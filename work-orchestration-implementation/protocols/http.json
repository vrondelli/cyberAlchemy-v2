{
  "schema_version": "cav2-rwo-http-adapter/v1",
  "adapter_id": "CA2-ADAPTER-RWO-HTTP-JSON",
  "protocol": "HTTP/1.1-or-newer JSON",
  "operations": [
    {"method": "POST", "path": "/v1/compositions:compile", "maps_to": "CompileComposition"},
    {"method": "POST", "path": "/v1/streams/{stream_id}/accepted-events", "maps_to": "AcceptStructuralEvent"},
    {"method": "GET", "path": "/v1/streams/{stream_id}/cursor", "maps_to": "ReadAcceptedHistory"}
  ],
  "required_headers": ["Content-Type: application/json", "Idempotency-Key", "X-Authority-Ref"],
  "status_mapping": {"Accepted": 201, "Duplicate": 200, "Conflict": 409, "Rejected": 422},
  "ownership": "transport translation only",
  "implementation": "cyberAlchemy-v2/work-orchestration-implementation/runtime/src/ports.rs#accept_http_event",
  "real_network_delivery": "deferred",
  "authority_effect": "none"
}
