{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/review-capabilities/v1",
  "$defs": {
    "id": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "text": {"type":"string","minLength":1},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "profile": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","package_id","package_root","package_owner","product_ref","product_capability_refs","business_ontology_ref","domainspec_project_ref","system_ontology_ref","source_registry_ref","support_registry_ref","construction_binding_ref","conformance_ref","status","construction_status","visibility","authority_effect","claim_limit"],
      "properties":{
        "schema_ref":{"const":"schemas/review-capabilities.schema.json#/$defs/profile"},"schema_version":{"const":"cav2-review-capabilities-profile/v1"},"package_id":{"const":"cav2.review-capabilities"},"package_root":{"const":"cyberAlchemy-v2/review"},"package_owner":{"$ref":"#/$defs/text"},"product_ref":{"const":"CA2-PRODUCT-CYBERALCHEMY"},"product_capability_refs":{"const":["CA2-CAP-RESOLVE-CONSEQUENTIAL-DECISIONS","CA2-CAP-EXPLAIN-COMPLEXITY-WITHOUT-MEANING-DRIFT"]},"business_ontology_ref":{"const":"business-ontology.json"},"domainspec_project_ref":{"const":"domainspec/project.json"},"system_ontology_ref":{"const":"domainspec/generated/system-ontology.json"},"source_registry_ref":{"const":"sources.json"},"support_registry_ref":{"const":"capabilities/support.json"},"construction_binding_ref":{"const":"construction-binding.json"},"conformance_ref":{"const":"conformance.json"},"status":{"const":"candidate"},"construction_status":{"const":"candidate"},"visibility":{"const":"private"},"authority_effect":{"const":"none"},"claim_limit":{"$ref":"#/$defs/text"}
      }
    },
    "source": {"type":"object","additionalProperties":false,"required":["source_id","path","owner_route"],"properties":{"source_id":{"pattern":"^SRC-REVIEW-"},"path":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}}},
    "selection": {"type":"object","additionalProperties":false,"required":["selection_id","source_id","scope_kind","selector","sha256"],"properties":{"selection_id":{"pattern":"^CAP-SEL-"},"source_id":{"pattern":"^SRC-REVIEW-"},"scope_kind":{"enum":["whole-file","heading-section"]},"selector":{"type":["string","null"]},"sha256":{"$ref":"#/$defs/sha256"}}},
    "sourceRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","sources","selections","authority_effect"],"properties":{"schema_ref":{"const":"schemas/review-capabilities.schema.json#/$defs/sourceRegistry"},"schema_version":{"const":"cav2-review-capability-sources/v1"},"sources":{"type":"array","minItems":7,"items":{"$ref":"#/$defs/source"}},"selections":{"type":"array","minItems":8,"items":{"$ref":"#/$defs/selection"}},"authority_effect":{"const":"none"}}},
    "businessNode": {"type":"object","additionalProperties":false,"required":["id","kind","meaning","owner_route"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["Product","Product Capability","Outcome","Actor","Context"]},"meaning":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}}},
    "businessRelation": {"type":"object","additionalProperties":false,"required":["id","source","type","target"],"properties":{"id":{"pattern":"^CA2-REVIEW-REL-"},"source":{"$ref":"#/$defs/id"},"type":{"enum":["belongs_to","produces","serves","applies_in","uses"]},"target":{"$ref":"#/$defs/id"}}},
    "businessOntology": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","ontology_id","ontology_type","product_ref","nodes","relations","authority_effect","claim_limit"],"properties":{"schema_ref":{"const":"schemas/review-capabilities.schema.json#/$defs/businessOntology"},"schema_version":{"const":"cav2-review-business-ontology/v1"},"ontology_id":{"const":"CA2-REVIEW-CAPABILITY-BUSINESS-ONTOLOGY"},"ontology_type":{"const":"capability-local-business"},"product_ref":{"const":"CA2-PRODUCT-CYBERALCHEMY"},"nodes":{"type":"array","minItems":10,"items":{"$ref":"#/$defs/businessNode"}},"relations":{"type":"array","minItems":10,"items":{"$ref":"#/$defs/businessRelation"}},"authority_effect":{"const":"none"},"claim_limit":{"$ref":"#/$defs/text"}}},
    "obligation": {"type":"object","additionalProperties":false,"required":["id","statement"],"properties":{"id":{"pattern":"^CAP-OBL-REVIEW-"},"statement":{"$ref":"#/$defs/text"}}},
    "supportRecord": {"type":"object","additionalProperties":false,"required":["id","kind","capability_ref","meaning","source_refs"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["input-contract","output-contract","context-policy","realization-binding","obligation-registry"]},"capability_ref":{"pattern":"^CA2-CAP-"},"agent_capability_ref":{"type":"string"},"implementation_ref":{"type":"string"},"implementation_digest":{"$ref":"#/$defs/sha256"},"meaning":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"pattern":"^CAP-SEL-"}},"obligations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/obligation"}}}},
    "supportResidue": {"type":"object","additionalProperties":false,"required":["id","status","meaning"],"properties":{"id":{"pattern":"^CAP-RES-REVIEW-"},"status":{"enum":["open","blocked","deferred"]},"meaning":{"$ref":"#/$defs/text"}}},
    "supportRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","records","residue","authority_effect"],"properties":{"schema_ref":{"const":"../schemas/review-capabilities.schema.json#/$defs/supportRegistry"},"schema_version":{"const":"cav2-review-capability-support/v1"},"records":{"type":"array","minItems":10,"items":{"$ref":"#/$defs/supportRecord"}},"residue":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/supportResidue"}},"authority_effect":{"const":"none"}}},
    "constructionStage": {"type":"object","additionalProperties":false,"required":["name","state","blockers"],"properties":{"name":{"enum":["definitions","product_capabilities","business_ontology","domainspec_source","compiled_graph","system_ontology","realization_bindings","conformance"]},"state":{"enum":["validated","candidate","not_evaluable"]},"blockers":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "digestBinding": {"type":"object","additionalProperties":false,"required":["ref","sha256"],"properties":{"ref":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "constructionBinding": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","binding_id","product_capability_refs","stages","domainspec_project","compiled_graph","system_ontology","realization_bindings","authority_effect","claim_limit"],"properties":{"schema_ref":{"const":"schemas/review-capabilities.schema.json#/$defs/constructionBinding"},"schema_version":{"const":"cav2-review-capability-construction/v1"},"binding_id":{"const":"CA2-CONSTRUCTION-REVIEW-CAPABILITIES-001"},"product_capability_refs":{"const":["CA2-CAP-RESOLVE-CONSEQUENTIAL-DECISIONS","CA2-CAP-EXPLAIN-COMPLEXITY-WITHOUT-MEANING-DRIFT"]},"stages":{"type":"array","minItems":8,"maxItems":8,"items":{"$ref":"#/$defs/constructionStage"}},"domainspec_project":{"$ref":"#/$defs/digestBinding"},"compiled_graph":{"$ref":"#/$defs/digestBinding"},"system_ontology":{"$ref":"#/$defs/digestBinding"},"realization_bindings":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/digestBinding"}},"authority_effect":{"const":"none"},"claim_limit":{"$ref":"#/$defs/text"}}},
    "observedCheck": {"type":"object","additionalProperties":false,"required":["id","status"],"properties":{"id":{"$ref":"#/$defs/text"},"status":{"enum":["PASS","BLOCK","NOT_EVALUABLE"]}}},
    "conformance": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","status","subject_refs","system_ontology_ref","system_ontology_digest","test_ref","test_digest","observed_checks","blockers","authority_effect","claim_limit"],"properties":{"schema_ref":{"const":"schemas/review-capabilities.schema.json#/$defs/conformance"},"schema_version":{"const":"cav2-review-capability-conformance/v1"},"status":{"const":"NOT_EVALUABLE"},"subject_refs":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/digestBinding"}},"system_ontology_ref":{"const":"cyberAlchemy-v2/review/domainspec/generated/system-ontology.json"},"system_ontology_digest":{"$ref":"#/$defs/sha256"},"test_ref":{"const":"cyberAlchemy-v2/review/tests/test_negative_mutations.py"},"test_digest":{"$ref":"#/$defs/sha256"},"observed_checks":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/observedCheck"}},"blockers":{"type":"array","minItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"authority_effect":{"const":"none"},"claim_limit":{"$ref":"#/$defs/text"}}}
  }
}
