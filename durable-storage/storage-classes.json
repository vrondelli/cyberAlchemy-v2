{
  "schema_ref": "schemas/durable-storage.schema.json#/$defs/storageClassRegistry",
  "schema_version": "cav2-durable-storage-classes/v1",
  "classes": [
    {
      "class_id": "DS-CLASS-AUTHORITATIVE-VERSIONED",
      "label": "Authoritative Versioned",
      "authority_role": "source",
      "mutability": "revision-controlled",
      "rebuildable": false,
      "semantics": "Preserve owner-controlled source or decision records with exact version identity and visible history.",
      "required_evidence": ["content identity", "owner route", "version history", "integrity check"],
      "excluded_uses": ["derived cache", "secret value", "implicit authority transfer"],
      "authority_effect": "none"
    },
    {
      "class_id": "DS-CLASS-APPEND-ONLY-EVIDENCE",
      "label": "Append-Only Evidence",
      "authority_role": "evidence",
      "mutability": "append-only",
      "rebuildable": false,
      "semantics": "Preserve receipts, decisions, assessments, or traces as history without overwriting earlier evidence.",
      "required_evidence": ["subject identity", "producer identity", "event time", "content digest"],
      "excluded_uses": ["canonical source replacement", "mutable working document"],
      "authority_effect": "none"
    },
    {
      "class_id": "DS-CLASS-RECOVERABLE-WORKING-STATE",
      "label": "Recoverable Working State",
      "authority_role": "operational-state",
      "mutability": "revision-controlled",
      "rebuildable": false,
      "semantics": "Preserve resumable state through explicit revisions and checkpoints while keeping it distinct from source authority.",
      "required_evidence": ["session or workflow identity", "revision identity", "recovery boundary", "recovery test"],
      "excluded_uses": ["canonical meaning", "unbounded process memory", "implicit user decision"],
      "authority_effect": "none"
    },
    {
      "class_id": "DS-CLASS-IMMUTABLE-ARTIFACT",
      "label": "Immutable Artifact",
      "authority_role": "artifact",
      "mutability": "immutable",
      "rebuildable": false,
      "semantics": "Preserve one exact accepted or reviewable artifact under a content identity; changes create a successor.",
      "required_evidence": ["content digest", "producer", "lifecycle posture", "retention decision"],
      "excluded_uses": ["mutable cache", "silent in-place revision"],
      "authority_effect": "none"
    },
    {
      "class_id": "DS-CLASS-REBUILDABLE-PROJECTION",
      "label": "Rebuildable Projection",
      "authority_role": "projection",
      "mutability": "replaceable",
      "rebuildable": true,
      "semantics": "Retain a view, index, catalog, or cache only as an optimization when its exact sources and deterministic rebuild route remain available.",
      "required_evidence": ["source identities", "projection version", "rebuild procedure"],
      "excluded_uses": ["sole copy of source meaning", "acceptance evidence"],
      "authority_effect": "none"
    },
    {
      "class_id": "DS-CLASS-EXTERNAL-SECRET-REFERENCE",
      "label": "External Secret Reference",
      "authority_role": "secret-reference",
      "mutability": "reference-only",
      "rebuildable": false,
      "semantics": "Preserve only a typed reference to a secret controlled by a separate credential owner and facility.",
      "required_evidence": ["secret owner route", "reference identity", "access boundary"],
      "excluded_uses": ["secret bytes", "credential export", "implicit access grant"],
      "authority_effect": "none"
    },
    {
      "class_id": "DS-CLASS-EPHEMERAL",
      "label": "Ephemeral",
      "authority_role": "ephemeral",
      "mutability": "replaceable",
      "rebuildable": true,
      "semantics": "Declare that material is intentionally disposable and carries no durability promise.",
      "required_evidence": ["explicit owner classification", "rebuild or discard consequence"],
      "excluded_uses": ["authoritative source", "irreplaceable evidence", "required recovery state"],
      "authority_effect": "none"
    }
  ],
  "authority_effect": "none"
}
