{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-durable-storage.schema/v1",
  "title": "CyberAlchemy v2 Durable Capability State business ontology",
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "selector"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^CAP-SEL-"},
        "selector": {"$ref": "#/$defs/text"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "selection_kind", "selector", "sha256", "posture", "owner_route"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^CAP-SEL-"},
        "path": {"$ref": "#/$defs/text"},
        "selection_kind": {"enum": ["whole-file", "markdown-section"]},
        "selector": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "posture": {"$ref": "#/$defs/text"},
        "owner_route": {"$ref": "#/$defs/text"}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "sources"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/sourceRegistry"},
        "schema_version": {"const": "cav2-durable-storage-sources/v1"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "canonicalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ref", "source_ref", "selector_sha256", "local_use", "authority_effect"],
      "properties": {
        "definition_ref": {"enum": ["CAV2-D65", "CAV2-D67"]},
        "source_ref": {"type": "string", "pattern": "^CAP-SEL-"},
        "selector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "local_use": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"}
      }
    },
    "localTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_id", "term", "meaning", "owner_route", "canonical_status", "forbidden_collapse"],
      "properties": {
        "term_id": {"type": "string", "pattern": "^DS-TERM-"},
        "term": {"$ref": "#/$defs/text"},
        "meaning": {"$ref": "#/$defs/text"},
        "owner_route": {"$ref": "#/$defs/text"},
        "canonical_status": {"const": "package-local-candidate"},
        "forbidden_collapse": {"$ref": "#/$defs/text"}
      }
    },
    "definitionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "canonical_bindings", "local_terms", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/definitionRegistry"},
        "schema_version": {"const": "cav2-durable-storage-definitions/v1"},
        "canonical_bindings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/canonicalBinding"}},
        "local_terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/localTerm"}},
        "authority_effect": {"const": "none"}
      }
    },
    "ontologySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence", "reason", "excluded_types"],
      "properties": {
        "source": {"const": "inferred"},
        "confidence": {"const": "high"},
        "reason": {"$ref": "#/$defs/text"},
        "excluded_types": {"const": ["system-runtime", "business-system-bridge"]}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "package_id", "ontology_id", "title", "ontology_type", "ontology_type_selection", "branch", "materialization", "package_root", "package_owner", "meaning_owner", "product_ref", "product_capability_ref", "visibility", "candidate_status", "construction_stage", "runtime_registration_status", "authority_effect", "source_registry", "definition_registry", "product_capability", "product_capability_support", "storage_class_registry", "storage_requirement_registry", "node_registry", "relation_registry", "residue_registry", "schema_path", "validator_path", "blocked_outputs"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/profile"},
        "schema_version": {"const": "cav2-durable-storage-profile/v1"},
        "package_id": {"const": "cav2.durable-storage"},
        "ontology_id": {"const": "cav2.durable-storage.business"},
        "title": {"$ref": "#/$defs/text"},
        "ontology_type": {"const": "business-domain"},
        "ontology_type_selection": {"$ref": "#/$defs/ontologySelection"},
        "branch": {"const": "business"},
        "materialization": {"const": "package-required"},
        "package_root": {"const": "cyberAlchemy-v2/durable-storage"},
        "package_owner": {"$ref": "#/$defs/text"},
        "meaning_owner": {"$ref": "#/$defs/text"},
        "product_ref": {"const": "CA2-PRODUCT-CYBERALCHEMY"},
        "product_capability_ref": {"const": "CA2-CAP-PRESERVE-DURABLE-CAPABILITY-STATE"},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "construction_stage": {"const": "business-ontology-candidate"},
        "runtime_registration_status": {"const": "registered-read-only-candidate"},
        "authority_effect": {"const": "none"},
        "source_registry": {"const": "sources.json"},
        "definition_registry": {"const": "definitions.json"},
        "product_capability": {"const": "product-capability.json"},
        "product_capability_support": {"const": "product-capability-support.json"},
        "storage_class_registry": {"const": "storage-classes.json"},
        "storage_requirement_registry": {"const": "storage-requirements.json"},
        "node_registry": {"const": "nodes.json"},
        "relation_registry": {"const": "relations.json"},
        "residue_registry": {"const": "residue.json"},
        "schema_path": {"const": "schemas/durable-storage.schema.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "blocked_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "storageClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "label", "authority_role", "mutability", "rebuildable", "semantics", "required_evidence", "excluded_uses", "authority_effect"],
      "properties": {
        "class_id": {"type": "string", "pattern": "^DS-CLASS-"},
        "label": {"$ref": "#/$defs/text"},
        "authority_role": {"enum": ["source", "evidence", "operational-state", "artifact", "projection", "secret-reference", "ephemeral"]},
        "mutability": {"enum": ["revision-controlled", "append-only", "immutable", "replaceable", "reference-only"]},
        "rebuildable": {"type": "boolean"},
        "semantics": {"$ref": "#/$defs/text"},
        "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "excluded_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "authority_effect": {"const": "none"}
      }
    },
    "storageClassRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "classes", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/storageClassRegistry"},
        "schema_version": {"const": "cav2-durable-storage-classes/v1"},
        "classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/storageClass"}},
        "authority_effect": {"const": "none"}
      }
    },
    "coverageBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "product_capability_count", "external_agent_capability_reference_count", "completeness_claim", "historical_candidate_copies_excluded"],
      "properties": {
        "posture": {"const": "exact-source-bounded"},
        "product_capability_count": {"const": 12},
        "external_agent_capability_reference_count": {"const": 1},
        "completeness_claim": {"$ref": "#/$defs/text"},
        "historical_candidate_copies_excluded": {"const": true}
      }
    },
    "storageRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "subject_ref", "subject_kind", "subject_owner_route", "need_posture", "artifact_kinds", "durability_class_refs", "retention_posture", "binding_state", "evidence_refs", "rationale", "claim_limit", "authority_effect"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^DS-REQ-"},
        "subject_ref": {"type": "string", "pattern": "^CA2-(CAP|REF)-"},
        "subject_kind": {"enum": ["product-capability", "agent-capability-reference"]},
        "subject_owner_route": {"$ref": "#/$defs/text"},
        "need_posture": {"enum": ["evidenced-existing", "required-before-runtime", "mixed-existing-and-future", "derived-optional", "unknown", "external-owner"]},
        "artifact_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
        "durability_class_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DS-CLASS-"}},
        "retention_posture": {"enum": ["owner-decision-required", "preserve-history", "rebuild-on-demand", "external-owner"]},
        "binding_state": {"enum": ["unselected", "external-owner"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-SEL-"}},
        "rationale": {"$ref": "#/$defs/text"},
        "claim_limit": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"}
      }
    },
    "storageRequirementRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "coverage_basis", "requirements", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/storageRequirementRegistry"},
        "schema_version": {"const": "cav2-durable-storage-requirements/v1"},
        "coverage_basis": {"$ref": "#/$defs/coverageBasis"},
        "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/storageRequirement"}},
        "authority_effect": {"const": "none"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "role", "plain_language", "claim", "source_refs", "owner_route", "candidate_status", "evidence_confidence", "commitment_confidence", "authority_effect", "forbidden_collapse", "open_questions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/text"},
        "role": {"enum": ["product_projection", "product_capability", "actor", "domain_concept", "input_contract", "output_contract", "policy", "business_rule", "outcome"]},
        "plain_language": {"$ref": "#/$defs/text"},
        "claim": {"$ref": "#/$defs/text"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
        "owner_route": {"$ref": "#/$defs/text"},
        "candidate_status": {"enum": ["candidate", "projected", "deferred", "blocked"]},
        "evidence_confidence": {"enum": ["low", "medium", "high"]},
        "commitment_confidence": {"enum": ["low", "conditional", "committed"]},
        "authority_effect": {"const": "none"},
        "forbidden_collapse": {"$ref": "#/$defs/text"},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "nodeRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "nodes", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/nodeRegistry"},
        "schema_version": {"const": "cav2-durable-storage-nodes/v1"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "authority_effect": {"const": "none"}
      }
    },
    "relationType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_roles", "target_roles", "meaning", "forbidden_collapse"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "target_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "meaning": {"$ref": "#/$defs/text"},
        "forbidden_collapse": {"$ref": "#/$defs/text"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source", "target", "source_refs", "owner_route", "authority_effect", "forbidden_collapse"],
      "properties": {
        "id": {"type": "string", "pattern": "^DS-REL-"},
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
        "owner_route": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"},
        "forbidden_collapse": {"$ref": "#/$defs/text"}
      }
    },
    "relationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "relation_vocabulary", "relations", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/relationRegistry"},
        "schema_version": {"const": "cav2-durable-storage-relations/v1"},
        "relation_vocabulary": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relationType"}},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}},
        "authority_effect": {"const": "none"}
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residue_id", "label", "description", "status", "owner_route", "next_action", "subject_refs", "evidence_refs", "authority_effect"],
      "properties": {
        "residue_id": {"type": "string", "pattern": "^CAP-RES-DURABLE-STORAGE-"},
        "label": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "status": {"enum": ["open", "deferred", "blocked", "closed"]},
        "owner_route": {"$ref": "#/$defs/text"},
        "next_action": {"$ref": "#/$defs/text"},
        "subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-SEL-"}},
        "authority_effect": {"const": "none"}
      }
    },
    "residueRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "residue", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/residueRegistry"},
        "schema_version": {"const": "cav2-durable-storage-residue/v1"},
        "residue": {"type": "array", "items": {"$ref": "#/$defs/residue"}},
        "authority_effect": {"const": "none"}
      }
    },
    "realizationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "state", "system_ontology_ref", "provider_ref", "implementation_ref", "blockers", "authority_effect"],
      "properties": {
        "binding_id": {"const": "CA2-CAP-BIND-DURABLE-STORAGE-UNSELECTED"},
        "state": {"const": "not_evaluable"},
        "system_ontology_ref": {"type": "null"},
        "provider_ref": {"type": "null"},
        "implementation_ref": {"type": "null"},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "authority_effect": {"const": "none"}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "statement", "state"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^DS-OBL-"},
        "statement": {"$ref": "#/$defs/text"},
        "state": {"enum": ["model-checkable", "not_evaluable"]}
      }
    },
    "obligationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "aggregate_state", "obligations"],
      "properties": {
        "registry_id": {"const": "CA2-CAP-OBLIGATIONS-DURABLE-STORAGE"},
        "aggregate_state": {"const": "not_evaluable"},
        "obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}}
      }
    },
    "productCapabilitySupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "capability_ref", "instance_status", "adoption_state", "construction_stage", "realization_binding", "obligation_registry", "authority_effect"],
      "properties": {
        "schema_ref": {"const": "schemas/durable-storage.schema.json#/$defs/productCapabilitySupport"},
        "schema_version": {"const": "cav2-durable-storage-product-capability-support/v1"},
        "capability_ref": {"const": "CA2-CAP-PRESERVE-DURABLE-CAPABILITY-STATE"},
        "instance_status": {"const": "candidate"},
        "adoption_state": {"const": "not-adopted"},
        "construction_stage": {"const": "business-ontology-candidate"},
        "realization_binding": {"$ref": "#/$defs/realizationBinding"},
        "obligation_registry": {"$ref": "#/$defs/obligationRegistry"},
        "authority_effect": {"const": "none"}
      }
    },
    "validationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "validated_at", "status", "package_root", "ontology_id", "ontology_type", "branch", "visibility", "authority_effect", "material_digest", "source_digest", "counts", "construction", "claim_ceiling", "errors"],
      "properties": {
        "schema_version": {"const": "cav2-durable-storage-validation/v1"},
        "validated_at": {"type": "string", "format": "date-time"},
        "status": {"const": "PASS"},
        "package_root": {"const": "cyberAlchemy-v2/durable-storage"},
        "ontology_id": {"const": "cav2.durable-storage.business"},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "visibility": {"const": "private"},
        "authority_effect": {"const": "none"},
        "material_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "canonical_definitions", "local_terms", "storage_classes", "requirements", "product_capabilities", "external_agent_capability_references", "nodes", "relation_types", "relations", "residue"],
          "properties": {
            "sources": {"type": "integer", "minimum": 1},
            "canonical_definitions": {"const": 2},
            "local_terms": {"type": "integer", "minimum": 1},
            "storage_classes": {"const": 7},
            "requirements": {"const": 13},
            "product_capabilities": {"const": 12},
            "external_agent_capability_references": {"const": 1},
            "nodes": {"type": "integer", "minimum": 1},
            "relation_types": {"type": "integer", "minimum": 1},
            "relations": {"type": "integer", "minimum": 1},
            "residue": {"type": "integer", "minimum": 1}
          }
        },
        "construction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definitions", "product_capability", "business_ontology", "domainspec_source", "compiled_graph", "system_ontology", "implementation_binding", "conformance"],
          "properties": {
            "definitions": {"const": "validated-reference"},
            "product_capability": {"const": "candidate-validated-shape"},
            "business_ontology": {"const": "candidate-validated-package"},
            "domainspec_source": {"const": "absent"},
            "compiled_graph": {"const": "not_evaluable"},
            "system_ontology": {"const": "not_evaluable"},
            "implementation_binding": {"const": "not_evaluable"},
            "conformance": {"const": "not_evaluable"}
          }
        },
        "claim_ceiling": {"$ref": "#/$defs/text"},
        "errors": {"type": "array", "maxItems": 0}
      }
    }
  }
}
