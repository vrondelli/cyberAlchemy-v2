{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/essays-agent-runtime-ontology-plan.schema.json",
  "title": "Essays agent runtime ontology planning package",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema_version", "plan_id", "title", "project_ref", "goal_ref", "capability_ref", "primary_ontology_type", "ontology_type_selection", "materialization", "package_root", "package_owner", "visibility", "status", "source_registry", "ontology_family_registry", "dependency_registry", "campaign_registry", "residue_registry", "validator_path", "construction_binding_state", "implementation_authority", "authority_effect", "claim_ceiling"],
      "properties": {
        "$schema": {"type":"string"}, "schema_version": {"type":"string"}, "plan_id": {"type":"string"},
        "title": {"type":"string"}, "project_ref": {"type":"string"}, "goal_ref": {"type":"string"},
        "capability_ref": {"type":"string"}, "primary_ontology_type": {"const":"business-system-bridge"},
        "ontology_type_selection": {"type":"object"}, "materialization": {"const":"package-required"},
        "package_root": {"type":"string"}, "package_owner": {"type":"string"}, "visibility": {"const":"private"},
        "status": {"const":"candidate-planning"}, "source_registry": {"type":"string"},
        "ontology_family_registry": {"type":"string"}, "dependency_registry": {"type":"string"},
        "campaign_registry": {"type":"string"}, "residue_registry": {"type":"string"},
        "validator_path": {"type":"string"}, "construction_binding_state": {"const":"not-registered"},
        "implementation_authority": {"const":"not-granted"}, "authority_effect": {"const":"none"},
        "claim_ceiling": {"type":"string"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema_version", "digest_algorithm", "sources", "authority_effect"],
      "properties": {
        "$schema": {"type":"string"}, "schema_version": {"type":"string"},
        "digest_algorithm": {"const":"sha256-file-bytes/v1"},
        "sources": {"type":"array", "minItems":1}, "authority_effect": {"const":"none"}
      }
    },
    "ontologyFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema_version", "plan_ref", "family_rule", "ontologies", "system_view_rule", "authority_effect"],
      "properties": {
        "$schema": {"type":"string"}, "schema_version": {"type":"string"}, "plan_ref": {"type":"string"},
        "family_rule": {"type":"string"}, "ontologies": {"type":"array", "minItems":7, "maxItems":7},
        "system_view_rule": {"type":"string"}, "authority_effect": {"const":"none"}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema_version", "plan_ref", "d65_chain", "dependency_edges", "non_ontology_preconditions", "cycle_policy", "authority_effect"],
      "properties": {
        "$schema": {"type":"string"}, "schema_version": {"type":"string"}, "plan_ref": {"type":"string"},
        "d65_chain": {"type":"array", "minItems":7, "maxItems":7},
        "dependency_edges": {"type":"array", "minItems":1},
        "non_ontology_preconditions": {"type":"array", "minItems":1},
        "cycle_policy": {"const":"forbid"}, "authority_effect": {"const":"none"}
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema_version", "campaign_id", "plan_ref", "campaign_intent", "one_shot_interpretation", "technology_posture", "runtime_units", "phases", "preimplementation_decisions", "failure_policy", "authority_effect"],
      "properties": {
        "$schema": {"type":"string"}, "schema_version": {"type":"string"}, "campaign_id": {"type":"string"},
        "plan_ref": {"type":"string"}, "campaign_intent": {"type":"string"},
        "one_shot_interpretation": {"type":"string"}, "technology_posture": {"type":"object"},
        "runtime_units": {"type":"array", "minItems":1}, "phases": {"type":"array", "minItems":6, "maxItems":6},
        "preimplementation_decisions": {"type":"array", "minItems":1}, "failure_policy": {"type":"string"},
        "authority_effect": {"const":"none"}
      }
    }
  }
}
