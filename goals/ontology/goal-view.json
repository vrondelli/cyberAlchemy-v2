  "relation_vocabulary": [
    {"id": "instance_of", "meaning": "The source is an instance of the target concept."},
    {"id": "belongs_to", "meaning": "The source Goal is owned within the target Project."},
    {"id": "traced_to", "meaning": "The source states a purpose connection to the target without proving realization, adoption, or achievement."},
    {"id": "tests_realization_of", "meaning": "The source uses bounded evidence to test one realization of the target thesis; it does not prove the whole thesis."},
    {"id": "supported_by", "meaning": "The target evidence supports a bounded part of the source claim."},
    {"id": "carries_binding", "meaning": "The source Project concept carries references to binding records in the target Project-owned registry; the relation grants no authority."},
    {"id": "carries_construction_binding", "meaning": "The source Project concept or Project record carries an exact prototype ConstructionBinding reference; the relation grants no product approval, authority, or construction effect."},
    {"id": "contains_prototype_binding", "meaning": "The Project-owned registry indexes the target prototype construction record without acquiring any stage-owner authority."},
    {"id": "binds_prototype_contract", "meaning": "The source Project construction selects the target exact tested D65 prototype contract without approving the consuming product."},
    {"id": "guided_by_scaffold", "meaning": "The source Project construction uses the target non-authoritative ontology scaffold to help agents navigate the prototype lifecycle."},
    {"id": "shaped_by", "meaning": "The source registry uses the target canonical invariant schema without claiming that any binding satisfies it."},
    {"id": "scopes_candidate_authority_for", "meaning": "The source records a complete candidate authority tuple for the target without activating or transferring authority."},
    {"id": "candidate_child_of", "meaning": "The source is declared as a child of the target in source topology, while admissibility as a CAV2-D16 model-instance relation remains unresolved."},
    {"id": "prepared_for", "meaning": "The source candidate is maintained for the target Project but does not create adoption, conformance, or execution authority."},
    {"id": "prepares_adoption_for", "meaning": "The source is a no-effect decision envelope for an exact inherited-contract candidate; it is not the owner decision."},
    {"id": "resolved_by_adoption", "meaning": "The source envelope is resolved by the target exact owner adoption decision; this does not prove conformance or satisfy the complete binding invariant."},
    {"id": "admitted_instance_of", "meaning": "The source has an exact admitted instance_of relation to the target for CAV2-D16 typed-relation witnessing only; adoption, conformance, binding, and authority remain absent."},
    {"id": "selects_candidate", "meaning": "The source decision selects the target candidate only; it does not admit or activate the candidate."},
    {"id": "admits_relation", "meaning": "The source owner decision admits the target exact typed relation only and grants no further lifecycle or authority effect."},
    {"id": "admitted_from_candidate", "meaning": "The source admitted relation preserves and identifies the frozen candidate from which it was admitted."},
    {"id": "requires_admitted_relation", "meaning": "The source adoption envelope binds the target admitted relation as a prerequisite to the separately recorded D48 owner decision."},
    {"id": "adopts_exact_contract", "meaning": "The source owner decision adopts the target exact inherited contract and no other version; it does not prove conformance, activate authority, or complete a binding."},
    {"id": "contains_adoption", "meaning": "The source Project-owned registry contains the target exact adopted-parent-contract projection without creating authority."},
    {"id": "projects_adoption_decision", "meaning": "The source adopted-parent-contract record projects the target immutable owner decision while preserving the decision as authority."},
    {"id": "contains_assessment", "meaning": "The source Project-owned registry contains the target no-effect assessment without making its result conformance proof."},
    {"id": "assesses_conformance_of", "meaning": "The source review-only assessment evaluates structural support and evidence currency for the target adopted contract; an indeterminate result does not satisfy conformance or D64."}
  ],
