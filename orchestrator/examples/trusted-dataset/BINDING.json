{
  "schema_version": "orchestrator-consumer-binding/v1-candidate",
  "binding_id": "orchestrator.example.trusted-dataset",
  "consumer_root": "../../../trusted-dataset-materialization",
  "adapter": "../../../trusted-dataset-materialization/rwo-adapter",
  "rwo_api": "../../rwo",
  "api_version": "rwo-core-api/v1",
  "engine_version": "rwo-core-dag/v2",
  "integration": {
    "mode": "direct-pure-structural-api",
    "durability_owner": "trusted-dataset materialization host",
    "data_boundary": "RWO receives control events and data references, never bulk dataset bytes",
    "conditional_routes": [
      {
        "source": "ValidateDataset",
        "pointer": "/event_type",
        "equals": "DatasetValidated",
        "target": "StageLoad"
      },
      {
        "source": "ValidateDataset",
        "pointer": "/event_type",
        "equals": "ValidationRejected",
        "target": "QuarantineDataset"
      }
    ]
  },
  "status": "candidate",
  "authority_effect": "none",
  "legacy_provenance_ref": "LEGACY-PROVENANCE.json",
  "open_questions_ref": "../../authority/definitions/DEFINITIONS.md#open-questions"
}
