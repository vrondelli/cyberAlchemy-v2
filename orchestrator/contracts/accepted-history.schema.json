{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-accepted-history/v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "cursor",
    "accepted_events",
    "pending_commands",
    "control_records"
  ],
  "properties": {
    "schema_version": {
      "const": "orchestrator-accepted-history/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "cursor": {
      "type": "object"
    },
    "accepted_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pending_commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "control_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
