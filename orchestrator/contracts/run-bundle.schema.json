{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-run-bundle/v1",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_digest",
    "run_id",
    "graph",
    "graph_digest",
    "engine_version",
    "admitted_at_ms",
    "deadline_at_ms",
    "authority_refs",
    "admission_context"
  ],
  "properties": {
    "schema_version": {
      "const": "orchestrator-run-bundle/v1"
    },
    "bundle_digest": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "graph": {
      "type": "object"
    },
    "graph_digest": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "admitted_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "deadline_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "admission_context": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
