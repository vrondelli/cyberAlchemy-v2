{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-command-receipt/v1",
  "type": "object",
  "required": [
    "receipt_id",
    "command_id",
    "worker_id",
    "fencing_token",
    "event",
    "effect_disposition",
    "recorded_at_ms"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "type": "object"
    },
    "effect_disposition": {
      "enum": [
        "not_applicable",
        "not_applied",
        "applied",
        "unknown"
      ]
    },
    "recorded_at_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
