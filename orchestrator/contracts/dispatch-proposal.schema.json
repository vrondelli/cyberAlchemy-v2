{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-dispatch-proposal/v1",
  "type": "object",
  "required": [
    "schema_version", "proposal_id", "strategy_id", "strategy_version",
    "strategy_digest", "template_ref", "intended_outcome", "graph",
    "graph_digest", "lanes", "agent_requirements", "policies", "limits",
    "selected_adapter_refs", "inputs", "evidence_expectations",
    "result_reduction", "authority_refs", "status"
  ],
  "properties": {
    "schema_version": { "const": "orchestrator-dispatch-proposal/v1" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "strategy_id": { "type": "string", "minLength": 1 },
    "strategy_version": { "type": "string", "minLength": 1 },
    "strategy_digest": { "type": "string", "minLength": 1 },
    "template_ref": { "type": ["string", "null"] },
    "intended_outcome": { "type": "string", "minLength": 1 },
    "graph": { "type": "object" },
    "graph_digest": { "type": "string", "minLength": 1 },
    "lanes": { "type": "array" },
    "agent_requirements": { "type": "array" },
    "policies": {},
    "limits": { "type": "object" },
    "selected_adapter_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputs": {},
    "evidence_expectations": {},
    "result_reduction": {},
    "authority_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "proposed" }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
