{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-event-proposal/v1",
  "type": "object",
  "required": [
    "event_id",
    "command_id",
    "node_id",
    "outcome",
    "output_ref",
    "error"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "succeeded",
        "retryable_failure",
        "failed"
      ]
    },
    "output_ref": {},
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
