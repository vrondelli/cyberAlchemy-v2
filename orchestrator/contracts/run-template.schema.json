{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-run-template/v1",
  "type": "object",
  "required": [
    "schema_version", "run_template_id", "version", "display_name",
    "description", "strategy_template_id", "strategy_template_version",
    "default_parameters", "adapter_defaults", "limit_overrides",
    "presentation", "admission_prompts"
  ],
  "properties": {
    "schema_version": { "const": "orchestrator-run-template/v1" },
    "run_template_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "strategy_template_id": { "type": "string", "minLength": 1 },
    "strategy_template_version": { "type": "string", "minLength": 1 },
    "default_parameters": { "type": "object" },
    "adapter_defaults": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limit_overrides": {
      "type": ["object", "null"],
      "properties": {
        "deadline_seconds": { "type": "integer", "minimum": 1 },
        "max_parallelism": { "type": "integer", "minimum": 1 }
      },
      "required": ["deadline_seconds", "max_parallelism"],
      "additionalProperties": false
    },
    "presentation": {},
    "admission_prompts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
