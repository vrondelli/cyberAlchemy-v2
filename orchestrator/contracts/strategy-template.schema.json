{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-strategy-template/v1",
  "type": "object",
  "required": ["schema_version", "template_id", "version", "parameters", "compatibility_requirements", "strategy"],
  "properties": {
    "schema_version": { "const": "orchestrator-strategy-template/v1" },
    "template_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value_type", "required", "default", "constraints"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value_type": { "enum": ["string", "integer", "number", "boolean", "object", "array"] },
          "required": { "type": "boolean" },
          "default": {},
          "constraints": {
            "type": "object",
            "required": ["allowed_values", "minimum", "maximum", "min_length", "max_length"],
            "properties": {
              "allowed_values": { "type": "array" },
              "minimum": { "type": ["number", "null"] },
              "maximum": { "type": ["number", "null"] },
              "min_length": { "type": ["integer", "null"], "minimum": 0 },
              "max_length": { "type": ["integer", "null"], "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "compatibility_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "strategy": { "type": "object" }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
