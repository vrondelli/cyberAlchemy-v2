{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-strategy/v1",
  "type": "object",
  "required": [
    "schema_version", "strategy_id", "version", "intended_outcome",
    "root_work_ref", "work_definitions", "lanes", "agent_requirements",
    "policies", "limits", "adapter_requirements", "inputs",
    "evidence_expectations", "result_reduction", "authority_refs"
  ],
  "properties": {
    "schema_version": { "const": "orchestrator-strategy/v1" },
    "strategy_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "intended_outcome": { "type": "string", "minLength": 1 },
    "root_work_ref": { "type": "string", "minLength": 1 },
    "work_definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_id", "purpose"],
        "properties": {
          "lane_id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "agent_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "agent_ref", "lane_id", "node_selector", "required_capabilities"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "agent_ref": { "type": ["string", "null"] },
          "lane_id": { "type": "string", "minLength": 1 },
          "node_selector": { "type": "string", "minLength": 1 },
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "policies": {},
    "limits": {
      "type": "object",
      "required": ["deadline_seconds", "max_parallelism"],
      "properties": {
        "deadline_seconds": { "type": "integer", "minimum": 1 },
        "max_parallelism": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "adapter_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputs": {},
    "evidence_expectations": {},
    "result_reduction": {},
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "x-authority-effect": "none",
  "x-open-questions-ref": "../authority/definitions/DEFINITIONS.md#open-questions"
}
