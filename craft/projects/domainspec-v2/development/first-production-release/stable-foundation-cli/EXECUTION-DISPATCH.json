        "to_owner": "invoke refresh",
        "applies_to_steps": ["S1", "S2", "S3", "S4", "S5"],
        "contract": "A schema-valid Task Session receipt and passing acceptance-critical command precede the separately approved six-target closeout candidate.",
        "on_violation": "block"
      },
      {
        "boundary_id": "B2-private-decision-context",
        "kind": "external_context",
        "from_owner": "DomainSpec-v2 private authority",
        "to_owner": "WP-SFC-001 implementation",
        "applies_to_steps": ["S0", "S6"],
        "contract": "Use exact private source handles locally; do not copy private prose into public Arcanum or canonical memory.",
        "on_violation": "block"
      }
    ],
    "authority": {
      "lifecycle": "invoke refresh",
      "execution": "task-session for one selected unit",
      "validation": "declared validation-contract owner and independent verifier where named",
      "evidence": "Task Session plus fixed closeout receipts",
      "memory": "none",
      "promotion": "DomainSpec-v2 Owners under a separate decision"
