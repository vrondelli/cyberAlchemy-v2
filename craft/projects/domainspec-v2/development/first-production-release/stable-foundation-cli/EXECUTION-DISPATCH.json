  "gates": [
    {
      "gate_id": "G0-route-projection",
      "kind": "validation",
      "owner": "dispatch-spec and implementation-readiness",
      "condition": "The dispatch and 20-route execution projection validate with equal frontier and write scopes.",
      "on_fail": "block"
    },
    {
      "gate_id": "G1-single-unit-entry",
      "kind": "human_approval",
      "owner": "DomainSpec-v2 execution owner",
      "condition": "Exactly one dependency-eligible SWU has separate execution authorization and every typed owner prerequisite required by that unit.",
      "on_fail": "ask"
    },
    {
      "gate_id": "G2-closeout-baseline",
      "kind": "quality",
      "owner": "invoke refresh",
      "condition": "Every closeout uses the six-target sha256-or-absent baseline and does not start a successor.",
      "on_fail": "block"
    },
    {
      "gate_id": "G3-W2-join",
      "kind": "validation",
      "owner": "Task Session parent",
      "condition": "Both W2 lane receipt sets pass and are joined before W3 eligibility.",
      "on_fail": "block"
    },
    {
      "gate_id": "G4-independent-owners",
      "kind": "quality",
      "owner": "independent verifier",
      "condition": "Operator, author, verifier, support, proposer, approver, profile, and causal-evidence owners remain distinguishable where required.",
      "on_fail": "block"
    },
    {
      "gate_id": "G5-authority-ceiling",
      "kind": "promotion_guardrail",
      "owner": "DomainSpec-v2 Owners",
      "condition": "Task Session evidence does not release, publish, deploy, promote authority, or claim the complete July product.",
      "on_fail": "block"
    }
  ],
  "boundary_evidence": {
    "boundaries": [
