{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/authority-baseline.schema.json",
  "title": "DomainSpec v2 FPR-01 authority baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "baseline_id", "task_id", "status", "inputs",
    "meta_types", "relationships", "source_homes", "direction_dependency",
    "disagreement_resolutions", "repair_requirements", "authority_boundary"
  ],
  "properties": {
    "$schema": {"const": "schemas/authority-baseline.schema.json"},
    "schema_version": {"const": "authority-baseline/v1"},
    "baseline_id": {"type": "string", "pattern": "^FPR01-AUTHORITY-BASELINE-"},
    "task_id": {"const": "SWU-FPR01-003"},
    "status": {"const": "validation-candidate"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_receipt", "census", "dispositions", "decision"],
      "properties": {
        "predecessor_receipt": {"$ref": "#/$defs/digestReference"},
        "census": {"$ref": "#/$defs/digestReference"},
        "dispositions": {"$ref": "#/$defs/digestReference"},
        "decision": {"$ref": "#/$defs/digestReference"}
      }
    },
    "meta_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_path", "scheme", "registry_status", "backend", "staged_labels", "ui", "superseded"],
      "properties": {
        "authority_path": {"const": "definitions/meta-types/meta-types.yml"},
        "scheme": {"const": "DS-D1"},
        "registry_status": {"const": "active"},
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "ids", "status"],
          "properties": {
            "count": {"const": 13},
            "ids": {
              "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^DS-D1\\.(?:[1-9]|1[1-4])$"}
            },
            "status": {"const": "active"}
          }
        },
        "staged_labels": {
          "type": "object", "additionalProperties": false, "required": ["count", "contiguous"],
          "properties": {"count": {"const": 24}, "contiguous": {"const": false}}
        },
        "ui": {
          "type": "object", "additionalProperties": false, "required": ["candidate", "deferred"],
          "properties": {
            "candidate": {
              "type": "object", "additionalProperties": false, "required": ["count", "ids", "status"],
              "properties": {
                "count": {"const": 9},
                "ids": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "pattern": "^DS-D1\\.(?:1[5-9]|2[0-3])$"}},
                "status": {"const": "candidate"}
              }
            },
            "deferred": {
              "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
              "items": {"$ref": "#/$defs/namedStatus"}
            }
          }
        },
        "superseded": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/namedStatus"}
        }
      }
    },
    "relationships": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_path", "registry_status", "declared_count", "record_count", "active_count", "category_wording"],
      "properties": {
        "authority_path": {"const": "definitions/relationships/relationships.yml"},
        "registry_status": {"const": "active"},
        "declared_count": {"const": 30},
        "record_count": {"const": 30},
        "active_count": {"const": 30},
        "category_wording": {"const": "typed composable graph fragment"}
      }
    },
    "source_homes": {
      "type": "object", "additionalProperties": false,
      "required": ["consumer_project_manifest", "feature_manifest_pattern", "node_source_pattern", "connection_ownership", "generated_root_disposition", "legacy_feature_pack_disposition", "legacy_taxonomy", "definitions"],
      "properties": {
        "consumer_project_manifest": {"const": "project.json"},
        "feature_manifest_pattern": {"const": "specs/<feature>/feature.json"},
        "node_source_pattern": {"const": "specs/<feature>/nodes/<node>.json"},
        "connection_ownership": {"const": "source-node-owned"},
        "generated_root_disposition": {"const": "generated-projection"},
        "legacy_feature_pack_disposition": {"const": "historical"},
        "legacy_taxonomy": {
          "type": "object", "additionalProperties": false, "required": ["path", "disposition", "authority"],
          "properties": {"path": {"const": "impl/spec/TAXONOMY.md"}, "disposition": {"const": "retire-after-migration"}, "authority": {"const": false}}
        },
        "definitions": {
          "type": "object", "additionalProperties": false, "required": ["authority_path", "rejected_path", "rejected_path_disposition"],
          "properties": {"authority_path": {"const": "definitions/"}, "rejected_path": {"const": "impl/spec/DEFINITIONS.md"}, "rejected_path_disposition": {"const": "superseded"}}
        }
      }
    },
    "direction_dependency": {
      "type": "object", "additionalProperties": false, "required": ["target", "disposition", "owner", "statement"],
      "properties": {"target": {"const": "FPR-03"}, "disposition": {"const": "deferred"}, "owner": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}}
    },
    "disagreement_resolutions": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": {"$ref": "#/$defs/resolution"}
    },
    "repair_requirements": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repairRequirement"}
    },
    "authority_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_surfaces_mutated", "fpr_01_ratified", "fpr_01_complete", "fpr01_004_execution_authorized", "fpr_02_entry_authorized", "production_authorized"],
      "properties": {
        "authority_surfaces_mutated": {"const": false},
        "fpr_01_ratified": {"const": false},
        "fpr_01_complete": {"const": false},
        "fpr01_004_execution_authorized": {"const": false},
        "fpr_02_entry_authorized": {"const": false},
        "production_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "digestReference": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "namedStatus": {
      "type": "object", "additionalProperties": false, "required": ["id", "term", "status"],
      "properties": {"id": {"type": "string", "pattern": "^DS-D1\\.[0-9]+$"}, "term": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}}
    },
    "resolution": {
      "type": "object", "additionalProperties": false, "required": ["id", "disposition", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^FPR01-D0(?:0[1-9]|1[0-2])$"},
        "disposition": {"enum": ["authoritative", "generated-projection", "historical", "superseded", "deferred", "repair-required"]},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "repairRequirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "owner", "target"],
      "properties": {"id": {"type": "string", "pattern": "^FPR01-D0(?:0[1-9]|1[0-2])$"}, "owner": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}
    }
  }
}
