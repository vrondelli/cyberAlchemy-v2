{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/v2/first-production-release/roadmap-copy.schema.json",
  "title": "DomainSpec v2 Roadmap Presentation Copy",
  "description": "Presentation-only text fields for the generated first-production-release roadmap. This document never owns roadmap identity, graph meaning, continuation state, proof, or release authorization.",
  "type": "object",
  "required": [
    "schema_version",
    "copy_kind",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "copy_kind": {
      "const": "presentation-only"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/copy_field"
      }
    }
  },
  "$defs": {
    "copy_field": {
      "type": "object",
      "required": [
        "field_id",
        "target",
        "role",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^copy\\.(node|frontier|critical-step|status|page)\\.[A-Za-z0-9][A-Za-z0-9._-]*\\.(title|summary|label|body|instruction|status-label)$"
        },
        "target": {
          "$ref": "#/$defs/copy_target"
        },
        "role": {
          "type": "string",
          "enum": [
            "title",
            "summary",
            "label",
            "body",
            "instruction",
            "status-label"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    "copy_target": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "node",
            "frontier",
            "critical-step",
            "status",
            "page"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "node"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^FPR-[0-9]{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "frontier"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^FR-FPR-[A-Z0-9-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "critical-step"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^CP-[0-9]{2}-[a-z0-9-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "page"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "enum": [
                  "roadmap",
                  "orientation",
                  "release-boundary",
                  "source-guidance"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
