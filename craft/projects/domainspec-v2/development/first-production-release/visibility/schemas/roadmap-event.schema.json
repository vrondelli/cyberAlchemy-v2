{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/v2/first-production-release/roadmap-event.schema.json",
  "title": "DomainSpec v2 Roadmap Lab Semantic Event",
  "description": "Exact private message contract carried inside the existing generic ide-extension Canvas interaction. Canvas surface and revision bindings are parent-owned outer request fields and are intentionally forbidden in these payloads.",
  "oneOf": [
    {
      "$ref": "#/$defs/orientation_event"
    },
    {
      "$ref": "#/$defs/restatement_event"
    },
    {
      "$ref": "#/$defs/source_event"
    },
    {
      "$ref": "#/$defs/proposal_event"
    },
    {
      "$ref": "#/$defs/disposition_event"
    }
  ],
  "$defs": {
    "event_type": {
      "const": "ide-extension.canvas.event"
    },
    "event_schema_version": {
      "const": "1.0.0"
    },
    "participant_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "node_id": {
      "type": "string",
      "pattern": "^FPR-[0-9]{2}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "reason_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._:/#-]+$"
    },
    "orientation_event": {
      "type": "object",
      "required": [
        "type",
        "eventName",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/event_type"
        },
        "eventName": {
          "const": "roadmap.orientation.acknowledged"
        },
        "payload": {
          "$ref": "#/$defs/orientation_payload"
        }
      }
    },
    "restatement_event": {
      "type": "object",
      "required": [
        "type",
        "eventName",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/event_type"
        },
        "eventName": {
          "const": "roadmap.restatement.submitted"
        },
        "payload": {
          "$ref": "#/$defs/restatement_payload"
        }
      }
    },
    "source_event": {
      "type": "object",
      "required": [
        "type",
        "eventName",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/event_type"
        },
        "eventName": {
          "const": "roadmap.source.requested"
        },
        "payload": {
          "$ref": "#/$defs/source_payload"
        }
      }
    },
    "proposal_event": {
      "type": "object",
      "required": [
        "type",
        "eventName",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/event_type"
        },
        "eventName": {
          "const": "roadmap.improvement.proposed"
        },
        "payload": {
          "$ref": "#/$defs/proposal_payload"
        }
      }
    },
    "disposition_event": {
      "type": "object",
      "required": [
        "type",
        "eventName",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/event_type"
        },
        "eventName": {
          "const": "roadmap.proposal.disposition.recorded"
        },
        "payload": {
          "$ref": "#/$defs/disposition_payload"
        }
      }
    },
    "orientation_payload": {
      "type": "object",
      "required": [
        "event_schema_version",
        "participant_label",
        "input_fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "event_schema_version": {
          "$ref": "#/$defs/event_schema_version"
        },
        "participant_label": {
          "$ref": "#/$defs/participant_label"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/input_fingerprint"
        }
      }
    },
    "restatement_payload": {
      "type": "object",
      "required": [
        "event_schema_version",
        "participant_label",
        "node_id",
        "input_fingerprint",
        "answers"
      ],
      "additionalProperties": false,
      "properties": {
        "event_schema_version": {
          "$ref": "#/$defs/event_schema_version"
        },
        "participant_label": {
          "$ref": "#/$defs/participant_label"
        },
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/input_fingerprint"
        },
        "answers": {
          "type": "object",
          "required": [
            "meaning",
            "dependency",
            "done_evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "meaning": {
              "$ref": "#/$defs/bounded_text"
            },
            "dependency": {
              "$ref": "#/$defs/bounded_text"
            },
            "done_evidence": {
              "$ref": "#/$defs/bounded_text"
            }
          }
        }
      }
    },
    "source_payload": {
      "type": "object",
      "required": [
        "event_schema_version",
        "participant_label",
        "node_id",
        "input_fingerprint",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "event_schema_version": {
          "$ref": "#/$defs/event_schema_version"
        },
        "participant_label": {
          "$ref": "#/$defs/participant_label"
        },
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/input_fingerprint"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        }
      }
    },
    "proposal_payload": {
      "type": "object",
      "required": [
        "event_schema_version",
        "proposal_id",
        "participant_label",
        "node_id",
        "input_fingerprint",
        "proposal_class",
        "target",
        "observed_original",
        "proposed_change",
        "reason",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "event_schema_version": {
          "$ref": "#/$defs/event_schema_version"
        },
        "proposal_id": {
          "$ref": "#/$defs/proposal_id"
        },
        "participant_label": {
          "$ref": "#/$defs/participant_label"
        },
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/input_fingerprint"
        },
        "proposal_class": {
          "type": "string",
          "enum": [
            "presentation-copy",
            "graph-or-claim",
            "continuation",
            "research-evidence",
            "protected-or-unsupported"
          ]
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/presentation_copy_target"
            },
            {
              "$ref": "#/$defs/graph_claim_target"
            },
            {
              "$ref": "#/$defs/continuation_target"
            },
            {
              "$ref": "#/$defs/research_target"
            },
            {
              "$ref": "#/$defs/protected_target"
            }
          ]
        },
        "observed_original": {
          "$ref": "#/$defs/bounded_text"
        },
        "proposed_change": {
          "$ref": "#/$defs/bounded_text"
        },
        "reason": {
          "$ref": "#/$defs/reason_text"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proposal_class": {
                "const": "presentation-copy"
              }
            },
            "required": [
              "proposal_class"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/presentation_copy_target"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "proposal_class": {
                "const": "graph-or-claim"
              }
            },
            "required": [
              "proposal_class"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/graph_claim_target"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "proposal_class": {
                "const": "continuation"
              }
            },
            "required": [
              "proposal_class"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/continuation_target"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "proposal_class": {
                "const": "research-evidence"
              }
            },
            "required": [
              "proposal_class"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/research_target"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "proposal_class": {
                "const": "protected-or-unsupported"
              }
            },
            "required": [
              "proposal_class"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/protected_target"
              }
            }
          }
        }
      ]
    },
    "presentation_copy_target": {
      "type": "object",
      "required": [
        "field_id"
      ],
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "type": "string",
          "pattern": "^copy\\.(node|frontier|critical-step|status|page)\\.[A-Za-z0-9][A-Za-z0-9._-]*\\.(title|summary|label|body|instruction|status-label)$"
        }
      }
    },
    "graph_claim_target": {
      "type": "object",
      "required": [
        "target_kind",
        "target_id"
      ],
      "additionalProperties": false,
      "properties": {
        "target_kind": {
          "type": "string",
          "enum": [
            "node",
            "edge",
            "claim"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "continuation_target": {
      "type": "object",
      "required": [
        "continuation_kind",
        "target_id"
      ],
      "additionalProperties": false,
      "properties": {
        "continuation_kind": {
          "type": "string",
          "enum": [
            "gap",
            "decision",
            "next-move"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "research_target": {
      "type": "object",
      "required": [
        "claim_target",
        "research_question"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "research_question": {
          "$ref": "#/$defs/reason_text"
        }
      }
    },
    "protected_target": {
      "type": "object",
      "required": [
        "requested_action"
      ],
      "additionalProperties": false,
      "properties": {
        "requested_action": {
          "$ref": "#/$defs/reason_text"
        }
      }
    },
    "disposition_payload": {
      "type": "object",
      "required": [
        "event_schema_version",
        "proposal_id",
        "node_id",
        "input_fingerprint",
        "owner_route",
        "disposition",
        "evidence_kind",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "event_schema_version": {
          "$ref": "#/$defs/event_schema_version"
        },
        "proposal_id": {
          "$ref": "#/$defs/proposal_id"
        },
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/input_fingerprint"
        },
        "owner_route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/ -]*$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "stale-review-required",
            "under-review",
            "accepted",
            "rejected",
            "applied-with-evidence"
          ]
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "review-packet",
            "owner-receipt",
            "application-proof"
          ]
        },
        "evidence_ref": {
          "$ref": "#/$defs/evidence_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "stale-review-required"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "evidence_kind": {
                "const": "review-packet"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "under-review",
                  "accepted",
                  "rejected"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "evidence_kind": {
                "const": "owner-receipt"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "applied-with-evidence"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "evidence_kind": {
                "const": "application-proof"
              }
            }
          }
        }
      ]
    }
  }
}
