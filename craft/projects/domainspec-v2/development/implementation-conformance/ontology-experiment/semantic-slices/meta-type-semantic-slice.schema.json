{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/meta-type-semantic-slice-v1.json",
  "title": "MetaTypeSemanticSlice/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "meta_type_id",
    "architecture_type_id",
    "source_role",
    "language",
    "selector_contract",
    "source_locators",
    "semantic_content",
    "semantic_sha256",
    "status",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "MetaTypeSemanticSlice/v1"},
    "slice_id": {"type": "string", "minLength": 1},
    "meta_type_id": {"type": "string", "minLength": 1},
    "architecture_type_id": {"type": "string", "minLength": 1},
    "source_role": {"enum": ["ontology", "projection", "language-profile"]},
    "language": {"type": ["string", "null"]},
    "selector_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_role", "path"],
        "properties": {
          "document_role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "semantic_content": {"type": "object"},
    "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "candidate"},
    "authority_effect": {"const": "none"}
  }
}
