{
  "schema_version": "MetaTypeSemanticSliceSelector/v1",
  "selector_id": "domainspec.enum-semantic-slice/v1",
  "meta_type_id": "DS-D1.3",
  "architecture_type_id": "architecture.EnumImplementation",
  "roles": [
    "ontology",
    "projection",
    "typescript-profile",
    "python-profile",
    "rust-profile"
  ],
  "selection": {
    "ontology": {
      "concept_roots": [
        "architecture.EnumImplementation",
        "architecture.EnumRepresentationUnit"
      ],
      "include_ancestor_closure": true,
      "property_prefixes": [
        "binding.expected_enum",
        "enum."
      ],
      "required_properties": [
        "binding.concept_id",
        "binding.current",
        "enum.composition_kind",
        "enum.implemented_members"
      ],
      "include_profile_referenced_properties": true,
      "required_relations": [
        "architecture.composed_from"
      ],
      "include_required_operators": true,
      "include_enum_language_projection_portions": true
    },
    "projection": {
      "meta_type_ids": [
        "DS-D1.3"
      ],
      "excluded_root_fields": [
        "counts",
        "mapping_status_values"
      ]
    },
    "profiles": {
      "languages": [
        "typescript",
        "python",
        "rust"
      ],
      "overlay_contract_id": "enum.profile-representation",
      "include_effective_inherited_constraints": true,
      "ordered_fields": [
        "extends"
      ]
    }
  },
  "canonicalization": {
    "object_keys": "utf8-byte-order",
    "selected_sets": "stable-identifier-order-after-duplicate-rejection",
    "precedence_sensitive_arrays": "preserve-source-order"
  },
  "rejections": [
    "missing-selected-id",
    "duplicate-selected-id",
    "unresolved-reference",
    "foreign-selected-reference",
    "unsafe-source-path",
    "schema-or-status-mismatch",
    "authority-inflation"
  ],
  "authority_effect": "none"
}
