{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/orodi-alert-profile-business-ontology/v1",
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "ontology_id", "ontology_type", "branch", "materialization", "package_root", "package_owner", "visibility", "status", "definition_pack_ref", "product_capability_projection_ref", "source_registry", "node_registry", "relation_registry", "residue_registry", "schema_path", "validator_path", "receipt_root", "admission_state", "authority_effect"],
      "properties": {
        "ontology_type": {"const":"business-domain"},
        "branch": {"const":"business"},
        "materialization": {"const":"package-required"},
        "visibility": {"const":"private"},
        "status": {"const":"candidate"},
        "admission_state": {"const":"not-granted"},
        "authority_effect": {"const":"none"}
      }
    }
  }
}
