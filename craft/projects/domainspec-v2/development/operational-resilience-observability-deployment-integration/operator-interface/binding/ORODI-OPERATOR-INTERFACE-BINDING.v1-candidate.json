  "alerting_realization": {
    "provisioning_mode": "file-provisioned",
    "rule_count": 5,
    "rule_uids": [
      "orodi-telemetry-unavailable",
      "orodi-unsafe-candidate-routing",
      "orodi-candidate-degradation",
      "orodi-stable-degradation",
      "orodi-rollback-incomplete"
    ],
    "no_data_state": "Alerting",
    "evaluation_error_state": "Alerting",
    "notification_delivery": {
      "state": "disabled",
      "mute_interval": "orodi-local-evaluation-only",
      "mute_coverage": "00:00-24:00 every day",
      "receiver": "ORODI disabled local sink",
      "sink": "http://127.0.0.1:9/orodi-disabled",
      "sink_boundary": "container loopback only; no external destination or credential"
    },
    "authority_effect": "none"
  },
  "required_checks": [
    {
      "check_id": "ORODI-OI-NON-ACTUATION",
      "requirement": "Grafana alert evaluation, Grafana views, Prometheus, Loki, and Alloy expose no ORODI control-plane token, control endpoint, deployment, rollback, admission, promotion, publication, or release actuation path."
    },
    {
      "check_id": "ORODI-OI-TELEMETRY-CONSERVATION",
      "requirement": "Dashboard queries display observed gateway metric values and missing source telemetry remains missing; no synthetic pass or repaired sample is permitted."
    },
    {
      "check_id": "ORODI-OI-PRIVACY",
      "requirement": "Operational-event resources, bodies, attributes, and labels exclude credentials, control tokens, request bodies, authorization headers, and arbitrary user values."
    },
    {
      "check_id": "ORODI-OI-BOUNDED-CARDINALITY",
      "requirement": "Metric and log labels are limited to declared run, service, event_type, phase, generation, outcome, cohort, status_class, and fault_state fields with finite values where applicable; timestamps and request identifiers are not labels."
    },
    {
      "check_id": "ORODI-OI-EVENT-CONSERVATION",
      "requirement": "Every commissioned install-candidate, candidate-fault activation, rollback, and terminal restoration transition has an append-only structured event retrievable from Loki through the provisioned Grafana datasource."
    },
    {
      "check_id": "ORODI-OI-ROLLBACK-RESTORATION",
      "requirement": "After rollback, control state and metrics show stable_weight=100, candidate_weight=0, candidate_target absent, and candidate_fault_active=false, and the correlated rollback/restoration events remain visible."
    },
    {
      "check_id": "ORODI-OI-LOOPBACK-AND-EPHEMERAL",
      "requirement": "All host-published ports bind to 127.0.0.1, observability state is ephemeral, no Docker socket is mounted, and no external network or named persistent volume is created."
    },
    {
      "check_id": "ORODI-OI-IMMUTABLE-IMAGES",
      "requirement": "Grafana, Loki, and Alloy use exactly the immutable image references frozen by this binding with pull_policy never during commissioning."
    },
    {
      "check_id": "ORODI-OI-ALERT-RULE-SET",
      "requirement": "Exactly five file-provisioned rules exist with the frozen UIDs for telemetry unavailability, unsafe candidate routing, candidate degradation, stable degradation, and incomplete rollback; every rule reads only the provisioned Prometheus datasource and has fixed evidence-only labels."
    },
    {
      "check_id": "ORODI-OI-ALERT-FAIL-CLOSED",
      "requirement": "Every rule maps missing telemetry and evaluation errors to Alerting, preserving no-data and error as operator-attention evidence rather than coercing either state to normal."
    },
    {
      "check_id": "ORODI-OI-NO-EXTERNAL-NOTIFICATION-DELIVERY",
      "requirement": "Every rule is bound to the always-active orodi-local-evaluation-only mute interval and the only receiver is an inert webhook on container loopback port 9; external destinations, contact credentials, host gateways, public bindings, and delivery attempts are forbidden."
    },
    {
