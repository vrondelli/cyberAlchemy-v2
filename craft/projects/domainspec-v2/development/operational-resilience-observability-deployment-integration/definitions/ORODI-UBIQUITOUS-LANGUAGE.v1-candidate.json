  "lexical_policy": {
    "concepts": "Use singular Title Case in prose and PascalCase in code.",
    "operations": "Use imperative domain verbs: Assemble, Record, Evaluate, Aggregate, Analyze, Observe, Project, Verify, Commission.",
    "events": "Use past-tense facts: Assembled, Recorded, Evaluated, Aggregated, Analyzed, Observed, Projected, Verified, Commissioned.",
    "rules": "Use complete declarative must-hold phrases, not vague policy names.",
    "json_fields": "Use lower_snake_case as a mechanical projection of the preferred domain expression.",
    "error_codes": "Use ORODI_<SUBJECT>_<CONDITION> with one stable condition meaning.",
    "generic_noun_rule": "Result, status, data, manager, handler, processor, check, and item are forbidden as unqualified domain nouns.",
    "alias_rule": "ORODI is the only accepted acronym; ORRI and ORDI are not aliases."
  },
  "evidence_state_vocabulary": ["passed", "failed", "missing", "invalid", "inconclusive", "stale", "not-run"],
  "semantic_distinctions": [
    {"left":"Observation","right":"Evidence","rule":"An Observation is recorded input; it becomes supporting Operational Evidence only through exact binding, eligibility, provenance, freshness, and evaluation."},
    {"left":"Evidence","right":"Receipt","rule":"Evidence supports a claim; a Receipt is the immutable record emitted by one operation or evaluation."},
    {"left":"Validate","right":"Evaluate","rule":"Validate checks declared structure or contract conformance. Evaluate applies domain policy to bound evidence and returns an Evidence State."},
    {"left":"Passed","right":"Valid","rule":"Passed is an Evidence State for an evaluated obligation. Valid means structurally conformant to a declared contract. Neither means accepted, admitted, or authorized."},
    {"left":"Analyze Canary","right":"Shift Traffic","rule":"Analyze Canary produces a non-actuating receipt. Shift Traffic is a separately authorized environment effect."},
    {"left":"Evaluate Rollback","right":"Actuate Rollback","rule":"Evaluate Rollback judges restoration evidence. Actuate Rollback changes an environment and belongs to a protected owner."},
    {"left":"Runtime Snapshot","right":"Runtime Evidence","rule":"A Runtime Snapshot is receipt-derived data and remains denied until an admitted observer and authorized run satisfy Runtime Evidence requirements."},
    {"left":"Run-Ready","right":"Commissioned","rule":"Run-Ready means statically prepared and not-run. Commissioned means a separately authorized exercise ran, teardown was observed, and residual state is zero."}
  ],
  "reserved_effect_verbs": {
    "verbs": ["admit", "authorize", "commission", "deploy", "inject fault", "promote", "release", "roll back", "shift traffic", "tear down"],
    "rule": "Use these verbs only for an operation with the corresponding explicit owner and effect authorization. Never use them for validators, observers, evaluators, projections, simulations, plans, or receipts."
  },
