{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec://schemas/meta-type-semantic-enforcement-capability/v1",
  "$defs": {
    "id": {"type":"string","minLength":3,"pattern":"^[A-Za-z0-9][A-Za-z0-9.@_-]*(?:[.-][A-Za-z0-9@_-]+)+$"},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "profile": {"type":"object","required":["schema_version","package_id","package_root","product_capability_ref","business_ontology_ref","definition_ref","status","adoption_decision_ref","predecessor_baseline","material_files","receipt_root","authority_effect","blocked_effects"]},
    "productCapability": {"type":"object","required":["schema_version","capability_id","definition_ref","definition_source","product_ref","business_ontology_ref","outcome","scope","exclusions","participant_refs","consumer_refs","input_contracts","output_contracts","context_policies","owner_routes","lifecycle_posture","realization_bindings","obligations","predecessor","revision_history","challenge_route","authority_effect","claim_limit"]},
    "businessOntology": {"type":"object","required":["schema_version","ontology_id","ontology_type","product_capability_ref","status","source_bindings","nodes","relations","invariants","residue","authority_effect","claim_limit"]},
    "ownerDecision": {"type":"object","required":["schema_version","decision_id","recorded_at","decision_source","selected","candidate_package_digest","invariants","authority_effect"]},
    "receipt": {"type":"object","required":["schema_version","receipt_id","validated_at","package_id","package_digest","checks","result","authority_effect"]}
  }
}
