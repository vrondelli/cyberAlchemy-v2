{
  "dispatch_id": "sic-fac-000-repair-a-route-v1",
  "intent": {
    "raw": "Apply Option A to the bounded generic-factory repair candidate.",
    "objective": "Bind the explicit owner decision to a fresh strict context, material package, Task Session admission, exact 14-target mutation, and fail-closed validation receipt.",
    "target_artifact": "projects/domainspec-v2/development/system-integration-contract-layer/SIC-FAC-000-REPAIR-A/TASK-SESSION-RECEIPT.json"
  },
  "mode": "sequence",
  "techniques": [
    "sequence",
    "approval_semantics_map",
    "artifact_contract_bridge",
    "execution_receipt_handoff",
    "concrete_path_evidence",
    "state_namespace_boundary"
  ],
  "steps": [
    {
      "step_id": "resolve-owner-decision",
      "name": "Resolve the protected semantic owner decision",
      "capability_ref": "decision-gate",
      "capability_status": "local-extension",
      "capability_metadata": {
        "installed_skill": ".agents/skills/decision-gate/SKILL.md",
        "validation_note": "Installed repository-local capability absent from the dispatch validator's current canonical-id allowlist."
      },
      "mode": "resolve",
      "pattern": "decision",
      "inputs": [
        {"kind": "human_answer", "ref": "A"},
        {"kind": "artifact", "ref": "SIC-FAC-000-REPAIR-CANDIDATE/decision-gate/DECISION.md"}
      ],
      "outputs": [
        {"kind": "decision", "ref": "decision-gate/RESOLUTION.json"}
      ],
      "stop_conditions": [
        "the human answer is not one of the presented admissible option identifiers"
      ]
    },
    {
      "step_id": "build-strict-context",
      "name": "Bind the live baseline and exact write frontier",
      "capability_ref": "context-builder",
      "mode": "build",
      "pattern": "sequential",
      "depends_on_steps": ["resolve-owner-decision"],
      "inputs": [
        {"kind": "decision", "ref": "decision-gate/RESOLUTION.json"},
        {"kind": "artifact", "ref": "prior 31-value compatibility audit"}
      ],
      "outputs": [
        {"kind": "artifact", "ref": "context-pack.json"}
      ],
      "stop_conditions": [
        "any audited lock has drifted",
        "the material frontier exceeds 14 product paths"
      ]
    },
    {
      "step_id": "materialize-candidate",
      "name": "Create and validate the exact material package",
      "capability_ref": "invoke",
      "mode": "refresh",
      "pattern": "sequential",
      "depends_on_steps": ["build-strict-context"],
      "inputs": [
        {"kind": "artifact", "ref": "context-pack.json"},
        {"kind": "decision", "ref": "decision-gate/RESOLUTION.json"}
      ],
      "outputs": [
        {"kind": "artifact", "ref": "producer/material-package.json"},
        {"kind": "receipt", "ref": "producer/material-package-receipt.json"}
      ],
      "stop_conditions": [
        "the producer receipt is not current-schema pass with mutationHandoff ready"
      ]
    },
    {
      "step_id": "execute-admitted-task",
      "name": "Apply and validate the admitted candidate",
      "capability_ref": "task-session",
      "mode": "execute",
      "pattern": "validation",
      "depends_on_steps": ["materialize-candidate"],
      "inputs": [
        {"kind": "receipt", "ref": "producer/material-package-receipt.json"},
        {"kind": "artifact", "ref": "mutation-admission-request.json"}
      ],
      "outputs": [
        {"kind": "receipt", "ref": "TASK-SESSION-RECEIPT.json"}
      ],
      "evidence_artifact": "VALIDATION-RESULT.json",
      "stop_conditions": [
        "mutation admission is not admit",
        "any acceptance-critical validation fails"
      ]
    }
  ],
  "gates": [
    {
      "gate_id": "owner-option-a",
      "kind": "human_approval",
      "owner": "family-claim-owners",
      "condition": "Option A explicitly approves the 31 audit-bound provider claims for exactly nine active fixture locks.",
      "on_fail": "block"
    },
    {
      "gate_id": "exact-live-frontier",
      "kind": "quality",
      "owner": "generic-factory-owner",
      "condition": "All 14 product baselines are exact and the 31 current locks equal their audited pre-decision values.",
      "on_fail": "block"
    },
    {
      "gate_id": "material-and-admission",
      "kind": "validation",
      "owner": "invoke-and-task-session",
      "condition": "The material package passes the producer schema and the fresh mutation admission receipt says admit.",
      "on_fail": "block"
    },
    {
      "gate_id": "candidate-validation",
      "kind": "validation",
      "owner": "generic-factory-owner",
      "condition": "Typecheck, full tests, fresh reference and W3 lifecycles, hostile equality probe, semantic hashes, and inventory checks pass on the actual 14 changed product files.",
      "on_fail": "block"
    },
    {
      "gate_id": "no-downstream-promotion",
      "kind": "promotion_guardrail",
      "owner": "system-integration-contract-owner",
      "condition": "Candidate execution must not promote or mutate Revision 2 integration, profile, reviewer, publication, release, or deployment state.",
      "on_fail": "block"
    }
  ],
  "observability": {
    "dispatch_id_required": true,
    "trace_events": [
      "decision.resolved",
      "context.bound",
      "material.validated",
      "mutation.admitted",
      "validation.completed",
      "task.closed"
    ],
    "signal_grouping": "sic-fac-000-repair-a-route-v1"
  },
  "boundary_evidence": {
    "boundaries": [
      {
        "boundary_id": "human-to-candidate",
        "kind": "human_approval",
        "from_owner": "family-claim-owners",
        "to_owner": "generic-factory-owner",
        "applies_to_steps": ["resolve-owner-decision", "build-strict-context"],
        "contract": "A authorizes only the exact 31 audit values and exact 14-target candidate.",
        "on_violation": "block"
      },
      {
        "boundary_id": "material-to-execution",
        "kind": "capability_handoff",
        "from_owner": "invoke",
        "to_owner": "task-session",
        "applies_to_steps": ["materialize-candidate", "execute-admitted-task"],
        "contract": "Task Session consumes exact current-schema producer and admission receipts before product writes.",
        "on_violation": "block"
      },
      {
        "boundary_id": "candidate-evidence-state",
        "kind": "state_write",
        "from_owner": "task-session",
        "to_owner": "generic-factory-owner",
        "applies_to_steps": ["execute-admitted-task"],
        "contract": "Product writes are limited to 14 paths; execution evidence is limited to the fresh candidate root.",
        "on_violation": "block"
      }
    ],
    "authority": {
      "lifecycle": "generic-factory-owner",
      "execution": "task-session",
      "validation": "generic-factory-owner",
      "evidence": "SIC-FAC-000-R2 candidate root",
      "promotion": "system-integration-contract-owner; not granted"
    },
    "receipts": [
      {
        "receipt_id": "material-package-receipt",
        "producer": "invoke",
        "required_fields": ["artifacts", "validation_result", "status"],
        "stores": ["producer/material-package-receipt.json"],
        "on_missing": "block"
      },
      {
        "receipt_id": "task-session-receipt",
        "producer": "task-session",
        "required_fields": ["artifacts", "validation_result", "status", "blockers"],
        "stores": ["TASK-SESSION-RECEIPT.json"],
        "on_missing": "block"
      }
    ],
    "state_namespaces": [
      {
        "namespace": "product",
        "owner": "generic-factory-owner",
        "write_policy": "exact 14 admitted paths only"
      },
      {
        "namespace": "candidate-evidence",
        "owner": "SIC-FAC-000-R2",
        "write_policy": "fresh candidate root only"
      }
    ]
  },
  "promotion_guardrails": [
    "This route does not promote Inventory, ontology, definitions, integration contracts, profiles, Revision 2, publication, release, deployment, or production readiness."
  ]
}
