{
  "$schema": "schemas/profile.schema.json",
  "schema_version": "ontology-vault.profile.v1",
  "ontology_id": "invoke-define-cli.system-runtime.v1",
  "label": "Invoke Define CLI System Runtime Ontology",
  "ontology_type": "system-runtime",
  "status": "candidate",
  "visibility": "private",
  "owner_route": "DomainSpec-v2 Invoke Define experiment owner",
  "authority_effect": "none",
  "type_selection_ref": "TYPE-SELECTION.json",
  "materialization_mode": "package-required",
  "branch_contract": {
    "branches": [
      {
        "branch_id": "system",
        "kind": "system-runtime",
        "root_node_id": "system.invoke-define-cli"
      }
    ],
    "cross_branch_relations": "not-applicable"
  },
  "registries": {
    "sources": "SOURCES.json",
    "nodes": "NODES.json",
    "relations": "RELATIONS.json",
    "views": "VIEWS.json",
    "residue": "RESIDUE.jsonl"
  },
  "schema_bindings": [
    {"artifact": "PROFILE.json", "schema": "schemas/profile.schema.json"},
    {"artifact": "SOURCES.json", "schema": "schemas/sources.schema.json"},
    {"artifact": "NODES.json", "schema": "schemas/nodes.schema.json"},
    {"artifact": "RELATIONS.json", "schema": "schemas/relations.schema.json"},
    {"artifact": "VIEWS.json", "schema": "schemas/views.schema.json"},
    {"artifact": "RESIDUE.jsonl", "schema": "schemas/residue-entry.schema.json"}
  ],
  "allowed_node_roles": [
    "component",
    "interface",
    "workflow",
    "stage",
    "query",
    "artifact",
    "rule",
    "status-axis",
    "evidence-boundary"
  ],
  "allowed_relation_types": [
    "exposes",
    "contains",
    "orders_before",
    "produces",
    "requires",
    "constrains",
    "projects",
    "specified_by"
  ],
  "invariants": [
    {
      "invariant_id": "INV-STAGE-CATALOG-CURRENT",
      "statement": "The ontology stage identities and operation verbs equal the current Define CLI catalog."
    },
    {
      "invariant_id": "INV-WORKFLOW-ORDER",
      "statement": "The Define workflow orders semantic-context, semantic-closure, source, bundle, admission, then status."
    },
    {
      "invariant_id": "INV-STATUS-EVIDENCE-PAIR",
      "statement": "Status resolution requires both the producer stage receipt and the independent admission receipt."
    },
    {
      "invariant_id": "INV-STATUS-AXES-INDEPENDENT",
      "statement": "artifact_authored, registry_released, and mutation_runtime_ready remain separate axes."
    },
    {
      "invariant_id": "INV-NO-PARTIAL-PUBLICATION",
      "statement": "A failed bundle production publishes no partial candidate bundle."
    },
    {
      "invariant_id": "INV-AUTHORITY-NONE",
      "statement": "Ontology and experiment artifacts grant no execution, admission, release, publication, or deployment authority."
    },
    {
      "invariant_id": "INV-WIR-NOT-EXECUTED",
      "statement": "This ontology reuses SWU-WIR-006 as evidence and does not execute or close it."
    }
  ],
  "forbidden_transitions": [
    {
      "transition_id": "FT-BUNDLE-IMPLIES-ADMISSION",
      "from": "artifact.define-candidate-bundle",
      "to": "artifact.define-bundle-admission-receipt",
      "reason": "Only the independent admission stage may produce the admission receipt."
    },
    {
      "transition_id": "FT-STRUCTURE-IMPLIES-AUTHORITY",
      "from": "candidate ontology or compiled graph",
      "to": "execution or release authority",
      "reason": "Structural conformance is evidence, not authority."
    },
    {
      "transition_id": "FT-STATUS-AXIS-COLLAPSE",
      "from": "artifact_authored PASS",
      "to": "registry_released or mutation_runtime_ready PASS",
      "reason": "The capability axes answer separate questions."
    }
  ]
}
