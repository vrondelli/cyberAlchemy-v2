{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/private/schemas/invoke-define-cli-ontology-views/v1",
  "title": "Invoke Define CLI ontology views",
  "type": "object",
  "required": ["schema_version", "views"],
  "properties": {
    "schema_version": {"const": "ontology-vault.views.v1"},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["view_id", "label", "purpose", "allowed_claim", "blocked_claim"],
        "properties": {
          "view_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "omitted_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "relation_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "allowed_claim": {"type": "string", "minLength": 1},
          "blocked_claim": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
