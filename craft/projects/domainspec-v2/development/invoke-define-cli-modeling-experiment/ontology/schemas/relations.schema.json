{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/private/schemas/invoke-define-cli-ontology-relations/v1",
  "title": "Invoke Define CLI ontology relations",
  "type": "object",
  "required": ["schema_version", "relations"],
  "properties": {
    "schema_version": {"const": "ontology-vault.relations.v1"},
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relation_id", "type", "from_node_id", "to_node_id", "source_refs", "authority_effect"],
        "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "from_node_id": {"type": "string", "minLength": 1},
          "to_node_id": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "authority_effect": {"const": "none"}
        }
      }
    }
  }
}
