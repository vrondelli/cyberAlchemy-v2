{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/private/schemas/invoke-define-cli-ontology-residue-entry/v1",
  "title": "Invoke Define CLI ontology residue entry",
  "type": "object",
  "required": ["residue_id", "status", "kind", "statement", "source_refs", "owner_route", "authority_effect"],
  "properties": {
    "residue_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "blocked", "resolved"]},
    "kind": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "owner_route": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  }
}
