{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/private/schemas/invoke-define-cli-ontology-profile/v1",
  "title": "Invoke Define CLI ontology profile",
  "type": "object",
  "required": [
    "schema_version",
    "ontology_id",
    "ontology_type",
    "status",
    "visibility",
    "owner_route",
    "authority_effect",
    "type_selection_ref",
    "materialization_mode",
    "branch_contract",
    "registries",
    "schema_bindings",
    "allowed_node_roles",
    "allowed_relation_types",
    "invariants",
    "forbidden_transitions"
  ],
  "properties": {
    "schema_version": {"const": "ontology-vault.profile.v1"},
    "ontology_id": {"const": "invoke-define-cli.system-runtime.v1"},
    "ontology_type": {"const": "system-runtime"},
    "status": {"const": "candidate"},
    "visibility": {"const": "private"},
    "owner_route": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"},
    "materialization_mode": {"const": "package-required"},
    "allowed_node_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "allowed_relation_types": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "invariants": {"type": "array", "minItems": 1},
    "forbidden_transitions": {"type": "array", "minItems": 1}
  }
}
