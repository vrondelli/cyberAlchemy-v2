{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/private/schemas/invoke-define-cli-ontology-nodes/v1",
  "title": "Invoke Define CLI ontology nodes",
  "type": "object",
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": {"const": "ontology-vault.nodes.v1"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "label", "role", "branch_id", "status", "description", "source_refs", "authority_effect"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "branch_id": {"const": "system"},
          "status": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "authority_effect": {"const": "none"}
        }
      }
    }
  }
}
