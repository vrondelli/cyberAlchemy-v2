{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-p4-rule/v1",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_id",
    "rule_id",
    "edge_id",
    "target_id",
    "obligation",
    "authority",
    "authority_effect",
    "release_admission"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-p4-rule/v1"},
    "semantic_id": {"const": "evf.semantic.financial-settlement.p4.v1"},
    "rule_id": {"const": "financial-settlement.PayoutEligibilityRule"},
    "edge_id": {"const": "financial-settlement.edge.payout-rule-enforces-generation"},
    "target_id": {"const": "financial-settlement.GenerateSettlement"},
    "obligation": {"$ref": "../contracts/financial-settlement-l1-obligations.v1.schema.json#/$defs/obligation"},
    "authority": {"const": "owner-selected-candidate-local-semantic-capsule"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"}
  }
}
