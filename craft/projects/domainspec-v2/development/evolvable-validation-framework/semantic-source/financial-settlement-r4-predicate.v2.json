      "translation_treatment": "owner-supplied-nonnegative-Int-symbol"
    }
  ],
  "assumptions": [
    {"assumption_id": "r4-eligible-positive-makeup", "expression": "totalAppliedMakeup > 0"},
    {"assumption_id": "r4-count-domain", "expression": "sameDateMakeupAppliedCount >= 0"}
  ],
  "predicate": {
    "predicate_id": "financial-settlement.r4.no-duplicate-makeup.general.v2",
    "expression": "shouldCreateMakeupAppliedEvent iff sameDateMakeupAppliedCount = 0",
    "normalized_ast": {
      "operator": "iff",
      "left": {"symbol": "shouldCreateMakeupAppliedEvent"},
      "right": {
        "operator": "eq",
        "left": {"symbol": "sameDateMakeupAppliedCount"},
        "right": {"integer": 0}
      }
    }
  },
  "scope": {
    "included": [
      "R4 pure decision under totalAppliedMakeup > 0",
      "all nonnegative same-date MAKEUP_APPLIED counts",
      "exact type-and-date filtering abstraction"
    ],
    "excluded": [
      "database-write",
      "event-emission",
      "P3",
