  "variables": [
    {"name": "totalAppliedMakeup", "sort": "Int", "role": "owner-premise-input"},
    {"name": "sameDateMakeupAppliedCount", "sort": "Int", "role": "exact-derived-abstraction-input"},
    {"name": "shouldCreateMakeupAppliedEvent", "sort": "Bool", "role": "pure-decision-output"}
  ],
  "abstractions": [
    {
      "abstraction_id": "r4-same-date-makeup-applied-count",
      "output_variable": "sameDateMakeupAppliedCount",
      "definition": "cardinality(existingTransactions where transaction.type = MAKEUP_APPLIED and transaction.date = periodEnd)",
