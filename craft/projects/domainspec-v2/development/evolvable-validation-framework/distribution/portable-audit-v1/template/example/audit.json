    "args": ["--input", "{input}"],
    "tool_files": [],
    "input": "positive.txt",
    "expected": {"outcome": "pass", "reason_code": "ORDER_PRESERVED", "cases": 6, "failed_cases": 0},
    "negative_controls": [{
      "id": "arrival-order-mutant",
      "input": "negative.txt",
      "expected": {"outcome": "fail", "reason_code": "ORDER_MISMATCH", "cases": 6, "failed_cases": 5},
      "reason_code": "ORDER_MISMATCH"
    }]
  }]
