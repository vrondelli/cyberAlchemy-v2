{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-r4-binding/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "binding_id", "unit_id", "obligation_id", "rule_id", "edge_id", "target_id", "decision_field", "semantic_ref", "obligation_spec_ref", "runtime_contract_ref", "runtime_source_ref", "runtime_loader_ref", "fixture_ref", "graph_ref", "source_manifest_ref", "p4_terminal_receipt_ref", "authority_effect", "release_admission", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-r4-binding/v2"},
    "binding_id": {"const": "evf.l1.financial-settlement.r4.binding.v2"},
    "unit_id": {"const": "SWU-GCP-003-R4"},
    "obligation_id": {"const": "evf.l1.financial-settlement.r4.obligation.v1"},
    "rule_id": {"const": "financial-settlement.NoDuplicateMakeupRule"},
    "edge_id": {"const": "financial-settlement.edge.no-duplicate-makeup-rule-enforces-generation"},
    "target_id": {"const": "financial-settlement.GenerateSettlement"},
    "decision_field": {"const": "shouldCreateMakeupAppliedEvent"},
    "semantic_ref": {"$ref": "#/$defs/exactRef"}, "obligation_spec_ref": {"$ref": "#/$defs/exactRef"},
    "runtime_contract_ref": {"$ref": "#/$defs/exactRef"}, "runtime_source_ref": {"$ref": "#/$defs/exactRef"},
    "runtime_loader_ref": {"$ref": "#/$defs/exactRef"}, "fixture_ref": {"$ref": "#/$defs/exactRef"},
    "graph_ref": {"$ref": "#/$defs/exactRef"}, "source_manifest_ref": {"$ref": "#/$defs/exactRef"},
    "p4_terminal_receipt_ref": {"$ref": "#/$defs/exactRef"},
    "authority_effect": {"const": "none"}, "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"const": "candidate-local-r4-pure-decision-with-p4-prerequisite-not-application-equivalence-or-side-effects"}
  },
  "$defs": {"exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}}}}
}
