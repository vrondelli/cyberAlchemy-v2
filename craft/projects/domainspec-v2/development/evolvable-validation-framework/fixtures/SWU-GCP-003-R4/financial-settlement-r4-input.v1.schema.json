{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-r4-input/v1",
  "type": "object",
  "required": ["schema_version", "fixture_id", "cases", "expected_values_forbidden"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-r4-input/v1"},
    "fixture_id": {"const": "evf.l1.financial-settlement.r4.fixture.v1"},
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["case_id", "control_class", "input"],
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "control_class": {"enum": ["truth-table", "other-date", "other-type"]},
          "input": {
            "type": "object",
            "required": ["existingTransactions", "periodEnd", "totalAppliedMakeup", "totalPayout"],
            "additionalProperties": false,
            "properties": {
              "existingTransactions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "date"],
                  "additionalProperties": false,
                  "properties": {"type": {"type": "string"}, "date": {"type": "string", "format": "date"}}
                }
              },
              "periodEnd": {"type": "string", "format": "date"},
              "totalAppliedMakeup": {"type": "integer", "minimum": 1},
              "totalPayout": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "expected_values_forbidden": {"const": true}
  }
}
