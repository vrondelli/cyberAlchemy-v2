{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/evf/key-door-binding-contract/v2",
  "title": "EVF Key And Door Exact Binding Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "obligation_id",
    "edge",
    "predicate_ref",
    "fixture_ref",
    "runtime_contract_ref",
    "ospec_ref",
    "lineage_refs",
    "runtime_source_binding",
    "cardinality"
  ],
  "properties": {
    "schema_version": {
      "const": "evf.key-door-binding-contract/v2"
    },
    "binding_id": {
      "const": "evf.key-door.binding.v2"
    },
    "obligation_id": {
      "const": "evf.s1.enforces.has-key.unlock-door.v1"
    },
    "edge": {
      "const": {
        "edge_id": "key-and-door.edge.has-key-rule-enforces-unlock-door",
        "relationship": "enforces",
        "source_node_id": "key-and-door.HasKeyRule",
        "target_node_id": "key-and-door.UnlockDoor"
      }
    },
    "predicate_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "fixture_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "runtime_contract_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "ospec_ref": {
      "$ref": "#/$defs/exactRef"
    },
    "lineage_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_registry",
        "rule_source",
        "generated_graph",
        "generated_source_manifest"
      ],
      "properties": {
        "relationship_registry": {
          "$ref": "#/$defs/exactRef"
        },
        "rule_source": {
          "$ref": "#/$defs/exactRef"
        },
        "generated_graph": {
          "$ref": "#/$defs/exactRef"
        },
        "generated_source_manifest": {
          "$ref": "#/$defs/exactRef"
        }
      }
    },
    "runtime_source_binding": {
      "const": {
        "path": "projects/domainspec-v2/impl/test-derivation-engine/src/minted-project/fixtures/key-door-runtime.ts",
        "export": "attemptUnlock",
        "version": 1,
        "pre_state": "absent",
        "postimage_digest_owner": "task-session-material-reconciliation",
        "postimage_digest_required_before_execution": true,
        "postimage_ref": {
          "path": "projects/domainspec-v2/impl/test-derivation-engine/src/minted-project/fixtures/key-door-runtime.ts",
          "sha256": "1ba24134f1bb2180abfae7af037238413d55ffe7abbf8fde11020128f5ceb0e8",
          "size_bytes": 323
        }
      }
    },
    "cardinality": {
      "const": "exactly-one-binding-per-obligation"
    }
  },
  "$defs": {
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
