{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-p4-binding/v1",
  "$defs": {
    "exactRef": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "unit_id",
    "obligation_id",
    "rule_id",
    "edge_id",
    "target_id",
    "semantic_ref",
    "obligation_spec_ref",
    "runtime_contract_ref",
    "runtime_source_ref",
    "fixture_ref",
    "graph_ref",
    "source_manifest_ref",
    "authority_effect",
    "release_admission"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-p4-binding/v1"},
    "binding_id": {"const": "evf.l1.financial-settlement.p4.binding.v1"},
    "unit_id": {"const": "SWU-GCP-002-P4"},
    "obligation_id": {"const": "evf.l1.financial-settlement.p4.obligation.v1"},
    "rule_id": {"const": "financial-settlement.PayoutEligibilityRule"},
    "edge_id": {"const": "financial-settlement.edge.payout-rule-enforces-generation"},
    "target_id": {"const": "financial-settlement.GenerateSettlement"},
    "semantic_ref": {"$ref": "#/$defs/exactRef"},
    "obligation_spec_ref": {"$ref": "#/$defs/exactRef"},
    "runtime_contract_ref": {"$ref": "#/$defs/exactRef"},
    "runtime_source_ref": {"$ref": "#/$defs/exactRef"},
    "fixture_ref": {"$ref": "#/$defs/exactRef"},
    "graph_ref": {"$ref": "#/$defs/exactRef"},
    "source_manifest_ref": {"$ref": "#/$defs/exactRef"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"}
  }
}
