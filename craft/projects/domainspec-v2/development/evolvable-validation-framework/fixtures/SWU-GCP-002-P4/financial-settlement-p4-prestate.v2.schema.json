{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-p4-rule-prestate/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prestate_id", "selection_kind", "origin_fixture_ref", "total_payout", "existing_payout_count_for_end_date", "end_date", "expected_effect_values_forbidden", "authority_effect", "release_admission", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-p4-rule-prestate/v2"},
    "prestate_id": {"const": "evf.l1.financial-settlement.p4.rule-prestate.v2"},
    "selection_kind": {"const": "candidate-explicit-rule-prestate-not-application-calculation"},
    "origin_fixture_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "total_payout": {"type": "integer", "minimum": 1},
    "existing_payout_count_for_end_date": {"const": 0},
    "end_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "expected_effect_values_forbidden": {"const": true},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"const": "selected-rule-prestate-only-not-settlement-calculation"}
  }
}
