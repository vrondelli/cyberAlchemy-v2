{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/evf/key-door-input-set/v1",
  "title": "EVF Key And Door Expected-Free Input Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_set_id",
    "authority",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "evf.key-door-input-set/v1"
    },
    "fixture_set_id": {
      "const": "evf.key-door.input-set.v1"
    },
    "authority": {
      "const": "expected-free-input-only"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/trueLockedCase"
        },
        {
          "$ref": "#/$defs/falseLockedCase"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "trueLockedCase": {
      "$ref": "#/$defs/caseBase",
      "properties": {
        "case_id": {
          "const": "has-key-locked"
        },
        "vars": {
          "properties": {
            "has_key": {
              "const": true
            }
          }
        },
        "call_arg": {
          "properties": {
            "has_key": {
              "const": true
            },
            "door_locked": {
              "const": true
            }
          }
        }
      }
    },
    "falseLockedCase": {
      "$ref": "#/$defs/caseBase",
      "properties": {
        "case_id": {
          "const": "no-key-locked-control"
        },
        "vars": {
          "properties": {
            "has_key": {
              "const": false
            }
          }
        },
        "call_arg": {
          "properties": {
            "has_key": {
              "const": false
            },
            "door_locked": {
              "const": true
            }
          }
        }
      }
    },
    "caseBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "vars",
        "call_arg"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "vars": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "has_key"
          ],
          "properties": {
            "has_key": {
              "type": "boolean"
            }
          }
        },
        "call_arg": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "has_key",
            "door_locked"
          ],
          "properties": {
            "has_key": {
              "type": "boolean"
            },
            "door_locked": {
              "const": true
            }
          }
        }
      }
    }
  }
}
