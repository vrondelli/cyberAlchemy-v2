{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/evf/key-door-predicate-source/v1",
  "title": "EVF Key And Door Predicate Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "swu_id",
    "authority",
    "predicate"
  ],
  "properties": {
    "schema_version": {
      "const": "evf.key-door-predicate-source/v1"
    },
    "source_id": {
      "const": "evf.key-door.predicate-source.v1"
    },
    "swu_id": {
      "const": "SWU-GCP-001"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "admission_basis",
        "claim_ceiling",
        "schema_validation_grants_authority"
      ],
      "properties": {
        "kind": {
          "const": "owner-selectable-evf-local-semantic-source"
        },
        "admission_basis": {
          "const": "DEC-GCP-001-R1:option-a"
        },
        "claim_ceiling": {
          "const": "EVF-local-SWU-GCP-001-proof-only"
        },
        "schema_validation_grants_authority": {
          "const": false
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "result_type",
        "ast"
      ],
      "properties": {
        "predicate_id": {
          "const": "evf.key-door.has-key.v1"
        },
        "result_type": {
          "const": "boolean"
        },
        "ast": {
          "$ref": "#/$defs/booleanEquality"
        }
      }
    }
  },
  "$defs": {
    "booleanEquality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "eq"
        },
        "left": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "value_type"
          ],
          "properties": {
            "kind": {
              "const": "variable"
            },
            "name": {
              "const": "has_key"
            },
            "value_type": {
              "const": "boolean"
            }
          }
        },
        "right": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value_type",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value_type": {
              "const": "boolean"
            },
            "value": {
              "const": true
            }
          }
        }
      }
    }
  }
}
