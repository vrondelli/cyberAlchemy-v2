{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://domainspec.dev/evf/financial-settlement-r4-current-validation/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_id", "unit_id", "target_denominator_scope", "target_inventory", "required_mutants", "authority_effect", "release_admission", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-r4-current-validation/v2"},
    "contract_id": {"const": "evf.l1.financial-settlement.r4.current-validation.v2"},
    "unit_id": {"const": "SWU-GCP-003-R4"},
    "target_denominator_scope": {"const": "selected-nonrecursive-inputs"},
    "target_inventory": {"type": "array", "minItems": 19, "maxItems": 19, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}}},
    "required_mutants": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "object", "additionalProperties": false, "required": ["id", "code"], "properties": {"id": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}}}},
    "authority_effect": {"const": "none"}, "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"const": "candidate-local-r4-pure-decision-with-p4-prerequisite-not-application-equivalence-or-side-effects"}
  }
}
