{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://domainspec.dev/evf/financial-settlement-r4-terminal-receipt/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "unit_id", "status", "graph_handle", "p4_terminal_receipt_ref", "evidence", "acceptance_vector", "claim_ceiling", "authority_effect", "release_admission", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-r4-terminal-receipt/v2"},
    "receipt_id": {"const": "evf.l1.financial-settlement.r4.receipt.v2"},
    "unit_id": {"const": "SWU-GCP-003-R4"}, "status": {"const": "pass"},
    "graph_handle": {"type": "object", "additionalProperties": false, "required": ["graph_ref", "source_manifest_ref", "source_set_digest", "profile_digest", "kinds_digest", "relationships_digest", "handle_digest"], "properties": {"graph_ref": {"$ref": "#/$defs/exactRef"}, "source_manifest_ref": {"$ref": "#/$defs/exactRef"}, "source_set_digest": {"$ref": "#/$defs/digest"}, "profile_digest": {"$ref": "#/$defs/digest"}, "kinds_digest": {"$ref": "#/$defs/digest"}, "relationships_digest": {"$ref": "#/$defs/digest"}, "handle_digest": {"$ref": "#/$defs/digest"}}},
    "p4_terminal_receipt_ref": {"$ref": "#/$defs/exactRef"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["binding_ref", "validation_contract_ref", "derivation_ref", "execution_ref", "mutation_report_ref", "test_result_ref", "validation_result_ref"], "properties": {"binding_ref": {"$ref": "#/$defs/exactRef"}, "validation_contract_ref": {"$ref": "#/$defs/exactRef"}, "derivation_ref": {"$ref": "#/$defs/exactRef"}, "execution_ref": {"$ref": "#/$defs/exactRef"}, "mutation_report_ref": {"$ref": "#/$defs/exactRef"}, "test_result_ref": {"$ref": "#/$defs/exactRef"}, "validation_result_ref": {"$ref": "#/$defs/exactRef"}}},
    "acceptance_vector": {"const": {"obligations": 1, "bindings": 1, "p4_prerequisite_replayed": 1, "eligible_execution_cases": 5, "mutants_required": 15, "mutants_killed": 15, "targets": 19, "target_denominator_scope": "selected-nonrecursive-inputs", "tests_passed": 6, "writes_observed": 0, "events_observed": 0}},
    "claim_ceiling": {"const": "candidate-local-r4-pure-decision-with-p4-prerequisite-not-application-equivalence-or-side-effects"},
    "authority_effect": {"const": "none"}, "release_admission": {"const": "not-granted"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}}}}
}
