{
  "schema_version": "evf.graph-law-comparison/v1",
  "comparison_id": "evf.l2.reachability-comparison.v1",
  "property_id": "evf.l2.financial-settlement.rule-to-payout-event-reachability",
  "property_version": "1",
  "required_domain": "exact-closed-world-fact-set",
  "required_join_keys": [
    "request_id",
    "facts_digest",
    "property_id",
    "property_version",
    "property_definition_ref",
    "comparison_contract_ref",
    "universe_digest",
    "evaluation_mode"
  ],
  "mappings": {
    "datalog": {
      "nonempty-complete-violation-relation": "counterexample",
      "empty-complete-violation-relation": "no-counterexample",
      "incomplete-or-invalid": "unresolved"
    },
    "alloy-check": {
      "sat": "counterexample",
      "unsat": "no-counterexample",
      "unknown": "unresolved"
    }
  },
  "join_matrix": [
    {"datalog":"counterexample","alloy":"counterexample","join_status":"consistent","consistency_class":"counterexample-consistent"},
    {"datalog":"no-counterexample","alloy":"no-counterexample","join_status":"consistent","consistency_class":"no-counterexample-consistent-under-declared-bounds"},
    {"datalog":"counterexample","alloy":"no-counterexample","join_status":"unresolved","consistency_class":"provider-disagreement"},
    {"datalog":"no-counterexample","alloy":"counterexample","join_status":"unresolved","consistency_class":"provider-disagreement"},
    {"datalog":"unresolved","alloy":"*","join_status":"unresolved","consistency_class":"provider-disagreement"},
    {"datalog":"*","alloy":"unresolved","join_status":"unresolved","consistency_class":"provider-disagreement"}
  ],
  "provider_precedence": "forbidden",
  "voting": "forbidden",
  "claim_strengthening": "forbidden",
  "authority_effect": "none",
  "release_admission": "not-granted"
}
