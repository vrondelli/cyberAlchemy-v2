{
  "schema_version": "evf.canonicalization-profile/v1",
  "profile_id": "evf-canonical-json/v1",
  "accepted_values": "json-only",
  "numbers": "safe-integers-only-in-digest-payloads",
  "encoding": "utf-8-without-bom",
  "object_key_order": "javascript-utf16-code-unit-ascending",
  "ordered_arrays": "preserve-declared-semantic-order",
  "fact_sorting": {
    "nodes": ["node_id", "feature_id", "kind"],
    "edges": ["edge_id", "predicate", "from", "to"],
    "duplicates": "reject-before-sort"
  },
  "strings": {
    "trim": false,
    "case_fold": false,
    "unicode_normalize": false
  },
  "digest": "sha256-lowercase-hex",
  "facts_digest_material": ["nodes", "edges"],
  "unsupported_values": ["nan", "infinity", "undefined", "non-json-object-members"],
  "authority_effect": "none"
}
