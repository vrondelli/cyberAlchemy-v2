{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/evf/graph-fact-manifest.v1.schema.json",
  "title": "GraphFactManifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "source", "extractor", "projection", "facts", "counts", "validation", "facts_digest", "universe_digest", "authority", "claim_ceiling", "residue"],
  "properties": {
    "schema_version": {"const":"evf.graph-fact-manifest/v1"},
    "manifest_id": {"$ref":"#/$defs/id"},
    "source": {
      "type":"object","additionalProperties":false,
      "required":["graph_ref","graph_schema_ref","source_manifest_ref","project_ref","profile_ref","kinds_ref","relationships_ref","graph_authority_expected","project_id","source_set_digest","registry_digests"],
      "properties": {
        "graph_ref":{"$ref":"#/$defs/exactRef"},"graph_schema_ref":{"$ref":"#/$defs/exactRef"},"source_manifest_ref":{"$ref":"#/$defs/exactRef"},"project_ref":{"$ref":"#/$defs/exactRef"},"profile_ref":{"$ref":"#/$defs/exactRef"},"kinds_ref":{"$ref":"#/$defs/exactRef"},"relationships_ref":{"$ref":"#/$defs/exactRef"},
        "graph_authority_expected":{"const":"generated-semantic-read-model"},"project_id":{"$ref":"#/$defs/id"},"source_set_digest":{"$ref":"#/$defs/digest"},
        "registry_digests":{"type":"object","additionalProperties":false,"required":["profile","kinds","relationships"],"properties":{"profile":{"$ref":"#/$defs/digest"},"kinds":{"$ref":"#/$defs/digest"},"relationships":{"$ref":"#/$defs/digest"}}}
      }
    },
    "extractor": {
      "type":"object","additionalProperties":false,"required":["extractor_id","extractor_version","extractor_ref","configuration_ref","canonicalization_profile_ref","canonicalization_profile"],
      "properties":{"extractor_id":{"$ref":"#/$defs/id"},"extractor_version":{"type":"string","minLength":1},"extractor_ref":{"$ref":"#/$defs/exactRef"},"configuration_ref":{"$ref":"#/$defs/exactRef"},"canonicalization_profile_ref":{"$ref":"#/$defs/exactRef"},"canonicalization_profile":{"const":"evf-canonical-json/v1"}}
    },
    "projection": {
      "type":"object","additionalProperties":false,"required":["node_fields","edge_fields","field_renames","body_omitted","no_inference","no_inverse_generation","no_case_folding","no_unicode_normalization"],
      "properties":{"node_fields":{"const":["node_id","feature_id","kind"]},"edge_fields":{"const":["edge_id","predicate","from","to"]},"field_renames":{"const":{"type":"predicate"}},"body_omitted":{"const":true},"no_inference":{"const":true},"no_inverse_generation":{"const":true},"no_case_folding":{"const":true},"no_unicode_normalization":{"const":true}}
    },
    "facts": {
      "type":"object","additionalProperties":false,"required":["nodes","edges"],
      "properties": {
        "nodes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["node_id","feature_id","kind"],"properties":{"node_id":{"$ref":"#/$defs/id"},"feature_id":{"$ref":"#/$defs/id"},"kind":{"$ref":"#/$defs/id"}}}},
        "edges":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["edge_id","predicate","from","to"],"properties":{"edge_id":{"$ref":"#/$defs/id"},"predicate":{"$ref":"#/$defs/id"},"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"}}}}
      }
    },
    "counts":{"type":"object","additionalProperties":false,"required":["nodes","edges"],"properties":{"nodes":{"type":"integer","minimum":0},"edges":{"type":"integer","minimum":0}}},
    "validation":{"type":"object","additionalProperties":false,"required":["validator_ref","validation_profile_ref","validated_payload_digest","node_ids_unique","edge_ids_unique","endpoints_total","counts_matched","canonical_order_matched","facts_digest_matched","universe_digest_matched","registry_digests_matched","source_set_digest_matched","zero_omitted","zero_invented"],"properties":{"validator_ref":{"$ref":"#/$defs/exactRef"},"validation_profile_ref":{"$ref":"#/$defs/exactRef"},"validated_payload_digest":{"$ref":"#/$defs/digest"},"node_ids_unique":{"const":true},"edge_ids_unique":{"const":true},"endpoints_total":{"const":true},"counts_matched":{"const":true},"canonical_order_matched":{"const":true},"facts_digest_matched":{"const":true},"universe_digest_matched":{"const":true},"registry_digests_matched":{"const":true},"source_set_digest_matched":{"const":true},"zero_omitted":{"const":true},"zero_invented":{"const":true}}},
    "facts_digest":{"$ref":"#/$defs/digest"},
    "universe_digest":{"$ref":"#/$defs/digest"},
    "authority":{"const":"derived-non-authoritative-read-model"},
    "claim_ceiling":{"const":"deterministic-structural-projection-only"},
    "residue":{"type":"array","items":{"type":"object"}}
  },
  "$defs": {
    "id":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "path":{"type":"string","minLength":1,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "exactRef":{"type":"object","additionalProperties":false,"required":["path","sha256","size_bytes"],"properties":{"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/digest"},"size_bytes":{"type":"integer","minimum":0}}}
  }
}
