{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-p4-standalone-runtime/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_id", "unit_id", "mode", "runtime_source_ref", "semantic_ref", "fixture_ref", "observation_contract", "network", "authority_effect", "release_admission", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-p4-standalone-runtime/v2"},
    "runtime_id": {"const": "evf.l1.financial-settlement.p4.standalone-candidate.v2"},
    "unit_id": {"const": "SWU-GCP-002-P4"},
    "mode": {"const": "candidate-standalone-observed-ports"},
    "runtime_source_ref": {"$ref": "#/$defs/exactRef"},
    "semantic_ref": {"$ref": "#/$defs/exactRef"},
    "fixture_ref": {"$ref": "#/$defs/exactRef"},
    "observation_contract": {"const": {"function": "executeStandalonePayoutEffects", "antecedent": "totalPayout > 0 and existingPayoutCountForEndDate = 0", "ordered_effects": ["write:PAYOUT", "event:PayoutCreated"], "observed_at_port_invocation": true, "manufactured_trace_forbidden": true}},
    "network": {"const": "forbidden"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"const": "candidate-local-p4-rule-slice-only-not-application-runtime-or-transaction-atomicity"}
  },
  "$defs": {
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
