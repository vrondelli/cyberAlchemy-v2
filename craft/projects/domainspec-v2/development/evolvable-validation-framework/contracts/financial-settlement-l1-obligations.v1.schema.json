{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-l1-obligations/v1",
  "$defs": {
    "obligation": {
      "type": "object",
      "required": [
        "obligation_id",
        "rule_id",
        "edge_id",
        "relationship",
        "target_id",
        "contract_kind",
        "semantic_contract",
        "excluded_claims"
      ],
      "additionalProperties": false,
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "edge_id": {"type": "string", "minLength": 1},
        "relationship": {"const": "enforces"},
        "target_id": {"const": "financial-settlement.GenerateSettlement"},
        "contract_kind": {"enum": ["ordered-effect-implication", "pure-decision-truth-table"]},
        "semantic_contract": {"type": "object", "minProperties": 1},
        "excluded_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "type": "object",
  "required": ["schema_version", "obligation", "authority_effect", "release_admission"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-l1-obligation/v1"},
    "obligation": {"$ref": "#/$defs/obligation"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"}
  }
}
