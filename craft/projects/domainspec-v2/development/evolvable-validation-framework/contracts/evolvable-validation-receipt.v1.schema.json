{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/evf/evolvable-validation-receipt/v1",
  "title": "EVF Generic Aggregate Validation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "profile_id", "route", "profile_ref",
    "stage_receipts", "aggregate_state", "all_required_stages_present",
    "denominator", "verification_receipt", "evidence_payload_digest",
    "authority_effect", "release_admission", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "evf.evolvable-validation-receipt/v1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "profile_id": {"$ref": "#/$defs/id"},
    "route": {"enum": ["executable", "theorem", "multi_provider"]},
    "profile_ref": {"$ref": "#/$defs/currentRef"},
    "stage_receipts": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "prefixItems": [
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S0"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S1"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S2"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S3"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S4"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S5"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S6"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S7"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S8"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S9"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S10"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S11"}}},
        {"$ref": "#/$defs/stageReceipt", "properties": {"stage_id": {"const": "S12"}}}
      ],
      "items": false
    },
    "aggregate_state": {"$ref": "#/$defs/state"},
    "all_required_stages_present": {"const": true},
    "denominator": {
      "type": "object", "additionalProperties": false,
      "required": ["stages", "checks", "mutations"],
      "properties": {
        "stages": {"const": 13},
        "checks": {"type": "integer", "minimum": 1},
        "mutations": {"type": "integer", "minimum": 1}
      }
    },
    "verification_receipt": {"$ref": "#/$defs/verificationReceipt"},
    "evidence_payload_digest": {"$ref": "#/$defs/sha256"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["passed", "failed", "blocked", "indeterminate", "not_applicable"]},
    "exactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "location", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "location": {"enum": ["repository", "host"]},
        "current": {"type": "boolean"}
      }
    },
    "currentRef": {"allOf": [{"$ref": "#/$defs/exactRef"}, {"properties": {"current": {"const": true}}}]},
    "stageReceipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "stage_id", "profile_id", "route", "state",
        "input_stage_receipt_digests", "evidence_refs", "reason_codes",
        "residue", "details", "claim_ceiling", "authority_effect",
        "receipt_payload_digest"
      ],
      "properties": {
        "schema_version": {"const": "evf.stage-receipt/v1"},
        "stage_id": {"pattern": "^S([0-9]|1[0-2])$"},
        "profile_id": {"$ref": "#/$defs/id"},
        "route": {"enum": ["executable", "theorem", "multi_provider"]},
        "state": {"$ref": "#/$defs/state"},
        "input_stage_receipt_digests": {"type": "object", "propertyNames": {"pattern": "^S([0-9]|1[0-2])$"}, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/exactRef"}},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "residue": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "details": {"type": "object"},
        "claim_ceiling": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"},
        "receipt_payload_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "verificationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "verdict", "verified_stage_ids", "all_refs_current", "replay_equal", "recomputed_aggregate_state", "reason_codes", "authority_effect", "receipt_payload_digest"],
      "properties": {
        "schema_version": {"const": "evf.verification-receipt/v1"},
        "verdict": {"enum": ["passed", "failed", "blocked", "indeterminate"]},
        "verified_stage_ids": {"const": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10"]},
        "all_refs_current": {"type": "boolean"},
        "replay_equal": {"type": "boolean"},
        "recomputed_aggregate_state": {"$ref": "#/$defs/state"},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "authority_effect": {"const": "none"},
        "receipt_payload_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
