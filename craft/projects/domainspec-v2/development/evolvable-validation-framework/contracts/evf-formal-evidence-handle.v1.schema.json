{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/evf/evf-formal-evidence-handle.v1.schema.json",
  "title": "EVF Formal Evidence Handle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handle_id", "request_id", "provider_receipt_ref", "evidence_kind", "normalized_outcome", "proof_status", "residue", "authority_effect", "release_admission", "claim_ceiling", "handle_payload_digest"],
  "properties": {
    "schema_version": {"const": "evf.formal-evidence-handle/v1"},
    "handle_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "provider_receipt_ref": {"$ref": "#/$defs/exactRef"},
    "evidence_kind": {"enum": ["lean-theorem", "lean-elaboration"]},
    "normalized_outcome": {"enum": ["theorem-checked", "elaboration-checked", "unresolved"]},
    "proof_status": {"enum": ["lean-theorem-declarations-checked", "not-established-no-theorem-declaration", "not-established-no-bound-theorem-declaration", "not-established"]},
    "residue": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"enum": ["exact-lean-theorem-declarations-checked-only", "lean-elaboration-only-no-theorem-proof", "no-proof-claim"]},
    "handle_payload_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
