{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/evf/product-candidate-manifest/v1",
  "title": "EVF Product Candidate Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "selected_decisions", "artifact_groups",
    "runtime_refs", "candidate_payload_digest", "claim_ceiling", "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "evf.product-candidate-manifest/v1"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "selected_decisions": {
      "type": "object", "additionalProperties": false,
      "required": ["EVF-DEC-001", "EVF-DEC-002", "EVF-DEC-003", "selection_ref"],
      "properties": {
        "EVF-DEC-001": {"const": "B"},
        "EVF-DEC-002": {"const": "A"},
        "EVF-DEC-003": {"const": "C"},
        "selection_ref": {"$ref": "#/$defs/currentRef"}
      }
    },
    "artifact_groups": {
      "type": "object", "additionalProperties": false,
      "required": ["governance", "contracts", "ontology", "implementation", "profiles", "fixtures", "formalization", "consumer"],
      "properties": {
        "governance": {"$ref": "#/$defs/nonEmptyRefs"},
        "contracts": {"$ref": "#/$defs/nonEmptyRefs"},
        "ontology": {"$ref": "#/$defs/nonEmptyRefs"},
        "implementation": {"$ref": "#/$defs/nonEmptyRefs"},
        "profiles": {"$ref": "#/$defs/nonEmptyRefs"},
        "fixtures": {"$ref": "#/$defs/nonEmptyRefs"},
        "formalization": {"$ref": "#/$defs/nonEmptyRefs"},
        "consumer": {"$ref": "#/$defs/nonEmptyRefs"}
      }
    },
    "runtime_refs": {"$ref": "#/$defs/nonEmptyRefs"},
    "candidate_payload_digest": {"$ref": "#/$defs/sha256"},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "currentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "location", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "location": {"enum": ["repository", "host"]},
        "current": {"const": true}
      }
    },
    "nonEmptyRefs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/currentRef"}
    }
  }
}
