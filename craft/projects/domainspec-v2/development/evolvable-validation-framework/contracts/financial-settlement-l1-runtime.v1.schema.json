{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-l1-runtime/v1",
  "$defs": {
    "exactRef": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "runtime_id",
    "unit_id",
    "mode",
    "runtime_source_ref",
    "observation_contract",
    "network",
    "authority_effect",
    "release_admission"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-l1-runtime/v1"},
    "runtime_id": {"type": "string", "minLength": 1},
    "unit_id": {"enum": ["SWU-GCP-002-P4", "SWU-GCP-003-R4"]},
    "mode": {"enum": ["actual-effect-adapter", "actual-pure-decision"]},
    "runtime_source_ref": {"$ref": "#/$defs/exactRef"},
    "observation_contract": {"type": "object", "minProperties": 1},
    "network": {"const": "forbidden"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"}
  }
}
