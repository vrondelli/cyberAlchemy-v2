{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-l1-composite-receipt/v1",
  "$defs": {
    "exactRef": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "status",
    "unit_receipts",
    "identity_denominators",
    "shared_handle_digest",
    "join_checks",
    "claim_ceiling",
    "authority_effect",
    "release_admission",
    "receipt_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-l1-composite-receipt/v1"},
    "receipt_id": {"const": "evf.l1.financial-settlement.composite.receipt.v1"},
    "status": {"const": "pass"},
    "unit_receipts": {
      "type": "object",
      "required": ["p4", "r4"],
      "additionalProperties": false,
      "properties": {"p4": {"$ref": "#/$defs/exactRef"}, "r4": {"$ref": "#/$defs/exactRef"}}
    },
    "identity_denominators": {"type": "object", "minProperties": 7},
    "shared_handle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "join_checks": {"type": "object", "minProperties": 5},
    "claim_ceiling": {"const": "candidate-local-two-distinct-financial-settlement-rule-slices-over-one-frozen-graph-source-handle-only"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
