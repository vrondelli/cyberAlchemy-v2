{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-l1-receipt/v1",
  "$defs": {
    "exactRef": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "unit_id",
    "status",
    "identities",
    "graph_handle",
    "evidence_refs",
    "acceptance_vector",
    "claim_ceiling",
    "authority_effect",
    "release_admission",
    "receipt_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-l1-receipt/v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "unit_id": {"enum": ["SWU-GCP-002-P4", "SWU-GCP-003-R4"]},
    "status": {"const": "pass"},
    "identities": {"type": "object", "minProperties": 6},
    "graph_handle": {
      "type": "object",
      "required": [
        "graph_ref",
        "source_manifest_ref",
        "source_set_digest",
        "profile_digest",
        "kinds_digest",
        "relationships_digest",
        "handle_digest"
      ],
      "properties": {
        "graph_ref": {"$ref": "#/$defs/exactRef"},
        "source_manifest_ref": {"$ref": "#/$defs/exactRef"},
        "source_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kinds_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "relationships_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "handle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/exactRef"}},
    "acceptance_vector": {"type": "object", "minProperties": 4},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
