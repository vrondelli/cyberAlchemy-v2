      "decision_field": "shouldCreateMakeupAppliedEvent",
      "truth_table": [
        {"case_id": "r4-zero-same-date", "same_date_makeup_applied_count": 0, "expected": true},
        {"case_id": "r4-one-same-date", "same_date_makeup_applied_count": 1, "expected": false},
        {"case_id": "r4-two-same-date", "same_date_makeup_applied_count": 2, "expected": false},
        {"case_id": "r4-other-date-control", "same_date_makeup_applied_count": 0, "expected": true},
        {"case_id": "r4-other-type-control", "same_date_makeup_applied_count": 0, "expected": true}
      ]
    },
    "excluded_claims": [
      "database-write",
      "event-emission",
      "P3",
      "full-settlement-preconditions"
    ]
  },
  "authority_effect": "none",
  "release_admission": "not-granted"
}
