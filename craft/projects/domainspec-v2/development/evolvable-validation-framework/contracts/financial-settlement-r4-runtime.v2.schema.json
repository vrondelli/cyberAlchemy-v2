{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/evf/financial-settlement-r4-standalone-runtime/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "unit_id",
    "mode",
    "runtime_source_ref",
    "semantic_ref",
    "fixture_ref",
    "observation_contract",
    "network",
    "authority_effect",
    "release_admission",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "evf.financial-settlement-r4-standalone-runtime/v2"},
    "runtime_id": {"const": "evf.l1.financial-settlement.r4.standalone-candidate.v2"},
    "unit_id": {"const": "SWU-GCP-003-R4"},
    "mode": {"const": "candidate-standalone-pure-decision"},
    "runtime_source_ref": {"$ref": "#/$defs/exactRef"},
    "semantic_ref": {"$ref": "#/$defs/exactRef"},
    "fixture_ref": {"$ref": "#/$defs/exactRef"},
    "observation_contract": {
      "const": {
        "function": "decideStandaloneMakeupApplied",
        "decision_field": "shouldCreateMakeupAppliedEvent",
        "truth_table_cases": 5,
        "fixed_premise": "totalAppliedMakeup > 0",
        "writes_observed": false,
        "events_observed": false
      }
    },
    "network": {"const": "forbidden"},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"const": "candidate-local-pure-decision-only-not-application-runtime"}
  },
  "$defs": {
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
