{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/evf/key-door-obligation-set/v2",
  "title": "EVF Key And Door Validation Obligation Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "obligation_set_id",
    "authority",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "const": "evf.key-door-obligation-set/v2"
    },
    "obligation_set_id": {
      "const": "evf.key-door.ospec.v2"
    },
    "authority": {
      "const": "validation-evidence-only-not-semantic-authority"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "const": {
            "obligation_id": "evf.s1.enforces.has-key.unlock-door.v1",
            "edge_id": "key-and-door.edge.has-key-rule-enforces-unlock-door",
            "relationship": "enforces",
            "source_node_id": "key-and-door.HasKeyRule",
            "target_node_id": "key-and-door.UnlockDoor",
            "predicate_id": "evf.key-door.has-key.v1",
            "binding_id": "evf.key-door.binding.v2"
          }
        }
      ],
      "items": false
    }
  }
}
