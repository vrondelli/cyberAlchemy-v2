{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/ape.typescript-operation-application-profile.candidate-v1.json",
  "title": "APE TypeScript Operation Application Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "language",
    "subject_meta_type_id",
    "evidence_lane",
    "portable_semantics",
    "rmt_semantic_policy",
    "properties",
    "property_denominator",
    "authority_effect"
  ],
  "properties": {
    "schema_version": { "const": "ape.architecture-profile/v1" },
    "profile_id": { "const": "APE.ArchitectureProfile.TypeScriptOperationApplication/candidate-v1" },
    "version": { "const": "0.1.0-candidate" },
    "language": { "const": "typescript" },
    "subject_meta_type_id": { "const": "Operation" },
    "evidence_lane": { "const": "candidate-local-prototype" },
    "portable_semantics": { "const": false },
    "rmt_semantic_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rule_ordering", "operation_contract_ref", "operation_contract_sha256"],
      "properties": {
        "mode": { "const": "reference-only" },
        "rule_ordering": { "const": "not-promoted" },
        "operation_contract_ref": { "$ref": "#/$defs/repositoryRef" },
        "operation_contract_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.outcome-cohesion" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.value-effect-placement" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.hof-direction" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.role-contract-specificity" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.repository-boundary" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.unit-of-work-boundary" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.event-handler-stage" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.durable-intent-stage" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.external-transport-stage" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.cost-observation" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.traversal-equivalence" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.pure-rule-placement" } } }] },
        { "allOf": [{ "$ref": "#/$defs/property" }, { "properties": { "property_id": { "const": "APE.ImplementationProperty.operation.instrumentation-placement" } } }] }
      ],
      "items": false
    },
    "property_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_property_ids", "count", "sha256"],
      "properties": {
        "ordered_property_ids": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            { "const": "APE.ImplementationProperty.operation.outcome-cohesion" },
            { "const": "APE.ImplementationProperty.operation.value-effect-placement" },
            { "const": "APE.ImplementationProperty.operation.hof-direction" },
            { "const": "APE.ImplementationProperty.operation.role-contract-specificity" },
            { "const": "APE.ImplementationProperty.operation.repository-boundary" },
            { "const": "APE.ImplementationProperty.operation.unit-of-work-boundary" },
            { "const": "APE.ImplementationProperty.operation.event-handler-stage" },
            { "const": "APE.ImplementationProperty.operation.durable-intent-stage" },
            { "const": "APE.ImplementationProperty.operation.external-transport-stage" },
            { "const": "APE.ImplementationProperty.operation.cost-observation" },
            { "const": "APE.ImplementationProperty.operation.traversal-equivalence" },
            { "const": "APE.ImplementationProperty.operation.pure-rule-placement" },
            { "const": "APE.ImplementationProperty.operation.instrumentation-placement" }
          ],
          "items": false
        },
        "count": { "const": 13 },
        "sha256": { "const": "7aa69ff1927bbd26e1cd8bde453baae17cde326881b66f3d93dc48c6f344ab86" }
      }
    },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "valueDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": { "const": "enum" },
        "values": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "applicabilityPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression", "when_true", "when_false", "when_unresolved"],
      "properties": {
        "kind": {
          "enum": ["always", "profile-selected", "effectful-dependency-present", "dependency-role-present", "declared-capability", "source-reference-present"]
        },
        "expression": { "$ref": "#/$defs/nonEmptyString" },
        "when_true": { "const": "applicable" },
        "when_false": { "const": "not-applicable" },
        "when_unresolved": { "const": "owner-blocked" }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "value_domain",
        "valid_subjects",
        "observation_stage",
        "owner_route",
        "forbidden_inferences",
        "applicability_predicate",
        "portable_semantics"
      ],
      "properties": {
        "property_id": { "type": "string", "pattern": "^APE\\.ImplementationProperty\\.operation\\.[a-z0-9-]+$" },
        "value_domain": { "$ref": "#/$defs/valueDomain" },
        "valid_subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "Operation" }],
          "items": false
        },
        "observation_stage": { "enum": ["dependency", "boundary", "cost", "integration", "evaluation"] },
        "owner_route": { "$ref": "#/$defs/nonEmptyString" },
        "forbidden_inferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "applicability_predicate": { "$ref": "#/$defs/applicabilityPredicate" },
        "portable_semantics": { "const": false }
      }
    }
  }
}
