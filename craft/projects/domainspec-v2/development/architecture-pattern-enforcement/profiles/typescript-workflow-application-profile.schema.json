{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/typescript-workflow-application-profile.schema.json",
  "title": "TypeScript Workflow Application Architecture Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "language",
    "subject_meta_type_id",
    "evidence_lane",
    "portable_semantics",
    "rmt_semantic_policy",
    "properties",
    "property_denominator",
    "authority_effect"
  ],
  "properties": {
    "schema_version": { "const": "ape.architecture-profile/v1" },
    "profile_id": { "const": "APE.ArchitectureProfile.TypeScriptWorkflowApplication/candidate-v1" },
    "version": { "const": "0.1.0-candidate" },
    "language": { "const": "typescript" },
    "subject_meta_type_id": { "const": "Workflow" },
    "evidence_lane": { "const": "candidate-local-prototype" },
    "portable_semantics": { "const": false },
    "rmt_semantic_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "workflow_candidate_ref",
        "workflow_candidate_sha256",
        "workflow_projection_receipt_ref",
        "workflow_projection_receipt_sha256",
        "semantic_hostiles_owned_by_rmt",
        "profile_may_reinterpret_semantics"
      ],
      "properties": {
        "mode": { "const": "reference-only" },
        "workflow_candidate_ref": { "$ref": "#/$defs/repositoryRef" },
        "workflow_candidate_sha256": { "$ref": "#/$defs/sha256" },
        "workflow_projection_receipt_ref": { "$ref": "#/$defs/repositoryRef" },
        "workflow_projection_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "semantic_hostiles_owned_by_rmt": { "const": true },
        "profile_may_reinterpret_semantics": { "const": false }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "$ref": "#/$defs/propertyP01" },
        { "$ref": "#/$defs/propertyP02" },
        { "$ref": "#/$defs/propertyP03" },
        { "$ref": "#/$defs/propertyP04" },
        { "$ref": "#/$defs/propertyP05" },
        { "$ref": "#/$defs/propertyP06" },
        { "$ref": "#/$defs/propertyP07" },
        { "$ref": "#/$defs/propertyP08" },
        { "$ref": "#/$defs/propertyP09" }
      ],
      "items": false
    },
    "property_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_property_ids", "count", "sha256"],
      "properties": {
        "ordered_property_ids": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            { "const": "APE.WF.P01-NAMED-ORCHESTRATION" },
            { "const": "APE.WF.P02-CHILD-AUTHORITY" },
            { "const": "APE.WF.P03-HOF-STEPS" },
            { "const": "APE.WF.P04-MODE-APPLICABILITY" },
            { "const": "APE.WF.P05-STEP-LOCAL-TRANSACTION" },
            { "const": "APE.WF.P06-CONTINUATION" },
            { "const": "APE.WF.P07-DURABLE-CAPABILITIES" },
            { "const": "APE.WF.P08-TRANSPORT-BOUNDARIES" },
            { "const": "APE.WF.P09-TRAVERSAL-EQUIVALENCE" }
          ],
          "items": false
        },
        "count": { "const": 9 },
        "sha256": { "const": "dcafa4b33d08181f0dd7ecf92aef5a27c2b0e059ece49f60c876b6578f586279" }
      }
    },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryRef": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "propertyBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "value_domain",
        "valid_subjects",
        "observation_stage",
        "owner_route",
        "forbidden_inferences",
        "applicability_predicate",
        "portable_semantics"
      ],
      "properties": {
        "property_id": { "type": "string" },
        "value_domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "enum" },
            "values": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "valid_subjects": { "type": "array", "prefixItems": [{ "const": "Workflow" }], "minItems": 1, "maxItems": 1, "items": false },
        "observation_stage": { "enum": ["child-binding", "mode", "continuation", "durable-runtime", "message-boundary", "compensation"] },
        "owner_route": { "type": "string", "minLength": 1 },
        "forbidden_inferences": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "applicability_predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expression", "when_true", "when_false", "when_unresolved"],
          "properties": {
            "kind": { "enum": ["always", "owner-declaration", "workflow-mode", "message-placement"] },
            "expression": { "type": "string", "minLength": 1 },
            "when_true": { "const": "applicable" },
            "when_false": { "const": "not-applicable" },
            "when_unresolved": { "const": "owner-blocked" }
          }
        },
        "portable_semantics": { "const": false }
      }
    },
    "propertyP01": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P01-NAMED-ORCHESTRATION" } } }] },
    "propertyP02": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P02-CHILD-AUTHORITY" } } }] },
    "propertyP03": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P03-HOF-STEPS" } } }] },
    "propertyP04": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P04-MODE-APPLICABILITY" } } }] },
    "propertyP05": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P05-STEP-LOCAL-TRANSACTION" } } }] },
    "propertyP06": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P06-CONTINUATION" } } }] },
    "propertyP07": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P07-DURABLE-CAPABILITIES" } } }] },
    "propertyP08": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P08-TRANSPORT-BOUNDARIES" } } }] },
    "propertyP09": { "allOf": [{ "$ref": "#/$defs/propertyBase" }, { "properties": { "property_id": { "const": "APE.WF.P09-TRAVERSAL-EQUIVALENCE" } } }] }
  }
}
