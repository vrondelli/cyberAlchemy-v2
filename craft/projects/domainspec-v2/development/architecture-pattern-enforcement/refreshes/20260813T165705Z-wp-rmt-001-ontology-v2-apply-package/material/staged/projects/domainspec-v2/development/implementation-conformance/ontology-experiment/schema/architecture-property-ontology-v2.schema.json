{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec://schemas/architecture-property-ontology-v2",
  "title": "DomainSpec architecture-property ontology v2",
  "description": "Schema for architecture definitions, evidence-bound implementation instances, typed relation instances, separated lifecycle axes, and owner-gated promotion records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_id",
    "model_kind",
    "status",
    "authority_effect",
    "document_mode",
    "definition_source_refs",
    "migration_evidence_refs",
    "historical_preimage_refs",
    "lifecycle_policy",
    "concept_types",
    "property_definitions",
    "relation_definitions",
    "constraint_operators",
    "language_projections",
    "implementation_instances",
    "supporting_instances",
    "relation_instances",
    "relation_instance_blueprints",
    "promotion_records",
    "projection_policy",
    "derived_projection",
    "derived_supporting_projection",
    "derived_relation_projection"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec-architecture-property-ontology/v2"
    },
    "ontology_id": {
      "type": "string",
      "minLength": 1
    },
    "model_kind": {
      "const": "architecture-property-ontology"
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed-candidate",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "document_mode": {
      "enum": [
        "preview",
        "live"
      ]
    },
    "preview_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "proposal-only"
    },
    "base_ontology_ref": {
      "$ref": "#/$defs/fileRef"
    },
    "base_projection_ref": {
      "$ref": "#/$defs/fileRef"
    },
    "terminal_receipt_ref": {
      "$ref": "#/$defs/fileRef"
    },
    "definition_catalogue_mode": {
      "const": "external-v1-reference-for-preview"
    },
    "definition_source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definitionSourceRef"
      },
      "minItems": 1
    },
    "migration_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "minItems": 1
    },
    "historical_preimage_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "minItems": 2
    },
    "lifecycle_policy": {
      "$ref": "#/$defs/lifecyclePolicy"
    },
    "concept_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conceptTypeDefinition"
      }
    },
    "property_definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyDefinition"
      }
    },
    "relation_definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationDefinition"
      }
    },
    "constraint_operators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraintOperator"
      }
    },
    "language_projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageProjection"
      }
    },
    "implementation_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/implementationInstance"
      }
    },
    "supporting_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supportingInstance"
      }
    },
    "relation_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationInstance"
      }
    },
    "promotion_records": {
      "type": "array",
      "items": {
        "$ref": "domainspec://schemas/promotion-record-v1"
      }
    },
    "projection_policy": {
      "$ref": "#/$defs/projectionPolicy"
    },
    "derived_projection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectionRow"
      }
    },
    "derived_supporting_projection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supportingProjectionRow"
      }
    },
    "derived_relation_projection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationProjectionRow"
      }
    },
    "relation_instance_blueprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationBlueprint"
      },
      "uniqueItems": true
    },
    "migration_readiness": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "document_mode": {
            "const": "preview"
          }
        },
        "required": [
          "document_mode"
        ]
      },
      "then": {
        "required": [
          "preview_id",
          "mode",
          "base_ontology_ref",
          "base_projection_ref",
          "terminal_receipt_ref",
          "definition_catalogue_mode"
        ]
      },
      "else": {
        "properties": {
          "concept_types": {
            "minItems": 1
          },
          "property_definitions": {
            "minItems": 1
          },
          "relation_definitions": {
            "minItems": 1
          },
          "constraint_operators": {
            "minItems": 1
          },
          "language_projections": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "conceptTypeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "label",
        "abstract",
        "extends",
        "concept_role",
        "source_refs",
        "owner_route",
        "candidate_status",
        "confidence",
        "challenge_contract",
        "forbidden_collapse"
      ],
      "properties": {
        "concept_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "abstract": {
          "type": "boolean"
        },
        "extends": {
          "type": [
            "string",
            "null"
          ]
        },
        "concept_role": {
          "enum": [
            "evidence object",
            "projection object",
            "system object",
            "workflow object"
          ]
        },
        "canonical_meta_type_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/metaTypeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_mapping_status": {
          "enum": [
            "architecture-role-only",
            "candidate-alignment"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "candidate_status": {
          "enum": [
            "candidate",
            "deferred",
            "projected"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "challenge_contract": {
          "$ref": "#/$defs/challengeContract"
        },
        "forbidden_collapse": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "canonical_meta_type_ref": [
          "canonical_mapping_status"
        ],
        "canonical_mapping_status": [
          "canonical_meta_type_ref"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "canonical_mapping_status": {
                "const": "architecture-role-only"
              }
            },
            "required": [
              "canonical_mapping_status"
            ]
          },
          "then": {
            "properties": {
              "canonical_meta_type_ref": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "canonical_meta_type_ref": {
                "$ref": "#/$defs/metaTypeId"
              }
            }
          }
        }
      ]
    },
    "propertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "label",
        "value_type",
        "applies_to",
        "semantics",
        "observation_stage",
        "owner_route",
        "forbidden_inference"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "$ref": "#/$defs/propertyValueType"
        },
        "applies_to": {
          "$ref": "#/$defs/propertySubjectSet"
        },
        "type_value_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeValueContract"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        },
        "observation_stage": {
          "type": "string",
          "minLength": 1
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_inference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "direction",
        "source_types",
        "target_types",
        "properties",
        "owner_route",
        "evidence_refs",
        "authority_effect",
        "value_effect",
        "cycle_policy",
        "forbidden_collapse"
      ],
      "properties": {
        "relation_id": {
          "$ref": "#/$defs/relationTypeId"
        },
        "direction": {
          "const": "directed"
        },
        "source_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_type_pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_type",
              "target_type"
            ],
            "properties": {
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "target_type": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authority_effect": {
          "const": "none"
        },
        "value_effect": {
          "enum": [
            "value-free",
            "value-constraining"
          ]
        },
        "cycle_policy": {
          "enum": [
            "acyclic",
            "cycle-permitted",
            "not-applicable"
          ]
        },
        "forbidden_collapse": {
          "type": "string",
          "minLength": 1
        },
        "candidate_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_id",
        "candidate_id",
        "status",
        "reason",
        "authority_effect"
      ],
      "properties": {
        "blueprint_id": {
          "$ref": "#/$defs/relationBlueprintId"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate\\.[a-z0-9][a-z0-9.-]*/v[0-9]+$"
        },
        "relation_type_ref": {
          "$ref": "#/$defs/relationTypeId"
        },
        "relation_type_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationTypeId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "const": "deferred"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authority_effect": {
          "const": "none"
        }
      },
      "oneOf": [
        {
          "required": [
            "relation_type_ref"
          ]
        },
        {
          "required": [
            "relation_type_refs"
          ]
        }
      ]
    },
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_confidence",
        "commitment_confidence"
      ],
      "properties": {
        "evidence_confidence": {
          "enum": [
            "low",
            "medium"
          ]
        },
        "commitment_confidence": {
          "const": "low"
        }
      }
    },
    "challengeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_challenge_modes",
        "resolution_gate"
      ],
      "properties": {
        "valid_challenge_modes": {
          "type": "array",
          "items": {
            "enum": [
              "evidence",
              "contradiction",
              "owner_review"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resolution_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "propertyValueType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minimum"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "minimum": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "values": {
              "$ref": "#/$defs/nonEmptyUniqueStringArray"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/arrayItemValueType"
            }
          }
        }
      ]
    },
    "arrayItemValueType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "required",
            "properties",
            "additional_properties"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "required": {
              "const": [
                "key",
                "value"
              ]
            },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "$ref": "#/$defs/inlineStringValueType"
                },
                "value": {
                  "$ref": "#/$defs/inlineStringValueType"
                }
              }
            },
            "additional_properties": {
              "const": false
            }
          }
        }
      ]
    },
    "inlineStringValueType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "string"
        }
      }
    },
    "propertySubjectSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "types"
      ],
      "properties": {
        "kind": {
          "enum": [
            "node",
            "relation"
          ]
        },
        "types": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        }
      }
    },
    "typeValueContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "allowed_values"
      ],
      "properties": {
        "type_id": {
          "type": "string",
          "minLength": 1
        },
        "allowed_values": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        }
      }
    },
    "constraintOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id",
        "accepted_value_types",
        "expected_operand_kinds"
      ],
      "properties": {
        "operator_id": {
          "enum": [
            "required",
            "equals",
            "matches",
            "one_of",
            "set_equals",
            "unique",
            "non_empty",
            "cardinality"
          ]
        },
        "accepted_value_types": {
          "type": "array",
          "items": {
            "enum": [
              "array",
              "boolean",
              "enum",
              "integer",
              "string"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_operand_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "cardinality-spec",
              "literal",
              "property-ref"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "languageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "language",
        "projection_kind",
        "source_refs",
        "observes",
        "native_surfaces",
        "unsupported",
        "allowed_use",
        "blocked_use",
        "drift_owner",
        "expiry_or_review_trigger"
      ],
      "properties": {
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "typescript",
            "python",
            "rust"
          ]
        },
        "projection_kind": {
          "const": "candidate-map"
        },
        "source_refs": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "observes": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "native_surfaces": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "unsupported": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "allowed_use": {
          "type": "string",
          "minLength": 1
        },
        "blocked_use": {
          "type": "string",
          "minLength": 1
        },
        "drift_owner": {
          "type": "string",
          "minLength": 1
        },
        "expiry_or_review_trigger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "jsonObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "json_pointer"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
        }
      }
    },
    "endpointAssertionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "json_pointer",
        "assertion_spec",
        "identity_field",
        "architecture_type_field"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
        },
        "assertion_spec": {
          "enum": [
            "candidate-architecture-implementation/v1",
            "instance-endpoint-assertion/v1",
            "node-endpoint-assertion/v1"
          ]
        },
        "identity_field": {
          "enum": [
            "concept_id",
            "definition_id",
            "instance_id",
            "node_id"
          ]
        },
        "architecture_type_field": {
          "enum": [
            "type_id",
            "architecture_type_ref"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "assertion_spec",
            "identity_field",
            "architecture_type_field"
          ],
          "properties": {
            "assertion_spec": {
              "const": "candidate-architecture-implementation/v1"
            },
            "identity_field": {
              "enum": [
                "concept_id",
                "definition_id"
              ]
            },
            "architecture_type_field": {
              "const": "type_id"
            }
          }
        },
        {
          "required": [
            "assertion_spec",
            "identity_field",
            "architecture_type_field"
          ],
          "properties": {
            "assertion_spec": {
              "const": "instance-endpoint-assertion/v1"
            },
            "identity_field": {
              "const": "instance_id"
            },
            "architecture_type_field": {
              "const": "architecture_type_ref"
            }
          }
        },
        {
          "required": [
            "assertion_spec",
