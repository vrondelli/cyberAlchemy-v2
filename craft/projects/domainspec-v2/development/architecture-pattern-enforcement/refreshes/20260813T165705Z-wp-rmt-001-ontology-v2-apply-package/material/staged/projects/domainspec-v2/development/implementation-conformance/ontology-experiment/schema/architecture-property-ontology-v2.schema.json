          "$ref": "#/$defs/implementationLifecycleAxes"
        },
        "promotion_record_ref": {
          "$ref": "#/$defs/promotionRecordId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "admission_status": {
                    "const": "admitted"
                  }
                },
                "required": [
                  "admission_status"
                ]
              }
            }
          },
          "then": {
            "required": [
              "promotion_record_ref"
            ],
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "authority_effect": {
                    "const": "canonical-admission"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "authority_effect": {
                    "const": "none"
                  }
                }
              }
            },
            "not": {
              "required": [
                "promotion_record_ref"
              ]
            }
          }
        }
      ]
