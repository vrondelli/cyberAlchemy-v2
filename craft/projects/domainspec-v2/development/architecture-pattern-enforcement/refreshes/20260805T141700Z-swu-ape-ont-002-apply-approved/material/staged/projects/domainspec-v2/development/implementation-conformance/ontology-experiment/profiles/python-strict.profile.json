{
  "schema_version": "domainspec-architecture-profile/v1",
  "profile_id": "architecture.python-strict",
  "status": "candidate",
  "language": "python",
  "extends": ["./base-domain.profile.json"],
  "constraints": [
    {
      "constraint_id": "python.rule-location",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.RuleImplementation"],
      "property_id": "source.path",
      "operator": "matches",
      "expected": "^src/domain/rules/[a-z0-9_]+\\.py$",
      "severity": "error"
    },
    {
      "constraint_id": "python.operation-location",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.OperationImplementation"],
      "property_id": "source.path",
      "operator": "matches",
      "expected": "^src/application/(operations|use_cases)/[a-z0-9_]+\\.py$",
      "severity": "error"
    },
    {
      "constraint_id": "python.filename-snake-case",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.DomainConceptImplementation"],
      "property_id": "source.filename_case",
      "operator": "equals",
      "expected": "snake_case",
      "severity": "error"
    },
    {
      "constraint_id": "python.one-public-callable",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.DomainConceptImplementation"],
      "property_id": "symbol.public_callable_count",
      "operator": "equals",
      "expected": 1,
      "severity": "error"
    },
    {
      "constraint_id": "python.rule-function-definition",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.RuleImplementation"],
      "property_id": "callable.form",
      "operator": "equals",
      "expected": "function-definition",
      "severity": "error"
    },
    {
      "constraint_id": "python.operation-rule-direct-leaf",
      "constraint_kind": "relation-property",
      "relation_type": "architecture.depends_on",
      "source_types": ["architecture.OperationImplementation"],
      "target_types": ["architecture.RuleImplementation"],
      "property_id": "dependency.resolution",
      "operator": "equals",
      "expected": "direct-leaf",
      "severity": "error"
    }
  ],
  "authority_effect": "none"
}
