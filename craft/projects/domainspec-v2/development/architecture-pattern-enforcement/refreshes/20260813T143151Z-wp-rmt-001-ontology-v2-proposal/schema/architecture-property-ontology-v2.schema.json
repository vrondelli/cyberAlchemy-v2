{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec://schemas/architecture-property-ontology-v2",
  "title": "DomainSpec architecture-property ontology v2",
  "description": "Schema for architecture definitions, evidence-bound implementation instances, typed relation instances, separated lifecycle axes, and owner-gated promotion records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_id",
    "model_kind",
    "status",
    "authority_effect",
    "document_mode",
    "definition_source_refs",
    "migration_evidence_refs",
    "historical_preimage_refs",
    "lifecycle_policy",
    "concept_types",
    "property_definitions",
    "relation_definitions",
    "constraint_operators",
    "language_projections",
    "implementation_instances",
    "supporting_instances",
    "relation_instances",
    "promotion_records",
    "projection_policy",
    "derived_projection",
    "derived_supporting_projection",
    "derived_relation_projection"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec-architecture-property-ontology/v2"
    },
    "ontology_id": {
      "type": "string",
      "minLength": 1
    },
    "model_kind": {
      "const": "architecture-property-ontology"
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed-candidate",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "authority_effect": {
      "const": "none"
    },
    "document_mode": {
      "enum": [
        "preview",
        "live"
      ]
    },
    "preview_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "proposal-only"
    },
    "base_ontology_ref": {
      "$ref": "#/$defs/fileRef"
    },
    "base_projection_ref": {
      "$ref": "#/$defs/fileRef"
    },
    "terminal_receipt_ref": {
      "$ref": "#/$defs/fileRef"
    },
    "definition_catalogue_mode": {
      "const": "external-v1-reference-for-preview"
    },
    "definition_source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definitionSourceRef"
      },
      "minItems": 1
    },
    "migration_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "minItems": 1
    },
    "historical_preimage_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      },
      "minItems": 2
    },
    "lifecycle_policy": {
      "$ref": "#/$defs/lifecyclePolicy"
    },
    "concept_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conceptTypeDefinition"
      }
    },
    "property_definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/propertyDefinition"
      }
    },
    "relation_definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationDefinition"
      }
    },
    "constraint_operators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraintOperator"
      }
    },
    "language_projections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageProjection"
      }
    },
    "implementation_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/implementationInstance"
      }
    },
    "supporting_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supportingInstance"
      }
    },
    "relation_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationInstance"
      }
    },
    "promotion_records": {
      "type": "array",
      "items": {
        "$ref": "domainspec://schemas/promotion-record-v1"
      }
    },
    "projection_policy": {
      "$ref": "#/$defs/projectionPolicy"
    },
    "derived_projection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectionRow"
      }
    },
    "derived_supporting_projection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supportingProjectionRow"
      }
    },
    "derived_relation_projection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationProjectionRow"
      }
    },
    "relation_instance_blueprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationBlueprint"
      }
    },
    "migration_readiness": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "document_mode": {
            "const": "preview"
          }
        },
        "required": [
          "document_mode"
        ]
      },
      "then": {
        "required": [
          "preview_id",
          "mode",
          "base_ontology_ref",
          "base_projection_ref",
          "terminal_receipt_ref",
          "definition_catalogue_mode"
        ]
      },
      "else": {
        "properties": {
          "concept_types": {
            "minItems": 1
          },
          "property_definitions": {
            "minItems": 1
          },
          "relation_definitions": {
            "minItems": 1
          },
          "constraint_operators": {
            "minItems": 1
          },
          "language_projections": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "conceptTypeDefinition": {
      "type": "object",
      "required": [
        "concept_id"
      ],
      "properties": {
        "concept_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "propertyDefinition": {
      "type": "object",
      "required": [
        "property_id"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationDefinition": {
      "type": "object",
      "required": [
        "relation_id"
      ],
      "properties": {
        "relation_id": {
          "$ref": "#/$defs/relationTypeId"
        }
      }
    },
    "relationBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "status",
        "reason"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type_ref": {
          "$ref": "#/$defs/relationTypeId"
        },
        "relation_type_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationTypeId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "const": "deferred-exact-endpoint-materialization"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "relation_type_ref"
          ]
        },
        {
          "required": [
            "relation_type_refs"
          ]
        }
      ]
    },
    "constraintOperator": {
      "type": "object",
      "required": [
        "operator_id"
      ],
      "properties": {
        "operator_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "languageProjection": {
      "type": "object",
      "required": [
        "projection_id",
        "language"
      ],
      "properties": {
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "definitionSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "path",
        "sha256",
        "use"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "use": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementationLifecycleAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta_type_maturity",
        "definition_status",
        "evidence_status",
        "admission_status",
        "authority_effect"
      ],
      "properties": {
        "meta_type_maturity": {
          "enum": [
            "candidate",
            "active",
            "deferred",
            "superseded",
            "retired"
          ]
        },
        "definition_status": {
          "enum": [
            "candidate",
            "reviewed-candidate",
            "stable",
            "deprecated",
            "retired"
          ]
        },
        "evidence_status": {
          "enum": [
            "unobserved",
            "candidate",
            "validated-candidate",
            "superseded",
            "withdrawn"
          ]
        },
        "admission_status": {
          "enum": [
            "not-admitted",
            "proposed",
            "admitted"
          ]
        },
        "authority_effect": {
          "enum": [
            "none",
            "canonical-admission"
          ]
        }
      }
    },
    "relationLifecycleAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_status",
        "evidence_status",
        "admission_status",
        "authority_effect"
      ],
      "properties": {
        "definition_status": {
          "enum": [
            "candidate",
            "reviewed-candidate",
            "stable",
            "deprecated",
            "retired"
          ]
        },
        "evidence_status": {
          "enum": [
            "unobserved",
            "candidate",
            "validated-candidate",
            "superseded",
            "withdrawn"
          ]
        },
        "admission_status": {
          "enum": [
            "not-admitted",
            "proposed",
            "admitted"
          ]
        },
        "authority_effect": {
          "enum": [
            "none",
            "canonical-admission"
          ]
        }
      }
    },
    "languageRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "node_id",
        "provider_id",
        "protocol_id"
      ],
      "properties": {
        "language": {
          "enum": [
            "typescript",
            "python",
            "rust"
          ]
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "form_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementationInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_instance_id",
        "candidate_id",
        "canonical_meta_type_ref",
        "architecture_type_ref",
        "candidate_ref",
        "projection_receipt_ref",
        "terminal_receipt_ref",
        "language_realizations",
        "lifecycle_axes"
      ],
      "properties": {
        "implementation_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_meta_type_ref": {
          "$ref": "#/$defs/metaTypeId"
        },
        "architecture_type_ref": {
          "$ref": "#/$defs/architectureImplementationId"
        },
        "concept_or_definition_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ref": {
          "$ref": "#/$defs/fileRef"
        },
        "projection_receipt_ref": {
          "$ref": "#/$defs/fileRef"
        },
        "terminal_receipt_ref": {
          "$ref": "#/$defs/fileRef"
        },
        "language_realizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/languageRealization"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "lifecycle_axes": {
          "$ref": "#/$defs/implementationLifecycleAxes"
        },
        "promotion_record_ref": {
          "$ref": "#/$defs/promotionRecordId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "admission_status": {
                    "const": "admitted"
                  }
                },
                "required": [
                  "admission_status"
                ]
              }
            }
          },
          "then": {
            "required": [
              "promotion_record_ref"
            ],
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "authority_effect": {
                    "const": "canonical-admission"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "authority_effect": {
                    "const": "none"
                  }
                }
              }
            },
            "not": {
              "required": [
                "promotion_record_ref"
              ]
            }
          }
        }
      ]
    },
    "supportingInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supporting_instance_id",
        "candidate_id",
        "canonical_meta_type_ref",
        "architecture_type_ref",
        "source_identity_pointer",
        "evidence_refs",
        "lifecycle_axes"
      ],
      "properties": {
        "supporting_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_meta_type_ref": {
          "$ref": "#/$defs/metaTypeId"
        },
        "architecture_type_ref": {
          "$ref": "#/$defs/architectureTypeId"
        },
        "source_identity_pointer": {
          "type": "string",
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileRef"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "lifecycle_axes": {
          "allOf": [
            {
              "$ref": "#/$defs/relationLifecycleAxes"
            },
            {
              "properties": {
                "admission_status": {
                  "const": "not-admitted"
                },
                "authority_effect": {
                  "const": "none"
                }
              }
            }
          ]
        }
      }
    },
    "relationInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_instance_id",
        "candidate_id",
        "canonical_meta_type_ref",
        "relation_type_ref",
        "source_instance_ref",
        "target_instance_ref",
        "source_type_ref",
        "target_type_ref",
        "evidence_refs",
        "cycle_policy",
        "lifecycle_axes"
      ],
      "properties": {
        "relation_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_meta_type_ref": {
          "$ref": "#/$defs/metaTypeId"
        },
        "relation_type_ref": {
          "$ref": "#/$defs/relationTypeId"
        },
        "source_instance_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_instance_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_type_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_type_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileRef"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "cycle_policy": {
          "enum": [
            "acyclic",
            "not-applicable"
          ]
        },
        "lifecycle_axes": {
          "$ref": "#/$defs/relationLifecycleAxes"
        },
        "promotion_record_ref": {
          "$ref": "#/$defs/promotionRecordId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "admission_status": {
                    "const": "admitted"
                  }
                },
                "required": [
                  "admission_status"
                ]
              }
            }
          },
          "then": {
            "required": [
              "promotion_record_ref"
            ],
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "authority_effect": {
                    "const": "canonical-admission"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "lifecycle_axes": {
                "properties": {
                  "authority_effect": {
                    "const": "none"
                  }
                }
              }
            },
            "not": {
              "required": [
                "promotion_record_ref"
              ]
            }
          }
        }
      ]
    },
    "promotionRecordId": {
      "type": "string",
      "pattern": "^promotion\\.[a-z0-9][a-z0-9._/-]*/v[0-9]+$"
    },
    "metaTypeId": {
      "type": "string",
      "pattern": "^DS-D1\\.[0-9]+$"
    },
    "architectureImplementationId": {
      "type": "string",
      "pattern": "^architecture\\.[A-Za-z0-9]+Implementation$"
    },
    "architectureTypeId": {
      "type": "string",
      "pattern": "^architecture\\.[A-Za-z0-9]+$"
    },
    "relationTypeId": {
      "type": "string",
      "pattern": "^architecture\\.[a-z][a-z0-9_]*$"
    },
    "lifecyclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_independence",
        "admission_transition_owner",
        "authority_source",
        "candidate_self_promotion",
        "projection_authorship"
      ],
      "properties": {
        "axis_independence": {
          "const": [
            "meta_type_maturity",
            "definition_status",
            "evidence_status",
            "admission_status",
            "authority_effect"
          ]
        },
        "admission_transition_owner": {
          "const": "accepted-owner-gated-PromotionRecord"
        },
        "authority_source": {
          "const": "PromotionRecord.owner_acceptance"
        },
        "candidate_self_promotion": {
          "const": "forbidden"
        },
        "projection_authorship": {
          "const": "forbidden"
        }
      }
    },
    "projectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sources",
        "may_author_lifecycle",
        "may_grant_authority"
      ],
      "properties": {
        "kind": {
          "const": "derived-read-model"
        },
        "sources": {
          "const": [
            "implementation_instances",
            "supporting_instances",
            "relation_instances",
            "promotion_records"
          ]
        },
        "may_author_lifecycle": {
          "const": false
        },
        "may_grant_authority": {
          "const": false
        }
      }
    },
    "projectionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_instance_id",
        "candidate_id",
        "canonical_meta_type_ref",
        "architecture_type_ref",
        "meta_type_maturity",
        "definition_status",
        "evidence_status",
        "admission_status",
        "authority_effect",
        "promotion_record_ref"
      ],
      "properties": {
        "implementation_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_meta_type_ref": {
          "$ref": "#/$defs/metaTypeId"
        },
        "architecture_type_ref": {
          "$ref": "#/$defs/architectureImplementationId"
        },
        "meta_type_maturity": {
          "type": "string"
        },
        "definition_status": {
          "type": "string"
        },
        "evidence_status": {
          "type": "string"
        },
        "admission_status": {
          "type": "string"
        },
        "authority_effect": {
          "type": "string"
        },
        "promotion_record_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "supportingProjectionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supporting_instance_id",
        "candidate_id",
        "canonical_meta_type_ref",
        "architecture_type_ref",
        "source_identity_pointer",
        "definition_status",
        "evidence_status",
        "admission_status",
        "authority_effect"
      ],
      "properties": {
        "supporting_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_meta_type_ref": {
          "$ref": "#/$defs/metaTypeId"
        },
        "architecture_type_ref": {
          "$ref": "#/$defs/architectureTypeId"
        },
        "source_identity_pointer": {
          "type": "string",
          "minLength": 1
        },
        "definition_status": {
          "type": "string"
        },
        "evidence_status": {
          "type": "string"
        },
        "admission_status": {
          "const": "not-admitted"
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "relationProjectionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_instance_id",
        "candidate_id",
        "canonical_meta_type_ref",
        "relation_type_ref",
        "source_instance_ref",
        "target_instance_ref",
        "definition_status",
        "evidence_status",
        "admission_status",
        "authority_effect",
        "promotion_record_ref"
      ],
      "properties": {
        "relation_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_meta_type_ref": {
          "$ref": "#/$defs/metaTypeId"
        },
