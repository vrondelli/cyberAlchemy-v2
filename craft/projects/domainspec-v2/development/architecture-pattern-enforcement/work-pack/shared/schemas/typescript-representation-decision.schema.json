{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/ape-enum-typescript-representation-decision-v1.json",
  "title": "APE TypeScript Enum representation decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "swu_id",
    "language",
    "canonical_concept_ref",
    "evidence_date",
    "owner",
    "bindings",
    "selected_protocol",
    "representation_decisions",
    "provider_status",
    "profile_activation",
    "claim_ceiling",
    "authority_effect",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": "ape.enum.typescript-representation-decision.v1"
    },
    "decision_id": {
      "const": "APE-ENUM-TS-REPRESENTATION-001"
    },
    "swu_id": {
      "const": "SWU-APE-ENUM-TS-001"
    },
    "language": {
      "const": "typescript"
    },
    "canonical_concept_ref": {
      "const": "DS-D1.3 Enum"
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "owner_role", "authorization_ref"],
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_role": {
          "const": "typescript-architecture-profile-owner"
        },
        "authorization_ref": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontology",
        "profile",
        "dependency_receipt",
        "schema",
        "validator",
        "owner_authorization"
      ],
      "properties": {
        "ontology": {"$ref": "#/$defs/artifactRef"},
        "profile": {"$ref": "#/$defs/artifactRef"},
        "dependency_receipt": {"$ref": "#/$defs/artifactRef"},
        "schema": {"$ref": "#/$defs/artifactRef"},
        "validator": {"$ref": "#/$defs/artifactRef"},
        "owner_authorization": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "selected_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "form_id",
        "selection_state",
        "module_path",
        "required_exports"
      ],
      "properties": {
        "protocol_id": {
          "const": "typescript.owned-const-object-enum/v1"
        },
        "form_id": {
          "const": "typescript.owned-const-object-enum"
        },
        "selection_state": {
          "const": "selected-for-materialization"
        },
        "module_path": {
          "const": "projects/domainspec-v2/impl/architecture-conformance/typescript/runtime/enum/index.ts"
        },
        "required_exports": {
          "type": "array",
          "prefixItems": [
            {"const": "defineEnum"},
            {"const": "composeEnum"},
            {"const": "EnumValue"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "representation_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representationDecision"
      },
      "minItems": 7,
      "maxItems": 7
    },
    "provider_status": {
      "const": "unmaterialized-until-SWU-APE-ENUM-TS-001A"
    },
    "profile_activation": {
      "const": "deferred-to-SWU-APE-ENUM-TS-001B"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "none"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_swu", "allowed_effect"],
      "properties": {
        "next_swu": {
          "const": "SWU-APE-ENUM-TS-001A"
        },
        "allowed_effect": {
          "const": "runtime-provider-materialization-only"
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer"
        }
      }
    },
    "representationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_id", "category", "disposition", "reason"],
      "properties": {
        "form_id": {
          "enum": [
            "typescript.owned-const-object-enum",
            "typescript.native-enum",
            "typescript.standalone-literal-union",
            "typescript.bare-const-object",
            "typescript.arbitrary-factory",
            "typescript.raw-spread-or-computed-member",
            "typescript.helper-name-impersonation"
          ]
        },
        "category": {
          "enum": ["candidate-form", "analysis-boundary"]
        },
        "disposition": {
          "enum": ["selected-for-materialization", "rejected", "unsupported"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
