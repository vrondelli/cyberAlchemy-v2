{
  "schema_version": "domainspec-architecture-profile/v1",
  "profile_id": "architecture.typescript-strict",
  "status": "candidate",
  "language": "typescript",
  "extends": ["./base-domain.profile.json"],
  "representation_overlays": [
    {
      "contract_id": "enum.profile-representation",
      "language": "typescript",
      "selection_mode": "external-owner-decision",
      "admitted_forms": [],
      "rejected_forms": [],
      "unsupported_forms": [],
      "missing_decision_outcome": "unselected",
      "language_mismatch_outcome": "unsupported",
      "owner_route": "typescript-architecture-profile-owner",
      "representation_constraints": []
    }
  ],
  "constraints": [
    {
      "constraint_id": "typescript.rule-location",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.RuleImplementation"],
      "property_id": "source.path",
      "operator": "matches",
      "expected": "^src/domain/rules/[a-z0-9-]+\\.ts$",
      "severity": "error"
    },
    {
      "constraint_id": "typescript.operation-location",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.OperationImplementation"],
      "property_id": "source.path",
      "operator": "matches",
      "expected": "^src/application/(operations|use-cases)/[a-z0-9-]+\\.ts$",
      "severity": "error"
    },
    {
      "constraint_id": "typescript.filename-kebab-case",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.DomainConceptImplementation"],
      "property_id": "source.filename_case",
      "operator": "equals",
      "expected": "kebab-case",
      "severity": "error"
    },
    {
      "constraint_id": "typescript.one-public-callable",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.DomainConceptImplementation"],
      "property_id": "symbol.public_callable_count",
      "operator": "equals",
      "expected": 1,
      "severity": "error"
    },
    {
      "constraint_id": "typescript.rule-arrow-only",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.RuleImplementation"],
      "property_id": "callable.form",
      "operator": "equals",
      "expected": "arrow-function",
      "severity": "error"
    },
    {
      "constraint_id": "typescript.operation-rule-direct-leaf",
      "constraint_kind": "relation-property",
      "relation_type": "architecture.depends_on",
      "source_types": ["architecture.OperationImplementation"],
      "target_types": ["architecture.RuleImplementation"],
      "property_id": "dependency.resolution",
      "operator": "equals",
      "expected": "direct-leaf",
      "severity": "error"
    }
  ],
  "authority_effect": "none"
}
