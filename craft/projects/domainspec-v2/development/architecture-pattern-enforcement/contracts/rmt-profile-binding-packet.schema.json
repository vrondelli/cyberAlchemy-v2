{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/ape.rmt-profile-binding-packet.v1.json",
  "title": "APE RMT Profile Binding Packet",
  "description": "Evidence-only binding of one exact WP-RMT-002 subject to one APE profile denominator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "rmt_subject",
    "predecessor_evidence",
    "profile",
    "observations",
    "bindings",
    "infrastructure_joins",
    "accounting",
    "stale_input",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "ape.rmt-profile-binding-packet/v1"
    },
    "packet_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "rmt_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_pack_id",
        "meta_type_id",
        "subject_id",
        "realization_contract"
      ],
      "properties": {
        "work_pack_id": {
          "const": "WP-RMT-002"
        },
        "meta_type_id": {
          "enum": [
            "Operation",
            "Workflow"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "realization_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "digest"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/repositoryRef"
            },
            "digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "predecessor_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_evidence_lane",
        "receipt_ref",
        "receipt_digest",
        "result",
        "claim_ceiling",
        "synchronized_task_session_closeout"
      ],
      "properties": {
        "required_evidence_lane": {
          "enum": [
            "candidate-local-prototype",
            "canonical-governance"
          ]
        },
        "receipt_ref": {
          "$ref": "#/$defs/repositoryRef"
        },
        "receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "result": {
          "const": "pass"
        },
        "claim_ceiling": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "synchronized_task_session_closeout": {
          "type": "boolean"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_profile_id",
        "architecture_profile_version",
        "implementation_property_denominator_digest"
      ],
      "properties": {
        "architecture_profile_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture_profile_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementation_property_denominator_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "infrastructure_joins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/infrastructureJoin"
      }
    },
    "accounting": {
      "$ref": "#/$defs/accounting"
    },
    "stale_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "mismatches"
      ],
      "properties": {
        "result": {
          "enum": [
            "pass",
            "block"
          ]
        },
        "mismatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mismatch"
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_only",
        "authority_effect",
        "synchronized_closeout_claim",
        "prohibited_claims"
      ],
      "properties": {
        "evidence_only": {
          "const": true
        },
        "authority_effect": {
          "const": "none"
        },
        "synchronized_closeout_claim": {
          "type": "boolean"
        },
        "prohibited_claims": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "const": "semantic admission"
            },
            {
              "const": "infrastructure guarantee beyond a joined record"
            },
            {
              "const": "profile admission"
            },
            {
              "const": "promotion"
            },
            {
              "const": "publication"
            },
            {
              "const": "release"
            },
            {
              "const": "production readiness"
            }
          ],
          "items": false
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "projection_kind",
        "property_id",
        "implementation_binding_id",
        "source_ref",
        "source_digest",
        "observed_value",
        "provenance_ref"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "projection_kind": {
          "enum": [
            "observed",
            "derived",
            "owner-resolved",
            "unsupported"
          ]
        },
        "property_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementation_binding_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_ref": {
          "$ref": "#/$defs/repositoryRef"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "observed_value": true,
        "provenance_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_binding_id",
        "dependency_role",
        "consumer_contract_ref",
        "adapter_ref",
        "adapter_digest"
      ],
      "properties": {
        "implementation_binding_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dependency_role": {
          "enum": [
            "repository",
            "unit-of-work",
            "event-handler",
            "outbox-repository",
            "transporter",
            "client",
            "clock",
            "generator",
            "hasher",
            "codec",
            "metrics-recorder",
            "workflow-store",
            "scheduler",
            "typed-config"
          ]
        },
        "consumer_contract_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "adapter_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "adapter_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "infrastructureJoin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_id",
        "dependency_observation_id",
        "concern_kind",
        "external_record_ref",
        "external_record_digest",
        "external_record_status",
        "observation_ceiling"
      ],
      "properties": {
        "join_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dependency_observation_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "concern_kind": {
          "enum": [
            "persistence",
            "transaction",
            "failure",
            "transport",
            "delivery",
            "workflow-runtime"
          ]
        },
        "external_record_ref": {
          "$ref": "#/$defs/repositoryRef"
        },
        "external_record_digest": {
          "$ref": "#/$defs/sha256"
        },
        "external_record_status": {
          "enum": [
            "pass",
            "fail",
            "missing",
            "unsupported",
            "owner-blocked"
          ]
        },
        "observation_ceiling": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator_property_ids",
        "applicability_results",
        "applicable_property_ids",
        "non_applicable_property_ids",
        "owner_blocked_applicability_ids",
        "property_results",
        "result_counts",
        "unaccounted_property_ids"
      ],
      "properties": {
        "denominator_property_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "applicability_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applicabilityResult"
          }
        },
        "applicable_property_ids": {
          "$ref": "#/$defs/propertyIdArray"
        },
        "non_applicable_property_ids": {
          "$ref": "#/$defs/propertyIdArray"
        },
        "owner_blocked_applicability_ids": {
          "$ref": "#/$defs/propertyIdArray"
        },
        "property_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyResult"
          }
        },
        "result_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail",
            "missing",
            "unsupported",
            "owner_blocked",
            "not_applicable"
          ],
          "properties": {
            "pass": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "fail": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "missing": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "unsupported": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "owner_blocked": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "not_applicable": {
              "$ref": "#/$defs/nonNegativeInteger"
            }
          }
        },
        "unaccounted_property_ids": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "propertyIdArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "applicabilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "applicability",
        "basis",
        "evidence_ref"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "applicability": {
          "enum": [
            "applicable",
            "not-applicable",
            "owner-blocked"
          ]
        },
        "basis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "propertyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "result",
        "finding_ref"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "missing",
            "unsupported",
            "owner-blocked"
          ]
        },
        "finding_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "expected_digest",
        "actual_digest"
      ],
      "properties": {
        "selector": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expected_digest": {
          "$ref": "#/$defs/sha256"
        },
        "actual_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "const": "missing"
            }
          ]
        }
      }
    }
  }
}
