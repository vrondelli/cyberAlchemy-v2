{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/workflow-type-completion-receipt.schema.json",
  "title": "Workflow Type Completion Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "evidence_lane",
    "result",
    "subject",
    "predecessor",
    "profile",
    "fixture",
    "findings",
    "accounting",
    "material_inventory",
    "claim_ceiling",
    "synchronized_task_session_closeout",
    "authority_effect",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": "ape.workflow-type-completion-receipt/v1" },
    "receipt_id": { "$ref": "#/$defs/nonEmpty" },
    "evidence_lane": { "const": "candidate-local-prototype" },
    "result": { "enum": ["pass", "fail", "incomplete"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta_type_id", "subject_id", "candidate_sha256", "source_sha256"],
      "properties": {
        "meta_type_id": { "const": "Workflow" },
        "subject_id": { "const": "candidate.settlement.ordered-workflow.workflow-implementation/v1" },
        "candidate_sha256": { "$ref": "#/$defs/sha256" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_swu_id", "candidate_sha256", "receipt_sha256", "synchronized_task_session_closeout", "operation_type_completion_receipt_used", "authority_effect"],
      "properties": {
        "projection_swu_id": { "const": "RMT-WF-010" },
        "candidate_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "synchronized_task_session_closeout": { "const": false },
        "operation_type_completion_receipt_used": { "const": false },
        "authority_effect": { "const": "none" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "profile_sha256", "denominator_sha256"],
      "properties": {
        "profile_id": { "const": "APE.ArchitectureProfile.TypeScriptWorkflowApplication/candidate-v1" },
        "version": { "const": "0.1.0-candidate" },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "denominator_sha256": { "const": "dcafa4b33d08181f0dd7ecf92aef5a27c2b0e059ece49f60c876b6578f586279" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "fixture_sha256", "applicability_sha256", "hostile_catalogue_sha256"],
      "properties": {
        "fixture_id": { "const": "AWF-FIXTURE-settlement-workflow-synchronous/v1" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "applicability_sha256": { "$ref": "#/$defs/sha256" },
        "hostile_catalogue_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/finding" }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator_count", "applicable_count", "not_applicable_count", "owner_blocked_applicability_count", "pass_count", "fail_count", "missing_count", "unsupported_count", "owner_blocked_count", "unaccounted_property_ids", "extra_property_ids"],
      "properties": {
        "denominator_count": { "const": 9 },
        "applicable_count": { "const": 7 },
        "not_applicable_count": { "const": 2 },
        "owner_blocked_applicability_count": { "const": 0 },
        "pass_count": { "const": 7 },
        "fail_count": { "const": 0 },
        "missing_count": { "const": 0 },
        "unsupported_count": { "const": 0 },
        "owner_blocked_count": { "const": 0 },
        "unaccounted_property_ids": { "type": "array", "maxItems": 0 },
        "extra_property_ids": { "type": "array", "maxItems": 0 }
      }
    },
    "material_inventory": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/material" }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "missing_named_compensation_callable_retained", "profile_admitted", "semantic_admission", "runtime_or_delivery_guarantee", "operation_completion_dependency", "promotion", "publication", "release", "deployment", "production_readiness"],
      "properties": {
        "statement": { "const": "candidate-local TypeScript Workflow architecture evidence only" },
        "missing_named_compensation_callable_retained": { "const": true },
        "profile_admitted": { "const": false },
        "semantic_admission": { "const": false },
        "runtime_or_delivery_guarantee": { "const": false },
        "operation_completion_dependency": { "const": false },
        "promotion": { "const": false },
        "publication": { "const": false },
        "release": { "const": false },
        "deployment": { "const": false },
        "production_readiness": { "const": false }
      }
    },
    "synchronized_task_session_closeout": { "const": false },
    "authority_effect": { "const": "none" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryRef": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "property_id", "applicability", "result", "diagnostic", "producer", "producer_output_sha256", "expected_value", "observed_value", "raw_evidence", "joins", "owner_route", "origin_profile", "authority_effect"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/nonEmpty" },
        "property_id": { "enum": ["APE.WF.P01-NAMED-ORCHESTRATION", "APE.WF.P02-CHILD-AUTHORITY", "APE.WF.P03-HOF-STEPS", "APE.WF.P04-MODE-APPLICABILITY", "APE.WF.P05-STEP-LOCAL-TRANSACTION", "APE.WF.P06-CONTINUATION", "APE.WF.P07-DURABLE-CAPABILITIES", "APE.WF.P08-TRANSPORT-BOUNDARIES", "APE.WF.P09-TRAVERSAL-EQUIVALENCE"] },
        "applicability": { "enum": ["applicable", "owner-blocked"] },
        "result": { "enum": ["pass", "fail", "missing", "unsupported", "owner-blocked"] },
        "diagnostic": { "$ref": "#/$defs/nonEmpty" },
        "producer": { "$ref": "#/$defs/nonEmpty" },
        "producer_output_sha256": { "$ref": "#/$defs/sha256" },
        "expected_value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "evidence_ref"],
          "properties": { "basis": { "$ref": "#/$defs/nonEmpty" }, "evidence_ref": { "$ref": "#/$defs/nonEmpty" } }
        },
        "observed_value": true,
        "raw_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lock" } },
        "joins": { "type": "array" },
        "owner_route": { "$ref": "#/$defs/nonEmpty" },
        "origin_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "version", "profile_sha256"],
          "properties": {
            "profile_id": { "const": "APE.ArchitectureProfile.TypeScriptWorkflowApplication/candidate-v1" },
            "version": { "const": "0.1.0-candidate" },
            "profile_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "authority_effect": { "const": "none" }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryRef" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": { "enum": ["workflow-candidate", "workflow-source", "rmt-wf-006", "rmt-wf-007", "rmt-wf-008", "rmt-wf-009", "rmt-wf-010", "packet-schema", "packet-validator", "packet-closeout", "workflow-predecessor", "profile-schema", "profile", "applicability", "child-observer", "continuation-observer", "compensation-observer", "mode-discriminator", "runtime-observer", "version-observer", "message-observer", "fixture", "hostiles", "evaluator", "receipt-schema"] },
        "path": { "$ref": "#/$defs/repositoryRef" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
