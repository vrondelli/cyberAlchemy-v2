{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/ape/operation-type-completion-receipt-v1.json",
  "title": "Operation profile evidence-only TypeCompletionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "evidence_lane",
    "result",
    "subject",
    "profile",
    "fixture",
    "findings",
    "accounting",
    "material_inventory",
    "claim_ceiling",
    "synchronized_task_session_closeout",
    "authority_effect",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": "ape.operation-type-completion-receipt/v1" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "evidence_lane": { "const": "candidate-local-prototype" },
    "result": { "enum": ["pass", "fail", "incomplete"] },
    "subject": { "$ref": "#/$defs/subject" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "profile_sha256", "denominator_sha256"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "denominator_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "fixture_sha256", "hostile_catalogue_sha256"],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1 },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "hostile_catalogue_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator_count",
        "applicable_count",
        "not_applicable_count",
        "pass_count",
        "fail_count",
        "missing_count",
        "unsupported_count",
        "owner_blocked_count",
        "unaccounted_property_ids",
        "extra_property_ids"
      ],
      "properties": {
        "denominator_count": { "type": "integer", "minimum": 1 },
        "applicable_count": { "type": "integer", "minimum": 0 },
        "not_applicable_count": { "type": "integer", "minimum": 0 },
        "pass_count": { "type": "integer", "minimum": 0 },
        "fail_count": { "type": "integer", "minimum": 0 },
        "missing_count": { "type": "integer", "minimum": 0 },
        "unsupported_count": { "type": "integer", "minimum": 0 },
        "owner_blocked_count": { "type": "integer", "minimum": 0 },
        "unaccounted_property_ids": {
          "type": "array",
          "maxItems": 0
        },
        "extra_property_ids": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "material_inventory": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material" }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "profile_admitted",
        "semantic_admission",
        "infrastructure_guarantee_beyond_join",
        "promotion",
        "publication",
        "release",
        "deployment",
        "production_readiness"
      ],
      "properties": {
        "statement": { "const": "candidate-local Operation architecture evidence only" },
        "profile_admitted": { "const": false },
        "semantic_admission": { "const": false },
        "infrastructure_guarantee_beyond_join": { "const": false },
        "promotion": { "const": false },
        "publication": { "const": false },
        "release": { "const": false },
        "deployment": { "const": false },
        "production_readiness": { "const": false }
      }
    },
    "synchronized_task_session_closeout": { "const": false },
    "authority_effect": { "const": "none" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta_type_id", "subject_id", "subject_sha256"],
      "properties": {
        "meta_type_id": { "const": "Operation" },
        "subject_id": { "type": "string", "minLength": 1 },
        "subject_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rawEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concern_kind",
        "observation_id",
        "observation_ref",
        "observation_sha256",
        "record_id",
        "record_ref",
        "record_sha256",
        "external_status",
        "external_ceiling",
        "interface_ref",
        "evidence_lane"
      ],
      "properties": {
        "concern_kind": { "enum": ["persistence", "transaction", "failure", "transport", "delivery"] },
        "observation_id": { "type": "string", "minLength": 1 },
        "observation_ref": { "type": "string", "minLength": 1 },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "record_id": { "type": "string", "minLength": 1 },
        "record_ref": { "type": "string", "minLength": 1 },
        "record_sha256": { "$ref": "#/$defs/sha256" },
        "external_status": { "enum": ["admitted", "candidate", "absent"] },
        "external_ceiling": { "type": "string", "minLength": 1 },
        "interface_ref": { "type": ["string", "null"] },
        "evidence_lane": { "enum": ["candidate-local-fixture", "canonical"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "subject",
        "property_id",
        "applicability",
        "result",
        "expected_value",
        "observed_value",
        "result_envelope_ref",
        "result_envelope_sha256",
        "origin_profile",
        "raw_evidence",
        "joins",
        "diagnostic",
        "owner_route",
        "authority_effect"
      ],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "property_id": { "type": "string", "pattern": "^APE\\.ImplementationProperty\\.operation\\." },
        "applicability": { "enum": ["applicable", "owner-blocked"] },
        "result": { "enum": ["pass", "fail", "missing", "unsupported", "owner-blocked"] },
        "expected_value": {},
        "observed_value": {},
        "result_envelope_ref": { "type": "string", "minLength": 1 },
        "result_envelope_sha256": { "$ref": "#/$defs/sha256" },
        "origin_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "version", "profile_sha256"],
          "properties": {
            "profile_id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "profile_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "raw_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rawEvidence" }
        },
        "joins": {
          "type": "array",
          "items": { "$ref": "#/$defs/join" }
        },
        "diagnostic": { "type": "string", "minLength": 1 },
        "owner_route": { "type": "string", "minLength": 1 },
        "authority_effect": { "const": "none" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
