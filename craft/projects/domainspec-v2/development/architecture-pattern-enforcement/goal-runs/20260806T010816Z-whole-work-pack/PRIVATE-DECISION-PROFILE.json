{
  "profile": {
    "id": "operator-vladimir-ape-whole-work-pack",
    "version": "1.0.0",
    "mode": "custom-runtime",
    "description": "Private APE run projection of the repository-owned operator profile; source content remains private and unchanged."
  },
  "risk": {
    "unknown_action": "stop",
    "default_tier": "T3",
    "protected_operations": [
      "active-ledger-mutation",
      "commit",
      "push",
      "pull-request",
      "publication",
      "promotion",
      "deployment",
      "ci",
      "network",
      "destructive-shell",
      "parent-gitlink-movement"
    ],
    "read_only_allowlist": [
      "craft-read",
      "context-selection",
      "planning",
      "design-review",
      "staged-proposal",
      "local-validation"
    ]
  },
  "approval": {
    "mutation_mode": "propose-then-promote",
    "promotion_mode": "explicit-token",
    "decision_record_required": true,
    "batch_limit": 1
  },
  "slice": {
    "size": "smallest-reliable",
    "validate_before_broaden": true,
    "reconcile_before_act": true
  },
  "ownership": {
    "model": "owner-scoped",
    "immutable_substrate": [
      "public-private-boundary",
      "generated-runtime-surfaces",
      "unapproved-parent-gitlink",
      "arcanum-public-source"
    ]
  },
  "gap_filling": {
    "fallback_exploration": "named-gaps-only",
    "interrogation_style": "one-question-at-a-time",
    "record_residue": true
  },
  "technique_weights": {
    "review_then_audit": "high",
    "validation_loop": "high",
    "frame_handoff": "high",
    "dialectic": "high",
    "tournament": "high",
    "pareto_gate": "high",
    "toy_game": "medium",
    "research_external": "low"
  },
  "anti_patterns": [
    "ambient-authority",
    "direct-active-ledger-mutation",
    "silent-shared-substrate-mutation",
    "unbounded-shell-without-allowlist",
    "promotion-without-experiment-evidence",
    "acting-on-stale-assumptions",
    "broadening-before-validation"
  ]
}
