  "representation_decisions": [
    {
      "form_id": "typescript.owned-const-object-enum",
      "category": "candidate-form",
      "disposition": "selected-for-materialization",
      "reason": "The owner selected the owned const-object protocol so runtime identity, type inference, and composition stay inside one explicit provider boundary."
    },
    {
      "form_id": "typescript.native-enum",
      "category": "candidate-form",
      "disposition": "rejected",
      "reason": "Native enum emits a TypeScript runtime object and constrains composition in ways the selected owned protocol intentionally avoids."
    },
    {
      "form_id": "typescript.standalone-literal-union",
      "category": "candidate-form",
      "disposition": "unsupported",
      "reason": "A type-only union cannot supply the required owned runtime value contract."
    },
    {
      "form_id": "typescript.bare-const-object",
      "category": "candidate-form",
      "disposition": "unsupported",
      "reason": "A bare as-const object lacks the owned construction and composition boundary required by the selected protocol."
    },
    {
      "form_id": "typescript.arbitrary-factory",
      "category": "analysis-boundary",
      "disposition": "unsupported",
      "reason": "Unowned factories cannot prove the selected construction protocol."
    },
    {
      "form_id": "typescript.raw-spread-or-computed-member",
      "category": "analysis-boundary",
      "disposition": "unsupported",
      "reason": "Raw spread and computed members bypass owned composition and collision checks."
    },
    {
      "form_id": "typescript.helper-name-impersonation",
      "category": "analysis-boundary",
      "disposition": "unsupported",
      "reason": "Matching helper names without the owned module identity cannot prove protocol conformance."
    }
  ],
