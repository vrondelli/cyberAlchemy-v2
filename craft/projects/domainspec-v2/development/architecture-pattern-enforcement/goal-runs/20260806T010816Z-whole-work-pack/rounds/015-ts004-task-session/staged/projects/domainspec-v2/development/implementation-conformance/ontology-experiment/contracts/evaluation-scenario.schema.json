{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/evaluation-scenario.schema.json",
  "title": "DomainSpec Candidate Evaluation Scenario",
  "description": "Language-neutral, non-authoritative causal scenario contract for a later proof-provider adoption route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "operation",
    "artifacts",
    "expectations",
    "mutation_lineage",
    "recomposition",
    "frozen_cases",
    "results",
    "case_result_join",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "evaluation-scenario.v1"},
    "scenario_id": {"$ref": "#/$defs/stableId"},
    "operation": {"$ref": "#/$defs/operationHandle"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "mutant"],
      "properties": {
        "base": {"$ref": "#/$defs/contentHandle"},
        "mutant": {"$ref": "#/$defs/contentHandle"}
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre", "post"],
      "properties": {
        "pre": {"$ref": "#/$defs/expectationHandle"},
        "post": {"$ref": "#/$defs/expectationHandle"}
      }
    },
    "mutation_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_id",
        "operation_ref",
        "base_ref",
        "mutant_ref",
        "pre_expectation_ref",
        "post_expectation_ref"
      ],
      "properties": {
        "mutation_id": {"$ref": "#/$defs/stableId"},
        "operation_ref": {"$ref": "#/$defs/stableId"},
        "base_ref": {"$ref": "#/$defs/stableId"},
        "mutant_ref": {"$ref": "#/$defs/stableId"},
        "pre_expectation_ref": {"$ref": "#/$defs/stableId"},
        "post_expectation_ref": {"$ref": "#/$defs/stableId"}
      }
    },
    "recomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "result_ref", "partitions"],
      "properties": {
        "source_ref": {"$ref": "#/$defs/stableId"},
        "result_ref": {"$ref": "#/$defs/stableId"},
        "partitions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/partition"}
        }
      }
    },
    "frozen_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frozenCase"}
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluationResult"}
    },
    "case_result_join": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/joinEntry"}
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operationHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "operation_kind", "sha256"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/stableId"},
        "operation_kind": {
          "enum": ["insert", "remove", "replace", "recompose"]
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contentHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "expectationHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation_id", "sha256", "immutable"],
      "properties": {
        "expectation_id": {"$ref": "#/$defs/stableId"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "immutable": {"const": true}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_ref", "start", "end"],
      "properties": {
        "resource_ref": {"$ref": "#/$defs/stableId"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_id", "scope", "source_member_refs", "result_member_refs"],
      "properties": {
        "partition_id": {"$ref": "#/$defs/stableId"},
        "scope": {"$ref": "#/$defs/scope"},
        "source_member_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "result_member_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed"],
      "properties": {
        "added": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "removed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "diagnosticCode": {
      "type": ["string", "null"],
      "pattern": "^BTE_[A-Z0-9_]+$"
    },
    "frozenCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "input_ref",
        "expectation_ref",
        "expected_diagnostic",
        "expected_delta",
        "frozen"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/stableId"},
        "input_ref": {"$ref": "#/$defs/stableId"},
        "expectation_ref": {"$ref": "#/$defs/stableId"},
        "expected_diagnostic": {"$ref": "#/$defs/diagnosticCode"},
        "expected_delta": {"$ref": "#/$defs/delta"},
        "frozen": {"const": true}
      }
    },
    "evaluationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "scenario_ref",
        "input_ref",
        "expectation_ref",
        "observed_diagnostic",
        "observed_delta"
      ],
      "properties": {
        "result_id": {"$ref": "#/$defs/stableId"},
        "scenario_ref": {"$ref": "#/$defs/stableId"},
        "input_ref": {"$ref": "#/$defs/stableId"},
        "expectation_ref": {"$ref": "#/$defs/stableId"},
        "observed_diagnostic": {"$ref": "#/$defs/diagnosticCode"},
        "observed_delta": {"$ref": "#/$defs/delta"}
      }
    },
    "joinEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ref", "result_ref"],
      "properties": {
        "case_ref": {"$ref": "#/$defs/stableId"},
        "result_ref": {"$ref": "#/$defs/stableId"}
      }
    }
  }
}
