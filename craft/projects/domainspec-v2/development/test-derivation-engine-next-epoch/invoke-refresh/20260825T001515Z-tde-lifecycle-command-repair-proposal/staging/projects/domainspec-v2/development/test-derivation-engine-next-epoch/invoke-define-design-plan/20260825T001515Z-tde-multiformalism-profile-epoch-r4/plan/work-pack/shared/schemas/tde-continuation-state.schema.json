{
  "$defs": {
    "exactArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "https://domainspec.dev/schemas/tde/continuation-state/1-0-0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "completed_swu": {
      "minLength": 1,
      "type": "string"
    },
    "execution_started": {
      "const": false
    },
    "invoke_closeout_receipt_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "next_owner": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "next_swu": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "router_verification_receipt_ref": {
      "$ref": "#/$defs/exactArtifactRef"
    },
    "schema_version": {
      "const": "domainspec-v2.tde-continuation-state/v1"
    },
    "work_pack_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "work_pack_id",
    "completed_swu",
    "invoke_closeout_receipt_ref",
    "router_verification_receipt_ref",
    "next_swu",
    "next_owner",
    "execution_started",
    "authority_effect"
  ],
  "title": "TdeContinuationState",
  "type": "object"
}
