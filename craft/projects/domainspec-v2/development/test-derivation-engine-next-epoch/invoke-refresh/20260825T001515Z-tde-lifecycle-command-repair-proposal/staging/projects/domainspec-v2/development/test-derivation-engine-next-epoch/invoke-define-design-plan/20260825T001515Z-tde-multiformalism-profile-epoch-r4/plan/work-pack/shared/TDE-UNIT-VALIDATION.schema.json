{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority_effect": {
      "const": "none"
    },
    "contract_id": {
      "minLength": 1,
      "type": "string"
    },
    "environment_contract": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "const": "C.UTF-8"
        },
        "network": {
          "const": "forbidden"
        },
        "runtime_identity": {
          "minLength": 1,
          "type": "string"
        },
        "secrets": {
          "const": "forbidden"
        },
        "timezone": {
          "const": "UTC"
        }
      },
      "required": [
        "network",
        "locale",
        "timezone",
        "runtime_identity",
        "secrets"
      ],
      "type": "object"
    },
    "expected_exit_policy": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "const": "any nonzero exit blocks and is retained"
        },
        "success": {
          "const": [
            0
          ],
          "type": "array"
        }
      },
      "required": [
        "success",
        "failure"
      ],
      "type": "object"
    },
    "failure_policy": {
      "const": "first nonzero exit blocks; retain exact failure; teardown cannot mask it"
    },
    "risk_class": {
      "enum": [
        "bounded-write",
        "read-only"
      ]
    },
    "schema_version": {
      "const": "domainspec-v2.tde-epoch-unit-validation/v2"
    },
    "swu_id": {
      "minLength": 1,
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "validation_commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "argv": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "command_id": {
            "minLength": 1,
            "type": "string"
          },
          "cwd": {
            "minLength": 1,
            "type": "string"
          },
          "environment": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "expected_exit_codes": {
            "const": [
              0
            ]
          },
          "max_output_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "risk_class": {
            "enum": [
              "bounded-write",
              "read-only"
            ]
          },
          "timeout_seconds": {
            "maximum": 86400,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "command_id",
          "argv",
          "cwd",
          "timeout_seconds",
          "max_output_bytes",
          "environment",
          "risk_class",
          "expected_exit_codes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "wpra_projection": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "argv": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "command_id": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "max_output_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "timeout_seconds": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "command_id",
          "argv",
          "cwd",
          "timeout_seconds",
          "max_output_bytes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "task_id",
    "swu_id",
    "environment_contract",
    "risk_class",
    "expected_exit_policy",
    "validation_commands",
    "wpra_projection",
    "acceptance",
    "failure_policy",
    "authority_effect"
  ],
  "title": "TdeEpochUnitValidationContract",
  "type": "object"
}
