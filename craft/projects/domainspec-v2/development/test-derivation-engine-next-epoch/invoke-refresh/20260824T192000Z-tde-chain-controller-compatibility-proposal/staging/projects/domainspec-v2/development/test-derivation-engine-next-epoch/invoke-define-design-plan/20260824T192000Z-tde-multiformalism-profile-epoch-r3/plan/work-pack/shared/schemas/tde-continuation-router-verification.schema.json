{
  "$defs": {
    "exactArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "https://domainspec.dev/schemas/tde/continuation-router-verification/1-0-0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "completed_swu": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "returned_next_route": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "domainspec-v2.tde-continuation-router-verification/v1"
    },
    "successor_executed": {
      "const": false
    },
    "verdict": {
      "enum": [
        "pass",
        "block"
      ]
    },
    "work_pack_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "work_pack_id",
    "completed_swu",
    "verdict",
    "returned_next_route",
    "successor_executed",
    "authority_effect"
  ],
  "title": "TdeContinuationRouterVerification",
  "type": "object"
}
