        type RuleProtocol<T> = Readonly<{normalize:(input:unknown)=>T;key:(value:T)=>string}>;
        const rulePart = (value:string):string=>value.length+':'+value;
        const ruleData = (input:unknown,allowed:readonly string[]):Record<string,PropertyDescriptor>=>{
          if(input===null||typeof input!=='object'||Array.isArray(input)||![Object.prototype,null].includes(Object.getPrototypeOf(input))) throw new TypeError('WORKFLOW_VALUE');
          const descriptors=Object.getOwnPropertyDescriptors(input);
          if(Reflect.ownKeys(descriptors).some(key=>typeof key!=='string'||!allowed.includes(key))||Object.values(descriptors).some(d=>!Object.hasOwn(d,'value')||!d.enumerable)) throw new TypeError('WORKFLOW_VALUE');
          return descriptors;
        };
        const ruleString:RuleProtocol<string> = Object.freeze({normalize:(input:unknown):string=>{if(typeof input!=='string')throw new TypeError('WORKFLOW_VALUE');return input;},key:(value:string):string=>rulePart('String')+rulePart(value)});
        const ruleBool:RuleProtocol<boolean> = Object.freeze({normalize:(input:unknown):boolean=>{if(typeof input!=='boolean')throw new TypeError('WORKFLOW_VALUE');return input;},key:(value:boolean):string=>rulePart('Bool')+rulePart(value?'1':'0')});
        const ruleUInt64:RuleProtocol<bigint> = Object.freeze({
          normalize:(input:unknown):bigint=>{
            let value:bigint;
            if(typeof input==='bigint')value=input;
            else if(typeof input==='number'&&Number.isSafeInteger(input))value=BigInt(input);
            else if(typeof input==='string'&&input.length<=20&&/^(0|[1-9][0-9]*)$/.exec(input)?.[0]===input)value=BigInt(input);
            else throw new TypeError('WORKFLOW_VALUE');
            if(value<0n||value>18446744073709551615n)throw new TypeError('WORKFLOW_VALUE');
            return value;
          },key:(value:bigint):string=>rulePart('UInt64')+rulePart(String(value)),
        });
        const ruleOptional = <T>(element:RuleProtocol<T>):RuleProtocol<T|null>=>Object.freeze({normalize:(input:unknown):T|null=>input===null?null:element.normalize(input),key:(value:T|null):string=>value===null?rulePart('absent'):rulePart('present')+rulePart(element.key(value))});
        const ruleSequence = <T>(element:RuleProtocol<T>,unique:boolean):RuleProtocol<readonly T[]>=>Object.freeze({
          normalize:(input:unknown):readonly T[]=>{
            if(!Array.isArray(input)||Object.getPrototypeOf(input)!==Array.prototype)throw new TypeError('WORKFLOW_VALUE');
            const descriptors:Record<string,PropertyDescriptor>=Object.getOwnPropertyDescriptors(input),length=descriptors.length!.value as number;
            if(Reflect.ownKeys(descriptors).length!==length+1)throw new TypeError('WORKFLOW_VALUE');
            const rows:{value:T;key:string}[]=[];
            for(let i=0;i<length;i++){const d=descriptors[String(i)];if(!d||!Object.hasOwn(d,'value')||!d.enumerable)throw new TypeError('WORKFLOW_VALUE');const value=element.normalize(d.value);rows.push({value,key:element.key(value)});}
            if(unique){if(new Set(rows.map(row=>row.key)).size!==rows.length)throw new TypeError('WORKFLOW_VALUE');rows.sort((a,b)=>a.key<b.key?-1:a.key>b.key?1:0);}
            return Object.freeze(rows.map(row=>row.value));
          },key:(values:readonly T[]):string=>rulePart(unique?'set':'list')+rulePart(String(values.length))+values.map(value=>rulePart(element.key(value))).join(''),
        });
        const ruleToSet = <T>(input:readonly T[],element:RuleProtocol<T>):readonly T[]=>{
          const rows=new Map<string,T>();for(const value of input){const key=element.key(value);if(!rows.has(key))rows.set(key,value);}
          return Object.freeze([...rows].sort(([a],[b])=>a<b?-1:a>b?1:0).map(([,value])=>value));
        };
        type RuleAnyProtocol = Readonly<{normalize:(input:unknown)=>unknown;key:(value:never)=>string}>;
        type RuleSumCase<P> = {[K in keyof P]:P[K] extends null?Readonly<{variant:K}>:P[K] extends RuleProtocol<infer T>?Readonly<{variant:K;payload:T}>:never}[keyof P];
        const ruleSum = <const P extends Readonly<Record<string,RuleAnyProtocol|null>>>(variants:P):RuleProtocol<RuleSumCase<P>>=>Object.freeze({
          normalize:(input:unknown):RuleSumCase<P>=>{
            const d=ruleData(input,['variant','payload']),variant=d.variant?.value;
            if(typeof variant!=='string'||!Object.hasOwn(variants,variant))throw new TypeError('WORKFLOW_VALUE');
            const protocol=variants[variant]!;
            if(Object.keys(d).length!==(protocol===null?1:2)||(protocol!==null&&!Object.hasOwn(d,'payload')))throw new TypeError('WORKFLOW_VALUE');
            return Object.freeze(protocol===null?{variant}:{variant,payload:protocol.normalize(d.payload!.value)}) as RuleSumCase<P>;
          },key:(value:RuleSumCase<P>):string=>{
            const protocol=variants[value.variant]!;
            if(protocol!==null&&!('payload' in value))throw new TypeError('WORKFLOW_VALUE');
            return rulePart('sum')+rulePart(String(value.variant))+(protocol===null?rulePart('no-payload'):rulePart(protocol.key(('payload' in value?value.payload:undefined) as never)));
          },
        });
        // end structured Rule support
        type R2 = (Readonly<{variant:"Off"}>|Readonly<{variant:"On"}>);
        type R2Input = (Readonly<{variant:"Off"}>|Readonly<{variant:"On"}>);
        const R2Value:RuleProtocol<R2> = ruleSum(Object.freeze({["Off"]:null,["On"]:null}));
        type R3 = R2;
        type R3Input = R2Input;
        const R3Value:RuleProtocol<R3> = Object.freeze({normalize:R2Value.normalize,key:(value:R3):string=>rulePart("alpha:mode")+rulePart(R2Value.key(value))});
        type R4 = Readonly<{readonly "amount":bigint}>;
        type R4Input = Readonly<{readonly "amount":bigint|number|string}>;
        const R4Value:RuleProtocol<R4> = Object.freeze({
          normalize:(input:unknown):R4=>{
            const d=ruleData(input,["amount"]);
            return Object.freeze({["amount"]:ruleUInt64.normalize(Object.hasOwn(d,"amount")?d["amount"]!.value:undefined)});
          },key:(value:R4):string=>rulePart("Value Object")+rulePart("alpha:money")+rulePart("amount")+rulePart(ruleUInt64.key(value["amount"])),
        });
        type R5 = Readonly<{readonly "amount":bigint;readonly "id":string;readonly "mode":R3;readonly "money":R4}>;
        type R5Input = Readonly<{readonly "amount":bigint|number|string;readonly "id":string;readonly "mode":R3Input;readonly "money":R4Input}>;
        const R5Value:RuleProtocol<R5> = Object.freeze({
          normalize:(input:unknown):R5=>{
            const d=ruleData(input,["amount","id","mode","money"]);
            return Object.freeze({["amount"]:ruleUInt64.normalize(Object.hasOwn(d,"amount")?d["amount"]!.value:undefined),["id"]:ruleString.normalize(Object.hasOwn(d,"id")?d["id"]!.value:undefined),["mode"]:R3Value.normalize(Object.hasOwn(d,"mode")?d["mode"]!.value:undefined),["money"]:R4Value.normalize(Object.hasOwn(d,"money")?d["money"]!.value:undefined)});
          },key:(value:R5):string=>rulePart("Entity")+rulePart("alpha:order")+rulePart("id")+rulePart(ruleString.key(value["id"])),
        });
        const eventFail = ():never => {throw new TypeError("EVENT_INPUT");};
        const eventData = (value:unknown,allowed:readonly string[],required:readonly string[]):Record<string,PropertyDescriptor> => {
          if(!value||typeof value!=="object"||Array.isArray(value)||![Object.prototype,null].includes(Object.getPrototypeOf(value)))return eventFail();
          const d=Object.getOwnPropertyDescriptors(value);
          if(Reflect.ownKeys(d).some(k=>typeof k!=="string"||!allowed.includes(k))||Object.values(d).some(p=>!Object.hasOwn(p,"value")||!p.enumerable)||required.some(k=>!Object.hasOwn(d,k)))return eventFail();
          return d;
        };
        const eventString = (v:unknown):string => typeof v==="string"?v:eventFail();
        const eventText = (v:unknown):string => typeof v==="string"&&v.length>0?v:eventFail();
        const eventBoolean = (v:unknown):boolean => typeof v==="boolean"?v:eventFail();
        const eventDecimal = (v:unknown):number => typeof v==="number"&&Number.isFinite(v)?(Object.is(v,-0)?0:v):eventFail();
        const eventInteger = (v:unknown):bigint => {
          let n:bigint;
          if(typeof v==="bigint")n=v;
          else if(typeof v==="number"&&Number.isSafeInteger(v))n=BigInt(v);
          else if(typeof v==="string"&&v.length<=20&&/^(0|-?[1-9][0-9]*)$/.exec(v)?.[0]===v)n=BigInt(v);
          else return eventFail();
          return n>=-9223372036854775808n&&n<=9223372036854775807n?n:eventFail();
        };
        type EventRef<S extends string> = string & {readonly __domainspecRef?:S};
        type E0Input=Readonly<{occurrence:Readonly<{"event-id":string}>;occurredAt:string;payload:Readonly<{}>}>;
        type E0=Readonly<{occurrence:Readonly<{"event-id":string}>;occurredAt:string;payload:Readonly<{}>}>;
        const captureE0=(input:unknown):E0=>{
          const d=eventData(input,["occurrence","occurredAt","payload"],["occurrence","occurredAt","payload"]);
          const o=eventData(d.occurrence!.value,["event-id"],["event-id"]);
          const p=eventData(d.payload!.value,[],[]);
          return Object.freeze({occurrence:Object.freeze({["event-id"]:eventText(o["event-id"]!.value)}),occurredAt:eventText(d.occurredAt!.value),payload:Object.freeze({})});
        };
        const materialFail=():never=>{throw new TypeError("WORKFLOW_VALUE");};
        const captureData=(input:unknown):unknown=>{
          let count=0;
          const copy=(v:unknown,depth:number):unknown=>{
            if(++count>20000||depth>64)return materialFail();
            if(v===null||typeof v==="string"||typeof v==="boolean"||typeof v==="bigint"||typeof v==="number"&&Number.isFinite(v))return v;
            if(!v||typeof v!=="object")return materialFail();
            const array=Array.isArray(v),proto=Object.getPrototypeOf(v);
            if(array?proto!==Array.prototype:proto!==Object.prototype&&proto!==null)return materialFail();
            const d=Object.getOwnPropertyDescriptors(v),keys=Reflect.ownKeys(d);if(keys.length>2048)return materialFail();
            if(array){const length=d.length!.value;if(length>1024||keys.length!==length+1)return materialFail();const result:unknown[]=[];for(let i=0;i<length;i++){const p=d[String(i)];if(!p||!Object.hasOwn(p,"value")||!p.enumerable)return materialFail();result.push(copy(p.value,depth+1));}return Object.freeze(result);}
            const result:Record<string,unknown>=Object.create(null);
            for(const k of keys){const p=d[k as string];if(typeof k!=="string"||!p||!Object.hasOwn(p,"value")||!p.enumerable)return materialFail();result[k]=copy(p.value,depth+1);}return Object.freeze(result);
          };return copy(input,0);
        };
        export type WorkflowInput=Readonly<{readonly "order":R5Input;readonly "notice":E0Input}>;
        export type CapturedInput=Readonly<{readonly "order":R5;readonly "notice":E0}>;
        export type StepId="post";
        export type CapturedResult=Readonly<{step_id:"post";action_sha256:"65b5360adf64a1523a43bd7c439291725a93385d65c9516dfe48c18f6e2afc02";value:R5}>;
        const inputs=new WeakSet<object>();const resultInputs=new WeakMap<object,CapturedInput>();
        const assertInput=(input:CapturedInput):void=>{if(!input||typeof input!=="object"||!inputs.has(input))materialFail();};
        export const capture=(value:WorkflowInput):CapturedInput=>{
          const d=ruleData(captureData(value),["order","notice"]);if(Object.keys(d).length!==2)return materialFail();
          const input=Object.freeze({["order"]:R5Value.normalize(d["order"]!.value),["notice"]:captureE0(d["notice"]!.value)});inputs.add(input);return input;
        };
        export const captureResult=(input:CapturedInput,stepId:StepId,raw:unknown):CapturedResult=>{
          assertInput(input);
          if(stepId==="post"){const value=R5Value.normalize(captureData(raw));const row=Object.freeze({step_id:"post" as const,action_sha256:"65b5360adf64a1523a43bd7c439291725a93385d65c9516dfe48c18f6e2afc02" as const,value});resultInputs.set(row,input);return row;}
          return materialFail();
        };
        const prefix=(input:CapturedInput,results:readonly CapturedResult[],min:number,max:number):Record<string,unknown>=>{
          assertInput(input);if(!Array.isArray(results)||Object.getPrototypeOf(results)!==Array.prototype)return materialFail();
          const d:Record<string,PropertyDescriptor>=Object.getOwnPropertyDescriptors(results),length=d.length!.value;
          if(length<min||length>max||Reflect.ownKeys(d).length!==length+1)return materialFail();
          const ids=["post"],r:Record<string,unknown>=Object.create(null);
          for(let i=0;i<length;i++){const p=d[String(i)];if(!p||!Object.hasOwn(p,"value")||!p.enumerable)return materialFail();const row=p.value;if(!row||typeof row!=="object"||resultInputs.get(row)!==input||row.step_id!==ids[i])return materialFail();r[row.step_id]=row.value;}return r;
        };
        export const steps=Object.freeze({["post"]:Object.freeze({operation_ref:"alpha:post",action_sha256:"65b5360adf64a1523a43bd7c439291725a93385d65c9516dfe48c18f6e2afc02",arguments:(input:CapturedInput,results:readonly CapturedResult[]):Readonly<{readonly "order":R5;readonly "notice_input":E0}>=>{
          const r=prefix(input,results,0,0);
          return Object.freeze({["order"]:input["order"],["notice_input"]:input["notice"]});
        }})});
        export const compensations=Object.freeze({});
        export const result=(input:CapturedInput,results:readonly CapturedResult[]):R5=>{
          const r=prefix(input,results,1,1);
          return R5Value.normalize((r["post"] as R5));
        };
        export const descriptor=Object.freeze({["schema_version"]:"domainspec.workflow-materialization-descriptor/v1-candidate",["workflow_sha256"]:"24b0073aa6ce8f78582feb9427cfe115bb51d5079f1d3a6298d95f14080d5e1d",["field_compilation_sha256"]:"7831dab7f5ab084a75b6f10e5f89880c9de0f6aba4b9bdffdd1e2c415c7c6352",["contract_sha256"]:"88d7a46aa61a28b371de4e468163a2c36c1da1d8ca83c14c77584fb2061a54a4",["selector"]:"alpha:flow",["steps"]:Object.freeze([Object.freeze({["step_id"]:"post",["operation_ref"]:"alpha:post",["action_sha256"]:"65b5360adf64a1523a43bd7c439291725a93385d65c9516dfe48c18f6e2afc02"})]),["compensations"]:Object.freeze([]),["effect_contract"]:"pure-typed-materialization",["invariant_execution"]:"not-performed",["commit_evidence"]:"not-established",["event_construction"]:"not-performed",["authority_effect"]:"none"});
        
    10:
      path: 'features/alpha/src/application/workflows/flow.provider.ts'
      content: |-
        import {createHash} from "node:crypto";
        import * as material from "./flow.material.js";
        export type {WorkflowInput} from "./flow.material.js";
        import type {WorkflowInput} from "./flow.material.js";
        import {operationPost as forward0} from "../operations/post.js";
        export type WorkflowDependencies=Readonly<{readonly "alpha:post":Parameters<typeof forward0>[1]}>;
        const wf=Object.freeze({["hash"]:"24b0073aa6ce8f78582feb9427cfe115bb51d5079f1d3a6298d95f14080d5e1d",["selector"]:"alpha:flow",["steps"]:Object.freeze([Object.freeze({["step_id"]:"post",["operation_ref"]:"alpha:post",["action_sha256"]:"65b5360adf64a1523a43bd7c439291725a93385d65c9516dfe48c18f6e2afc02"})])});
        const policyHash="3735e530a560f61f6203b21ec5a457b40d956d0c0f6bec93697c11592038be7f";
        const outcomeContract="0a7cb5a92bbec1bc5003dd5a6ba70ebc184a8316ad617f2a362b5d9de82ba607";
        const prefixTemplates:readonly PrefixTemplate[]=Object.freeze([Object.freeze({["steps"]:Object.freeze([]),["plan"]:Object.freeze([]),["plan_digest"]:null})]);
        
        export interface OperationSettlement {
         readonly commit_status:'committed'|'not-committed'|'indeterminate';
         readonly origin:'returned'|'invalid-return'|'threw'|'not-started';
         readonly status:'committed'|'failed'|'rejected'|'indeterminate'|null;
         readonly stage:string|null;readonly code:string|null;readonly continuation:string|null;
         readonly cleanup_failed:boolean|null;readonly result_validation:'not-performed';
        }
        const fail=(message:string):never=>{throw new TypeError('WORKFLOW_RUNTIME:'+message);};
        const own=(value:unknown,names:readonly string[]):Record<string,PropertyDescriptor>=>{
         if(!value||typeof value!=='object'||Array.isArray(value)||![Object.prototype,null].includes(Object.getPrototypeOf(value)))return fail('plain object');
         const keys=Reflect.ownKeys(value);
         if(keys.length!==names.length||keys.some(k=>typeof k!=='string'||!names.includes(k)))return fail('closed fields');
         const d=Object.getOwnPropertyDescriptors(value);
         if(Object.values(d).some(p=>!Object.hasOwn(p,'value')||!p.enumerable))return fail('inert fields');return d;
        };
        const text=(v:unknown):v is string=>typeof v==='string'&&v.length>0&&v.length<=2048;
        const identity=(v:unknown):string=>typeof v==='string'&&v.length<=256&&/^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/.exec(v)?.[0]===v?v:fail('identity');
        const unknown=(origin:'invalid-return'|'threw'):OperationSettlement=>Object.freeze({commit_status:'indeterminate',origin,status:null,stage:null,code:null,continuation:null,cleanup_failed:null,result_validation:'not-performed'});
        const notStarted=():OperationSettlement=>Object.freeze({commit_status:'not-committed',origin:'not-started',status:null,stage:'argument-materialization',code:'ARGUMENT_MATERIALIZATION_FAILED',continuation:null,cleanup_failed:null,result_validation:'not-performed'});
        export function inspectOperationSettlement(value:unknown,expectedContinuation:string):OperationSettlement{
         if(!text(expectedContinuation))return fail('continuation');
         try{
          const sd=value&&typeof value==='object'?Object.getOwnPropertyDescriptor(value,'status'):undefined;
          if(!sd||!Object.hasOwn(sd,'value')||!sd.enumerable)return unknown('invalid-return');
          if(sd.value==='committed'){
           own(value,['status','value']);
           return Object.freeze({commit_status:'committed',origin:'returned',status:'committed',stage:null,code:null,continuation:null,cleanup_failed:null,result_validation:'not-performed'});
          }
          const d=own(value,['status','stage','code','continuation','cleanupFailed']);
          const status=d.status!.value,stage=d.stage!.value,code=d.code!.value,cleanup=d.cleanupFailed!.value;
          if(!text(stage)||!text(code)||d.continuation!.value!==expectedContinuation||typeof cleanup!=='boolean')return unknown('invalid-return');
          let valid=false;
          if(stage==='commit')valid=!cleanup&&(status==='rejected'&&code==='COMMIT_REJECTED'||status==='indeterminate'&&['COMMIT_INDETERMINATE','INVALID_COMMIT_RECEIPT','COMMIT_UNCERTAIN'].includes(code));
          else if(stage==='input')valid=status==='failed'&&code==='OPERATION_INPUT'&&!cleanup;
          else if(stage==='begin')valid=status==='failed'&&code==='BEGIN_FAILED'&&!cleanup;
          else if(['read','guard','write-validation','event','result'].includes(stage))valid=status==='failed'&&code==='OPERATION_FAILED'||stage==='read'&&status==='failed'&&['READ_NOT_FOUND','READ_IDENTITY_MISMATCH'].includes(code)||stage==='guard'&&status==='rejected'&&/^RULE_REJECTED:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$/.test(code);
          if(!valid)return unknown('invalid-return');
          return Object.freeze({commit_status:status==='indeterminate'?'indeterminate':'not-committed',origin:'returned',status,stage,code,continuation:expectedContinuation,cleanup_failed:cleanup,result_validation:'not-performed'});
         }catch{return unknown('invalid-return');}
        }
        const freeze=<T>(v:T):T=>{if(v&&typeof v==='object'&&!Object.isFrozen(v)){Object.values(v).forEach(freeze);Object.freeze(v);}return v;};
        const canonical=(v:unknown):string=>{
         if(Array.isArray(v))return '['+v.map(canonical).join(',')+']';
         if(v!==null&&typeof v==='object'){const d=v as Record<string,unknown>;return '{'+Object.keys(d).sort().map(k=>JSON.stringify(k)+':'+canonical(d[k])).join(',')+'}';}
         return JSON.stringify(v);
        };
        const digest=(v:unknown):string=>createHash('sha256').update(canonical(v)).digest('hex');
        
        type StepMeta=Readonly<{step_id:string;operation_ref:string;action_sha256:string}>;
        type PlanEntry=Readonly<{compensation_id:string;for_step:string;operation_ref:string;action_sha256:string;depends_on:readonly string[];inactive_dependencies:readonly string[];arguments:readonly unknown[];events:readonly unknown[];failure_continuation:string}>;
        type PrefixTemplate=Readonly<{steps:readonly StepMeta[];plan:readonly PlanEntry[];plan_digest:string|null}>;
        export type WorkflowIdentity=Readonly<{workflow_execution_id:string;failure_occurrence_id:string}>;
        type Observation=Readonly<{schema_version:'domainspec.workflow-step-observation/v1-candidate';contract_sha256:string;workflow_sha256:string;step_id:string;operation_ref:string;action_sha256:string;settlement:OperationSettlement;evidence:'caller-supplied';authority_effect:'none';observation_sha256:string}>;
        type LocalError='committed-result-invalid'|'result-materialization-failed'|null;
        const observe=(index:number,settlement:OperationSettlement):Observation=>{
         const step=wf.steps[index]!;
         const body={schema_version:'domainspec.workflow-step-observation/v1-candidate' as const,contract_sha256:outcomeContract,workflow_sha256:wf.hash,...step,settlement,evidence:'caller-supplied' as const,authority_effect:'none' as const};
         return freeze({...body,observation_sha256:digest(body)});
        };
        const recover=(completed:readonly string[],failed:Observation,ids:WorkflowIdentity)=>{
         const template=prefixTemplates[completed.length]!;
         const journal={schema_version:'domainspec.workflow-failure-journal/v1-candidate' as const,workflow_execution_id:ids.workflow_execution_id,failure_occurrence_id:ids.failure_occurrence_id,completed_step_ids:completed,failed_step_id:failed.step_id,failed_commit_status:failed.settlement.commit_status};
