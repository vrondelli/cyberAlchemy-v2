          normalize:(input:unknown):T=>{if(!provider.isOwned(input)) throw new TypeError('UNOWNED_SUM_CASE');return input;},
          key:(value:T):string=>part('NamedSum') + part(provider.key(value)),
        });
        const uint64Value:ValueProtocol<bigint> = Object.freeze({
          normalize:(input:unknown):bigint=>{
            let value:bigint;
            if(typeof input === 'bigint') value=input;
            else if(typeof input === 'number' && Number.isSafeInteger(input)) value=BigInt(input);
            else if(typeof input === 'string' && input.length <= 20 && /^(0|[1-9][0-9]*)$/.exec(input)?.[0] === input) value=BigInt(input);
            else throw new TypeError('INVALID_UINT64');
            if(value < 0n || value > 18446744073709551615n) throw new TypeError('INVALID_UINT64');
            return value;
          },
          key:(value:bigint):string=>part('UInt64') + part(String(value)),
        });
        const ownedEntityValue = <T>(provider:Readonly<{isOwned:(input:unknown)=>input is T;key:(input:unknown)=>string}>):ValueProtocol<T> => Object.freeze({
          normalize:(input:unknown):T=>{if(!provider.isOwned(input)) throw new TypeError('UNOWNED_ENTITY');return input;},
          key:(value:T):string=>part('Entity') + part(provider.key(value)),
        });
        const field0Value = uint64Value;
        const valueKey = (fields:MoneyFields):string => part("alpha:money") + part("3eeaf28f589af095624fd15b62621d15abc12839aa5b07ccf2f3f6847a452e0f") + part("amount") + part("UInt64") + part(field0Value.key(fields["amount"]));
        const baseValidators:readonly BoundValidator[] = Object.freeze([Object.freeze({rule:"alpha:amount-valid",closure_sha256:"0b9036a069881f794bdd00ecbb0c21bbe074a0a62c4fda2b3150bb8ae4ea2e59",artifact_sha256:"79dc4e92c138d499e7e78be6faa341008bd7b966a4877810d49ebacfe7a962a4",validate:(fields:MoneyFields):boolean=>validator0({["amount"]:fields["amount"]})})]);
        const extensionValidators:Readonly<Record<string,readonly BoundValidator[]>> = Object.freeze({});
        const makeFactory = (extensions:readonly string[],validators:readonly BoundValidator[]):Factory => {
          const construct = (route:string,input:unknown,previous?:MoneySnapshot):Result => {
            const phases:string[] = ['normalize'];
            const trace:ValidatorTrace[] = [];
            const evidence = ():Trace => Object.freeze({route,phases:Object.freeze([...phases]),validators:Object.freeze([...trace])});
            const failure = (code:string):Result => Object.freeze({ok:false,value:null,failure_codes:Object.freeze([code]),trace:evidence()});
            let fields:MoneyFields;
            try {
              if (input === null || typeof input !== 'object' || Array.isArray(input) || ![Object.prototype,null].includes(Object.getPrototypeOf(input))) return failure('INVALID_FIELDS');
              const descriptors = Object.getOwnPropertyDescriptors(input);
              if (Reflect.ownKeys(descriptors).some(key=>typeof key !== 'string' || !["amount"].includes(key)) || Object.values(descriptors).some(d=>!Object.hasOwn(d,'value') || !d.enumerable)) return failure('INVALID_FIELDS');
