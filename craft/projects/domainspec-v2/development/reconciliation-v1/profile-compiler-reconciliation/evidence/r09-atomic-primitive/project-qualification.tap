        };
        // Checked arithmetic program follows.
        export const calculate = (input:Readonly<{readonly "amount":CalculationUInt64Input}>):bigint=>{
          const d=properties(input,["amount"]);
          const p0=normalize(d["amount"]!.value);
          return p0;
        };
        
