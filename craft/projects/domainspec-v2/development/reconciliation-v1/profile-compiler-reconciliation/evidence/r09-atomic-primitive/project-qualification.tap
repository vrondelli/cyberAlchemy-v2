        // domainspec-rule: "alpha:allowed"; closure: c00b8919f94aaf5cb851422e746871f0d0d1a4235829dce2527dae4b24ed8eba
        export const ruleAllowed = (parameters:Readonly<{readonly "value":boolean}>):boolean => {
          const d=ruleData(parameters,["value"]);
          if(Object.keys(d).length!==1)throw new TypeError('RULE_INPUT');
          const p0 = ruleBool.normalize(d["value"]!.value);
          return (ruleBool.key(p0) === ruleBool.key(true));
        };
        
