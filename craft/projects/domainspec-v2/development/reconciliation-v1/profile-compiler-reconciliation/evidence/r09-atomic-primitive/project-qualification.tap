        export const calculateTotal=Object.freeze(Object.assign(calculate,{descriptor:Object.freeze({["schema_version"]:"domainspec.generated-calculation-descriptor/v2-candidate",["protocol_id"]:"typescript.bound-calculation/v1",["selector"]:"beta:total",["ontology_calculation"]:"FIXTURE-BETA-TOTAL",["contract_sha256"]:"287d35e26963e45772f3d1f50a0cc96c19481f77c97da2c1255f97be976dfbcf",["source"]:Object.freeze({["relative_path"]:"specs/beta/nodes/total.json",["sha256"]:"99eac7562d1916d4adfa074b832bf34f33f3f203e8cd6d807236146e8166f6c7",["source_type"]:"node",["source_id"]:"beta:total",["pointer"]:"/body/typed_contract"}),["inputs"]:Object.freeze([]),["result"]:Object.freeze({["kind"]:"scalar",["name"]:"UInt64"}),["division_rounding"]:"reject",["value_profile"]:"domainspec.typescript-exact-uint64/v1",["return_semantics"]:"value",["effect_contract"]:"none",["dependency_contract"]:"explicit-only",["failure_contract"]:"declared",["result_consumption"]:"complete",["primary_callable_count"]:1,["supporting_exports"]:"explicit-only",["failures"]:Object.freeze(["CALCULATION_INPUT","CALCULATION_OVERFLOW","CALCULATION_UNDERFLOW","CALCULATION_DIVIDE_BY_ZERO","CALCULATION_INEXACT"]),["provider"]:Object.freeze({["id"]:"beta:total/typescript-exact/v2",["sha256"]:"8bf505f5b871c426fcc9e7f224ddbb4d0f03dd7787245ee9d9d3911c7658a05a"}),["authority_effect"]:"none",["descriptor_sha256"]:"48ab07e26698754770f08feee094c5c457550a78aa8d7a4d44935457eeb76a6e"})}));
        
