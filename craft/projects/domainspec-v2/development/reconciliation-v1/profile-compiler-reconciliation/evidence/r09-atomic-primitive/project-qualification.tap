          return descriptors;
        };
        const ruleString:RuleProtocol<string> = Object.freeze({normalize:(input:unknown):string=>{if(typeof input!=='string')throw new TypeError('RULE_INPUT');return input;},key:(value:string):string=>rulePart('String')+rulePart(value)});
        const ruleBool:RuleProtocol<boolean> = Object.freeze({normalize:(input:unknown):boolean=>{if(typeof input!=='boolean')throw new TypeError('RULE_INPUT');return input;},key:(value:boolean):string=>rulePart('Bool')+rulePart(value?'1':'0')});
