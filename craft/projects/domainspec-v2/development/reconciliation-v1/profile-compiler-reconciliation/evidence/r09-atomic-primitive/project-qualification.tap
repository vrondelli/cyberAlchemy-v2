        import {Mode as EnumDefinition} from "./mode.js";
        const brand:unique symbol = Symbol("beta:mode");
        export type ModeCase = Readonly<{[brand]:true;variant:EnumDefinition}>;
        const cases = Object.freeze({["Off"]:Object.freeze({[brand]:true as const,variant:EnumDefinition["Off"]}),["On"]:Object.freeze({[brand]:true as const,variant:EnumDefinition["On"]})});
        const ownership = new WeakSet<object>(Object.values(cases));
        const owned = (value:unknown):value is ModeCase => value !== null && typeof value === 'object' && ownership.has(value);
        const part = (value:string):string => value.length + ':' + value;
        export const ModeValueComponent = Object.freeze({
          protocol_id:'typescript.owned-enum-case/v1-candidate' as const,
          concept:"beta:mode",contract_sha256:"3eeaf28f589af095624fd15b62621d15abc12839aa5b07ccf2f3f6847a452e0f",
          definition_sha256:"03c1d3ee85fa833ecaf4670a7d982347b39e30977301539e224cc6324ae13908",
          values:cases,
          fromVariant:(value:unknown):ModeCase=>{
            if(typeof value !== 'string' || !Object.hasOwn(cases,value)) throw new TypeError('INVALID_ENUM_VARIANT');
            return cases[value as keyof typeof cases];
          },
          isOwned:owned,
          key:(value:unknown):string=>{if(!owned(value)) throw new TypeError('UNOWNED_ENUM_CASE');return part("beta:mode") + part("3eeaf28f589af095624fd15b62621d15abc12839aa5b07ccf2f3f6847a452e0f") + part(value.variant);},
          equals:(left:unknown,right:unknown):boolean=>owned(left) && owned(right) && left.variant === right.variant,
        });
        
