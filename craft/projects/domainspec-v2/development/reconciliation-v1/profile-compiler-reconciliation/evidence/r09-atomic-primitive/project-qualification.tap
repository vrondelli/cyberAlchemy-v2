      content: |-
        import {ruleAmountValid as validator0} from "../rules/amount-valid.js";
        export interface MoneyFields {
          readonly "amount":bigint;
        }
        const brand:unique symbol = Symbol("alpha:money");
        type Component = Readonly<{field:string;tag:'String'|'Bool'|'ValueObject'|'Optional'|'List'|'Set'|'Enum'|'Sum'|'UInt64'|'Entity';value:unknown;protocol_id:'typescript.owned-value-component/v1';protocol_sha256:string}>;
        export interface MoneySnapshot {
          readonly [brand]:true;
          readonly fields:MoneyFields;
          readonly components:readonly Component[];
          readonly hash:()=>string;
          readonly equals:(other:unknown)=>boolean;
        }
        type ValidatorTrace = Readonly<{rule:string;closure_sha256:string;artifact_sha256:string;outcome:'pass'|'fail'|'exception'}>;
        type Trace = Readonly<{route:string;phases:readonly string[];validators:readonly ValidatorTrace[]}>;
        type Result = Readonly<{ok:true;value:MoneySnapshot;failure_codes:readonly string[];trace:Trace}> | Readonly<{ok:false;value:null;failure_codes:readonly string[];trace:Trace}>;
        type BoundValidator = Readonly<{rule:string;closure_sha256:string;artifact_sha256:string;validate:(fields:MoneyFields)=>boolean}>;
        interface Factory {
          readonly create:(input:unknown)=>Result;
          readonly reconstruct:(input:unknown)=>Result;
          readonly extend:(id:string)=>Factory;
          readonly extensions:readonly string[];
        }
        const snapshots = new WeakMap<object,Readonly<{fields:MoneyFields;key:string}>>();
        const owned = (value:unknown):value is MoneySnapshot => value !== null && typeof value === 'object' && snapshots.has(value);
        const part = (value:string):string => value.length + ':' + value;
        type ValueProtocol<T> = Readonly<{normalize:(input:unknown)=>T;key:(value:T)=>string}>;
        const stringValue:ValueProtocol<string> = Object.freeze({
          normalize:(input:unknown):string=>{if(typeof input !== 'string') throw new TypeError('INVALID_COMPONENT');return input;},
          key:(value:string):string=>part('String') + part(value),
        });
        const boolValue:ValueProtocol<boolean> = Object.freeze({
          normalize:(input:unknown):boolean=>{if(typeof input !== 'boolean') throw new TypeError('INVALID_COMPONENT');return input;},
          key:(value:boolean):string=>part('Bool') + part(value ? '1' : '0'),
        });
        const ownedValue = <T>(provider:Readonly<{isOwned:(input:unknown)=>input is T;key:(input:unknown)=>string}>):ValueProtocol<T> => Object.freeze({
          normalize:(input:unknown):T=>{if(!provider.isOwned(input)) throw new TypeError('UNOWNED_COMPONENT');return input;},
          key:(value:T):string=>part('ValueObject') + part(provider.key(value)),
        });
        const optionalValue = <T>(element:ValueProtocol<T>):ValueProtocol<T|null> => Object.freeze({
          normalize:(input:unknown):T|null=>input === null ? null : element.normalize(input),
          key:(value:T|null):string=>part('Optional') + (value === null ? part('absent') : part('present') + part(element.key(value))),
        });
        const sequenceValue = <T>(element:ValueProtocol<T>,unique:boolean):ValueProtocol<readonly T[]> => {
          const ownedSequences = new WeakMap<readonly T[],string>();
          return Object.freeze({
            normalize:(input:unknown):readonly T[]=>{
              if(!Array.isArray(input) || Object.getPrototypeOf(input) !== Array.prototype) throw new TypeError('INVALID_COLLECTION');
              const descriptors:Record<string,PropertyDescriptor> = Object.getOwnPropertyDescriptors(input as object);
              const length = descriptors.length!.value as number;
              if(Reflect.ownKeys(descriptors).length !== length + 1) throw new TypeError('INVALID_COLLECTION');
              const entries:{value:T;key:string}[] = [];
