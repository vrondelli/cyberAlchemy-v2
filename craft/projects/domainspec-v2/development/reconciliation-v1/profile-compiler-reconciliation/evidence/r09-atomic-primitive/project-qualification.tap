          key:(value:T):string=>part('Entity') + part(provider.key(value)),
        });
        const field0Value = uint64Value;
        const field1Value = stringValue;
        const field2Value = enumValue(component2);
        const field3Value = ownedValue(component3);
        const valueKey = (fields:OrderFields):string => part("alpha:order") + part("3eeaf28f589af095624fd15b62621d15abc12839aa5b07ccf2f3f6847a452e0f") + part("id") + part("String") + part(field1Value.key(fields["id"]));
        const baseValidators:readonly BoundValidator[] = Object.freeze([Object.freeze({rule:"alpha:id-valid",closure_sha256:"dd03215c53f965fab408a0fa5b1fbd3da985e287a1edff5bb6306dae2ebe20a7",artifact_sha256:"6d3321be1588e1036825f5c8f9ce70581f91e0143054d1fe9917faf243104a1b",validate:(fields:OrderFields):boolean=>validator0({["id"]:fields["id"]})})]);
        const extensionValidators:Readonly<Record<string,readonly BoundValidator[]>> = Object.freeze({});
        const makeFactory = (extensions:readonly string[],validators:readonly BoundValidator[]):Factory => {
          const construct = (route:string,input:unknown,previous?:OrderSnapshot):Result => {
            const phases:string[] = ['normalize'];
            const trace:ValidatorTrace[] = [];
            const evidence = ():Trace => Object.freeze({route,phases:Object.freeze([...phases]),validators:Object.freeze([...trace])});
            const failure = (code:string):Result => Object.freeze({ok:false,value:null,failure_codes:Object.freeze([code]),trace:evidence()});
            let fields:OrderFields;
            try {
              if (input === null || typeof input !== 'object' || Array.isArray(input) || ![Object.prototype,null].includes(Object.getPrototypeOf(input))) return failure('INVALID_FIELDS');
              const descriptors = Object.getOwnPropertyDescriptors(input);
              if (Reflect.ownKeys(descriptors).some(key=>typeof key !== 'string' || !["amount","id","mode","money"].includes(key)) || Object.values(descriptors).some(d=>!Object.hasOwn(d,'value') || !d.enumerable)) return failure('INVALID_FIELDS');
              fields = Object.freeze({["amount"]:field0Value.normalize(Object.hasOwn(descriptors,"amount") ? descriptors["amount"]!.value : undefined),["id"]:field1Value.normalize(Object.hasOwn(descriptors,"id") ? descriptors["id"]!.value : undefined),["mode"]:field2Value.normalize(Object.hasOwn(descriptors,"mode") ? descriptors["mode"]!.value : undefined),["money"]:field3Value.normalize(Object.hasOwn(descriptors,"money") ? descriptors["money"]!.value : undefined)});
