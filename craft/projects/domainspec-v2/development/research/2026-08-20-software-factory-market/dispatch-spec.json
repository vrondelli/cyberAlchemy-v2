{
  "dispatch_id": "2026-08-20-domainspec-v2-software-factory-market-route",
  "intent": {
    "raw": "Create research showing how the software-factory market is doing and what DomainSpec v2 can reuse so v2 can work as a software factory too.",
    "objective": "Execute one exact-bound, independently reviewed Research Tower that maps the 2026 agentic software-development market to current DomainSpec v2 owners and produces local-only reuse recommendations without implementation or authority effects.",
    "target_artifact": "projects/domainspec-v2/development/research/2026-08-20-software-factory-market/findings.md",
    "arcanum_vocabulary": [
      "research-tower",
      "dispatch-spec",
      "domainspec-subagents-strategy",
      "orchestrate",
      "exact-binding",
      "promotion-guardrail"
    ],
    "operator_sentence": "Map the live market, preserve the local owner boundaries, and recommend only the reusable patterns that survive source, witness, and audit gates."
  },
  "mode": "research",
  "techniques": [
    "dialectic",
    "role_projection_boundary",
    "execution_receipt_handoff",
    "evidence_receipt_link",
    "authority_split_gate",
    "observability_grouping"
  ],
  "subagent_strategy": {
    "status": "required",
    "trigger": "Three independently falsifiable evidence lenses and three independent attack gates must be joined before one writer may produce the research result.",
    "explanation": "Market reality, product mechanics, and current v2 fit must remain separate through exploration; precedent, non-vacuity, and definitional reviewers must then challenge the joined candidate before writing.",
    "context": [
      "The exact research design is declared in dispatch-sheet.json under schema 0.8.0.",
      "The validated Inventory packet is discovery only; current v2 status binds to a refreshed live Craft digest at execution admission.",
      "The prior Factory.ai handoff is an input with a FIX review, not an accepted DomainSpec v2 baseline.",
      "All research writes remain inside the new tower folder and no product or authority mutation is allowed."
    ],
    "binding_mode": "capability-bound",
    "execution_owner": "orchestrate",
    "roles": [
      {
        "role_id": "market-product-exploration",
        "purpose": "Explore the market structure, maturity, product workflow, and runtime architecture through two independent external lenses.",
        "owns": "market and product explorer receipts",
        "capability_ref": "research-tower",
        "capability_target": "2026 software-factory market corpus",
        "capability_mode": "explore",
        "agent_count": 2,
        "mutation_policy": "read-only",
        "write_scope": [],
        "forbidden_write_scopes": [
          "projects/domainspec-v2/",
          "arcanum/",
          ".arcanum/",
          "telemetry/",
          ".git/"
        ],
        "depends_on_roles": [],
        "input_refs": [
          "levels/L0-corpus.md",
          "source-candidates.md",
          "dispatch-sheet.json"
        ],
        "output_refs": [
          "receipts/market-explorer.json",
          "receipts/product-architecture-explorer.json"
        ],
        "applies_to_steps": ["s1"]
      },
      {
        "role_id": "v2-fit-exploration",
        "purpose": "Map current DomainSpec v2 capability, owner, evidence, and gap state against reusable market patterns.",
        "owns": "v2 fit and owner explorer receipt",
        "capability_ref": "research-tower",
        "capability_target": "current DomainSpec v2 factory-relevant evidence",
        "capability_mode": "explore",
        "agent_count": 1,
        "mutation_policy": "read-only",
        "write_scope": [],
        "forbidden_write_scopes": [
          "projects/domainspec-v2/",
          "arcanum/",
          ".arcanum/",
          "telemetry/",
          ".git/"
        ],
        "depends_on_roles": [],
        "input_refs": [
          "strategy-inventory-packet.json",
          "projects/domainspec-v2/.craft/ledger.yml",
          "dispatch-sheet.json"
        ],
        "output_refs": ["receipts/v2-fit-explorer.json"],
        "applies_to_steps": ["s1"]
      },
      {
        "role_id": "research-synthesis",
        "purpose": "Join the three explorer lenses into exact-bound market, operating-model, owner, and reuse candidates.",
        "owns": "candidate synthesis and evidence-closure matrix",
        "capability_ref": "research-tower",
        "capability_target": "software-factory market-to-v2 synthesis",
        "capability_mode": "synthesize",
        "agent_count": 1,
        "mutation_policy": "read-only",
        "write_scope": [],
        "forbidden_write_scopes": [
          "projects/domainspec-v2/",
          "arcanum/",
          ".arcanum/",
          "telemetry/",
          ".git/"
        ],
        "depends_on_roles": [
          "market-product-exploration",
          "v2-fit-exploration"
        ],
        "input_refs": [
          "receipts/market-explorer.json",
          "receipts/product-architecture-explorer.json",
          "receipts/v2-fit-explorer.json"
        ],
        "output_refs": [
          "receipts/synthesis.json",
          "receipts/evidence-closure-candidate.json"
        ],
        "applies_to_steps": ["s2"]
      },
      {
        "role_id": "adversarial-review",
        "purpose": "Apply independent precedent, non-vacuity, and definitional-soundness gates to the synthesis.",
        "owns": "three reviewer receipts and evidence-closure verdict",
        "capability_ref": "research-tower",
        "capability_target": "software-factory market-to-v2 synthesis",
        "capability_mode": "review",
        "agent_count": 3,
        "mutation_policy": "read-only",
        "write_scope": [],
        "forbidden_write_scopes": [
          "projects/domainspec-v2/",
          "arcanum/",
          ".arcanum/",
          "telemetry/",
          ".git/"
        ],
        "depends_on_roles": ["research-synthesis"],
        "input_refs": [
          "receipts/synthesis.json",
          "receipts/evidence-closure-candidate.json"
        ],
        "output_refs": [
          "receipts/review-precedent.json",
          "receipts/review-non-vacuity.json",
          "receipts/review-definitional.json",
          "receipts/evidence-closure.json"
        ],
        "applies_to_steps": ["s3"]
      },
      {
        "role_id": "findings-writer",
        "purpose": "Write the evidence-closed, plain-language market and reuse findings artifact.",
        "owns": "findings.md only",
        "capability_ref": "research-tower",
        "capability_target": "projects/domainspec-v2/development/research/2026-08-20-software-factory-market/findings.md",
        "capability_mode": "write-findings",
        "agent_count": 1,
        "mutation_policy": "artifact-only",
        "write_scope": [
          "projects/domainspec-v2/development/research/2026-08-20-software-factory-market/findings.md"
        ],
        "forbidden_write_scopes": [
          "projects/domainspec-v2/impl/",
          "projects/domainspec-v2/.craft/",
          "projects/domainspec-v2/definitions/",
          "arcanum/",
          ".arcanum/",
          "telemetry/",
          ".git/"
        ],
        "depends_on_roles": ["adversarial-review"],
        "input_refs": [
          "receipts/synthesis.json",
          "receipts/evidence-closure.json",
          "research.md"
        ],
        "output_refs": [
          "receipts/writer.json"
        ],
        "applies_to_steps": ["s4"]
      },
      {
        "role_id": "final-audit",
        "purpose": "Audit the findings against the frozen goal, evidence contract, source cutoff, owner boundaries, and claim ceiling.",
        "owns": "final audit receipt",
        "capability_ref": "research-tower",
        "capability_target": "projects/domainspec-v2/development/research/2026-08-20-software-factory-market/findings.md",
        "capability_mode": "audit",
        "agent_count": 1,
        "mutation_policy": "read-only",
        "write_scope": [],
        "forbidden_write_scopes": [
          "projects/domainspec-v2/",
          "arcanum/",
          ".arcanum/",
          "telemetry/",
          ".git/"
        ],
        "depends_on_roles": ["findings-writer"],
        "input_refs": [
          "findings.md",
          "receipts/evidence-closure.json",
          "receipts/writer.json"
        ],
        "output_refs": ["reviews/audit-final.json"],
        "applies_to_steps": ["s5"]
      }
    ],
    "execution_waves": [
      {
        "wave_id": "exploration",
        "role_ids": [
          "market-product-exploration",
          "v2-fit-exploration"
        ],
        "parallel": true,
        "join_policy": "all",
        "gate_after": "g-explorer-join",
        "on_incomplete": "block"
      },
      {
        "wave_id": "synthesis",
        "role_ids": ["research-synthesis"],
        "parallel": false,
        "join_policy": "all",
        "depends_on_waves": ["exploration"],
        "gate_after": "g-synthesis-join",
        "on_incomplete": "block"
      },
      {
        "wave_id": "review",
        "role_ids": ["adversarial-review"],
        "parallel": false,
        "join_policy": "all",
        "depends_on_waves": ["synthesis"],
        "gate_after": "g-evidence-closure",
        "on_incomplete": "block"
      },
      {
        "wave_id": "writing",
        "role_ids": ["findings-writer"],
        "parallel": false,
        "join_policy": "all",
        "depends_on_waves": ["review"],
        "gate_after": "g-writer-join",
        "on_incomplete": "block"
      },
      {
        "wave_id": "audit",
        "role_ids": ["final-audit"],
        "parallel": false,
        "join_policy": "all",
        "depends_on_waves": ["writing"],
        "gate_after": "g-final-audit",
        "on_incomplete": "block"
      }
    ],
    "parallelism": "mixed",
    "join_policy": "parent_synthesis",
    "authorization": "approved",
    "permission_prompt": "Run this exact nine-agent, read-mostly market-research dispatch and allow only the named writer to create findings.md after evidence closure?",
    "receipt_requirements": [
      "agent_id",
      "role_id",
      "spawn_status",
      "join_status",
      "close_status",
      "residue",
      "reroute",
      "dispatch_id",
      "step_id",
      "capability_ref",
      "capability_target",
      "capability_mode",
      "wave_id",
      "write_scope",
      "status",
      "artifacts",
      "validation",
      "observer_status",
      "blockers",
      "handoff_note"
    ]
  },
  "steps": [
    {
      "step_id": "s1",
      "name": "Freeze and explore the external market and current v2 surface",
      "capability_ref": "research-tower",
      "capability_status": "candidate",
      "mode": "explore",
      "pattern": "fanout",
      "parallel": true,
      "roles": [
        "market-product-exploration",
        "v2-fit-exploration"
      ],
      "inputs": [
        {"kind": "intent", "ref": "intent.raw"},
        {"kind": "artifact", "ref": "levels/L0-corpus.md"},
        {"kind": "artifact", "ref": "source-candidates.md"},
        {"kind": "artifact", "ref": "strategy-inventory-packet.json"},
        {"kind": "artifact", "ref": "projects/domainspec-v2/.craft/ledger.yml"},
        {"kind": "artifact", "ref": "dispatch-sheet.json"}
      ],
      "outputs": [
        {"kind": "receipt", "ref": "receipts/market-explorer.json"},
        {"kind": "receipt", "ref": "receipts/product-architecture-explorer.json"},
        {"kind": "receipt", "ref": "receipts/v2-fit-explorer.json"}
      ],
      "join_policy": "all",
      "stop_conditions": [
        "stop if the cohort cannot be frozen without arbitrary selection",
        "stop if current v2 authority bytes cannot be digest-bound",
        "stop if an explorer attempts a repository write or external product action"
      ]
    },
    {
      "step_id": "s2",
      "name": "Synthesize market, operating-model, owner, and reuse candidates",
      "capability_ref": "research-tower",
      "capability_status": "candidate",
      "mode": "synthesize",
      "pattern": "synthesis",
      "parallel": false,
      "depends_on_steps": ["s1"],
      "roles": ["research-synthesis"],
      "inputs": [
        {"kind": "receipt", "ref": "receipts/market-explorer.json"},
        {"kind": "receipt", "ref": "receipts/product-architecture-explorer.json"},
        {"kind": "receipt", "ref": "receipts/v2-fit-explorer.json"}
      ],
      "outputs": [
        {"kind": "receipt", "ref": "receipts/synthesis.json"},
        {"kind": "receipt", "ref": "receipts/evidence-closure-candidate.json"}
      ],
      "join_policy": "all",
      "stop_conditions": [
        "stop if the three explorer returns cannot be reconciled without suppressing disagreement",
        "stop if any recommended row lacks a current local owner"
      ]
    },
    {
      "step_id": "s3",
      "name": "Run precedent, non-vacuity, and definitional review",
      "capability_ref": "research-tower",
      "capability_status": "candidate",
      "mode": "review",
      "pattern": "dialectic",
      "parallel": true,
      "depends_on_steps": ["s2"],
      "roles": ["adversarial-review"],
      "inputs": [
        {"kind": "receipt", "ref": "receipts/synthesis.json"},
        {"kind": "receipt", "ref": "receipts/evidence-closure-candidate.json"}
      ],
      "outputs": [
        {"kind": "receipt", "ref": "receipts/review-precedent.json"},
        {"kind": "receipt", "ref": "receipts/review-non-vacuity.json"},
        {"kind": "receipt", "ref": "receipts/review-definitional.json"},
        {"kind": "receipt", "ref": "receipts/evidence-closure.json"}
      ],
      "join_policy": "all",
      "convergence_criteria": [
        "every load-bearing row is exact-bound or explicitly open",
        "every recommendation has a current owner and non-vacuous witness",
        "no runtime, evidence, or authority meanings are collapsed"
      ],
      "stop_conditions": [
        "stop if evidence closure fails after the single allowed explorer feedback return",
        "stop if a KILL finding removes the central recommendation and no sound branch remains"
      ]
    },
    {
      "step_id": "s4",
      "name": "Write the evidence-closed findings",
      "capability_ref": "research-tower",
      "capability_status": "candidate",
      "mode": "write-findings",
      "pattern": "sequential",
      "parallel": false,
      "depends_on_steps": ["s3"],
      "roles": ["findings-writer"],
      "inputs": [
        {"kind": "receipt", "ref": "receipts/synthesis.json"},
        {"kind": "receipt", "ref": "receipts/evidence-closure.json"},
        {"kind": "artifact", "ref": "research.md"}
      ],
      "outputs": [
        {"kind": "artifact", "ref": "findings.md"},
        {"kind": "receipt", "ref": "receipts/writer.json"}
      ],
      "join_policy": "all",
      "stop_conditions": [
        "stop unless the evidence-closure receipt passes",
        "stop if the writer exceeds the exact one-file write scope"
      ]
    },
    {
      "step_id": "s5",
      "name": "Audit the findings and close or return one bounded repair",
      "capability_ref": "research-tower",
      "capability_status": "candidate",
      "mode": "audit",
      "pattern": "validation",
      "parallel": false,
      "depends_on_steps": ["s4"],
      "roles": ["final-audit"],
      "inputs": [
        {"kind": "artifact", "ref": "findings.md"},
        {"kind": "receipt", "ref": "receipts/evidence-closure.json"},
        {"kind": "receipt", "ref": "receipts/writer.json"}
      ],
      "outputs": [
        {"kind": "receipt", "ref": "reviews/audit-final.json"}
      ],
      "evidence_artifact": "reviews/audit-final.json",
      "join_policy": "all",
      "stop_conditions": [
        "stop at BLOCK if the audit cannot pass after one bounded writer repair",
        "stop before any implementation, authority, vendor, publication, release, deployment, commit, or push action"
      ]
    }
  ],
  "gates": [
    {
      "gate_id": "g-user-confirmation",
      "kind": "human_approval",
      "owner": "user",
      "condition": "The exact validated research sheet and tension results are shown, and the user replies exactly confirmed before registration or spawning.",
      "on_fail": "block"
    },
    {
      "gate_id": "g-explorer-join",
      "kind": "validation",
      "owner": "orchestrate",
      "condition": "All three explorer receipts are returned, joined, closed, source-bound, and free of repository writes before synthesis.",
      "applies_after_wave": "exploration",
      "requires_role_receipts": [
        "receipts/market-explorer.json",
        "receipts/product-architecture-explorer.json",
        "receipts/v2-fit-explorer.json"
      ],
      "on_fail": "block"
    },
    {
      "gate_id": "g-synthesis-join",
      "kind": "validation",
      "owner": "orchestrate",
      "condition": "The synthesis and evidence-closure candidate receipts are joined and closed before adversarial review begins.",
      "applies_after_wave": "synthesis",
      "requires_role_receipts": [
        "receipts/synthesis.json",
        "receipts/evidence-closure-candidate.json"
      ],
      "on_fail": "block"
    },
    {
      "gate_id": "g-evidence-closure",
      "kind": "quality",
      "owner": "parent-research-owner",
      "condition": "All three reviewer receipts close every load-bearing row through exact sources, current owners, non-vacuous witnesses, and definitional boundaries before writing.",
      "applies_after_wave": "review",
      "requires_role_receipts": [
        "receipts/review-precedent.json",
        "receipts/review-non-vacuity.json",
        "receipts/review-definitional.json",
        "receipts/evidence-closure.json"
      ],
      "on_fail": "block"
    },
    {
      "gate_id": "g-writer-join",
      "kind": "validation",
      "owner": "orchestrate",
      "condition": "The writer receipt is joined and findings.md exists within the one-file write scope before final audit begins.",
      "applies_after_wave": "writing",
      "requires_role_receipts": ["receipts/writer.json"],
      "on_fail": "block"
    },
    {
      "gate_id": "g-final-audit",
      "kind": "validation",
      "owner": "final-audit",
      "condition": "The exact findings pass the frozen goal, evidence, owner, source-cutoff, verdict-matrix, and claim-ceiling checks.",
      "applies_after_wave": "audit",
      "requires_role_receipts": ["reviews/audit-final.json"],
      "on_fail": "block"
    }
  ],
  "observability": {
    "dispatch_id_required": true,
    "trace_events": [
      "dispatch_proposed",
      "human_confirmation_required",
      "dispatch_registered",
      "agent_spawned",
      "agent_joined",
      "agent_closed",
      "wave_gate_passed",
      "wave_gate_blocked",
      "evidence_closed",
      "writer_admitted",
      "audit_completed",
      "dispatch_closed"
    ],
    "signal_grouping": "dispatch_id, wave_id, role_id, step_id, capability_ref, status"
  },
  "boundary_evidence": {
    "boundaries": [
      {
        "boundary_id": "b-external-source",
        "kind": "external_context",
        "from_owner": "external product and market sources",
        "to_owner": "research-tower",
        "applies_to_steps": ["s1", "s2", "s3"],
        "contract": "External claims enter only with source kind, date, exact selector, status qualifier, and caveat; no repository material is sent to a vendor.",
        "on_violation": "block"
      },
      {
        "boundary_id": "b-v2-authority",
        "kind": "artifact_import",
        "from_owner": "DomainSpec v2 Craft and source owners",
        "to_owner": "research-tower",
        "applies_to_steps": ["s1", "s2", "s3", "s5"],
        "contract": "Current v2 state is read-only and digest-bound; research may describe or recommend but cannot select, mutate, accept, promote, release, or change authority.",
        "on_violation": "block"
      },
      {
        "boundary_id": "b-evidence-return",
        "kind": "evidence_return",
        "from_owner": "explorers, synthesizer, and reviewers",
        "to_owner": "findings-writer",
        "applies_to_steps": ["s4"],
        "contract": "The writer receives only joined receipts and a passing exact-binding evidence-closure artifact.",
        "on_violation": "block"
      },
      {
        "boundary_id": "b-findings-write",
        "kind": "state_write",
        "from_owner": "research-tower",
        "to_owner": "findings-writer",
        "applies_to_steps": ["s4"],
        "contract": "The writer may create or revise only findings.md and only after the evidence gate passes.",
        "on_violation": "block"
      },
      {
        "boundary_id": "b-human-confirmation",
        "kind": "human_approval",
        "from_owner": "user",
        "to_owner": "orchestrate",
        "applies_to_steps": ["s1"],
        "contract": "No research agent spawns and no dispatch row is registered until the user explicitly confirms the exact validated route.",
        "on_violation": "block"
      }
    ],
    "authority": {
      "lifecycle": "domainspec-subagents-strategy and dispatch ledger",
      "execution": "orchestrate",
      "validation": "dispatch-spec, check-tension, reviewers, and final auditor",
      "evidence": "research-tower exact-binding artifacts",
      "promotion": "not granted; later named owners only"
    },
    "receipts": [
      {
        "receipt_id": "research-role-receipt",
        "producer": "every delegated role",
        "required_fields": [
          "dispatch_id",
          "step_id",
          "capability_ref",
          "status",
          "artifacts",
          "validation",
          "observer_status",
          "blockers",
          "residue",
          "handoff_note"
        ],
        "stores": ["working-folder receipts and orchestration event stream"],
        "on_missing": "block"
      },
      {
        "receipt_id": "final-audit-receipt",
        "producer": "final-audit",
        "required_fields": [
          "dispatch_id",
          "status",
          "validation",
          "audit_reference",
          "blockers",
          "residue",
          "handoff_note"
        ],
        "stores": ["reviews/audit-final.json"],
        "on_missing": "block"
      }
    ],
    "state_namespaces": [
      {
        "namespace": "projects/domainspec-v2/development/research/2026-08-20-software-factory-market/",
        "owner": "parent research owner, with findings.md delegated only to the writer",
        "write_policy": "research artifacts only; all other repository and external state is read-only or forbidden"
      }
    ],
    "promotion_splits": [
      {
        "source": "local research recommendation",
        "target": "DomainSpec v2 definition, ontology, implementation, product, vendor, release, or production decision",
        "rule": "Research may name a promotion candidate or experiment, but only a later named owner and governed route may change the target.",
        "on_violation": "block"
      }
    ]
  },
  "promotion_guardrails": [
    "Research closure does not authorize implementation, vendor selection, purchasing, integration, deployment, publication, release, commit, or push.",
    "Operational execution, tests, review, and structured output never become semantic or promotion authority by implication.",
    "Only Arcanum is public; private DomainSpec v2 or authority prose must not be copied into public Arcanum."
  ]
}
