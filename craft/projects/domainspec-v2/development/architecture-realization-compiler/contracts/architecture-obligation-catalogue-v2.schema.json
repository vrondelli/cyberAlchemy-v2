{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/architecture-obligation-catalogue/v2",
  "title": "ArchitectureObligationCatalogue/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_id",
    "catalogue_version",
    "supersedes_ref",
    "definition_ref",
    "ontology_ref",
    "profile_ref",
    "obligations",
    "catalogue_sha256",
    "owner_ref",
    "authority_effect"
  ],
  "properties": {
    "schema_version": { "const": "ArchitectureObligationCatalogue/v2" },
    "catalogue_id": { "type": "string", "minLength": 1 },
    "catalogue_version": { "const": "2" },
    "supersedes_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "catalogue_version", "path", "sha256"],
      "properties": {
        "catalogue_id": { "type": "string", "minLength": 1 },
        "catalogue_version": { "const": "1" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "definition_version",
        "definition_sha256",
        "authority_status",
        "path",
        "sha256"
      ],
      "properties": {
        "definition_id": { "type": "string", "minLength": 1 },
        "definition_version": { "type": "string", "minLength": 1 },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "authority_status": { "enum": ["candidate-fixture", "owner-issued"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ontology_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_id", "schema_version", "path", "sha256"],
      "properties": {
        "ontology_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "schema_version", "path", "sha256", "extends"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "extends": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/profileSource" }
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_key",
          "contract_version",
          "subject_ref",
          "operator",
          "expected_payload",
          "failure_codes"
        ],
        "properties": {
          "obligation_key": { "const": "enum.member-bijection@1" },
          "contract_version": { "const": "1" },
          "subject_ref": { "type": "string", "minLength": 1 },
          "operator": { "const": "member-bijection" },
          "expected_payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concept_id", "composition_kind", "order_semantics", "members"],
            "properties": {
              "concept_id": { "type": "string", "minLength": 1 },
              "composition_kind": { "const": "direct" },
              "order_semantics": { "const": "none" },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["member_id", "semantic_value"],
                  "properties": {
                    "member_id": { "type": "string", "minLength": 1 },
                    "semantic_value": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "failure_codes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "catalogue_sha256": { "$ref": "#/$defs/sha256" },
    "owner_ref": { "const": "architecture-obligation-catalogue-owner" },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "schema_version", "path", "sha256"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
