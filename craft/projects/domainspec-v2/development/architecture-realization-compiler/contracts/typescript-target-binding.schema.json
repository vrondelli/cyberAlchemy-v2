{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/typescript-target-binding/v1",
  "title": "TypeScriptTargetBinding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "binding_id", "definition_ref", "language", "module_path",
    "export_name", "type_name", "member_names", "provider_module_specifier",
    "protocol_ref", "profile_ref", "provider_ref", "emitter_version",
    "emitter_config_digest", "format_version", "binding_sha256", "authority_effect"
  ],
  "properties": {
    "schema_version": { "const": "TypeScriptTargetBinding/v1" },
    "binding_id": { "type": "string", "minLength": 1 },
    "definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "definition_version", "definition_sha256"],
      "properties": {
        "definition_id": { "type": "string", "minLength": 1 },
        "definition_version": { "type": "string", "minLength": 1 },
        "definition_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "language": { "const": "typescript" },
    "module_path": { "type": "string", "minLength": 1 },
    "export_name": { "$ref": "#/$defs/identifier" },
    "type_name": { "$ref": "#/$defs/identifier" },
    "member_names": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/identifier" }
    },
    "provider_module_specifier": { "const": "../runtime/enum/index.js" },
    "protocol_ref": { "const": "typescript.owned-const-object-enum/v1" },
    "profile_ref": { "$ref": "#/$defs/source" },
    "provider_ref": { "$ref": "#/$defs/source" },
    "emitter_version": { "type": "string", "minLength": 1 },
    "emitter_config_digest": { "$ref": "#/$defs/sha256" },
    "format_version": { "const": "typescript-printer/v1" },
    "binding_sha256": { "$ref": "#/$defs/sha256" },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
