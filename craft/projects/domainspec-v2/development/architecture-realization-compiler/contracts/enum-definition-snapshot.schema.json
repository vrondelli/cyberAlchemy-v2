{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/enum-definition-snapshot/v1",
  "title": "EnumDefinitionSnapshot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_id",
    "definition_version",
    "concept_id",
    "composition_kind",
    "order_semantics",
    "members",
    "definition_sha256",
    "authority_ref",
    "authority_status",
    "authority_effect"
  ],
  "properties": {
    "schema_version": { "const": "EnumDefinitionSnapshot/v1" },
    "definition_id": { "type": "string", "minLength": 1 },
    "definition_version": { "type": "string", "minLength": 1 },
    "concept_id": { "type": "string", "minLength": 1 },
    "composition_kind": { "const": "direct" },
    "order_semantics": { "const": "none" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "semantic_value"],
        "properties": {
          "member_id": { "type": "string", "minLength": 1 },
          "semantic_value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_ref": { "type": "string", "minLength": 1 },
    "authority_status": { "enum": ["candidate-fixture", "owner-issued"] },
    "authority_effect": { "const": "none" }
  }
}
