{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/architecture-realization-spec/v1",
  "title": "ArchitectureRealizationSpec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "ontology_ref",
    "profile_ref",
    "realization_type",
    "definition_type_ref",
    "required_properties",
    "required_relations",
    "constraint_operators",
    "composition_kind",
    "unsupported_outcomes",
    "spec_sha256",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "ArchitectureRealizationSpec/v1"},
    "spec_id": {"type": "string", "minLength": 1},
    "ontology_ref": {"$ref": "#/$defs/ontologyRef"},
    "profile_ref": {"$ref": "#/$defs/profileRef"},
    "realization_type": {"const": "architecture.EnumImplementation"},
    "definition_type_ref": {"const": "DS-D1.3"},
    "required_properties": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/propertyDefinition"}
    },
    "required_relations": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string"}
    },
    "constraint_operators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operatorDefinition"}
    },
    "composition_kind": {"const": "direct"},
    "unsupported_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "exactSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "schema_version", "sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "ontologyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_id", "schema_version", "sha256"],
      "properties": {
        "ontology_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "schema_version", "sha256", "extends"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "extends": {"type": "array", "items": {"$ref": "#/$defs/exactSourceRef"}}
      }
    },
    "valueType": {
      "type": "object",
      "minProperties": 1
    },
    "propertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_id", "value_type", "observation_stage", "owner_route", "forbidden_inference"],
      "properties": {
        "property_id": {"type": "string", "minLength": 1},
        "value_type": {"$ref": "#/$defs/valueType"},
        "observation_stage": {"type": "string", "minLength": 1},
        "owner_route": {"type": "string", "minLength": 1},
        "forbidden_inference": {"type": "string", "minLength": 1}
      }
    },
    "operatorDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "accepted_value_types", "expected_operand_kinds"],
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "accepted_value_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "expected_operand_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
