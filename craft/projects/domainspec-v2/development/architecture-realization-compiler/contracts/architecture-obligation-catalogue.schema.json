{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/architecture-obligation-catalogue/v1",
  "title": "ArchitectureObligationCatalogue/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_id",
    "catalogue_version",
    "definition_ref",
    "ontology_ref",
    "profile_ref",
    "obligations",
    "catalogue_sha256",
    "owner_ref",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "ArchitectureObligationCatalogue/v1"},
    "catalogue_id": {"type": "string", "minLength": 1},
    "catalogue_version": {"const": "1"},
    "definition_ref": {"$ref": "#/$defs/definitionRef"},
    "ontology_ref": {"$ref": "#/$defs/ontologyRef"},
    "profile_ref": {"$ref": "#/$defs/profileRef"},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/obligation"}
    },
    "catalogue_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "owner_ref": {"const": "architecture-obligation-catalogue-owner"},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sourceFields": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "definitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "definition_version", "authority_status", "path", "sha256"],
      "properties": {
        "definition_id": {"const": "candidate.order-status"},
        "definition_version": {"const": "1"},
        "authority_status": {"const": "candidate-fixture"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "ontologyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_id", "schema_version", "path", "sha256"],
      "properties": {
        "ontology_id": {"const": "implementation-conformance.architecture-properties"},
        "schema_version": {"const": "domainspec-architecture-property-ontology/v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "extendedProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "schema_version", "path", "sha256"],
      "properties": {
        "profile_id": {"const": "architecture.base-domain"},
        "schema_version": {"const": "domainspec-architecture-profile/v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "schema_version", "path", "sha256", "extends"],
      "properties": {
        "profile_id": {"const": "architecture.typescript-strict"},
        "schema_version": {"const": "domainspec-architecture-profile/v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "extends": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/extendedProfileRef"}
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "semantic_value"],
      "properties": {
        "member_id": {"type": "string", "minLength": 1},
        "semantic_value": {"type": "string", "minLength": 1}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "composition_kind", "order_semantics", "members"],
      "properties": {
        "concept_id": {"const": "candidate.order-status"},
        "composition_kind": {"const": "direct"},
        "order_semantics": {"const": "none"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/member"}
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_key",
        "contract_version",
        "subject_ref",
        "operator",
        "expected_payload",
        "failure_codes"
      ],
      "properties": {
        "obligation_key": {"const": "enum.member-bijection@1"},
        "contract_version": {"const": "1"},
        "subject_ref": {"const": "candidate.order-status@1"},
        "operator": {"const": "member-bijection"},
        "expected_payload": {"$ref": "#/$defs/payload"},
        "failure_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
