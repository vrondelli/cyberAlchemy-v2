{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/schemas/alchlang/evf-causal-join/v1-candidate",
  "title": "AlchLang EVF Causal Join Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "join_id",
    "route_kind",
    "causal_outcome",
    "cause",
    "evaluation_request_ref",
    "provider_receipt_ref",
    "evidence_binding_ref",
    "evf_join_ref",
    "domain_join_status",
    "can_satisfy_obligation",
    "revision_route",
    "residue",
    "provider_execution_by_join",
    "provider_result_consumed",
    "evidence_omitted",
    "non_pass_promoted_to_pass",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "alchlang.evf-causal-join/v1-candidate"},
    "join_id": {"$ref": "#/$defs/text"},
    "route_kind": {"enum": ["execution-evidence", "theorem-evidence"]},
    "causal_outcome": {"enum": ["pass", "fail", "unknown", "timeout", "malformed", "stale", "unavailable", "not-evaluable"]},
    "cause": {"$ref": "#/$defs/text"},
    "evaluation_request_ref": {"$ref": "#/$defs/exactRef"},
    "provider_receipt_ref": {"$ref": "#/$defs/exactRef"},
    "evidence_binding_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "evf_join_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "domain_join_status": {"enum": ["PASS_BOUNDED", "NON_PASS", "UNSUPPORTED", "INDETERMINATE", "STALE", "MISSING", "FAILED", "BLOCKED"]},
    "can_satisfy_obligation": {"type": "boolean"},
    "revision_route": {"enum": ["business-meaning", "interpretation-model", "formal-claim", "capability-assessment", "neutral-obligation", "projection", "runtime-binding", "theorem-binding", "provider", "evf-join", "none"]},
    "residue": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "provider_execution_by_join": {"const": false},
    "provider_result_consumed": {"type": "boolean"},
    "evidence_omitted": {"const": false},
    "non_pass_promoted_to_pass": {"const": false},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "allOf": [
    {
      "if": {"properties": {"causal_outcome": {"const": "pass"}}},
      "then": {
        "properties": {
          "domain_join_status": {"const": "PASS_BOUNDED"},
          "can_satisfy_obligation": {"const": true},
          "revision_route": {"const": "none"},
          "residue": {"maxItems": 0},
          "evaluation_request_ref": {"$ref": "#/$defs/exactCurrentRef"},
          "provider_receipt_ref": {"$ref": "#/$defs/exactCurrentRef"}
        }
      },
      "else": {
        "properties": {
          "domain_join_status": {"not": {"const": "PASS_BOUNDED"}},
          "can_satisfy_obligation": {"const": false},
          "revision_route": {"not": {"const": "none"}},
          "residue": {"minItems": 3}
        }
      }
    },
    {
      "if": {"properties": {"causal_outcome": {"enum": ["unavailable", "not-evaluable"]}}},
      "then": {"properties": {"provider_result_consumed": {"const": false}}},
      "else": {"properties": {"provider_result_consumed": {"const": true}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "current": {"type": "boolean"}
      }
    },
    "exactCurrentRef": {
      "allOf": [
        {"$ref": "#/$defs/exactRef"},
        {"properties": {"current": {"const": true}}}
      ]
    }
  }
}
