{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/alchlang/evf-case-claim-artifact/v1-candidate",
  "title": "Unverified per-case reported outcome candidate",
  "description": "Exact caller-supplied claim; neither provider execution nor oracle truth is established.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evaluation_request_ref", "obligation_id", "case_id", "witness_input_digest", "reported_native_output", "reported_normalized_outcome", "reported_oracle_evaluation"],
  "properties": {
    "schema_version": {"const": "alchlang.evf-case-claim-artifact/v1-candidate"},
    "evaluation_request_ref": {"$ref": "#/$defs/ref"},
    "obligation_id": {"$ref": "#/$defs/text"}, "case_id": {"$ref": "#/$defs/text"},
    "witness_input_digest": {"$ref": "#/$defs/digest"}, "reported_native_output": {},
    "reported_normalized_outcome": {"const": "passed"}, "reported_oracle_evaluation": {"const": "matched"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}}
  }
}
