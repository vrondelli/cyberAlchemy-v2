{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/alchlang/evf-evidence-input/v2-candidate",
  "title": "Unverified case-claim EVF input candidate",
  "description": "Reported pass is a caller claim, never an observed provider result.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "join_id", "provider", "reported_causal_outcome", "cause", "evaluation_request_ref", "provider_outcome_ref", "comparability", "result_semantics", "claim_ceiling", "bindings", "case_claims"],
  "properties": {
    "schema_version": {"const": "alchlang.evf-evidence-input/v2-candidate"},
    "join_id": {"$ref": "#/$defs/text"},
    "provider": {"$ref": "#/$defs/provider"},
    "reported_causal_outcome": {"const": "pass"},
    "cause": {"$ref": "#/$defs/text"},
    "evaluation_request_ref": {"$ref": "#/$defs/ref"},
    "provider_outcome_ref": {"$ref": "#/$defs/ref"},
    "comparability": {"$ref": "#/$defs/comparability"},
    "result_semantics": {"$ref": "#/$defs/text"},
    "claim_ceiling": {"$ref": "#/$defs/text"},
    "bindings": {"type": "object", "additionalProperties": false,
      "required": ["formal_claim_ref", "capability_assessment_ref", "obligation_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "native_source_bundle_ref", "runtime_binding_ref", "profile_ref", "environment_refs"],
      "properties": {
        "formal_claim_ref": {"$ref": "#/$defs/ref"}, "capability_assessment_ref": {"$ref": "#/$defs/ref"},
        "obligation_ref": {"$ref": "#/$defs/ref"}, "obligation_set_ref": {"$ref": "#/$defs/ref"},
        "projection_ref": {"$ref": "#/$defs/ref"}, "preservation_binding_ref": {"$ref": "#/$defs/ref"},
        "native_source_bundle_ref": {"$ref": "#/$defs/ref"}, "runtime_binding_ref": {"$ref": "#/$defs/ref"},
        "profile_ref": {"$ref": "#/$defs/ref"}, "environment_refs": {"$ref": "#/$defs/refSet"}
      }
    },
    "case_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/caseClaim"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "refSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "provider": {"type": "object", "additionalProperties": false, "required": ["owner", "id", "version"], "properties": {"owner": {"$ref": "#/$defs/text"}, "id": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}},
    "comparability": {"type": "object", "additionalProperties": false, "required": ["same_claim", "same_evaluation_request", "same_domain", "same_result_semantics"], "properties": {"same_claim": {"const": true}, "same_evaluation_request": {"const": true}, "same_domain": {"const": true}, "same_result_semantics": {"const": true}}},
    "caseClaim": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "case_id", "witness_input_digest", "reported_native_output", "reported_normalized_outcome", "reported_oracle_evaluation", "artifact_ref"], "properties": {"obligation_id": {"$ref": "#/$defs/text"}, "case_id": {"$ref": "#/$defs/text"}, "witness_input_digest": {"$ref": "#/$defs/digest"}, "reported_native_output": {}, "reported_normalized_outcome": {"const": "passed"}, "reported_oracle_evaluation": {"const": "matched"}, "artifact_ref": {"$ref": "#/$defs/ref"}}}
  }
}
