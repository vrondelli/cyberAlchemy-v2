{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alchlang.p04-d65-construction-binding/v2-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "binding_id",
    "binding_manifest_sha256",
    "construction_id",
    "project_ref",
    "subject_ref",
    "invariant_ref",
    "definition_revision",
    "state",
    "contributor_routes",
    "artifact_bindings",
    "stage_accounting",
    "exact_candidate",
    "internal_construction_verification",
    "product_validation",
    "eligibility",
    "registration",
    "authority_requests",
    "challenge_route",
    "drift_route",
    "claim_ceiling",
    "open_questions",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "alchlang.p04-d65-construction-binding/v2-candidate"},
    "date": {"const": "2026-10-02"},
    "binding_id": {"pattern": "^alchlang-domainspec-p04-[a-f0-9]{16}$"},
    "binding_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "construction_id": {"const": "alchlang-domainspec-application-v1"},
    "project_ref": {"const": "craft/projects/domainspec-v2/development/authoring-to-runtime-v1"},
    "subject_ref": {"type": "string", "minLength": 1},
    "invariant_ref": {"const": "CAV2-D65"},
    "definition_revision": {"const": 2},
    "state": {"const": "candidate_frozen"},
    "contributor_routes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_bindings": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "#/$defs/artifactBinding"}
    },
    "stage_accounting": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {"$ref": "#/$defs/definitionPrototypeStage"},
        {"$ref": "#/$defs/ontologyScaffoldStage"},
        {"$ref": "#/$defs/productCapabilityStage"},
        {"$ref": "#/$defs/businessPrototypeStage"},
        {"$ref": "#/$defs/domainspecPrototypeStage"},
        {"$ref": "#/$defs/compiledSystemStage"},
        {"$ref": "#/$defs/implementationPrototypeStage"},
        {"$ref": "#/$defs/testableCandidateStage"},
        {"$ref": "#/$defs/productTestEvidenceStage"},
        {"$ref": "#/$defs/productApprovalStage"},
        {"$ref": "#/$defs/postApprovalStage"}
      ],
      "items": false
    },
    "exact_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_manifest_sha256", "candidate_file_sha256", "artifact_binding_id", "currentness_ref"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_file_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_binding_id": {"const": "p03-exact-candidate"},
        "currentness_ref": {"const": "p03-qualification"}
      }
    },
    "internal_construction_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_binding_ids", "all_current", "not_product_test_evidence"],
      "properties": {
        "evidence_binding_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "all_current": {"const": true},
        "not_product_test_evidence": {"const": true}
      }
    },
    "product_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_node", "product_test_contract_ref", "product_test_evidence_refs", "product_owner_testing_performed", "product_approval_ref", "deferred_reason"],
      "properties": {
        "handoff_node": {"const": "L4X"},
        "product_test_contract_ref": {"type": "null"},
        "product_test_evidence_refs": {"type": "array", "maxItems": 0},
        "product_owner_testing_performed": {"const": false},
        "product_approval_ref": {"type": "null"},
        "deferred_reason": {"type": "string", "minLength": 1}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l4x_product_review_handoff", "product_approval_request", "authority_request"],
      "properties": {
        "l4x_product_review_handoff": {"$ref": "#/$defs/ineligibleDecision"},
        "product_approval_request": {"$ref": "#/$defs/ineligibleDecision"},
        "authority_request": {"$ref": "#/$defs/ineligibleDecision"}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "target", "governance_registry_mutated", "registry_reference_binding_id"],
      "properties": {
        "performed": {"const": false},
        "target": {"type": "null"},
        "governance_registry_mutated": {"const": false},
        "registry_reference_binding_id": {"const": "governance-prototype-construction-registry"}
      }
    },
    "authority_requests": {"type": "array", "maxItems": 0},
    "challenge_route": {"type": "string", "minLength": 1},
    "drift_route": {"type": "string", "minLength": 1},
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_accounting_complete", "product_owner_validation", "product_approval", "governance_registration", "d65_admission", "authority", "publication", "release", "deployment", "production"],
      "properties": {
        "stage_accounting_complete": {"const": true},
        "product_owner_validation": {"const": false},
        "product_approval": {"const": false},
        "governance_registration": {"const": false},
        "d65_admission": {"const": false},
        "authority": {"const": false},
        "publication": {"const": false},
        "release": {"const": false},
        "deployment": {"const": false},
        "production": {"const": false}
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "scope_kind", "selector", "sha256", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "scope_kind": {"enum": ["whole-file", "heading-section"]},
        "selector": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "stageBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "state", "artifact_binding_ids", "evidence_statement", "remaining_requirement"],
      "properties": {
        "stage": {"type": "string"},
        "state": {"enum": ["prototyped", "scaffolded", "testable", "blocked"]},
        "artifact_binding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_statement": {"type": "string", "minLength": 1},
        "remaining_requirement": {"type": ["string", "null"]}
      }
    },
    "definitionPrototypeStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "definition_prototype"}, "state": {"const": "prototyped"}, "artifact_binding_ids": {"minItems": 2}, "remaining_requirement": {"type": "null"}}}]},
    "ontologyScaffoldStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "ontology_scaffold"}, "state": {"const": "scaffolded"}, "artifact_binding_ids": {"minItems": 3}, "remaining_requirement": {"type": "null"}}}]},
    "productCapabilityStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "product_capability_prototype"}, "state": {"const": "prototyped"}, "artifact_binding_ids": {"minItems": 1}, "remaining_requirement": {"type": "null"}}}]},
    "businessPrototypeStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "business_prototype"}, "state": {"const": "prototyped"}, "artifact_binding_ids": {"minItems": 2}, "remaining_requirement": {"type": "null"}}}]},
    "domainspecPrototypeStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "domainspec_prototype"}, "state": {"const": "prototyped"}, "artifact_binding_ids": {"minItems": 2}, "remaining_requirement": {"type": "null"}}}]},
    "compiledSystemStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "compiled_system_prototype"}, "state": {"const": "prototyped"}, "artifact_binding_ids": {"minItems": 3}, "remaining_requirement": {"type": "null"}}}]},
    "implementationPrototypeStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "implementation_prototype"}, "state": {"const": "prototyped"}, "artifact_binding_ids": {"minItems": 3}, "remaining_requirement": {"type": "null"}}}]},
    "testableCandidateStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "testable_product_candidate"}, "state": {"const": "testable"}, "artifact_binding_ids": {"minItems": 2}, "remaining_requirement": {"type": "null"}}}]},
    "productTestEvidenceStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "product_test_evidence"}, "state": {"const": "blocked"}, "artifact_binding_ids": {"maxItems": 0}, "remaining_requirement": {"type": "string", "minLength": 1}}}]},
    "productApprovalStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "product_approval"}, "state": {"const": "blocked"}, "artifact_binding_ids": {"maxItems": 0}, "remaining_requirement": {"type": "string", "minLength": 1}}}]},
    "postApprovalStage": {"allOf": [{"$ref": "#/$defs/stageBase"}, {"properties": {"stage": {"const": "post_approval_authority_decisions"}, "state": {"const": "blocked"}, "artifact_binding_ids": {"maxItems": 0}, "remaining_requirement": {"type": "string", "minLength": 1}}}]},
    "ineligibleDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blockers"],
      "properties": {
        "status": {"const": "not_eligible"},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
