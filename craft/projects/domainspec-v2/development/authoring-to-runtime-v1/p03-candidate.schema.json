{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/contracts/alchlang-domainspec-p03-candidate.schema.json",
  "title": "AlchLang and DomainSpec exact tested candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "date", "source_posture", "source_groups",
    "package_archives", "generated_projects", "tools", "environment",
    "receipts", "materialization", "claim_ceiling", "authority_effect", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "alchlang.p03-exact-candidate/v1-candidate"},
    "candidate_id": {"type": "string", "pattern": "^alchlang-domainspec-p03-[a-f0-9]{16}$"},
    "date": {"const": "2026-09-20"},
    "source_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "git_head", "whole_tree_clean_claimed", "selection"],
      "properties": {
        "kind": {"const": "working-tree-exact-selected-files"},
        "git_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "whole_tree_clean_claimed": {"const": false},
        "selection": {"const": "closed-groups-with-exact-file-rows"}
      }
    },
    "source_groups": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/inventory"}},
    "package_archives": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/archive"}},
    "generated_projects": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/generated"}},
    "tools": {
      "type": "array", "minItems": 7,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["tool"],
        "properties": {
          "tool": {"type": "string"}, "version": {"type": "string"},
          "executable": {"type": "string"}, "executable_sha256": {"$ref": "#/$defs/digest"},
          "family": {"type": "string"}, "source": {"type": "string"},
          "real_executable": {"type": "string"}, "real_executable_sha256": {"$ref": "#/$defs/digest"},
          "lock_path": {"type": "string"}, "lock_sha256": {"$ref": "#/$defs/digest"},
          "lock_package": {"type": "string"}, "package_name": {"type": "string"},
          "package_version": {"type": "string"}, "expected_version": {"type": "string"},
          "observed_version": {"type": "string"}
        }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "os_release", "node", "npm", "python", "rust_lock_sha256"],
      "properties": {
        "platform": {"type": "string"}, "architecture": {"type": "string"},
        "os_release": {"type": "string"}, "node": {"type": "string"},
        "npm": {"type": "string"}, "python": {"type": "string"},
        "rust_lock_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "receipts": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/file"}},
    "materialization": {
      "type": "object", "additionalProperties": false,
      "required": ["archive_bytes_match_p02", "generated_manifest_bytes_match_p02", "exact_file_rows_used", "broad_directory_digest_used", "task_owned_root_disposed", "historical_evidence_refreshed"],
      "properties": {
        "archive_bytes_match_p02": {"const": true}, "generated_manifest_bytes_match_p02": {"const": true},
        "exact_file_rows_used": {"const": true}, "broad_directory_digest_used": {"const": false},
        "task_owned_root_disposed": {"const": true}, "historical_evidence_refreshed": {"const": false}
      }
    },
    "claim_ceiling": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_candidate_construction_evidence", "product_owner_validation", "product_approval", "d65_admission", "publication", "release", "deployment", "production"],
      "properties": {
        "exact_candidate_construction_evidence": {"const": true}, "product_owner_validation": {"const": false},
        "product_approval": {"const": false}, "d65_admission": {"const": false},
        "publication": {"const": false}, "release": {"const": false},
        "deployment": {"const": false}, "production": {"const": false}
      }
    },
    "authority_effect": {"const": "none"},
    "manifest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selector", "files", "inventory_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selector": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "inventory_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "archive": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selector", "files", "inventory_sha256", "name", "version", "archive_sha256", "archive_size_bytes", "p02_archive_sha256"],
      "properties": {
        "id": {"type": "string"}, "selector": {"type": "string"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "inventory_sha256": {"$ref": "#/$defs/digest"}, "name": {"type": "string"},
        "version": {"type": "string"}, "archive_sha256": {"$ref": "#/$defs/digest"},
        "archive_size_bytes": {"type": "integer", "minimum": 1}, "p02_archive_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "generated": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selector", "files", "inventory_sha256", "language", "build_manifest_sha256", "p02_build_manifest_sha256", "archive_set_sha256"],
      "properties": {
        "id": {"type": "string"}, "selector": {"type": "string"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "inventory_sha256": {"$ref": "#/$defs/digest"},
        "language": {"enum": ["typescript", "python", "rust"]},
        "build_manifest_sha256": {"$ref": "#/$defs/digest"},
        "p02_build_manifest_sha256": {"$ref": "#/$defs/digest"},
        "archive_set_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
