{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/schemas/alchlang/evf-causal-join/v2-candidate",
  "title": "Unverified case-claim causal join candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "join_id", "route_kind", "reported_causal_outcome", "cause", "evaluation_request_ref", "provider_outcome_ref", "evidence_binding_ref", "evf_join_ref", "domain_join_status", "can_satisfy_obligation", "case_evidence_verification", "revision_route", "residue", "provider_execution_by_join", "provider_result_consumed", "evidence_omitted", "non_pass_promoted_to_pass", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "alchlang.evf-causal-join/v2-candidate"},
    "join_id": {"$ref": "#/$defs/text"}, "route_kind": {"const": "execution-evidence"},
    "reported_causal_outcome": {"const": "pass"}, "cause": {"$ref": "#/$defs/text"},
    "evaluation_request_ref": {"$ref": "#/$defs/ref"}, "provider_outcome_ref": {"$ref": "#/$defs/ref"},
    "evidence_binding_ref": {"$ref": "#/$defs/ref"}, "evf_join_ref": {"$ref": "#/$defs/ref"},
    "domain_join_status": {"const": "BLOCKED"}, "can_satisfy_obligation": {"const": false},
    "case_evidence_verification": {"const": "unverified"}, "revision_route": {"const": "provider"},
    "residue": {"$ref": "#/$defs/residue"}, "provider_execution_by_join": {"const": false},
    "provider_result_consumed": {"const": false}, "evidence_omitted": {"const": false},
    "non_pass_promoted_to_pass": {"const": false}, "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "residue": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
