{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/alchlang/evf-provider-outcome/v2-candidate",
  "title": "Finalized Execution Provider Outcome Projection Candidate",
  "description": "Caller-supplied exact receipt projection for one finalized execution request; validation does not authenticate a provider.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_kind", "provider", "causal_outcome", "cause", "evaluation_request_ref", "comparability", "result_semantics", "finalized_scope", "case_results"],
  "properties": {
    "schema_version": {"const": "alchlang.evf-provider-outcome/v2-candidate"},
    "route_kind": {"const": "execution-evidence"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "id", "version"],
      "properties": {"owner": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "causal_outcome": {"const": "pass"},
    "cause": {"type": "string", "minLength": 1},
    "evaluation_request_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "comparability": {
      "type": "object", "additionalProperties": false,
      "required": ["same_claim", "same_evaluation_request", "same_domain", "same_result_semantics"],
      "properties": {"same_claim": {"const": true}, "same_evaluation_request": {"const": true}, "same_domain": {"const": true}, "same_result_semantics": {"const": true}}
    },
    "result_semantics": {"type": "string", "minLength": 1},
    "case_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["obligation_id", "case_id", "normalized_outcome"],
      "properties": {"obligation_id": {"type": "string", "minLength": 1}, "case_id": {"type": "string", "minLength": 1}, "normalized_outcome": {"const": "passed"}}}},
    "finalized_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["formal_claim_ref", "evaluation_context_ref", "interpretation_model_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "case_domain_sha256", "witness_input_set_sha256", "domain_and_bound_sha256"],
      "properties": {
        "formal_claim_ref": {"$ref": "#/$defs/exactCurrentRef"},
        "evaluation_context_ref": {"$ref": "#/$defs/exactCurrentRef"},
        "interpretation_model_ref": {"oneOf": [{"$ref": "#/$defs/exactCurrentRef"}, {"type": "null"}]},
        "obligation_set_ref": {"$ref": "#/$defs/exactCurrentRef"},
        "projection_ref": {"$ref": "#/$defs/exactCurrentRef"},
        "preservation_binding_ref": {"$ref": "#/$defs/exactCurrentRef"},
        "case_domain_sha256": {"$ref": "#/$defs/digest"},
        "witness_input_set_sha256": {"$ref": "#/$defs/digest"},
        "domain_and_bound_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    }
  }
}
