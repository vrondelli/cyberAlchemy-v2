{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/schemas/alchlang/runtime-cleanup-report/v1-candidate",
  "title": "AlchLang bounded runtime cleanup report candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "cleanup_observed", "temporary_resources_removed", "owned_residue", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "alchlang.runtime-cleanup-report/v1-candidate"},
    "run_id": {"type": "string", "minLength": 1},
    "cleanup_observed": {"const": true},
    "temporary_resources_removed": {"const": true},
    "owned_residue": {"type": "array", "maxItems": 0},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
