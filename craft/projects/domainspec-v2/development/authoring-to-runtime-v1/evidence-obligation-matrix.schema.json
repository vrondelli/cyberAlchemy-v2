{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/domainspec-v2/authoring-to-runtime/evidence-obligation-matrix.schema.json",
  "title": "AlchLang E05 evidence obligation matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "result", "authority_effect", "required_classes", "source_boundaries", "test_files", "obligations", "coverage", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "alchlang.evidence-obligation-matrix/v1-candidate"},
    "task": {"const": "E05"},
    "result": {"const": "pass"},
    "authority_effect": {"const": "none"},
    "required_classes": {
      "type": "array",
      "prefixItems": [
        {"const": "non-collapse"}, {"const": "semantic"}, {"const": "orthogonality"},
        {"const": "property-oracle"}, {"const": "mutation"}, {"const": "determinism"}, {"const": "currentness"}
      ],
      "items": false
    },
    "source_boundaries": {
      "type": "object", "additionalProperties": false, "required": ["E01", "E02", "E03", "E04"],
      "properties": {"E01": {"$ref": "#/$defs/binding"}, "E02": {"$ref": "#/$defs/binding"}, "E03": {"$ref": "#/$defs/binding"}, "E04": {"$ref": "#/$defs/binding"}}
    },
    "test_files": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
    "obligations": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"$ref": "#/$defs/obligation"}},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["obligations", "by_task", "classes", "behavioral", "representation_only", "unexplained_gaps", "failed", "skipped"],
      "properties": {
        "obligations": {"const": 32},
        "by_task": {"type": "object", "additionalProperties": false, "required": ["E01", "E02", "E03", "E04"], "properties": {"E01": {"const": 8}, "E02": {"const": 8}, "E03": {"const": 8}, "E04": {"const": 8}}},
        "classes": {"const": 7}, "behavioral": {"const": 32}, "representation_only": {"const": 0},
        "unexplained_gaps": {"const": 0}, "failed": {"const": 0}, "skipped": {"const": 0}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_task", "source_obligation", "evidence_class", "layers", "semantic_oracle", "test_file", "test_name", "evidence_kind", "representation_only", "status", "gap"],
      "properties": {
        "id": {"type": "string", "pattern": "^E0[1-4]-O0[1-8]$"},
        "source_task": {"enum": ["E01", "E02", "E03", "E04"]},
        "source_obligation": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["non-collapse", "semantic", "orthogonality", "property-oracle", "mutation", "determinism", "currentness"]},
        "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["E01", "E02", "E03", "E04"]}},
        "semantic_oracle": {"type": "string", "minLength": 1},
        "test_file": {"type": "string", "minLength": 1},
        "test_name": {"type": "string", "minLength": 1},
        "evidence_kind": {"const": "behavioral"},
        "representation_only": {"const": false},
        "status": {"const": "pass"},
        "gap": {"type": "null"}
      }
    }
  }
}
