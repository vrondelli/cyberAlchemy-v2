{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/schemas/alchlang/evf-evidence-trace/v2-candidate",
  "title": "Unverified case-claim construction trace candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "join_id", "route_kind", "input_sha256", "reported_causal_outcome", "provider_outcome_ref", "case_claim_refs", "evidence_binding_ref", "evf_join_ref", "causal_join_ref", "case_evidence_verification", "domain_join_status", "can_satisfy_obligation", "provider_execution_by_join", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "alchlang.evf-evidence-trace/v2-candidate"},
    "join_id": {"$ref": "#/$defs/text"}, "route_kind": {"const": "execution-evidence"},
    "input_sha256": {"$ref": "#/$defs/digest"}, "reported_causal_outcome": {"const": "pass"},
    "provider_outcome_ref": {"$ref": "#/$defs/ref"}, "case_claim_refs": {"$ref": "#/$defs/refSet"},
    "evidence_binding_ref": {"$ref": "#/$defs/ref"}, "evf_join_ref": {"$ref": "#/$defs/ref"},
    "causal_join_ref": {"$ref": "#/$defs/ref"}, "case_evidence_verification": {"const": "unverified"},
    "domain_join_status": {"const": "BLOCKED"}, "can_satisfy_obligation": {"const": false},
    "provider_execution_by_join": {"const": false}, "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "refSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}
  }
}
