{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/alchlang/evf-provider-outcome/v3-candidate",
  "title": "Reported provider case-claim projection candidate",
  "description": "Reported aggregate and case claims only; no provider authentication or execution observation.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "route_kind", "provider", "reported_causal_outcome", "cause", "evaluation_request_ref", "comparability", "result_semantics", "finalized_scope", "case_claims", "case_evidence_verification"],
  "properties": {
    "schema_version": {"const": "alchlang.evf-provider-outcome/v3-candidate"}, "route_kind": {"const": "execution-evidence"},
    "provider": {"$ref": "#/$defs/provider"}, "reported_causal_outcome": {"const": "pass"},
    "cause": {"$ref": "#/$defs/text"}, "evaluation_request_ref": {"$ref": "#/$defs/ref"},
    "comparability": {"$ref": "#/$defs/comparability"}, "result_semantics": {"$ref": "#/$defs/text"},
    "finalized_scope": {"$ref": "#/$defs/scope"}, "case_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/caseClaim"}},
    "case_evidence_verification": {"const": "unverified"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "provider": {"type": "object", "additionalProperties": false, "required": ["owner", "id", "version"], "properties": {"owner": {"$ref": "#/$defs/text"}, "id": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}},
    "comparability": {"type": "object", "additionalProperties": false, "required": ["same_claim", "same_evaluation_request", "same_domain", "same_result_semantics"], "properties": {"same_claim": {"const": true}, "same_evaluation_request": {"const": true}, "same_domain": {"const": true}, "same_result_semantics": {"const": true}}},
    "caseClaim": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "case_id", "witness_input_digest", "reported_native_output", "reported_normalized_outcome", "reported_oracle_evaluation", "artifact_ref"], "properties": {"obligation_id": {"$ref": "#/$defs/text"}, "case_id": {"$ref": "#/$defs/text"}, "witness_input_digest": {"$ref": "#/$defs/digest"}, "reported_native_output": {}, "reported_normalized_outcome": {"const": "passed"}, "reported_oracle_evaluation": {"const": "matched"}, "artifact_ref": {"$ref": "#/$defs/ref"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["formal_claim_ref", "evaluation_context_ref", "interpretation_model_ref", "obligation_set_ref", "projection_ref", "preservation_binding_ref", "case_domain_sha256", "witness_input_set_sha256", "domain_and_bound_sha256"], "properties": {"formal_claim_ref": {"$ref": "#/$defs/ref"}, "evaluation_context_ref": {"$ref": "#/$defs/ref"}, "interpretation_model_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]}, "obligation_set_ref": {"$ref": "#/$defs/ref"}, "projection_ref": {"$ref": "#/$defs/ref"}, "preservation_binding_ref": {"$ref": "#/$defs/ref"}, "case_domain_sha256": {"$ref": "#/$defs/digest"}, "witness_input_set_sha256": {"$ref": "#/$defs/digest"}, "domain_and_bound_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
