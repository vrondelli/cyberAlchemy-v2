{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/alchlang/formal-claim-v4-v2-projection/v1-candidate",
  "title": "AlchLang FormalClaim v4 to v2 Projection Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "source_ref", "target_ref", "source_identity_inputs_digest", "mapping", "preserved_semantics", "known_losses", "semantic_loss_count", "representation_change_count", "currentness", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "alchlang.formal-claim-v4-v2-projection/v1-candidate"},
    "projection_id": {"$ref": "#/$defs/text"},
    "source_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "target_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "source_identity_inputs_digest": {"$ref": "#/$defs/digest"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_identity", "business_binding", "formal_language_profile", "canonical_proposition", "formal_signature", "definition_binding", "interpretation_boundary", "claim_ceiling"],
      "properties": {
        "claim_identity": {"$ref": "#/$defs/text"},
        "business_binding": {"$ref": "#/$defs/text"},
        "formal_language_profile": {"$ref": "#/$defs/text"},
        "canonical_proposition": {"$ref": "#/$defs/text"},
        "formal_signature": {"$ref": "#/$defs/text"},
        "definition_binding": {"$ref": "#/$defs/text"},
        "interpretation_boundary": {"$ref": "#/$defs/text"},
        "claim_ceiling": {"$ref": "#/$defs/text"}
      }
    },
    "preserved_semantics": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "known_losses": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "semantic_loss_count": {"const": 0},
    "representation_change_count": {"type": "integer", "minimum": 5},
    "currentness": {"const": "current"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    }
  }
}
