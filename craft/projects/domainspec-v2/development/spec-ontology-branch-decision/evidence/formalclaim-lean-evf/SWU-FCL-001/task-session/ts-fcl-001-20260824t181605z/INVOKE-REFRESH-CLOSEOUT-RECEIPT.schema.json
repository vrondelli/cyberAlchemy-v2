{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/invoke-refresh-closeout-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "owner",
    "mode",
    "mutation_mode",
    "activation_source",
    "task_id",
    "swu_id",
    "source_receipt",
    "target_inventory_ref",
    "validation_evidence_ref",
    "result",
    "delta_classes",
    "validated_targets",
    "successor",
    "lifecycle_effect",
    "authority_effect",
    "residue"
  ],
  "properties": {
    "schema_version": {"const": "invoke-refresh-closeout-receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "owner": {"const": "invoke"},
    "mode": {"const": "refresh"},
    "mutation_mode": {"const": "apply-approved"},
    "activation_source": {"const": "delegated"},
    "task_id": {"const": "TASK-FCL-01-SOURCE"},
    "swu_id": {"const": "SWU-FCL-001"},
    "source_receipt": {"$ref": "#/$defs/exactRef"},
    "target_inventory_ref": {"$ref": "#/$defs/exactRef"},
    "validation_evidence_ref": {"$ref": "#/$defs/exactRef"},
    "result": {"enum": ["pass", "no-op"]},
    "delta_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["evidence_added", "status_changed", "blocker_resolved", "route_changed"]}
    },
    "validated_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "eligible", "selected", "executed"],
      "properties": {
        "unit_id": {"const": "SWU-FCL-002"},
        "eligible": {"const": true},
        "selected": {"const": false},
        "executed": {"const": false}
      }
    },
    "lifecycle_effect": {"const": "run-state-closeout-only"},
    "authority_effect": {"const": "none"},
    "residue": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
