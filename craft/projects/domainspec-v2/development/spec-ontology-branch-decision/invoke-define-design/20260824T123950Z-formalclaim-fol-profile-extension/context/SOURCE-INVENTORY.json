{
  "schema_version": "invoke.source-inventory/v1",
  "mode": "inventory-lookup-and-validate",
  "inventory_root": ".arcanum/inventory",
  "machine_index": ".arcanum/inventory/index.json",
  "human_index": ".arcanum/inventory/index.md",
  "lookup_readiness": "ready",
  "validation_command": ".arcanum/inventory/scripts/validate-index-json.sh .arcanum/inventory/index.json",
  "validation_result": {
    "status": "pass",
    "failures": 0,
    "warnings": 153,
    "warning_scope": "uncontrolled historical tags only"
  },
  "authority_ceiling": "inventory-read-model-only",
  "matches": [
    {
      "entry_id": "domainspec-v2-spec-ontology-node-layering-dispatch-closeout-synthesis",
      "path": ".arcanum/inventory/entries/domainspec-v2-spec-ontology-node-layering-dispatch-closeout-synthesis.md",
      "fit": ["one-semantic-graph", "non-duplicate-truth", "non-authority"]
    },
    {
      "entry_id": "domainspec-v2-evolvable-validation-framework-strategy-result-synthesis",
      "path": ".arcanum/inventory/entries/domainspec-v2-evolvable-validation-framework-strategy-result-synthesis.md",
      "fit": ["validation-lane-ownership", "formal-method-routing", "typed-receipt-ceiling"]
    },
    {
      "entry_id": "entries-fol-constitution-validation-complement-synthesis",
      "path": ".arcanum/inventory/entries/fol-constitution-validation-complement-synthesis.md",
      "fit": ["cross-rule-FOL", "transitive-closure-boundary", "intended-not-shipped"]
    }
  ],
  "excluded_matches": [
    {
      "path": ".arcanum/inventory/entries/deterministic-validation-for-all-cav2-synthesis.md",
      "reason": "nearby but broader CAV2 synthesis; selected DomainSpec and FOL entries close the current obligations more directly"
    }
  ],
  "mutation": "none"
}
