{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:v2:spec-ontology:v1-verifier-policy:1",
  "title": "V1 Structural Verifier Policy And Checker Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "status", "authority_effect", "policy_owner", "allowed_checks", "forbidden_effects", "fail_closed_conditions", "checker_contract", "revision_rule", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "dsv2.spec-ontology.v1-verifier-policy/v1"},
    "policy_id": {"const": "dsv2-spec-ontology-v1-structural-verification-policy"},
    "policy_version": {"const": "candidate-1"},
    "status": {"const": "candidate-direct-victor-acceptance-pending"},
    "authority_effect": {"const": "none"},
    "policy_owner": {"const": "victor-boscaro"},
    "allowed_checks": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["principal-identity", "current-role-assignment", "exact-byte-digests", "scope-and-non-scope", "timestamp-supersession-currentness", "claim-ceiling"]}},
    "forbidden_effects": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["semantic-acceptance", "semantic-rejection", "semantic-veto", "obligation-discharge", "promotion-or-publication-authorization"]}},
    "fail_closed_conditions": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"enum": ["missing-binding", "malformed-binding", "stale-binding", "digest-mismatch", "identity-mismatch", "role-mismatch", "scope-expansion", "claim-ceiling-expansion"]}},
    "checker_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker_id", "implementation_status", "execution_status", "code_ref", "input_schema_refs", "output_schema_ref", "determinism", "first_failure_preserved", "exit_status_preserved"],
      "properties": {
        "checker_id": {"const": "planned-dsv2-spec-ontology-v1-checker"},
        "implementation_status": {"const": "not-implemented"},
        "execution_status": {"const": "not-run"},
        "code_ref": {"type": "null"},
        "input_schema_refs": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "output_schema_ref": {"type": "string", "minLength": 1},
        "determinism": {"const": "same-exact-inputs-and-policy-must-produce-same-result"},
        "first_failure_preserved": {"const": true},
        "exit_status_preserved": {"const": true}
      }
    },
    "revision_rule": {"const": "any-policy-or-checker-byte-change-requires-new-version-direct-victor-reacceptance-and-fresh-package-verification"},
    "claim_ceiling": {"const": "structural-admissibility-only-no-semantic-or-lifecycle-authority"}
  }
}
