{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:v2:spec-ontology:owner-response:2",
  "title": "Exact Protected Owner Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "package_id", "artifact_digest_method", "package_content_digest_method", "manifest_digest_method", "package_manifest_digest", "package_content_digest", "accepted_artifact_refs", "accepted_json_pointers", "decision", "decision_owner_ref", "current_owner_role_assignment_ref", "current_owner_role_assignment_digest", "authentication_posture", "authentication_evidence_ref", "authentication_evidence_digest", "required_verification_level", "decision_scope", "explicit_non_scope", "claim_ceiling", "decision_timestamp", "decision_evidence_ref", "supersedes_response_ref", "response_status", "authority_effect"],
  "properties": {
    "schema_version": {"const": "dsv2.spec-ontology.owner-response/v2"},
    "request_id": {"pattern": "^OAR-(0[1-9]|1[01])$"},
    "package_id": {"type": "string", "minLength": 1},
    "artifact_digest_method": {"const": "sha256-raw-file-bytes-v1"},
    "package_content_digest_method": {"const": "sha256-rfc8785-acceptance-artifact-path-digest-set-v1"},
    "manifest_digest_method": {"const": "sha256-rfc8785-manifest-without-manifest-digest-v1"},
    "package_manifest_digest": {"$ref": "#/$defs/digest"},
    "package_content_digest": {"$ref": "#/$defs/digest"},
    "accepted_artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "accepted_json_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
    "decision": {"enum": ["accept-contract", "reject-contract", "defer"]},
    "decision_owner_ref": {"type": "string", "minLength": 1},
    "current_owner_role_assignment_ref": {"type": "string", "minLength": 1},
    "current_owner_role_assignment_digest": {"$ref": "#/$defs/digest"},
    "authentication_posture": {"const": "repository-local-l1-exact-role-receipt"},
    "authentication_evidence_ref": {"type": "string", "minLength": 1},
    "authentication_evidence_digest": {"$ref": "#/$defs/digest"},
    "required_verification_level": {"enum": ["V1-policy-verified", "V2-direct-verified"]},
    "decision_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "explicit_non_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "decision_timestamp": {"type": "string", "format": "date-time"},
    "decision_evidence_ref": {"type": "string", "minLength": 1},
    "supersedes_response_ref": {"type": ["string", "null"]},
    "response_status": {"enum": ["issued-verification-pending", "issued-verified-current", "issued-rejected", "issued-deferred"]},
    "authority_effect": {"const": "owner-scope-only-after-current-required-verification"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
