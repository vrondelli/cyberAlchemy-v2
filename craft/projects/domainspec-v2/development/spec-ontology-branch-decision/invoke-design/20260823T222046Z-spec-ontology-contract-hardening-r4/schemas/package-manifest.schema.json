{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:v2:spec-ontology:owner-admission-package-manifest:3",
  "title": "Specification-Ontology Owner-Admission Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "package_revision", "status", "authority_effect", "artifact_digest_method", "source_decisions", "acceptance_bound_artifacts", "owner_request_slices", "package_content_digest_method", "package_content_digest", "invalidation_rule", "claim_ceiling", "manifest_digest_method", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "dsv2.spec-ontology.owner-admission-package-manifest/v3"},
    "package_id": {"type": "string", "minLength": 1},
    "package_revision": {"type": "integer", "minimum": 1},
    "status": {"const": "candidate-frozen-responses-and-verification-pending"},
    "authority_effect": {"const": "none"},
    "artifact_digest_method": {"const": "sha256-raw-file-bytes-v1", "description": "SHA-256 over the exact regular-file byte sequence at the bound path relative to the package root; symlinks are forbidden; encode as lowercase 64-character hexadecimal."},
    "source_decisions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "acceptance_bound_artifacts": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactWithRole"}},
    "owner_request_slices": {"type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": {"$ref": "#/$defs/requestSlice"}},
    "package_content_digest_method": {"const": "sha256-rfc8785-acceptance-artifact-path-digest-set-v1", "description": "Sort acceptance_bound_artifacts ascending by Unicode code-point path; project only path and sha256; RFC 8785 JCS serialize the array as UTF-8 with no trailing LF; apply SHA-256 and lowercase hexadecimal encoding."},
    "package_content_digest": {"$ref": "#/$defs/digest"},
    "invalidation_rule": {"const": "any-bound-byte-digest-scope-role-level-policy-claim-ceiling-or-source-decision-change-creates-a-superseding-package-and-restarts-owner-response-and-verification"},
    "claim_ceiling": {"const": "candidate-design-contract-only-no-implementation-migration-promotion-publication-or-canonical-effect"},
    "manifest_digest_method": {"const": "sha256-rfc8785-manifest-without-manifest-digest-v1", "description": "Remove only top-level manifest_digest; RFC 8785 JCS serialize the entire remaining manifest object, including this method field, as UTF-8 with no trailing LF; apply SHA-256 and lowercase hexadecimal encoding."},
    "manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "artifactWithRole": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "role": {"type": "string", "minLength": 1}}},
    "requestSlice": {"type": "object", "additionalProperties": false, "required": ["request_id", "owner_principal", "owner_role", "json_pointers", "required_verification_level", "verification_route", "requested_scope", "explicit_non_scope", "status"], "properties": {"request_id": {"pattern": "^OAR-(0[1-9]|1[01])$"}, "owner_principal": {"const": "rondelli"}, "owner_role": {"type": "string", "minLength": 1}, "json_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}, "required_verification_level": {"enum": ["V1-policy-verified", "V2-direct-verified"]}, "verification_route": {"enum": ["victor-owned-v1-policy-checker", "direct-victor-boscaro"]}, "requested_scope": {"type": "string", "minLength": 1}, "explicit_non_scope": {"type": "string", "minLength": 1}, "status": {"const": "pending-exact-rondelli-response-and-required-verification"}}}
  }
}
