{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:v2:spec-ontology:role-assignment:1",
  "title": "Specification-Ontology Candidate Role Assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "status", "authority_effect", "primary_principal", "verifier_principal", "role_assignments", "verifier_assignment", "separation_invariant"],
  "properties": {
    "schema_version": {"const": "dsv2.spec-ontology.role-assignments/v1"},
    "package_id": {"type": "string", "minLength": 1},
    "status": {"const": "candidate-unadmitted"},
    "authority_effect": {"const": "none"},
    "primary_principal": {"$ref": "#/$defs/rondelli"},
    "verifier_principal": {"$ref": "#/$defs/victor"},
    "role_assignments": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/primaryRoleAssignment"}
    },
    "verifier_assignment": {"$ref": "#/$defs/verifierAssignment"},
    "separation_invariant": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rondelli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "display_label", "identity_assurance"],
      "properties": {
        "principal_id": {"const": "rondelli"},
        "display_label": {"const": "Rondelli"},
        "identity_assurance": {"const": "repository-local-l1-direct-user-declaration-protected-role-admission-pending"}
      }
    },
    "victor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "display_label", "declared_relationship", "identity_assurance"],
      "properties": {
        "principal_id": {"const": "victor-boscaro"},
        "display_label": {"const": "Victor Boscaro"},
        "declared_relationship": {"const": "partner-of-rondelli"},
        "identity_assurance": {"const": "repository-local-naming-equivalence-direct-victor-authentication-pending"}
      }
    },
    "primaryRoleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "role_id", "principal_id", "scope", "explicit_non_scope", "assignment_status", "authentication_posture", "supersedes_assignment_ref"],
      "properties": {
        "assignment_id": {"type": "string", "pattern": "^RA-[0-9]{2}$"},
        "role_id": {
          "enum": ["domainspec-v2-authority-model-owner", "primary-source-owner", "business-source-owner", "formal-claims-owner", "specification-composition-owner", "validation-governance-owner", "proof-and-evidence-owner", "ontology-protocol-owner", "relationship-authority-owner", "lifecycle-owner", "projection-owner", "privacy-owner", "publication-owner", "negative-corpus-owner", "aggregate-command-owner", "promotion-lifecycle-owner"]
        },
        "principal_id": {"const": "rondelli"},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "explicit_non_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assignment_status": {"const": "proposed-protected-admission-pending"},
        "authentication_posture": {"const": "repository-local-l1-exact-role-receipt"},
        "supersedes_assignment_ref": {"type": ["string", "null"]}
      }
    },
    "verifierAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "role_id", "principal_id", "allowed_checks", "blocking_effect", "forbidden_effects", "assignment_status"],
      "properties": {
        "assignment_id": {"const": "VA-01"},
        "role_id": {"const": "owner-authentication-and-receipt-structural-verifier"},
        "principal_id": {"const": "victor-boscaro"},
        "allowed_checks": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["principal-identity", "current-role-assignment", "exact-byte-digests", "scope-and-non-scope", "timestamp-supersession-currentness", "claim-ceiling"]}
        },
        "blocking_effect": {"const": "structurally-inadmissible"},
        "forbidden_effects": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["semantic-acceptance", "semantic-rejection", "semantic-veto", "obligation-discharge", "promotion-or-publication-authorization"]}
        },
        "assignment_status": {"const": "proposed-direct-victor-acceptance-pending"}
      }
    }
  }
}
