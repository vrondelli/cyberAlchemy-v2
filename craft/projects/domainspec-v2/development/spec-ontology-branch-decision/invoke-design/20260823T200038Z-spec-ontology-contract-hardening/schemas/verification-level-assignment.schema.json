{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:v2:spec-ontology:verification-level-assignment:1",
  "title": "Per-Package Verification-Level Assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "status", "authority_effect", "assignment_owner", "level_vocabulary", "assignments", "raise_rule", "lower_rule", "post_freeze_change_rule", "v3_availability"],
  "properties": {
    "schema_version": {"const": "dsv2.spec-ontology.verification-level-assignments/v1"},
    "package_id": {"type": "string", "minLength": 1},
    "status": {"const": "candidate-unadmitted"},
    "authority_effect": {"const": "none"},
    "assignment_owner": {"const": "rondelli-acting-through-applicable-exact-primary-owner-role"},
    "level_vocabulary": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["V0-draft-precheck", "V1-policy-verified", "V2-direct-verified", "V3-externally-attested"]}
    },
    "assignments": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assignment"}
    },
    "raise_rule": {"const": "owner-may-raise-before-freeze"},
    "lower_rule": {"const": "owner-may-not-lower-below-hazard-class-floor"},
    "post_freeze_change_rule": {"const": "any-level-or-bound-byte-change-creates-superseding-package-and-restarts-verification"},
    "v3_availability": {"const": "unavailable-until-separate-external-l2-gate"}
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "package_class", "minimum_level", "required_verification_level", "assigned_by_principal", "assigned_by_role", "verification_route", "status"],
      "properties": {
        "request_id": {"pattern": "^OAR-(0[1-9]|1[01])$"},
        "package_class": {"enum": ["ordinary-protected-owner-slice", "high-impact-protected-boundary"]},
        "minimum_level": {"enum": ["V1-policy-verified", "V2-direct-verified"]},
        "required_verification_level": {"enum": ["V1-policy-verified", "V2-direct-verified"]},
        "assigned_by_principal": {"const": "rondelli"},
        "assigned_by_role": {"type": "string", "minLength": 1},
        "verification_route": {"enum": ["victor-owned-v1-policy-checker", "direct-victor-boscaro"]},
        "status": {"const": "assigned-in-candidate-verification-pending"}
      }
    }
  }
}
