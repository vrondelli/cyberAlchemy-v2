{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainspec:v2:spec-ontology:design-scope-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "target_id", "target_footprint", "source_contracts", "declared_field_classes", "interfaces", "stores", "normative_rules", "acceptance_and_readiness_claims", "exclusions", "unknowns", "authored_by", "compiled_by", "authority_effect", "input_digest"],
  "properties": {
    "schema_version": {"const": "dsv2.spec-ontology.hardening-design-scope/v1"},
    "manifest_id": {"const": "dsv2-spec-ontology-hardening-scope-001"},
    "target_id": {"const": "dsv2-spec-ontology-owner-verification-hardening"},
    "target_footprint": {"type": "object"},
    "source_contracts": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "object"}},
    "declared_field_classes": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "interfaces": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "object"}},
    "stores": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "object"}},
    "normative_rules": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "object"}},
    "acceptance_and_readiness_claims": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "object"}},
    "exclusions": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "object"}},
    "unknowns": {"type": "array", "maxItems": 0},
    "authored_by": {"const": "/root"},
    "compiled_by": {"const": "/root/spec_ontology_hardening_proposer"},
    "authority_effect": {"const": "none"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
