    {"order":8,"validator_id":"HV-08-ADMISSION-JOIN","owner":"promotion-lifecycle-owner-proposed-rondelli","allowed_checks":["all exact current owner responses present","required V1/V2 receipts present","no rejection or defer","no changed package"],"forbidden_effect":"semantic reinterpretation, discharge, promotion, or publication by validator","implementation_status":"not-implemented","execution_status":"not-run"}
