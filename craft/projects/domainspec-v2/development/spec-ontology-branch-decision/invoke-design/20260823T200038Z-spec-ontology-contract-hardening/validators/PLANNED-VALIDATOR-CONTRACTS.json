    {"order":4,"validator_id":"HV-04-PACKAGE-CURRENTNESS","owner":"lifecycle-owner-proposed-rondelli","allowed_checks":["bound artifact digests","package manifest digest","supersession","post-freeze changes"],"forbidden_effect":"admitting changed bytes in place","implementation_status":"not-implemented","execution_status":"not-run"},
