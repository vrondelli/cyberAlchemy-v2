    {"order":6,"validator_id":"HV-06-V1-POLICY-CHECKER","owner":"victor-boscaro-verifier-policy","allowed_checks":["accepted policy and checker byte bindings","deterministic output","first-failure and exit-status preservation"],"forbidden_effect":"checker owning policy or semantics","implementation_status":"not-implemented","execution_status":"not-run"},
