{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/integration-ontology-scaffold.v1-candidate.schema.json",
  "title": "DomainSpec Integration Ontology Scaffold",
  "$defs": {
    "effect": {"const":"none"},
    "identifier": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"},
    "concept": {
      "type":"object",
      "additionalProperties":false,
      "required":["concept_id","label","branch","role","definition_disposition","definition_ref","evidence_confidence","commitment_confidence","status","authority_effect"],
      "properties": {
        "concept_id":{"$ref":"#/$defs/identifier"},"label":{"type":"string","minLength":1},
        "branch":{"enum":["business","system","bridge"]},
        "role":{"enum":["contract","binding","profile","realization","evidence","mapping","policy","channel","payload","boundary","observation","layout"]},
        "definition_disposition":{"enum":["reuse","specialize","propose"]},
        "definition_ref":{"type":"string","pattern":"^DEFINE-PACK-DOMAINSPEC-INTEGRATION-001#"},
        "evidence_confidence":{"enum":["canonical-source-backed","candidate-source-backed"]},
        "commitment_confidence":{"enum":["active-domain-definition","candidate"]},
        "status":{"const":"candidate-projection"},"authority_effect":{"$ref":"#/$defs/effect"}
      }
    },
    "relation": {
      "type":"object","additionalProperties":false,
      "required":["relation_id","type","from","to","branch","evidence_refs"],
      "properties": {
        "relation_id":{"$ref":"#/$defs/identifier"},"type":{"enum":["specializes","binds-contract-shaped-by","is-part-of","targets","consumes-from","acknowledges-at","is-encoded-by","binds","projects","may-produce","places"]},
        "from":{"$ref":"#/$defs/identifier"},"to":{"$ref":"#/$defs/identifier"},"branch":{"enum":["business","system","bridge"]},
        "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/identifier"}}
      }
    },
    "invariant": {
      "type":"object","additionalProperties":false,
      "required":["invariant_id","kind","expression","status","source_ref","authority_effect"],
      "properties": {"invariant_id":{"$ref":"#/$defs/identifier"},"kind":{"const":"non-collapse"},"expression":{"type":"string","pattern":" != "},"status":{"const":"candidate"},"source_ref":{"const":"definition-pack"},"authority_effect":{"$ref":"#/$defs/effect"}}
    }
  },
  "oneOf": [
    {"type":"object","required":["concepts"],"properties":{"concepts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/concept"}}}},
    {"type":"object","required":["relations"],"properties":{"relations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relation"}}}},
    {"type":"object","required":["invariants"],"properties":{"invariants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/invariant"}}}}
  ]
}
