{
  "schema_version": "domainspec-ontology-form-decision-state-machine/v1",
  "machine_id": "ontology-form-decision-campaign",
  "initial_state": "inventoried",
  "states": [
    {"id":"inventoried","terminal":false,"required_evidence":["canonical projection entry"]},
    {"id":"definition-ready","terminal":false,"required_evidence":["active canonical meta-type record","criterion path"]},
    {"id":"architecture-form-proposed","terminal":false,"required_evidence":["proposed architecture type","portable invariants","property and relation gaps"]},
    {"id":"language-forms-proposed","terminal":false,"required_evidence":["TypeScript candidates","Python candidates","Rust candidates"]},
    {"id":"tension-reviewed","terminal":false,"required_evidence":["alternatives compared","negative controls","open contradictions"]},
    {"id":"owner-decided","terminal":false,"required_evidence":["exact architecture mapping decision","selected profile forms"]},
    {"id":"descriptor-complete","terminal":false,"required_evidence":["realization descriptor","mode contracts","claim ceiling","proof requirements"]},
    {"id":"implementation-ready","terminal":false,"required_evidence":["passing decision validator","empty blocker list","implementation queue entry"]},
    {"id":"implemented","terminal":false,"required_evidence":["implementation receipt"]},
    {"id":"proved","terminal":false,"required_evidence":["positive proof","negative controls","language receipts"]},
    {"id":"stale","terminal":false,"required_evidence":["changed exact input","earliest affected decision stage"]},
    {"id":"wait-for-definition","terminal":true,"required_evidence":["non-active definition maturity","definitions owner route"]},
    {"id":"deferred","terminal":true,"required_evidence":["deferred canonical status","review trigger"]},
    {"id":"superseded","terminal":true,"required_evidence":["superseded canonical status","replacement or retirement reference"]}
  ],
  "transitions": [
    {"from":"inventoried","to":"definition-ready","gate":"canonical maturity is active"},
    {"from":"inventoried","to":"wait-for-definition","gate":"canonical maturity is candidate"},
    {"from":"inventoried","to":"deferred","gate":"canonical maturity is deferred"},
    {"from":"inventoried","to":"superseded","gate":"canonical maturity is superseded"},
    {"from":"definition-ready","to":"architecture-form-proposed","gate":"portable form and gaps recorded"},
    {"from":"architecture-form-proposed","to":"language-forms-proposed","gate":"all three profile candidates recorded"},
    {"from":"language-forms-proposed","to":"tension-reviewed","gate":"alternatives and failure controls reviewed"},
    {"from":"tension-reviewed","to":"owner-decided","gate":"exact mapping and profile decisions supplied by owners"},
    {"from":"owner-decided","to":"descriptor-complete","gate":"relations modes providers claims and proofs close"},
    {"from":"descriptor-complete","to":"implementation-ready","gate":"validator passes and blockers are empty"},
    {"from":"implementation-ready","to":"implemented","gate":"bounded implementation receipt passes"},
    {"from":"implemented","to":"proved","gate":"positive negative and language proof receipts pass"},
    {"from":"definition-ready","to":"stale","gate":"canonical or criterion digest drift"},
    {"from":"architecture-form-proposed","to":"stale","gate":"canonical ontology profile or criterion digest drift"},
    {"from":"language-forms-proposed","to":"stale","gate":"profile decision or provider digest drift"},
    {"from":"tension-reviewed","to":"stale","gate":"review input digest drift"},
    {"from":"owner-decided","to":"stale","gate":"mapping or profile decision digest drift"},
    {"from":"descriptor-complete","to":"stale","gate":"descriptor mode provider proof or claim digest drift"},
    {"from":"implementation-ready","to":"stale","gate":"validation receipt or queue digest drift"},
    {"from":"implemented","to":"stale","gate":"implementation or toolchain digest drift"},
    {"from":"proved","to":"stale","gate":"proof input implementation or environment digest drift"},
    {"from":"stale","to":"inventoried","gate":"canonical identity or maturity changed"},
    {"from":"stale","to":"architecture-form-proposed","gate":"architecture type property or relation decision changed"},
    {"from":"stale","to":"language-forms-proposed","gate":"language form profile or provider changed"},
    {"from":"stale","to":"descriptor-complete","gate":"only validation proof or implementation evidence changed"}
  ],
  "forbidden_transitions": [
    "wait-for-definition -> implementation-ready",
    "deferred -> implementation-ready",
    "superseded -> implementation-ready",
    "architecture-form-proposed -> implemented",
    "proof receipt -> owner-decided",
    "observed source shape -> definition-ready",
    "stale -> implementation-ready"
  ],
  "authority_effect": "none"
}
