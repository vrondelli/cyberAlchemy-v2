{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/ontology-form-proof-contract.schema.json",
  "title": "DomainSpec ontology form proof requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "positive_obligations",
    "negative_controls",
    "required_observation_stages",
    "required_evidence_classes",
    "claim_ceiling",
    "authority_effect"
  ],
  "properties": {
    "positive_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_observation_stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "canonical-binding",
          "source-shape",
          "native-type",
          "compiler",
          "module-topology",
          "runtime-behavior",
          "test",
          "telemetry"
        ]
      }
    },
    "required_evidence_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "binding-fixture",
          "source-projection",
          "typecheck",
          "compile-check",
          "unit-test",
          "integration-test",
          "mutation-test",
          "relation-test",
          "runtime-observation"
        ]
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  }
}

