{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/ontology-form-kernel-decision.schema.json",
  "title": "DomainSpec ontology-form campaign kernel decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "campaign_id",
    "scope",
    "question",
    "status",
    "selected_option_id",
    "selected_option_label",
    "rationale",
    "decision_source",
    "admissibility",
    "considered_options",
    "accepted_clauses",
    "kernel",
    "remaining_blockers",
    "deferred_decisions",
    "assumptions",
    "non_effects",
    "next_step",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "domainspec-ontology-form-kernel-decision/v1"},
    "decision_id": {"const": "DS-OF-W0-KERNEL-POLICY-001"},
    "campaign_id": {"const": "domainspec-all-meta-type-forms-20260808"},
    "scope": {"const": "projects/domainspec-v2/development/ontology-form-decisions/**"},
    "question": {"type": "string", "minLength": 1},
    "status": {"const": "accepted"},
    "selected_option_id": {"const": "W0-A-STRICT-DIGEST-BOUND"},
    "selected_option_label": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "decision_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "exact_text", "accepted_at"],
      "properties": {
        "kind": {"const": "user-message"},
        "exact_text": {"const": "Accept W0-A"},
        "accepted_at": {"type": "string", "format": "date-time"}
      }
    },
    "admissibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_ref", "receipt_ref", "request_digest", "request_digest_algorithm", "route_outcome"],
      "properties": {
        "request_ref": {"$ref": "#/$defs/exactRef"},
        "receipt_ref": {"$ref": "#/$defs/exactRef"},
        "request_digest": {"$ref": "#/$defs/sha256"},
        "request_digest_algorithm": {"type": "string", "minLength": 1},
        "route_outcome": {"const": "gate"}
      }
    },
    "accepted_clauses": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "decision"],
        "properties": {
          "clause_id": {"pattern": "^W0-(0[1-9]|1[0-2])$"},
          "decision": {"type": "string", "minLength": 1}
        }
      }
    },
    "considered_options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "outcome"],
        "properties": {
          "option_id": {
            "enum": [
              "W0-A-STRICT-DIGEST-BOUND",
              "W0-B-RELAXED-PROTOTYPE",
              "W0-C-DEFER",
              "W0-D-STOP"
            ]
          },
          "outcome": {"enum": ["selected", "structurally-rejected", "not-selected"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_record_binding",
        "identifier_conventions",
        "realization_admission",
        "claim_composition",
        "proof_minimum",
        "contract_chain",
        "receipt_topology",
        "drift_policy",
        "validator_runtime"
      ],
      "properties": {
        "canonical_record_binding": {"$ref": "#/$defs/stringMap"},
        "identifier_conventions": {"$ref": "#/$defs/stringMap"},
        "realization_admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["languages", "selection", "syntax_inference", "provider_binding", "unavailable_or_unobservable"],
          "properties": {
            "languages": {
              "type": "array",
              "prefixItems": [
                {"const": "typescript"},
                {"const": "python"},
                {"const": "rust"}
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "selection": {"type": "string", "minLength": 1},
            "syntax_inference": {"const": "forbidden"},
            "provider_binding": {"type": "string", "minLength": 1},
            "unavailable_or_unobservable": {"type": "string", "minLength": 1}
          }
        },
        "claim_composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "inputs", "evidence_may_widen"],
          "properties": {
            "operator": {"const": "conservative-intersection"},
            "inputs": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "evidence_may_widen": {"const": false}
          }
        },
        "proof_minimum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive_obligations", "negative_controls", "observation_stages", "evidence_classes", "relation_bearing_form", "behavioral_claim", "authority_effect"],
          "properties": {
            "positive_obligations": {"type": "string", "minLength": 1},
            "negative_controls": {"type": "string", "minLength": 1},
            "observation_stages": {"type": "string", "minLength": 1},
            "evidence_classes": {"type": "string", "minLength": 1},
            "relation_bearing_form": {"const": "relation-test required"},
            "behavioral_claim": {"type": "string", "minLength": 1},
            "authority_effect": {"const": "none"}
          }
        },
        "contract_chain": {
          "type": "array",
          "prefixItems": [
            {"const": "CanonicalMetaTypeRecordRef/v1"},
            {"const": "ArchitectureMappingDecision/v1"},
            {"const": "MetaTypeRealizationDescriptor/v1"},
            {"const": "FactoryKitPackage/v2"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "receipt_topology": {"$ref": "#/$defs/stringMap"},
        "drift_policy": {"$ref": "#/$defs/stringMap"},
        "validator_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network_required", "node", "python", "PyYAML", "jsonschema"],
          "properties": {
            "network_required": {"const": false},
            "node": {"type": "string", "minLength": 1},
            "python": {"type": "string", "minLength": 1},
            "PyYAML": {"type": "string", "minLength": 1},
            "jsonschema": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "remaining_blockers": {"$ref": "#/$defs/nonEmptyStringArray"},
    "deferred_decisions": {"type": "array", "maxItems": 0},
    "assumptions": {"$ref": "#/$defs/nonEmptyStringArray"},
    "non_effects": {"$ref": "#/$defs/nonEmptyStringArray"},
    "next_step": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
