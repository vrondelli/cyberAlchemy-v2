{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/ontology-form-decision-matrix.schema.json",
  "title": "DomainSpec ontology form decision matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "ontology_type",
    "status",
    "source_refs",
    "decision_state_machine_ref",
    "campaign_kernel_binding",
    "decisions",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "domainspec-ontology-form-decision-matrix/v1"},
    "campaign_id": {"$ref": "#/$defs/stableId"},
    "ontology_type": {"const": "architecture-property"},
    "status": {"enum": ["candidate", "reviewed-candidate", "closed"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/exactRef"}
    },
    "decision_state_machine_ref": {"type": "string", "minLength": 1},
    "campaign_kernel_binding": {"$ref": "#/$defs/campaignKernelBinding"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/formDecision"}
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "campaignKernelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "selected_option_id",
        "admissibility_request_ref",
        "admissibility_receipt_ref",
        "decision_record_ref",
        "prefilter_ref",
        "request_schema_ref",
        "receipt_schema_ref",
        "authority_effect"
      ],
      "properties": {
        "decision_id": {"const": "DS-OF-W0-KERNEL-POLICY-001"},
        "selected_option_id": {"const": "W0-A-STRICT-DIGEST-BOUND"},
        "admissibility_request_ref": {"$ref": "#/$defs/exactRef"},
        "admissibility_receipt_ref": {"$ref": "#/$defs/exactRef"},
        "decision_record_ref": {"$ref": "#/$defs/exactRef"},
        "prefilter_ref": {"$ref": "#/$defs/exactRef"},
        "request_schema_ref": {"$ref": "#/$defs/exactRef"},
        "receipt_schema_ref": {"$ref": "#/$defs/exactRef"},
        "authority_effect": {"const": "none"}
      }
    },
    "canonicalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "record_selector",
        "selected_record_sha256",
        "criterion_path",
        "criterion_sha256"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "record_selector": {"type": "string", "minLength": 1},
        "selected_record_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "criterion_path": {"type": ["string", "null"]},
        "criterion_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "architectureForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_status",
        "type_id",
        "portable_invariants",
        "required_property_ids",
        "allowed_relation_ids",
        "missing_property_decisions",
        "missing_relation_decisions"
      ],
      "properties": {
        "decision_status": {
          "enum": [
            "unproposed",
            "proposed",
            "candidate-mapped",
            "owner-decided",
            "not-applicable"
          ]
        },
        "type_id": {
          "anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]
        },
        "portable_invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_property_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "allowed_relation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "missing_property_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "missing_relation_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "formDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "meta_type_id",
        "label",
        "category",
        "definition_maturity",
        "source_mapping_status",
        "decision_state",
        "state_history",
        "outcome",
        "canonical_ref",
        "architecture_form",
        "language_realizations",
        "proof_requirements",
        "owner_route",
        "blocking_decisions",
        "architecture_mapping_decision_ref",
        "realization_descriptor_ref",
        "factory_kit_ref",
        "implementation_gate",
        "authority_effect"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/stableId"},
        "meta_type_id": {"pattern": "^DS-D1\\.[0-9]+$"},
        "label": {"type": "string", "minLength": 1},
        "category": {
          "enum": ["structural", "behavioral", "connective", "lifecycle", "ui"]
        },
        "definition_maturity": {
          "enum": ["active", "candidate", "deferred", "superseded"]
        },
        "source_mapping_status": {
          "enum": [
            "candidate-mapped",
            "profiled-unmapped",
            "unsupported",
            "not-admitted",
            "superseded"
          ]
        },
        "decision_state": {
          "enum": [
            "inventoried",
            "definition-ready",
            "architecture-form-proposed",
            "language-forms-proposed",
            "tension-reviewed",
            "owner-decided",
            "descriptor-complete",
            "implementation-ready",
            "implemented",
            "proved",
            "stale",
            "wait-for-definition",
            "deferred",
            "superseded"
          ]
        },
        "state_history": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "inventoried",
              "definition-ready",
              "architecture-form-proposed",
              "language-forms-proposed",
              "tension-reviewed",
              "owner-decided",
              "descriptor-complete",
              "implementation-ready",
              "implemented",
              "proved",
              "stale",
              "wait-for-definition",
              "deferred",
              "superseded"
            ]
          }
        },
        "outcome": {
          "enum": ["implement", "wait-for-definition", "deferred", "superseded"]
        },
        "canonical_ref": {"$ref": "#/$defs/canonicalRef"},
        "architecture_form": {"$ref": "#/$defs/architectureForm"},
        "language_realizations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "https://domainspec.local/contracts/language-realization.schema.json"},
          "allOf": [
            {"contains":{"properties":{"language":{"const":"typescript"}},"required":["language"]},"minContains":1,"maxContains":1},
            {"contains":{"properties":{"language":{"const":"python"}},"required":["language"]},"minContains":1,"maxContains":1},
            {"contains":{"properties":{"language":{"const":"rust"}},"required":["language"]},"minContains":1,"maxContains":1}
          ]
        },
        "proof_requirements": {"$ref": "https://domainspec.local/contracts/ontology-form-proof-contract.schema.json"},
        "owner_route": {"type": "string", "minLength": 1},
        "blocking_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "architecture_mapping_decision_ref": {
          "anyOf": [{"$ref": "#/$defs/exactRef"}, {"type": "null"}]
        },
        "realization_descriptor_ref": {
          "anyOf": [{"$ref": "#/$defs/exactRef"}, {"type": "null"}]
        },
        "factory_kit_ref": {
          "anyOf": [{"$ref": "#/$defs/exactRef"}, {"type": "null"}]
        },
        "implementation_gate": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
