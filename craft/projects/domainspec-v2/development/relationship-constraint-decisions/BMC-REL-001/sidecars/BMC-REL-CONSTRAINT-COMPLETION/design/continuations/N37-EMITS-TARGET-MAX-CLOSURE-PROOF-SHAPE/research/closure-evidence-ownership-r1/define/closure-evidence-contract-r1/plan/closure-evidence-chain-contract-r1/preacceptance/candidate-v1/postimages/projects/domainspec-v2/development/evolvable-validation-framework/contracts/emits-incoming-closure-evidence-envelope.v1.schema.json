{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/evf/emits-incoming-closure-evidence-envelope/v1",
  "title": "EVF Emits Incoming Closure Evidence Envelope v1",
  "description": "EVF consumer-completeness envelope for one exact emits.target_max=1 snapshot. Structural validity does not prove completeness truth or authority admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_id",
    "contract",
    "subject",
    "boundary",
    "source_population",
    "source_placement",
    "target_population",
    "target_placement",
    "incoming_adjacency",
    "snapshot",
    "attestation",
    "currentness",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "evf.emits-incoming-closure-evidence-envelope/v1"
    },
    "envelope_id": {
      "$ref": "#/$defs/nonempty"
    },
    "contract": {
      "$ref": "#/$defs/bound_ref"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "boundary": {
      "$ref": "#/$defs/boundary"
    },
    "source_population": {
      "$ref": "#/$defs/exact_id_set"
    },
    "source_placement": {
      "$ref": "#/$defs/exact_id_set"
    },
    "target_population": {
      "$ref": "#/$defs/exact_id_set"
    },
    "target_placement": {
      "$ref": "#/$defs/exact_id_set"
    },
    "incoming_adjacency": {
      "$ref": "#/$defs/exact_emits_fact_set"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "attestation": {
      "$ref": "#/$defs/attestation"
    },
    "currentness": {
      "$ref": "#/$defs/currentness"
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bound_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "version",
        "sha256"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/nonempty"
        },
        "version": {
          "$ref": "#/$defs/nonempty"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "predicate_id",
        "counting_unit_receipt",
        "numeric_policy_receipt",
        "closure_proof_receipt"
      ],
      "properties": {
        "relation_id": {
          "const": "emits"
        },
        "predicate_id": {
          "const": "emits.target_max=1"
        },
        "counting_unit_receipt": {
          "$ref": "#/$defs/bound_ref"
        },
        "numeric_policy_receipt": {
          "$ref": "#/$defs/bound_ref"
        },
        "closure_proof_receipt": {
          "$ref": "#/$defs/bound_ref"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "boundary_kind_ref",
        "owner_ref"
      ],
      "properties": {
        "boundary_id": {
          "$ref": "#/$defs/nonempty"
        },
        "boundary_kind_ref": {
          "$ref": "#/$defs/nonempty"
        },
        "owner_ref": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "exact_id_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "membership_digest",
        "members"
      ],
      "properties": {
        "completeness": {
          "const": "declared-complete"
        },
        "membership_digest": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "emits_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_entity_id",
        "target_event_id"
      ],
      "properties": {
        "source_entity_id": {
          "$ref": "#/$defs/nonempty"
        },
        "target_event_id": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "exact_emits_fact_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "fact_set_digest",
        "facts",
        "outgoing_closure"
      ],
      "properties": {
        "completeness": {
          "const": "declared-complete-incoming"
        },
        "fact_set_digest": {
          "$ref": "#/$defs/sha256"
        },
        "facts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/emits_fact"
          }
        },
        "outgoing_closure": {
          "const": "open"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_digest",
        "source_set",
        "graph",
        "source_manifest",
        "relationship_registry",
        "profile"
      ],
      "properties": {
        "snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_set": {
          "$ref": "#/$defs/bound_ref"
        },
        "graph": {
          "$ref": "#/$defs/bound_ref"
        },
        "source_manifest": {
          "$ref": "#/$defs/bound_ref"
        },
        "relationship_registry": {
          "$ref": "#/$defs/bound_ref"
        },
        "profile": {
          "$ref": "#/$defs/bound_ref"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaring_owner_ref",
        "producer_ref",
        "declaration_digest",
        "completeness_claim"
      ],
      "properties": {
        "declaring_owner_ref": {
          "$ref": "#/$defs/nonempty"
        },
        "producer_ref": {
          "$ref": "#/$defs/nonempty"
        },
        "declaration_digest": {
          "$ref": "#/$defs/sha256"
        },
        "completeness_claim": {
          "const": "declares-complete-for-bound-snapshot"
        }
      }
    },
    "currentness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reference"
          ],
          "properties": {
            "state": {
              "const": "external-ref"
            },
            "reference": {
              "$ref": "#/$defs/bound_ref"
            }
          }
        }
      ]
    }
  }
}
