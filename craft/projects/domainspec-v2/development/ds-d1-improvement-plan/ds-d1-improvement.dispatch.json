{
  "dispatch_id": "domainspec-v2-ds-d1-improvement-plan",
  "intent": {
    "raw": "create an invoke plan to improve DS-D1 after the meta-type category-boundary findings",
    "objective": "Plan a bounded route from the accepted staged-authority DS-D1 finding to maturity alignment, UI-11 decision/formalization, the accepted Saga collapse route, backend semantic-depth hardening, validator support, and closeout read-model sync.",
    "target_artifact": "projects/domainspec-v2/development/ds-d1-improvement-plan"
  },
  "mode": "sequence",
  "techniques": [
    "sequence",
    "scu_swu_reduction",
    "recomposition_proof",
    "validation_loop",
    "owner_boundary_check",
    "authority_split_gate",
    "artifact_contract_bridge",
    "execution_receipt_handoff",
    "residue_ledger",
    "concrete_path_evidence",
    "state_namespace_boundary"
  ],
  "subagent_strategy": {
    "status": "recommended",
    "trigger": "Task Session may delegate isolated schema, fixture, and test SWUs after owner decisions.",
    "explanation": "Invoke only plans. Runtime subagents, if used, should receive exactly one SWU contract and return a native receipt.",
    "context": [
      "WORK-PACK.md#SWU Manifest",
      "work-pack/tasks/",
      "work-pack/waves/"
    ],
    "roles": [
      {
        "role_id": "ui-type-worker",
        "purpose": "Implement one selected UI meta-type schema, fixture, and test slice.",
        "owns": "SWU-DSD1-004 or SWU-DSD1-005 only",
        "applies_to_steps": ["s4"]
      },
      {
        "role_id": "backend-hardening-worker",
        "purpose": "Harden one high-risk backend type family with finite witnesses.",
        "owns": "SWU-DSD1-010, SWU-DSD1-011, or SWU-DSD1-012 only",
        "applies_to_steps": ["s6"]
      }
    ],
    "parallelism": "mixed",
    "join_policy": "parent_synthesis",
    "authorization": "requires_user_permission",
    "permission_prompt": "Approve runtime subagents only for one selected SWU with the write scope and receipt contract from WORK-PACK.md.",
    "receipt_requirements": [
      "agent_id",
      "role_id",
      "spawn_status",
      "join_status",
      "close_status",
      "dispatch_id",
      "step_id",
      "capability_ref",
      "receipt_kind",
      "status",
      "artifacts",
      "validation",
      "observer_status",
      "blockers",
      "residue",
      "reroute",
      "handoff_note"
    ]
  },
  "boundary_evidence": {
    "boundaries": [
      {
        "boundary_id": "b-invoke-task-session",
        "kind": "capability_handoff",
        "from_owner": "invoke",
        "to_owner": "task-session",
        "applies_to_steps": ["s2", "s4", "s6", "s7", "s8"],
        "contract": "Task Session executes one selected SWU and returns a receipt before any work-pack sync.",
        "on_violation": "block"
      },
      {
        "boundary_id": "b-ds-d1-ds-d8",
        "kind": "artifact_import",
        "from_owner": "DS-D8 relationship authority",
        "to_owner": "DS-D1 formation authority",
        "applies_to_steps": ["s2", "s3", "s4", "s5", "s6"],
        "contract": "DS-D8 endpoint use may create evidence pressure but cannot promote DS-D1 formation authority.",
        "on_violation": "block"
      },
      {
        "boundary_id": "b-private-delta-rules",
        "kind": "artifact_import",
        "from_owner": "implementation derivation engine",
        "to_owner": "public DS-D1 validators",
        "applies_to_steps": ["s4", "s6", "s7"],
        "contract": "Public schemas and validators must not import private derivation delta-rules.",
        "on_violation": "block"
      }
    ],
    "authority": {
      "lifecycle": "invoke",
      "execution": "task-session",
      "definitions": "definitions-governance",
      "relationship_authority": "definitions/relationships",
      "validation": "DomainSpec v2 impl tools",
      "promotion": "definitions-governance or explicit owner decision"
    },
    "receipts": [
      {
        "receipt_id": "r-task-session-swu",
        "producer": "task-session",
        "required_fields": [
          "run_id",
          "artifacts",
          "validation_result",
          "blockers",
          "residue"
        ],
        "stores": [
          "task-session result artifact",
          ".arcanum/observability/signals/sigil-invocations.jsonl"
        ],
        "on_missing": "flag"
      }
    ],
    "state_namespaces": [
      {
        "namespace": "source",
        "owner": "git/worktree",
        "write_policy": "Task Session writes only selected SWU scope."
      },
      {
        "namespace": "authority-root",
        "owner": "definitions-governance",
        "write_policy": "No DS-D1 promotion without owner route."
      }
    ]
  },
  "steps": [
    {
      "step_id": "s1",
      "name": "Author Invoke plan package",
      "capability_ref": "invoke",
      "pattern": "sequential",
      "techniques": ["sequence", "scu_swu_reduction", "recomposition_proof", "residue_ledger", "concrete_path_evidence"],
      "inputs": [
        {"kind": "artifact", "ref": "projects/domainspec-v2/development/r3-research/ds-d1-metatype-category-boundary/findings.md"},
        {"kind": "artifact", "ref": "projects/domainspec-v2/development/meta-type-formalization/WORK-PACK.md"},
        {"kind": "artifact", "ref": "projects/domainspec-v2/development/meta-type-definitions/WORK-PACK.md"}
      ],
      "outputs": [
        {"kind": "artifact", "ref": "projects/domainspec-v2/development/ds-d1-improvement-plan/WORK-PACK.md"},
        {"kind": "artifact", "ref": "projects/domainspec-v2/development/ds-d1-improvement-plan/IMPLEMENTATION-LAYERING.md"}
      ],
      "evidence_artifact": "projects/domainspec-v2/development/ds-d1-improvement-plan/PLAN-TRANSPORT.md",
      "stop_conditions": ["block if no selected first SWU exists"]
    },
    {
      "step_id": "s2",
      "name": "Execute DS-D1 maturity alignment",
      "capability_ref": "task-session",
      "pattern": "handoff",
      "techniques": ["execution_receipt_handoff", "validation_loop", "owner_boundary_check"],
      "inputs": [{"kind": "artifact", "ref": "WORK-PACK.md#SWU-DSD1-001"}],
      "outputs": [{"kind": "artifact", "ref": "task-session result for SWU-DSD1-001"}],
      "evidence_artifact": "task-session result for SWU-DSD1-001",
      "stop_conditions": ["block if docs validation fails or authority wording contradicts findings"]
    },
    {
      "step_id": "s3",
      "name": "Decide UI-11 path",
      "capability_ref": "decision-gate",
      "capability_status": "local-extension",
      "pattern": "decision",
      "techniques": ["authority_split_gate", "owner_boundary_check", "residue_ledger"],
      "inputs": [{"kind": "artifact", "ref": "SWU-DSD1-003"}],
      "outputs": [{"kind": "decision", "ref": "UI path decision"}],
      "evidence_artifact": "decision record for SWU-DSD1-003",
      "stop_conditions": ["block if UI types are treated as DS-D1 authority because DS-D8 uses them"]
    },
    {
      "step_id": "s4",
      "name": "Execute selected UI branch",
      "capability_ref": "task-session",
      "pattern": "handoff",
      "techniques": ["artifact_contract_bridge", "validation_loop", "execution_receipt_handoff"],
      "inputs": [
        {"kind": "decision", "ref": "UI path decision"},
        {"kind": "artifact", "ref": "SWU-DSD1-004..006"}
      ],
      "outputs": [{"kind": "artifact", "ref": "selected UI branch receipt"}],
      "evidence_artifact": "selected UI branch receipt",
      "stop_conditions": ["block if selected UI branch lacks human and machine evidence"]
    },
    {
      "step_id": "s5",
      "name": "Consume completed Saga collapse decision",
      "capability_ref": "decision-gate",
      "capability_status": "local-extension",
      "pattern": "decision",
      "techniques": ["authority_split_gate", "owner_boundary_check", "residue_ledger"],
      "inputs": [{"kind": "artifact", "ref": "SWU-DSD1-007"}],
      "outputs": [{"kind": "decision", "ref": "Completed Saga collapse decision"}],
      "evidence_artifact": "DEC-DSD1-SAGA-FORK plus SWU-DSD1-007 status",
      "stop_conditions": ["block if the cancelled hardening branch is reopened or collapse is claimed complete before SGRM-008"]
    },
    {
      "step_id": "s6",
      "name": "Continue backend hardening after Saga collapse routing",
      "capability_ref": "task-session",
      "pattern": "fanout",
      "parallel": true,
      "join_policy": "parent_synthesis",
      "techniques": ["scu_swu_reduction", "artifact_contract_bridge", "validation_loop", "execution_receipt_handoff"],
      "inputs": [
        {"kind": "decision", "ref": "Completed Saga collapse decision and SGRM routing receipts"},
        {"kind": "artifact", "ref": "SWU-DSD1-010..012"}
      ],
      "outputs": [{"kind": "ledger", "ref": "Backend hardening receipts"}],
      "evidence_artifact": "Backend hardening receipts; Saga route evidence remains in SGRM",
      "stop_conditions": ["block if parallel workers touch overlapping schema or validator helpers without coordination"]
    },
    {
      "step_id": "s7",
      "name": "Extend validators only as selected hardening requires",
      "capability_ref": "task-session",
      "pattern": "handoff",
      "techniques": ["artifact_contract_bridge", "validation_loop", "state_namespace_boundary"],
      "inputs": [{"kind": "artifact", "ref": "SWU-DSD1-013..014"}],
      "outputs": [{"kind": "artifact", "ref": "validator hardening receipt"}],
      "evidence_artifact": "validator hardening receipt",
      "stop_conditions": ["block if public validator imports private delta-rules"]
    },
    {
      "step_id": "s8",
      "name": "Sync read models and verify recomposition",
      "capability_ref": "task-session",
      "pattern": "validation",
      "techniques": ["recomposition_proof", "execution_receipt_handoff", "residue_ledger", "validation_loop"],
      "inputs": [{"kind": "artifact", "ref": "SWU-DSD1-015..016"}],
      "outputs": [{"kind": "artifact", "ref": "final DS-D1 improvement receipt"}],
      "evidence_artifact": "Craft/Inventory/observability closeout receipt",
      "stop_conditions": ["flag any deferred branch; block if ledgers claim more authority than executed"]
    }
  ],
  "gates": [
    {
      "gate_id": "g1-selected-swu",
      "kind": "quality",
      "owner": "invoke",
      "condition": "A first executable SWU is selected before mutation-capable execution.",
      "on_fail": "block"
    },
    {
      "gate_id": "g2-ui-decision",
      "kind": "decision",
      "owner": "definitions-governance",
      "condition": "UI-11 implementation waits for explicit add-ui, narrow-claim, or defer decision.",
      "on_fail": "block"
    },
    {
      "gate_id": "g3-saga-decision",
      "kind": "decision",
      "owner": "definitions-governance plus relationship authority owner",
      "condition": "Satisfied: collapse is selected; hardening is cancelled and repository-local migration is complete through SGRM-008.",
      "on_fail": "block"
    },
    {
      "gate_id": "g4-validation",
      "kind": "validation",
      "owner": "task-session",
      "condition": "Each executed SWU returns validation evidence before plan status is synchronized.",
      "on_fail": "block"
    }
  ],
  "observability": {
    "dispatch_id_required": true,
    "trace_events": [
      "dispatch_validated",
      "invoke_plan_authored",
      "task_session_receipt_recorded",
      "read_model_synced"
    ],
    "signal_grouping": "dispatch_id"
  },
  "promotion_guardrails": [
    "Execution evidence is not canonical DS-D1 category promotion.",
    "DS-D8 endpoint use is not DS-D1 formation authority.",
    "Implementation schema shape is not semantic proof."
  ]
}
