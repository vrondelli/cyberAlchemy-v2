#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec "$SCRIPT_DIR/terminal_guard.sh" shell \
  --timeout "${TERMINAL_GUARD_TIMEOUT:-120}" \
  --retry-timeout "${TERMINAL_GUARD_RETRY_TIMEOUT:-45}" \
  --max-retries "${TERMINAL_GUARD_MAX_RETRIES:-1}" \
  "$@"
