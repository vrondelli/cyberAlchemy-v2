{
  "name": "@domainspec/core-workspace",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.8.1"
  },
  "pnpm": {
    "overrides": {
      "vitest@3.2.6>vite": "6.4.3",
      "vite@6.4.3>esbuild": "0.25.12"
    }
  },
  "workspaces": [
    "cyberAlchemy-v2/implementation/agent-reasoning-engine/packages/aci-binding-contract",
    "cyberAlchemy-v2/implementation/agent-reasoning-engine/packages/intent-route-resolver",
    "cyberAlchemy-v2/implementation/agent-reasoning-engine/packages/semantic-judgment-evaluator",
    "cyberAlchemy-v2/implementation/ontology-candidate-graph-prototype",
    "cyberAlchemy-v2/implementation/ontology-evidence-workbench",
    "projects/auth-user-management",
    "projects/body-war/app",
    "projects/goldenquill/apps/tilth_ui",
    "projects/goldenquill/apps/tilth_ui_react",
    "projects/ide-extension",
    "projects/domainspec-v2/impl",
    "projects/domainspec-v2/impl/cli",
    "projects/domainspec-v2/impl/test-derivation-engine",
    "projects/rpv-origination/phase-0/prototype",
    "projects/ui-prototyping-studio/backend"
  ],
  "scripts": {
    "audit": "pnpm audit --audit-level=low",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm --filter @domainspec/auth-user-management test && pnpm --filter @cyberalchemy/ontology-evidence-workbench test:web"
  }
}
