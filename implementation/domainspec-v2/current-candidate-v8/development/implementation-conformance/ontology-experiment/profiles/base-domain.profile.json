  "constraints": [
    {
      "constraint_id": "portable.one-primary-concept-per-source",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.DomainConceptImplementation"],
      "property_id": "source.primary_concept_count",
      "operator": "equals",
      "expected": 1,
      "severity": "error"
    },
    {
      "constraint_id": "portable.semantic-binding-required",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.DomainConceptImplementation"],
      "property_id": "binding.concept_id",
      "operator": "required",
      "expected": true,
      "severity": "error"
    },
    {
      "constraint_id": "portable.binding-must-be-current",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.DomainConceptImplementation"],
      "property_id": "binding.current",
      "operator": "equals",
      "expected": true,
      "severity": "error"
    },
    {
      "constraint_id": "portable.one-primary-callable",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.RuleImplementation", "architecture.OperationImplementation", "architecture.QueryImplementation", "architecture.MappingImplementation", "architecture.StateMachineImplementation", "architecture.WorkflowImplementation"],
      "property_id": "symbol.primary_callable_count",
      "operator": "equals",
      "expected": 1,
      "severity": "error"
    },
    {
      "constraint_id": "portable.helper-policy-explicit",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.RuleImplementation", "architecture.OperationImplementation", "architecture.QueryImplementation", "architecture.MappingImplementation", "architecture.StateMachineImplementation", "architecture.WorkflowImplementation"],
      "property_id": "callable.helper_policy",
      "operator": "one_of",
      "expected": ["no-helpers", "private-helpers-allowed", "separate-source-units"],
      "severity": "error"
    },
    {
      "constraint_id": "portable.rule-is-boolean-guard",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.RuleImplementation"],
      "property_id": "callable.return_semantics",
      "operator": "equals",
      "expected": "boolean",
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-expected-values-required",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "binding.expected_enum_values",
      "operator": "required",
      "expected": true,
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-values-required",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "enum.implemented_values",
      "operator": "required",
      "expected": true,
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-values-exact",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "enum.implemented_values",
      "operator": "set_equals",
      "expected": {"kind": "property-ref", "property_id": "binding.expected_enum_values"},
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-values-unique",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "enum.implemented_values",
      "operator": "unique",
      "expected": true,
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-values-non-empty",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "enum.implemented_values",
      "operator": "non_empty",
      "expected": true,
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-cardinality-positive",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "enum.implemented_values",
      "operator": "cardinality",
      "expected": {"min": 1},
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-has-no-typed-fields",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "structure.typed_field_count",
      "operator": "equals",
      "expected": 0,
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-has-no-identity",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "identity.component_count",
      "operator": "equals",
      "expected": 0,
      "severity": "error"
    },
    {
      "constraint_id": "portable.enum-has-no-transitions",
      "constraint_kind": "node-property",
      "applies_to": ["architecture.EnumImplementation"],
      "property_id": "state.transition_count",
      "operator": "equals",
      "expected": 0,
      "severity": "error"
    }
  ],
  "authority_effect": "none"
