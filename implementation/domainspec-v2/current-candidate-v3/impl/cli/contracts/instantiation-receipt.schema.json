{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/contracts/instantiation-receipt.schema.json",
  "title": "DomainSpec baseline-bound instantiation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline",
    "input",
    "language",
    "selected_realization",
    "generator_id",
    "system_integration",
    "semantic_contract",
    "plan_sha256",
    "artifacts",
    "authority_effect",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec.instantiation-receipt/v1"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "const": "domainspec-meta-types-current-implemented@11-candidate.3"
        },
        "digest": {
          "const": "cf9021bc0a3624be233f26877c6fecc5f10d3db5c37423e496eade4fea184cd5"
        },
        "manifest_sha256": {
          "const": "ed5b08a898969e0c392835b7c12a1baa58f58bd3b142fd67c2aaa2da03cd92dc"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "feature_id",
        "node_id",
        "kind",
        "meta_type_id",
        "source_manifest_sha256"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "feature_id": {
          "$ref": "#/$defs/id"
        },
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "Entity",
            "Value Object",
            "Enum",
            "Operation",
            "Query",
            "Calculation",
            "Rule",
            "Policy",
            "Workflow",
            "Interface",
            "Event",
            "Mapping",
            "State Machine"
          ]
        },
        "meta_type_id": {
          "pattern": "^DS-D1\\.(?:[1-9]|1[1-4])$"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "language": {
      "enum": [
        "typescript",
        "python",
        "rust"
      ]
    },
    "selected_realization": {
      "$ref": "#/$defs/realization"
    },
    "generator_id": {
      "pattern": "^domainspec\\.generator/(?:DS-D1\\.4/(?:typescript|python|rust)/v2|DS-D1\\.9/(?:typescript|python|rust)/v3|DS-D1\\.(?:1|2|3|5|6|7|8|11|12|13|14)/(?:typescript|python|rust)/v1)$"
    },
    "system_integration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/system_integration"
        }
      ]
    },
    "semantic_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "relationships",
        "relationship_authority_sha256"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/body"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "relationship_authority_sha256": {
          "const": "82c55ea1ad031d3135c5b8a85162e44b4e85f296b54057fda0dc38131ab376a1"
        }
      }
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta_type_id",
        "meta_type_label",
        "language",
        "source",
        "provider",
        "binding"
      ],
      "properties": {
        "meta_type_id": {
          "type": "string"
        },
        "meta_type_label": {
          "type": "string"
        },
        "language": {
          "enum": [
            "typescript",
            "python",
            "rust"
          ]
        },
        "source": {
          "$ref": "#/$defs/path_digest"
        },
        "provider": {
          "$ref": "#/$defs/path_digest"
        },
        "binding": {
          "$ref": "#/$defs/path_digest"
        }
      }
    },
    "system_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_selector",
        "binding_source",
        "manifest",
        "generated_relative_path"
      ],
      "properties": {
        "profile_selector": {
          "const": "provider-neutral-v1"
        },
        "binding_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_path",
            "sha256"
          ],
          "properties": {
            "relative_path": {
              "type": "string",
              "pattern": "^integrations/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.json$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "manifest": {
          "$ref": "#/$defs/system_integration_manifest"
        },
        "generated_relative_path": {
          "type": "string",
          "pattern": "^src/domainspec/system-integration/(?:typescript|python|rust)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.(?:ts|py|rs)$"
        }
      }
    },
    "system_integration_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_set_id",
        "subject_ref",
        "profile",
        "language",
        "source_digest",
        "canonical_bindings",
        "runtime_guarantees_observed",
        "authority_effect",
        "binding_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "domainspec.system-integration-binding-manifest/v1"
        },
        "binding_set_id": {
          "$ref": "#/$defs/id"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "profile_digest",
            "language_profile_id",
            "language_profile_digest",
            "architecture_id",
            "architecture_sha256"
          ],
          "properties": {
            "profile_id": {
              "const": "domainspec.system-integration-profile/provider-neutral-v1"
            },
            "profile_digest": {
              "$ref": "#/$defs/sha256"
            },
            "language_profile_id": {
              "type": "string",
              "minLength": 1
            },
            "language_profile_digest": {
              "$ref": "#/$defs/sha256"
            },
            "architecture_id": {
              "const": "domainspec-durable-recovery@2"
            },
            "architecture_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "language": {
          "enum": [
            "typescript",
            "python",
            "rust"
          ]
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_bindings": {
          "type": "object"
        },
        "runtime_guarantees_observed": {
          "const": false
        },
        "authority_effect": {
          "const": "none"
        },
        "binding_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "body": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "description",
            "fields"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "$ref": "#/$defs/string_array"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "values"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "$ref": "#/$defs/string_array",
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "reads",
            "writes",
            "effects",
            "guard",
            "failure_continuation"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "reads": {
              "$ref": "#/$defs/string_array"
            },
            "writes": {
              "$ref": "#/$defs/string_array"
            },
            "effects": {
              "$ref": "#/$defs/string_array"
            },
            "guard": {
              "type": "string",
              "minLength": 1
            },
            "failure_continuation": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "reads"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "reads": {
              "$ref": "#/$defs/string_array"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "inputs"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "$ref": "#/$defs/string_array"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "predicate"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "strategies"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "strategies": {
              "$ref": "#/$defs/string_array",
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "steps",
            "compensations"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "$ref": "#/$defs/string_array",
              "minItems": 1
            },
            "compensations": {
              "$ref": "#/$defs/string_array"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "version",
            "operations"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "operations": {
              "$ref": "#/$defs/string_array"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "source",
            "target"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "description",
            "states",
            "initial",
            "transitions"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "states": {
              "$ref": "#/$defs/string_array",
              "minItems": 1
            },
            "initial": {
              "type": "string",
              "minLength": 1
            },
            "transitions": {
              "$ref": "#/$defs/string_array"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "node_id",
        "kind"
      ],
      "properties": {
        "feature_id": {
          "$ref": "#/$defs/id"
        },
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "relationship",
        "scope",
        "source",
        "target"
      ],
      "properties": {
        "edge_id": {
          "$ref": "#/$defs/id"
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "feature",
            "project"
          ]
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "target": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
