{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec://schemas/durable-compensation-concepts/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "status", "authority_effect", "source_definition", "admission", "concepts", "dispatch_transitions", "processing_guarantee", "invariants", "deferred_architecture_choices", "excluded_semantics", "admission_requirements"],
  "properties": {
    "schema_version": {"const": "domainspec.durable-compensation-concepts/v1"},
    "package_id": {"const": "domainspec-durable-compensation-concepts@2"},
    "status": {"const": "admitted-definition-source"},
    "authority_effect": {"const": "none"},
    "source_definition": {"const": "domainspec-v2-D36"},
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ids", "canonical_definitions", "product_ontology", "baseline_id"],
      "properties": {
        "definition_ids": {
          "type": "array",
          "prefixItems": [
            {"const": "domainspec-v2-D36"}, {"const": "domainspec-v2-D37"},
            {"const": "domainspec-v2-D38"}, {"const": "domainspec-v2-D39"},
            {"const": "domainspec-v2-D40"}, {"const": "domainspec-v2-D41"},
            {"const": "domainspec-v2-D42"}, {"const": "domainspec-v2-D43"},
            {"const": "domainspec-v2-D44"}
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        },
        "canonical_definitions": {"const": "cyberAlchemy-v2/authority/domainspec-v2/current-candidate-v5/definitions/DEFINITIONS.md"},
        "product_ontology": {"const": "cyberAlchemy-v2/ontology/domainspec-v2/current-candidate-v5"},
        "baseline_id": {"const": "domainspec-meta-types-current-implemented@7"}
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposed_id", "term", "role", "identity_fields", "states", "retry_identity_behavior"],
        "properties": {
          "proposed_id": {"pattern": "^domainspec-v2-D(3[7-9]|4[0-4])$"},
          "term": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "identity_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "states": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "retry_identity_behavior": {
            "enum": ["preserved", "new-per-execution-episode", "independent-authority-lifecycle", "new-per-authorized-retry", "terminal-only"]
          }
        }
      }
    },
    "dispatch_transitions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "cause"],
        "properties": {
          "from": {"enum": ["ready", "leased", "executing", "retry-scheduled"]},
          "to": {"enum": ["ready", "leased", "executing", "retry-scheduled", "terminal"]},
          "cause": {"type": "string", "minLength": 1}
        }
      }
    },
    "processing_guarantee": {"const": "at-least-once-invocation-with-idempotent-semantic-application"},
    "invariants": {"type": "array", "minItems": 21, "maxItems": 21, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "deferred_architecture_choices": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_semantics": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "admission_requirements": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
