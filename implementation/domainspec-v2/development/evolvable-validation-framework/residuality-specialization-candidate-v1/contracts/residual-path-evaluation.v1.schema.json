{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsv2.evf-residual-path-evaluation/v1",
  "$comment": "Open questions are owned by ../OPEN-QUESTIONS.md.",
  "title": "EVF residual path evaluation receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "source_bindings", "path_results", "coverage", "aggregate_readiness", "residues", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "dsv2.evf-residual-path-evaluation-receipt/v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "object"},
    "path_results": {"type": "array", "minItems": 1},
    "coverage": {
      "type": "object",
      "required": ["declared_paths", "specification_closed_paths", "reachable_safety_paths", "evidence_supported_paths"],
      "properties": {
        "declared_paths": {"type": "integer", "minimum": 1},
        "specification_closed_paths": {"type": "integer", "minimum": 0},
        "reachable_safety_paths": {"type": "integer", "minimum": 0},
        "evidence_supported_paths": {"type": "integer", "minimum": 0}
      }
    },
    "aggregate_readiness": {"enum": ["READY_CANDIDATE_ONLY", "BLOCK"]},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
