{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/evf/verification-tier-profile.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "status", "supported_tiers", "tier_requirements", "trait_capabilities", "policies", "authority_effect", "product_approval", "runtime_admission", "release_admission", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "evf.verification-tier-enforcement-profile/v1-candidate"},
    "profile_id": {"const": "evf.core.verification-tiers.v0-v2"},
    "profile_version": {"const": "1"},
    "status": {"const": "implementation-candidate-unapproved"},
    "supported_tiers": {"const": ["V0", "V1", "V2"]},
    "tier_requirements": {
      "type": "object", "additionalProperties": false, "required": ["V0", "V1", "V2"],
      "properties": {
        "V0": {"$ref": "#/$defs/requirement"},
        "V1": {"$ref": "#/$defs/requirement"},
        "V2": {"$ref": "#/$defs/requirement"}
      }
    },
    "trait_capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["recursive-relational", "bounded-structural", "executable-implementation"],
      "properties": {
        "recursive-relational": {"const": ["datalog-fixed-point"]},
        "bounded-structural": {"const": ["relational-model-finding"]},
        "executable-implementation": {"const": ["executable-evaluation"]}
      }
    },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["automatic_downgrade", "voting", "fixture_product_evidence", "unknown_is_success", "degraded_success", "contract_and_property_results_separate"],
      "properties": {
        "automatic_downgrade": {"const": "forbidden"},
        "voting": {"const": "forbidden"},
        "fixture_product_evidence": {"const": "forbidden"},
        "unknown_is_success": {"const": false},
        "degraded_success": {"const": "forbidden"},
        "contract_and_property_results_separate": {"const": true}
      }
    },
    "authority_effect": {"const": "none"},
    "product_approval": {"const": "not-granted"},
    "runtime_admission": {"const": "not-granted"},
    "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_provider_routes", "independent_routes", "negative_control_classes"],
      "properties": {
        "minimum_provider_routes": {"type": "integer", "minimum": 1},
        "independent_routes": {"type": "boolean"},
        "negative_control_classes": {"type": "array", "items": {"enum": ["subject", "oracle", "denominator", "evidence", "execution"]}, "uniqueItems": true}
      }
    }
  }
}
