{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evf.verification-tier-result/v1",
  "type": "object",
  "required": ["schema_version", "request_id", "requested_tier", "verified_tier", "available_lower_tier", "contract_state", "property_outcome", "provider_receipt_digests", "checks", "residue", "claim_ceiling", "authority_effect", "result_digest"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "evf.verification-tier-result/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "requested_tier": {"enum": ["V0", "V1", "V2", null]},
    "verified_tier": {"enum": ["V0", "V1", "V2", null]},
    "available_lower_tier": {"enum": ["V0", "V1", null]},
    "contract_state": {"enum": ["satisfied", "not_evaluable", "conflicting_evidence", "invalid_request"]},
    "property_outcome": {"enum": ["counterexample", "no_counterexample_within_bounds", "inconclusive", "conflicting_evidence"]},
    "provider_receipt_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "checks": {"type": "array", "items": {"type": "object"}},
    "residue": {"type": "array", "items": {"type": "string"}},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"},
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
