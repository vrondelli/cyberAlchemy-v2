.decl Node(id:symbol)
.input Node

.decl SelectedEdge(from:symbol, to:symbol)
.input SelectedEdge

.decl RequiredSource(id:symbol)
.input RequiredSource

.decl Target(id:symbol)
.input Target

.decl Reach(from:symbol, to:symbol)
Reach(x, y) :- SelectedEdge(x, y).
Reach(x, z) :- Reach(x, y), SelectedEdge(y, z).

.decl Violation(source:symbol)
Violation(source) :- RequiredSource(source), Target(target), !Reach(source, target).
.output Violation
