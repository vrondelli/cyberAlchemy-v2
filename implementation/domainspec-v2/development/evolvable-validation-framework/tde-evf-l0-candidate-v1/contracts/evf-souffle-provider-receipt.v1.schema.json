{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsv2.evf-souffle-provider-receipt.v1",
  "type": "object",
  "required": ["schema_version", "receipt_kind", "obligation_id", "provider", "execution", "normalized_outcome", "authority_effect", "release_admission", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "evf.souffle-provider-receipt/v1"},
    "receipt_kind": {"enum": ["provider-evidence", "test-only-fixture-evidence"]},
    "provider": {
      "type": "object",
      "required": ["id", "version", "runtime_sha256", "version_output"]
    },
    "normalized_outcome": {"enum": ["counterexample", "no-counterexample", "unresolved"]},
    "authority_effect": {"const": "none"},
    "release_admission": {"const": "not-granted"},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
