{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsv2.tde-neutral-graph-obligation.v1",
  "type": "object",
  "required": ["schema_version", "obligation_id", "obligation_kind", "property_id", "property_definition_ref", "fact_manifest_digest", "subject", "oracle", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "tde.neutral-graph-obligation/v1"},
    "obligation_id": {"type": "string", "pattern": "^tde\\.obligation\\.[0-9a-f]{64}$"},
    "obligation_kind": {"const": "closed-world-reachability"},
    "fact_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "required": ["required_sources", "target", "selected_predicates", "closure", "directed"],
      "properties": {
        "project_id": {"const": "financial-settlement"},
        "required_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "target": {"type": "string"},
        "selected_predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "closure": {"const": "non-reflexive-transitive-one-or-more"},
        "directed": {"const": true}
      },
      "additionalProperties": false
    },
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": true
}
