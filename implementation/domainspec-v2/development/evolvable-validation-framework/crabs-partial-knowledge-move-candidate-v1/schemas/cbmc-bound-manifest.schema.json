{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evf.crabs-partial-knowledge-cbmc-bound-manifest.v1",
  "type": "object",
  "required": ["schema_version", "status", "cbmc", "subject_commit", "representatives", "authority_effect"],
  "properties": {
    "schema_version": {"const": "evf.crabs-partial-knowledge-cbmc-bound-manifest/v1"},
    "status": {"enum": ["frozen", "not-evaluable"]},
    "cbmc": {
      "type": "object",
      "required": ["version", "executable", "sha256"],
      "properties": {
        "version": {"const": "6.11.0"},
        "executable": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "subject_commit": {"const": "477799721668652988bf98a4a9067d08f5bdaebf"},
    "representatives": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "harness_sha256", "loops", "property_id", "assertion_text", "discovery", "complete_check_argv", "target_check_argv"],
        "properties": {
          "id": {"enum": ["b-newer", "c-newer"]},
          "harness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "loops": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["loop_id", "unwind", "justification"], "properties": {"loop_id": {"type": "string", "minLength": 1}, "unwind": {"type": "integer", "minimum": 1}, "justification": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
          "property_id": {"type": "string", "minLength": 1},
          "assertion_text": {"enum": ["EVF_CBMC_B_NEWER_CONVERGENCE", "EVF_CBMC_C_NEWER_CONVERGENCE"]},
          "discovery": {"type": "object", "required": ["loops_stdout_sha256", "loops_stderr_sha256", "properties_stdout_sha256", "properties_stderr_sha256"], "properties": {"loops_stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "loops_stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "properties_stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "properties_stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
          "complete_check_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "target_check_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
