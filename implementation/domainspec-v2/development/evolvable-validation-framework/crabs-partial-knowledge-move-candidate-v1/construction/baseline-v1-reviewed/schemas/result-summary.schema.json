{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evf.crabs-partial-knowledge-result-summary.v1",
  "type": "object",
  "required": ["schema_version", "run_id", "convergence_status", "implementation_invariant_status", "safety_status", "cbmc_statuses", "receipt_status", "promotion_verdict", "counts", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "evf.crabs-partial-knowledge-result-summary/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "convergence_status": {"enum": ["counterexample", "no-counterexample-in-matrix", "not-evaluable"]},
    "implementation_invariant_status": {"enum": ["violation", "no-detected-violation", "not-evaluable"]},
    "safety_status": {"enum": ["violation", "no-detected-violation", "not-evaluable"]},
    "cbmc_statuses": {"type": "object", "required": ["b-newer", "c-newer"], "properties": {"b-newer": {"enum": ["counterexample", "no-counterexample-at-bound", "not-evaluable"]}, "c-newer": {"enum": ["counterexample", "no-counterexample-at-bound", "not-evaluable"]}}, "additionalProperties": false},
    "receipt_status": {"enum": ["pass", "block"]},
    "promotion_verdict": {"enum": ["PASS", "BLOCK", "PARTIAL_NOT_EVALUABLE"]},
    "counts": {"type": "object"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
