{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsv2.evf-l2-hardening-evaluation.v1",
  "type": "object",
  "required": [
    "schema_version", "obligation_id", "evaluated_at", "freshness_limit_seconds",
    "checks", "provider_receipt_digests", "mapped_results", "status",
    "consistency_class", "residue", "collect_all", "voting", "authority_effect",
    "product_approval", "runtime_admission", "release_admission", "claim_ceiling",
    "evaluation_digest"
  ],
  "properties": {
    "schema_version": {"const": "evf.l2-hardening-evaluation/v1"},
    "obligation_id": {"type": "string", "pattern": "^tde\\.obligation\\."},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "freshness_limit_seconds": {"type": "integer", "minimum": 1},
    "status": {"enum": ["SUPPORTED_BOUNDED", "COUNTEREXAMPLE", "CONFLICT", "NOT_EVALUABLE", "BLOCK"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "status", "blockers"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "NOT_EVALUABLE"]},
          "blockers": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "provider_receipt_digests": {
      "type": "object",
      "required": ["souffle", "alloy"],
      "properties": {
        "souffle": {"type": ["string", "null"]},
        "alloy": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "mapped_results": {
      "type": "object",
      "required": ["souffle", "alloy"],
      "properties": {
        "souffle": {"type": ["string", "null"]},
        "alloy": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "collect_all": {"const": true},
    "consistency_class": {"type": "string", "minLength": 1},
    "residue": {"type": "array", "items": {"type": "string"}},
    "voting": {"const": "forbidden"},
    "authority_effect": {"const": "none"},
    "product_approval": {"const": "not-granted"},
    "runtime_admission": {"const": "not-granted"},
    "release_admission": {"const": "not-granted"},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "evaluation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
