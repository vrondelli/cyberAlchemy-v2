{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"evf.verification-tier-provider-receipt/v2-candidate",
  "type":"object","additionalProperties":false,
  "required":["schema_version","route_id","independence_group","producer_identity","capability","obligation_id","subject_sha256","bounds_digest","normalized_outcome","fresh","fixture","execution_state","raw_evidence_ref","raw_evidence_sha256","provider_profile_ref","provider_profile_sha256","input_refs","infrastructure","route_mutation","payload_digest"],
  "properties":{
    "schema_version":{"const":"evf.verification-tier-provider-receipt/v2-candidate"},"route_id":{"type":"string","minLength":1},"independence_group":{"type":"string","minLength":1},"producer_identity":{"type":"string","minLength":1},
    "capability":{"enum":["executable-evaluation","theorem-checking","explicit-state-model-checking","relational-model-finding","datalog-fixed-point"]},"obligation_id":{"type":"string","minLength":1},"subject_sha256":{"$ref":"#/$defs/sha"},"bounds_digest":{"$ref":"#/$defs/sha"},
    "normalized_outcome":{"enum":["no-counterexample","counterexample"]},"fresh":{"const":true},"fixture":{"const":false},"execution_state":{"const":"completed"},"raw_evidence_ref":{"$ref":"#/$defs/ref"},"raw_evidence_sha256":{"$ref":"#/$defs/sha"},"provider_profile_ref":{"$ref":"#/$defs/ref"},"provider_profile_sha256":{"$ref":"#/$defs/sha"},
    "input_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}},"infrastructure":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["component_id","sha256"],"properties":{"component_id":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}}},
    "route_mutation":{"type":"object","additionalProperties":false,"required":["mutation_id","expected_non_success","detected","input_ref","evidence_ref"],"properties":{"mutation_id":{"type":"string","minLength":1},"expected_non_success":{"const":true},"detected":{"const":true},"input_ref":{"$ref":"#/$defs/ref"},"evidence_ref":{"$ref":"#/$defs/ref"}}},"payload_digest":{"$ref":"#/$defs/sha"}
  },
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ref":{"type":"object","additionalProperties":false,"required":["path","sha256","size_bytes"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"},"size_bytes":{"type":"integer","minimum":0}}}}
}
