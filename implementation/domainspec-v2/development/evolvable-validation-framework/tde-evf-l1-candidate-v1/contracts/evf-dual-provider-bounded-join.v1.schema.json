{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsv2.evf-dual-provider-bounded-join.v1",
  "type": "object",
  "required": ["schema_version", "obligation_id", "provider_receipt_digests", "preflight", "mapped_results", "status", "consistency_class", "residue", "voting", "authority_effect", "product_approval", "release_admission", "join_digest"],
  "properties": {
    "schema_version": {"const": "evf.dual-provider-bounded-join/v1"},
    "status": {"enum": ["SUPPORTED_BOUNDED", "COUNTEREXAMPLE", "CONFLICT", "NOT_EVALUABLE", "BLOCK"]},
    "voting": {"const": "forbidden"},
    "authority_effect": {"const": "none"},
    "product_approval": {"const": "not-granted"},
    "release_admission": {"const": "not-granted"},
    "join_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
