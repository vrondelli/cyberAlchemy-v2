{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsv2.evf-crabs-cbmc-correction-record.v1",
  "type": "object",
  "required": ["schema_version", "correction_id", "recorded_at", "corrected_run_id", "corrected_outcome", "reason", "replacement_run_id", "authority_effect"],
  "properties": {
    "schema_version": {"const": "evf.crabs-cbmc-correction-record/v1"},
    "correction_id": {"type": "string", "pattern": "^crabs-cbmc-correction-[0-9a-f]{16}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "corrected_run_id": {"type": "string", "pattern": "^crabs-cbmc-[0-9a-f]{16}$"},
    "corrected_outcome": {"const": "not-evaluable"},
    "reason": {"type": "string", "minLength": 1},
    "replacement_run_id": {"type": "string", "pattern": "^crabs-cbmc-[0-9a-f]{16}$"},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
