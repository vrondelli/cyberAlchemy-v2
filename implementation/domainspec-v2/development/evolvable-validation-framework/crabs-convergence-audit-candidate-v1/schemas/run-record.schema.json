{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsv2.evf-crabs-cbmc-run-record.v1",
  "type": "object",
  "required": ["schema_version", "run_id", "evidence_status", "started_at", "finished_at", "host", "subject_commit", "source_manifest_digest", "obligation_digest", "provider", "bounds", "native", "cbmc", "normalized_outcome", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "evf.crabs-cbmc-run-record/v1"},
    "run_id": {"type": "string", "pattern": "^crabs-cbmc-[0-9a-f]{16}$"},
    "evidence_status": {"enum": ["dry-run-fixture", "live"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "host": {"type": "string", "minLength": 1},
    "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "obligation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {
      "type": "object",
      "required": ["id", "version", "runtime_sha256", "native_compiler_sha256"],
      "properties": {
        "id": {"const": "cbmc"},
        "version": {"const": "6.11.0"},
        "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "native_compiler_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "bounds": {"type": "object"},
    "native": {"$ref": "#/$defs/execution"},
    "cbmc": {"$ref": "#/$defs/execution"},
    "normalized_outcome": {"enum": ["counterexample", "no-counterexample", "not-evaluable"]},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "execution": {
      "type": "object",
      "required": ["argv", "exit_code", "stdout_sha256", "stderr_sha256", "stdout_base64", "stderr_base64"],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stdout_base64": {"type": "string"},
        "stderr_base64": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
