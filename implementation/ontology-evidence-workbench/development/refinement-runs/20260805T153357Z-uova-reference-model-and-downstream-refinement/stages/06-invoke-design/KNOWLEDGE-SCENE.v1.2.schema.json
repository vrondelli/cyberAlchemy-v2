{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/oew/knowledge-scene/v1.2",
  "title": "OEW Knowledge Scene v1.2 compositional successor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "scene_digest",
    "graph_digest",
    "view_pack_id",
    "view_pack_digest",
    "scope",
    "nodes",
    "internal_relations",
    "cut_relations",
    "clusters",
    "portals",
    "legend",
    "navigation_frame",
    "denominators",
    "relation_index_receipt"
  ],
  "properties": {
    "schema_version": {"const": "oew.knowledge-scene.v1.2"},
    "scene_id": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/id"},
    "scene_digest": {"$ref": "https://cyberalchemy.local/oew/relation-reference/v1.2#/$defs/digest"},
    "graph_digest": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/digest"},
    "view_pack_id": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/id"},
    "view_pack_digest": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/digest"},
    "scope": {"enum": ["home", "focus", "path", "full-index"]},
    "nodes": {"type": "array", "items": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/node"}},
    "internal_relations": {"type": "array", "items": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/relation"}},
    "cut_relations": {"type": "array", "items": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/relation"}},
    "clusters": {"type": "array", "items": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/compiledCluster"}},
    "portals": {"type": "array", "items": {"$ref": "#/$defs/portal"}},
    "legend": {"type": "array", "items": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/cue"}},
    "path_result": {"$ref": "#/$defs/pathResult"},
    "navigation_frame": {"$ref": "#/$defs/navigationFrame"},
    "denominators": {"$ref": "https://domainspec.local/oew/knowledge-scene/v1.1#/$defs/denominators"},
    "relation_index_receipt": {"$ref": "https://cyberalchemy.local/oew/relation-reference/v1.2#/$defs/relationIndexReceipt"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringList": {"type": "array", "items": {"type": "string"}},
    "relationRef": {"$ref": "https://cyberalchemy.local/oew/relation-reference/v1.2#/$defs/relationRef"},
    "portalConstituent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_ref", "inside_endpoint_node_id", "outside_endpoint_node_id", "traversal_direction", "destination_cluster_id"],
      "properties": {
        "relation_ref": {"$ref": "#/$defs/relationRef"},
        "inside_endpoint_node_id": {"$ref": "#/$defs/id"},
        "outside_endpoint_node_id": {"$ref": "#/$defs/id"},
        "traversal_direction": {"enum": ["with-source", "against-source", "either"]},
        "destination_cluster_id": {"$ref": "#/$defs/id"}
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portal_id", "destination_cluster_id", "constituents", "predicate_summary", "predicate_summary_digest"],
      "properties": {
        "portal_id": {"$ref": "#/$defs/id"},
        "destination_cluster_id": {"$ref": "#/$defs/id"},
        "constituents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/portalConstituent"}},
        "predicate_summary": {"$ref": "#/$defs/stringList"},
        "predicate_summary_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "pathHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_node_id", "relation_ref", "to_node_id", "traversal_direction"],
      "properties": {
        "from_node_id": {"$ref": "#/$defs/id"},
        "relation_ref": {"$ref": "#/$defs/relationRef"},
        "to_node_id": {"$ref": "#/$defs/id"},
        "traversal_direction": {"enum": ["with-source", "against-source"]}
      }
    },
    "pathResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_result_id", "from_node_id", "to_node_id", "policy_id", "policy_version", "selected_path_index", "paths"],
      "properties": {
        "path_result_id": {"$ref": "#/$defs/id"},
        "from_node_id": {"$ref": "#/$defs/id"},
        "to_node_id": {"$ref": "#/$defs/id"},
        "policy_id": {"enum": ["directed-shortest", "undirected-shortest"]},
        "policy_version": {"const": "1.0.0"},
        "selected_path_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "paths": {"type": "array", "maxItems": 8, "items": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/pathHop"}}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "node", "relation", "portal", "path-hop"]},
        "id": {"type": "string"},
        "relation_ref": {"$ref": "#/$defs/relationRef"}
      }
    },
    "navigationFrame": {
      "type": "object",
      "additionalProperties": true,
      "required": ["frame_id", "graph_digest", "view_pack_id", "view_pack_digest", "scene_digest", "scope", "selected"],
      "properties": {
        "frame_id": {"$ref": "#/$defs/id"},
        "graph_digest": {"$ref": "#/$defs/digest"},
        "view_pack_id": {"$ref": "#/$defs/id"},
        "view_pack_digest": {"$ref": "#/$defs/digest"},
        "scene_digest": {"$ref": "#/$defs/digest"},
        "scope": {"enum": ["home", "focus", "path", "full-index"]},
        "selected": {"$ref": "#/$defs/selection"}
      }
    }
  }
}
