{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/oew/view-pack/v1",
  "title": "OEW View Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "view_pack_id", "view_pack_digest", "graph_digest", "role", "label", "purpose", "allowed_readings", "forbidden_readings", "membership_policy", "unassigned_policy", "clusters", "default_cluster_id", "source_refs", "authority_effect"],
  "properties": {
    "schema_version": {"const": "oew.view-pack.v1"},
    "view_pack_id": {"type": "string", "minLength": 1},
    "view_pack_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "graph_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role": {"enum": ["meaning", "business", "system", "bridge", "evidence", "task", "coverage", "gaps", "learning"]},
    "label": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "allowed_readings": {"$ref": "#/$defs/nonEmptyStrings"},
    "forbidden_readings": {"$ref": "#/$defs/nonEmptyStrings"},
    "membership_policy": {"const": "exactly-one-cluster-per-admitted-node"},
    "unassigned_policy": {"const": "reject"},
    "clusters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cluster"}},
    "default_cluster_id": {"type": "string", "minLength": 1},
    "sequences": {"type": "array", "items": {"$ref": "#/$defs/sequence"}},
    "source_refs": {"$ref": "#/$defs/nonEmptyStrings"},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "purpose", "icon_token", "member_node_ids", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "icon_token": {"type": "string", "minLength": 1},
        "member_node_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "source_refs": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "node_ids": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  }
}
