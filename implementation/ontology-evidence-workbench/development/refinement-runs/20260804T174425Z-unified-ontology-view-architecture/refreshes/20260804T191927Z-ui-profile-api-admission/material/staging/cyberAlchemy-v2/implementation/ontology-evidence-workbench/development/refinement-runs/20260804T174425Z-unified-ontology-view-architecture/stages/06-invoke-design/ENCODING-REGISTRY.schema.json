{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/oew/encoding-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "graph_digest", "predicate_tokens", "node_kind_tokens", "role_tokens"],
  "properties": {
    "schema_version": {"const": "oew.encoding-registry.v1"},
    "registry_id": {"type": "string"},
    "graph_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "predicate_tokens": {"type": "array", "items": {"type": "object", "required": ["exact_predicate", "color", "pattern", "text", "direction_phrase"], "properties": {"exact_predicate": {"type": "string"}, "color": {"type": "string"}, "pattern": {"enum": ["solid", "dashed", "dotted", "double"]}, "text": {"type": "string"}, "direction_phrase": {"type": "string"}}}},
    "node_kind_tokens": {"type": "array", "items": {"type": "object", "required": ["node_kind", "icon_token", "text"], "properties": {"node_kind": {"type": "string"}, "icon_token": {"type": "string"}, "text": {"type": "string"}}}},
    "role_tokens": {"type": "array", "items": {"type": "object", "required": ["role", "mark_token", "text"], "properties": {"role": {"type": "string"}, "mark_token": {"type": "string"}, "text": {"type": "string"}}}}
  }
}

