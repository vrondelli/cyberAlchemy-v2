{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/oew/semantic-intent/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_id", "scene_digest", "kind", "entity_id", "input_modality"],
  "properties": {
    "schema_version": {"const": "oew.semantic-intent.v1"},
    "intent_id": {"type": "string", "minLength": 1},
    "scene_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kind": {"enum": ["select-node", "select-relation", "open-portal", "expand-portal", "request-path", "open-inspector", "open-full-index", "restore-frame", "set-filter", "set-viewport"]},
    "entity_id": {"type": "string"},
    "input_modality": {"enum": ["keyboard", "pointer", "touch", "programmatic"]},
    "payload": {"type": "object"}
  }
}

