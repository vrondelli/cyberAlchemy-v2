{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/oew/scene-geometry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_digest", "layout_engine", "layout_version", "options_digest", "seed", "canonical_precision_px", "nodes", "relations", "clusters"],
  "properties": {
    "schema_version": {"const": "oew.scene-geometry.v1"},
    "scene_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "layout_engine": {"const": "elk-layered"},
    "layout_version": {"const": "0.9.3"},
    "options_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed": {"type": "integer", "minimum": 1},
    "canonical_precision_px": {"const": 0.25},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["source_node_id", "x", "y", "width", "height"], "properties": {"source_node_id": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}}},
    "relations": {"type": "array", "items": {"type": "object", "required": ["source_relation_id", "sections", "label_box", "marker_endpoint"], "properties": {"source_relation_id": {"type": "string"}, "sections": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}}, "label_box": {"type": "object"}, "marker_endpoint": {"type": "object"}}}}},
    "clusters": {"type": "array", "items": {"type": "object", "required": ["cluster_id", "x", "y", "width", "height"], "properties": {"cluster_id": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}}}}
  }
}
