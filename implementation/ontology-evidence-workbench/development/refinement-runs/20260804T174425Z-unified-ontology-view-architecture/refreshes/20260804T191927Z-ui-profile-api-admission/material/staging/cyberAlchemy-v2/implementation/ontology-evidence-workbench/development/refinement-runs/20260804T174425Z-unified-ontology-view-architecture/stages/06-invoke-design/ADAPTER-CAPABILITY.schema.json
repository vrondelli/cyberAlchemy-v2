{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/oew/adapter-capability/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "adapter_version", "dependency_lock_digest", "capabilities", "conformance_receipt"],
  "properties": {
    "schema_version": {"const": "oew.adapter-capability.v1"},
    "adapter_id": {"enum": ["react-flow-svg", "cytoscape-canvas"]},
    "adapter_version": {"type": "string", "minLength": 1},
    "dependency_lock_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel_relation_identity", "compound_clusters", "edge_labels", "markers", "patterns", "semantic_dom", "geometry_receipts", "keyboard_intents", "forced_colors", "reduced_motion", "viewport_control"],
      "properties": {
        "parallel_relation_identity": {"const": true}, "compound_clusters": {"const": true}, "edge_labels": {"const": true}, "markers": {"const": true}, "patterns": {"const": true}, "semantic_dom": {"const": true}, "geometry_receipts": {"const": true}, "keyboard_intents": {"const": true}, "forced_colors": {"const": true}, "reduced_motion": {"const": true}, "viewport_control": {"const": true}
      }
    },
    "conformance_receipt": {"type": "object", "required": ["result", "fixture_digest", "browser_runtime_digest"], "properties": {"result": {"const": "pass"}, "fixture_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "browser_runtime_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  }
}

