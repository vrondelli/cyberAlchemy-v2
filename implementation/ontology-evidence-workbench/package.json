{
  "name": "@cyberalchemy/ontology-evidence-workbench",
  "version": "0.0.0-prototype",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:web",
    "test:all": "pnpm run test:web && pnpm run test:legacy",
    "test:web": "vitest run",
    "test:legacy": "node --experimental-strip-types --experimental-loader ./scripts/legacy-typescript-loader.mjs --test --test-skip-pattern \"live gateway requires explicit evidence tokens\" \"test/*.test.mjs\"",
    "test:standalone-browser": "node scripts/validate-standalone-oew.mjs && node --test test/standalone-browser-acceptance.test.mjs",
    "test:standalone-browser:container": "OEW_ACCEPTANCE_OUTPUT_ROOT=node_modules/.cache/oew-standalone node scripts/validate-standalone-oew.mjs && OEW_ACCEPTANCE_OUTPUT_ROOT=node_modules/.cache/oew-standalone node --test test/standalone-browser-acceptance.test.mjs",
    "audit:active-frontend": "node scripts/audit-active-frontend.mjs",
    "historical:test:source-admission": "node --test test/source-admission.test.mjs",
    "historical:test:native-viewer": "node --test test/native-viewer-boundary.test.mjs test/native-viewer-poker.test.mjs && node scripts/serve-native-viewer.mjs verify --receipt generated/runs/SWU-OEW-006/native-viewer-receipt.json",
    "historical:verify:adapter": "node scripts/verify-adapter-receipt.mjs generated/runs/SWU-OEW-004/adapter-receipt.json",
    "historical:verify:upstream": "node --test test/upstream-lock.test.mjs && node scripts/prepare-upstream.mjs verify --lock upstream/UPSTREAM.lock.json --output generated/upstream/2cda14e89535049e49120198886bc0b82e9e630f",
    "historical:test:l1-toolchain": "node --test test/l1-toolchain-bootstrap.test.mjs",
    "historical:materialize:l1-probe": "node scripts/materialize-l1-workroot.mjs materialize --lock upstream/L1-TOOLCHAIN.lock.json --output generated/runs/SWU-OEW-006P/l1-toolchain-handle.json",
    "historical:verify:l1-toolchain": "node scripts/verify-l1-toolchain.mjs verify --lock upstream/L1-TOOLCHAIN.lock.json --handle generated/runs/SWU-OEW-006P/l1-toolchain-handle.json --output generated/runs/SWU-OEW-006P/l1-toolchain-verification.json",
    "historical:test:ui-store": "node --test test/ui-store.test.mjs",
    "historical:test:trust-rail": "node --test test/trust-rail.test.mjs",
    "historical:test:evidence-inspector": "node --test test/evidence-inspector.test.mjs",
    "historical:test:view-parity": "node --test test/view-parity.test.mjs",
    "historical:test:navigation": "node --test test/navigation.test.mjs",
    "historical:test:poker-tour": "node --test test/poker-tour.test.mjs",
    "historical:test:responsive": "node --test test/responsive.test.mjs",
    "historical:build:l1": "node scripts/materialize-l1-build.mjs build --lock upstream/L1-BUILD.lock.json --output generated/runs/SWU-OEW-013B/l1-build-handle.json",
    "historical:verify:l1-build": "node scripts/verify-l1-build.mjs verify --lock upstream/L1-BUILD.lock.json --handle generated/runs/SWU-OEW-013B/l1-build-handle.json --output generated/runs/SWU-OEW-013B/l1-build-verification.json",
    "historical:test:browser": "node --test test/browser-acceptance.test.mjs",
    "historical:verify:browser-acceptance": "node scripts/verify-browser-acceptance.mjs generated/runs/SWU-OEW-014/browser-acceptance.json"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
