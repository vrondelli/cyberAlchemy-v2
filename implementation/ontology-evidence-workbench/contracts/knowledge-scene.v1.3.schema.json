{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/oew/knowledge-scene/v1.3",
  "title": "OEW KnowledgeScene draft or finalized artifact v1.3",
  "x-oew-relation-reference-paths": [
    "portals.*.constituents.*.relation_ref",
    "path.hops.*.relation_ref",
    "navigation_frame.selected.relation_ref"
  ],
  "oneOf": [
    {"$ref": "#/$defs/knowledgeSceneDraft"},
    {"$ref": "#/$defs/knowledgeSceneFinal"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relationLocator": {
      "$ref": "relation-reference.v1.3.schema.json#/$defs/relationLocator"
    },
    "relationRef": {
      "$ref": "relation-reference.v1.3.schema.json#/$defs/relationRef"
    },
    "relationFacet": {
      "type": "object",
      "required": ["source_relation_id"],
      "properties": {
        "source_relation_id": {"type": "string", "minLength": 1}
      }
    },
    "portalConstituentDraft": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relation_ref", "traversal_direction"],
      "properties": {
        "relation_ref": {"$ref": "#/$defs/relationLocator"},
        "traversal_direction": {
          "enum": ["with-source", "against-source", "either"]
        }
      }
    },
    "portalConstituentFinal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relation_ref", "traversal_direction"],
      "properties": {
        "relation_ref": {"$ref": "#/$defs/relationRef"},
        "traversal_direction": {
          "enum": ["with-source", "against-source", "either"]
        }
      }
    },
    "pathHopDraft": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relation_ref", "traversal_direction"],
      "properties": {
        "relation_ref": {"$ref": "#/$defs/relationLocator"},
        "traversal_direction": {
          "enum": ["with-source", "against-source", "either"]
        }
      }
    },
    "pathHopFinal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relation_ref", "traversal_direction"],
      "properties": {
        "relation_ref": {"$ref": "#/$defs/relationRef"},
        "traversal_direction": {
          "enum": ["with-source", "against-source", "either"]
        }
      }
    },
    "relationSelectionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relation_ref"],
      "properties": {
        "kind": {"enum": ["relation", "path-hop"]},
        "relation_ref": {"$ref": "#/$defs/relationLocator"}
      }
    },
    "relationSelectionFinal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relation_ref"],
      "properties": {
        "kind": {"enum": ["relation", "path-hop"]},
        "relation_ref": {"$ref": "#/$defs/relationRef"}
      }
    },
    "navigationFrameDraft": {
      "type": "object",
      "not": {"required": ["scene_digest"]},
      "properties": {
        "selected": {
          "oneOf": [
            {"$ref": "#/$defs/relationSelectionDraft"},
            {
              "type": "object",
              "not": {"required": ["relation_ref"]}
            }
          ]
        }
      }
    },
    "navigationFrameFinal": {
      "type": "object",
      "required": ["scene_digest"],
      "properties": {
        "scene_digest": {"$ref": "#/$defs/digest"},
        "selected": {
          "oneOf": [
            {"$ref": "#/$defs/relationSelectionFinal"},
            {
              "type": "object",
              "not": {"required": ["relation_ref"]}
            }
          ]
        }
      }
    },
    "receiptDraft": {
      "type": "object",
      "not": {"required": ["scene_digest"]}
    },
    "receiptFinal": {
      "type": "object",
      "required": [
        "scene_digest",
        "source_graph_digest",
        "relation_ids",
        "relation_count",
        "facet_set_digest",
        "digest_profile",
        "canonicalization_version",
        "hash_algorithm"
      ],
      "properties": {
        "scene_digest": {"$ref": "#/$defs/digest"},
        "source_graph_digest": {"type": "string", "minLength": 1},
        "relation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "relation_count": {"type": "integer", "minimum": 0},
        "facet_set_digest": {"$ref": "#/$defs/digest"},
        "digest_profile": {"const": "oew.relation-digest.v1"},
        "canonicalization_version": {"const": "rfc8785"},
        "hash_algorithm": {"const": "sha256"}
      }
    },
    "sceneBase": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "graph_digest",
        "internal_relations",
        "cut_relations",
        "portals",
        "navigation_frame"
      ],
      "properties": {
        "schema_version": {"const": "oew.knowledge-scene.v1.3"},
        "graph_digest": {"type": "string", "minLength": 1},
        "internal_relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/relationFacet"}
        },
        "cut_relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/relationFacet"}
        }
      }
    },
    "knowledgeSceneDraft": {
      "allOf": [
        {"$ref": "#/$defs/sceneBase"},
        {
          "not": {"required": ["scene_digest"]},
          "properties": {
            "portals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["constituents"],
                "properties": {
                  "constituents": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/portalConstituentDraft"}
                  }
                }
              }
            },
            "path": {
              "type": "object",
              "required": ["hops"],
              "properties": {
                "hops": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/pathHopDraft"}
                }
              }
            },
            "navigation_frame": {"$ref": "#/$defs/navigationFrameDraft"},
            "relation_index_receipt": {"$ref": "#/$defs/receiptDraft"}
          }
        }
      ]
    },
    "knowledgeSceneFinal": {
      "allOf": [
        {"$ref": "#/$defs/sceneBase"},
        {
          "required": ["scene_digest", "relation_index_receipt"],
          "properties": {
            "scene_digest": {"$ref": "#/$defs/digest"},
            "portals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["constituents"],
                "properties": {
                  "constituents": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/portalConstituentFinal"}
                  }
                }
              }
            },
            "path": {
              "type": "object",
              "required": ["hops"],
              "properties": {
                "hops": {
                  "type": "array",
                  "items": {"$ref": "#/$defs/pathHopFinal"}
                }
              }
            },
            "navigation_frame": {"$ref": "#/$defs/navigationFrameFinal"},
            "relation_index_receipt": {"$ref": "#/$defs/receiptFinal"}
          }
        }
      ]
    }
  }
}
