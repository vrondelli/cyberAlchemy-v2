{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/private/oew/l1-toolchain-handle/v1",
  "title": "OEW L1 Toolchain Handle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "result",
    "lock",
    "upstream",
    "effective_workspace",
    "toolchain",
    "mode",
    "workroot",
    "install",
    "patch_probe",
    "protected_set",
    "cleanup",
    "residue",
    "final_feature_build_claim",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "oew.l1-toolchain-handle.v1"},
    "handle": {"const": "oew-l1-toolchain-handle/v1"},
    "result": {"const": "pass"},
    "lock": {"$ref": "#/$defs/artifact"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "source_archive", "retained_l0_receipt"],
      "properties": {
        "commit": {"pattern": "^[a-f0-9]{40}$"},
        "source_archive": {"$ref": "#/$defs/artifact"},
        "retained_l0_receipt": {"$ref": "#/$defs/artifact"}
      }
    },
    "effective_workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "lockfile", "workspace"],
      "properties": {
        "package": {"$ref": "#/$defs/image"},
        "lockfile": {"$ref": "#/$defs/image"},
        "workspace": {"$ref": "#/$defs/image"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm"],
      "properties": {
        "node": {"$ref": "#/$defs/tool"},
        "pnpm": {"$ref": "#/$defs/tool"}
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "frozen_lockfile", "ignore_scripts", "isolated_store", "workspace_fallback", "global_fallback"],
      "properties": {
        "kind": {"enum": ["online", "isolated-store"]},
        "frozen_lockfile": {"const": true},
        "ignore_scripts": {"const": true},
        "isolated_store": {"const": true},
        "workspace_fallback": {"const": false},
        "global_fallback": {"const": false}
      }
    },
    "workroot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest_named", "outside_repository", "fresh"],
      "properties": {
        "name": {"pattern": "^oew-l1-toolchain-[a-f0-9]{16}$"},
        "digest_named": {"const": true},
        "outside_repository": {"const": true},
        "fresh": {"const": true}
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "result"],
      "properties": {
        "command": {"const": "pnpm install --frozen-lockfile --ignore-scripts --store-dir <workroot>/pnpm-store"},
        "exit_code": {"const": 0},
        "result": {"const": "pass"}
      }
    },
    "patch_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "patch", "target", "preimage_sha256", "postimage_sha256", "applied_once", "reapply_rejected", "oracle_passed"],
      "properties": {
        "manifest": {"$ref": "#/$defs/artifact"},
        "patch": {"$ref": "#/$defs/artifact"},
        "target": {"type": "string", "minLength": 1},
        "preimage_sha256": {"$ref": "#/$defs/digest"},
        "postimage_sha256": {"$ref": "#/$defs/digest"},
        "applied_once": {"const": true},
        "reapply_rejected": {"const": true},
        "oracle_passed": {"const": true}
      }
    },
    "protected_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "contract_sha256", "compiler_sha256", "set_digest", "entry_count", "equal_current"],
      "properties": {
        "before": {"$ref": "#/$defs/artifact"},
        "contract_sha256": {"$ref": "#/$defs/digest"},
        "compiler_sha256": {"$ref": "#/$defs/digest"},
        "set_digest": {"$ref": "#/$defs/digest"},
        "entry_count": {"type": "integer", "minimum": 1},
        "equal_current": {"const": true}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finally_executed", "workroot_removed", "workroot_absent"],
      "properties": {
        "finally_executed": {"const": true},
        "workroot_removed": {"const": true},
        "workroot_absent": {"const": true}
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporary_removed", "retained"],
      "properties": {
        "temporary_removed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "retained": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "final_feature_build_claim": {"const": false},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
