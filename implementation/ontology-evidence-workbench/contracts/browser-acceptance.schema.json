{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/schemas/oewtp/browser-acceptance/v1",
  "title": "OEW Browser Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "work_pack_id",
    "swu_id",
    "attempt_id",
    "result",
    "claim",
    "independent_verification",
    "source",
    "browser",
    "assertions",
    "negative_cases",
    "observations",
    "artifacts",
    "teardown",
    "claim_ceiling",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "oewtp.browser-acceptance.v1"
    },
    "handle": {
      "type": "string",
      "pattern": "^oewtp-browser-acceptance/[0-9]{8}T[0-9]{6}Z$"
    },
    "work_pack_id": {
      "const": "WP-OEWTP-001"
    },
    "swu_id": {
      "const": "SWU-OEWTP-004"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z$"
    },
    "result": {
      "const": "pass"
    },
    "claim": {
      "const": "one-local-automated-poker-team-journey"
    },
    "independent_verification": {
      "const": false
    },
    "source": {
      "type": "object",
      "required": [
        "gateway_handle",
        "gateway_receipt",
        "build_tree_sha256",
        "adapter_receipt_sha256",
        "authority_effect"
      ],
      "properties": {
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "browser": {
      "type": "object",
      "required": [
        "cli",
        "cli_path",
        "cli_realpath",
        "cli_version",
        "package",
        "package_name",
        "package_version",
        "api_entry",
        "chromium_executable",
        "chromium_version",
        "smoke_launch",
        "viewport",
        "headless",
        "fresh_context",
        "extensions",
        "persisted_user_data"
      ],
      "properties": {
        "package_name": {
          "const": "playwright"
        },
        "smoke_launch": {
          "const": "pass"
        },
        "headless": {
          "const": true
        },
        "fresh_context": {
          "const": true
        },
        "extensions": {
          "const": false
        },
        "persisted_user_data": {
          "const": false
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A(0[1-9]|1[0-3])-"
          },
          "result": {
            "const": "pass"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "negative_cases": {
      "type": "object",
      "required": [
        "invalid_bootstrap_status",
        "invalid_bootstrap_protected_body",
        "invalid_bundle_alert_visible",
        "invalid_bundle_graph_count"
      ],
      "properties": {
        "invalid_bootstrap_status": {
          "enum": [401, 403]
        },
        "invalid_bootstrap_protected_body": {
          "const": false
        },
        "invalid_bundle_alert_visible": {
          "const": true
        },
        "invalid_bundle_graph_count": {
          "const": 0
        }
      }
    },
    "observations": {
      "type": "object",
      "required": [
        "unexpected_console_errors",
        "outbound_requests",
        "request_count",
        "response_count"
      ],
      "properties": {
        "unexpected_console_errors": {
          "const": 0
        },
        "outbound_requests": {
          "const": 0
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "gateway_runtime",
        "request_ledger",
        "console_ledger",
        "screenshot"
      ]
    },
    "teardown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_closed",
        "context_closed",
        "browser_closed",
        "gateway_closed",
        "port_released",
        "temporary_roots_absent",
        "retained_dist_preserved"
      ],
      "properties": {
        "page_closed": {
          "const": true
        },
        "context_closed": {
          "const": true
        },
        "browser_closed": {
          "const": true
        },
        "gateway_closed": {
          "const": true
        },
        "port_released": {
          "const": true
        },
        "temporary_roots_absent": {
          "const": true
        },
        "retained_dist_preserved": {
          "const": true
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "none"
    }
  }
}
