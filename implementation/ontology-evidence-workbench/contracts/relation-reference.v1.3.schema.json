{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/oew/relation-reference/v1.3",
  "title": "OEW relation locator or finalized relation reference v1.3",
  "oneOf": [
    {"$ref": "#/$defs/relationLocator"},
    {"$ref": "#/$defs/relationRef"}
  ],
  "$defs": {
    "relationId": {
      "type": "string",
      "minLength": 1
    },
    "sceneRevisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relationLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_relation_id"],
      "properties": {
        "source_relation_id": {"$ref": "#/$defs/relationId"}
      }
    },
    "relationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_relation_id", "scene_digest"],
      "properties": {
        "source_relation_id": {"$ref": "#/$defs/relationId"},
        "scene_digest": {"$ref": "#/$defs/sceneRevisionDigest"}
      }
    }
  }
}
