{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oew.standalone-browser-acceptance.v1",
  "type": "object",
  "required": ["schema_version", "work_pack_id", "result", "dataset", "environment", "journeys", "errors", "artifacts", "authority_effect"],
  "properties": {
    "schema_version": { "const": "oew.standalone-browser-acceptance.v1" },
    "work_pack_id": { "const": "WP-SOEW-001" },
    "result": { "enum": ["pass", "fail"] },
    "authority_effect": { "const": "none" },
    "dataset": {
      "type": "object",
      "required": ["run_id", "nodes", "relations", "graph_sha256", "sidecar_sha256", "receipt_sha256"]
    },
    "environment": { "type": "object", "required": ["node", "playwright", "browser", "executable"] },
    "journeys": { "type": "array", "minItems": 8 },
    "errors": { "type": "array", "maxItems": 0 },
    "artifacts": { "type": "array", "minItems": 2 }
  },
  "additionalProperties": true
}
