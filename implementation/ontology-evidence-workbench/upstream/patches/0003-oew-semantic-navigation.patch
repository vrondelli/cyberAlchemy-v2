+  colorTokens: {"edge.data.consumes": {dark: "#158A8E", light: "#148185"}},
+  presentationPatternMap: {builds_on: "edge.pattern.solid"},
+  patternTokens: {"edge.pattern.solid": {label: "solid"}},
+};
+const bundle = {
+  graph: {
+    version: "1.0.0",
+    kind: "knowledge",
+    edges: [{
+      source: `presentation:${sourceId}`,
+      target: `presentation:${targetId}`,
+      description: "consumes",
+      type: "builds_on",
+      direction: "forward",
+    }],
+  },
+  sidecar: {
+    schema_version: "oew.evidence-sidecar.v1",
+    authority_effect: "none",
+    edges: {
+      [edgeId]: {
+        authority_effect: "none",
+        source_ref: relationId,
+        source: sourceId,
+        target: targetId,
+        source_relation: "consumes",
+        presentation_relation: "builds_on",
+        evidence_refs: ["operations.md"],
+      },
+    },
+    source_relations: {
+      schema_version: "body-war-business-relation-set/v1",
+      relations: [sourceRelation],
+    },
+    relation_encoding: encoding,
+  },
+  receipt: {
+    semantic_fixture: {
+      schema_version: "oew.semantic-navigation-browser-fixture.v1",
+      authority_effect: "none",
+      source_relations_sha256: "234ad4152b731edcb03cd1b45dfa21570bd37df741090ca6ca0940fd98c0ce00",
+      relation_encoding_sha256: "64cfafc1ce0803ccd7d21354b713458898256fb5db1372a380f3c383ca1d14e6",
+    },
+  },
+  sourceRefIndex: {[relationId]: entry},
+};
+const {relationInputs, relationRecords} = relationSceneFromBundle(bundle);
+const record = relationRecords[relationId];
+const relationModel = {
+  rows: [{presentationType: "relation", sourceRef: relationId}],
+  selectedSourceRef: relationId,
+};
+const expectIssue = (operation, issue) => {
+  try {
+    operation();
+  } catch (error) {
+    expect(error.issue).toBe(issue);
+    return;
+  }
+  throw new Error(`Expected ${issue}`);
+};
+const withRelation = (changed) => ({
+  ...relationInputs,
+  sourceRelations: {relations: [{...sourceRelation, ...changed}]},
+});
+const luminance = (hex) => {
+  const channels = hex.slice(1).match(/.{2}/g)
+    .map((value) => parseInt(value, 16) / 255)
+    .map((value) => value <= 0.03928
+      ? value / 12.92
+      : ((value + 0.055) / 1.055) ** 2.4);
+  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
+};
+
+describe("canonical selected relation rendering", () => {
+  it("uses the canonical schema and graph-edge identity without adaptation defaults", () => {
+    expect(record).toEqual({
+      schemaVersion: "relation-presentation-record.v1",
+      graphEdgeId: edgeId,
+      sourceRelationId: relationId,
+      sourceNodeId: sourceId,
+      targetNodeId: targetId,
+      sourcePredicate: "consumes",
+      sourceDirection: "directed",
+      projectedDirection: "forward",
+      presentationRelation: "builds_on",
+      colorToken: "edge.data.consumes",
+      linePatternToken: "edge.pattern.solid",
+      provenance: [{path: "operations.md", selector: "Attach", sha256: digest}],
+      sourceAuthorityEffect: "none",
+      projectionAuthorityEffect: "none",
+    });
+    expect(record.graphEdgeId).toBe(`presentation-edge:${record.sourceRelationId}`);
+  });
+
+  it("fails closed on missing direction, evidence digest, mappings, or authority", () => {
+    expectIssue(
+      () => relationRecordFromBundle(entry, bundle, withRelation({direction: ""})),
+      "SOURCE_DIRECTION_REQUIRED",
+    );
+    expectIssue(
+      () => relationRecordFromBundle(entry, bundle, withRelation({
+        evidence_refs: [{path: "operations.md", selector: "Attach", sha256: "bad"}],
+      })),
+      "SOURCE_EVIDENCE_DIGEST",
+    );
+    expectIssue(
+      () => relationRecordFromBundle(entry, bundle, {
+        ...relationInputs,
+        encoding: {...encoding, predicateColorMap: {}},
+      }),
+      "PREDICATE_MAPPING_MISSING",
+    );
+    expectIssue(
+      () => relationRecordFromBundle(entry, bundle, {
+        ...relationInputs,
+        encoding: {...encoding, presentationPatternMap: {}},
+      }),
+      "PRESENTATION_MAPPING_MISSING",
+    );
+    expectIssue(
+      () => relationRecordFromBundle(entry, bundle, withRelation({authority_effect: ""})),
+      "SOURCE_AUTHORITY_REQUIRED",
+    );
+    const noncanonicalId = `presentation-edge:${sourceId}:consumes:${targetId}`;
+    expectIssue(
+      () => relationRecordFromBundle(
+        {...entry, presentationId: noncanonicalId},
+        {
+          ...bundle,
+          sidecar: {
+            ...bundle.sidecar,
+            edges: {[noncanonicalId]: bundle.sidecar.edges[edgeId]},
+          },
+        },
+        relationInputs,
+      ),
+      "GRAPH_EDGE_ID_MISMATCH",
+    );
+  });
+
+  it("renders exact text, directions, pattern, and non-color selection", () => {
+    const markup = renderToStaticMarkup(
+      <GraphSurface
+        model={relationModel}
+        onSelect={() => {}}
+        relationColorValues={relationInputs.relationColorValues}
+        relationRecords={{[relationId]: record}}
+        traceActive={false}
+      />,
+    );
+    expect(markup).toContain('data-relation-schema="relation-presentation-record.v1"');
+    expect(markup).toContain('data-color-token="edge.data.consumes"');
+    expect(markup).toContain('data-pattern-token="edge.pattern.solid"');
+    for (const literal of [sourceId, "consumes", targetId, "directed", "forward"])
+      expect(markup).toContain(literal);
+    expect(markup).toContain("Selected relation");
+    expect(markup).toContain('aria-current="true"');
+  });
+
+  it("requires the canonical record in graph and inspector", () => {
+    expect(() => renderToStaticMarkup(
+      <GraphSurface
+        model={relationModel}
+        onSelect={() => {}}
+        relationColorValues={relationInputs.relationColorValues}
+        relationRecords={{}}
+        traceActive={false}
+      />,
+    )).toThrow(`RELATION_RECORD_REQUIRED:${relationId}`);
+    expect(() => inspectorModel(entry, null)).toThrow(`RELATION_RECORD_REQUIRED:${relationId}`);
+    const invalidBundle = {
+      ...bundle,
+      sidecar: {
+        ...bundle.sidecar,
+        source_relations: {
+          ...bundle.sidecar.source_relations,
+          relations: [{...sourceRelation, direction: ""}],
+        },
+      },
+    };
+    let detail = "";
+    expect(() => relationSceneFromBundle(invalidBundle)).toThrow(
+      "SOURCE_DIRECTION_REQUIRED",
+    );
+    try {
+      relationSceneFromBundle(invalidBundle);
+    } catch (error) {
+      detail = error.message;
+    }
+    const blocked = renderToStaticMarkup(<FailClosedSurface detail={detail} />);
+    expect(blocked).toContain('role="alert"');
+    expect(blocked).toContain("Workbench blocked");
+    expect(blocked).not.toContain('aria-label="Evidence graph"');
+  });
+
+  it("shows exact evidence and authority while retaining contrast recovery", () => {
+    const model = inspectorModel(entry, record);
+    expect(model).toMatchObject({
+      relation: "consumes",
+      sourceDirection: "directed",
+      projectedDirection: "forward",
+      provenance: ["operations.md"],
+      sourceAuthorityEffect: "none",
+      projectionAuthorityEffect: "none",
+    });
+    const markup = renderToStaticMarkup(
+      <EvidenceInspector entry={entry} onClose={() => {}} relationRecord={record} />,
+    );
+    expect(markup).toContain("Source authority");
+    expect(markup).toContain("Projection authority");
+    const contrast = (luminance("#158A8E") + 0.05) /
+      (luminance("#071019") + 0.05);
+    expect(contrast).toBeGreaterThanOrEqual(3);
+    expect(css).toContain("@media (forced-colors: active)");
+    expect(css).toContain("border-color: CanvasText");
+  });
+});
