+export const RELATION_ACTIVATION_KEYS = Object.freeze(["Enter", " "]);
+
+export function isRelationActivationKey(event) {
+  return RELATION_ACTIVATION_KEYS.includes(String(event?.key ?? ""));
+}
+
+export function restoreRelationFocus(root = document) {
+  const relations = Array.from(
+    root.querySelectorAll('.oew-edge[aria-current="true"]'),
+  );
+  if (relations.length === 1) {
+    relations[0].focus();
+    return Object.freeze({
+      restored: root.activeElement === relations[0],
+      target: "selected-relation",
+      fallbackUsed: false,
+      reason: root.activeElement === relations[0]
+        ? null
+        : "RELATION_FOCUS_REJECTED",
+    });
+  }
+  if (relations.length > 1) {
+    return Object.freeze({
+      restored: false,
+      target: null,
+      fallbackUsed: false,
+      reason: "RELATION_FOCUS_AMBIGUOUS",
+    });
+  }
+  const heading = root.querySelector("[data-oew-scene-heading]");
+  if (!heading) {
+    return Object.freeze({
+      restored: false,
+      target: null,
+      fallbackUsed: true,
+      reason: "SCENE_HEADING_MISSING",
+    });
+  }
+  heading.focus();
+  return Object.freeze({
+    restored: root.activeElement === heading,
+    target: "scene-heading",
+    fallbackUsed: true,
+    reason: root.activeElement === heading ? null : "SCENE_FOCUS_REJECTED",
+  });
+}
+
 export function keyboardCommand(event) {
