{
  "schema_version": "are.runtime-authority/v1",
  "product_form": "single-user-local-cli-daemon",
  "records": {
    "gateway_session_store": {
      "role": "transport-orchestration-and-delivery-recovery",
      "semantic_authority": false,
      "format": "are.gateway-session-event/v1"
    },
    "reasoning_state": {
      "role": "semantic-reasoning-truth",
      "semantic_authority": true,
      "format": "are.reasoning-state-event/v1"
    },
    "backend_transcript_cache": {
      "role": "provider-transcript-and-cache-observation",
      "semantic_authority": false,
      "format": "backend-owned-versioned-or-not_evaluable"
    }
  },
  "migration": {
    "default_enabled": false,
    "expiry_default_enabled": false,
    "unknown_format": "refuse",
    "required_preconditions": [
      "format-detected",
      "backup-exported",
      "restore-proved",
      "interrupted-migration-tested"
    ]
  },
  "diagnostics": {
    "separate_liveness_and_readiness": true,
    "secret_values": "never-emit",
    "backend_diagnostics": "digest-and-byte-count-only"
  },
  "authority_effect": "none",
  "claim_limit": "Local runtime record ownership and safe-operation contract only; no deployed service, production secret backend, physical erasure, multi-tenant isolation, release, or activation claim."
}
