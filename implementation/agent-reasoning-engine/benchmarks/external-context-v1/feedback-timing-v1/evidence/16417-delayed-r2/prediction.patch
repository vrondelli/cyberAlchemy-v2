+/**
+ * Returns `true` if `scope` is equal to or nested within `ancestor` (or its scope subtree)
+ * @param {import('svelte').Scope} scope
+ * @param {import('svelte').Scope} ancestor
+ */
+function is_within_scope(scope, ancestor) {
+	let current = scope;
+	while (current) {
+		if (current === ancestor) return true;
+		current = current.parent;
+	}
+	return false;
+}
