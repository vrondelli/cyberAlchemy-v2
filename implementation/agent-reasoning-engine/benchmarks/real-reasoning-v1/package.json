{
  "name": "@cyberalchemy/are-real-reasoning-benchmark",
  "version": "0.1.0-candidate",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "benchmark": "node bin/benchmark.mjs --mode core",
    "benchmark:intent": "node bin/benchmark.mjs --mode intent",
    "benchmark:integration": "node bin/benchmark.mjs --mode integration",
    "benchmark:continuation": "node bin/benchmark.mjs --mode continuation-routing",
    "benchmark:compaction": "node bin/benchmark.mjs --mode compaction-simulated",
    "benchmark:compaction:live": "node bin/benchmark.mjs --mode compaction-live",
    "benchmark:compaction:auto-live": "node bin/benchmark.mjs --mode compaction-auto-live",
    "benchmark:adaptive-reuse": "node bin/adaptive-reuse.mjs",
    "benchmark:adaptive-reuse:holdout": "node bin/adaptive-reuse.mjs --holdout",
    "benchmark:live": "node bin/benchmark.mjs --mode live",
    "benchmark:live-multiturn": "node bin/benchmark.mjs --mode live-multiturn",
    "benchmark:external-retrieval:fixture": "node bin/benchmark.mjs --mode external-retrieval --dataset fixtures/agent-retrieval-bench/samples.jsonl --predictions fixtures/agent-retrieval-bench/predictions.jsonl --dataset-id arb-fixture --dataset-revision fixture-v1 --stdout-only",
    "benchmark:external-retrieval:produce-fixture": "node bin/benchmark.mjs --mode external-retrieval-run --dataset fixtures/agent-retrieval-bench/samples.jsonl --corpus-dir fixtures/agent-retrieval-bench/corpus --dataset-id arb-fixture --dataset-revision fixture-v1 --stdout-only",
    "benchmark:all": "node bin/benchmark.mjs --mode all",
    "improve": "node bin/improve.mjs --mode diagnose",
    "improve:failure-canary": "node bin/improve.mjs run-canary",
    "evolve:fixture": "node bin/evolution-canary.mjs",
    "impact:profile": "node bin/impact-profile.mjs --warm-iterations 20 --iterations 100",
    "scorer:experiment": "node bin/scorer-experiment.mjs --repetitions 3",
    "scorer:experiment:v2": "node bin/scorer-experiment.mjs --treatment scorer:declared-concept-equivalence/candidate-v2 --experiment-id research-experiment:declared-concept-equivalence-v2-candidate --repetitions 3",
    "scorer:experiment:v3": "node bin/scorer-experiment.mjs --treatment scorer:declared-concept-equivalence/candidate-v3 --experiment-id research-experiment:declared-concept-equivalence-v3-candidate --repetitions 3",
    "scorer:experiment:v3:loop": "node bin/scorer-loop.mjs --treatment scorer:declared-concept-equivalence/candidate-v3 --experiment-id research-experiment:declared-concept-equivalence-v3-candidate --max-attempts 15 --repetitions 3",
    "scorer:strategy-loop": "node bin/scorer-loop.mjs --experiment-id research-experiment:declared-concept-equivalence-strategy-loop --max-attempts 15 --repetitions 3",
    "scorer:strategy-loop:gain": "node bin/scorer-loop.mjs --experiment-id research-experiment:declared-concept-equivalence-strategy-loop-gain --gain --max-no-gain-attempts 1 --max-attempts 15 --repetitions 3",
    "scorer:portfolio": "node bin/scorer-portfolio.mjs --experiment-id research-experiment:declared-concept-equivalence-portfolio --screening-repetitions 1 --full-repetitions 3 --max-survivors 2",
    "scorer:portfolio:confirm": "node bin/scorer-portfolio.mjs --experiment-id research-experiment:declared-concept-equivalence-portfolio-confirmed --confirmation-split even --screening-repetitions 1 --full-repetitions 3 --full-replications 3 --confirmation-repetitions 3 --confirmation-replications 3 --max-survivors 2",
    "scorer:portfolio:next": "node bin/scorer-portfolio.mjs --experiment-id research-experiment:declared-concept-equivalence-portfolio-v4 --confirmation-split even --screening-repetitions 1 --full-repetitions 3 --full-replications 3 --confirmation-repetitions 3 --confirmation-replications 3 --max-survivors 2 --output runs/2026-09-03-scorer-portfolio-v4-confirmed.json",
    "scorer:portfolio:variance": "node bin/scorer-portfolio.mjs --experiment-id research-experiment:declared-concept-equivalence-variance-v1 --confirmation-split even --screening-repetitions 3 --full-repetitions 10 --full-replications 10 --confirmation-repetitions 10 --confirmation-replications 10 --max-survivors 2 --warmup-samples 500 --timing-order alternating --output runs/2026-09-04-scorer-portfolio-variance-v1.json"
  }
}
