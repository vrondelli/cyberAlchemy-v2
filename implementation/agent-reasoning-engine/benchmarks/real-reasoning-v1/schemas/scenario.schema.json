{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.real-reasoning-scenario/v1",
  "type": "object",
  "required": ["schema_version", "scenario_id", "request"],
  "properties": {
    "schema_version": {"const": "are.benchmark-scenario/v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "request": {"type": "string", "minLength": 1},
    "objective_kind": {"type": ["string", "null"]},
    "expected_kind": {"enum": ["direct", "gate", "block", "complete", "no-match"]},
    "expected_route": {"type": ["string", "null"]},
    "required_definition_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_context_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "benchmark_kind": {"enum": ["route-continuation"]},
    "completion": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "objective_frontier": {
      "type": "object",
      "required": ["state", "evidence_refs"],
      "properties": {
        "state": {"enum": ["complete", "runnable", "choice-required", "decision-required", "input-required", "blocked"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "provider": {"type": "object"},
    "expected": {
      "type": "object",
      "required": ["continuation_needed", "directive_kind", "selected_proposal_id", "reason_code"],
      "properties": {
        "continuation_needed": {"type": "boolean"},
        "directive_kind": {"enum": ["direct", "gate", "block", "complete"]},
        "selected_proposal_id": {"type": ["string", "null"]},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "error_class": {"enum": ["none", "premature-stop", "over-continuation"]}
  },
  "additionalProperties": true
}
