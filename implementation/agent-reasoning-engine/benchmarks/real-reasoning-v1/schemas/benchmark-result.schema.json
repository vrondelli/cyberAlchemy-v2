{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.real-reasoning-benchmark-result/v1",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "mode", "status", "environment", "summary", "authority_effect"],
  "properties": {
    "schema_version": {"const": "are.real-reasoning-benchmark-result/v1"},
    "benchmark_id": {"type": "string"},
    "mode": {"enum": ["core", "intent", "integration", "continuation-routing", "compaction-simulated", "compaction-live", "compaction-auto-live", "adaptive-reuse", "adaptive-reuse-holdout", "live", "live-multiturn", "external-retrieval", "external-retrieval-run", "all"]},
    "status": {"enum": ["PASS", "FAIL", "NOT_EVALUATED"]},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": true
}
