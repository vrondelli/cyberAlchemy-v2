{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.reasoning-improvement-iteration/v1",
  "type": "object",
  "required": ["schema_version", "iteration_id", "mode", "status", "target_id", "authority_effect"],
  "properties": {
    "schema_version": {"const": "are.reasoning-improvement-iteration/v1"},
    "iteration_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["diagnose", "iterate", "verify-candidate", "loop", "evolution-cycle"]},
    "status": {"enum": ["DIAGNOSED", "READY_FOR_CHANGE", "KEEP", "REJECT", "STABLE", "BLOCKED", "NO_TARGET", "RECOMMEND", "ACTIVATE"]},
    "target_id": {"type": ["string", "null"]},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": true
}
