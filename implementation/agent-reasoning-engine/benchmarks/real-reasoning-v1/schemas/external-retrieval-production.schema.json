{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.external-retrieval-production/v1",
  "type": "object",
  "required": ["schema_version", "producer", "dataset_id", "dataset_revision", "dataset_sha256", "corpus_manifest", "corpus_manifest_sha256", "selected_snapshot_count", "selected_dependencies_sha256", "predictions_sha256", "samples", "retrieved", "abstained", "tokenizer", "gold_access", "authority_effect"],
  "properties": {
    "schema_version": {"const": "are.external-retrieval-production/v1"},
    "producer": {"const": "are-hybrid-lexical-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_revision": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_manifest": {"type": "string", "minLength": 1},
    "corpus_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_snapshot_count": {"type": "integer", "minimum": 0},
    "selected_dependencies_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predictions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "samples": {"type": "integer", "minimum": 0},
    "retrieved": {"type": "integer", "minimum": 0},
    "abstained": {"type": "integer", "minimum": 0},
    "tokenizer": {"const": "regex_code_tokenizer_v1"},
    "gold_access": {"const": "forbidden-and-unused"},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
