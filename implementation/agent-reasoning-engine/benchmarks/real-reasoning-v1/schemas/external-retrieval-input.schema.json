{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.external-retrieval-prediction/v1",
  "type": "object",
  "required": ["schema_version", "sample_id", "repo", "base_commit", "decision", "ranked_files"],
  "properties": {
    "schema_version": {"const": "are.external-retrieval-prediction/v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 1},
    "decision": {"enum": ["retrieve", "abstain"]},
    "ranked_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "header_tokens", "content_tokens"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "header_tokens": {"type": "integer", "minimum": 0},
          "content_tokens": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
