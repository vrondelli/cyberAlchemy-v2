{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "are.coding-agent-tool-result/v1"
    },
    "ok": {
      "const": true
    },
    "tool_name": {
      "const": "read-file"
    },
    "arguments": {
      "type": "object"
    },
    "output": {
      "type": "object"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "effect_calls": {
      "type": "integer",
      "const": 0
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "required": [
    "schema_version",
    "ok",
    "tool_name",
    "arguments",
    "output",
    "output_sha256",
    "output_bytes",
    "effect_calls",
    "authority_effect"
  ],
  "additionalProperties": false
}
