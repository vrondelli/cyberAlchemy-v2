[
  {
    "id": "ascii",
    "export_name": "sliceInspection",
    "args": [
      "abcdef",
      1,
      3
    ],
    "expected": {
      "ok": true,
      "value": {
        "offset_unit": "utf16-code-units",
        "offset": 1,
        "next_offset": 4,
        "total_chars": 6,
        "eof": false,
        "utf8": "bcd"
      }
    }
  },
  {
    "id": "end-boundary",
    "export_name": "sliceInspection",
    "args": [
      "A😀B",
      0,
      2
    ],
    "expected": {
      "ok": true,
      "value": {
        "offset_unit": "utf16-code-units",
        "offset": 0,
        "next_offset": 1,
        "total_chars": 4,
        "eof": false,
        "utf8": "A"
      }
    }
  },
  {
    "id": "start-boundary",
    "export_name": "sliceInspection",
    "args": [
      "A😀B",
      2,
      1
    ],
    "expected": {
      "ok": false,
      "error": "inspection-range-splits-unicode"
    }
  },
  {
    "id": "no-progress",
    "export_name": "sliceInspection",
    "args": [
      "😀",
      0,
      1
    ],
    "expected": {
      "ok": false,
      "error": "inspection-range-splits-unicode"
    }
  },
  {
    "id": "whole-pair",
    "export_name": "sliceInspection",
    "args": [
      "😀",
      0,
      2
    ],
    "expected": {
      "ok": true,
      "value": {
        "offset_unit": "utf16-code-units",
        "offset": 0,
        "next_offset": 2,
        "total_chars": 2,
        "eof": true,
        "utf8": "😀"
      }
    }
  },
  {
    "id": "eof",
    "export_name": "sliceInspection",
    "args": [
      "abc",
      3,
      5
    ],
    "expected": {
      "ok": true,
      "value": {
        "offset_unit": "utf16-code-units",
        "offset": 3,
        "next_offset": 3,
        "total_chars": 3,
        "eof": true,
        "utf8": ""
      }
    }
  },
  {
    "id": "outside",
    "export_name": "sliceInspection",
    "args": [
      "abc",
      4,
      1
    ],
    "expected": {
      "ok": false,
      "error": "inspection-range-invalid"
    }
  },
  {
    "id": "zero-width",
    "export_name": "sliceInspection",
    "args": [
      "abc",
      0,
      0
    ],
    "expected": {
      "ok": false,
      "error": "inspection-range-invalid"
    }
  }
]
