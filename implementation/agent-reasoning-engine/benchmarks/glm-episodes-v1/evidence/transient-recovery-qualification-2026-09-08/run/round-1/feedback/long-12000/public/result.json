    "changes": [
      {
        "expected_file_sha256": "de2128bc2465bf97f4745d8d604263b505d904352ee283837647a2be77de2276",
        "operation": "replace-file",
        "path": "src/subject.mjs",
        "utf8": "import {createHash} from 'node:crypto';\nconst stable = value => JSON.stringify(value, (_, item) => item && typeof item === 'object' && !Array.isArray(item) ? Object.fromEntries(Object.keys(item).sort().map(key => [key,item[key]])) : item);\nconst hash = value => createHash('sha256').update(typeof value === 'string' ? value : stable(value)).digest('hex');\nconst need = (condition, code) => { if (!condition) throw new Error(code); };\nexport function projectObservations(history, history_ref, recentCount) {\n  need(Array.isArray(history) && history.length <= 12 && /^[a-f0-9]{64}$/.test(history_ref), 'retention-history-invalid');\n  need(Number.isInteger(recentCount) && recentCount >= 0\n    && (history.length === 0 ? true : recentCount <= history.length), 'retention-window-invalid');\n  if (history.length === 0) return [];\n  const keepFrom = history.length - recentCount;\n  return history.map((entry, step) => {\n    const messages = entry.messages;\n    const calls = messages?.[0]?.tool_calls;\n    need(Array.isArray(calls) && calls.length > 0 && messages[0].role === 'assistant'\n      && messages.length === calls.length + 1, 'retention-tool-pair-invalid');\n    const ids = calls.map(call => call.id);\n    need(ids.every(id => typeof id === 'string' && id.length > 0) && ids.length > 0\n      && new Set(ids).size === ids.length, 'retention-tool-pair-invalid');\n    for (const [index, message] of messages.slice(1).entries()) {\n      need(message.role === 'tool' && message.tool_call_id === ids[index] && typeof message.content === 'string',\n        'retention-tool-pair-invalid');\n    }\n    if (step >= keepFrom) return entry;\n    return {...entry, messages: [messages[0], ...messages.slice(1).map(message => ({...message,\n      content: stable({are_observation_masked: true, original_content_sha256: hash(message.content),\n        history_ref, history_step: step + 1, tool_call_id: message.tool_call_id,\n        recovery: 'Original result is available through read-context-evidence.'})}))]};\n  });\n}\n"
      }
    ],
    "expected_base_tree_sha256": "e859c0f16501402f4976e177db9321e3c1e2d2b0a1b984bc8f6509e60c1f7e1e",
    "rationale": "Fixes pair-0/pair-4 by rejecting duplicate assistant tool_call IDs (unique-ID requirement), since positional pairing alone cannot distinguish cases where both calls and both results share one ID. Fixes empty-history by allowing an empty history with a non-negative recentCount and returning [] directly, instead of failing the recentCount <= history.length check for recentCount=1. All other behavior, masking, and export preserved.",
    "schema_version": "are.patch-set-candidate/v1"
  },
