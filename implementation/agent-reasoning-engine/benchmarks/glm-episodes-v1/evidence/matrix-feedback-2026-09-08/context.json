ate, and claim ceiling for one reasoning run.","node_id":"agent-reasoning-engine.ContextEnvelope","node_type":"Entity"},"context_item_id":"ontology-node:agent-reasoning-engine.ContextEnvelope","item_digest":"1c36b2492e0433ead48343d6005eb42f860dec445da677346839d53d18839718","item_kind":"ontology-node","mandatory":true,"relevance_basis":"required-edge-endpoint","schema_version":"are.context-item/v1","source_digest":"6e9ddc6351fb382a1b4c38c3ed010022b1dbff069249d0b4972221e93df44795","source_ref":"ontology#node:agent-reasoning-engine.ContextEnvelope","temporal_scope":"source-epoch","transform_refs":["lock/v1"]},{"authority_effect":"none","authority_posture":"basis-posture","content":{"intent":"Preserve one candidate context unit with relevance, provenance, authority, temporal, transformation, and digest metadata.","node_id":"agent-reasoning-engine.ContextItem","node_type":"Entity"},"context_item_id":"ontology-node:agent-reasoning-engine.ContextItem","item_digest":"552a02024588f804b1c349de1a821a676a9509932ed61c803b4f2be571faab93","item_kind":"ontology-node","mandatory":true,"relevance_basis":"required-edge-endpoint","schema_version":"are.context-item/v1","source_digest":"9384f7958586fda9138e8dbb5c43340e3046e9d4ea0c11c7152ebedd81e75044","source_ref":"ontology#node:agent-reasoning-engine.ContextItem","temporal_scope":"source-epoch","transform_refs":["lock/v1"]},{"authority_effect":"none","authority_posture":"basis-posture","content":{"intent":"Automatically assess and execute one configured fail-closed reasoning-state evolution as reuse, successor, branch, or non-destructive reduced successor.","node_id":"agent-reasoning-engine.CoordinateReasoningStateTransition","node_type":"Operation"},"context_item_id":"ontology-node:agent-reasoning-engine.CoordinateReasoningStateTransition","item_digest":"a20acd5b472ba07380190d2755c717007e1dffef984b4108a124d500e373f18b","item_kind":"ontology-node","mandatory":true,"relevance_basis":"required-edge-endpoint","schema_version":"are.context-