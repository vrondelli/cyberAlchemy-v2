{
  "schema_version": "are.single-chat-ontology-scaffold/v1",
  "status": "prototype-scaffold",
  "nodes": [
    {"id": "Human", "role": "product-actor"},
    {"id": "SingleChat", "role": "interaction-surface"},
    {"id": "Conversation", "role": "reasoning-runtime-state"},
    {"id": "Turn", "role": "interaction-unit"},
    {"id": "ConversationEvent", "role": "runtime-output"},
    {"id": "InteractionAdapter", "role": "presentation-adapter"},
    {"id": "HumanDecisionGate", "role": "consequence-boundary"},
    {"id": "UsabilityObservation", "role": "product-evidence"},
    {"id": "FailureClassification", "role": "evidence-routing"},
    {"id": "EngineImprovementHandoff", "role": "improvement-input"},
    {"id": "EvolutionRuntime", "role": "research-learning-runtime"}
  ],
  "relations": [
    {"from": "Human", "edge": "interacts_through", "to": "SingleChat"},
    {"from": "SingleChat", "edge": "projects", "to": "Conversation"},
    {"from": "Conversation", "edge": "contains", "to": "Turn"},
    {"from": "Turn", "edge": "emits", "to": "ConversationEvent"},
    {"from": "ConversationEvent", "edge": "rendered_by", "to": "InteractionAdapter"},
    {"from": "Conversation", "edge": "may_require", "to": "HumanDecisionGate"},
    {"from": "SingleChat", "edge": "observed_as", "to": "UsabilityObservation"},
    {"from": "UsabilityObservation", "edge": "classified_by", "to": "FailureClassification"},
    {"from": "FailureClassification", "edge": "may_create", "to": "EngineImprovementHandoff"},
    {"from": "EngineImprovementHandoff", "edge": "hands_off_to", "to": "EvolutionRuntime"}
  ],
  "invariants": [
    "The interaction adapter does not own intent, route, reasoning, continuation, or decision eligibility.",
    "Only a verified reasoning-engine failure may create an Engine Improvement Handoff.",
    "A handoff grants no implementation, adoption, activation, publication, deployment, or effect authority."
  ],
  "authority_effect": "none"
}

