{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARE Companion",
  "version": "0.1.0",
  "identifier": "dev.cyberalchemy.are.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "orb",
        "create": false,
        "title": "ARE Companion",
        "url": "orb.html",
        "width": 84,
        "height": 84,
        "minWidth": 84,
        "minHeight": 84,
        "maxWidth": 84,
        "maxHeight": 84,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": { "active": false }
}
