FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates file python3 pkgconf \
      libgtk-3-dev libwebkit2gtk-4.1-dev libdbus-1-dev \
      libayatana-appindicator3-dev libxdo-dev libssl-dev librsvg2-dev \
      libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/vlad_/projects/cyberAlchemy-v2
