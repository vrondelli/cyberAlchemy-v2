{
  "schemas": {
    "RouteAvailabilityFacts": {
      "registry_declared": {
        "type": "boolean"
      },
      "lifecycle_available": {
        "type": "boolean"
      },
      "capability_required": {
        "type": "boolean"
      },
      "capability_available": {
        "type": "boolean"
      },
      "route_identity_matches": {
        "type": "boolean"
      }
    },
    "RouteAvailabilityDecision": {
      "status": {
        "type": "string",
        "pattern": "^(available|unavailable)$"
      },
      "repair_focus": {
        "type": "string",
        "pattern": "^(registry|lifecycle|module-capability|route-identity|none)$"
      },
      "authority_effect": {
        "type": "string",
        "const": "none"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "RouteAvailability",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/are/route-availability",
    "input": "RouteAvailabilityFacts",
    "output": "RouteAvailabilityDecision",
    "authEnv": "ARE_RUNTIME_TOKEN",
    "maxBytes": 8192,
    "timeout": 1000,
    "errorStatus": 422,
    "statuses": {
      "unavailable": 409,
      "available": 200
    },
    "errors": {},
    "result": "EvaluateRouteAvailability"
  }
}
