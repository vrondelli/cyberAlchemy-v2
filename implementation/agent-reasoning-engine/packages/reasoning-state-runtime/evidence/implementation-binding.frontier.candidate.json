    {"obligation_id": "ARE-CTF-OBL-006", "meaning": "Use at-most-once recovery posture when successor delivery acknowledgement is unavailable; never silently retry an uncertain successor."},
    {"obligation_id": "ARE-CTF-OBL-007", "meaning": "Keep frontier state, replay, and diagnostics non-authorizing with authority_effect none."}
