  "objective": "Exact-bind the selected model, plan, runtime, Codex startup integration, profile, and test bytes for the bounded Reasoning-State Recovery and Disposable Index Rebuilding candidate vertical.",
  "recovery_obligations": [
    {
      "obligation_id": "ARE-RSR-OBL-001",
      "meaning": "Verify the complete append-only source as UTF-8 canonical JSONL with known record shapes and exact digests before recovery."
    },
    {
      "obligation_id": "ARE-RSR-OBL-002",
      "meaning": "Rebuild deterministic disposable event, epoch, checkpoint, and head indexes only from verified canonical records."
    },
    {
      "obligation_id": "ARE-RSR-OBL-003",
      "meaning": "Require every non-empty recoverable stream to end at a complete valid checkpoint."
    },
    {
      "obligation_id": "ARE-RSR-OBL-004",
      "meaning": "Recheck the exact source digest after opening the append sink and before hydration."
    },
    {
      "obligation_id": "ARE-RSR-OBL-005",
      "meaning": "Preserve exact recovered replay identities and continue the event sequence and predecessor chain on the next append."
    },
    {
      "obligation_id": "ARE-RSR-OBL-006",
      "meaning": "Never repair, truncate, rewrite, replace, or silently skip source bytes on any recovery failure."
    },
    {
      "obligation_id": "ARE-RSR-OBL-007",
      "meaning": "Complete file-backed Codex wrapper recovery before accepting or forwarding the first turn."
    },
    {
      "obligation_id": "ARE-RSR-OBL-008",
      "meaning": "Perform recovery and derived-index rebuilding with zero model, provider, network, evaluator, effect, or authority-owner calls."
    },
    {
      "obligation_id": "ARE-RSR-OBL-009",
      "meaning": "Keep recovery, indexes, assessments, replay, and wrapper startup non-authorizing with authority_effect none."
    }
  ],
