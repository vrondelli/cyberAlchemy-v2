{
  "schema_version": "are.evolution-receipt-manifest/v1",
  "manifest_ref": "receipts:longitudinal-automation-v1",
  "required_receipt_classes": [
    "phase-admission",
    "work-lease",
    "work-settlement",
    "handoff-offer",
    "handoff-acceptance",
    "shadow-decision",
    "canary-action",
    "recovery-decision",
    "independent-evaluation",
    "cycle-settlement"
  ],
  "storage": {
    "model": "append-only-content-addressed",
    "hot": ["active-state", "recent-evidence", "revocations", "current-projections"],
    "warm": ["compressed-events", "evaluation-receipts"],
    "cold": ["deduplicated-distant-cycle-evidence"],
    "always_hot": ["manifests", "digests", "settlements", "revocations"],
    "deletable": ["reconstructible-caches", "duplicate-payloads"]
  },
  "reconstruction_requirement": "Current projections must rebuild from immutable events and content-addressed objects.",
  "authority_effect": "none",
  "open_questions_ref": "OPEN-QUESTIONS.md"
}
