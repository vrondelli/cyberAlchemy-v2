{
  "schema_version": "are.longitudinal-automation-dataset-manifest/v1",
  "manifest_ref": "dataset:longitudinal-automation-v1",
  "cohorts": [
    {
      "cohort_ref": "cohort:fixed-replay-48",
      "minimum_episodes": 48,
      "mode": "offline-replay",
      "families": [
        "same-thread-recurrence",
        "split-thread-continuation",
        "objective-cycle-transition",
        "preference-exception",
        "preference-revision-revocation",
        "environment-restart",
        "temporal-drift",
        "language-ordering-style"
      ]
    },
    {
      "cohort_ref": "cohort:prospective-20",
      "minimum_episodes": 20,
      "mode": "shadow-then-bounded-canary",
      "families": [
        "dag-workflow",
        "iterative-workflow",
        "reactive-workflow",
        "interactive-workflow",
        "open-ended-workflow",
        "restart-partial-failure"
      ]
    }
  ],
  "durable_fields": [
    "source-identity",
    "record-ordinal",
    "timestamp",
    "content-hash",
    "length",
    "language-hint",
    "correction-signal-class",
    "tool-name-count",
    "evaluator-label"
  ],
  "excluded_durable_fields": [
    "message-text",
    "reasoning-content",
    "tool-arguments",
    "tool-outputs",
    "credential-values",
    "environment-values"
  ],
  "partition_rule": "Chronological objective-grouped discovery, validation, and frozen holdout partitions.",
  "status": "specification-only-no-source-selected",
  "authority_effect": "none",
  "open_questions_ref": "OPEN-QUESTIONS.md"
}
