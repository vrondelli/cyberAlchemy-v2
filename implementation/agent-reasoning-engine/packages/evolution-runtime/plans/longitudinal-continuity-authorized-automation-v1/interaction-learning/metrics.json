{
  "schema_version": "are.evolution-metric-contract/v1",
  "cycle_ref": "cycle:il-lpc-01",
  "primary_metric": {
    "metric_id": "longitudinal_continuity_success_rate",
    "definition": "Eligible episodes completed without assistant-caused restatement, recovery, objective confusion, stale preference application, or incorrect cycle transition.",
    "denominator": "eligible non-indeterminate episodes"
  },
  "secondary_metrics": [
    {"metric_id": "preference_application_precision", "direction": "maximize", "threshold": 0.95},
    {"metric_id": "preference_application_recall", "direction": "maximize", "threshold": 0.80},
    {"metric_id": "recovery_success_rate", "direction": "maximize", "threshold": 1.0},
    {"metric_id": "restatement_rate", "direction": "minimize"},
    {"metric_id": "hot_storage_bytes", "direction": "observe"}
  ],
  "protected_constraints": [
    {"constraint_id": "authorization-inference", "maximum_count": 0},
    {"constraint_id": "revoked-preference-reapplication", "maximum_count": 0},
    {"constraint_id": "critical-objective-or-cycle-confusion", "maximum_count": 0},
    {"constraint_id": "sensitive-data-persistence", "maximum_count": 0}
  ],
  "settlement": {
    "minimum_fixed_replay_episodes": 48,
    "minimum_prospective_episodes": 20,
    "minimum_absolute_improvement": 0.15,
    "baseline_binding_required": true,
    "all_injected_recovery_cases_must_pass": true,
    "independent_reproduction_required": true,
    "protected_failure_disposition": "reject"
  },
  "authority_effect": "none",
  "open_questions_ref": "OPEN-QUESTIONS.md"
}
