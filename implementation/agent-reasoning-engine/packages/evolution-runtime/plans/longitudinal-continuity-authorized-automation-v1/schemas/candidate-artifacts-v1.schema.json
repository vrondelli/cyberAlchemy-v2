{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/are/evolution-runtime/longitudinal-continuity-authorized-automation-candidate-v1.schema.json",
  "$comment": "Open questions are owned by ../OPEN-QUESTIONS.md.",
  "title": "Longitudinal continuity and authorized automation candidate artifacts",
  "oneOf": [
    {"$ref": "#/$defs/cycleCandidate"},
    {"$ref": "#/$defs/hypothesisRegistry"},
    {"$ref": "#/$defs/metricContract"}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {"ref": {"$ref": "#/$defs/identifier"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "cycleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "cycle_ref", "cycle_kind", "runtime_definition", "objective", "policy", "work_plan", "hypotheses", "metrics", "status", "authority_effect", "open_questions_ref"],
      "properties": {
        "schema_version": {"const": "are.evolution-cycle-candidate-plan/v1"},
        "cycle_ref": {"$ref": "#/$defs/identifier"},
        "cycle_kind": {"enum": ["interaction-learning", "engine-improvement"]},
        "runtime_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition_ref", "definition_digest", "admitted", "enabled"],
          "properties": {
            "definition_ref": {"$ref": "#/$defs/identifier"},
            "definition_digest": {"$ref": "#/$defs/sha256"},
            "admitted": {"const": false},
            "enabled": {"const": false}
          }
        },
        "objective": {"type": "object"},
        "policy": {"$ref": "#/$defs/binding"},
        "work_plan": {"$ref": "#/$defs/binding"},
        "hypotheses": {"$ref": "#/$defs/binding"},
        "metrics": {"$ref": "#/$defs/binding"},
        "handoff_dependency": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
        "status": {"const": "candidate-not-runnable"},
        "authority_effect": {"const": "none"},
        "open_questions_ref": {"$ref": "#/$defs/identifier"}
      }
    },
    "hypothesisRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "cycle_ref", "selection_policy", "hypotheses", "authority_effect", "open_questions_ref"],
      "properties": {
        "schema_version": {"const": "are.evolution-hypothesis-registry/v1"},
        "cycle_ref": {"$ref": "#/$defs/identifier"},
        "selection_policy": {"type": "object"},
        "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "authority_effect": {"const": "none"},
        "open_questions_ref": {"$ref": "#/$defs/identifier"}
      }
    },
    "metricContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "cycle_ref", "primary_metric", "secondary_metrics", "protected_constraints", "settlement", "authority_effect", "open_questions_ref"],
      "properties": {
        "schema_version": {"const": "are.evolution-metric-contract/v1"},
        "cycle_ref": {"$ref": "#/$defs/identifier"},
        "primary_metric": {"type": "object"},
        "secondary_metrics": {"type": "array", "items": {"type": "object"}},
        "protected_constraints": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "settlement": {"type": "object"},
        "authority_effect": {"const": "none"},
        "open_questions_ref": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
