{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/are/evolution-runtime/cycle-definition-v1.schema.json",
  "title": "ARE evolution cycle definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition_ref", "definition_digest", "cycle_kind", "version", "predecessor", "compatibility", "command_types", "event_types", "derived_dispositions", "policy_extension", "validator_bindings", "admission", "authority_effect"],
  "properties": {
    "schema_version": {"const": "are.evolution-cycle-definition/v1"},
    "definition_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$"},
    "definition_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cycle_kind": {"enum": ["benchmark-research", "research-learning", "engine-improvement", "interaction-learning", "controlled-upgrade"]},
    "version": {"type": "integer", "minimum": 1},
    "predecessor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition_ref", "definition_digest"],
          "properties": {
            "definition_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/v[1-9][0-9]*$"},
            "definition_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "minimum_runtime_protocol"],
      "properties": {
        "mode": {"enum": ["initial", "additive-successor", "breaking-successor"]},
        "minimum_runtime_protocol": {"const": "are.evolution-protocol/v1"}
      }
    },
    "command_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}},
    "event_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "derived_dispositions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "policy_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_kind", "schema_ref", "schema_digest"],
      "properties": {
        "policy_kind": {"enum": ["benchmark-objective", "research-answerability", "engine-comparison", "interaction-learning", "controlled-upgrade"]},
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "validator_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validator_ref", "version", "roles", "implementation_digest"],
        "properties": {
          "validator_ref": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "implementation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "admitted", "enabled", "user_decision_ref"],
      "properties": {
        "status": {"const": "candidate"},
        "admitted": {"const": false},
        "enabled": {"const": false},
        "user_decision_ref": {"type": "null"}
      }
    },
    "authority_effect": {"const": "none"}
  }
}
