{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.hen-hint-compression-v1",
  "title": "ARE H-EN compact hint payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "field_order", "policy", "accounting", "records", "claim_ceiling", "authority_effect"],
  "properties": {
    "schema_version": {"const": "are.hen-compressed-hints/v1"},
    "field_order": {
      "const": ["repository_relative_path", "start_line_inclusive", "end_line_inclusive", "content_sha256", "score_units", "facet"]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "maximum_payload_bytes", "maximum_records", "maximum_records_per_path"],
      "properties": {
        "policy_id": {"const": "hen-balanced-facet-round-robin/v1"},
        "maximum_payload_bytes": {"const": 4096},
        "maximum_records": {"const": 16},
        "maximum_records_per_path": {"const": 4}
      }
    },
    "accounting": {"type": "object"},
    "records": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "integer", "minimum": 0}, {"type": "string"}], "items": false, "minItems": 6, "maxItems": 6}
    },
    "claim_ceiling": {"type": "string"},
    "authority_effect": {"const": "none"}
  }
}
