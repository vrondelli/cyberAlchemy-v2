{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.benchmark-research-v1",
  "title": "ARE benchmark-research legacy import and projection",
  "$defs": {
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length", "media_type", "role", "chronology_posture", "exposure_posture", "accounting_posture"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "chronology_posture": {"type": "string", "minLength": 1},
        "exposure_posture": {"type": "string", "minLength": 1},
        "accounting_posture": {"type": "string", "minLength": 1}
      }
    },
    "importManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_id", "manifest_digest", "cycle_ref", "cycle_definition_ref", "objective", "hypothesis", "candidate", "next_work", "source_artifacts", "excluded_scopes", "missing_evidence", "import_posture", "authority_effect"],
      "properties": {
        "schema_version": {"const": "are.benchmark-research-legacy-import/v1"},
        "manifest_id": {"type": "string", "minLength": 1},
        "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cycle_ref": {"type": "string", "minLength": 1},
        "cycle_definition_ref": {"const": "benchmark-research/v1"},
        "objective": {"type": "object"},
        "hypothesis": {"type": "object"},
        "candidate": {"type": "object"},
        "next_work": {"type": "object"},
        "source_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceArtifact"}},
        "excluded_scopes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "import_posture": {"const": "retrospective"},
        "authority_effect": {"const": "none"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "cycle_ref", "manifest_ref", "manifest_digest", "objective", "hypotheses", "candidates", "qualifications", "ready_work", "artifact_bindings", "import_receipt", "claim_ceiling", "authority_effect", "projection_digest"],
      "properties": {
        "schema_version": {"const": "are.benchmark-research-projection/v1"},
        "cycle_ref": {"type": "string"},
        "manifest_ref": {"type": "string"},
        "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "objective": {"type": "object"},
        "hypotheses": {"type": "array"},
        "candidates": {"type": "array"},
        "qualifications": {"type": "array"},
        "ready_work": {"type": "array"},
        "artifact_bindings": {"type": "array"},
        "import_receipt": {"type": "object"},
        "claim_ceiling": {"type": "string"},
        "authority_effect": {"const": "none"},
        "projection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
