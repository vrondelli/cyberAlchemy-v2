{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.hen-candidate-view-v1",
  "title": "ARE H-EN candidate view",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_ref", "task_ref", "source", "accounting", "hint_payload", "claim_ceiling", "authority_effect", "view_digest"],
  "properties": {
    "schema_version": {"const": "are.hen-candidate-view/v1"},
    "candidate_ref": {"const": "candidate:H-EN-R2-compressed-v1"},
    "task_ref": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "accounting": {"type": "object"},
    "hint_payload": {"type": "object"},
    "claim_ceiling": {"type": "string"},
    "authority_effect": {"const": "none"},
    "view_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
