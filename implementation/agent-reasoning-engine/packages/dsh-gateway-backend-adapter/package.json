{
  "name": "@cyberalchemy/are-dsh-gateway-backend-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only DeepSeek Harness backend adapter for the ARE app-server gateway.",
  "bin": {
    "are-dsh-app-server": "bin/are-dsh-app-server.mjs",
    "are-dsh-web-host": "bin/are-dsh-web-host.mjs"
  },
  "exports": "./index.mjs",
  "scripts": {
    "patch:dsh": "node scripts/apply-private-dsh-session-patch.mjs",
    "verify:dsh-patch": "node scripts/apply-private-dsh-session-patch.mjs --check",
    "pretest": "node scripts/apply-private-dsh-session-patch.mjs --check",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "precanary": "node scripts/apply-private-dsh-session-patch.mjs --check",
    "canary": "node scripts/canary.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2"
  },
  "engines": {
    "node": ">=22"
  }
}
