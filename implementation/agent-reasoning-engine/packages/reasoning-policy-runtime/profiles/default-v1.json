{
  "schema_version": "are.reasoning-policy-profile/v1",
  "profile_id": "are.reasoning-policy.default-v1",
  "maximum_event_count": 64,
  "mandatory_event_kinds": [
    "context-projected",
    "counterevidence-recorded",
    "reasoning-state-reduced",
    "semantic-evaluation-completed",
    "session-eviction-prepared",
    "turn-completion-frontier-sealed"
  ],
  "interaction_bound_action": "create-successor",
  "selected_dependency_drift_action": "create-successor",
  "exploration_action": "create-branch",
  "overflow_action": "reduce-successor",
  "stable_plan_action": "reuse-current",
  "reduction": {
    "method": "deterministic-event-selection-no-summary",
    "retain_latest_nonmandatory": true,
    "mandatory_overflow": "block"
  },
  "claim_ceiling": "Deterministic reasoning-state transition selection only; no correctness, authority, continuation, or effect claim.",
  "authority_effect": "none"
}
