{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.next-action-candidate/v1",
  "title": "ARE Next Action Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "path", "expected_base_tree_sha256", "expected_file_sha256", "utf8", "authority_effect"],
  "properties": {
    "schema_version": {"const": "are.next-action-candidate/v1"},
    "operation": {"const": "replace-file"},
    "path": {"type": "string", "minLength": 1},
    "expected_base_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utf8": {"type": "string"},
    "rationale": {"type": "string"},
    "authority_effect": {"const": "none"}
  }
}
