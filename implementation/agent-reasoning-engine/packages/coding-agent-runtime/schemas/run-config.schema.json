{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.coding-agent-run-config/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "observation_allowlist", "mutation_allowlist", "verification_command"],
  "properties": {
    "schema_version": {"const": "are.coding-agent-run-config/v1"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "base_url", "model"],
      "properties": {
        "transport": {"const": "openai-compatible"},
        "base_url": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "credential": {
          "oneOf": [
            {"$ref": "#/$defs/environmentCredential"},
            {"$ref": "#/$defs/localCredential"},
            {"$ref": "#/$defs/injectedCredential"}
          ]
        }
      }
    },
    "observation_allowlist": {"$ref": "#/$defs/nonEmptyStrings"},
    "mutation_allowlist": {"$ref": "#/$defs/nonEmptyStrings"},
    "verification_command": {"$ref": "#/$defs/nonEmptyStrings"},
    "max_context_bytes": {"type": "integer", "minimum": 1},
    "capability_awareness": {"$ref": "#/$defs/capabilityAwareness"}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "capabilityAwareness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "catalog_version", "owner_ref", "revision", "capabilities"],
      "properties": {
        "catalog_id": {"type": "string", "minLength": 1},
        "catalog_version": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "max_context_bytes": {"type": "integer", "minimum": 1},
        "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capabilityEntry"}}
      }
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "route_id", "label", "owner_ref"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "route_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "owner_ref": {"type": "string", "minLength": 1},
        "intent_kind": {"type": "string", "minLength": 1},
        "request_terms": {"$ref": "#/$defs/nonEmptyStrings"},
        "required_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dominates": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_effects": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "credentialBase": {
      "type": "object",
      "required": ["provider_kind", "provider_id", "locator"]
    },
    "environmentCredential": {
      "allOf": [
        {"$ref": "#/$defs/credentialBase"},
        {
          "additionalProperties": false,
          "properties": {
            "provider_kind": {"const": "environment"},
            "provider_id": {"type": "string", "minLength": 1},
            "locator": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,126}$"}
          }
        }
      ]
    },
    "injectedCredential": {
      "allOf": [
        {"$ref": "#/$defs/credentialBase"},
        {
          "additionalProperties": false,
          "properties": {
            "provider_kind": {"const": "injected"},
            "provider_id": {"type": "string", "minLength": 1},
            "locator": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "localCredential": {
      "allOf": [
        {"$ref": "#/$defs/credentialBase"},
        {
          "additionalProperties": false,
          "properties": {
            "provider_kind": {"const": "local-sops-age"},
            "provider_id": {"type": "string", "minLength": 1},
            "locator": {"type": "string", "minLength": 1},
            "python_command": {"type": "string", "minLength": 1},
            "project_root": {"type": "string", "minLength": 1},
            "key_file": {"type": "string", "minLength": 1},
            "vault_file": {"type": "string", "minLength": 1},
            "timeout_ms": {"type": "integer", "minimum": 1}
          }
        }
      ]
    }
  }
}
