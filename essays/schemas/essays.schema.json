{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cyberalchemy.local/private/schemas/essays/v1",
  "title":"Essays semantic package",
  "$defs":{
    "text":{"type":"string","minLength":1},
    "id":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "profile":{"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","package_id","title","package_root","product_ref","project_ref","goal_ref","product_capability_ref","whisper_ref","package_owner","product_owner","capability_owner","visibility","status","authority_effect","source_registry","definition_registry","node_registry","relation_registry","product_ontology","capability_ontology","residue_registry","schema_path","validator_path","construction_state","blocked_outputs"],"properties":{"schema_ref":{"const":"schemas/essays.schema.json#/$defs/profile"},"schema_version":{"const":"cav2-essays-profile/v1"},"package_id":{"const":"cav2.essays"},"title":{"const":"Essays"},"package_root":{"const":"cyberAlchemy-v2/essays"},"product_ref":{"const":"CA2-PRODUCT-ESSAYS"},"project_ref":{"const":"CA2-PROJECT-ESSAYS"},"goal_ref":{"const":"CA2-GOAL-ESSAYS-FIRST-RUNTIME"},"product_capability_ref":{"const":"CA2-CAP-DEVELOP-GOVERNED-ESSAY"},"whisper_ref":{"const":"CA2-REF-ARC-WHISPER"},"package_owner":{"$ref":"#/$defs/text"},"product_owner":{"$ref":"#/$defs/text"},"capability_owner":{"$ref":"#/$defs/text"},"visibility":{"const":"private"},"status":{"const":"candidate-semantic-package"},"authority_effect":{"const":"none"},"source_registry":{"const":"sources.json"},"definition_registry":{"const":"definitions.json"},"node_registry":{"const":"nodes.json"},"relation_registry":{"const":"relations.json"},"product_ontology":{"const":"product-ontology.json"},"capability_ontology":{"const":"capability-ontology.json"},"residue_registry":{"const":"residue.json"},"schema_path":{"const":"schemas/essays.schema.json"},"validator_path":{"const":"scripts/validate.py"},"construction_state":{"const":"development-system-ontology-compiled"},"blocked_outputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "source":{"type":"object","additionalProperties":false,"required":["source_id","path","observed_file_sha256","owner_route","posture"],"properties":{"source_id":{"type":"string","pattern":"^SRC-ESSAYS-"},"path":{"$ref":"#/$defs/text"},"observed_file_sha256":{"$ref":"#/$defs/sha256"},"owner_route":{"$ref":"#/$defs/text"},"posture":{"$ref":"#/$defs/text"}}},
    "selection":{"type":"object","additionalProperties":false,"required":["selection_id","source_id","selector_kind","selector","selection_sha256"],"properties":{"selection_id":{"type":"string","pattern":"^ESSAYS-SEL-"},"source_id":{"type":"string","pattern":"^SRC-ESSAYS-"},"selector_kind":{"enum":["markdown-heading","json-document"]},"selector":{"$ref":"#/$defs/text"},"selection_sha256":{"$ref":"#/$defs/sha256"}}},
    "sourceRegistry":{"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","selection_digest_algorithm","sources","selections"],"properties":{"schema_ref":{"const":"schemas/essays.schema.json#/$defs/sourceRegistry"},"schema_version":{"const":"cav2-essays-sources/v1"},"selection_digest_algorithm":{"const":"sha256-selector-bytes-or-canonical-json/v1"},"sources":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/source"}},"selections":{"type":"array","minItems":9,"items":{"$ref":"#/$defs/selection"}}}},
    "canonicalBinding":{"type":"object","additionalProperties":false,"required":["definition_ref","term","source_selection_ref","use","authority_effect"],"properties":{"definition_ref":{"enum":["CAV2-D19","CAV2-D33","CAV2-D60","CAV2-D63","CAV2-D65","CAV2-D67"]},"term":{"$ref":"#/$defs/text"},"source_selection_ref":{"type":"string","pattern":"^ESSAYS-SEL-"},"use":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
    "definitionProposal":{"type":"object","additionalProperties":false,"required":["definition_id","term","status","normative_voice","plain_language_voice","domain_context_voice","owner_route","source_refs","forbidden_collapse","authority_effect"],"properties":{"definition_id":{"type":"string","pattern":"^ESSAYS-DEF-"},"term":{"$ref":"#/$defs/text"},"status":{"const":"candidate"},"normative_voice":{"$ref":"#/$defs/text"},"plain_language_voice":{"$ref":"#/$defs/text"},"domain_context_voice":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^ESSAYS-SEL-"}},"forbidden_collapse":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
    "definitionRegistry":{"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","canonical_bindings","proposals"],"properties":{"schema_ref":{"const":"schemas/essays.schema.json#/$defs/definitionRegistry"},"schema_version":{"const":"cav2-essays-definitions/v1"},"canonical_bindings":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/canonicalBinding"}},"proposals":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/definitionProposal"}}}},
    "node":{"type":"object","additionalProperties":false,"required":["id","label","role","branch","meaning","source_refs","owner_route","status","authority_effect","forbidden_collapse"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/text"},"role":{"enum":["product","thesis","project","goal","participant","outcome","product_capability","agent_capability_candidate","artifact","residue","upstream_candidate"]},"branch":{"enum":["product","capability"]},"meaning":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^ESSAYS-SEL-"}},"owner_route":{"$ref":"#/$defs/text"},"status":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"},"forbidden_collapse":{"$ref":"#/$defs/text"}}},
    "nodeRegistry":{"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","nodes"],"properties":{"schema_ref":{"const":"schemas/essays.schema.json#/$defs/nodeRegistry"},"schema_version":{"const":"cav2-essays-nodes/v1"},"nodes":{"type":"array","minItems":10,"items":{"$ref":"#/$defs/node"}}}},
    "relation":{"type":"object","additionalProperties":false,"required":["id","type","source","target","meaning","source_refs","owner_route","authority_effect","forbidden_collapse"],"properties":{"id":{"type":"string","pattern":"^ESSAYS-REL-"},"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"meaning":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^ESSAYS-SEL-"}},"owner_route":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"},"forbidden_collapse":{"$ref":"#/$defs/text"}}},
    "relationRegistry":{"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","relations"],"properties":{"schema_ref":{"const":"schemas/essays.schema.json#/$defs/relationRegistry"},"schema_version":{"const":"cav2-essays-relations/v1"},"relations":{"type":"array","minItems":15,"items":{"$ref":"#/$defs/relation"}}}},
    "ontologyView":{"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","ontology_id","ontology_kind","question","answer","node_refs","relation_refs","claim_ceiling"],"properties":{"schema_ref":{"const":"schemas/essays.schema.json#/$defs/ontologyView"},"schema_version":{"const":"cav2-essays-ontology-view/v1"},"ontology_id":{"enum":["cav2.essays.product","cav2.essays.capability"]},"ontology_kind":{"enum":["product","capability"]},"question":{"$ref":"#/$defs/text"},"answer":{"$ref":"#/$defs/text"},"node_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"relation_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^ESSAYS-REL-"}},"claim_ceiling":{"$ref":"#/$defs/text"}}},
    "residue":{"type":"object","additionalProperties":false,"required":["residue_id","statement","impact","next_owner","status","subject_refs","authority_effect"],"properties":{"residue_id":{"type":"string","pattern":"^ESSAYS-RES-"},"statement":{"$ref":"#/$defs/text"},"impact":{"$ref":"#/$defs/text"},"next_owner":{"$ref":"#/$defs/text"},"status":{"enum":["open","blocked","deferred"]},"subject_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"authority_effect":{"const":"none"}}},
    "residueRegistry":{"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","residue","authority_effect"],"properties":{"schema_ref":{"const":"schemas/essays.schema.json#/$defs/residueRegistry"},"schema_version":{"const":"cav2-essays-residue/v1"},"residue":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/residue"}},"authority_effect":{"const":"none"}}}
  }
}
