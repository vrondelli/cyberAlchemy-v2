{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/essays/writing-capability-ontology.schema.json",
  "title": "Essays writing capability ontology package records",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "required": ["schema_version", "ontology_id", "ontology_type", "branch", "package_root", "package_owner", "visibility", "status", "authority_effect"]
    },
    "sources": {
      "type": "object",
      "required": ["schema_version", "digest_algorithm", "sources", "authority_effect"]
    },
    "nodes": {
      "type": "object",
      "required": ["schema_version", "nodes", "authority_effect"]
    },
    "relations": {
      "type": "object",
      "required": ["schema_version", "relations", "authority_effect"]
    },
    "views": {
      "type": "object",
      "required": ["schema_version", "views", "authority_effect"]
    },
    "residue": {
      "type": "object",
      "required": ["schema_version", "residue", "authority_effect"]
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "role", "branch", "meaning", "source_refs", "owner_route", "status", "authority_effect", "forbidden_collapse"],
      "properties": {
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "type", "source", "target", "meaning", "source_refs", "owner_route", "authority_effect", "forbidden_collapse"],
      "properties": {
        "authority_effect": {
          "const": "none"
        }
      }
    }
  }
}
