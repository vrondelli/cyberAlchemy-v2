{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/essays/agent-runtime-capability-records.schema.json",
  "title": "Essays agent-runtime capability dependency records",
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "text": {"type":"string","minLength":1},
    "sourceRefs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CAP-SEL-"}},
    "item": {
      "type":"object","additionalProperties":false,
      "required":["item_id","meaning","required","source_refs","absence_behavior"],
      "properties":{
        "item_id":{"type":"string","pattern":"^CAP-(IN|OUT)-"},
        "meaning":{"$ref":"#/$defs/text"},
        "required":{"type":"boolean"},
        "source_refs":{"$ref":"#/$defs/sourceRefs"},
        "absence_behavior":{"$ref":"#/$defs/text"}
      }
    },
    "capabilityContract": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","contract_id","capability_ref","direction","artifact_ref","items","readiness_point","missing_input_policy","owner_routes","source_refs","challenge_route","authority_effect","claim_limit"],
      "properties":{
        "schema_ref":{"const":"../schemas/agent-runtime-capability-records.schema.json#/$defs/capabilityContract"},
        "schema_version":{"const":"cav2.essays.agent-runtime.capability-contract/v1"},
        "contract_id":{"type":"string","pattern":"^CA2-CAP-CONTRACT-ESSAYS-"},
        "capability_ref":{"const":"CA2-CAP-ESSAYS-AGENT-RUNTIME"},
        "direction":{"enum":["input","output"]},
        "artifact_ref":{"$ref":"#/$defs/id"},
        "items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/item"}},
        "readiness_point":{"enum":["command-intake-ready","workspace-snapshot-ready","agent-proposal-recorded","browser-evidence-recorded","command-receipt-recorded"]},
        "missing_input_policy":{"enum":["block-start","block-command","record-gap-and-continue","not-applicable"]},
        "owner_routes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "source_refs":{"$ref":"#/$defs/sourceRefs"},
        "challenge_route":{"$ref":"#/$defs/text"},
        "authority_effect":{"const":"none"},
        "claim_limit":{"$ref":"#/$defs/text"}
      }
    },
    "contextRule": {
      "type":"object","additionalProperties":false,
      "required":["rule_id","statement","failure_behavior","source_refs"],
      "properties":{
        "rule_id":{"type":"string","pattern":"^CAP-CTX-RULE-ESSAYS-"},
        "statement":{"$ref":"#/$defs/text"},
        "failure_behavior":{"$ref":"#/$defs/text"},
        "source_refs":{"$ref":"#/$defs/sourceRefs"}
      }
    },
    "contextPolicy": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","policy_id","capability_ref","context_refs","intended_use","resolution_order","explicit_context_precedence","inference_controls","sufficiency_states","continuation_state","rules","owner_routes","source_refs","challenge_route","authority_effect","claim_limit"],
      "properties":{
        "schema_ref":{"const":"../schemas/agent-runtime-capability-records.schema.json#/$defs/contextPolicy"},
        "schema_version":{"const":"cav2.essays.agent-runtime.context-policy/v1"},
        "policy_id":{"const":"CA2-CAP-POLICY-ESSAYS-AGENT-RUNTIME-CONTEXT"},
        "capability_ref":{"const":"CA2-CAP-ESSAYS-AGENT-RUNTIME"},
        "context_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CA2-CONTEXT-"}},
        "intended_use":{"$ref":"#/$defs/text"},
        "resolution_order":{"const":["explicit-context","current-workspace-snapshot","saved-session-candidate"]},
        "explicit_context_precedence":{"const":true},
        "inference_controls":{"const":["provenance","confidence","conflict","correction","rejection"]},
        "sufficiency_states":{"const":["sufficient","insufficient","indeterminate"]},
        "continuation_state":{"const":"sufficient"},
        "rules":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/contextRule"}},
        "owner_routes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "source_refs":{"$ref":"#/$defs/sourceRefs"},
        "challenge_route":{"$ref":"#/$defs/text"},
        "authority_effect":{"const":"none"},
        "claim_limit":{"$ref":"#/$defs/text"}
      }
    },
    "obligation": {
      "type":"object","additionalProperties":false,
      "required":["obligation_id","statement","obligation_kind","business_meaning_refs","contract_refs","current_status","status_basis_refs","required_evidence","owner_route","claim_limit"],
      "properties":{
        "obligation_id":{"type":"string","pattern":"^CAP-OBL-ESSAYS-AR-"},
        "statement":{"$ref":"#/$defs/text"},
        "obligation_kind":{"enum":["input-coverage","output-integrity","continuity","authority","context-sufficiency","recovery","parity","isolation"]},
        "business_meaning_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "contract_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CA2-CAP-(CONTRACT|POLICY)-"}},
        "current_status":{"enum":["not-assessed","known-gap","blocked","satisfied","violated"]},
        "status_basis_refs":{"$ref":"#/$defs/sourceRefs"},
        "required_evidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "owner_route":{"$ref":"#/$defs/text"},
        "claim_limit":{"$ref":"#/$defs/text"}
      }
    },
    "obligationRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","registry_id","product_capability_ref","obligations","owner_routes","source_refs","authority_effect","claim_limit"],
      "properties":{
        "schema_ref":{"const":"../schemas/agent-runtime-capability-records.schema.json#/$defs/obligationRegistry"},
        "schema_version":{"const":"cav2.essays.agent-runtime.obligations/v1"},
        "registry_id":{"const":"CA2-CAP-OBLIGATIONS-ESSAYS-AGENT-RUNTIME"},
        "product_capability_ref":{"const":"CA2-CAP-ESSAYS-AGENT-RUNTIME"},
        "obligations":{"type":"array","minItems":20,"items":{"$ref":"#/$defs/obligation"}},
        "owner_routes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "source_refs":{"$ref":"#/$defs/sourceRefs"},
        "authority_effect":{"const":"none"},
        "claim_limit":{"$ref":"#/$defs/text"}
      }
    },
    "realizationPrecondition": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","binding_id","product_capability_ref","record_kind","selection_state","selected_realization_ref","required_predecessor_refs","required_evidence","owner_routes","realization_posture","conformance_posture","source_refs","challenge_route","authority_effect","claim_limit"],
      "properties":{
        "schema_ref":{"const":"../schemas/agent-runtime-capability-records.schema.json#/$defs/realizationPrecondition"},
        "schema_version":{"const":"cav2.essays.agent-runtime.realization-precondition/v1"},
        "binding_id":{"const":"CA2-CAP-BIND-ESSAYS-AGENT-RUNTIME-UNSELECTED"},
        "product_capability_ref":{"const":"CA2-CAP-ESSAYS-AGENT-RUNTIME"},
        "record_kind":{"const":"realization-precondition"},
        "selection_state":{"const":"unselected"},
        "selected_realization_ref":{"type":"null"},
        "required_predecessor_refs":{"type":"array","minItems":5,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "required_evidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "owner_routes":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "realization_posture":{"const":"unrealized"},
        "conformance_posture":{"const":"not-assessed"},
        "source_refs":{"$ref":"#/$defs/sourceRefs"},
        "challenge_route":{"$ref":"#/$defs/text"},
        "authority_effect":{"const":"none"},
        "claim_limit":{"$ref":"#/$defs/text"}
      }
    }
  }
}
