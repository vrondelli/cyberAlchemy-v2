{
  "schema_version": "minted-node/v1",
  "node_id": "bug-ticket-ontology-game.SpatialInvestigationWorld",
  "feature_id": "bug-ticket-ontology-game",
  "kind": "Component",
  "intent": "Project each exploration place as a navigable three-dimensional room with authored architecture, uniquely identifiable evidence machines, bounded movement, sightline, proximity interaction, physical state feedback, and doors, while delegating evidence meaning and puzzle transitions to the game hook.",
  "body": {
    "typed_inputs": "CaseViewModel",
    "typed_outputs": "SpatialPlaceInteraction",
    "independent_route": "false",
    "domain_data_authority": "false",
    "validation_authority": "false",
    "access_authority": "false",
    "interaction_model": ["guided-walk", "optional-direct-move", "look", "approach", "inspect", "cross-door"],
    "default_control_mode": "guided",
    "optional_control_mode": "immersive-pointer-lock",
    "station_contract": ["unique-visual-asset", "collision-footprint", "interaction-anchor", "look-at-height", "state-indicator"],
    "accessibility_contract": ["keyboard-target-cycle", "keyboard-activation", "touch-guided-walk", "reduced-motion", "focus-restoration", "sound-opt-in"],
    "fallback": "illustrated-phaser-place"
  },
  "connections": [
    {"edge_id":"bug-ticket-ontology-game.edge.spatial-world-consumes-hook","type":"consumes","to":"bug-ticket-ontology-game.GameHook"},
    {"edge_id":"bug-ticket-ontology-game.edge.spatial-world-displays-view-model","type":"displays","to":"bug-ticket-ontology-game.CaseViewModel"}
  ]
}
