{
  "name": "@cyberalchemy/essays-runtime",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/App.tsx",
    "./model": "./src/domain/model.ts",
    "./markdown": "./src/domain/markdown.ts",
    "./styles.css": "./src/styles.css"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:determinism": "node scripts/check-build-determinism.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "@milkdown/core": "7.21.3",
    "@milkdown/plugin-history": "7.21.3",
    "@milkdown/prose": "7.21.3",
    "@milkdown/preset-commonmark": "7.21.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
