{
  "schema_version": "minted-node/v1",
  "node_id": "essays-runtime.EssayWorkspace",
  "feature_id": "essays-runtime",
  "kind": "Entity",
  "intent": "Own one essay-making context, its accepted artifact identities, lifecycle state, and current authoritative revisions without delegating domain authority to the editor adapter.",
  "body": {
    "fields": [
      {"name":"workspace_id","type":"EssayWorkspaceId","identity":true},
      {"name":"title","type":"Text","identity":false},
      {"name":"lifecycle_stage","type":"EssayLifecycleStage","identity":false},
      {"name":"current_revision","type":"RevisionNumber","identity":false}
    ]
  },
  "connections": [
    {"edge_id":"essays-runtime.edge.workspace-owns-essay","type":"owns","to":"essays-runtime.ReviewableEssay"},
    {"edge_id":"essays-runtime.edge.workspace-owns-review","type":"owns","to":"essays-runtime.AddressableEditorialReview"},
    {"edge_id":"essays-runtime.edge.workspace-owns-residue","type":"owns","to":"essays-runtime.EditorialResidue"},
    {"edge_id":"essays-runtime.edge.workspace-contains-intent","type":"contains","to":"essays-runtime.TextIntent"},
    {"edge_id":"essays-runtime.edge.workspace-contains-plan","type":"contains","to":"essays-runtime.CompositionPlan"}
  ]
}
