{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/essays/product-ontology.schema.json",
  "title": "Essays Product Ontology package records",
  "$defs": {
    "id": {"type":"string","minLength":1},
    "sourceRef": {"type":"object","additionalProperties":false,"required":["source_id","selector"],"properties":{"source_id":{"$ref":"#/$defs/id"},"selector":{"$ref":"#/$defs/id"}}},
    "node": {"type":"object","required":["id","label","role","branch","meaning","source_refs","owner_route","status","authority_effect","forbidden_collapse"],"properties":{"authority_effect":{"const":"none"}}},
    "relation": {"type":"object","required":["id","type","source","target","meaning","source_refs","owner_route","authority_effect","forbidden_collapse"],"properties":{"authority_effect":{"const":"none"}}}
  }
}
