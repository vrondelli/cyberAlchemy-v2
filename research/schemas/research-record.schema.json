{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/research-record/v1",
  "title": "CyberAlchemy v2 Research record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_kind", "research_id", "title", "description", "project_ref", "goal_refs", "question", "scope", "exclusions", "sources", "method", "evidence_aggregate", "counterevidence", "findings_refs", "limitations", "created", "last_updated", "owner_route", "challenge_route", "claim_ceiling", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2-research-record/v1"},
    "canonical_kind": {"const": "research"},
    "research_id": {"type": "string", "pattern": "^CA2-RESEARCH-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "project_ref": {"type": "string"},
    "goal_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
    "question": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1},
    "exclusions": {"type": "array", "minItems": 1},
    "sources": {"type": "array", "minItems": 1},
    "method": {"type": "array", "minItems": 1},
    "evidence_aggregate": {"type": "array", "minItems": 1},
    "counterevidence": {"type": "array"},
    "findings_refs": {"type": "array"},
    "limitations": {"type": "array", "minItems": 1},
    "created": {"type": "string", "format": "date"},
    "last_updated": {"type": "string", "format": "date"},
    "owner_route": {"type": "string", "minLength": 1},
    "challenge_route": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  }
}
