{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/pythonconstraint/lean-reuse-audit/v1",
  "oneOf": [
    {"$ref": "#/$defs/profile"},
    {"$ref": "#/$defs/sources"},
    {"$ref": "#/$defs/ontology"},
    {"$ref": "#/$defs/inventory"},
    {"$ref": "#/$defs/matrix"},
    {"$ref": "#/$defs/importReport"},
    {"$ref": "#/$defs/attackOrder"}
  ],
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "noneAuthority": {"const": "none"},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "package_id", "task_id", "parent_research_id", "goal_ref", "status", "authority_effect", "admission", "target", "artifacts", "validation", "claim_ceiling"],
      "properties": {
        "artifact_kind": {"const": "audit_profile"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "package_id": {"$ref": "#/$defs/nonEmpty"}, "task_id": {"const": "PYC-LEAN-REUSE-AUDIT-001"}, "parent_research_id": {"$ref": "#/$defs/nonEmpty"}, "goal_ref": {"$ref": "#/$defs/nonEmpty"}, "status": {"const": "candidate"}, "authority_effect": {"$ref": "#/$defs/noneAuthority"}, "admission": {"const": "not-requested"}, "target": {"type": "object"}, "artifacts": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "validation": {"$ref": "#/$defs/nonEmpty"}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "source": {
      "type": "object", "required": ["id", "kind", "sha256", "role"],
      "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "kind": {"enum": ["local_file", "git_blob", "https_pinned_blob"]}, "path": {"type": "string"}, "url": {"type": "string"}, "repository": {"type": "string"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "sha256": {"$ref": "#/$defs/sha256"}, "role": {"$ref": "#/$defs/nonEmpty"}}
    },
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "source_set_id", "authority_effect", "sources", "claim_ceiling"],
      "properties": {"artifact_kind": {"const": "source_registry"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "source_set_id": {"$ref": "#/$defs/nonEmpty"}, "authority_effect": {"$ref": "#/$defs/noneAuthority"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}}
    },
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "meaning"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "kind": {"$ref": "#/$defs/nonEmpty"}, "meaning": {"$ref": "#/$defs/nonEmpty"}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["id", "type", "source", "target"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "type": {"$ref": "#/$defs/nonEmpty"}, "source": {"$ref": "#/$defs/nonEmpty"}, "target": {"$ref": "#/$defs/nonEmpty"}}},
    "ontology": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "ontology_id", "ontology_status", "relation_vocabulary_status", "authority_effect", "source_refs", "nodes", "relations", "residue", "claim_ceiling"],
      "properties": {"artifact_kind": {"const": "evidence_procedure_ontology"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "ontology_id": {"$ref": "#/$defs/nonEmpty"}, "ontology_status": {"const": "candidate"}, "relation_vocabulary_status": {"const": "package-local-candidate"}, "authority_effect": {"$ref": "#/$defs/noneAuthority"}, "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}, "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}}, "residue": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}}
    },
    "construct": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_ref", "symbol", "construct_kind", "reuse_mode", "import_dependency", "relevant_specs", "adaptation", "claim_ceiling"],
      "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "source_ref": {"$ref": "#/$defs/nonEmpty"}, "symbol": {"$ref": "#/$defs/nonEmpty"}, "construct_kind": {"$ref": "#/$defs/nonEmpty"}, "reuse_mode": {"$ref": "#/$defs/nonEmpty"}, "import_dependency": {"$ref": "#/$defs/nonEmpty"}, "relevant_specs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "adaptation": {"$ref": "#/$defs/nonEmpty"}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}}
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "inventory_id", "authority_effect", "constructs", "claim_ceiling"],
      "properties": {"artifact_kind": {"const": "lean_construct_inventory"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "inventory_id": {"$ref": "#/$defs/nonEmpty"}, "authority_effect": {"$ref": "#/$defs/noneAuthority"}, "constructs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/construct"}}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}}
    },
    "matrixRow": {
      "type": "object", "additionalProperties": false,
      "required": ["spec_id", "group", "semantic_obligation", "candidate_constructs", "reuse_posture", "new_lemmas", "attack_wave"],
      "properties": {"spec_id": {"$ref": "#/$defs/nonEmpty"}, "group": {"$ref": "#/$defs/nonEmpty"}, "semantic_obligation": {"$ref": "#/$defs/nonEmpty"}, "candidate_constructs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "reuse_posture": {"$ref": "#/$defs/nonEmpty"}, "new_lemmas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "attack_wave": {"$ref": "#/$defs/nonEmpty"}}
    },
    "matrix": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "matrix_id", "authority_effect", "rows", "claim_ceiling"],
      "properties": {"artifact_kind": {"const": "spec_reuse_matrix"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "matrix_id": {"$ref": "#/$defs/nonEmpty"}, "authority_effect": {"$ref": "#/$defs/noneAuthority"}, "rows": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/matrixRow"}}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}}
    },
    "classification": {"type": "object", "additionalProperties": false, "required": ["construct_id", "classification", "reason"], "properties": {"construct_id": {"$ref": "#/$defs/nonEmpty"}, "classification": {"enum": ["requires-adaptation", "diagnostic-only", "method-reusable", "directly-importable"]}, "reason": {"$ref": "#/$defs/nonEmpty"}}},
    "importReport": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "report_id", "authority_effect", "target_contract", "classifications", "summary", "claim_ceiling"],
      "properties": {"artifact_kind": {"const": "import_closure_report"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "report_id": {"$ref": "#/$defs/nonEmpty"}, "authority_effect": {"$ref": "#/$defs/noneAuthority"}, "target_contract": {"type": "object"}, "classifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/classification"}}, "summary": {"type": "object"}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}}
    },
    "wave": {"type": "object", "additionalProperties": false, "required": ["id", "name", "depends_on", "spec_ids", "strategy", "exit_condition"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "name": {"$ref": "#/$defs/nonEmpty"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "spec_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "strategy": {"$ref": "#/$defs/nonEmpty"}, "exit_condition": {"$ref": "#/$defs/nonEmpty"}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["class", "test", "next_action"], "properties": {"class": {"$ref": "#/$defs/nonEmpty"}, "test": {"$ref": "#/$defs/nonEmpty"}, "next_action": {"$ref": "#/$defs/nonEmpty"}}},
    "attackOrder": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "order_id", "authority_effect", "preconditions", "waves", "blocker_protocol", "claim_ceiling"],
      "properties": {"artifact_kind": {"const": "proof_attack_order"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "order_id": {"$ref": "#/$defs/nonEmpty"}, "authority_effect": {"$ref": "#/$defs/noneAuthority"}, "preconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "waves": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/wave"}}, "blocker_protocol": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blocker"}}, "claim_ceiling": {"$ref": "#/$defs/nonEmpty"}}
    }
  }
}
