    }
  },
  "services": {
    "edge": {
      "build": {
        "context": "/home/vrondelli/projects/cyberAlchemy-v2/keld-project/are-documentation",
        "dockerfile": "deploy/edge.Dockerfile"
      },
      "cap_drop": [
        "ALL"
