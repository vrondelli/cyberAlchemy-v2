      "environment": {
        "ARE_CHAT_ACCESS_MODE": "anonymous-public",
        "ARE_CHAT_PUBLIC_HOST": "127.0.0.1:14194"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "/nodejs/bin/node",
          "-e",
          "fetch('http://127.0.0.1:8080/healthz').then(r=\u003eprocess.exit(r.ok?0:1)).catch(()=\u003eprocess.exit(1))"
        ],
        "timeout": "3s",
        "interval": "5s",
        "retries": 12
      },
      "image": "are-chat-edge:security-candidate",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "2",
          "max-size": "5m"
        }
      },
      "mem_limit": "402653184",
      "networks": {
        "chat-ingress": null,
        "host-edge": null
      },
      "pids_limit": 64,
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "14194",
          "protocol": "tcp"
        }
      ],
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true",
        "seccomp=./seccomp-node.json"
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=16m,mode=1777"
      ],
      "user": "65532:65532"
    },
