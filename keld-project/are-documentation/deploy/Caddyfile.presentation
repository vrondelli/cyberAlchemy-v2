are.keld.studio {
  header X-Robots-Tag "noindex, nofollow, noarchive"
  header Cache-Control "no-store"

  @legacyPage path /are /are/
  redir @legacyPage / 308

  @root path /
  handle @root {
    rewrite * /are/
    reverse_proxy are-edge:8080
  }

  @areRuntime path /are/*
  handle @areRuntime {
    reverse_proxy are-edge:8080
  }

  handle {
    respond "Not found" 404
  }
}
