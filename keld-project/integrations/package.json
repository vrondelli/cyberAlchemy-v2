{
  "name": "@keld/sdk-integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "node scripts/preflight.mjs test",
    "test": "node --test --test-timeout=30000 test/*.test.mjs",
    "preflight": "node scripts/preflight.mjs full",
    "check-config": "node bin/server.mjs check",
    "start": "node bin/server.mjs start",
    "reconcile": "node bin/reconcile.mjs",
    "inspect-reconciliation": "node bin/inspect-reconciliation.mjs",
    "inspect-refunds": "node bin/inspect-refunds.mjs",
    "resolve-reconciliation": "node bin/resolve-reconciliation.mjs",
    "process-events": "node bin/process-events.mjs",
    "inspect-events": "node bin/inspect-events.mjs",
    "retry-event": "node bin/retry-event.mjs",
    "maintain": "node bin/maintain.mjs",
    "recover-payment": "node bin/recover-payment.mjs",
    "discover-payment": "node bin/discover-payment.mjs",
    "test:browser": "node test/browser-check.mjs",
    "test:auth-postgres": "node test/auth-postgres-runner.mjs",
    "resume-checkout": "node bin/resume-checkout.mjs",
    "archive-events": "node bin/archive-events.mjs",
