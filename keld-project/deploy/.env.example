# Non-secret settings only. Use DNS names pointing to the new VPS.
KELD_DOMAIN=shop.example.com
SYNVORA_DOMAIN=synvora.solutions
AUTH_DOMAIN=auth.example.com
ARE_DOMAIN=are.example.com
ACME_EMAIL=operator@example.com
KELD_VERSION=candidate
SYNVORA_VERSION=synvora-candidate

# Required before the isolated ARE host can start. Use immutable
# registry references such as registry.example/are-edge@sha256:..., not tags.
ARE_EDGE_IMAGE=
ARE_PUBLIC_CHAT_IMAGE=
ARE_INFERENCE_BROKER_IMAGE=
ARE_PROVIDER_GATEWAY_IMAGE=

# Owner/provider values are intentionally blank. Compose rejects an unset or
# empty value instead of inventing production retention, spend, or rate policy.
ARE_CHAT_IDLE_RETENTION_SECONDS=
ARE_BROKER_HOURLY_MICROUSD_LIMIT=
ARE_BROKER_MONTHLY_MICROUSD_LIMIT=
ARE_PROVIDER_INPUT_MICROUSD_PER_MILLION_TOKENS=
ARE_PROVIDER_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
