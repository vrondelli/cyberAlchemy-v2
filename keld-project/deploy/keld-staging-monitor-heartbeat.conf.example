# Install as /etc/systemd/system/keld-staging-monitor.service.d/heartbeat.conf
# only after /etc/keld-staging-monitor/heartbeat-url contains an owner-approved
# external HTTPS receiver and a test delivery has been observed by its owner.
[Service]
LoadCredential=heartbeat-url:/etc/keld-staging-monitor/heartbeat-url
ExecStartPost=/usr/bin/python3 /opt/keld-staging/send_staging_heartbeat.py --url-credential %d/heartbeat-url --state-file /var/lib/keld-staging-monitor/state.json
