[Unit]
Description=Verify the exact KELD and ARE staging release
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=keld-staging-monitor
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/keld-staging/monitor_staging.py --manifest-dir /opt/keld-staging/release-manifests --manifest-tool /opt/keld-staging/capture_release_manifest.py --quote-tool /opt/keld-staging/quote_config.py --quote-config /opt/keld-staging/.runtime/keld.json --expected-are-retention-seconds 1800 --state-file /var/lib/keld-staging-monitor/state.json
TimeoutStartSec=90
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
