{
  "version": 1,
  "origin": "https://localhost:17443",
  "auth": {
    "issuer": "https://YOUR-ISSUER/realms/keld",
    "client": "keld",
    "audience": "keld",
    "secretEnv": "KELD_OIDC_SECRET",
    "databaseUrlEnv": "KELD_DATABASE_URL",
    "keyEnv": "KELD_SESSION_KEY"
  },
  "payments": {
    "stripe": {
      "account": "YOUR_TEST_ACCOUNT",
      "secretEnv": "KELD_STRIPE_SECRET"
    },
    "mercadopago": {
      "account": "YOUR_TEST_COLLECTOR",
      "accessTokenEnv": "KELD_MP_TOKEN",
      "api": "orders-v1",
      "applicationId": "YOUR_TEST_APPLICATION_ID"
    },
    "paypal": {
      "account": "YOUR_SANDBOX_MERCHANT",
      "clientIdEnv": "KELD_PAYPAL_CLIENT_ID",
      "secretEnv": "KELD_PAYPAL_SECRET",
      "currency": "USD"
    }
  },
  "tls": {
    "certFile": "./private/localhost-cert.pem",
    "keyFile": "./private/localhost-key.pem"
  },
  "ledger": {
    "database": "./private/commerce.db",
    "fixtureFile": "./private/fixture.bin",
    "sha256": "REPLACE_WITH_FIXTURE_SHA256",
    "bytes": 0,
    "reservationSeconds": 3600
  },
  "quoteBrl": {
    "numerator": 0,
    "denominator": 1,
    "reference": "SET_EXPLICIT_SANDBOX_QUOTE",
    "expiresAt": 0
  }
}
