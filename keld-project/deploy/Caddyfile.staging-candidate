{$KELD_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@private path /readyz
	handle @private {
		respond 404
	}
	handle {
		reverse_proxy web:8080 {
			header_up Host {$KELD_DOMAIN}
		}
	}
}

{$AUTH_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@public path /realms/keld/* /resources/* /robots.txt
	handle @public {
		reverse_proxy keycloak:8080
	}
	handle {
		respond "Not found" 404
	}
}

are.keld.studio {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header Cache-Control "no-store"

	@legacyPage path /are /are/
	redir @legacyPage / 308

	@root path /
	handle @root {
		rewrite * /are/
		reverse_proxy are-edge:8080
	}

	@areRuntime path /are/*
	handle @areRuntime {
		reverse_proxy are-edge:8080
	}

	handle {
		respond "Not found" 404
	}
}
