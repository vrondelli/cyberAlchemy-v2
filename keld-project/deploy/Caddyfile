{$KELD_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@private path /readyz
	respond @private 404
	reverse_proxy web:8080 {
		header_up Host {$KELD_DOMAIN}
	}
}
{$AUTH_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@public path /realms/keld/* /resources/* /robots.txt
	handle @public {
		reverse_proxy keycloak:8080
	}
	handle {
		respond "Not found" 404
	}
}
