{$KELD_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@private path /readyz
	handle @private {
		respond 404
	}
	@are path /are /are/*
	handle @are {
		reverse_proxy are-edge:8080 {
			header_up Host {$KELD_DOMAIN}
		}
	}
	handle {
		reverse_proxy web:8080 {
			header_up Host {$KELD_DOMAIN}
		}
	}
}
{$AUTH_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@public path /realms/keld/* /resources/* /robots.txt
	handle @public {
		reverse_proxy keycloak:8080
	}
	handle {
		respond "Not found" 404
	}
}
