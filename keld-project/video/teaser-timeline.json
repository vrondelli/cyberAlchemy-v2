  "captions": [
    {
      "start": 0.16,
      "end": 2.98,
      "text": "He was known by many titles."
    },
    {
      "start": 3.56,
      "end": 7.28,
      "text": "Some knew what he built, others only knew what he kept."
    },
    {
      "start": 7.849999999999994,
      "end": 10.25,
      "text": "Keld did not offer to think in their place."
    },
    {
      "start": 10.629999999999995,
      "end": 15.050000000000011,
      "text": "He listened, cleared a space on the workbench, and began making what"
    },
    {
      "start": 15.050000000000011,
      "end": 18.710000000000008,
      "text": "they needed. An instrument to carry a memory."
    },
    {
      "start": 18.97,
      "end": 23.150000000000006,
      "text": "A mechanism to test a possibility, a connection where there had been"
    },
    {
      "start": 23.150000000000006,
      "end": 23.830000000000013,
      "text": "none."
    },
    {
      "start": 24.430000000000007,
      "end": 26.47,
      "text": "Even minds need tools."
    }
  ]
}
