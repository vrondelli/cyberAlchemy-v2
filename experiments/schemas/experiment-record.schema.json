{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/experiment-record/v1",
  "title": "CyberAlchemy v2 Experiment record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_kind", "experiment_id", "title", "description", "project_ref", "goal_refs", "research_refs", "question_or_hypothesis", "subject", "protocol_ref", "conditions", "variables_or_interventions", "measures", "environment", "prerequisites", "stop_rules", "run_refs", "evidence_refs", "findings_refs", "limitations", "created", "last_updated", "owner_route", "challenge_route", "claim_ceiling", "blocked_effects", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2-experiment-record/v1"},
    "canonical_kind": {"const": "experiment"},
    "experiment_id": {"type": "string", "pattern": "^CA2-EXPERIMENT-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "project_ref": {"type": "string"},
    "goal_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
    "research_refs": {"type": "array", "uniqueItems": true},
    "question_or_hypothesis": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "protocol_ref": {"type": "object"},
    "conditions": {"type": "array", "minItems": 1},
    "variables_or_interventions": {"type": "array", "minItems": 1},
    "measures": {"type": "array", "minItems": 1},
    "environment": {"type": "array", "minItems": 1},
    "prerequisites": {"type": "array", "minItems": 1},
    "stop_rules": {"type": "array", "minItems": 1},
    "run_refs": {"type": "array"},
    "evidence_refs": {"type": "array"},
    "findings_refs": {"type": "array"},
    "limitations": {"type": "array", "minItems": 1},
    "created": {"type": "string", "format": "date"},
    "last_updated": {"type": "string", "format": "date"},
    "owner_route": {"type": "string", "minLength": 1},
    "challenge_route": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "blocked_effects": {"type": "array", "minItems": 1},
    "authority_effect": {"const": "none"}
  }
}
