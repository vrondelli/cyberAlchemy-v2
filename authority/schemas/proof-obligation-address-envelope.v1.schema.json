{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cav2:proof-obligation-address-envelope:1.0.0",
  "title": "Proof and Obligation Address Envelope v1",
  "description": "Unexecuted TOP-03 candidate. This schema validates only structural addressing and exact references.",
  "$comment": "Conformance does not establish owner-local meaning, lifecycle, obligation or discharge state, proof truth, evaluation semantics, authority kind, promotion, attestation, classification, audience, or publication permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "syntax_schema_uri",
    "owner_namespace",
    "record_id",
    "record_version",
    "record_digest",
    "owner_refs",
    "source_bindings",
    "typed_refs",
    "assertion_limit"
  ],
  "properties": {
    "syntax_schema_uri": {
      "const": "urn:cav2:proof-obligation-address-envelope:1.0.0"
    },
    "owner_namespace": {
      "$ref": "#/$defs/identifier"
    },
    "record_id": {
      "$ref": "#/$defs/identifier"
    },
    "record_version": {
      "$ref": "#/$defs/version"
    },
    "record_digest": {
      "$ref": "#/$defs/digest"
    },
    "owner_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ownerReference"
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceBinding"
      }
    },
    "typed_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/typedReference"
      }
    },
    "assertion_limit": {
      "$ref": "#/$defs/ownerQualifiedRef"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ownerQualifiedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_namespace",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "owner_namespace": {
          "$ref": "#/$defs/identifier"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "ownerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type_ref",
        "owner_ref"
      ],
      "properties": {
        "reference_type_ref": {
          "$ref": "#/$defs/ownerQualifiedRef"
        },
        "owner_ref": {
          "$ref": "#/$defs/ownerQualifiedRef"
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_ref",
        "path",
        "selector",
        "digest"
      ],
      "properties": {
        "repository_ref": {
          "$ref": "#/$defs/ownerQualifiedRef"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "typedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type_ref",
        "target_owner_namespace",
        "target_id",
        "target_version",
        "target_digest"
      ],
      "properties": {
        "reference_type_ref": {
          "$ref": "#/$defs/ownerQualifiedRef"
        },
        "target_owner_namespace": {
          "$ref": "#/$defs/identifier"
        },
        "target_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_version": {
          "$ref": "#/$defs/version"
        },
        "target_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
