{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/authority/decisions/durable-storage-semantic-admission.schema.json",
  "title": "CyberAlchemy v2 durable-storage semantic admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "decision_id",
    "decision_status",
    "question",
    "selected_option_id",
    "selection_source",
    "selected_at",
    "owner_route",
    "subject",
    "admission_scope",
    "decision_effect",
    "next_stage_effect",
    "rationale",
    "remaining_gates",
    "forbidden_effects",
    "staleness_rule",
    "challenge_route",
    "admission_effect",
    "adoption_effect",
    "implementation_effect",
    "conformance_effect",
    "publication_effect",
    "deployment_effect",
    "authority_effect"
  ],
  "properties": {
    "schema_ref": {"const": "selection.schema.json"},
    "schema_version": {"const": "cav2-durable-storage-semantic-admission/v1"},
    "decision_id": {"const": "CAV2-DECISION-DURABLE-STORAGE-SEMANTIC-ADMISSION-001"},
    "decision_status": {"const": "accepted"},
    "question": {"$ref": "#/$defs/text"},
    "selected_option_id": {"const": "ADMIT-EXACT-DURABLE-STORAGE-SEMANTIC-BASELINE"},
    "selection_source": {"const": "user-explicit-direction"},
    "selected_at": {"type": "string", "format": "date-time"},
    "owner_route": {"const": "CyberAlchemy v2 product owner plus CyberAlchemy v2 durable-state capability owner"},
    "subject": {"$ref": "#/$defs/subject"},
    "admission_scope": {
      "const": [
        "exact-product-capability-meaning",
        "exact-capability-local-business-ontology",
        "d65-semantic-predecessor-eligibility"
      ]
    },
    "decision_effect": {"const": "admits-exact-product-capability-and-business-ontology-as-d65-semantic-predecessor"},
    "next_stage_effect": {"const": "eligible-for-separately-authorized-domainspec-v2-authoring"},
    "rationale": {"$ref": "#/$defs/text"},
    "remaining_gates": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "forbidden_effects": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "staleness_rule": {"$ref": "#/$defs/text"},
    "challenge_route": {"$ref": "#/$defs/text"},
    "admission_effect": {"const": "exact-semantic-predecessor-admitted"},
    "adoption_effect": {"const": "none"},
    "implementation_effect": {"const": "none"},
    "conformance_effect": {"const": "none"},
    "publication_effect": {"const": "none"},
    "deployment_effect": {"const": "none"},
    "authority_effect": {"const": "semantic-admission-only"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontology_id",
        "package_root",
        "product_capability_ref",
        "product_capability_path",
        "product_capability_digest",
        "material_digest_algorithm",
        "material_files",
        "material_digest",
        "validation_receipt_ref",
        "validation_receipt_digest"
      ],
      "properties": {
        "ontology_id": {"const": "cav2.durable-storage.business"},
        "package_root": {"const": "cyberAlchemy-v2/durable-storage"},
        "product_capability_ref": {"const": "CA2-CAP-PRESERVE-DURABLE-CAPABILITY-STATE"},
        "product_capability_path": {"const": "cyberAlchemy-v2/durable-storage/product-capability.json"},
        "product_capability_digest": {"$ref": "#/$defs/sha256"},
        "material_digest_algorithm": {"const": "sorted-relative-path-nul-bytes-nul-sha256/v1"},
        "material_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "material_digest": {"$ref": "#/$defs/sha256"},
        "validation_receipt_ref": {"$ref": "#/$defs/relativePath"},
        "validation_receipt_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
