{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/authority/decisions/work-orchestration-semantic-admission.schema.json",
  "title": "CyberAlchemy v2 work-orchestration semantic admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "decision_id",
    "decision_status",
    "question",
    "selection_source",
    "selected_at",
    "owner_route",
    "subject",
    "selections",
    "admission_scope",
    "decision_effect",
    "next_stage_effect",
    "rationale",
    "remaining_gates",
    "forbidden_effects",
    "staleness_rule",
    "challenge_route",
    "admission_effect",
    "adoption_effect",
    "implementation_effect",
    "conformance_effect",
    "publication_effect",
    "deployment_effect",
    "external_effect",
    "authority_effect"
  ],
  "properties": {
    "schema_ref": {"const": "selection.schema.json"},
    "schema_version": {"const": "cav2-work-orchestration-semantic-admission/v1"},
    "decision_id": {"const": "CAV2-DECISION-WORK-ORCHESTRATION-SEMANTIC-ADMISSION-001"},
    "decision_status": {"const": "accepted"},
    "question": {"$ref": "#/$defs/text"},
    "selection_source": {"$ref": "#/$defs/selectionSource"},
    "selected_at": {"type": "string", "format": "date-time"},
    "owner_route": {"const": "CyberAlchemy v2 product owner plus CyberAlchemy v2 work-orchestration capability owner"},
    "subject": {"$ref": "#/$defs/subject"},
    "selections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/selection"}
    },
    "admission_scope": {
      "const": [
        "exact-product-capability-meaning",
        "exact-capability-local-business-ontology",
        "domain-recovery-versus-structural-orchestration-ownership-principle",
        "single-logical-accepted-history-authority-requirement",
        "small-etl-first-domainspec-fixture-selection",
        "d65-semantic-predecessor-eligibility"
      ]
    },
    "decision_effect": {"const": "admits-exact-work-orchestration-semantic-baseline-and-records-bounded-successor-constraints"},
    "next_stage_effect": {"const": "eligible-for-separately-authorized-small-etl-domainspec-v2-candidate-authoring"},
    "rationale": {"$ref": "#/$defs/text"},
    "remaining_gates": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "forbidden_effects": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "staleness_rule": {"$ref": "#/$defs/text"},
    "challenge_route": {"$ref": "#/$defs/text"},
    "admission_effect": {"const": "exact-semantic-predecessor-admitted"},
    "adoption_effect": {"const": "none"},
    "implementation_effect": {"const": "none"},
    "conformance_effect": {"const": "none"},
    "publication_effect": {"const": "none"},
    "deployment_effect": {"const": "none"},
    "external_effect": {"const": "none"},
    "authority_effect": {"const": "semantic-admission-only"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "selectionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "exact_user_direction", "interpretation"],
      "properties": {
        "kind": {"const": "current-chat"},
        "exact_user_direction": {
          "const": [
            "Accept or revise the capability meaning.",
            "Decide that DomainSpec owns domain recovery semantics while one generic orchestration runtime owns structural scheduling and cursor replay.",
            "Defer the exact physical journal design, but require one accepted-history authority.",
            "Use a small ETL workflow as the first DomainSpec fixture because it exercises sequence, mapping, validation gates, idempotency, and effects without agent-policy complexity."
          ]
        },
        "interpretation": {"const": "accept-current-exact-baseline-no-revision-requested"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontology_id",
        "package_root",
        "product_capability_ref",
        "product_capability_path",
        "product_capability_digest",
        "definitions_path",
        "definitions_digest",
        "material_digest_algorithm",
        "material_files",
        "material_digest",
        "source_digest",
        "validation_command",
        "validation_runs",
        "validation_outputs_identical",
        "validation_status",
        "validation_authority_effect"
      ],
      "properties": {
        "ontology_id": {"const": "cav2.work-orchestration.business"},
        "package_root": {"const": "cyberAlchemy-v2/work-orchestration"},
        "product_capability_ref": {"const": "CA2-CAP-EXECUTE-BOUNDED-COMPOSITE-WORK"},
        "product_capability_path": {"const": "cyberAlchemy-v2/work-orchestration/product-capability.json"},
        "product_capability_digest": {"$ref": "#/$defs/sha256"},
        "definitions_path": {"const": "cyberAlchemy-v2/work-orchestration/definitions.json"},
        "definitions_digest": {"$ref": "#/$defs/sha256"},
        "material_digest_algorithm": {"const": "sorted-relative-path-nul-bytes-nul-sha256/v1"},
        "material_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "material_digest": {"$ref": "#/$defs/sha256"},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "validation_command": {"const": "PYTHONDONTWRITEBYTECODE=1 python3 cyberAlchemy-v2/work-orchestration/scripts/validate.py"},
        "validation_runs": {"const": 2},
        "validation_outputs_identical": {"const": true},
        "validation_status": {"const": "PASS"},
        "validation_authority_effect": {"const": "none"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_id", "question", "selected_option", "effect", "deferred", "authority_effect"],
      "properties": {
        "selection_id": {
          "enum": [
            "WO-DECISION-CAPABILITY-MEANING",
            "WO-DECISION-RECOVERY-OWNERSHIP",
            "WO-DECISION-ACCEPTED-HISTORY",
            "WO-DECISION-FIRST-DOMAINSPEC-FIXTURE"
          ]
        },
        "question": {"$ref": "#/$defs/text"},
        "selected_option": {"$ref": "#/$defs/text"},
        "effect": {"$ref": "#/$defs/text"},
        "deferred": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "authority_effect": {"enum": ["semantic-admission-only", "none"]}
      }
    }
  }
}
