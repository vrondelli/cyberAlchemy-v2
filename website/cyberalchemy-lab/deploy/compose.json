{
  "services": {
    "site": {
      "image": "nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10",
      "restart": "unless-stopped",
      "read_only": true,
      "tmpfs": [
        "/var/cache/nginx",
        "/var/run",
        "/tmp"
      ],
      "volumes": [
        "./public:/usr/share/nginx/html:ro",
        "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "networks": [
        "edge"
      ],
      "labels": {
        "traefik.enable": "true",
        "traefik.docker.network": "troqar_edge",
        "traefik.http.routers.cyberalchemy-public.rule": "Host(`cyberalchemylab.com`) && (Path(`/`) || Path(`/index.html`) || Path(`/en`) || PathPrefix(`/en/`) || PathPrefix(`/assets/`) || Path(`/robots.txt`) || Path(`/sitemap.xml`))",
        "traefik.http.routers.cyberalchemy-public.entrypoints": "websecure",
        "traefik.http.routers.cyberalchemy-public.tls": "true",
        "traefik.http.routers.cyberalchemy-public.tls.certresolver": "letsencrypt",
        "traefik.http.services.cyberalchemy-public.loadbalancer.server.port": "80"
      }
    }
  },
  "networks": {
    "edge": {
      "external": true,
      "name": "troqar_edge"
    }
  }
}
