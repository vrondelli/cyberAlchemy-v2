{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/product/craft/capabilities/orodi/schema/v1",
  "$defs": {
    "text": {"type":"string","minLength":1},
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "stringSet": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "exactRef": {
      "type":"object","additionalProperties":false,"required":["ref","digest"],
      "properties":{"ref":{"$ref":"#/$defs/text"},"digest":{"$ref":"#/$defs/digest"}}
    },
    "profile": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","package_id","product_ref","project_ref","goal_ref","ontology_ref","ontology_type","materialization","package_root","package_owner","visibility","status","source_registry","product_capability_registry","immutable_record_manifest","support_registry","admission_owner_registry","admission_decision_registry","schema_path","validator_path","receipt_root","authority_effect","blocked_outputs"],
      "properties":{
        "schema_ref":{"const":"schemas/orodi-capability-package.schema.json#/$defs/profile"},
        "schema_version":{"const":"cav2-craft-orodi-capability-profile/v1"},
        "package_id":{"const":"cav2.product.craft.capabilities.orodi"},
        "product_ref":{"const":"CA2-PRODUCT-CRAFT"},
        "project_ref":{"const":"CA2-PROJECT-CRAFT"},
        "goal_ref":{"const":"CA2-GOAL-CRAFT-ORODI-INTEGRATION"},
        "ontology_ref":{"const":"domainspec.orodi.ontology@1"},
        "ontology_type":{"const":"business-system-bridge"},
        "materialization":{"const":"package-required"},
        "package_root":{"const":"cyberAlchemy-v2/product/craft/capabilities/orodi"},
        "package_owner":{"const":"Craft Product owner"},
        "visibility":{"const":"private"},
        "status":{"const":"candidate"},
        "source_registry":{"const":"sources.json"},
        "product_capability_registry":{"const":"product-capabilities.json"},
        "immutable_record_manifest":{"const":"immutable-records.json"},
        "support_registry":{"const":"support.json"},
        "admission_owner_registry":{"const":"admission-owners.json"},
        "admission_decision_registry":{"const":"admission-decisions.json"},
        "schema_path":{"const":"schemas/orodi-capability-package.schema.json"},
        "validator_path":{"const":"scripts/validate.py"},
        "receipt_root":{"const":"receipts"},
        "authority_effect":{"const":"none"},
        "blocked_outputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}
      }
    },
    "sourceRegistry": {
      "type":"object","additionalProperties":false,"required":["schema_version","sources","selections","authority_effect"],
      "properties":{
        "schema_version":{"const":"cav2-craft-orodi-capability-sources/v1"},
        "sources":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["source_id","path","scope_kind","sha256","owner_route"],"properties":{"source_id":{"type":"string","pattern":"^SRC-ORODI-"},"path":{"$ref":"#/$defs/text"},"scope_kind":{"const":"whole-file"},"sha256":{"$ref":"#/$defs/digest"},"owner_route":{"$ref":"#/$defs/text"}}}},
        "selections":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["selection_id","source_id","selector_kind","selector","selection_sha256"],"properties":{"selection_id":{"type":"string","pattern":"^CAP-SEL-ORODI-"},"source_id":{"type":"string","pattern":"^SRC-ORODI-"},"selector_kind":{"enum":["whole-file","markdown-heading"]},"selector":{"$ref":"#/$defs/text"},"selection_sha256":{"$ref":"#/$defs/digest"}}}},
        "authority_effect":{"const":"none"}
      }
    },
    "immutableRegistry": {
      "type":"object","additionalProperties":false,"required":["schema_version","canonicalization","registry_ref","records","identity_rule","adoption_state","authority_effect","claim_ceiling"],
      "properties":{
        "schema_version":{"const":"cav2-craft-orodi-immutable-product-capabilities/v1"},
        "canonicalization":{"$ref":"#/$defs/text"},
        "registry_ref":{"$ref":"#/$defs/exactRef"},
        "records":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["capability_id","record_digest"],"properties":{"capability_id":{"type":"string","pattern":"^CA2-CAP-ORODI-"},"record_digest":{"$ref":"#/$defs/digest"}}}},
        "identity_rule":{"$ref":"#/$defs/text"},
        "adoption_state":{"const":"awaiting-craft-product-owner-decision"},
        "authority_effect":{"const":"none"},
        "claim_ceiling":{"$ref":"#/$defs/text"}
      }
    },
    "admissionOwners": {
      "type":"object","additionalProperties":false,"required":["schema_version","product_ref","project_ref","owners","decision_rule","authority_effect"],
      "properties":{
        "schema_version":{"const":"cav2-craft-orodi-admission-owners/v1"},
        "product_ref":{"const":"CA2-PRODUCT-CRAFT"},
        "project_ref":{"const":"CA2-PROJECT-CRAFT"},
        "owners":{"type":"array","minItems":6,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["owner_id","responsibility","owner_route","may_decide","may_not_infer"],"properties":{"owner_id":{"type":"string","pattern":"^CA2-OWNER-"},"responsibility":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"},"may_decide":{"$ref":"#/$defs/stringSet"},"may_not_infer":{"$ref":"#/$defs/stringSet"}}}},
        "decision_rule":{"$ref":"#/$defs/text"},
        "authority_effect":{"const":"none"}
      }
    },
    "admissionDecisions": {
      "type":"object","additionalProperties":false,"required":["schema_version","project_binding","resolved_decisions","pending_decisions","supersession_rule","authority_effect","claim_ceiling"],
      "properties":{
        "schema_version":{"const":"cav2-craft-orodi-admission-decisions/v1"},
        "project_binding":{"type":"object","additionalProperties":false,"required":["decision_id","state","owner_ref","project_ref","goal_ref","effect","authority_effect"],"properties":{"decision_id":{"type":"string","pattern":"^CA2-DECISION-"},"state":{"const":"established"},"owner_ref":{"const":"CA2-OWNER-CRAFT-PROJECT"},"project_ref":{"$ref":"#/$defs/exactRef"},"goal_ref":{"$ref":"#/$defs/exactRef"},"effect":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
        "resolved_decisions":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"type":"object","required":["decision_id","decision_kind","owner_ref","candidate_ref","decision_record_ref","decision","decision_state","decided_on","authority_effect"],"properties":{"decision_id":{"type":"string","pattern":"^CA2-DECISION-"},"decision_kind":{"enum":["product-capability-adoption","business-ontology-admission","domainspec-profile-and-source-admission","system-ontology-admission"]},"owner_ref":{"type":"string","pattern":"^CA2-OWNER-"},"candidate_ref":{"$ref":"#/$defs/exactRef"},"decision_record_ref":{"$ref":"#/$defs/exactRef"},"decision":{"enum":["adopt","admit"]},"decision_state":{"enum":["adopted","admitted"]},"decided_on":{"type":"string","format":"date"},"authority_effect":{"$ref":"#/$defs/text"}}}},
        "pending_decisions":{"type":"array","minItems":0,"maxItems":2,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["decision_id","decision_kind","owner_ref","candidate_ref","allowed_decisions","decision_state","required_statement","authority_effect"],"properties":{"decision_id":{"type":"string","pattern":"^CA2-DECISION-"},"decision_kind":{"enum":["business-ontology-admission","domainspec-profile-admission"]},"owner_ref":{"type":"string","pattern":"^CA2-OWNER-"},"candidate_ref":{"$ref":"#/$defs/exactRef"},"allowed_decisions":{"$ref":"#/$defs/stringSet"},"decision_state":{"const":"awaiting-owner-decision"},"required_statement":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}}},
        "supersession_rule":{"$ref":"#/$defs/text"},
        "authority_effect":{"enum":["contains-exact-product-capability-adoption","contains-product-capability-adoption-and-ontology-profile-system-admissions"]},
        "claim_ceiling":{"$ref":"#/$defs/text"}
      }
    }
  }
}
