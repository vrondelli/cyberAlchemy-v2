{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/product-thesis-record/v1",
  "title": "CyberAlchemy v2 Product Thesis record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_kind", "thesis_id", "title", "product_ref", "definition_ref", "carrier_ref", "participants", "problem", "value_proposition", "value_mechanism", "first_order_principles", "intended_outcomes", "boundaries", "hypotheses", "evidence_routes", "counterevidence_routes", "revision_criteria", "owner_route", "commitment_state", "artifact_authority_state", "revision_history", "challenge_route", "claim_ceiling", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2-product-thesis-record/v1"},
    "canonical_kind": {"const": "product-thesis"},
    "thesis_id": {"type": "string", "pattern": "^CA2-PRODUCT-THESIS-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "product_ref": {"type": "string"},
    "definition_ref": {"const": "CAV2-D63"},
    "carrier_ref": {"const": "PRODUCT-THESIS.md"},
    "participants": {"type": "array", "minItems": 1, "uniqueItems": true},
    "problem": {"type": "string", "minLength": 1},
    "value_proposition": {"type": "string", "minLength": 1},
    "value_mechanism": {"type": "string", "minLength": 1},
    "first_order_principles": {"type": "array", "minItems": 1, "uniqueItems": true},
    "intended_outcomes": {"type": "array", "minItems": 1, "uniqueItems": true},
    "boundaries": {"type": "array", "minItems": 1},
    "hypotheses": {"type": "array", "minItems": 1},
    "evidence_routes": {"type": "array", "minItems": 1},
    "counterevidence_routes": {"type": "array", "minItems": 1},
    "revision_criteria": {"type": "array", "minItems": 1},
    "owner_route": {"type": "string", "minLength": 1},
    "commitment_state": {"enum": ["draft", "committed", "revised", "retired", "superseded"]},
    "artifact_authority_state": {"enum": ["candidate", "promoted", "demoted"]},
    "revision_history": {"type": "array", "minItems": 1},
    "challenge_route": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  }
}
