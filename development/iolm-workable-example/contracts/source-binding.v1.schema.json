{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/iolm/source-binding.v1.schema.json",
  "title": "IOLM pinned fixture source binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "binding_id",
    "artifact_role",
    "posture",
    "authority_effect",
    "owner_route",
    "inputs",
    "expected",
    "ineligible_for"
  ],
  "properties": {
    "$schema": {"const": "source-binding.v1.schema.json"},
    "schema_version": {"const": "iolm-source-binding/v1"},
    "binding_id": {"const": "key-and-door-pinned-fixture"},
    "artifact_role": {"const": "fixture-binding"},
    "posture": {"const": "candidate"},
    "authority_effect": {"const": "none"},
    "owner_route": {"const": "private-learning-map-product-owner"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph", "source_manifest", "build_receipt"],
      "properties": {
        "graph": {
          "$ref": "#/$defs/input",
          "properties": {
            "path": {"const": "projects/domainspec-v2/impl/test-derivation-engine/__fixtures__/minted-project/contract/positive/key-and-door/expected/graph.json"},
            "route": {"const": "/fixtures/graph.json"},
            "sha256": {"const": "1f0691fac9ed9612605d62d8b390e9b39eca24b6f11a6b0868c7591c6179e7ae"}
          }
        },
        "source_manifest": {
          "$ref": "#/$defs/input",
          "properties": {
            "path": {"const": "projects/domainspec-v2/impl/test-derivation-engine/__fixtures__/minted-project/contract/positive/key-and-door/expected/source-manifest.json"},
            "route": {"const": "/fixtures/source-manifest.json"},
            "sha256": {"const": "ed4a1fdf4684b26fb5dbf086cf98f80050734ffea1d2c845503f0bf429e9cd6e"}
          }
        },
        "build_receipt": {
          "$ref": "#/$defs/input",
          "properties": {
            "path": {"const": "projects/domainspec-v2/impl/test-derivation-engine/__fixtures__/minted-project/contract/positive/key-and-door/expected/build-receipt.json"},
            "route": {"const": "/fixtures/build-receipt.json"},
            "sha256": {"const": "14ac660824e8a697ef6ae3e20b18132bf99aa45f9adbe46e46e686db36260fbe"}
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "source_set_digest",
        "profile_ref",
        "profile_digest",
        "generator_version",
        "kinds_digest",
        "relationships_digest",
        "node_count",
        "edge_count",
        "node_ids",
        "edge_ids"
      ],
      "properties": {
        "project_id": {"const": "key-and-door"},
        "source_set_digest": {"const": "33b2b650bcd5e4f4ab8c4f03c892bca8fcc660d167c9b6220a775e0b5bccdb1c"},
        "profile_ref": {"const": "feature-with-independent-node-files@1"},
        "profile_digest": {"const": "0868785499944ce2b21b915962cba48f8b21d627b840c24d81c77194e8864478"},
        "generator_version": {"const": "minted-project-tools/v1"},
        "kinds_digest": {"const": "4394968327b785d50cd323ad58a799feb71b9debf7e06b650b4fd1e4008f9ede"},
        "relationships_digest": {"const": "ffc97f2c358e4bebeebd8ceeb25aef59628be9c970cf6a7e510f7a37c9876d9f"},
        "node_count": {"const": 4},
        "edge_count": {"const": 3},
        "node_ids": {
          "type": "array",
          "prefixItems": [
            {"const": "key-and-door.DoorUnlocked"},
            {"const": "key-and-door.HasKeyRule"},
            {"const": "key-and-door.Player"},
            {"const": "key-and-door.UnlockDoor"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "edge_ids": {
          "type": "array",
          "prefixItems": [
            {"const": "key-and-door.edge.has-key-rule-enforces-unlock-door"},
            {"const": "key-and-door.edge.player-performs-unlock-door"},
            {"const": "key-and-door.edge.unlock-door-produces-door-unlocked"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "ineligible_for": {
      "type": "array",
      "prefixItems": [
        {"const": "SWU-IOLM-00C-B"},
        {"const": "SWU-IOLM-00C-C"},
        {"const": "G-DSV2-SG"},
        {"const": "CROSS_FEATURE_UNSUPPORTED"},
        {"const": "promotion"},
        {"const": "publication"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "route", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "route": {"type": "string", "pattern": "^/fixtures/[a-z-]+\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
