{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/iolm/demo-snapshot.v1.schema.json",
  "title": "IOLM DemoSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "snapshot_id",
    "artifact_role",
    "posture",
    "authority_effect",
    "owner_route",
    "source_binding",
    "features",
    "nodes",
    "relations",
    "counts",
    "slices",
    "validation",
    "ineligible_for"
  ],
  "properties": {
    "$schema": {"const": "https://domainspec.local/iolm/demo-snapshot.v1.schema.json"},
    "schema_version": {"const": "iolm-demo-snapshot/v1"},
    "snapshot_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "artifact_role": {"const": "generated-read-model"},
    "posture": {"const": "candidate"},
    "authority_effect": {"const": "none"},
    "owner_route": {"const": "private-learning-map-product-owner"},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/feature"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/node"}
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relation"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "relations"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "relations": {"type": "integer", "minimum": 0}
      }
    },
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "questions"],
      "properties": {
        "default": {"$ref": "#/$defs/slice"},
        "questions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slice"}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "guard", "boundary_handle"],
      "properties": {
        "state": {"const": "pass"},
        "guard": {"const": "DemoSnapshotV1Guard"},
        "boundary_handle": {"type": "string", "minLength": 1}
      }
    },
    "ineligible_for": {"$ref": "#/$defs/ineligibleFor"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "featureId": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_class",
        "test_only",
        "binding_id",
        "binding_schema_version",
        "boundary_handle",
        "source_set_digest",
        "profile_ref",
        "profile_digest",
        "generator_version",
        "kinds_digest",
        "relationships_digest",
        "fixture_hashes"
      ],
      "properties": {
        "input_class": {"enum": ["pinned-fixture", "synthetic-conformance"]},
        "test_only": {"type": "boolean"},
        "binding_id": {"type": "string", "minLength": 1},
        "binding_schema_version": {"type": "string", "minLength": 1},
        "boundary_handle": {"type": "string", "minLength": 1},
        "source_set_digest": {"$ref": "#/$defs/sha256"},
        "profile_ref": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$"},
        "profile_digest": {"$ref": "#/$defs/sha256"},
        "generator_version": {"type": "string", "minLength": 1},
        "kinds_digest": {"$ref": "#/$defs/sha256"},
        "relationships_digest": {"$ref": "#/$defs/sha256"},
        "fixture_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["graph", "source_manifest", "build_receipt"],
          "properties": {
            "graph": {"$ref": "#/$defs/sha256"},
            "source_manifest": {"$ref": "#/$defs/sha256"},
            "build_receipt": {"$ref": "#/$defs/sha256"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"input_class": {"const": "pinned-fixture"}}, "required": ["input_class"]},
          "then": {
            "properties": {
              "test_only": {"const": false},
              "boundary_handle": {"const": "iolm-fixture-boundary/v1"}
            }
          }
        },
        {
          "if": {"properties": {"input_class": {"const": "synthetic-conformance"}}, "required": ["input_class"]},
          "then": {
            "properties": {
              "test_only": {"const": true},
              "boundary_handle": {"const": "synthetic-conformance-only/v1"}
            }
          }
        }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "label"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/featureId"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "schema_version", "source_set_digest"],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "source_set_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenanceFields": {
      "type": "object",
      "properties": {
        "artifact_role": {"const": "generated-read-model"},
        "posture": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "owner_route": {"const": "private-learning-map-product-owner"},
        "source_reference": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "contract_binding": {"$ref": "#/$defs/contractBinding"},
        "validation_state": {"const": "pass"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_type",
        "feature_id",
        "kind",
        "label",
        "intent",
        "artifact_role",
        "posture",
        "authority_effect",
        "owner_route",
        "source_reference",
        "source_digest",
        "contract_binding",
        "validation_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "record_type": {"const": "node"},
        "feature_id": {"$ref": "#/$defs/featureId"},
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1},
        "artifact_role": {"const": "generated-read-model"},
        "posture": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "owner_route": {"const": "private-learning-map-product-owner"},
        "source_reference": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "contract_binding": {"$ref": "#/$defs/contractBinding"},
        "validation_state": {"const": "pass"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "node_id"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/featureId"},
        "node_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_type",
        "relation_class",
        "label",
        "source",
        "target",
        "artifact_role",
        "posture",
        "authority_effect",
        "owner_route",
        "source_reference",
        "source_digest",
        "contract_binding",
        "validation_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "record_type": {"const": "relation"},
        "relation_class": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/endpoint"},
        "artifact_role": {"const": "generated-read-model"},
        "posture": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "owner_route": {"const": "private-learning-map-product-owner"},
        "source_reference": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "contract_binding": {"$ref": "#/$defs/contractBinding"},
        "validation_state": {"const": "pass"}
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_id", "question", "node_ids", "relation_ids", "counts"],
      "properties": {
        "slice_id": {"type": "string", "minLength": 1},
        "question": {"type": ["string", "null"]},
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "relation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "relations"],
          "properties": {
            "nodes": {"type": "integer", "minimum": 1},
            "relations": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "ineligibleFor": {
      "type": "array",
      "prefixItems": [
        {"const": "SWU-IOLM-00C-B"},
        {"const": "SWU-IOLM-00C-C"},
        {"const": "G-DSV2-SG"},
        {"const": "CROSS_FEATURE_UNSUPPORTED"},
        {"const": "promotion"},
        {"const": "publication"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    }
  }
}
