{
  "schema_version": "minted-node/v1",
  "node_id": "are-interaction-learning.LearningBoundary",
  "feature_id": "are-interaction-learning",
  "kind": "Rule",
  "intent": "Reject cross-scope learning, ungrounded feedback, stale application and unbounded retries.",
  "body": {
    "formal_return_type": "boolean",
    "semantic_refs": [
      "are.interaction-state",
      "are.interaction-context",
      "are.grounding",
      "are.preference",
      "are.preference-application",
      "are.lesson-application",
      "are.learning-progress",
      "are.scoped-reflection",
      "are.loop"
    ],
    "required_conditions": [
      "no cross-user or cross-product reuse",
      "no silent durable preference inference",
      "disabled mode makes no provider calls",
      "two no-gain attempts stop strategy",
      "uncertain post-crash delivery is not retried"
    ],
    "violation_behavior": "block before dispatch and preserve earlier state",
    "authority_effect": "none"
  },
  "connections": [
    {
      "edge_id": "are-interaction-learning.edge.enforces-continuity",
      "type": "enforces",
      "to": "are-interaction-learning.RunInteractionLearning"
    }
  ]
}
