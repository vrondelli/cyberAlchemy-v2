{
  "schema_version": "minted-node/v1",
  "node_id": "are-requirement-continuity.RequirementBoundary",
  "feature_id": "are-requirement-continuity",
  "kind": "Rule",
  "intent": "Reject stale or missing snapshots, invalid changes and checkpoint failures without dispatch.",
  "body": {
    "formal_return_type": "boolean",
    "semantic_refs": [
      "CA2-ARE-CONCEPT-CURRENT-OBJECTIVE",
      "CA2-ARE-CONCEPT-OBJECTIVE-TRANSITION",
      "CA2-ARE-WORKFLOW-OBJECTIVE-RESOLUTION",
      "CA2-ARE-CONCEPT-REASONING-STATE-LEDGER",
      "CA2-ARE-CONCEPT-REASONING-STATE-CHECKPOINT"
    ],
    "required_conditions": [
      "all snapshots bind the current consumer, scope and objective state",
      "unknown never becomes empty",
      "no permission or completion inferred",
      "all snapshots fit aggregate budget"
    ],
    "violation_behavior": "block before dispatch and preserve earlier state",
    "authority_effect": "none"
  },
  "connections": [
    {
      "edge_id": "are-requirement-continuity.edge.enforces-continuity",
      "type": "enforces",
      "to": "are-requirement-continuity.CarryRequirements"
    }
  ]
}
