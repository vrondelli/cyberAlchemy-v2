  "resolved_findings": [
    "Prepared request is claimed synchronously before health await, rejecting concurrent dispatch acceptance.",
    "All close callers receive the same promise and await in-flight drain and writer-lock removal."
  ],
  "verified_behavior": [
    "Actual bounded recycler pauses after measurement and before model dispatch; per-request checkpoints share one arm receipt ledger binding.",
    "Held-health and held-request tests cover one-use dispatch and concurrent closure without timing-dependent assumptions.",
    "Actual GLM adapter exercised through in-memory HTTP seam:100 synthetic tokenizer tokens plus512 margin=612 bound, exactly one tokenizer/one model receipt, idle durable ledger equal to client receipts."
  ],
  "limitations": [
    "No real tokenization, credential resolution, socket/provider call or live fit established.",
    "Factory must bind matching profile/output limits, shared signal and health/storage callbacks; close waits rather than independently cancelling dispatched HTTP.",
    "Full multi-phase native adapter integration, mock tokenizer/in-flight failures, bounded history strategy, common baseline and source/supervision/qualification remain pending."
  ],
