{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.patch-set-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_base_tree_sha256",
    "changes",
    "authority_effect"
  ],
  "x-code": "patch-set.object-required",
  "x-unknown-code": "patch-set.unknown-field",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "are.patch-set-candidate/v1"
      ],
      "x-code": "patch-set.schema-version-invalid"
    },
    "expected_base_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "x-code": "patch-set.base-tree-digest-invalid"
    },
    "authority_effect": {
      "type": "string",
      "enum": [
        "none"
      ],
      "x-code": "patch-set.authority-effect-invalid"
    },
    "rationale": {
      "type": "string",
      "x-code": "patch-set.rationale-invalid"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "x-code": "patch-set.changes-invalid",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "path",
          "expected_file_sha256",
          "utf8"
        ],
        "x-code": "patch-set.change-invalid",
        "x-unknown-code": "patch-set.change-invalid",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "replace-file"
            ],
            "x-code": "patch-set.operation-invalid"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "x-code": "patch-set.path-invalid"
          },
          "expected_file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "x-code": "patch-set.file-digest-invalid"
          },
          "utf8": {
            "type": "string",
            "x-code": "patch-set.utf8-required"
          }
        }
      }
    }
  }
}
