  "findings": [
    {
      "id": "R1-blocking-special-file-open",
      "blocking": true,
      "detail": "Root-level fixed evidence paths are opened O_RDONLY before fstat regular-file validation. A preexisting FIFO with no writer blocks open indefinitely; state traversal only checks the state subtree. This violates bounded malformed-input handling even for a settled tree.",
      "required_fix": "Require final lstat regular-file type before open and/or use O_NONBLOCK before fstat; add isolated child timeout regression with named pipe."
    }
  ],
  "verified_behavior": [
    "Actual current-ARE and candidate started/completed shapes match adapter expectations.",
    "Five existing tests pass for all three arms, hash/outcome substitutions, nested locks, symlink/path rejection, completion binding and sparse-size rejection."
  ],
  "limitations": [
    "Outer process exit, hostile concurrent filesystem mutation protection, campaign seal binding and actual public task hash verification remain declared caller responsibilities, not extra R1 findings."
  ],
