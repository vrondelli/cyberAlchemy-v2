{"path":"documentation/tutorial/07-lifecycle/01-onmount/app-a/App.svelte","source_sha256":"1e225763632819cdaf0f1425555d0f25709889f2d34238666dcb09fcce8fb488","utf8":"<script>\n\tlet photos = [];\n</script>\n\n<h1>Photo album</h1>\n\n<div class=\"photos\">\n\t{#each photos as photo}\n\t\t<figure>\n\t\t\t<img src={photo.thumbnailUrl} alt={photo.title} />\n\t\t\t<figcaption>{photo.title}</figcaption>\n\t\t</figure>\n\t{:else}\n\t\t<!-- this block renders when photos.length === 0 -->\n\t\t<p>loading...</p>\n\t{/each}\n</div>\n\n<style>\n\t.photos {\n\t\twidth: 100%;\n\t\tdisplay: grid;\n\t\tgrid-template-columns: repeat(5, 1fr);\n\t\tgrid-gap: 8px;\n\t}\n\n\tfigure,\n\timg {\n\t\twidth: 100%;\n\t\tmargin: 0;\n\t}\n</style>\n"}