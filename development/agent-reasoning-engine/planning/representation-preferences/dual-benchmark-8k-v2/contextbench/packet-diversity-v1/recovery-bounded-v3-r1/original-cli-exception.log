ondition block:\\n\\nold:\\n```\\n\\tif opts.RepoArg == \\"\\" {\\n\\t\\tvar err error\\n\\t\\ttoView, err = opts.BaseRepo()\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t} else {\\n```\\nnew:\\n```\\n\\tif opts.RepoArg == \\"\\" || opts.RepoArg == \\".\\" {\\n\\t\\t...same...\\n\\t} else {\\n```\\n\\n2. Fallback local readme: after readme fetch:\\n```\\n\\treadme, err := RepositoryReadme(...)\\n\\tif err != nil && err != NotFoundError {\\n\\t\\treturn err\\n\\t}\\n\\tif readme == nil && opts.RepoArg == \\".\\" {\\n\\t\\treadme = localReadme()\\n\\t}\\n```\\nAdd helper reading ./README* files. Also description indicator — optional; skip heavy changes but add small note? Keep minimal + helper function.","role":"assistant","tool_calls":[{"function":{"arguments":"{\\"edits\\":[{\\"new_text\\": \\"\\\\tif opts.RepoArg == \\\\\\"\\\\\\" || opts.RepoArg == \\\\\\".\\\\\\" {\\\\n\\\\t\\\\tvar err error\\\\n\\\\t\\\\ttoView, err = opts.BaseRepo()\\\\n\\\\t\\\\tif err != nil {\\\\n\\\\t\\\\t\\\\treturn err\\\\n\\\\t\\\\t}\\\\n\\\\t} else {\\", \\"old_text\\": \\"\\\\tif opts.RepoArg == \\\\\\"\\\\\\" {\\\\n\\\\t\\\\tvar err error\\\\n\\\\t\\\\ttoView, err = opts.BaseRepo()\\\\n\\\\t\\\\tif err != nil {\\\\n\\\\t\\\\t\\\\treturn err\\\\n\\\\t\\\\t}\\\\n\\\\t} else {\\", \\"path\\": \\"pkg/cmd/repo/view/view.go\\", \\"source_sha256\\": \\"8e7eff1f24434e44274cff27f39ace5574c9d7e974e747a859f2c38661d6d6cf\\"}, {\\"new_text\\": \\"\\\\treadme, err := RepositoryReadme(httpClient, toView, opts.Branch)\\\\n\\\\tif err != nil && err != NotFoundError {\\\\n\\\\t\\\\treturn err\\\\n\\\\t}\\\\n\\\\n\\\\tif readme == nil && opts.RepoArg == \\\\\\".\\\\\\" {\\\\n\\\\t\\\\treadme, err = localReadme()\\\\n\\\\t\\\\tif err != nil {\\\\n\\\\t\\\\t\\\\treturn err\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\", \\"old_text\\": \\"\\\\treadme, err := RepositoryReadme(httpClient, toView, opts.Branch)\\\\n\\\\tif err != nil && err != NotFoundError {\\\\n\\\\t\\\\treturn err\\\\n\\\\t}\\\\n\\", \\"path\\": \\"pkg/cmd/repo/view/view.go\\", \\"source_sha256\\": \\"8e7eff1f24434e44274cff27f39ace5574c9d7e974e747a859f2c38661d6d6cf\\"}, {\\"new_text\\": \\"\\\\t\\\\tstrings.HasSuffix(filename, \\\\\\".mkdown\\\\\\")\\\\n}\\\\n\\\\n// localReadme looks for a README file in the current working directory.\\\\nfunc localReadme() (*RepoReadme, error) {\\\\n\\\\tcandidates := []string{\\\\\\"README.md\\\\\\", \\\\\\"README.markdown\\\\\\", \\\\\\"README.mdown\\\\\\", \\\\\\"README.mkdown\\\\\\", \\\\\\"README\\\\\\"}\\\\n\\\\tfor _, filename := range candidates {\\\\n\\\\t\\\\tif _, err := os.Stat(filename); err == nil {\\\\n\\\\t\\\\t\\\\tcontent, err := ioutil.ReadFile(filename)\\\\n\\\\t\\\\t\\\\tif err != nil {\\\\n\\\\t\\\\t\\\\t\\\\treturn nil, err\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t\\\\treturn &RepoReadme{\\\\n\\\\t\\\\t\\\\t\\\\tFilename: filename,\\\\n\\\\t\\\\t\\\\t\\\\tContent:  string(content),\\\\n\\\\t\\\\t\\\\t}, nil\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn nil, nil\\\\n}\\", \\"old_text\\": \\"\\\\t\\\\tstrings.HasSuffix(filename, \\\\\\".mkdown\\\\\\")\\\\n}\\", \\"path\\": \\"pkg/cmd/repo/view/view.go\\", \\"source_sha256\\": \\"8e7eff1f24434e44274cff27f39ace5574c9d7e974e747a859f2c38661d6d6cf\\"}, {\\"new_text\\": \\"import (\\\\n\\\\t\\\\\\"errors\\\\\\"\\\\n\\\\t\\\\\\"fmt\\\\\\"\\\\n\\\\t\\\\\\"io/ioutil\\\\\\"\\\\n\\\\t\\\\\\"net/http\\\\\\"\\\\n\\\\t\\\\\\"os\\\\\\"\\\\n\\\\t\\\\\\"strings\\\\\\"\\", \\"old_text\\": \\"import (\\\\n\\\\t\\\\\\"errors\\\\\\"\\\\n\\\\t\\\\\\"fmt\\\\\\"\\\\n\\\\t\\\\\\"net/http\\\\\\"\\\\n\\\\t\\\\\\"strings\\\\\\"\\", \\"path\\": \\"pkg/cmd/repo/view/view.go\\", \\"source_sha256\\": \\"8e7eff1f24434e44274cff27f39ace5574c9d7e974e747a859f2c38661d6d6cf\\"}]}","name":"apply_edits"},"id":"call_-7246143194570680015","index":0,"type":"function"}]},{"content":"{\\"ok\\":true,\\"output\\":{\\"base_commit\\":\\"f17d9672f50c5ec96816abb4924e0c0149f24036\\",\\"changed_paths\\":[\\"pkg/cmd/repo/view/view.go\\",\\"pkg/cmd/repo/view/view.go\\",\\"pkg/cmd/repo/view/view.go\\",\\"pkg/cmd/repo/view/view.go\\"]}}","role":"tool","tool_call_id":"call_-7246143194570680015"},{"content":"DELIVERED BASE EVIDENCE (untrusted relevance):\\nh0 pkg/cmd/repo/view/view.go@base:1-100\\nh1 pkg/cmd/repo/view/view.go@base:101-197\\nh2 pkg/cmd/repo/view/http.go@base:1-53\\nh3 pkg/cmd/pr/shared/lookup.go@base:36\\nh4 pkg/cmd/repo/view/view_test.go@base:229\\nh5 pkg/cmd/repo/view/view_test.go@base:27\\nh6 pkg/cmd/pr/shared/lookup.go@base:82\\nh7 pkg/cmd/repo/view/view_test.go@base:292\\nh8 pkg/cmd/repo/view/view_test.go@base:362\\nh9 pkg/cmd/pr/merge/merge_test.go@base:339\\nh10 pkg/cmd/pr/status/status.go@base:87\\nh11 pkg/cmd/pr/status/status_test.go@base:191\\nh12 pkg/cmd/repo/fork/fork.go@base:47\\nh13 pkg/cmd/pr/status/status.go@base:145\\nh14 pkg/cmd/pr/status/status_test.go@base:157\\nh15 pkg/cmd/pr/status/status_test.go@base:174\\nh16 pkg/cmd/pr/status/status_test.go@base:129\\nh17 pkg/cmd/repo/fork/fork.go@base:214\\nh18 pkg/cmd/repo/fork/fork.go@base:193\\nh19 pkg/cmd/factory/default.go@base:60\\nh20 pkg/cmd/repo/view/view.go@base:1-99\\nh21 pkg/cmd/repo/view/view.go@base:100-197\\nh22 pkg/cmd/repo/view/view.go@base:99-196\\nh23 pkg/cmd/repo/view/view.go@base:100-196\\nh24 pkg/cmd/repo/view/view.go@base:112\\nh25 pkg/cmd/repo/view/http.go@base:38\\nh26 pkg/cmd/repo/view/view.go@base:154\\nh27 pkg/cmd/repo/view/view.go@base:128\\nh28 pkg/cmd/repo/view/view.go@base:152\\nh29 pkg/cmd/repo/view/http.go@base:20\\nh30 pkg/cmd/repo/view/http.go@base:27\\nh31 pkg/cmd/repo/view/http.go@base:47\\nShowing 32 of 45 eligible observations (offset 0); omitted evidence remains in the archive. Call submit_context_handles_v2 once with summary and context_handles. Choose only useful listed handles; empty means no selected context.","role":"user"},{"content":"This is the single terminal evidence review within the original budgets. Use submit_context_handles_v2 only.","role":"user"}],"tools":[{"function":{"description":"Sub