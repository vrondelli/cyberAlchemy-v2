{"path":"documentation/examples/17-special-elements/06-svelte-body/App.svelte","source_sha256":"680883a18d47e2fc4256b09260d4a082e94223b88b38b31d7ba67247e5b069ad","utf8":"<script>\n\tlet hereKitty = false;\n\n\tconst handleMouseenter = () => (hereKitty = true);\n\tconst handleMouseleave = () => (hereKitty = false);\n</script>\n\n<svelte:body on:mouseenter={handleMouseenter} on:mouseleave={handleMouseleave} />\n\n<!-- creative commons BY-NC http://www.pngall.com/kitten-png/download/7247 -->\n<img\n\tclass:curious={hereKitty}\n\talt=\"Kitten wants to know what's going on\"\n\tsrc=\"/tutorial/kitten.png\"\n/>\n\n<style>\n\timg {\n\t\tposition: absolute;\n\t\tleft: 0;\n\t\tbottom: -60px;\n\t\ttransform: translate(-80%, 0) rotate(-30deg);\n\t\ttransform-origin: 100% 100%;\n\t\ttransition: transform 0.4s;\n\t}\n\n\t.curious {\n\t\ttransform: translate(-15%, 0) rotate(0deg);\n\t}\n\n\t:global(body) {\n\t\toverflow: hidden;\n\t}\n</style>\n"}