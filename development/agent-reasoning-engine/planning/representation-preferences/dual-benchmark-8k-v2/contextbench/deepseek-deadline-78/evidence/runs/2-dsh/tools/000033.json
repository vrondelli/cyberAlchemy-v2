9c245529ba5d0ddab8d2fe9c6d","start_line":32,"total_lines":667,"utf8":"The simdjson library offers a simple DOM tree API, which you can access by creating a"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":23,"end_line":635,"path":"doc/dom.md","read_id":"fcf8d01c25354434085b6caf84d0fd6885d8605b922f0057cb88fbf6ee44ca9c","retrieval_handle":"observed-read:fcf8d01c25354434085b6caf84d0fd6885d8605b922f0057cb88fbf6ee44ca9c","source_revision":"base","source_sha256":"4524a04469a0fce6db04218654f9417af1ad3e9c245529ba5d0ddab8d2fe9c6d","start_line":635,"total_lines":667,"utf8":"Best Use of the DOM API"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":392,"end_line":638,"path":"doc/dom.md","read_id":"6cc9e21657dace0cd10683e81360426c1b4bd475ec49581adc0da25862017269","retrieval_handle":"observed-read:6cc9e21657dace0cd10683e81360426c1b4bd475ec49581adc0da25862017269","source_revision":"base","source_sha256":"4524a04469a0fce6db04218654f9417af1ad3e9c245529ba5d0ddab8d2fe9c6d","start_line":638,"total_lines":667,"utf8":"The simdjson API provides access to the JSON DOM (document-object-model) content as a tree of `dom::element` instances, each representing an object, an array or an atomic type (null, true, false, number). These `dom::element` instances are lightweight objects (e.g., spanning 16 bytes) and it might be advantageous to pass them by value, as opposed to passing them by reference or by pointer."},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":96,"end_line":62,"path":"doc/iterate_many.md","read_id":"26e1675e17f3340d12155f021799b56781187b8d9a4ebc54b72e18f749dbcb5e","retrieval_handle":"observed-read:26e1675e17f3340d12155f021799b56781187b8d9a4ebc54b72e18f749dbcb5e","source_revision":"base","source_sha256":"6032e2f12e5b49575e2e39acfff757ac00e791f555c7e2380ef554bdd0ba0466","start_line":62,"total_lines":287,"utf8":"Unlike the popular parser RapidJson, our DOM does not require the buffer once the parsing job is"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":99,"end_line":63,"path":"doc/iterate_many.md","read_id":"4407224bf99084368a73d3dfed3748d24014fe33b272aaaa0393c91ce188cfaf","retrieval_handle":"observed-read:4407224bf99084368a73d3dfed3748d24014fe33b272aaaa0393c91ce188cfaf","source_revision":"base","source_sha256":"6032e2f12e5b49575e2e39acfff757ac00e791f555c7e2380ef554bdd0ba0466","start_line":63,"total_lines":287,"utf8":"completed,  the DOM and the buffer are completely independent. The drawback of this architecture is"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":83,"end_line":7,"path":"doc/ondemand_design.md","read_id":"9cb69c43efa3c51731f890076c86a98e9789cef2735c93cb375f36c176b03405","retrieval_handle":"observed-read:9cb69c43efa3c51731f890076c86a98e9789cef2735c93cb375f36c176b03405","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":7,"total_lines":782,"utf8":"- The most established approach is the construction of document-object-model (DOM)."},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":104,"end_line":11,"path":"doc/ondemand_design.md","read_id":"fec76df4977515732c64296fb54af0025d62c119094013c41ce65e70bfe9b8b9","retrieval_handle":"observed-read:fec76df4977515732c64296fb54af0025d62c119094013c41ce65e70bfe9b8b9","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":11,"total_lines":782,"utf8":"We propose an approach that is as easy to use and often as flexible as the DOM approach, yet as fast and"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":62,"end_line":13,"path":"doc/ondemand_design.md","read_id":"a200827279134b64454e13773c402b76a1ef27031436af393c01ad0c2dbe5b7d","retrieval_handle":"observed-read:a200827279134b64454e13773c402b76a1ef27031436af393c01ad0c2dbe5b7d","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":13,"total_lines":782,"utf8":"simdjson On Demand API offers a familiar, friendly DOM API and"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":93,"end_line":16,"path":"doc/ondemand_design.md","read_id":"014dad5d92602f40b8f690e05493aadd342d437f7156062f7a2b32dae66c5548","retrieval_handle":"observed-read:014dad5d92602f40b8f690e05493aadd342d437f7156062f7a2b32dae66c5548","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":16,"total_lines":782,"utf8":"To achieve ease of use, we mimicked the *form* of a traditional DOM API: you can iterate over"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":93,"end_line":19,"path":"doc/ondemand_design.md","read_id":"494d4762df66c889b3135ddaac5287046da2717ba2ec61db1cd323bb392913a2","retrieval_handle":"observed-read:494d4762df66c889b3135ddaac5287046da2717ba2ec61db1cd323bb392913a2","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":19,"total_lines":782,"utf8":"To achieve performance, we introduced some key limitations that make the DOM API *streaming*:"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":15,"end_line":95,"path":"doc/ondemand_design.md","read_id":"503d1e72c361dea49a43c6c29cd5f476de625a726591dc9a6c59be381bc11d1f","retrieval_handle":"observed-read:503d1e72c361dea49a43c6c29cd5f476de625a726591dc9a6c59be381bc11d1f","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":95,"total_lines":782,"utf8":"### DOM Parsers"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":115,"end_line":97,"path":"doc/ondemand_design.md","read_id":"82d22ccfe09d811a6e6e4f8ab16758ff753d8da3e60e13baa7031982ab41cfd6","retrieval_handle":"observed-read:82d22ccfe09d811a6e6e4f8ab16758ff753d8da3e60e13baa7031982ab41cfd6","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":97,"total_lines":782,"utf8":"Many of the most usable, popular JSON APIs (including simdjson) deserialize into a **DOM**: an intermediate tree of"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":118,"end_line":98,"path":"doc/ondemand_design.md","read_id":"02b061cd53782da386e364d488d69176e62eb1d6b5ee87a4fe74d7909c754aed","retrieval_handle":"observed-read:02b061cd53782da386e364d488d69176e62eb1d6b5ee87a4fe74d7909c754aed","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":98,"total_lines":782,"utf8":"objects, arrays and values. In this model, we convert the input data all at once into a tree-like structure (the DOM)."},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":105,"end_line":99,"path":"doc/ondemand_design.md","read_id":"f6cba980a332b304ceb887b7a4c7eb8ac3d60990c1a90146e02db1ffeb155a71","retrieval_handle":"observed-read:f6cba980a332b304ceb887b7a4c7eb8ac3d60990c1a90146e02db1ffeb155a71","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":99,"total_lines":782,"utf8":"The DOM is then accessed by the programmer like any other in-memory data structure. The resulting API let"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":76,"end_line":104,"path":"doc/ondemand_design.md","read_id":"f3b4b457f69011d5a02d0b41b3b3ee7e836990d196c184459389d7e1f2740b1e","retrieval_handle":"observed-read:f3b4b457f69011d5a02d0b41b3b3ee7e836990d196c184459389d7e1f2740b1e","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":104,"total_lines":782,"utf8":"The DOM approach is conceptually simple and \"programmer friendly\". Using the"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":83,"end_line":105,"path":"doc/ondemand_design.md","read_id":"e1fb27df795e4c059afb6fc29032d1f93e2637fdf027173df187f1a4a8480314","retrieval_handle":"observed-read:e1fb27df795e4c059afb6fc29032d1f93e2637fdf027173df187f1a4a8480314","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":105,"total_lines":782,"utf8":"DOM tree is often easy enough that many users use the DOM as-is instead of creating"},{"base_commit":"c5c43e9c7ff613bf01ca14b9b9083d38a6efd5fc","byte_count":100,"end_line":108,"path":"doc/ondemand_design.md","read_id":"5bcf2b09d518c75db84db862e65217330a1497135618dd6f9f7ae11a7c32add8","retrieval_handle":"observed-read:5bcf2b09d518c75db84db862e65217330a1497135618dd6f9f7ae11a7c32add8","source_revision":"base","source_sha256":"f346ddb1898ec9ced9ff43e693fc04d27eb227d0a73a64e0a82b493df01efa3c","start_line":108,"total_lines":782,"utf8":"The DOM approach was the only way to parse JSON documents up to version 0.6 of the simdjson library."}],"scanned_matching_files":26,"search_engine":"git-grep-literal","skipped":[],"total":128}}}