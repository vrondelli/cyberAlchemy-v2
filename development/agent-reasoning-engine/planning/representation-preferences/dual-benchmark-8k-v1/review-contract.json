{
  "schema_version": "are.dual8k-review/v1",
  "authority_effect": "none",
  "status": "pre-live-ready-for-frozen-bounded-development",
  "context_ceiling_tokens": 8000,
  "ceiling_includes": [
    "input",
    "tool-and-schema-overhead",
    "maximum-output"
  ],
  "minimum_cumulative_token_reduction": 0.15,
  "cost_formula": "1 - sum(treatment_logical_input_plus_output) / sum(control_logical_input_plus_output)",
  "cost_scope": "all model calls needed for matched long tasks, including repeated history, memory, reasoning and failed attempts",
  "shared_prefix_logical_charges": 2,
  "shared_prefix_physical_charges": 1,
  "benchmark_results_pooled": false,
  "planned_slots_fixed": true,
  "unknown_usage_permits_success": false,
  "quality_and_completion_nonregression_required": true,
  "existing_quality_gates_preserved": true,
  "postfreeze_task_replacement_allowed": false,
  "automatic_model_retries": 0,
  "initial_workers_per_benchmark": 2,
  "initial_workers_global": 4,
  "conditional_workers_per_benchmark": 4,
  "conditional_workers_global": 8,
  "scaling_prerequisites": [
    "complete valid four-total representative evidence",
    "exact usage",
    "no duplicate attempts",
    "no provider capacity failures",
    "remaining global budget",
    "frozen matched capacity probe"
  ],
  "budget_policy": "global atomic in-flight reservations or immutable non-overlapping branch allocations; unresolved usage retains reservation",
  "freeze_fields": [
    "dataset and source digests",
    "exact task IDs and partition exposure",
    "long-history eligibility",
    "arm protocol and order",
    "model profile",
    "prompt and output caps",
    "scorer",
    "quality gates",
    "token gates",
    "global and branch budgets",
    "stop rules",
    "code digests"
  ],
  "clearance_rejections": [
    "source or manifest drift",
    "gold exposure",
    "unmatched histories",
    "scorer change",
    "unknown usage",
    "hidden retries",
    "incomplete planned slots",
    "missing receipts",
    "quality regression",
    "completion regression",
    "cumulative reduction below 0.15"
  ],
  "claim_scope": "bounded development evidence; no full benchmark or release qualification",
  "code_review": {
    "status": "passed",
    "offline_tests_passed": 16,
    "evidence": [
      "PREFLIGHT-REVIEW.json",
      "PREFLIGHT-REVIEW.md"
    ],
    "blocking_findings": []
  },
  "open_questions_ref": "REVIEW.md#open-questions"
}
