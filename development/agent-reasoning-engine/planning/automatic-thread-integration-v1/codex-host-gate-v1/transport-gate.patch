+//! Opt-in gate at the HTTP attempt boundary. Host lifecycle wiring is separate.
+
+use crate::HttpClient;
+use crate::HttpTransport;
+use crate::Request;
+use crate::RequestCompression;
+use crate::ReqwestTransport;
+use crate::Response;
+use crate::StreamResponse;
+use crate::TransportError;
+use std::future::Future;
+use std::time::Duration;
+
+/// Authorizes exactly one immutable, prepared HTTP request per invocation.
+///
+/// The host implementation must account for full logical context, output reservation,
+/// and concurrent requests. HTTP body length alone is not a token bound. Requests
+/// may contain credentials; implementations must not log their headers or bodies.
+pub trait RequestGate: Send + Sync {
+    fn authorize(&self, request: &Request) -> impl Future<Output = Result<(), GateDenied>> + Send;
+}
+
+/// A denial carries no provider or credential data and cannot become a retryable HTTP error.
+#[derive(Debug, Clone, Copy)]
+pub struct GateDenied;
+
+/// A transport that awaits the gate before each execute or stream call.
+///
+/// This dedicated client disables redirects and internal retries. It does not use
+/// host proxy routing, WebSockets, or compaction hooks and is not selected by default.
+pub struct GatedReqwestTransport<G> {
+    transport: ReqwestTransport,
+    gate: G,
+    gate_timeout: Duration,
+}
+
+impl<G: RequestGate> GatedReqwestTransport<G> {
+    pub fn new(gate: G, gate_timeout: Duration) -> Result<Self, TransportError> {
+        if gate_timeout.is_zero() {
+            return Err(TransportError::Build(
+                "request gate timeout must be positive".into(),
+            ));
+        }
+        let client = reqwest::Client::builder()
+            .redirect(reqwest::redirect::Policy::none())
+            .retry(reqwest::retry::never())
+            .no_proxy()
+            .build()
+            .map_err(|_| TransportError::Build("request gate client construction failed".into()))?;
+        Ok(Self {
+            transport: ReqwestTransport::from_http_client(HttpClient::new_without_request_logging(
+                client,
+            )),
+            gate,
+            gate_timeout,
+        })
+    }
+
+    async fn authorize(&self, request: Request) -> Result<Request, TransportError> {
+        if request.compression != RequestCompression::None
+            || request.headers.contains_key(http::header::CONTENT_ENCODING)
+        {
+            return Err(TransportError::Build(
+                "request gate requires uncompressed input".into(),
+            ));
+        }
+        let request = request
+            .into_prepared()
+            .map_err(|_| TransportError::Build("request gate input preparation failed".into()))?;
+        match tokio::time::timeout(self.gate_timeout, self.gate.authorize(&request)).await {
+            Ok(Ok(())) => Ok(request),
+            Ok(Err(GateDenied)) => Err(TransportError::Build("request gate denied attempt".into())),
+            Err(_) => Err(TransportError::Build("request gate timed out".into())),
+        }
+    }
+}
+
+impl<G: RequestGate> HttpTransport for GatedReqwestTransport<G> {
+    async fn execute(&self, request: Request) -> Result<Response, TransportError> {
+        self.transport.execute(self.authorize(request).await?).await
+    }
+
+    async fn stream(&self, request: Request) -> Result<StreamResponse, TransportError> {
+        self.transport.stream(self.authorize(request).await?).await
+    }
+}
