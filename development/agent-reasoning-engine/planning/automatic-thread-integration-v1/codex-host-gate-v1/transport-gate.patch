+use super::*;
+use bytes::Bytes;
+use futures::StreamExt;
+use http::Method;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::net::TcpListener;
+use tokio::task::JoinHandle;
+
+struct Server {
+    url: String,
+    calls: Arc<AtomicUsize>,
+    bodies: Arc<Mutex<Vec<Vec<u8>>>>,
+    task: JoinHandle<()>,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+async fn server(status: &str) -> Server {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let response = format!(
+        "HTTP/1.1 {status}\r\nLocation: {url}/redirected\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"
+    );
+    let calls = Arc::new(AtomicUsize::new(0));
+    let bodies = Arc::new(Mutex::new(Vec::new()));
+    let count = Arc::clone(&calls);
+    let received = Arc::clone(&bodies);
+    let task = tokio::spawn(async move {
+        while let Ok((mut socket, _)) = listener.accept().await {
+            count.fetch_add(1, Ordering::SeqCst);
+            let mut buffer = Vec::new();
+            let mut chunk = [0; 4096];
+            loop {
+                let size = socket.read(&mut chunk).await.unwrap();
+                if size == 0 {
+                    break;
+                }
+                buffer.extend_from_slice(&chunk[..size]);
+                if let Some(end) = buffer.windows(4).position(|w| w == b"\r\n\r\n") {
+                    let headers = String::from_utf8_lossy(&buffer[..end]);
+                    let length = headers
+                        .lines()
+                        .find_map(|line| {
+                            let (name, value) = line.split_once(':')?;
+                            name.eq_ignore_ascii_case("content-length")
+                                .then(|| value.trim().parse::<usize>().unwrap())
+                        })
+                        .unwrap_or(0);
+                    if buffer.len() >= end + 4 + length {
+                        received.lock().unwrap().push(buffer[end + 4..].to_vec());
+                        break;
+                    }
+                }
+            }
+            let _ = socket.write_all(response.as_bytes()).await;
+        }
+    });
+    Server {
+        url,
+        calls,
+        bodies,
+        task,
+    }
+}
+
+struct QuotaGate {
+    calls: Arc<AtomicUsize>,
+    maximum: usize,
+    bodies: Arc<Mutex<Vec<Bytes>>>,
+}
+
+impl RequestGate for QuotaGate {
+    async fn authorize(&self, request: &Request) -> Result<(), GateDenied> {
+        self.bodies
+            .lock()
+            .unwrap()
+            .push(request.prepare_body_for_send().unwrap().body_bytes());
+        if self.calls.fetch_add(1, Ordering::SeqCst) < self.maximum {
+            Ok(())
+        } else {
+            Err(GateDenied)
+        }
+    }
+}
+
+fn transport(maximum: usize) -> (GatedReqwestTransport<QuotaGate>, Arc<AtomicUsize>) {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let gate = QuotaGate {
+        calls: Arc::clone(&calls),
+        maximum,
+        bodies: Arc::default(),
+    };
+    (
+        GatedReqwestTransport::new(gate, Duration::from_secs(1)).unwrap(),
+        calls,
+    )
+}
+
+fn request(server: &Server) -> Request {
+    Request::new(Method::POST, server.url.clone())
+        .with_json(&serde_json::json!({"input":"synthetic context", "max_output_tokens":8}))
+}
+
+#[tokio::test]
+async fn denials_prevent_both_dispatch_paths() {
+    let server = server("200 OK").await;
+    let (transport, calls) = transport(0);
+    assert!(matches!(
+        transport.execute(request(&server)).await,
+        Err(TransportError::Build(_))
+    ));
+    assert!(matches!(
+        transport.stream(request(&server)).await,
+        Err(TransportError::Build(_))
+    ));
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    assert_eq!(server.calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn gate_observes_exact_dispatched_body_on_both_paths() {
+    let server = server("200 OK").await;
+    let (transport, calls) = transport(2);
+    assert_eq!(
+        transport.execute(request(&server)).await.unwrap().body,
+        Bytes::from_static(b"ok")
+    );
+    let chunks: Vec<_> = transport
+        .stream(request(&server))
+        .await
+        .unwrap()
+        .bytes
+        .collect()
+        .await;
+    assert_eq!(
+        chunks
+            .into_iter()
+            .map(Result::unwrap)
+            .flatten()
+            .collect::<Vec<_>>(),
+        b"ok"
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    let observed: Vec<Vec<u8>> = transport
+        .gate
+        .bodies
+        .lock()
+        .unwrap()
+        .iter()
+        .map(|body| body.to_vec())
+        .collect();
+    assert_eq!(observed, *server.bodies.lock().unwrap());
+}
+
+#[tokio::test]
+async fn repeated_request_cannot_reuse_previous_permission() {
+    let server = server("200 OK").await;
+    let (transport, calls) = transport(1);
+    let request = request(&server);
+    transport.execute(request.clone()).await.unwrap();
+    assert!(matches!(
+        transport.stream(request).await,
+        Err(TransportError::Build(_))
+    ));
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    assert_eq!(server.calls.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn redirects_and_retryable_statuses_never_dispatch_internally() {
+    for status in [
+        "307 Temporary Redirect",
+        "429 Too Many Requests",
+        "503 Service Unavailable",
+    ] {
+        let server = server(status).await;
+        let (transport, calls) = transport(2);
+        assert!(matches!(
+            transport.execute(request(&server)).await,
+            Err(TransportError::Http { .. })
+        ));
+        assert!(matches!(
+            transport.stream(request(&server)).await,
+            Err(TransportError::Http { .. })
+        ));
+        assert_eq!(calls.load(Ordering::SeqCst), 2, "{status}");
+        assert_eq!(server.calls.load(Ordering::SeqCst), 2, "{status}");
+    }
+}
+
+#[tokio::test]
+async fn compressed_inputs_stop_before_gate_and_network() {
+    let server = server("200 OK").await;
+    let (transport, calls) = transport(10);
+    let mut compressed = request(&server);
+    compressed.compression = RequestCompression::Zstd;
+    let prepared = compressed.clone().into_prepared().unwrap();
+    for request in [compressed, prepared] {
+        assert!(matches!(
+            transport.execute(request).await,
+            Err(TransportError::Build(_))
+        ));
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert_eq!(server.calls.load(Ordering::SeqCst), 0);
+}
+
+struct WaitingGate;
+impl RequestGate for WaitingGate {
+    async fn authorize(&self, _request: &Request) -> Result<(), GateDenied> {
+        std::future::pending().await
+    }
+}
+
+#[tokio::test]
+async fn gate_timeout_prevents_network() {
+    let server = server("200 OK").await;
+    let transport = GatedReqwestTransport::new(WaitingGate, Duration::from_millis(20)).unwrap();
+    assert!(matches!(
+        transport.execute(request(&server)).await,
+        Err(TransportError::Build(_))
+    ));
+    assert!(matches!(
+        transport.stream(request(&server)).await,
+        Err(TransportError::Build(_))
+    ));
+    assert_eq!(server.calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn cancelling_pending_gate_prevents_network() {
+    let server = server("200 OK").await;
+    let transport = GatedReqwestTransport::new(WaitingGate, Duration::from_secs(10)).unwrap();
+    assert!(
+        tokio::time::timeout(
+            Duration::from_millis(20),
+            transport.execute(request(&server))
+        )
+        .await
+        .is_err()
+    );
+    assert_eq!(server.calls.load(Ordering::SeqCst), 0);
+}
