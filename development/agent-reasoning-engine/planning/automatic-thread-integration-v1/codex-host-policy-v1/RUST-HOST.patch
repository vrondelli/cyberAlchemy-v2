+//! Opt-in host behavior: permit, deny, disable delta transport, and intercept compaction.
+use codex_client::ContextGateConfig;
+use codex_protocol::protocol::{EventMsg, Op};
+use core_test_support::responses::{self, ev_assistant_message, ev_completed_with_tokens, sse};
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::{Value, json};
+use wiremock::matchers::{method, path};
+use wiremock::{Mock, MockServer, ResponseTemplate};
+
+async fn start(test: &core_test_support::test_codex::TestCodex, text: &str) -> anyhow::Result<()> {
+    test.codex
+        .start_or_steer_turn(codex_core::TurnInputRequest::user_input(vec![
+            codex_protocol::user_input::UserInput::Text {
+                text: text.into(),
+                text_elements: vec![],
+            },
+        ]))
+        .await?;
+    Ok(())
+}
+
+async fn policy(action: &'static str) -> MockServer {
+    let server = MockServer::start().await;
+    Mock::given(method("POST")).and(path("/decision")).respond_with(move |request: &wiremock::Request| {
+        let body: Value = serde_json::from_slice(&request.body).expect("valid offline fixture");
+        ResponseTemplate::new(200).set_body_json(json!({"version":1,"scope":body["scope"],"request_id":body["request_id"],"request_digest":body["request_digest"],"action":action}))
+    }).mount(&server).await;
+    server
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn context_gate_denial_stops_without_provider_request() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let policy = policy("recycle").await;
+    let gate = ContextGateConfig::new(format!("{}/decision", policy.uri()), "scope".into(), 32)
+        .expect("valid offline fixture");
+    let test = test_codex()
+        .with_config(move |config| config.experimental_context_gate = Some(gate))
+        .build_with_auto_env(&server)
+        .await?;
+    start(&test, "bounded fixture").await?;
+    wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(
+        policy
+            .received_requests()
+            .await
+            .expect("valid offline fixture")
+            .len(),
+        1
+    );
+    assert!(
+        !server
+            .received_requests()
+            .await
+            .expect("valid offline fixture")
+            .iter()
+            .any(|r| r.method == "POST" && r.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn context_gate_allows_full_http_request_with_output_cap() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let policy = policy("continue").await;
+    let mock = responses::mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("m", "fixture"),
+            ev_completed_with_tokens("r", 10),
+        ]),
+    )
+    .await;
+    let gate = ContextGateConfig::new(format!("{}/decision", policy.uri()), "scope".into(), 32)
+        .expect("valid offline fixture");
+    let test = test_codex()
+        .with_config(move |config| {
+            config.experimental_context_gate = Some(gate);
+            config.model_provider.supports_websockets = true;
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    start(&test, "bounded fixture").await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let sent = mock.single_request().body_json();
+    assert_eq!(sent["max_output_tokens"], 32);
+    assert_eq!(sent["store"], false);
+    let observed: Value = serde_json::from_slice(
+        &policy
+            .received_requests()
+            .await
+            .expect("valid offline fixture")[0]
+            .body,
+    )?;
+    assert_eq!(
+        serde_json::from_str::<Value>(observed["body"].as_str().expect("valid offline fixture"))?,
+        sent
+    );
+    assert!(
+        !server
+            .received_requests()
+            .await
+            .expect("valid offline fixture")
+            .iter()
+            .any(|r| r.headers.contains_key("upgrade"))
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn context_gate_stops_manual_compaction_even_when_peer_permits() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let policy = policy("continue").await;
+    let gate = ContextGateConfig::new(format!("{}/decision", policy.uri()), "scope".into(), 32)
+        .expect("valid offline fixture");
+    let test = test_codex()
+        .with_config(move |config| config.experimental_context_gate = Some(gate))
+        .build_with_auto_env(&server)
+        .await?;
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    let requests = policy
+        .received_requests()
+        .await
+        .expect("valid offline fixture");
+    assert_eq!(requests.len(), 1);
+    let body: Value = serde_json::from_slice(&requests[0].body)?;
+    assert_eq!(body["kind"], "native_compaction");
+    assert!(
+        !server
+            .received_requests()
+            .await
+            .expect("valid offline fixture")
+            .iter()
+            .any(|r| r.method == "POST")
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn context_gate_stops_pre_turn_compaction() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let policy = policy("continue").await;
+    let mock = responses::mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("m", "fixture"),
+            ev_completed_with_tokens("r", 2_000_000),
+        ]),
+    )
+    .await;
+    let gate = ContextGateConfig::new(format!("{}/decision", policy.uri()), "scope".into(), 32)
+        .expect("valid offline fixture");
+    let test = test_codex()
+        .with_config(move |config| {
+            config.experimental_context_gate = Some(gate);
+            config.model_auto_compact_token_limit = Some(100_000);
+            config.model_context_window = Some(1_000_000);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    start(&test, "first bounded fixture").await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    start(&test, "next fixture").await?;
+    let event = wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    let EventMsg::Error(error) = event else {
+        unreachable!("error predicate")
+    };
+    assert!(error.message.contains("ARE requires fresh context"));
+    assert_eq!(mock.requests().len(), 1);
+    let requests = policy
+        .received_requests()
+        .await
+        .expect("valid offline fixture");
+    let kinds: Vec<Value> = requests
+        .iter()
+        .map(|r| {
+            serde_json::from_slice::<Value>(&r.body).expect("valid offline fixture")["kind"].clone()
+        })
+        .collect();
+    assert_eq!(kinds, vec![json!("provider"), json!("native_compaction")]);
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn context_gate_rechecks_endpoint_retry_and_stops_outer_retry() -> anyhow::Result<()> {
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let server = responses::start_mock_server().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(ResponseTemplate::new(503))
+        .mount(&server)
+        .await;
+    let policy = MockServer::start().await;
+    let calls = Arc::new(AtomicUsize::new(0));
+    let count = Arc::clone(&calls);
+    Mock::given(method("POST")).respond_with(move |request: &wiremock::Request| {
+        let body: Value = serde_json::from_slice(&request.body).expect("valid offline fixture");
+        let action = if count.fetch_add(1, Ordering::SeqCst) == 0 { "continue" } else { "recycle" };
+        ResponseTemplate::new(200).set_body_json(json!({"version":1,"scope":body["scope"],"request_id":body["request_id"],"request_digest":body["request_digest"],"action":action}))
+    }).mount(&policy).await;
+    let gate = ContextGateConfig::new(format!("{}/decision", policy.uri()), "scope".into(), 32)
+        .expect("valid offline fixture");
+    let test = test_codex()
+        .with_config(move |config| {
+            config.experimental_context_gate = Some(gate);
+            config.model_provider.request_max_retries = Some(2);
+            config.model_provider.stream_max_retries = Some(2);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    start(&test, "retry fixture").await?;
+    wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    assert_eq!(
+        server
+            .received_requests()
+            .await
+            .expect("valid offline fixture")
+            .iter()
+            .filter(|r| r.method == "POST" && r.url.path().ends_with("/responses"))
+            .count(),
+        1
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "run with the explicit offline ARE Node service runner"]
+async fn context_gate_real_are_peer() -> anyhow::Result<()> {
+    let endpoint = std::env::var("ARE_OFFLINE_TEST_POLICY_ENDPOINT")?;
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("m", "offline canary reply"),
+            ev_completed_with_tokens("r", 10),
+        ]),
+    )
+    .await;
+    let gate = ContextGateConfig::new(endpoint, "fixture-scope".into(), 32)
+        .expect("valid offline fixture");
+    let test = test_codex()
+        .with_config(move |config| {
+            config.experimental_context_gate = Some(gate);
+            config.model = Some("gpt-5.1".into());
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    start(&test, "offline ARE host canary").await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(mock.single_request().body_json()["model"], "gpt-5.1");
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    assert_eq!(mock.requests().len(), 1);
+    Ok(())
+}
