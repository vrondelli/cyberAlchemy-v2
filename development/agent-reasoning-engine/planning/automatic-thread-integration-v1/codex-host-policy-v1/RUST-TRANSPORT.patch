+//! Offline bridge probe. Arguments contain only synthetic loopback test configuration.
+use codex_http_client::{ContextGateConfig, ContextGateTransport, HttpTransport, Request};
+use http::Method;
+
+#[tokio::main(flavor = "current_thread")]
+async fn main() {
+    let args: Vec<_> = std::env::args().collect();
+    let config = ContextGateConfig::new(args[1].clone(), "fixture-scope".into(), 32).unwrap();
+    let result = if args[2] == "compact" {
+        config.before_compaction().await.map_err(|_| ())
+    } else {
+        let transport = ContextGateTransport::gated(config).unwrap();
+        let body: serde_json::Value = serde_json::from_str(&args[3]).unwrap();
+        transport
+            .execute(Request::new(Method::POST, args[2].clone()).with_json(&body))
+            .await
+            .map(|_| ())
+            .map_err(|_| ())
+    };
+    println!("{}", if result.is_ok() { "allowed" } else { "stopped" });
+}
