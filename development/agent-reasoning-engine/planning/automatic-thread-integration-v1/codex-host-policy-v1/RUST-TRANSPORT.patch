+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn unsupported_request_stops_without_contacting_policy_or_provider() {
+    let gate =
+        ContextGateConfig::new("http://127.0.0.1:1/decision".into(), "scope".into(), 32).unwrap();
+    let transport = ContextGateTransport::gated(gate).unwrap();
+    for url in [
+        "https://example.com/responses",
+        "http://127.0.0.1:1/responses/compact",
+        "http://127.0.0.1:1/responses?secret=synthetic",
+    ] {
+        let error = transport
+            .execute(Request::new(http::Method::POST, url.into()).with_json(&json!({"input":[]})))
+            .await
+            .unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            TransportError::Build("ARE unsupported request path".into()).to_string()
+        );
+    }
+}
+
+#[tokio::test]
+async fn missing_policy_stops_requests_and_compaction() {
+    let gate =
+        ContextGateConfig::new("http://127.0.0.1:1/decision".into(), "scope".into(), 32).unwrap();
+    assert!(gate.before_compaction().await.is_err());
+    let transport = ContextGateTransport::gated(gate).unwrap();
+    assert!(
+        transport
+            .execute(
+                Request::new(http::Method::POST, "http://127.0.0.1:1/responses".into())
+                    .with_json(&json!({"input":[]}))
+            )
+            .await
+            .is_err()
+    );
+}
