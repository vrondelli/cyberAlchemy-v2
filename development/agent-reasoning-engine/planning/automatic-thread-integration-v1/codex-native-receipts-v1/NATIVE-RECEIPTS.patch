+#![cfg(target_os = "linux")]
+//! Native-owned receipts and abrupt-exit recovery against an offline provider.
+#[path = "context_receipt_store.rs"]
+mod receipt_store;
+use codex_client::ContextGateConfig;
+use codex_protocol::protocol::{EventMsg, Op};
+use core_test_support::responses::{self, ev_assistant_message, ev_completed_with_tokens, sse};
+use core_test_support::test_codex::{TestCodex, test_codex};
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use receipt_store::Store;
+use serde_json::{Value, json};
+use std::collections::HashMap;
+use wiremock::matchers::{method, path};
+use wiremock::{Mock, ResponseTemplate};
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "requires the explicit offline recovery supervisor"]
+async fn context_receipts_native_driver() -> anyhow::Result<()> {
+    let endpoint = std::env::var("ARE_OFFLINE_RECEIPT_COORDINATOR")?;
+    anyhow::ensure!(endpoint.starts_with("http://127.0.0.1:"));
+    let client = codex_client::HttpClientBuilder::new()
+        .without_redirects()
+        .without_request_logging()
+        .build_direct()?;
+    let directory = std::env::var("ARE_OFFLINE_RECEIPT_DIRECTORY")?;
+    let binding = std::env::var("ARE_OFFLINE_RECEIPT_BINDING")?;
+    let mut store = Store::open(std::path::Path::new(&directory), &binding)?;
+    let server = responses::start_mock_server().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(sse(vec![
+                    ev_assistant_message("m", "offline-recovery-result"),
+                    ev_completed_with_tokens("r", 10),
+                ])),
+        )
+        .mount(&server)
+        .await;
+    let mut contexts: HashMap<String, (TestCodex, String, bool)> = HashMap::new();
+    let mut reply = json!({"ready":true});
+    loop {
+        let command: Value = client
+            .post(&endpoint)
+            .json(&reply)
+            .send()
+            .await?
+            .error_for_status()?
+            .json()
+            .await?;
+        let kind = command["kind"].as_str().expect("fixture command kind");
+        match kind {
+            "lookup" => {
+                reply = store.lookup(&command["operation"])?;
+            }
+
+            "open" => {
+                if let Some(receipt) = store.context(&command["request"])? {
+                    reply = receipt;
+                    continue;
+                }
+                let handover = command["handover_id"].as_str().expect("handover");
+                let text = command["capsule_text"].as_str().expect("capsule");
+                anyhow::ensure!(text.len() <= 4096, "bounded native fixture capsule");
+                if !contexts.contains_key(handover) {
+                    let gate = ContextGateConfig::new(
+                        command["policy_endpoint"].as_str().expect("policy").into(),
+                        command["scope"].as_str().expect("scope").into(),
+                        32,
+                    )
+                    .expect("offline gate");
+                    let test = test_codex()
+                        .with_config(move |config| {
+                            config.experimental_context_gate = Some(gate);
+                            config.model = Some("gpt-5.1".into());
+                        })
+                        .build_with_auto_env(&server)
+                        .await?;
+                    test.codex.inject_response_items(vec![serde_json::from_value(json!({
+                        "type":"message", "role":"user", "content":[{"type":"input_text","text":text}]
+                    }))?]).await?;
+                    contexts.insert(handover.into(), (test, text.into(), false));
+                }
+                let (test, restored, sealed) = &contexts[handover];
+                assert_eq!(restored, text);
+                assert!(!sealed);
+                let history = test.codex.conversation_history_snapshot().await;
+                let items: Vec<Value> = history
+                    .items()
+                    .map(serde_json::to_value)
+                    .collect::<Result<_, _>>()?;
+                assert!(!items.iter().any(|item| item["role"] == "assistant"));
+                assert_eq!(
+                    items
+                        .iter()
+                        .filter(
+                            |item| item["content"].as_array().is_some_and(|content| content
+                                .iter()
+                                .any(|part| part["text"].as_str() == Some(text)))
+                        )
+                        .count(),
+                    1
+                );
+                reply = json!({"context_id":test.session_configured.session_id.to_string(),"restored":true,"fresh_history":true,
+                    "handover_id":command["request"]["handover_id"],"generation":command["request"]["generation"],"capsule_digest":command["request"]["capsule"]["capsule_digest"],"evidence_ref":"native-receipt:opened"});
+                store.opened(&command["request"], &reply)?;
+                crash_at(&store, &command, "after-open")?;
+            }
+            "step" => {
+                let operation = &command["operation"];
+                let found = store.lookup(operation)?;
+                if found["status"] != "not_started" {
+                    reply = found;
+                    continue;
+                }
+                store.begin(operation)?;
+                crash_at(&store, &command, "before-step")?;
+                let handover = command["handover_id"].as_str().expect("handover");
+                if !contexts.contains_key(handover) {
+                    reply = operation.clone();
+                    reply["status"] = json!("recycle");
+                    reply["provider_sent"] = json!(false);
+                    reply["effects_started"] = json!(false);
+                    reply["evidence_ref"] = json!("native-receipt:lost-context");
+                    store.complete(operation, &reply)?;
+                    continue;
+                }
+                let (test, capsule, sealed) = &contexts[handover];
+                assert!(!sealed);
+                let before = server
+                    .received_requests()
+                    .await
+                    .expect("native requests")
+                    .iter()
+                    .filter(|r| r.method == "POST" && r.url.path() == "/v1/responses")
+                    .count();
+                test.codex
+                    .start_or_steer_turn(codex_core::TurnInputRequest::user_input(vec![
+                        codex_protocol::user_input::UserInput::Text {
+                            text: command["input"].as_str().expect("input").into(),
+                            text_elements: vec![],
+                        },
+                    ]))
+                    .await?;
+                let event = wait_for_event(&test.codex, |e| {
+                    matches!(e, EventMsg::Error(_) | EventMsg::TurnComplete(_))
+                })
+                .await;
+                let stopped = matches!(event, EventMsg::Error(_));
+                if stopped {
+                    wait_for_event(&test.codex, |e| matches!(e, EventMsg::TurnComplete(_))).await;
+                }
+                let requests: Vec<_> = server
+                    .received_requests()
+                    .await
+                    .expect("native requests")
+                    .into_iter()
+                    .filter(|r| r.method == "POST" && r.url.path() == "/v1/responses")
+                    .collect();
+                if stopped {
+                    assert_eq!(requests.len(), before);
+                } else {
+                    assert_eq!(requests.len(), before + 1);
+                    let body: Value = serde_json::from_slice(
+                        &requests.last().expect("native provider request").body,
+                    )?;
+                    assert_eq!(body["max_output_tokens"], 32);
+                    assert_eq!(body["store"], false);
+                    let input = body["input"].as_array().expect("full input");
+                    let restored = input
+                        .iter()
+                        .filter(|item| {
+                            item["content"].as_array().is_some_and(|content| {
+                                content
+                                    .iter()
+                                    .any(|part| part["text"].as_str() == Some(capsule))
+                            })
+                        })
+                        .count();
+                    assert_eq!(restored, 1);
+                }
+                store.audit(&json!({"kind":"provider","operation_id":operation["operation_id"],"item_id":operation["item"]["id"],"provider_calls":requests.len()-before}))?;
+                crash_at(&store, &command, "after-provider")?;
+                reply = client.post(format!("{endpoint}/classify")).json(&json!({"operation":operation,"stopped":stopped,"provider_calls":requests.len()-before})).send().await?.error_for_status()?.json().await?;
+                store.complete(operation, &reply)?;
+                crash_at(&store, &command, "after-receipt")?;
+            }
+            "seal" => {
+                let handover = command["handover_id"].as_str().expect("handover");
+                if let Some((test, _, sealed)) = contexts.get_mut(handover)
+                    && !*sealed
+                {
+                    test.codex.submit(Op::Shutdown).await?;
+                    wait_for_event(&test.codex, |e| matches!(e, EventMsg::ShutdownComplete)).await;
+                    *sealed = true;
+                }
+                reply = store.seal(&command["context"])?;
+                crash_at(&store, &command, "after-seal")?;
+            }
+            "finish" => break,
+            other => anyhow::bail!("unsupported fixture command {other}"),
+        }
+    }
+    Ok(())
+}
+
+fn crash_at(store: &Store, command: &Value, boundary: &str) -> anyhow::Result<()> {
+    if command["fault"] == boundary {
+        store.audit(&json!({"kind":"intentional-abrupt-exit","boundary":boundary}))?;
+        // Intentional fixture crash: no destructors, no acknowledgement, kernel releases lock.
+        std::process::exit(86);
+    }
+    Ok(())
+}
