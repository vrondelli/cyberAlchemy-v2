+//! Linux offline native-driver receipt store. Checksums detect accidental corruption;
+//! exact records bind requests. This is not a hostile-store authentication boundary.
+use anyhow::{Context, ensure};
+use serde_json::{Value, json};
+use sha1::{Digest, Sha1};
+use std::fs::{self, File, OpenOptions};
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::{Path, PathBuf};
+
+pub struct Store {
+    root: PathBuf,
+    _lock: File,
+    state: Value,
+}
+impl Store {
+    pub fn open(root: &Path, binding: &str) -> anyhow::Result<Self> {
+        ensure!(!binding.is_empty(), "store binding required");
+        fs::create_dir_all(root)?;
+        let lock = OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .read(true)
+            .write(true)
+            .mode(0o600)
+            .open(root.join("writer.lock"))?;
+        lock.try_lock().context("native receipt writer busy")?;
+        let file = root.join("receipts.json");
+        let state = if file.exists() {
+            ensure!(
+                fs::metadata(&file)?.len() <= 4_194_304,
+                "receipt store too large"
+            );
+            let envelope: Value = serde_json::from_slice(&fs::read(file)?)?;
+            let payload = envelope["payload"]
+                .as_str()
+                .context("receipt payload missing")?;
+            ensure!(
+                envelope["checksum"] == format!("{:x}", Sha1::digest(payload.as_bytes())),
+                "receipt integrity failed"
+            );
+            let state: Value = serde_json::from_str(payload)?;
+            ensure!(
+                state["version"] == 1 && state["binding"] == binding,
+                "receipt scope drift"
+            );
+            state
+        } else {
+            json!({"version":1,"binding":binding,"contexts":{},"operations":{}})
+        };
+        let store = Self {
+            root: root.into(),
+            _lock: lock,
+            state,
+        };
+        store.save()?;
+        Ok(store)
+    }
+    fn save(&self) -> anyhow::Result<()> {
+        let payload = serde_json::to_string(&self.state)?;
+        ensure!(payload.len() <= 2_000_000, "receipt store too large");
+        let envelope =
+            json!({"checksum":format!("{:x}",Sha1::digest(payload.as_bytes())),"payload":payload});
+        let temp = self.root.join(format!("{}.tmp", uuid::Uuid::new_v4()));
+        let mut file = OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .mode(0o600)
+            .open(&temp)?;
+        let bytes = serde_json::to_vec(&envelope)?;
+        ensure!(bytes.len() <= 4_194_304, "receipt envelope too large");
+        file.write_all(&bytes)?;
+        file.sync_all()?;
+        fs::rename(temp, self.root.join("receipts.json"))?;
+        File::open(&self.root)?.sync_all()?;
+        Ok(())
+    }
+    pub fn context(&self, request: &Value) -> anyhow::Result<Option<Value>> {
+        let id = request["handover_id"]
+            .as_str()
+            .context("handover required")?;
+        let value = &self.state["contexts"][id];
+        if value.is_null() {
+            return Ok(None);
+        }
+        ensure!(value["request"] == *request, "handover request drift");
+        Ok(Some(value["receipt"].clone()))
+    }
+    pub fn opened(&mut self, request: &Value, receipt: &Value) -> anyhow::Result<()> {
+        ensure!(self.context(request)?.is_none(), "context already stored");
+        let id = request["handover_id"]
+            .as_str()
+            .context("handover required")?;
+        self.state["contexts"][id] = json!({"request":request,"receipt":receipt,"sealed":false});
+        self.save()
+    }
+    fn bound_context(&self, operation: &Value) -> anyhow::Result<()> {
+        let contexts = self.state["contexts"].as_object().context("contexts")?;
+        ensure!(
+            contexts.values().any(|entry| entry["receipt"]["context_id"]
+                == operation["context_id"]
+                && entry["receipt"]["generation"] == operation["generation"]
+                && entry["receipt"]["capsule_digest"] == operation["capsule_digest"]),
+            "unknown context binding"
+        );
+        Ok(())
+    }
+    pub fn lookup(&self, operation: &Value) -> anyhow::Result<Value> {
+        self.bound_context(operation)?;
+        let id = operation["operation_id"]
+            .as_str()
+            .context("operation required")?;
+        let record = &self.state["operations"][id];
+        let mut result = operation.clone();
+        result["evidence_ref"] = json!(format!("native-receipt:{id}"));
+        if record.is_null() {
+            result["status"] = json!("not_started");
+            return Ok(result);
+        }
+        ensure!(record["operation"] == *operation, "operation request drift");
+        if record["receipt"].is_null() {
+            result["status"] = json!("unknown");
+            return Ok(result);
+        }
+        Ok(record["receipt"].clone())
+    }
+    pub fn begin(&mut self, operation: &Value) -> anyhow::Result<()> {
+        ensure!(
+            self.lookup(operation)?["status"] == "not_started",
+            "operation already recorded"
+        );
+        let id = operation["operation_id"]
+            .as_str()
+            .context("operation required")?;
+        self.state["operations"][id] = json!({"operation":operation,"receipt":null});
+        self.save()
+    }
+    pub fn complete(&mut self, operation: &Value, receipt: &Value) -> anyhow::Result<()> {
+        ensure!(
+            self.lookup(operation)?["status"] == "unknown",
+            "operation not pending"
+        );
+        for key in ["operation_id", "context_id", "generation"] {
+            ensure!(receipt[key] == operation[key], "receipt binding drift");
+        }
+        ensure!(
+            receipt["status"] == "completed"
+                || (receipt["status"] == "recycle"
+                    && receipt["provider_sent"] == false
+                    && receipt["effects_started"] == false),
+            "terminal receipt required"
+        );
+        let id = operation["operation_id"]
+            .as_str()
+            .context("operation required")?;
+        self.state["operations"][id]["receipt"] = receipt.clone();
+        self.save()
+    }
+    pub fn seal(&mut self, context: &Value) -> anyhow::Result<Value> {
+        self.bound_context(context)?;
+        let uncertain = self.state["operations"]
+            .as_object()
+            .context("operations")?
+            .values()
+            .filter(|entry| {
+                entry["operation"]["context_id"] == context["context_id"]
+                    && entry["receipt"].is_null()
+            })
+            .count();
+        let mut receipt = context.clone();
+        receipt["sealed"] = json!(uncertain == 0);
+        receipt["pending"] = json!(0);
+        receipt["uncertain"] = json!(uncertain);
+        receipt["evidence_ref"] = json!("native-receipt:sealed");
+        if uncertain == 0 {
+            for entry in self.state["contexts"]
+                .as_object_mut()
+                .context("contexts")?
+                .values_mut()
+            {
+                if entry["receipt"]["context_id"] == context["context_id"] {
+                    entry["sealed"] = json!(true);
+                }
+            }
+            self.save()?;
+        }
+        Ok(receipt)
+    }
+    pub fn audit(&self, value: &Value) -> anyhow::Result<()> {
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .mode(0o600)
+            .open(self.root.join("fixture-audit.jsonl"))?;
+        writeln!(file, "{}", serde_json::to_string(value)?)?;
+        file.sync_all()?;
+        Ok(())
+    }
+}
