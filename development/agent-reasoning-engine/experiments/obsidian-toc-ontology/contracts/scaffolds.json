{
  "schema_version": "obsidian-toc-experiment-contract/v1",
  "status": "prototype",
  "authority_effect": "none",
  "types": [
    "Requirement",
    "Source",
    "Hypothesis",
    "CodeLocation",
    "TestCase",
    "Observation"
  ],
  "relations": {
    "grounded_in": [
      "Requirement",
      "Source"
    ],
    "addresses": [
      "Hypothesis",
      "Requirement"
    ],
    "targets": [
      "Hypothesis",
      "CodeLocation"
    ],
    "checks": [
      "TestCase",
      "Requirement"
    ],
    "result_of": [
      "Observation",
      "TestCase"
    ],
    "supports": [
      "Observation",
      "Hypothesis"
    ],
    "contradicts": [
      "Observation",
      "Hypothesis"
    ]
  },
  "required_receipt_fields": [
    "run_id",
    "arm",
    "model",
    "input_hashes",
    "container_image_digest",
    "base_sha",
    "started_at",
    "ended_at",
    "wall_seconds",
    "token_usage",
    "patch_sha256",
    "changed_paths",
    "development_evidence",
    "verifier_evidence",
    "status",
    "blockers"
  ],
  "unknown_measurements": "null with explicit cause, never zero",
  "open_questions": [
    "Native model version and usage metering unavailable"
  ]
}
