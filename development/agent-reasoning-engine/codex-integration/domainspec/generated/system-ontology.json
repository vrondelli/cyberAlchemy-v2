        "formal_return_type": "boolean",
        "semantic_refs": [
          "CA2-ARE-CODEX-RULE-DIRECTIVE-NONAUTHORITY",
          "CA2-CAP-POLICY-ARE-CODEX-NONAUTHORITY"
        ],
        "required_conditions": [
          "every engine result has authority_effect none",
          "a direct route is not effect consent",
          "Codex permission policy remains an independent necessary check",
          "a gate identifies but does not satisfy an owner decision",
          "validation does not adopt the capability or interface",
          "runtime evidence does not imply conformance"
        ],
        "result_posture": "non-collapse invariant",
        "authority_effect": "none"
