  "nodes": [
    {"id":"CA2-CAP-GOVERN-CODEX-REQUESTS","kind":"Product Capability","meaning":"Govern Codex request preflight and bounded continuation through non-authorizing Agent Reasoning Engine directives.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION"]},
    {"id":"CA2-ARE-CODEX-OUTCOME-PREFLIGHT-CONTROL","kind":"Outcome","meaning":"Codex receives direct, gate, or block before its first repository tool call.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-ARE-ROUTER-WITNESS"]},
    {"id":"CA2-ARE-CODEX-OUTCOME-CONTINUATION-CONTROL","kind":"Outcome","meaning":"After each bounded completion, Codex completes, continues one safe option, gates a consequential choice, or blocks.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-ARE-ROUTER-PROFILE"]},
    {"id":"CA2-ARE-CODEX-OUTCOME-AUDITABLE-ORDERING","kind":"Outcome","meaning":"A mechanism-derived receipt can show the decision preceded the governed tool boundary.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-CODEX-HOOK"]},
    {"id":"CA2-ARE-CODEX-ACTOR-USER","kind":"Actor","meaning":"The attributable user or intent owner whose raw request and reserved decisions remain visible.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION"]},
    {"id":"CA2-ARE-CODEX-ACTOR-HOST","kind":"Actor","meaning":"The Codex host that must obtain and enforce a directive before the governed tool boundary.","source_refs":["CAP-SEL-CODEX-HOOK-CONFIG","CAP-SEL-CODEX-HOOK"]},
    {"id":"CA2-ARE-CODEX-ACTOR-EFFECT-OWNER","kind":"Actor","meaning":"The exact owner who alone may resolve a reserved decision or authorize a protected effect.","source_refs":["CAP-SEL-CA2-AUTHORITY","CAP-SEL-CA2-INVARIANTS"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-REQUEST-CONTEXT","kind":"Domain Concept","meaning":"The raw request plus explicitly postured objective, effects, targets, constraints, evidence, and digest.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-ARE-PARENT-ONTOLOGY"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-PREFLIGHT-DECISION","kind":"Domain Concept","meaning":"A deterministic direct, gate, or block classification before repository work.","source_refs":["CAP-SEL-ARE-ROUTER-PROFILE","CAP-SEL-ARE-ROUTER-WITNESS"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-ROUTE-DIRECTIVE","kind":"Domain Concept","meaning":"A non-authorizing instruction with route or candidates, reasons, owner boundary, and exact decision provenance.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-CA2-ROUTES"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-CONTINUATION-ASSESSMENT","kind":"Domain Concept","meaning":"A post-completion classification over admissible options, effects, reversibility, and owner gates.","source_refs":["CAP-SEL-ARE-ROUTER-PROFILE","CAP-SEL-CA2-INVARIANTS"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-CONTINUATION-PROPOSAL","kind":"Domain Concept","meaning":"One attributed successor proposal from a plan-bound or interaction-bound lane, with an exact digest, effect posture, evidence, and human-decision binding state.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-ARE-CODEX-CONTINUATION-SOURCE-SELECTION","CAP-SEL-ARE-ROUTER-PROFILE","CAP-SEL-CA2-AUTHORITY"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-CONTINUATION-DIRECTIVE","kind":"Domain Concept","meaning":"A complete, direct, gate, or block result that does not perform its selected successor.","source_refs":["CAP-SEL-ARE-ROUTER-WITNESS","CAP-SEL-CA2-RULES"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-DECISION-GATE","kind":"Domain Concept","meaning":"A configurable stop presenting an exact choice, consequences, provenance, and owner route without satisfying the decision.","source_refs":["CAP-SEL-ARE-ROUTER-PROFILE","CAP-SEL-CA2-AUTHORITY"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-INTEGRATION-RECEIPT","kind":"Domain Concept","meaning":"Mechanism-derived evidence joining a decision digest to a Codex turn and observable tool ordering.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-CODEX-HOOK"]},
    {"id":"CA2-ARE-CODEX-CONCEPT-HOST-ADAPTER","kind":"Domain Concept","meaning":"The owner-selected, not-yet-implemented Codex app-server wrapper boundary that would invoke, enforce, and evidence the directives.","source_refs":["CAP-SEL-ARE-CODEX-HOST-SELECTION","CAP-SEL-ARE-CODEX-APP-SERVER-OBSERVATION","CAP-SEL-ARE-CODEX-APP-SERVER-INTERFACE"]},
    {"id":"CA2-ARE-CODEX-WORKFLOW-PREFLIGHT","kind":"Workflow","meaning":"Capture request context, verify the profile, select one declared route or expose ambiguity, then emit a directive before tools.","source_refs":["CAP-SEL-ARE-ROUTER-PROFILE","CAP-SEL-CA2-ROUTES"]},
    {"id":"CA2-ARE-CODEX-WORKFLOW-CONTINUATION","kind":"Workflow","meaning":"After completion, enumerate structurally admissible successors and continue only until the next consequential decision gate.","source_refs":["CAP-SEL-ARE-CODEX-DEFINITION","CAP-SEL-ARE-ROUTER-WITNESS"]},
    {"id":"CA2-ARE-CODEX-RULE-GOAL-NONDEFAULT","kind":"Rule","meaning":"Goal is selected only by goal-specific evidence and never wraps all requests.","source_refs":["CAP-SEL-ARE-ROUTER-PROFILE","CAP-SEL-CA2-GOALS"]},
    {"id":"CA2-ARE-CODEX-RULE-UNKNOWN-FAILS-CLOSED","kind":"Rule","meaning":"Unknown route, effect, reversibility, owner gate, or selected dependency cannot yield direct continuation.","source_refs":["CAP-SEL-ARE-ROUTER-PROFILE","CAP-SEL-CA2-INVARIANTS"]},
    {"id":"CA2-ARE-CODEX-RULE-DIRECTIVE-NONAUTHORITY","kind":"Rule","meaning":"No directive, validation result, or receipt grants adoption, implementation, publication, deployment, or effect authority.","source_refs":["CAP-SEL-CA2-AUTHORITY","CAP-SEL-CA2-RULES"]}
  ],
