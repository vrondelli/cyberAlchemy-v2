{
  "schema_version": "mint.manifest.v0.1",
  "request_id": "fixture-valid-private",
  "mode": "plan",
  "run_date": "2026-08-07",
  "domain": {
    "name": "Fixture Domain",
    "slug": "fixture-domain",
    "objective": "Test the no-write planner",
    "governed_subject": "fixture decisions",
    "proposal_unit": "one domain-local authority proposal"
  },
  "target": {
    "path": "$TARGET_PATH",
    "allowed_root": "$ALLOWED_ROOT",
    "visibility": "private",
    "must_be_absent": true
  },
  "framework": {
    "source_path": "$FRAMEWORK_SOURCE",
    "expected_sha256": "$FRAMEWORK_SHA256",
    "attach_mode": "submodule"
  },
  "authority": {
    "primary_source": {
      "name": "Fixture primary source",
      "uri": "urn:fixture:primary-source",
      "owner_route": "source-owner"
    },
    "domain_kinds": [
      {
        "id": "FIXTURE_DECISION",
        "name": "Fixture decision",
        "counts_as": "a domain-local governed decision",
        "owner_route": "fixture-decision-owner",
        "blocked_use": "must not count as ratified before the domain owner closes the gate",
        "triage_receipt_ref": "$TRIAGE_RECEIPT",
        "triage_receipt_sha256": "$TRIAGE_SHA256",
        "triage_verdict": "new-authority (domain-local)"
      }
    ],
    "ratification_status": "pending"
  },
  "template_set": {
    "root": "$TEMPLATE_ROOT",
    "expected_sha256": "$TEMPLATE_SHA256"
  },
  "protected_paths": ["$PROTECTED_PATH"]
}
