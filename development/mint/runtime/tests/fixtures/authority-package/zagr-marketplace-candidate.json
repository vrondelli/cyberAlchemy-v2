      }
    },
    {
      "definition_id": "DEF.SUBTREE-VISIBILITY",
      "term": "Subtree Visibility",
      "normative_meaning": "An authenticated user is scoped to the Node subtree rooted at the user home_node_id.",
      "boundary": "The source requires persisted RLS enforcement; this package is not runtime authorization or enforcement.",
      "schema_ref": "ZAGR.MARKETPLACE.SUBTREE-VISIBILITY",
