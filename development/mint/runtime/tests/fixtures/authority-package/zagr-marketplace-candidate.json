    {
      "definition_id": "DEF.AUTHORITY-PACKAGE",
      "term": "Authority Package",
      "normative_meaning": "A private candidate graph whose typed records are the sole semantic input to later no-write projections.",
      "boundary": "Validation and projection do not ratify, promote, render to a target, apply, or remint.",
      "schema_ref": "SCHEMA.AUTHORITY-PACKAGE",
      "definition_lifecycle": "proposed",
