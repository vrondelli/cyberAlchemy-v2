      }
    },
    {
      "definition_id": "DEF.NODE-TREE",
      "term": "Marketplace Node Tree",
      "normative_meaning": "ZAGR, Revendores, and sub-merchants form one recursive Node tree at arbitrary depth.",
      "boundary": "This candidate records the source claim; it does not create, mutate, or enforce the tree.",
      "schema_ref": "ZAGR.MARKETPLACE.NODE",
      "definition_lifecycle": "proposed",
      "source_binding_refs": ["SRC.ZAGR.DOMAIN-LEDGER", "SRC.ZAGR.MARKETPLACE-README", "SRC.ZAGR.MARKETPLACE-DOMAIN"],
