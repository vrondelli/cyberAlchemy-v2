      }
    },
    {
      "definition_id": "DEF.MARKETPLACE-RBAC-RLS",
      "term": "Marketplace RBAC and RLS Boundary",
      "normative_meaning": "Marketplace combines role grants with Postgres row-level security so application bugs cannot widen subtree visibility.",
      "boundary": "The package describes the boundary but makes no authorization decision and performs no database operation.",
