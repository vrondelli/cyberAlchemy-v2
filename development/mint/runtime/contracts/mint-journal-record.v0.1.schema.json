{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/journal-record/v0.1",
  "title": "MintJournalRecordV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "attempt_id", "plan_id", "render_id", "target_path", "event", "path", "sha256", "size_bytes", "detail"],
  "properties": {
    "schema_version": {"const": "mint.journal-record.v0.1"},
    "sequence": {"type": "integer", "minimum": 1},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "render_id": {"$ref": "#/$defs/digest"},
    "target_path": {"type": "string", "minLength": 1},
    "event": {"enum": ["begin", "dir-intent", "dir-created", "file-intent", "file-created", "failed", "file-removed", "dir-removed", "recovered", "recovery-blocked", "complete"]},
    "path": {"type": ["string", "null"]},
    "sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "detail": {"type": "string"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
