{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/authority-cedar-receipt/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "compiler_version", "compiler_sha256", "package_id", "package_sha256", "semantic_sha256", "status", "language_profile", "policy_inventory", "per_unit_parity", "residues", "blockers", "writes_performed", "authority_effect", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.authority-cedar-receipt.v0.1"}, "receipt_id": {"$ref": "#/$defs/digest"},
    "compiler_version": {"const": "mint.runtime.authority-cedar.v0.1"}, "compiler_sha256": {"$ref": "#/$defs/digest"},
    "package_id": {"type": ["string", "null"]}, "package_sha256": {"$ref": "#/$defs/digest"}, "semantic_sha256": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ready", "partial", "blocked"]}, "language_profile": {"const": "cedar-internal-subset.v0.1"},
    "policy_inventory": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["policy_id", "semantic_unit_ref", "sha256", "size_bytes"], "properties": {"policy_id": {"type": "string", "minLength": 1}, "semantic_unit_ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}}}},
    "per_unit_parity": {"type": "array"}, "residues": {"type": "array"},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CEDAR_[A-Z0-9_]+$"}},
    "writes_performed": {"const": 0}, "authority_effect": {"const": "none"},
    "proof_ceiling": {"const": "candidate-local internal Cedar-subset structural parity only; no official Cedar evaluation, authorization decision, enforcement, ratification, release, deployment, or production proof"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
