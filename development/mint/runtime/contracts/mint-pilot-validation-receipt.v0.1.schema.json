{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/pilot-validation-receipt/v0.1",
  "title": "MintPilotValidationReceiptV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "validator_version", "validator_sha256", "contract_sha256", "pilot_id", "request_id", "run_date", "status", "evidence_bindings", "observations", "validation_checks", "blockers", "effects_planned", "effects_applied", "writes_attempted", "writes_performed", "external_commands_executed", "network_calls", "git_operations", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.pilot-validation-receipt.v0.1"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "validator_version": {"const": "mint.runtime.pilot-check.v0.1"},
    "validator_sha256": {"$ref": "#/$defs/digest"},
    "contract_sha256": {"$ref": "#/$defs/digest"},
    "pilot_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "run_date": {"type": "string", "minLength": 1},
    "status": {"enum": ["admission-ready", "blocked"]},
    "evidence_bindings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "sha256", "size_bytes"],
        "properties": {
          "kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["target_path", "target_exists_before", "target_exists_after", "allowed_root", "journal_root", "journal_exists_before", "journal_exists_after", "journal_sha256_before", "journal_sha256_after", "visibility", "protected_paths", "zagr_root", "zagr_selector_count", "zagr_before_sha256", "zagr_after_sha256", "evidence_set_before_sha256", "evidence_set_after_sha256"],
      "properties": {
        "target_path": {"type": ["string", "null"]},
        "target_exists_before": {"type": ["boolean", "null"]}, "target_exists_after": {"type": ["boolean", "null"]},
        "allowed_root": {"type": ["string", "null"]}, "journal_root": {"type": ["string", "null"]},
        "journal_exists_before": {"type": ["boolean", "null"]}, "journal_exists_after": {"type": ["boolean", "null"]},
        "journal_sha256_before": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "journal_sha256_after": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "visibility": {"type": ["string", "null"]},
        "protected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "zagr_root": {"type": ["string", "null"]}, "zagr_selector_count": {"type": "integer", "minimum": 0},
        "zagr_before_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "zagr_after_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "evidence_set_before_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "evidence_set_after_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "validation_checks": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["check", "status"],
        "properties": {"check": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "block"]}}
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effects_planned": {"const": 0}, "effects_applied": {"const": 0},
    "writes_attempted": {"const": 0}, "writes_performed": {"const": 0},
    "external_commands_executed": {"const": 0}, "network_calls": {"const": 0}, "git_operations": {"const": 0},
    "proof_ceiling": {"const": "pilot input admission only; no render, apply, recover, mint, ratification, promotion, release, deployment, or production proof"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
