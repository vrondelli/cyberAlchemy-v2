{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://domainspec.local/private/mint/authority-transition-validation-receipt/v0.1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "validator_version", "validator_sha256", "request_id", "transition_id", "package_id", "package_sha256", "status", "evidence_bindings", "blockers", "writes_performed", "owner_receipt_consumed", "authority_effect", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.authority-transition-validation-receipt.v0.1"}, "receipt_id": {"$ref": "#/$defs/digest"}, "validator_version": {"const": "mint.runtime.authority-transition-check.v0.1"}, "validator_sha256": {"$ref": "#/$defs/digest"},
    "request_id": {"type": ["string", "null"]}, "transition_id": {"type": ["string", "null"]}, "package_id": {"type": ["string", "null"]}, "package_sha256": {"$ref": "#/$defs/digest"}, "status": {"enum": ["transition-ready", "blocked"]},
    "evidence_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256", "size_bytes"], "properties": {"kind": {"enum": ["package", "decision", "owner-receipt", "replay-ledger"]}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 0}}}},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TRANSITION_[A-Z0-9_]+$"}}, "writes_performed": {"const": 0}, "owner_receipt_consumed": {"const": false}, "authority_effect": {"const": "none"},
    "proof_ceiling": {"const": "owner-evidence transition admission only; no receipt consumption, ratification, promotion, package mutation, release, deployment, or production proof"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
