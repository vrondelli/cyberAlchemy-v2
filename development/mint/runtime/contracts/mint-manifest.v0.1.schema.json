{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/manifest/v0.1",
  "title": "MintManifestV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "mode", "run_date", "domain", "target", "framework", "authority", "template_set", "protected_paths"],
  "properties": {
    "schema_version": {"const": "mint.manifest.v0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "mode": {"const": "plan"},
    "run_date": {"type": "string", "format": "date"},
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "objective", "governed_subject", "proposal_unit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "objective": {"type": "string", "minLength": 1},
        "governed_subject": {"type": "string", "minLength": 1},
        "proposal_unit": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "allowed_root", "visibility", "must_be_absent"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "allowed_root": {"type": "string", "minLength": 1},
        "visibility": {"const": "private"},
        "must_be_absent": {"const": true}
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "expected_sha256", "attach_mode"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attach_mode": {"const": "submodule"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source", "domain_kinds", "ratification_status"],
      "properties": {
        "primary_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "uri", "owner_route"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "uri": {"type": "string", "minLength": 1},
            "owner_route": {"type": "string", "minLength": 1}
          }
        },
        "domain_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "counts_as", "owner_route", "blocked_use", "triage_receipt_ref", "triage_receipt_sha256", "triage_verdict"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
              "name": {"type": "string", "minLength": 1},
              "counts_as": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1},
              "blocked_use": {"type": "string", "minLength": 1},
              "triage_receipt_ref": {"type": "string", "minLength": 1},
              "triage_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "triage_verdict": {"const": "new-authority (domain-local)"}
            }
          }
        },
        "ratification_status": {"const": "pending"}
      }
    },
    "template_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "expected_sha256"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "protected_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
