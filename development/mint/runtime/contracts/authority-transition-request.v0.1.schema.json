{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://domainspec.local/private/mint/authority-transition-request/v0.1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "package_ref", "decision_ref", "owner_receipt_ref", "replay_ledger_ref", "transition_id", "expected", "authority_effect"],
  "properties": {
    "schema_version": {"const": "mint.authority-transition-request.v0.1"}, "request_id": {"type": "string", "minLength": 1},
    "package_ref": {"$ref": "#/$defs/ref"}, "decision_ref": {"$ref": "#/$defs/ref"}, "owner_receipt_ref": {"$ref": "#/$defs/ref"}, "replay_ledger_ref": {"$ref": "#/$defs/ref"}, "transition_id": {"type": "string", "minLength": 1},
    "expected": {"type": "object", "additionalProperties": false, "required": ["package_id", "subject_ref", "before_posture", "after_posture", "requested_effect"], "properties": {"package_id": {"type": "string", "minLength": 1}, "subject_ref": {"type": "string", "minLength": 1}, "before_posture": {"type": "string", "minLength": 1}, "after_posture": {"type": "string", "minLength": 1}, "requested_effect": {"enum": ["ratify", "promote", "deprecate", "retire"]}}},
    "authority_effect": {"const": "none"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}}}
}
