{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://domainspec.local/private/mint/authority-owner-decision/v0.1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "decision_id", "transition_id", "package_sha256", "selected_effect", "decision_state", "owner_id", "evidence_refs"],
  "properties": {"schema_version": {"const": "mint.authority-owner-decision.v0.1"}, "decision_id": {"type": "string", "minLength": 1}, "transition_id": {"type": "string", "minLength": 1}, "package_sha256": {"$ref": "#/$defs/digest"}, "selected_effect": {"enum": ["ratify", "promote", "deprecate", "retire"]}, "decision_state": {"enum": ["accepted", "rejected"]}, "owner_id": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
