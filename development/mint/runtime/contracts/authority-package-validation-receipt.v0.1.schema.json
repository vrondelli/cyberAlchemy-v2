{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/authority-package-validation-receipt/v0.1",
  "title": "MintAuthorityPackageValidationReceiptV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "validator_version", "validator_sha256",
    "package_id", "package_sha256", "semantic_sha256", "status",
    "validation_checks", "error_ids", "errors", "effects_planned",
    "effects_applied", "writes_attempted", "writes_performed",
    "external_commands_executed", "network_calls", "git_operations",
    "authority_effect", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "mint.authority-package-validation-receipt.v0.1"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "validator_version": {"const": "mint.runtime.authority-package-check.v0.1"},
    "validator_sha256": {"$ref": "#/$defs/digest"},
    "package_id": {"type": ["string", "null"]},
    "package_sha256": {"$ref": "#/$defs/digest"},
    "semantic_sha256": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["valid", "blocked"]},
    "validation_checks": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["check", "status"],
        "properties": {"check": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "block"]}}
      }
    },
    "error_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AP_[A-Z0-9_]+$"}},
    "errors": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["error_id", "path", "detail"],
        "properties": {
          "error_id": {"type": "string", "pattern": "^AP_[A-Z0-9_]+$"},
          "path": {"type": "string"}, "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "effects_planned": {"const": 0}, "effects_applied": {"const": 0},
    "writes_attempted": {"const": 0}, "writes_performed": {"const": 0},
    "external_commands_executed": {"const": 0}, "network_calls": {"const": 0},
    "git_operations": {"const": 0}, "authority_effect": {"const": "none"},
    "proof_ceiling": {"const": "candidate-local semantic validation only; no ratification, render, apply, remint, projection correctness, release, deployment, or production proof"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
