{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/receipt/v0.1",
  "title": "MintReceiptV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "plan_id", "status", "validation_checks", "effects_planned", "effects_applied", "writes_attempted", "writes_performed", "external_commands_executed", "stdout_sha256", "blockers", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.receipt.v0.1"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ready", "blocked"]},
    "validation_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validationCheck"}},
    "effects_planned": {"type": "integer", "minimum": 0},
    "effects_applied": {"const": 0},
    "writes_attempted": {"const": 0},
    "writes_performed": {"const": 0},
    "external_commands_executed": {"const": 0},
    "stdout_sha256": {"$ref": "#/$defs/digest"},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proof_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "block"]}
      }
    }
  }
}
