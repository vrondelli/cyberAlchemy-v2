{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/apply-receipt/v0.1",
  "title": "MintApplyReceiptV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "attempt_id", "status", "plan_id", "render_id", "request_sha256", "apply_runtime_sha256", "journal_path", "journal_sha256", "journal_records", "effects_total", "effects_applied", "target_file_writes", "files_removed", "directories_removed", "target_observation", "blockers", "residue", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.apply-receipt.v0.1"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["applied", "recovered", "blocked", "failed", "recovery-blocked"]},
    "plan_id": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "render_id": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "request_sha256": {"$ref": "#/$defs/digest"},
    "apply_runtime_sha256": {"$ref": "#/$defs/digest"},
    "journal_path": {"type": ["string", "null"]},
    "journal_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "journal_records": {"type": "integer", "minimum": 0},
    "effects_total": {"const": 18},
    "effects_applied": {"type": "integer", "minimum": 0, "maximum": 18},
    "target_file_writes": {"type": "integer", "minimum": 0, "maximum": 18},
    "files_removed": {"type": "integer", "minimum": 0, "maximum": 18},
    "directories_removed": {"type": "integer", "minimum": 0},
    "target_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "path", "regular_file_count"],
      "properties": {
        "exists": {"type": ["boolean", "null"]},
        "path": {"type": ["string", "null"]},
        "regular_file_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "residue": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proof_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
