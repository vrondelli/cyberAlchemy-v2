{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/authority-fol-projection/v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "package_id", "package_sha256", "semantic_sha256", "language_profile", "program", "program_sha256", "statements", "per_unit_parity", "invariant_parity", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.authority-fol-projection.v0.1"}, "status": {"enum": ["ready", "blocked"]},
    "package_id": {"type": ["string", "null"]}, "package_sha256": {"$ref": "#/$defs/digest"}, "semantic_sha256": {"$ref": "#/$defs/digest"},
    "language_profile": {"const": "tptp-fof-internal-subset.v0.1"}, "program": {"type": "string"}, "program_sha256": {"$ref": "#/$defs/digest"},
    "statements": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "per_unit_parity": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["semantic_unit_ref", "statement_ids", "parity_state"], "properties": {"semantic_unit_ref": {"type": "string", "minLength": 1}, "statement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "parity_state": {"enum": ["pass", "blocked"]}}}},
    "invariant_parity": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["invariant_id", "parity_state"], "properties": {"invariant_id": {"type": "string", "minLength": 1}, "parity_state": {"enum": ["pass", "blocked"]}}}},
    "proof_ceiling": {"const": "candidate-local internal TPTP-FOF-subset structural parity only; no theorem proving, satisfiability result, rule enforcement, ratification, release, deployment, or production proof"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "statement": {"type": "object", "additionalProperties": false, "required": ["statement_id", "statement_kind", "semantic_unit_refs", "statement", "sha256", "parsed_ast"], "properties": {"statement_id": {"type": "string", "minLength": 1}, "statement_kind": {"enum": ["fact", "invariant"]}, "semantic_unit_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "statement": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "parsed_ast": {"type": "object"}}}
  }
}
