{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/marketplace-remint-receipt/v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "runtime_version", "runtime_sha256", "request_id", "status", "package_id", "package_sha256", "semantic_sha256", "package_maturity", "target_path", "view_receipts", "file_inventory", "blockers", "zagr_before_sha256", "zagr_after_sha256", "zagr_unchanged", "writes_performed", "external_commands_executed", "network_calls", "git_operations", "authority_effect", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.marketplace-remint-receipt.v0.1"}, "receipt_id": {"$ref": "#/$defs/digest"},
    "runtime_version": {"const": "mint.runtime.marketplace-remint.v0.1"}, "runtime_sha256": {"$ref": "#/$defs/digest"},
    "request_id": {"type": ["string", "null"]}, "status": {"enum": ["reminted", "blocked"]},
    "package_id": {"type": ["string", "null"]}, "package_sha256": {"$ref": "#/$defs/digest"}, "semantic_sha256": {"$ref": "#/$defs/digest"},
    "package_maturity": {"type": ["string", "null"]}, "target_path": {"type": ["string", "null"]},
    "view_receipts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["view", "receipt_id", "package_sha256", "status"], "properties": {"view": {"enum": ["semantic", "markdown", "cedar", "fol"]}, "receipt_id": {"$ref": "#/$defs/digest"}, "package_sha256": {"$ref": "#/$defs/digest"}, "status": {"enum": ["valid", "ready"]}}}},
    "file_inventory": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}}}},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REMINT_[A-Z0-9_]+$"}},
    "zagr_before_sha256": {"$ref": "#/$defs/digest"}, "zagr_after_sha256": {"$ref": "#/$defs/digest"}, "zagr_unchanged": {"type": "boolean"},
    "writes_performed": {"type": "integer", "minimum": 0, "maximum": 24}, "external_commands_executed": {"const": 0}, "network_calls": {"const": 0}, "git_operations": {"const": 0},
    "authority_effect": {"const": "none"},
    "proof_ceiling": {"const": "candidate-local disposable Marketplace multi-view remint only; no Zagr mint, authority promotion, official Cedar evaluation, theorem proving, publication, release, deployment, or production proof"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
