{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://domainspec.local/private/mint/authority-owner-receipt/v0.1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "owner_receipt_id", "decision_id", "transition_id", "package_sha256", "subject_ref", "before_posture", "after_posture", "requested_effect", "decision_state", "nonce", "owner_id"],
  "properties": {"schema_version": {"const": "mint.authority-owner-receipt.v0.1"}, "owner_receipt_id": {"type": "string", "minLength": 1}, "decision_id": {"type": "string", "minLength": 1}, "transition_id": {"type": "string", "minLength": 1}, "package_sha256": {"$ref": "#/$defs/digest"}, "subject_ref": {"type": "string", "minLength": 1}, "before_posture": {"type": "string", "minLength": 1}, "after_posture": {"type": "string", "minLength": 1}, "requested_effect": {"enum": ["ratify", "promote", "deprecate", "retire"]}, "decision_state": {"const": "accepted"}, "nonce": {"type": "string", "minLength": 16}, "owner_id": {"type": "string", "minLength": 1}},
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
