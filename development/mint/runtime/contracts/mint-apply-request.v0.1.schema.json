{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/apply-request/v0.1",
  "title": "MintApplyRequestV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "plan_id", "render_id", "target_path", "allowed_root", "journal_root", "auto_recover", "fault_after_ordinal"],
  "properties": {
    "schema_version": {"const": "mint.apply-request.v0.1"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "render_id": {"$ref": "#/$defs/digest"},
    "target_path": {"type": "string", "minLength": 1},
    "allowed_root": {"type": "string", "minLength": 1},
    "journal_root": {"type": "string", "minLength": 1},
    "auto_recover": {"type": "boolean"},
    "fault_after_ordinal": {"oneOf": [{"type": "integer", "minimum": 2, "maximum": 19}, {"type": "null"}]}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
