{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/render-package/v0.1",
  "title": "MintRenderPackageV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render_id", "status", "plan_id", "manifest_sha256", "template_set_sha256", "render_input_sha256", "ir_sha256", "renderer_sha256", "files", "blockers"],
  "properties": {
    "schema_version": {"const": "mint.render-package.v0.1"},
    "render_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ready", "blocked"]},
    "plan_id": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "manifest_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "template_set_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "render_input_sha256": {"$ref": "#/$defs/digest"},
    "ir_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "renderer_sha256": {"$ref": "#/$defs/digest"},
    "files": {"type": "array", "maxItems": 18, "items": {"$ref": "#/$defs/file"}},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_ordinal", "path", "source_template", "source_sha256", "encoding", "content_b64", "size_bytes", "sha256", "render_version", "manifest_sha256", "plan_id", "template_set_sha256"],
      "properties": {
        "effect_ordinal": {"type": "integer", "minimum": 2, "maximum": 19},
        "path": {"type": "string", "minLength": 1},
        "source_template": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "render_version": {"const": "mint.runtime.render.v0.1"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "plan_id": {"$ref": "#/$defs/digest"},
        "template_set_sha256": {"$ref": "#/$defs/digest"},
        "encoding": {"const": "base64"},
        "content_b64": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
