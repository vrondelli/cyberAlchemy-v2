{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/authority-markdown-receipt/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "compiler_version", "compiler_sha256", "package_id", "package_sha256", "semantic_sha256", "status", "file_inventory", "b1_b9_status", "blockers", "writes_performed", "authority_effect", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.authority-markdown-receipt.v0.1"},
    "receipt_id": {"$ref": "#/$defs/digest"}, "compiler_version": {"const": "mint.runtime.authority-markdown.v0.1"}, "compiler_sha256": {"$ref": "#/$defs/digest"},
    "package_id": {"type": ["string", "null"]}, "package_sha256": {"$ref": "#/$defs/digest"}, "semantic_sha256": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ready", "blocked"]},
    "file_inventory": {"type": "array", "maxItems": 18, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}}}},
    "b1_b9_status": {"enum": ["pass", "blocked"]}, "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "writes_performed": {"const": 0}, "authority_effect": {"const": "none"},
    "proof_ceiling": {"const": "candidate-local Markdown projection only; no apply, ratification, Cedar/FOL correctness, remint, release, deployment, or production proof"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
