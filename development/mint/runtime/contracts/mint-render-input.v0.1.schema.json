{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/render-input/v0.1",
  "title": "MintRenderInputV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "manifest_sha256", "values"],
  "properties": {
    "schema_version": {"const": "mint.render-input.v0.1"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_families", "separable_concerns", "definitions", "constitution_rules", "promotion_gates", "related_corpora", "policy_surfaces", "domain_commitment", "withholding_boundary", "required_precedent_corpus", "methods", "project_roles"],
      "properties": {
        "evidence_families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceFamily"}},
        "separable_concerns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/separableConcern"}},
        "definitions": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/definition"}},
        "constitution_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/constitutionRule"}},
        "promotion_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/promotionGate"}},
        "related_corpora": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relatedCorpus"}},
        "policy_surfaces": {"$ref": "#/$defs/policySurfaces"},
        "domain_commitment": {"$ref": "#/$defs/text"},
        "withholding_boundary": {"$ref": "#/$defs/text"},
        "required_precedent_corpus": {"$ref": "#/$defs/text"},
        "methods": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/method"}},
        "project_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/projectRole"}}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\r\\n\\u0000]+$"},
    "evidenceFamily": {"type": "object", "additionalProperties": false, "required": ["name", "allowed_use", "blocked_use"], "properties": {"name": {"$ref": "#/$defs/text"}, "allowed_use": {"$ref": "#/$defs/text"}, "blocked_use": {"$ref": "#/$defs/text"}}},
    "separableConcern": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/text"}, "right": {"$ref": "#/$defs/text"}}},
    "definition": {"type": "object", "additionalProperties": false, "required": ["id", "term", "operational", "formal", "evidence", "source_kind"], "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}, "term": {"$ref": "#/$defs/text"}, "operational": {"$ref": "#/$defs/text"}, "formal": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/text"}, "source_kind": {"$ref": "#/$defs/text"}}},
    "constitutionRule": {"type": "object", "additionalProperties": false, "required": ["id", "rule", "validation_mode"], "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}, "rule": {"$ref": "#/$defs/text"}, "validation_mode": {"$ref": "#/$defs/text"}}},
    "promotionGate": {"type": "object", "additionalProperties": false, "required": ["name", "condition"], "properties": {"name": {"$ref": "#/$defs/text"}, "condition": {"$ref": "#/$defs/text"}}},
    "relatedCorpus": {"type": "object", "additionalProperties": false, "required": ["name", "relation", "allowed_use", "blocked_use"], "properties": {"name": {"$ref": "#/$defs/text"}, "relation": {"$ref": "#/$defs/text"}, "allowed_use": {"$ref": "#/$defs/text"}, "blocked_use": {"$ref": "#/$defs/text"}}},
    "policySurfaces": {"type": "object", "additionalProperties": false, "required": ["internal", "external"], "properties": {"internal": {"$ref": "#/$defs/text"}, "external": {"$ref": "#/$defs/text"}}},
    "method": {"type": "object", "additionalProperties": false, "required": ["kind_id", "method", "validation"], "properties": {"kind_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}, "method": {"$ref": "#/$defs/text"}, "validation": {"$ref": "#/$defs/text"}}},
    "projectRole": {"type": "object", "additionalProperties": false, "required": ["role", "scope", "owner_route"], "properties": {"role": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "owner_route": {"$ref": "#/$defs/text"}}}
  }
}
