{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/marketplace-remint-request/v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "package_ref", "target", "zagr_ref", "authority_effect"],
  "properties": {
    "schema_version": {"const": "mint.marketplace-remint-request.v0.1"}, "request_id": {"type": "string", "minLength": 1},
    "package_ref": {"$ref": "#/$defs/fileRef"},
    "target": {"type": "object", "additionalProperties": false, "required": ["path", "allowed_root", "must_be_absent"], "properties": {"path": {"type": "string", "pattern": "^/"}, "allowed_root": {"type": "string", "pattern": "^/"}, "must_be_absent": {"const": true}}},
    "zagr_ref": {"type": "object", "additionalProperties": false, "required": ["path", "expected_tree_sha256", "read_only"], "properties": {"path": {"type": "string", "pattern": "^/"}, "expected_tree_sha256": {"$ref": "#/$defs/digest"}, "read_only": {"const": true}}},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
