{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/private/mint/render-receipt/v0.1",
  "title": "MintRenderReceiptV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "render_id", "status", "validation_checks", "files_rendered", "writes_attempted", "writes_performed", "stdout_sha256", "blockers", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "mint.render-receipt.v0.1"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "render_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ready", "blocked"]},
    "validation_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "files_rendered": {"type": "integer", "minimum": 0, "maximum": 18},
    "writes_attempted": {"const": 0},
    "writes_performed": {"const": 0},
    "stdout_sha256": {"$ref": "#/$defs/digest"},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proof_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "check": {"type": "object", "additionalProperties": false, "required": ["check", "status"], "properties": {"check": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "block"]}}}
  }
}
