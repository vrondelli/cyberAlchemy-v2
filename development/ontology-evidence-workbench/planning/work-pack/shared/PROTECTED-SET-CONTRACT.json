{
  "algorithm": "sha256-canonical-source-entries-v1",
  "authority_effect": "none",
  "canonicalization": {
    "encoding": "utf-8",
    "entry_order": "unicode-code-point-by-repository-relative-path",
    "json": "sorted-keys-compact",
    "set_digest": "sha256(canonical-json(entries))"
  },
  "global_excluded_file_names": [
    ".DS_Store",
    "Thumbs.db"
  ],
  "global_excluded_segments": [
    ".git",
    ".hg",
    ".svn",
    ".npm",
    ".pnpm-store",
    ".yarn",
    "node_modules",
    "bower_components",
    ".venv",
    "venv",
    ".tox",
    "site-packages",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".cache",
    ".gradle",
    ".terraform",
    ".turbo",
    ".next",
    ".vite",
    ".parcel-cache",
    "coverage"
  ],
  "global_excluded_suffixes": [
    ".pyc",
    ".pyo",
    ".swp",
    ".swo",
    "~"
  ],
  "overlap_policy": "deduplicate-by-repository-relative-path",
  "repository_root": ".",
  "required_paths": [
    "cyberAlchemy-v2/.craft/ledger.yml"
  ],
  "schema_version": "oew.protected-set-contract.v1",
  "scopes": [
    {
      "excluded_prefixes": [],
      "id": "poker-team-source",
      "path": "validation/poker-team"
    },
    {
      "excluded_prefixes": [],
      "id": "interactive-ontology-learning-map-source",
      "path": "cyberAlchemy-v2/development/interactive-ontology-learning-map"
    },
    {
      "excluded_prefixes": [],
      "id": "cyberalchemy-craft-state",
      "path": "cyberAlchemy-v2/.craft"
    },
    {
      "excluded_prefixes": [],
      "id": "cyberalchemy-authority-source",
      "path": "cyberAlchemy-v2/authority"
    },
    {
      "excluded_prefixes": [],
      "id": "cyberalchemy-ontology-source",
      "path": "cyberAlchemy-v2/ontology"
    },
    {
      "excluded_prefixes": [
        ".arcanum"
      ],
      "id": "arcanum-public-source",
      "path": "arcanum"
    },
    {
      "excluded_prefixes": [],
      "id": "ocgp-swu-008-evidence",
      "path": "cyberAlchemy-v2/implementation/ontology-candidate-graph-prototype/generated/runs/SWU-OCGP-008"
    }
  ],
  "special_file_policy": "reject",
  "symlink_policy": "hash-link-text-never-follow"
}
