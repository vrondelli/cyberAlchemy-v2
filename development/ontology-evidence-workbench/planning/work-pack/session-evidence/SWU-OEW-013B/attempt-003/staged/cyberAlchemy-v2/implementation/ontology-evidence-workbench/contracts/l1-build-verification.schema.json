{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/private/oew/l1-build-verification/v1",
  "title": "OEW L1 Final Build Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "result",
    "verifier",
    "producer_handle",
    "lock",
    "recomputed",
    "checks",
    "negative_witnesses",
    "cleanup",
    "residue",
    "browser_acceptance_claim",
    "manual_ux_claim",
    "release_claim",
    "production_claim",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "oew.l1-build-verification.v1"},
    "handle": {"const": "oew-l1-build-verification/v1"},
    "result": {"const": "pass"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "script"],
      "properties": {
        "id": {"const": "verify-l1-build"},
        "script": {"$ref": "#/$defs/image"}
      }
    },
    "producer_handle": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "required": ["handle"],
          "properties": {"handle": {"const": "oew-l1-build-handle/v1"}}
        }
      ]
    },
    "lock": {"$ref": "#/$defs/artifact"},
    "recomputed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_count",
        "input_digest",
        "lock_check_count",
        "lock_check_ids_digest",
        "lock_validation_receipt_sha256",
        "output_tree_sha256",
        "output_file_count",
        "output_total_size_bytes",
        "output_archive_sha256",
        "archive_tree_sha256",
        "archive_file_count",
        "archive_total_size_bytes",
        "core_output_tree_sha256",
        "core_output_file_count",
        "core_output_total_size_bytes",
        "core_required_output_count",
        "source_overlay_file_count",
        "patch_postimage_sha256",
        "protected_set_digest",
        "protected_entry_count"
      ],
      "properties": {
        "input_count": {"type": "integer", "minimum": 1},
        "input_digest": {"$ref": "#/$defs/digest"},
        "lock_check_count": {"const": 70},
        "lock_check_ids_digest": {"$ref": "#/$defs/digest"},
        "lock_validation_receipt_sha256": {"$ref": "#/$defs/digest"},
        "output_tree_sha256": {"$ref": "#/$defs/digest"},
        "output_file_count": {"type": "integer", "minimum": 1},
        "output_total_size_bytes": {"type": "integer", "minimum": 1},
        "output_archive_sha256": {"$ref": "#/$defs/digest"},
        "archive_tree_sha256": {"$ref": "#/$defs/digest"},
        "archive_file_count": {"type": "integer", "minimum": 13},
        "archive_total_size_bytes": {"type": "integer", "minimum": 1},
        "core_output_tree_sha256": {"$ref": "#/$defs/digest"},
        "core_output_file_count": {"type": "integer", "minimum": 12},
        "core_output_total_size_bytes": {"type": "integer", "minimum": 1},
        "core_required_output_count": {"const": 12},
        "source_overlay_file_count": {"const": 30},
        "patch_postimage_sha256": {"$ref": "#/$defs/digest"},
        "protected_set_digest": {"$ref": "#/$defs/digest"},
        "protected_entry_count": {"type": "integer", "minimum": 1}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_shape",
        "lock",
        "lock_70_bindings",
        "upstream",
        "verified_toolchain",
        "feature_inputs",
        "effective_workspace",
        "patch_images",
        "source_overlay_patch",
        "command_order",
        "core_build",
        "dashboard_commands",
        "output_archive",
        "archive_layout",
        "expected_external_artifact",
        "output_tree",
        "protected_equality",
        "cleanup",
        "port_residue",
        "producer_distinct"
      ],
      "properties": {
        "schema_shape": {"const": "pass"},
        "lock": {"const": "pass"},
        "lock_70_bindings": {"const": "pass"},
        "upstream": {"const": "pass"},
        "verified_toolchain": {"const": "pass"},
        "feature_inputs": {"const": "pass"},
        "effective_workspace": {"const": "pass"},
        "patch_images": {"const": "pass"},
        "source_overlay_patch": {"const": "pass"},
        "command_order": {"const": "pass"},
        "core_build": {"const": "pass"},
        "dashboard_commands": {"const": "pass"},
        "output_archive": {"const": "pass"},
        "archive_layout": {"const": "pass"},
        "expected_external_artifact": {"const": "pass"},
        "output_tree": {"const": "pass"},
        "protected_equality": {"const": "pass"},
        "cleanup": {"const": "pass"},
        "port_residue": {"const": "pass"},
        "producer_distinct": {"const": "pass"}
      }
    },
    "negative_witnesses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_feature_handle_rejected",
        "overlay_drift_rejected",
        "output_tamper_rejected",
        "producer_self_acceptance_rejected",
        "cleanup_residue_rejected",
        "core_missing_evidence_rejected",
        "core_command_drift_rejected",
        "core_skipped_rejected",
        "core_failed_rejected",
        "core_out_of_order_rejected",
        "core_output_missing_rejected",
        "archive_missing_rejected",
        "archive_writable_rejected",
        "archive_orphan_rejected"
      ],
      "properties": {
        "pre_feature_handle_rejected": {"const": true},
        "overlay_drift_rejected": {"const": true},
        "output_tamper_rejected": {"const": true},
        "producer_self_acceptance_rejected": {"const": true},
        "cleanup_residue_rejected": {"const": true},
        "core_missing_evidence_rejected": {"const": true},
        "core_command_drift_rejected": {"const": true},
        "core_skipped_rejected": {"const": true},
        "core_failed_rejected": {"const": true},
        "core_out_of_order_rejected": {"const": true},
        "core_output_missing_rejected": {"const": true},
        "archive_missing_rejected": {"const": true},
        "archive_writable_rejected": {"const": true},
        "archive_orphan_rejected": {"const": true}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_root_removed",
        "verification_root_absent",
        "workroot_absent",
        "store_absent",
        "ports_open_after_cleanup"
      ],
      "properties": {
        "verification_root_removed": {"const": true},
        "verification_root_absent": {"const": true},
        "workroot_absent": {"const": true},
        "store_absent": {"const": true},
        "ports_open_after_cleanup": {"type": "array", "maxItems": 0}
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unexpected_paths", "result"],
      "properties": {
        "unexpected_paths": {"type": "array", "maxItems": 0},
        "result": {"const": "pass"}
      }
    },
    "browser_acceptance_claim": {"const": false},
    "manual_ux_claim": {"const": false},
    "release_claim": {"const": false},
    "production_claim": {"const": false},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "handle": {"type": "string", "minLength": 1}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
