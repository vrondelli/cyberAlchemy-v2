{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/private/oew/l1-toolchain-verification/v1",
  "title": "OEW L1 Toolchain Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "result",
    "producer_handle",
    "checks",
    "residue",
    "final_feature_build_claim",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "oew.l1-toolchain-verification.v1"},
    "handle": {"const": "oew-l1-toolchain-verification/v1"},
    "result": {"const": "pass"},
    "producer_handle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "handle"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "handle": {"const": "oew-l1-toolchain-handle/v1"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock",
        "retained_l0",
        "source_archive",
        "node",
        "pnpm",
        "effective_lock",
        "patch_images",
        "protected_equality",
        "cleanup",
        "producer_distinct"
      ],
      "properties": {
        "lock": {"const": "pass"},
        "retained_l0": {"const": "pass"},
        "source_archive": {"const": "pass"},
        "node": {"const": "pass"},
        "pnpm": {"const": "pass"},
        "effective_lock": {"const": "pass"},
        "patch_images": {"const": "pass"},
        "protected_equality": {"const": "pass"},
        "cleanup": {"const": "pass"},
        "producer_distinct": {"const": "pass"}
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unexpected_paths", "result"],
      "properties": {
        "unexpected_paths": {"type": "array", "maxItems": 0},
        "result": {"const": "pass"}
      }
    },
    "final_feature_build_claim": {"const": false},
    "authority_effect": {"const": "none"}
  }
}
