{
  "name": "@cyberalchemy/ontology-evidence-workbench",
  "version": "0.0.0-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:source-admission": "node --test test/source-admission.test.mjs",
    "test:native-viewer": "node --test test/native-viewer-boundary.test.mjs test/native-viewer-poker.test.mjs && node scripts/serve-native-viewer.mjs verify --receipt generated/runs/SWU-OEW-006/native-viewer-receipt.json",
    "verify:adapter": "node scripts/verify-adapter-receipt.mjs generated/runs/SWU-OEW-004/adapter-receipt.json",
    "verify:upstream": "node --test test/upstream-lock.test.mjs && node scripts/prepare-upstream.mjs verify --lock upstream/UPSTREAM.lock.json --output generated/upstream/2cda14e89535049e49120198886bc0b82e9e630f",
    "test:l1-toolchain": "node --test test/l1-toolchain-bootstrap.test.mjs",
    "materialize:l1-probe": "node scripts/materialize-l1-workroot.mjs materialize --lock upstream/L1-TOOLCHAIN.lock.json --output generated/runs/SWU-OEW-006P/l1-toolchain-handle.json",
    "verify:l1-toolchain": "node scripts/verify-l1-toolchain.mjs verify --lock upstream/L1-TOOLCHAIN.lock.json --handle generated/runs/SWU-OEW-006P/l1-toolchain-handle.json --output generated/runs/SWU-OEW-006P/l1-toolchain-verification.json",
    "test:ui-store": "node --test test/ui-store.test.mjs",
    "test:trust-rail": "node --test test/trust-rail.test.mjs",
    "test:evidence-inspector": "node --test test/evidence-inspector.test.mjs",
    "test:view-parity": "node --test test/view-parity.test.mjs",
    "test:navigation": "node --test test/navigation.test.mjs",
    "test:poker-tour": "node --test test/poker-tour.test.mjs",
    "test:responsive": "node --test test/responsive.test.mjs",
    "build:l1": "node scripts/materialize-l1-build.mjs build --lock upstream/L1-BUILD.lock.json --output generated/runs/SWU-OEW-013B/l1-build-handle.json",
    "verify:l1-build": "node scripts/verify-l1-build.mjs verify --lock upstream/L1-BUILD.lock.json --handle generated/runs/SWU-OEW-013B/l1-build-handle.json --output generated/runs/SWU-OEW-013B/l1-build-verification.json",
    "test:browser": "node --test test/browser-acceptance.test.mjs",
    "verify:browser-acceptance": "node scripts/verify-browser-acceptance.mjs generated/runs/SWU-OEW-014/browser-acceptance.json"
  }
}
