{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.local/schemas/oew-evidence-sidecar.v1.json",
  "title": "Ontology Evidence Workbench Evidence Sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_run",
    "nodes",
    "edges",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "oew.evidence-sidecar.v1"
    },
    "source_run": {
      "$ref": "#/$defs/sourceRun"
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^presentation:[A-Za-z0-9._:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nodeRow"
      }
    },
    "edges": {
      "type": "object",
      "propertyNames": {
        "pattern": "^presentation-edge:[A-Za-z0-9._:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/edgeRow"
      }
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "terminal_receipt_sha256",
        "authority_effect"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "terminal_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "nodeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_kind",
        "source_kind_original",
        "source_artifact",
        "source_path",
        "source_digest",
        "presentation_type",
        "mapping_loss",
        "authority_effect"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "Finding",
            "Research artifact",
            "Definition",
            "Observation"
          ]
        },
        "source_kind_original": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "presentation_type": {
          "enum": [
            "claim",
            "source"
          ]
        },
        "mapping_loss": {
          "const": "generalized"
        },
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "edgeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source",
        "target",
        "source_relation",
        "presentation_relation",
        "mapping_loss",
        "policy_disposition",
        "diagnostics",
        "grounding_inclusion",
        "evidence_refs",
        "authority_effect"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source_relation": {
          "type": "string",
          "minLength": 1
        },
        "presentation_relation": {
          "enum": [
            "contradicts",
            "builds_on",
            "related"
          ]
        },
        "mapping_loss": {
          "enum": [
            "exact",
            "generalized",
            "lossy"
          ]
        },
        "policy_disposition": {
          "enum": [
            "policy-pass",
            "policy-fail",
            "policy-indeterminate",
            "not-applicable"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "grounding_inclusion": {
          "enum": [
            "included",
            "excluded",
            "not-applicable"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_effect": {
          "const": "none"
        }
      }
    }
  }
}
