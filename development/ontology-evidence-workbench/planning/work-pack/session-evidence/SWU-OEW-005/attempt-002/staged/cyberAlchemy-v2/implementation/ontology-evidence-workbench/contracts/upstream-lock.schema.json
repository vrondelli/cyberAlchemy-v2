{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/contracts/oew-upstream-lock.schema.json",
  "title": "OEW immutable upstream lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "commit",
    "license",
    "inspected_files",
    "package_manager",
    "viewer",
    "artifacts",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "oew.upstream-lock.v1"
    },
    "repository": {
      "const": "https://github.com/Egonex-AI/Understand-Anything"
    },
    "commit": {
      "const": "2cda14e89535049e49120198886bc0b82e9e630f"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"const": "MIT"},
        "path": {"const": "LICENSE"},
        "sha256": {
          "const": "24c4b35344840f1abaf3a3a4a44f5e29ee0e73b6bf25e42ef108e0afebd402bc"
        }
      }
    },
    "inspected_files": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "package_manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "lockfile"],
      "properties": {
        "name": {"const": "pnpm"},
        "version": {"const": "10.6.2"},
        "lockfile": {"const": "pnpm-lock.yaml"}
      }
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "build_command", "included_paths"],
      "properties": {
        "package": {"const": "understand-anything-viewer"},
        "version": {"const": "2.9.4"},
        "build_command": {
          "const": "pnpm --filter understand-anything-viewer build"
        },
        "included_paths": {
          "const": ["package.json", "README.md", "bin", "dist"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "viewer", "receipt"],
      "properties": {
        "source": {"const": "source.tar.gz"},
        "viewer": {"const": "viewer-dist.tar.gz"},
        "receipt": {"const": "build-receipt.json"}
      }
    },
    "authority_effect": {
      "const": "none"
    }
  }
}
