{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/oew/verified-run-handle/v1",
  "title": "OEW Verified Run Handle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified",
    "authority_effect",
    "source",
    "receipt_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "oew-verified-run-handle/v1"
    },
    "verified": {
      "const": true
    },
    "authority_effect": {
      "const": "none"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_directory",
        "receipt_path",
        "task_id",
        "swu_id"
      ],
      "properties": {
        "run_directory": {
          "type": "string",
          "minLength": 1
        },
        "receipt_path": {
          "type": "string",
          "pattern": "(^|/)terminal-receipt\\.json$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "swu_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "enum": [
              "digest-map.v1.json",
              "projection.v1.json",
              "result.v1.json",
              "terminal-receipt.json"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
