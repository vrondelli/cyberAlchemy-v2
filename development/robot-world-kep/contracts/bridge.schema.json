{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Local prototype only. Questions: ../OPEN-QUESTIONS.md",
  "$defs": {
    "ActionIntent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "robot-world.action/v1-prototype"
        },
        "world_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "enum": [
            "move",
            "gather",
            "deposit",
            "build",
            "wait"
          ]
        },
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -5,
            "maximum": 5
          }
        }
      },
      "required": [
        "schema_version",
        "world_id",
        "agent_id",
        "request_id",
        "expected_revision",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "move"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          },
          "else": {
            "not": {
              "required": [
                "target"
              ]
            }
          }
        }
      ]
    },
    "ArtifactManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "robot-world.artifact/v1-prototype"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "tool",
            "workflow"
          ]
        },
        "artifact_type": {
          "enum": [
            "dataset",
            "recipe"
          ]
        },
        "domain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "effect": {
          "enum": [
            "read-only",
            "simulation-only"
          ]
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,160}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,160}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schema_version",
        "capability_id",
        "version",
        "kind",
        "artifact_type",
        "domain",
        "effect",
        "consumers",
        "contributors",
        "byte_count"
      ],
      "additionalProperties": false
    },
    "QueryIntent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "robot-world.query/v1-prototype"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "world_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "consumer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "world_id",
        "consumer",
        "capability_id",
        "version",
        "limit"
      ],
      "additionalProperties": false
    },
    "ExchangeReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "robot-world.exchange/v1-prototype"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "world_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "consumer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,160}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "mode": {
          "const": "local-contract-fixture"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "world_id",
        "consumer",
        "capability_id",
        "version",
        "result_sha256",
        "row_count",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
