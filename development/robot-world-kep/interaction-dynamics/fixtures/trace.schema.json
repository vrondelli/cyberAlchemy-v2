{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Local trace shape only. Open questions: ../REPORT.md#open-questions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_sha256",
    "ablation",
    "dt",
    "snapshot",
    "actors",
    "clock_receipt",
    "state_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "robot-world.decision-trace/v1"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ablation": {
      "enum": [
        "full",
        "no-steering",
        "no-memory",
        "no-alignment",
        "no-cooperation",
        "no-caution"
      ]
    },
    "dt": {
      "const": 1.0
    },
    "snapshot": {
      "type": "object"
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "prior",
          "memory_before",
          "memory_after",
          "impulses",
          "event_ids",
          "decision",
          "semantic_after"
        ],
        "additionalProperties": false,
        "properties": {
          "prior": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "memory_before": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "memory_after": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "impulses": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "semantic_after": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "decision": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "agent_id",
              "source_revision",
              "semantic",
              "velocity",
              "neighbors",
              "steering",
              "weights",
              "candidates",
              "chosen"
            ],
            "properties": {
              "semantic": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "velocity": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "weights": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "candidates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "intent",
                    "features",
                    "score",
                    "eligible",
                    "rejection"
                  ],
                  "properties": {
                    "features": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number"
                      }
                    },
                    "score": {
                      "type": "number"
                    },
                    "eligible": {
                      "type": "boolean"
                    },
                    "intent": {
                      "type": "object"
                    },
                    "rejection": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "steering": {
                "type": "object",
                "required": [
                  "terms",
                  "scaled_force",
                  "semantic_force"
                ],
                "properties": {
                  "scaled_force": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  },
                  "semantic_force": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "clock_receipt": {
      "type": "object",
      "required": [
        "world_id",
        "revision",
        "event_hash",
        "status"
      ],
      "properties": {
        "event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "accepted"
        }
      }
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
