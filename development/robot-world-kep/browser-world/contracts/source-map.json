{
  "schema_version": "robot-world.browser-navigation/v1-prototype",
  "status": "local-agent-navigation-scaffold",
  "authority_effect": "none",
  "source_base": "../../unity-ui/unity/Assets/StreamingAssets/RobotWorld/demo-session/",
  "records": [
    {"term": "SessionSource", "source": "session.json", "selectors": ["schemaVersion", "mode", "frames", "catalog", "sourceReplaySha256", "sourceCatalogSha256"]},
    {"term": "ReplayCursor", "source": "session.json", "selectors": ["frames array order", "frames[].tick", "frames[].revision"], "rule": "82 frames, including two final revisions at tick 80"},
    {"term": "BrowserWorldView", "source": "session.json", "selectors": ["frames[].robots[].position"], "rule": "2D source projected onto horizontal X/Z; render interpolation does not mutate snapshots"},
    {"term": "AgentSelection", "source": "session.json", "selectors": ["frames[].robots[].id", "frames[].robots[].owner"], "rule": "Stable identity throughout session"},
    {"term": "AgentInspection", "source": "session.json", "selectors": ["frames[].robots[].energy", "frames[].robots[].cargo", "frames[].robots[].memory", "frames[].robots[].prior"]},
    {"term": "SessionIntegrity", "source": "session-manifest.json", "selectors": ["sha256", "byteCount", "frameCount", "sourceReplaySha256", "sourceCatalogSha256"], "rule": "Local content integrity, not producer authentication"}
  ],
  "open_questions": "../PLAN.md#open-questions"
}
