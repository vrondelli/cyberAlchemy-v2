{
  "schema_version": "iolm-candidate-negative-fixtures/v1",
  "base": "../positive/minimal-candidate-envelope.json",
  "cases": [
    {
      "id": "missing-posture",
      "mutations": [
        {"op": "remove", "path": "/input/posture"}
      ],
      "expected_codes": ["POSTURE_REQUIRED"]
    },
    {
      "id": "authoritative-self-label",
      "mutations": [
        {"op": "replace", "path": "/view/posture", "value": "authoritative"},
        {"op": "replace", "path": "/view/authority", "value": "authoritative-domain-graph"}
      ],
      "expected_codes": ["AUTHORITATIVE_SELF_LABEL"]
    },
    {
      "id": "missing-provenance",
      "mutations": [
        {"op": "remove", "path": "/view/nodes/0/provenance"}
      ],
      "expected_codes": ["PROVENANCE_REQUIRED"]
    },
    {
      "id": "missing-source-digest",
      "mutations": [
        {"op": "remove", "path": "/build_receipt/source_set_digest"}
      ],
      "expected_codes": ["SOURCE_DIGEST_REQUIRED"]
    },
    {
      "id": "missing-compiler-version",
      "mutations": [
        {"op": "remove", "path": "/input/compiler/version"}
      ],
      "expected_codes": ["COMPILER_VERSION_REQUIRED"]
    },
    {
      "id": "invalid-stable-id",
      "mutations": [
        {"op": "replace", "path": "/view/nodes/0/node_id", "value": "unstable id"}
      ],
      "expected_codes": ["STABLE_ID_INVALID"]
    },
    {
      "id": "duplicate-stable-id",
      "mutations": [
        {"op": "replace", "path": "/view/nodes/1/node_id", "value": "key-and-door.Player"},
        {"op": "replace", "path": "/view/nodes/1/provenance/source_record_id", "value": "key-and-door.Player"}
      ],
      "expected_codes": ["STABLE_ID_DUPLICATE"]
    },
    {
      "id": "dangling-stable-endpoint",
      "mutations": [
        {"op": "replace", "path": "/view/edges/0/to", "value": "key-and-door.Unknown"}
      ],
      "expected_codes": ["STABLE_ENDPOINT_MISSING"]
    },
    {
      "id": "g-dsv2-sg-evidence-claim",
      "mutations": [
        {"op": "add", "path": "/build_receipt/evidence_for/-", "value": "G-DSV2-SG"}
      ],
      "expected_codes": ["G_DSV2_SG_EVIDENCE_FORBIDDEN"]
    },
    {
      "id": "provenance-digest-mismatch",
      "mutations": [
        {"op": "replace", "path": "/view/provenance/minted_graph_digest", "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}
      ],
      "expected_codes": ["PROVENANCE_DIGEST_MISMATCH"]
    },
    {
      "id": "cross-document-identity-mismatch",
      "mutations": [
        {"op": "replace", "path": "/build_receipt/candidate_id", "value": "iolm.other-project.v1"}
      ],
      "expected_codes": ["CROSS_DOCUMENT_IDENTITY_MISMATCH"]
    },
    {
      "id": "minted-schema-binding-substitution",
      "mutations": [
        {"op": "replace", "path": "/input/minted_artifacts/graph/schema_id", "value": "https://example.invalid/authoritative-graph/v1"}
      ],
      "expected_codes": ["MINTED_SCHEMA_BINDING_INVALID"]
    }
  ]
}
