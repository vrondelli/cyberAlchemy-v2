{
  "schema_version": "oewtp.task-session-closeout.v1",
  "work_pack_id": "WP-OEWTP-001",
  "lifecycle_owner_route": "invoke:refresh:apply-approved",
  "authorization_ceiling": "closeout-only",
  "common_rules": {
    "attempt_binding": "Before any source mutation, Task Session assigns one collision-resistant concrete attempt_id, expands every <attempt-id> path in the selected SWU write scope and this inventory, records existing-target SHA-256 plus future-target absence, and rejects any remaining placeholder, collision, symlink escape, or active-owner overlap.",
    "baseline_binding": "Task Session records SHA-256 of every existing source/closeout target and declared absence of every future execution/closeout target immediately before source mutation; closeout rejects any unbound target or unrelated delta.",
    "execution_ownership": "The selected Task Session may apply only admitted materialWrites, then allow declared validation to produce only executionOutputs, with the terminal receipt last. Invoke Refresh may read those immutable outputs and write only declared_target_inventory.",
    "allowed_delta_classes": [
      "evidence_added",
      "status_changed",
      "blocker_opened",
      "blocker_resolved",
      "route_changed"
    ],
    "forbidden_delta_classes": [
      "implementation_source",
      "swu_contract_changed",
      "authority_changed",
      "promotion",
      "publication",
      "deployment",
      "destructive_cleanup",
      "unrelated_target"
    ],
    "owner_validation": [
      {
        "cwd": "<repository-root>",
        "command": "python3 -m json.tool cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/SWU-MANIFEST.json"
      },
      {
        "cwd": "<repository-root>",
        "command": "python3 -m json.tool cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/work-pack/chain-state.json"
      },
      {
        "cwd": "<repository-root>",
        "command": "bash tools/check_markdown_links.sh cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/WORK-PACK.md"
      },
      {
        "cwd": "<repository-root>",
        "command": "git diff --check -- cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype"
      }
    ],
    "terminal_source_receipt_contract": {
      "result": ["pass", "flag", "block", "interrupted"],
      "required_fields": [
        "swu_id",
        "attempt_id",
        "session_id",
        "capability_ref",
        "receipt_kind",
        "files_touched",
        "generated_outputs",
        "validation",
        "blockers",
        "residue",
        "handoff_note"
      ]
    },
    "expected_owner_receipt_contract": {
      "mode": "refresh",
      "phaseStatus": ["pass", "no-op"],
      "mutationMode": "apply-approved",
      "required_fields": [
        "mode",
        "phaseStatus",
        "mutationMode",
        "targetArtifacts",
        "appliedChanges",
        "materialPackage",
        "mutationReady",
        "result",
        "nextRoute"
      ],
      "write_outcome": "mutationReady=true with exact appliedChanges, or a receipt-backed no-op whose target bytes already encode the terminal source receipt",
      "forbidden_outcomes": [
        "implementation source mutation",
        "scope expansion",
        "authority or promotion change",
        "unvalidated successor selection"
      ]
    }
  },
