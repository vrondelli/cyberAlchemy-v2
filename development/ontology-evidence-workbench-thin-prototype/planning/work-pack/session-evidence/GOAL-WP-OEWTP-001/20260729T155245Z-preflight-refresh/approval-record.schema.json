{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/oewtp/planning-repair-approval/v1",
  "title": "OEWTPPlanningRepairApproval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "route",
    "authorized_by",
    "authorization_source",
    "scope_paths",
    "authority_class",
    "publication_class",
    "forbidden_scopes",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "oewtp.planning-repair-approval.v1"
    },
    "decision": {
      "const": "approved"
    },
    "route": {
      "const": "invoke:refresh:apply-approved"
    },
    "authorized_by": {
      "const": "human-prototype-owner"
    },
    "authorization_source": {
      "type": "string",
      "minLength": 1
    },
    "scope_paths": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/WORK-PACK.md",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/EXECUTION-PACK.md",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/SWU-MANIFEST.json",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/CLOSEOUT-SYNC-INVENTORY.json",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/work-pack/tasks/TASK-OEWTP-01-TYPED-ADMISSION.md",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/work-pack/tasks/TASK-OEWTP-02-BUILD-PRODUCER.md",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/work-pack/tasks/TASK-OEWTP-03-EVIDENCE-GATEWAY.md",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/work-pack/tasks/TASK-OEWTP-04-BROWSER-ACCEPTANCE.md",
          "cyberAlchemy-v2/development/ontology-evidence-workbench-thin-prototype/planning/MUTATION-ADMISSION-CONTRACT.json"
        ]
      }
    },
    "authority_class": {
      "const": "private"
    },
    "publication_class": {
      "const": "internal"
    },
    "forbidden_scopes": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "contains": {
        "const": "package manifests and lockfiles"
      },
      "items": {
        "enum": [
          "cyberAlchemy-v2/implementation/ontology-evidence-workbench/**",
          "cyberAlchemy-v2/development/ontology-evidence-workbench/**",
          "package manifests and lockfiles",
          "authority and promotion",
          "publication and deployment",
          "release and production"
        ]
      }
    },
    "claim_ceiling": {
      "const": "Planning runtime-contract repair only; no implementation mutation, SWU completion, browser witness, promotion, release, deployment, or production authority."
    }
  }
}
