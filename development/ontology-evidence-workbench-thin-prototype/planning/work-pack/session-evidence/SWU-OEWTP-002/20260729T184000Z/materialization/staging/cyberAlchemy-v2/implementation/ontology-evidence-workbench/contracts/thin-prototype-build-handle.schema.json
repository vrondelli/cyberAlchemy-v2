{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/schemas/oewtp/thin-prototype-build-handle/v1",
  "title": "OEW Thin Prototype Build Handle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "work_pack_id",
    "swu_id",
    "attempt_id",
    "result",
    "predecessor",
    "inputs",
    "toolchain",
    "workroot",
    "commands",
    "typed_test_discovery",
    "core_dist",
    "dashboard_dist",
    "package_manifests",
    "cleanup",
    "claim_ceiling",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "oewtp.thin-prototype-build-handle.v1"
    },
    "handle": {
      "type": "string",
      "pattern": "^oewtp-thin-prototype-build/[0-9]{8}T[0-9]{6}Z$"
    },
    "work_pack_id": {
      "const": "WP-OEWTP-001"
    },
    "swu_id": {
      "const": "SWU-OEWTP-002"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z$"
    },
    "result": {
      "const": "pass"
    },
    "predecessor": {
      "type": "object",
      "required": [
        "typed_receipt",
        "closeout_receipt",
        "typed_handle"
      ]
    },
    "inputs": {
      "type": "object",
      "required": [
        "toolchain_lock",
        "source_archive",
        "overlay_manifest",
        "first_working_manifest",
        "entry_patch",
        "package_registry",
        "overlay_files"
      ]
    },
    "toolchain": {
      "type": "object",
      "required": [
        "node",
        "pnpm"
      ]
    },
    "workroot": {
      "type": "object",
      "required": [
        "name",
        "input_digest",
        "digest_named",
        "outside_repository",
        "fresh",
        "archive_member_count",
        "isolated_store"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "program",
          "args",
          "cwd",
          "exit_code",
          "stdout_sha256",
          "stderr_sha256",
          "duration_ms"
        ]
      }
    },
    "typed_test_discovery": {
      "type": "object",
      "required": [
        "files",
        "file_count",
        "test_count",
        "passed",
        "failed"
      ],
      "properties": {
        "file_count": {
          "const": 6
        },
        "test_count": {
          "const": 6
        },
        "passed": {
          "const": 6
        },
        "failed": {
          "const": 0
        }
      }
    },
    "core_dist": {
      "$ref": "#/$defs/tree"
    },
    "dashboard_dist": {
      "allOf": [
        {
          "$ref": "#/$defs/tree"
        },
        {
          "type": "object",
          "required": [
            "path",
            "entrypoint",
            "immutable",
            "copy_verified"
          ],
          "properties": {
            "immutable": {
              "const": true
            },
            "copy_verified": {
              "const": true
            },
            "entrypoint": {
              "const": "index.html"
            }
          }
        }
      ]
    },
    "package_manifests": {
      "type": "object",
      "required": [
        "before",
        "after",
        "unchanged"
      ],
      "properties": {
        "unchanged": {
          "const": true
        }
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "finally_executed",
        "workroot_removed",
        "isolated_store_removed",
        "retained_dist_preserved"
      ],
      "properties": {
        "finally_executed": {
          "const": true
        },
        "workroot_removed": {
          "const": true
        },
        "isolated_store_removed": {
          "const": true
        },
        "retained_dist_preserved": {
          "const": true
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "$defs": {
    "tree": {
      "type": "object",
      "required": [
        "tree_sha256",
        "file_count",
        "byte_size"
      ],
      "properties": {
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
