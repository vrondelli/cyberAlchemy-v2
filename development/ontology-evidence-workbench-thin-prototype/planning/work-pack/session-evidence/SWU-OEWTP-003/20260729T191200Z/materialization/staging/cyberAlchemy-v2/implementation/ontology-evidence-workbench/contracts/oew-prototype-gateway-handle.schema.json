{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.dev/schemas/oewtp/prototype-gateway-handle/v1",
  "title": "OEW Prototype Gateway Handle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "work_pack_id",
    "swu_id",
    "attempt_id",
    "result",
    "process",
    "build",
    "adapter",
    "loader_contract",
    "routes",
    "request_bank",
    "closure",
    "claim_ceiling",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "oewtp.prototype-gateway-handle.v1"
    },
    "handle": {
      "type": "string",
      "pattern": "^oewtp-prototype-gateway/[0-9]{8}T[0-9]{6}Z$"
    },
    "work_pack_id": {
      "const": "WP-OEWTP-001"
    },
    "swu_id": {
      "const": "SWU-OEWTP-003"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z$"
    },
    "result": {
      "const": "pass"
    },
    "process": {
      "type": "object",
      "required": [
        "pid",
        "ownership",
        "bind_host",
        "port",
        "url_shape",
        "token_sha256",
        "token_persisted"
      ],
      "properties": {
        "bind_host": {
          "const": "127.0.0.1"
        },
        "token_persisted": {
          "const": false
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "handle",
        "dist_path",
        "tree_sha256",
        "file_count",
        "byte_size"
      ]
    },
    "adapter": {
      "type": "object",
      "required": [
        "run",
        "receipt_sha256",
        "graph_sha256",
        "sidecar_sha256",
        "authority_effect"
      ],
      "properties": {
        "authority_effect": {
          "const": "none"
        }
      }
    },
    "loader_contract": {
      "type": "object",
      "required": [
        "oew_app",
        "loader",
        "same_origin_requests",
        "tokenized_requests",
        "credentials_omit_requests"
      ]
    },
    "routes": {
      "type": "object",
      "required": [
        "bootstrap",
        "static_prefix",
        "evidence",
        "evidence_requires_explicit_token",
        "cookie_scope"
      ],
      "properties": {
        "evidence_requires_explicit_token": {
          "const": true
        },
        "cookie_scope": {
          "const": "static-only"
        }
      }
    },
    "request_bank": {
      "type": "object",
      "required": [
        "result",
        "probes",
        "passed",
        "failed",
        "protected_bytes_on_reject",
        "outbound_requests"
      ],
      "properties": {
        "result": {
          "const": "pass"
        },
        "failed": {
          "const": 0
        },
        "protected_bytes_on_reject": {
          "const": 0
        },
        "outbound_requests": {
          "const": 0
        }
      }
    },
    "closure": {
      "type": "object",
      "required": [
        "server_closed",
        "port_released",
        "output_written_after_close"
      ],
      "properties": {
        "server_closed": {
          "const": true
        },
        "port_released": {
          "const": true
        },
        "output_written_after_close": {
          "const": true
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "none"
    }
  }
}
