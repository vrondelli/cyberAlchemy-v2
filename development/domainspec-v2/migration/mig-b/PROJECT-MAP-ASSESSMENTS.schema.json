{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.domainspec-v2-project-map-assessments/v1",
  "title": "DomainSpec v2 development-directory lifecycle assessments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "status",
    "authority_effect",
    "classification_precedence",
    "classifications",
    "migration_dispositions",
    "directories"
  ],
  "properties": {
    "schema_version": { "const": "cav2.domainspec-v2-project-map-assessments/v1" },
    "assessment_id": { "const": "CAV2-DOMAINSPEC-V2-MIG-B-ASSESSMENTS-001" },
    "status": { "const": "evidence-assessed" },
    "authority_effect": { "const": "none" },
    "classification_precedence": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "classifications": { "type": "object", "minProperties": 5 },
    "migration_dispositions": { "type": "object", "minProperties": 5 },
    "directories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "lifecycle_status",
          "confidence",
          "bounded_outcome",
          "evidence_refs",
          "residue",
          "migration_disposition"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "lifecycle_status": {
            "enum": ["completed", "active", "blocked", "superseded", "historical"]
          },
          "confidence": { "enum": ["high", "medium"] },
          "bounded_outcome": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^projects/domainspec-v2/" }
          },
          "residue": { "type": "string", "minLength": 1 },
          "migration_disposition": {
            "enum": [
              "carry-forward-active-dependency",
              "carry-forward-continuation",
              "preserve-completed-provenance",
              "archive-superseded-provenance",
              "archive-historical-provenance"
            ]
          }
        }
      }
    }
  }
}
