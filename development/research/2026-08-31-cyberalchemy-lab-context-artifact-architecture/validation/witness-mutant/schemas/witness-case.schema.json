{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-lab:research:witness-case:v1",
  "title": "CyberAlchemy-lab synthetic witness case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "kind",
    "description",
    "expected",
    "mutations"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(WITNESS|MUT)-[A-Z0-9-]+$"
    },
    "kind": {
      "enum": ["positive_witness", "negative_mutant"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "error_codes"],
      "properties": {
        "result": {
          "enum": ["pass", "reject"]
        },
        "error_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E_[A-Z0-9_]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": {
            "enum": ["remove", "replace"]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {"const": "replace"}
              }
            },
            "then": {
              "required": ["value"]
            }
          }
        ]
      }
    }
  }
}
