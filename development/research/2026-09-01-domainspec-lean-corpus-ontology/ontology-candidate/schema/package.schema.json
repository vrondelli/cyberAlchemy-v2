{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyberalchemy-v2:lean-corpus-ontology-candidate-package:v2",
  "title": "DomainSpec Lean corpus ontology candidate package shapes",
  "description": "Version-pinned companion schema. scripts/validate.py is the normative executable validator; neither surface grants authority.",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ontology_id", "label", "ontology_type", "status", "visibility", "operational_owner_route", "semantic_owner_status", "source_commit", "authority_effect", "runtime_enforcement", "admission_claim", "implementation_binding_claim", "conformance_claim"],
      "properties": {
        "schema_version": {"const": "lean-corpus-ontology-candidate-profile/v2"},
        "ontology_id": {"const": "CA2-ONTOLOGY-CANDIDATE-DOMAINSPEC-LEAN-CORPUS-2026-09-01"},
        "label": {"type": "string", "minLength": 1},
        "ontology_type": {"const": "authority-governance"},
        "status": {"const": "research-candidate"},
        "visibility": {"const": "private"},
        "operational_owner_route": {"const": "CA2-ROUTE-IMPLEMENT"},
        "semantic_owner_status": {"const": "unselected"},
        "source_commit": {"const": "169d4a46aeaafba62c8bad127fc0522c3223e962"},
        "authority_effect": {"const": "none"},
        "runtime_enforcement": {"const": false},
        "admission_claim": {"const": false},
        "implementation_binding_claim": {"const": false},
        "conformance_claim": {"const": false}
      }
    },
    "lean_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_selector", "qualified_name", "declaration_kind", "line", "declaration_line_sha256"],
      "properties": {
        "research_selector": {"type": "string", "minLength": 1},
        "qualified_name": {"type": "string", "minLength": 1},
        "declaration_kind": {"enum": ["def", "theorem"]},
        "line": {"type": "integer", "minimum": 1},
        "declaration_line_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "research_artifact_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "path", "sha256", "disposition", "disposition_reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"const": "research-artifact"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "disposition": {"enum": ["support", "context-only"]},
        "disposition_reason": {"type": "string", "minLength": 1}
      }
    },
    "lean_declaration_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "repository", "commit", "path", "blob", "selectors", "disposition", "disposition_reason"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"const": "lean-declaration-source"},
        "repository": {"const": "domainspec-lean-formalization"},
        "commit": {"const": "169d4a46aeaafba62c8bad127fc0522c3223e962"},
        "path": {"type": "string", "minLength": 1},
        "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "selectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lean_selector"}},
        "disposition": {"enum": ["support-candidate", "support-bounded", "excluded-with-reason"]},
        "disposition_reason": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "oneOf": [
        {"$ref": "#/$defs/research_artifact_source"},
        {"$ref": "#/$defs/lean_declaration_source"}
      ]
    },
    "selector_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "qualified_name"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "qualified_name": {"type": "string", "minLength": 1}
      }
    },
    "review_responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsibility_type", "subject"],
      "properties": {
        "responsibility_type": {"const": "proposed-non-executable-review"},
        "subject": {"type": "string", "minLength": 1}
      }
    },
    "research_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "record_kind", "label", "definition", "proposed_record_kinds", "source_refs", "supporting_selectors", "method", "uncertainty", "claim_ceiling", "proposed_review_responsibilities", "promotion_prerequisite_gap", "global_prerequisite_gap_ids", "status", "semantic_owner_status", "authority_effect"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "record_kind": {"const": "research-finding"},
        "label": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "proposed_record_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["relation", "predicate", "invariant", "mapping", "schema"]}},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "supporting_selectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selector_ref"}},
        "method": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "claim_ceiling": {"type": "string", "minLength": 1},
        "proposed_review_responsibilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review_responsibility"}},
        "promotion_prerequisite_gap": {"type": "string", "minLength": 1},
        "global_prerequisite_gap_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "status": {"enum": ["candidate-review-only", "deferred"]},
        "semantic_owner_status": {"const": "unselected"},
        "authority_effect": {"const": "none"}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "applies_to", "statement", "authority_effect"],
      "properties": {
        "invariant_id": {"type": "string", "minLength": 1},
        "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "statement": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"}
      }
    },
    "prerequisite_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "scope", "d65_stage", "status", "required_resolution"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "scope": {"const": "global-package-prerequisite"},
        "d65_stage": {"type": "string", "minLength": 1},
        "status": {"enum": ["missing", "unselected"]},
        "required_resolution": {"type": "string", "minLength": 1}
      }
    },
    "receipt_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "ontology_id", "validation_result", "validated_at", "validator", "content_digests", "package_digest", "source_commit", "authority_effect"],
      "properties": {
        "schema_version": {"const": "lean-corpus-ontology-candidate-validation-receipt/v1"},
        "receipt_id": {"type": "string", "minLength": 1},
        "ontology_id": {"const": "CA2-ONTOLOGY-CANDIDATE-DOMAINSPEC-LEAN-CORPUS-2026-09-01"},
        "validation_result": {"const": "pass"},
        "validated_at": {"type": "string", "format": "date-time"},
        "validator": {"const": "scripts/validate.py"},
        "content_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"const": "169d4a46aeaafba62c8bad127fc0522c3223e962"},
        "authority_effect": {"const": "none"}
      }
    },
    "receipt_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "ontology_id", "validation_result", "validated_at", "validator", "content_digests", "package_digest", "source_commit", "authority_effect", "supersedes_receipt_id", "currentness_claim"],
      "properties": {
        "schema_version": {"const": "lean-corpus-ontology-candidate-validation-receipt/v2"},
        "receipt_id": {"type": "string", "minLength": 1},
        "ontology_id": {"const": "CA2-ONTOLOGY-CANDIDATE-DOMAINSPEC-LEAN-CORPUS-2026-09-01"},
        "validation_result": {"const": "pass"},
        "validated_at": {"type": "string", "format": "date-time"},
        "validator": {"const": "scripts/validate.py"},
        "content_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"const": "169d4a46aeaafba62c8bad127fc0522c3223e962"},
        "authority_effect": {"const": "none"},
        "supersedes_receipt_id": {"type": "string", "minLength": 1},
        "currentness_claim": {"const": "historical-validation-only"}
      }
    }
  }
}
