{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "define-condition-manifest@1",
  "title": "Define experiment condition manifest",
  "description": "Structural index. validate_condition_manifest.py is the executable invariant contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "evidence_kind",
    "task_id",
    "task_class",
    "repository_commit",
    "source_packet_digest",
    "fact_set_digest",
    "authority_effect",
    "facts",
    "conditions",
    "parity_reviews",
    "costs"
  ],
  "properties": {
    "schema_version": {"const": "define-condition-manifest@1"},
    "protocol_id": {"const": "define-downstream-utility@1"},
    "evidence_kind": {"enum": ["synthetic_fixture", "live_run"]},
    "task_id": {"type": "string", "minLength": 3},
    "task_class": {"enum": ["low_ambiguity_control", "high_ambiguity"]},
    "repository_commit": {"type": "string", "minLength": 7},
    "source_packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fact_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_effect": {"const": "none"},
    "facts": {"type": "array", "minItems": 1},
    "conditions": {"type": "object"},
    "parity_reviews": {"type": "array", "minItems": 2, "maxItems": 2},
    "costs": {"type": "object"}
  }
}
