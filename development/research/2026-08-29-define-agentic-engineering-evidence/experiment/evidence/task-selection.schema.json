{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "define-task-selection@1",
  "title": "Define experiment task-selection record",
  "description": "Structural index. validate_task_selection.py is the executable ambiguity and selection contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "evidence_kind",
    "recorded_at",
    "recorded_by",
    "selection_locked_before_condition_outputs",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "define-task-selection@1"},
    "protocol_id": {"const": "define-downstream-utility@1"},
    "evidence_kind": {"enum": ["synthetic_fixture", "live_run"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "recorded_by": {"type": "string", "minLength": 1},
    "selection_locked_before_condition_outputs": {"const": true},
    "candidates": {"type": "array", "minItems": 1}
  }
}
