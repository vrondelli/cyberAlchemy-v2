{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/define-task-runtime-profile-v1.json",
  "title": "Define task runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repository_commit",
    "visible_source_paths",
    "evaluator_source_root",
    "withheld_target_paths",
    "hidden_test_paths",
    "allowed_write_paths",
    "forbidden_paths",
    "target_path",
    "stub_fixture_path",
    "stub_fixture_sha256",
    "original_implementation_markers",
    "dependency_closure_digest",
    "agent_runtime_image_or_toolchain_digest",
    "evaluator_runtime_image_or_toolchain_digest",
    "visible_validation_commands",
    "hidden_validation_commands",
    "resource_limits",
    "network_policy",
    "expected_action",
    "baseline_receipt_path",
    "baseline_receipt_digest"
  ],
  "properties": {
    "schema_version": { "const": "define-task-runtime-profile@1" },
    "task_id": { "type": "string", "minLength": 1 },
    "repository_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "visible_source_paths": { "$ref": "#/$defs/nonEmptyPaths" },
    "evaluator_source_root": { "$ref": "#/$defs/path" },
    "withheld_target_paths": { "$ref": "#/$defs/nonEmptyPaths" },
    "hidden_test_paths": { "$ref": "#/$defs/nonEmptyPaths" },
    "allowed_write_paths": { "$ref": "#/$defs/nonEmptyPaths" },
    "forbidden_paths": { "$ref": "#/$defs/paths" },
    "target_path": { "$ref": "#/$defs/path" },
    "stub_fixture_path": { "$ref": "#/$defs/path" },
    "stub_fixture_sha256": { "$ref": "#/$defs/sha256" },
    "original_implementation_markers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "dependency_closure_digest": { "$ref": "#/$defs/sha256" },
    "agent_runtime_image_or_toolchain_digest": { "$ref": "#/$defs/sha256" },
    "evaluator_runtime_image_or_toolchain_digest": { "$ref": "#/$defs/sha256" },
    "runtime_identity": { "type": "string", "minLength": 1 },
    "runtime_authority": { "type": "string", "minLength": 1 },
    "visible_validation_commands": { "$ref": "#/$defs/commands" },
    "hidden_validation_commands": { "$ref": "#/$defs/commands" },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "memory_mebibytes", "cpu_count"],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "memory_mebibytes": { "type": "integer", "minimum": 64 },
        "cpu_count": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "network_policy": { "const": "none" },
    "expected_action": { "type": "string", "minLength": 1 },
    "baseline_receipt_path": { "$ref": "#/$defs/path" },
    "baseline_receipt_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true
    },
    "nonEmptyPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
