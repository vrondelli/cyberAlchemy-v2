{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/define-synthetic-task-block-v1.json",
  "title": "Define L3 synthetic task block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "evidence_kind",
    "experiment_id",
    "task_id",
    "block_attempt_id",
    "source",
    "materials_sha256",
    "condition_manifest_sha256",
    "synthetic_selection_sha256",
    "truth_card_sha256",
    "hidden_case_count",
    "seed_text",
    "seed_number",
    "condition_order",
    "synthetic_adapter",
    "authority_effect",
    "live_authorized",
    "model_calls",
    "network_policy",
    "candidate_digest"
  ],
  "properties": {
    "schema_version": {"const": "define-synthetic-task-block@1"},
    "protocol_id": {"const": "define-downstream-utility@1"},
    "evidence_kind": {"const": "synthetic_fixture"},
    "experiment_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "block_attempt_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"},
    "source": {"type": "object"},
    "materials_sha256": {"$ref": "#/$defs/sha256"},
    "condition_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "synthetic_selection_sha256": {"$ref": "#/$defs/sha256"},
    "truth_card_sha256": {"$ref": "#/$defs/sha256"},
    "hidden_case_count": {"type": "integer", "minimum": 3},
    "seed_text": {"type": "string", "minLength": 1},
    "seed_number": {"type": "integer", "minimum": 0},
    "condition_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["ticket_only", "equivalent_notes", "definition_pack", "definition_pack_evidence_gate"]}
    },
    "synthetic_adapter": {"const": "define-neutral-synthetic-adapter@1"},
    "authority_effect": {"const": "none"},
    "live_authorized": {"const": false},
    "model_calls": {"const": 0},
    "network_policy": {"const": "none"},
    "candidate_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
