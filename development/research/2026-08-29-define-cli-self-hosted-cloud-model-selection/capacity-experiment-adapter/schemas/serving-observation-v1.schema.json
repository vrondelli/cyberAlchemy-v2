{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/capacity-experiment/serving-observation/v1",
  "type": "object",
  "required": ["schema", "observation_id", "model_profile_id", "model_revision", "vllm_version", "runtime_digest", "container_digest", "container_identity_kind", "image_config_digest", "execution_snapshot_digest", "server_args_digest", "benchmark_args_digest", "executed_args_digest", "gpu_process_snapshot_digest", "tokenizer_digest", "adapter_digest", "gpu_uuid", "seed", "configuration_digest", "weight_dtype", "compute_dtype", "requested_kv_dtype", "kv_dtype", "technique", "context_tokens", "prompt_tokens", "response_token_budget", "max_concurrency", "observed_max_in_flight", "completed_requests", "failed_requests", "duration_ms", "observed_milli_rps", "memory", "source_sha256", "evidence_class"],
  "properties": {
    "schema": {"const": "capacity-experiment/serving-observation/v1"},
    "observation_id": {"$ref": "#/$defs/sha256"},
    "model_profile_id": {"$ref": "#/$defs/sha256"},
    "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "vllm_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-].*)?$"},
    "runtime_digest": {"$ref": "#/$defs/sha256"},
    "container_digest": {"$ref": "#/$defs/sha256"},
    "container_identity_kind": {"enum": ["execution_snapshot", "declared_oci_manifest"]},
    "image_config_digest": {"$ref": "#/$defs/sha256"},
    "execution_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "server_args_digest": {"$ref": "#/$defs/sha256"},
    "benchmark_args_digest": {"$ref": "#/$defs/sha256"},
    "executed_args_digest": {"$ref": "#/$defs/sha256"},
    "gpu_process_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "tokenizer_digest": {"$ref": "#/$defs/sha256"},
    "adapter_digest": {"$ref": "#/$defs/sha256"},
    "gpu_uuid": {"type": "string", "pattern": "^GPU-"},
    "seed": {"type": "integer", "minimum": 0},
    "configuration_digest": {"$ref": "#/$defs/sha256"},
    "weight_dtype": {"type": "string", "minLength": 1},
    "compute_dtype": {"type": "string", "minLength": 1},
    "requested_kv_dtype": {"type": "string", "minLength": 1},
    "kv_dtype": {"type": "string", "minLength": 1},
    "technique": {"enum": ["uncached", "prefix_cache_observed"]},
    "context_tokens": {"const": 32768},
    "prompt_tokens": {"const": 30720},
    "response_token_budget": {"const": 2048},
    "max_concurrency": {"type": "integer", "minimum": 1},
    "observed_max_in_flight": {"type": "integer", "minimum": 1},
    "completed_requests": {"type": "integer", "minimum": 1},
    "failed_requests": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "integer", "minimum": 1},
    "observed_milli_rps": {"type": "integer", "minimum": 1},
    "memory": {"type": "object"},
    "source_sha256": {"type": "object"},
    "evidence_class": {"const": "observed_single_replica_serving"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
