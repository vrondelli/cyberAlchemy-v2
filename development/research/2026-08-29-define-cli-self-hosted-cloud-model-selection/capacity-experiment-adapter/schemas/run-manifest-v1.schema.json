{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capacity-experiment/run-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "observation_start_ms", "observation_end_ms", "model_profile_id", "runtime_digest", "container_digest", "tokenizer_digest", "template_digest", "parser_digest", "adapter_digest", "weight_dtype", "kv_dtype", "placement", "tensor_parallel", "pipeline_parallel", "expert_parallel", "techniques", "context_tokens", "response_tokens", "workload_digest", "pipeline_digest", "gates_digest", "pipeline_shape", "serving_replicas", "target_milli_rps", "declared_shards", "declared_facets", "ttft_percentile_milli", "latency_percentile_milli", "min_samples"],
  "properties": {
    "schema": {"const": "capacity-experiment/run-manifest/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "observation_start_ms": {"type": "integer", "minimum": 0},
    "observation_end_ms": {"type": "integer", "minimum": 1},
    "model_profile_id": {"$ref": "#/$defs/sha256"},
    "runtime_digest": {"$ref": "#/$defs/sha256"},
    "container_digest": {"$ref": "#/$defs/sha256"},
    "tokenizer_digest": {"$ref": "#/$defs/sha256"},
    "template_digest": {"$ref": "#/$defs/sha256"},
    "parser_digest": {"$ref": "#/$defs/sha256"},
    "adapter_digest": {"$ref": "#/$defs/sha256"},
    "weight_dtype": {"type": "string", "minLength": 1},
    "kv_dtype": {"type": "string", "minLength": 1},
    "placement": {"type": "string", "minLength": 1},
    "tensor_parallel": {"type": "integer", "minimum": 1},
    "pipeline_parallel": {"type": "integer", "minimum": 1},
    "expert_parallel": {"type": "integer", "minimum": 1},
    "techniques": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "context_tokens": {"type": "integer", "minimum": 1},
    "response_tokens": {"type": "integer", "minimum": 0},
    "workload_digest": {"$ref": "#/$defs/sha256"},
    "pipeline_digest": {"$ref": "#/$defs/sha256"},
    "gates_digest": {"$ref": "#/$defs/sha256"},
    "pipeline_shape": {"type": "object"},
    "serving_replicas": {"type": "integer", "minimum": 1},
    "target_milli_rps": {"type": "integer", "minimum": 1},
    "declared_shards": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "declared_facets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "ttft_percentile_milli": {"type": "integer", "minimum": 1, "maximum": 1000},
    "latency_percentile_milli": {"type": "integer", "minimum": 1, "maximum": 1000},
    "min_samples": {"type": "integer", "minimum": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
}
