{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capacity-experiment/cognitive-event/v1",
  "type": "object", "additionalProperties": false,
  "required": ["attempt_id", "request_id", "worker_id", "role", "point_id", "shard_id", "facets", "evaluator_verdict", "language_quality_milli", "drift", "collision", "collapse", "premature_abstraction", "timestamp_ms"],
  "properties": {
    "attempt_id": {"type": "string", "minLength": 1}, "request_id": {"type": "string", "minLength": 1}, "worker_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["distill", "proposal", "tournament"]}, "track_id": {"type": ["string", "null"]}, "point_id": {"type": "string", "minLength": 1}, "shard_id": {"type": "string", "minLength": 1},
    "facets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "evidence_id": {"type": ["string", "null"]}, "evidence_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "evaluator_verdict": {"enum": ["accepted", "rejected", "missing"]}, "language_quality_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
    "drift": {"type": "boolean"}, "collision": {"type": "boolean"}, "collapse": {"type": "boolean"}, "premature_abstraction": {"type": "boolean"}, "timestamp_ms": {"type": "integer", "minimum": 0}
  }
}
