{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/capacity-experiment/serving-projection/v1",
  "type": "object",
  "required": ["schema", "projection_id", "model_profile_id", "model_revision", "vllm_version", "runtime_digest", "container_digest", "container_identity_kind", "image_config_digest", "execution_snapshot_digest", "tokenizer_digest", "adapter_digest", "gpu_uuid", "seed", "configuration_digest", "weight_dtype", "compute_dtype", "requested_kv_dtype", "kv_dtype", "technique", "active_agents", "inference_points_per_request", "parallel_inference_points_per_request", "headroom_milli", "selected_max_concurrency", "raw_capacity_milli_rps", "usable_capacity_milli_rps", "stable_points", "requirements", "evidence_class", "claim_ceiling"],
  "properties": {
    "schema": {"const": "capacity-experiment/serving-projection/v1"},
    "projection_id": {"$ref": "#/$defs/sha256"},
    "model_profile_id": {"$ref": "#/$defs/sha256"},
    "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "vllm_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-].*)?$"},
    "runtime_digest": {"$ref": "#/$defs/sha256"},
    "container_digest": {"$ref": "#/$defs/sha256"},
    "container_identity_kind": {"enum": ["execution_snapshot", "declared_oci_manifest"]},
    "image_config_digest": {"$ref": "#/$defs/sha256"},
    "execution_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "tokenizer_digest": {"$ref": "#/$defs/sha256"},
    "adapter_digest": {"$ref": "#/$defs/sha256"},
    "gpu_uuid": {"type": "string", "pattern": "^GPU-"},
    "seed": {"type": "integer", "minimum": 0},
    "configuration_digest": {"$ref": "#/$defs/sha256"},
    "weight_dtype": {"type": "string", "minLength": 1},
    "compute_dtype": {"type": "string", "minLength": 1},
    "requested_kv_dtype": {"type": "string", "minLength": 1},
    "kv_dtype": {"type": "string", "minLength": 1},
    "technique": {"enum": ["uncached", "prefix_cache_observed"]},
    "active_agents": {"type": "integer", "minimum": 1},
    "inference_points_per_request": {"type": "integer", "minimum": 1},
    "parallel_inference_points_per_request": {"type": "integer", "minimum": 1},
    "headroom_milli": {"type": "integer", "minimum": 1, "maximum": 1000},
    "selected_max_concurrency": {"type": "integer", "minimum": 1},
    "raw_capacity_milli_rps": {"type": "integer", "minimum": 1},
    "usable_capacity_milli_rps": {"type": "integer", "minimum": 1},
    "stable_points": {"type": "array", "minItems": 1},
    "requirements": {"type": "array", "minItems": 1},
    "evidence_class": {"const": "single_replica_projection"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
