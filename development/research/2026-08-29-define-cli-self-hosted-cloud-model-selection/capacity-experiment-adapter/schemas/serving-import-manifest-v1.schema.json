{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/capacity-experiment/serving-import-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "model_profile_id", "model_revision", "vllm_version", "runtime_digest", "container_digest", "container_identity_kind", "image_config_digest", "execution_snapshot_digest", "server_args_digest", "benchmark_args_digest", "executed_args_digest", "gpu_process_snapshot_digest", "tokenizer_digest", "adapter_digest", "gpu_uuid", "seed", "weight_dtype", "compute_dtype", "requested_kv_dtype", "kv_dtype", "technique", "context_tokens", "prompt_tokens", "response_token_budget", "max_concurrency", "resident_prefixes", "observation_start_ms", "observation_end_ms", "weights_artifact_bytes", "idle_gpu_used_bytes", "unrelated_gpu_processes_observed"],
  "properties": {
    "schema": {"const": "capacity-experiment/serving-import-manifest/v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "model_profile_id": {"$ref": "#/$defs/sha256"},
    "model_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "vllm_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-].*)?$"},
    "runtime_digest": {"$ref": "#/$defs/sha256"},
    "container_digest": {"$ref": "#/$defs/sha256"},
    "container_identity_kind": {"enum": ["execution_snapshot", "declared_oci_manifest"]},
    "image_config_digest": {"$ref": "#/$defs/sha256"},
    "execution_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "server_args_digest": {"$ref": "#/$defs/sha256"},
    "benchmark_args_digest": {"$ref": "#/$defs/sha256"},
    "executed_args_digest": {"$ref": "#/$defs/sha256"},
    "gpu_process_snapshot_digest": {"$ref": "#/$defs/sha256"},
    "tokenizer_digest": {"$ref": "#/$defs/sha256"},
    "adapter_digest": {"$ref": "#/$defs/sha256"},
    "gpu_uuid": {"type": "string", "pattern": "^GPU-"},
    "seed": {"type": "integer", "minimum": 0},
    "cache_metrics_digest": {"$ref": "#/$defs/sha256"},
    "weight_dtype": {"type": "string", "minLength": 1},
    "compute_dtype": {"type": "string", "minLength": 1},
    "requested_kv_dtype": {"type": "string", "minLength": 1},
    "kv_dtype": {"type": "string", "minLength": 1},
    "technique": {"enum": ["uncached", "prefix_cache_observed"]},
    "context_tokens": {"const": 32768},
    "prompt_tokens": {"const": 30720},
    "response_token_budget": {"const": 2048},
    "max_concurrency": {"type": "integer", "minimum": 1},
    "resident_prefixes": {"type": "integer", "minimum": 0},
    "observation_start_ms": {"type": "integer", "minimum": 0},
    "observation_end_ms": {"type": "integer", "minimum": 1},
    "weights_artifact_bytes": {"type": "integer", "minimum": 1},
    "idle_gpu_used_bytes": {"type": "integer", "minimum": 1},
    "unrelated_gpu_processes_observed": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
}
