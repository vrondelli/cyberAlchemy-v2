{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capacity-experiment/request-sample/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "attempt_id", "replica_id", "started_ms", "first_token_ms", "completed_ms", "prompt_tokens", "response_tokens", "outcome"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "replica_id": {"type": "string", "minLength": 1},
    "started_ms": {"type": "integer", "minimum": 0}, "first_token_ms": {"type": "integer", "minimum": 0}, "completed_ms": {"type": "integer", "minimum": 0},
    "prompt_tokens": {"type": "integer", "minimum": 0}, "response_tokens": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["success", "error", "timeout", "oom"]}
  }
}
