{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capacity-experiment/scenario-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workload_digest", "pipeline_digest", "gates_digest", "context_tokens", "response_tokens", "target_milli_rps", "required_capabilities", "required_facets", "serving_requirements", "gates", "budgets", "min_observation_samples", "search_limit"],
  "properties": {
    "schema": {"const": "capacity-experiment/scenario-policy/v1"},
    "workload_digest": {"$ref": "#/$defs/sha256"}, "pipeline_digest": {"$ref": "#/$defs/sha256"}, "gates_digest": {"$ref": "#/$defs/sha256"},
    "context_tokens": {"type": "integer", "minimum": 1}, "response_tokens": {"type": "integer", "minimum": 0},
    "target_milli_rps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_facets": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "serving_requirements": {"type": "object"}, "gates": {"type": "object"}, "budgets": {"type": "object"},
    "max_cost_microunits_per_hour": {"type": ["integer", "null"], "minimum": 1},
    "min_observation_samples": {"type": "integer", "minimum": 1}, "search_limit": {"type": "integer", "minimum": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
}
