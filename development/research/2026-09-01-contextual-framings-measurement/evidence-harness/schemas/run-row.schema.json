{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acft-run-row@1",
  "title": "ACFT append-only run row",
  "description": "Structural index; validate_harness.py owns arithmetic, manifest joins, pair cardinality, adjudication, and dry/live invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "evidence_kind", "run_id", "fixture_id", "witness_class", "condition", "status", "frozen", "execution", "controls", "outcomes", "adjudication", "deviations", "claim_language_key"],
  "properties": {
    "schema_version": {"const": "acft-run-row@1"},
    "protocol_id": {"const": "acft-round-trip-measurement@1"},
    "evidence_kind": {"enum": ["synthetic_fixture", "live_run"]},
    "run_id": {"type": "string", "minLength": 8},
    "fixture_id": {"type": "string", "minLength": 4},
    "witness_class": {"type": "string"},
    "condition": {"enum": ["baseline", "acft"]},
    "status": {"enum": ["completed", "blocked", "protocol_deviation"]},
    "frozen": {"type": "object"},
    "execution": {"type": "object"},
    "controls": {"type": "object"},
    "outcomes": {"type": "object"},
    "adjudication": {"type": "object"},
    "deviations": {"type": "array"},
    "claim_language_key": {"enum": ["synthetic_fixture_no_human_or_product_claim", "live_run_requires_owner_adjudication"]}
  }
}
