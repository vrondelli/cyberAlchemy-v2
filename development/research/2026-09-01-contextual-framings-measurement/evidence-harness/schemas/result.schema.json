{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acft-dry-run-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "evidence_kind", "validation_status", "rows", "pairs", "witness_classes", "p1a_boundary_errors", "p1b_analogy_harm", "p2_components", "secondary", "effect_verdict", "claim_status", "allowed_result_language", "blockers"],
  "properties": {
    "schema_version": {"const": "acft-dry-run-result@1"},
    "protocol_id": {"const": "acft-round-trip-measurement@1"},
    "evidence_kind": {"enum": ["synthetic_fixture", "live_run"]},
    "validation_status": {"const": "pass"},
    "rows": {"type": "integer", "minimum": 1},
    "pairs": {"type": "integer", "minimum": 1},
    "witness_classes": {"type": "array"},
    "p1a_boundary_errors": {"type": "object"},
    "p1b_analogy_harm": {"type": "object"},
    "p2_components": {"type": "object"},
    "secondary": {"type": "object"},
    "effect_verdict": {"enum": ["not_evaluable", "requires_owner_adjudication"]},
    "claim_status": {"enum": ["synthetic_fixture_no_human_or_product_claim", "live_run_requires_owner_adjudication"]},
    "allowed_result_language": {"type": "string", "minLength": 1},
    "blockers": {"type": "array"}
  }
}
