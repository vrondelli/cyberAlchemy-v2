{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acft-arm-manifest@1",
  "title": "ACFT paired-arm fixture manifest",
  "description": "Structural index; validate_harness.py owns cross-field, digest, parity, and leakage invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "manifest_id", "evidence_kind", "authority_effect", "source_ref", "fixtures"],
  "properties": {
    "schema_version": {"const": "acft-arm-manifest@1"},
    "protocol_id": {"const": "acft-round-trip-measurement@1"},
    "manifest_id": {"type": "string", "minLength": 8},
    "evidence_kind": {"enum": ["synthetic_fixture", "live_run"]},
    "authority_effect": {"const": "none"},
    "source_ref": {"type": "object"},
    "fixtures": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "witness_class", "task_prompt", "task_digest", "evidence_atoms", "evidence_atom_digest", "expected_structural_outcome", "baseline", "acft", "prohibited_learner_markers", "mutation_recipe"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 4},
          "witness_class": {"type": "string"},
          "task_prompt": {"type": "string", "minLength": 1},
          "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_atoms": {"type": "array", "minItems": 1},
          "evidence_atom_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_structural_outcome": {"enum": ["scoreable", "validator_rejects_mutant"]},
          "baseline": {"type": "object"},
          "acft": {"type": "object"},
          "prohibited_learner_markers": {"type": "array", "minItems": 1},
          "mutation_recipe": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
