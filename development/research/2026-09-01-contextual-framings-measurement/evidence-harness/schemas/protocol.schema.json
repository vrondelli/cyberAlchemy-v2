{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acft-evidence-protocol@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "status", "authority_effect", "intervention", "source_ref", "evidence_kinds", "required_witness_classes", "primary_hierarchy", "decision_policy", "scoring_order", "claim_language", "dry_run_live_separation", "open_questions_ref"],
  "properties": {
    "schema_version": {"const": "acft-evidence-protocol@1"},
    "protocol_id": {"const": "acft-round-trip-measurement@1"},
    "status": {"const": "candidate_dry_run"},
    "authority_effect": {"const": "none"},
    "intervention": {"type": "object"},
    "source_ref": {"$ref": "#/$defs/exact_ref"},
    "evidence_kinds": {"const": ["synthetic_fixture", "live_run"]},
    "required_witness_classes": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true},
    "primary_hierarchy": {"type": "array", "minItems": 4, "maxItems": 4},
    "decision_policy": {"type": "object"},
    "scoring_order": {"const": ["safety", "correctness", "process_cost", "self_report"]},
    "claim_language": {"type": "object"},
    "dry_run_live_separation": {"type": "object"},
    "open_questions_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "exact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
