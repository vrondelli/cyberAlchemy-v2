{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.micro-swarm-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "objective", "deadline_ms", "tasks"],
  "properties": {
    "schema_version": {"const": "cav2.micro-swarm-manifest.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "strategy_result_id", "claim_id", "lane", "question", "attack", "allowed_sources", "max_output_tokens", "timeout_ms", "mandatory"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^MAP-[0-9]{3,}$"},
          "strategy_result_id": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "lane": {"enum": ["internal", "runtime", "external", "adversarial"]},
          "question": {"type": "string", "minLength": 1},
          "attack": {"enum": ["support", "counterevidence", "recompute", "precedent", "gap"]},
          "allowed_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_ref", "selector"],
              "properties": {
                "source_ref": {"type": "string", "minLength": 1},
                "selector": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          },
          "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
          "mandatory": {"type": "boolean"}
        }
      }
    }
  }
}

