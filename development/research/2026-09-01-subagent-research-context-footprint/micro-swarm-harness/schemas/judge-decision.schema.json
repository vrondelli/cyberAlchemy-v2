{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.micro-swarm-judge-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "judge_role", "introduces_new_claims", "decisions", "elapsed_ms"],
  "properties": {
    "schema_version": {"const": "cav2.micro-swarm-judge-decision.v1"},
    "experiment_id": {"type": "string"},
    "judge_role": {"const": "judge-only"},
    "introduces_new_claims": {"const": false},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "verdict", "accepted_task_ids", "reason"],
        "properties": {
          "claim_id": {"type": "string"},
          "verdict": {"enum": ["ACCEPT", "REJECT", "REVISE", "NOT_EVALUABLE"]},
          "accepted_task_ids": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "elapsed_ms": {"type": "number", "minimum": 0}
  }
}

