{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.micro-swarm-claim-card.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "strategy_result_id", "claim_id", "statement", "evidence", "proof_status", "disposition", "confidence", "conflicts", "non_claims", "elapsed_ms"],
  "properties": {
    "schema_version": {"const": "cav2.micro-swarm-claim-card.v1"},
    "task_id": {"type": "string"},
    "strategy_result_id": {"type": "string"},
    "claim_id": {"type": "string"},
    "statement": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "selector"],
        "properties": {
          "source_ref": {"type": "string"},
          "selector": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "proof_status": {"enum": ["observed", "executed", "derived", "unverified", "failed"]},
    "disposition": {"enum": ["support", "contradict", "defer", "kill", "failed", "timed_out"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}},
    "elapsed_ms": {"type": "number", "minimum": 0}
  }
}

