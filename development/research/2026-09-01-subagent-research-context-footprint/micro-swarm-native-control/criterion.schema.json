{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/micro-swarm-native-control-criterion.v1.json",
  "type": "object",
  "required": [
    "schema_version", "criterion_id", "hypothesis", "non_goals", "arms",
    "measurements", "mechanical_verdict_rule", "reproducibility",
    "bound_artifacts", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cav2.micro-swarm-native-control-criterion.v1"},
    "criterion_id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "arms": {
      "type": "object",
      "required": ["luna_swarm", "sol_reference"],
      "properties": {
        "luna_swarm": {"$ref": "#/$defs/arm"},
        "sol_reference": {"$ref": "#/$defs/arm"}
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "required": ["deadline_ms", "quality_score", "parity_tolerance_points", "coverage_required"],
      "properties": {
        "deadline_ms": {"const": 300000},
        "quality_score": {"type": "string", "minLength": 1},
        "parity_tolerance_points": {"type": "number", "minimum": 0, "maximum": 100},
        "coverage_required": {"const": 1}
      },
      "additionalProperties": false
    },
    "mechanical_verdict_rule": {
      "type": "object",
      "required": ["precedence", "INVALID", "FALSIFIED", "SURVIVED"],
      "properties": {
        "precedence": {"const": ["INVALID", "FALSIFIED", "SURVIVED"]},
        "INVALID": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "FALSIFIED": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "SURVIVED": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "reproducibility": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bound_artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/exact_ref"}
    },
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "arm": {
      "type": "object",
      "required": ["model", "task_ids", "isolation", "output_shape"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "task_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "isolation": {"type": "string", "minLength": 1},
        "output_shape": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "exact_ref": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}

