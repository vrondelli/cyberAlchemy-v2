{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blinded judge output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "candidate_1", "candidate_2", "winner", "critical_misses", "shared_misses", "confidence"],
  "properties": {
    "schema_version": {"const": "cav2.blinded-judge-output.v1"},
    "role_id": {"type": "string"},
    "candidate_1": {"$ref": "#/$defs/candidate"},
    "candidate_2": {"$ref": "#/$defs/candidate"},
    "winner": {"enum": ["candidate_1", "candidate_2", "tie"]},
    "critical_misses": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 160}},
    "shared_misses": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 160}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_scores", "penalties", "total", "strengths", "misses", "invented_claims"],
      "properties": {
        "dimension_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_coverage", "conclusion_and_decision_fidelity", "evidence_and_proof_status_fidelity", "nonclaim_and_authority_preservation", "clarity_and_internal_consistency"],
          "properties": {
            "claim_coverage": {"type": "number", "minimum": 0, "maximum": 35},
            "conclusion_and_decision_fidelity": {"type": "number", "minimum": 0, "maximum": 25},
            "evidence_and_proof_status_fidelity": {"type": "number", "minimum": 0, "maximum": 20},
            "nonclaim_and_authority_preservation": {"type": "number", "minimum": 0, "maximum": 15},
            "clarity_and_internal_consistency": {"type": "number", "minimum": 0, "maximum": 5}
          }
        },
        "penalties": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 160}},
        "total": {"type": "number", "minimum": 0, "maximum": 100},
        "strengths": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 160}},
        "misses": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 160}},
        "invented_claims": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 160}}
      }
    }
  }
}
