{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset synthesizer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "claims", "conclusions", "decisions", "conflicts", "non_claims", "open_questions"],
  "properties": {
    "schema_version": {"const": "cav2.dataset-synthesizer-output.v1"},
    "role_id": {"type": "string"},
    "claims": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "proof_status", "evidence_anchors", "source_claim_ids"],
        "properties": {
          "claim_id": {"type": "string", "maxLength": 48},
          "statement": {"type": "string", "maxLength": 320},
          "proof_status": {"enum": ["observed", "derived", "reported", "candidate", "blocked", "mixed", "unknown"]},
          "evidence_anchors": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 180}},
          "source_claim_ids": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 48}}
        }
      }
    },
    "conclusions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/supported_statement"}},
    "decisions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/supported_statement"}},
    "conflicts": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 240}},
    "non_claims": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 220}},
    "open_questions": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 220}}
  },
  "$defs": {
    "supported_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "supporting_claim_ids"],
      "properties": {
        "statement": {"type": "string", "maxLength": 300},
        "supporting_claim_ids": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 48}}
      }
    }
  }
}
