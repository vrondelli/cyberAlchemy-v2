{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Angle reducer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "claims", "decisions", "conflicts", "non_claims", "schema_deviations"],
  "properties": {
    "schema_version": {"const": "cav2.angle-reducer-output.v1"},
    "role_id": {"type": "string"},
    "claims": {
      "type": "array",
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "proof_status", "evidence_anchors", "source_record_ids"],
        "properties": {
          "claim_id": {"type": "string", "maxLength": 48},
          "statement": {"type": "string", "maxLength": 280},
          "proof_status": {"enum": ["observed", "derived", "reported", "candidate", "blocked", "mixed", "unknown"]},
          "evidence_anchors": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 180}},
          "source_record_ids": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 48}}
        }
      }
    },
    "decisions": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 240}},
    "conflicts": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 240}},
    "non_claims": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 200}},
    "schema_deviations": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 200}}
  }
}
