{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Micro extractor output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_id", "records", "conflicts", "non_claims"],
  "properties": {
    "schema_version": {"const": "cav2.micro-extractor-output.v1"},
    "role_id": {"type": "string"},
    "records": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "statement", "evidence_anchor", "proof_status", "exact_values"],
        "properties": {
          "record_id": {"type": "string", "maxLength": 48},
          "statement": {"type": "string", "maxLength": 240},
          "evidence_anchor": {"type": "string", "maxLength": 180},
          "proof_status": {"enum": ["observed", "derived", "reported", "candidate", "blocked", "unknown"]},
          "exact_values": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 100}}
        }
      }
    },
    "conflicts": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 200}},
    "non_claims": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 200}}
  }
}
