domain exchange-purchase "CyberAlchemy Exchange Purchase"
owner exchange-product-owner
logic sfol-v1

entity Offer:
  offerOfferId: identifier required
  offerSeller: string required
  offerArtifactVersion: string required
  offerTermsCommitment: string required

entity PurchaseOrder:
  purchaseOrderOrderId: identifier required
  purchaseOrderBuyer: string required
  purchaseOrderSeller: string required
  purchaseOrderArtifact: string required
  purchaseOrderAmount: integer required
  purchaseOrderDeadline: integer required
  purchaseOrderStatus: string required
  purchaseOrderTermsCommitment: string required

entity Escrow:
  escrowOrderId: identifier required
  escrowMint: string required
  escrowVault: string required
  escrowAmount: integer required

entity PreparedDelivery:
  preparedDeliveryOrderId: identifier required
  preparedDeliveryKeyCommitment: string required
  preparedDeliveryEnvelopeCommitment: string required
  preparedDeliveryExpectedRevision: integer required
  preparedDeliveryReleaseAuthority: string required

entity PurchaseReceipt:
  purchaseReceiptOrderId: identifier required
  purchaseReceiptTransaction: string required
  purchaseReceiptSlot: integer required
  purchaseReceiptStatus: string required

entity DeliveryReceipt:
  deliveryReceiptOrderId: identifier required
  deliveryReceiptCiphertextCommitment: string required
  deliveryReceiptAttempt: string required
  deliveryReceiptAcknowledged: boolean required
