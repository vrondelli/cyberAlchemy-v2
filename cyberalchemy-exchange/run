#!/usr/bin/env python3
"""Run the Exchange candidate through repository-owned toolchains."""
import os
import json
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent
repo = root.parent
cap = root / 'capabilities/project-purchase/v1'
kep = root / 'knowledge-exchange-protocol'
hosted = kep / 'capabilities/hosted-devnet-exchange/v1/implementation'
launcher = repo / 'tools/toolchain/run'
target = cap / 'program/target'
tsx = repo / 'language/capabilities/alchlang/plans/general-compiler-v1/implementation/node_modules/.bin/tsx'

def run(args, cwd=repo):
    subprocess.run([str(a) for a in args], cwd=cwd, check=True)

def cargo(*args):
    command = [launcher, 'cargo', *args, '--manifest-path', cap / 'program/Cargo.toml']
    if args[0] != 'fetch':
        command += ['--target-dir', target]
    run(command)

def native_tests():
    args = [launcher, 'cargo', 'rustc', '--locked', '--jobs', '2', '--manifest-path',
            cap / 'program/Cargo.toml', '--target-dir', target, '--features', 'local-test-mint',
            '--test', 'settlement', '--message-format=json', '--', '-C', 'link-arg=-Wl,--strip-debug']
    built = subprocess.run([str(a) for a in args], cwd=repo, capture_output=True, text=True)
    print(built.stderr, end='', file=sys.stderr)
    if built.returncode:
        print(built.stdout, end='', file=sys.stderr)
    built.check_returncode()
    executables = [item['executable'] for line in built.stdout.splitlines()
                   if (item := json.loads(line)).get('executable')
                   and item.get('target', {}).get('name') == 'settlement']
    if len(executables) != 1:
        raise RuntimeError('Expected exactly one settlement test executable')
    run([executables[0]])

def build_ui():
    run([hosted / 'node_modules/.bin/esbuild', cap / 'ui/app-entry.mjs', '--bundle', '--minify', '--format=iife', '--outfile=' + str(cap / 'ui/app.js')])

command = sys.argv[1] if len(sys.argv) == 2 else 'help'
try:
    if command == 'bootstrap':
        for folder in [cap, hosted]:
            run(['npm', 'ci', '--ignore-scripts', '--no-audit', '--no-fund'], folder)
        cargo('fetch', '--locked')
    elif command == 'build':
        cargo('build', '--locked', '--features', 'local-test-mint', '--example', 'local_bank')
        build_ui()
        run([tsx, cap / 'build.ts'])
    elif command in ('prepare-devnet', 'preflight-devnet'):
        run(['node', cap / 'client/deployment.mjs', 'prepare' if command == 'prepare-devnet' else 'preflight'])
    elif command in ('build-sbf', 'check-sbf', 'build-deployment', 'check-deployment'):
        run([launcher, 'python3', cap / 'sbf.py', command])
    elif command == 'envelope-devnet':
        run(['node', cap / 'client/envelope.mjs'])
    elif command == 'check':
        run([tsx, cap / 'build.ts', '--check'])
        native_tests()
        run(['node', '--test', cap / 'client/crypto.test.mjs', cap / 'client/deployment.test.mjs'])
    elif command == 'demo':
        cargo('build', '--locked', '--features', 'local-test-mint', '--example', 'local_bank')
        run(['node', cap / 'client/demo.mjs'])
    elif command == 'serve-devnet':
        profile = json.loads((cap / 'deployment/public.json').read_text())
        if profile['network'] != 'solana-devnet' or profile['rpc'] != 'https://api.devnet.solana.com':
            raise RuntimeError('Invalid Devnet server profile')
        keys = Path(os.environ.get('EXCHANGE_DEPLOYMENT_KEY_DIR', str(Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share'))) / 'cyberalchemy/exchange/devnet-purchase-v1')))
        env = dict(os.environ, EXCHANGE_KEP_PROGRAM_ID=profile['keys']['kepProgram'],
                   EXCHANGE_PURCHASE_PROGRAM_ID=profile['keys']['purchaseProgram'],
                   EXCHANGE_RELEASE_KEY_FILE=str(keys / 'releaseAuthority.json'),
                   EXCHANGE_RPC_URL=profile['rpc'])
        subprocess.run(['node', str(cap / 'client/serve.mjs')], cwd=repo, env=env, check=True)
    elif command == 'serve':
        run(['node', cap / 'client/serve.mjs'])
    else:
        print('Usage: cyberalchemy-exchange/run bootstrap|build|check|build-sbf|check-sbf|prepare-devnet|build-deployment|check-deployment|preflight-devnet|envelope-devnet|serve-devnet|demo|serve')
        print('demo requires EXCHANGE_DATABASE_URL; browser checks use EXCHANGE_BROWSER_TEST=1.')
        sys.exit(2)
except subprocess.CalledProcessError as error:
    sys.exit(error.returncode)
