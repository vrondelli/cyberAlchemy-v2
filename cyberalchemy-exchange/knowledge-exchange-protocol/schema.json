{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-knowledge-exchange-product.schema/v2",
  "$defs": {
    "id": {"type":"string","minLength":1,"pattern":"^[A-Z0-9][A-Z0-9._:-]*$"},
    "text": {"type":"string","minLength":1},
    "source": {
      "type":"object","additionalProperties":false,
      "required":["id","path","digest_scope","selector","sha256","posture","owner_route"],
      "properties":{"id":{"type":"string","pattern":"^SRC-KEP-"},"path":{"$ref":"#/$defs/text"},"digest_scope":{"enum":["whole-file","markdown-heading"]},"selector":{"type":["string","null"]},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"posture":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}},
      "allOf":[{"if":{"properties":{"digest_scope":{"const":"whole-file"}}},"then":{"properties":{"selector":{"const":null}}}},{"if":{"properties":{"digest_scope":{"const":"markdown-heading"}}},"then":{"properties":{"selector":{"type":"string","pattern":"^## "}}}}]
    },
    "sourceRegistry": {
      "type":"object","additionalProperties":false,"required":["schema_version","sources"],
      "properties":{"schema_version":{"const":"cav2-knowledge-exchange-product-sources/v1"},"sources":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/source"}}}
    },
    "identityDecision": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","decision_id","decided_at","source","product_id","parent_product_id","relationship","thesis_id","project_id","goal_id","capability_id","product_root","owner_route","visibility","commitment_effect","blocked_effects","authority_effect"],
      "properties":{
        "schema_version":{"const":"cav2-knowledge-exchange-product-identity-decision/v1"},"decision_id":{"const":"CA2-DECISION-KNOWLEDGE-EXCHANGE-PRODUCT-IDENTITY-001"},"decided_at":{"type":"string","format":"date"},
        "source":{"type":"object","additionalProperties":false,"required":["kind","user_decisions"],"properties":{"kind":{"const":"current-chat"},"user_decisions":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/text"}}}},
        "product_id":{"const":"CA2-PRODUCT-KNOWLEDGE-EXCHANGE-PROTOCOL"},"parent_product_id":{"const":"CA2-PRODUCT-CYBERALCHEMY"},"relationship":{"const":"subproduct_of"},"thesis_id":{"const":"CA2-PRODUCT-THESIS-KNOWLEDGE-EXCHANGE-PROTOCOL"},"project_id":{"const":"CA2-PROJECT-KNOWLEDGE-EXCHANGE-SOLANA-PROOF"},"goal_id":{"const":"CA2-GOAL-KNOWLEDGE-EXCHANGE-ENCRYPTED-COOWNERSHIP"},"capability_id":{"const":"CA2-CAP-GRANT-ENCRYPTED-KNOWLEDGE-COOWNERSHIP"},"product_root":{"const":"cyberAlchemy-v2/product/knowledge-exchange-protocol"},"owner_route":{"$ref":"#/$defs/text"},"visibility":{"const":"private"},"commitment_effect":{"$ref":"#/$defs/text"},"blocked_effects":{"type":"array","minItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"authority_effect":{"const":"none"}
      }
    },
    "selection": {
      "type":"object","additionalProperties":false,"required":["selection_id","source_ref","selector"],
      "properties":{"selection_id":{"type":"string","pattern":"^CAP-SEL-KEP-"},"source_ref":{"$ref":"#/$defs/text"},"selector":{"$ref":"#/$defs/text"}}
    },
    "node": {
      "type":"object","additionalProperties":false,"required":["id","label","role","meaning"],
      "properties":{"id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/text"},"role":{"enum":["product","project","goal","product_capability","actor","identity","artifact","artifact_version","ciphertext","secret","key_binding","membership","grant","policy","key_envelope","request","operation","evidence","epoch","storage_reference","outcome","contract","context_policy","obligation_registry"]},"meaning":{"$ref":"#/$defs/text"}}
    },
    "relation": {
      "type":"object","additionalProperties":false,"required":["id","type","source","target","meaning"],
      "properties":{"id":{"type":"string","pattern":"^KEP-REL-"},"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"meaning":{"$ref":"#/$defs/text"}}
    },
    "rule": {
      "type":"object","additionalProperties":false,"required":["rule_id","statement","failure_behavior"],
      "properties":{"rule_id":{"type":"string","pattern":"^KEP-RULE-"},"statement":{"$ref":"#/$defs/text"},"failure_behavior":{"$ref":"#/$defs/text"}}
    },
    "proof": {
      "type":"object","additionalProperties":false,"required":["proof_id","statement","evidence_state"],
      "properties":{"proof_id":{"type":"string","pattern":"^KEP-PROOF-"},"statement":{"$ref":"#/$defs/text"},"evidence_state":{"const":"not_evaluable"}}
    },
    "residue": {
      "type":"object","additionalProperties":false,"required":["residue_id","status","description","next_owner"],
      "properties":{"residue_id":{"type":"string","pattern":"^CAP-RES-KEP-"},"status":{"enum":["open","blocked","deferred"]},"description":{"$ref":"#/$defs/text"},"next_owner":{"$ref":"#/$defs/text"},"binding_ref":{"type":"string","pattern":"^CA2-CAP-BIND-"}}
    },
    "definitionSource": {
      "type":"object","additionalProperties":false,"required":["path","sha256","definition_ids"],
      "properties":{"path":{"const":"cyberAlchemy-v2/product/knowledge-exchange-protocol/authority/definitions/DEFINITIONS.md"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"definition_ids":{"const":["KEP-D1","KEP-D2","KEP-D3","KEP-D4","KEP-D5","KEP-D6","KEP-D7","KEP-D8","KEP-D9","KEP-D10","KEP-D11","KEP-D12"]}}
    },
    "definitionBinding": {
      "type":"object","additionalProperties":false,"required":["definition_id","ontology_refs"],
      "properties":{"definition_id":{"type":"string","pattern":"^KEP-D([1-9]|1[0-2])$"},"ontology_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}
    },
    "businessOntology": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","ontology_id","ontology_type","branch","product_ref","capability_ref","lifecycle_status","authority_effect","enforcement_effect","definition_source","definition_bindings","construction_state","source_selections","nodes","relations","rules","proof_requirements","residue"],
      "properties":{
        "schema_version":{"const":"cav2-knowledge-exchange-business-ontology/v2"},"ontology_id":{"const":"CA2-ONTOLOGY-KNOWLEDGE-EXCHANGE-BUSINESS"},"ontology_type":{"const":"business-domain"},"branch":{"const":"business"},"product_ref":{"const":"CA2-PRODUCT-KNOWLEDGE-EXCHANGE-PROTOCOL"},"capability_ref":{"const":"CA2-CAP-GRANT-ENCRYPTED-KNOWLEDGE-COOWNERSHIP"},"lifecycle_status":{"const":"admitted"},"authority_effect":{"const":"none"},"enforcement_effect":{"const":"none"},"definition_source":{"$ref":"#/$defs/definitionSource"},"definition_bindings":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/$defs/definitionBinding"}},
        "construction_state":{"type":"object","additionalProperties":false,"required":["canonical_definitions","product_capability","business_ontology","domainspec_v2_source","compiled_graph_and_system_ontology","implementation_binding","conformance_evidence"],"properties":{"canonical_definitions":{"const":"current"},"product_capability":{"const":"adopted"},"business_ontology":{"const":"admitted"},"domainspec_v2_source":{"const":"blocked"},"compiled_graph_and_system_ontology":{"const":"not_evaluable"},"implementation_binding":{"const":"not_evaluable"},"conformance_evidence":{"const":"not_evaluable"}}},
        "source_selections":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/selection"}},"nodes":{"type":"array","minItems":29,"items":{"$ref":"#/$defs/node"}},"relations":{"type":"array","minItems":17,"items":{"$ref":"#/$defs/relation"}},"rules":{"type":"array","minItems":10,"items":{"$ref":"#/$defs/rule"}},"proof_requirements":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/proof"}},"residue":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/residue"}}
      }
    }
  }
}
