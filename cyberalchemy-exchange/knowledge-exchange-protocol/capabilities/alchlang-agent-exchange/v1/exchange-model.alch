domain alchlang-agent-exchange "Local alchLang Agent Exchange"
owner kep-product-owner
logic sfol-v1

entity ExchangeEnvelope:
  correlationId: identifier required
  sender: string required
  recipient: string required
  languageVersion: string required
  payloadDigest: string required

entity CompilationReceipt:
  receiptId: identifier required
  envelopeDigest: string required
  planDigest: string required
  bundleDigest: string required
  outcome: string required

entity DeliveryReplay:
  deliveryId: identifier required
  receiptDigest: string required
  protocolRevision: integer required

entity CompiledBundle:
  bundleId: identifier required
  filesJson: string required
