{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-kep-durable-storage-business-ontology.schema.json",
  "title": "Durable Storage Business Ontology Package",
  "type": "object",
  "description": "Package-local structural contract; semantic closure is enforced by validate.py.",
  "$defs": {
    "id": {"type":"string","minLength":1},
    "text": {"type":"string","minLength":1},
    "effect": {"const":"none"},
    "recordArray": {"type":"array","minItems":1,"items":{"type":"object"}},
    "packageEnvelope": {
      "type":"object",
      "required":["schema_version","authority_effect"],
      "properties":{"schema_version":{"$ref":"#/$defs/id"},"authority_effect":{"$ref":"#/$defs/effect"}},
      "additionalProperties":true
    }
  }
}
