{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kep-error-registry.schema.json",
  "type": "object",
  "required": ["registry_version", "entries"],
  "properties": {
    "registry_version": {"type":"string"},
    "entries": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["canonical_code","source_layer","effect_status","retry_disposition","title","safe_message","guidance"],
        "properties": {
          "canonical_code":{"type":"string"},
          "source_layer":{"type":"string"},
          "custom_program_code":{"type":"integer","minimum":1},
          "effect_status":{"type":"string"},
          "retry_disposition":{"type":"string"},
          "title":{"type":"string"},
          "safe_message":{"type":"string"},
          "guidance":{"type":"string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
