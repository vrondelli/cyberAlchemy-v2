{
  "name": "cyberalchemy-kep-hosted-devnet-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "bin": {"kep": "cli/kep.mjs"},
  "exports": {"./client": "./cli/client.mjs"},
  "files": [
    "cli/client.mjs",
    "cli/kep.mjs",
    "cli/provider.mjs",
    "cli/storage.mjs",
    "ui-src/account-client.js",
    "ui-src/console-session.js",
    "ui-src/errors.js",
    "ui-src/file-client.js",
    "ui-src/protocol.js",
    "error-registry/v1.json",
    "CLI-API.md"
  ],
  "scripts": {
    "test": "npm run check:ui && npm run check:bundle && npm run check:paper",
    "build:ui": "esbuild ui-src/app.js --bundle --minify --format=iife --global-name=KepExchange --outfile=static/assets/app.js",
    "check:ui": "node --test cli/client.test.mjs tests/package-boundary.test.mjs ui-src/cli-provider.test.js ui-src/agent-instructions.test.js ui-src/app.test.js ui-src/file-client.test.js ui-src/console-session.test.js ui-src/account-client.test.js ui-src/success-notice.test.js ui-src/file-drop.test.js ui-src/download-original.test.js",
    "check:bundle": "node ui-src/check-bundle.js",
    "build:files": "esbuild ui-src/file-console.js --bundle --minify --format=iife --outfile=static/assets/files.js",
    "build:console": "esbuild ui-src/console-experience.js --bundle --minify --format=iife --outfile=static/assets/console-experience.js",
    "build:paper": "python3 ui-src/build-paper.py",
    "check:paper": "python3 ui-src/build-paper.py --check"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@noble/ciphers": "2.4.0",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
