{
  "schema_version": "cav2-compiled-system-prototype/v1",
  "prototype_id": "KEP-HOST-IDENTITY-SESSION-PREFLIGHT-SYSTEM-PROTOTYPE-001",
  "status": "non-authoritative-construction-prototype",
  "source": "../identity-session-preflight-prototype.json",
  "components": [
    {
      "component_id": "isolated-client-session-store",
      "responsibility": "retain multiple exact same-tab KEP sessions without cross-role state inheritance"
    },
    {
      "component_id": "public-preflight-card-projector",
      "responsibility": "project canonical public-only identity session and operation inputs before signing"
    },
    {
      "component_id": "frozen-operation-ledger",
      "responsibility": "retain one semantic operation identifier and stage through reconciliation"
    },
    {
      "component_id": "identity-registration-classifier",
      "responsibility": "separate new registration exact resume operation replay and binding conflict"
    },
    {
      "component_id": "safe-attempt-projector",
      "responsibility": "return bounded redacted evidence for one high-entropy attempt identifier"
    }
  ],
  "interfaces": [
    "POST /v1/identities",
    "POST /v1/client-errors",
    "GET /v1/client-errors/{attempt_id}",
    "ca2-kep-public-preflight/v1",
    "ca2-kep-public-identity/v1",
    "ca2-kep-public-artifact/v1",
    "ca2-kep-public-reissue/v1"
  ],
  "state_transitions": [
    "fresh -> session-bound",
    "draft-operation -> frozen -> prepared -> submitted -> finalized -> reconciled",
    "unregistered-identity -> registered",
    "registered-exact-binding -> exact-resume-without-binding-change",
    "registered-different-binding -> typed-conflict",
    "client-failure -> redacted-attempt-evidence"
  ],
  "forbidden_transitions": [
    "fresh-session -> inherited-role-or-identity",
    "shared-wallet -> collapsed-knowledge-identity",
    "binding-conflict -> identity-overwrite",
    "unknown-effect -> automatic-successor-operation",
    "safe-attempt-projection -> diagnostic-or-secret-disclosure"
  ],
  "authority_effect": "none"
}
