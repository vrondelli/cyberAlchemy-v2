{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-kep-solana-business-ontology.schema/v1",
  "$defs": {
    "id": {"type":"string","minLength":1,"pattern":"^[A-Z0-9][A-Z0-9._:-]*$"},
    "text": {"type":"string","minLength":1},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "confidence": {
      "type":"object","additionalProperties":false,
      "required":["evidence","commitment"],
      "properties":{"evidence":{"const":"source-bound-high"},"commitment":{"const":"candidate-not-admitted"}}
    },
    "ontologyTypeSelection": {
      "type":"object","additionalProperties":false,
      "required":["source","confidence","reason"],
      "properties":{"source":{"const":"inferred"},"confidence":{"const":"high"},"reason":{"$ref":"#/$defs/text"}}
    },
    "constructionState": {
      "type":"object","additionalProperties":false,
      "required":["canonical_definitions","product_capability","business_ontology","domainspec_v2_source","compiled_graph_and_system_ontology","implementation_binding","conformance_evidence","runtime_evidence"],
      "properties":{
        "canonical_definitions":{"const":"accepted"},
        "product_capability":{"const":"adopted"},
        "business_ontology":{"const":"authored-candidate-awaiting-owner-admission"},
        "domainspec_v2_source":{"const":"not_evaluable"},
        "compiled_graph_and_system_ontology":{"const":"not_evaluable"},
        "implementation_binding":{"const":"not_evaluable"},
        "conformance_evidence":{"const":"not_evaluable"},
        "runtime_evidence":{"const":"not_evaluable"}
      }
    },
    "profile": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","ontology_id","title","ontology_type","ontology_type_selection","branch","materialization","package_root","package_owner","visibility","lifecycle_status","product_ref","capability_ref","source_registry","definition_binding_registry","node_registry","relation_registry","rule_registry","premise_registry","proof_registry","residue_registry","receipt_registry","schema_path","validator_path","construction_state","authority_effect","enforcement_effect","external_effect"],
      "properties":{
        "schema_ref":{"const":"schema.json#/$defs/profile"},
        "schema_version":{"const":"cav2-kep-solana-business-ontology-profile/v1"},
        "ontology_id":{"const":"CA2-ONTOLOGY-KEP-SOLANA-COOWNERSHIP"},
        "title":{"$ref":"#/$defs/text"},
        "ontology_type":{"const":"business-domain"},
        "ontology_type_selection":{"$ref":"#/$defs/ontologyTypeSelection"},
        "branch":{"const":"business"},
        "materialization":{"const":"package-required"},
        "package_root":{"const":"cyberAlchemy-v2/product/knowledge-exchange-protocol/capabilities/solana-coownership/ontology"},
        "package_owner":{"const":"Knowledge Exchange Protocol product owner"},
        "visibility":{"const":"private"},
        "lifecycle_status":{"const":"authored-candidate"},
        "product_ref":{"const":"CA2-PRODUCT-KNOWLEDGE-EXCHANGE-PROTOCOL"},
        "capability_ref":{"const":"CA2-CAP-REALIZE-NO-PRICE-SOLANA-COOWNERSHIP"},
        "source_registry":{"const":"sources.json"},
        "definition_binding_registry":{"const":"definition-bindings.json"},
        "node_registry":{"const":"nodes.json"},
        "relation_registry":{"const":"relations.json"},
        "rule_registry":{"const":"rules.json"},
        "premise_registry":{"const":"premises.json"},
        "proof_registry":{"const":"proof-requirements.json"},
        "residue_registry":{"const":"residue.json"},
        "receipt_registry":{"const":"receipts/index.json"},
        "schema_path":{"const":"schema.json"},
        "validator_path":{"const":"validate.py"},
        "construction_state":{"$ref":"#/$defs/constructionState"},
        "authority_effect":{"const":"none"},
        "enforcement_effect":{"const":"none"},
        "external_effect":{"const":"none"}
      }
    },
    "source": {
      "type":"object","additionalProperties":false,
      "required":["source_id","path","sha256","posture","owner"],
      "properties":{"source_id":{"type":"string","pattern":"^SRC-KEP-"},"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha256"},"posture":{"$ref":"#/$defs/text"},"owner":{"$ref":"#/$defs/text"}}
    },
    "selection": {
      "type":"object","additionalProperties":false,
      "required":["selection_id","source_id","selector_kind","selector","selection_sha256"],
      "properties":{"selection_id":{"type":"string","pattern":"^KEP-SOL-SEL-"},"source_id":{"type":"string","pattern":"^SRC-KEP-"},"selector_kind":{"enum":["whole-file","markdown-heading"]},"selector":{"type":["string","null"]},"selection_sha256":{"$ref":"#/$defs/sha256"}},
      "allOf":[{"if":{"properties":{"selector_kind":{"const":"whole-file"}}},"then":{"properties":{"selector":{"const":null}}}},{"if":{"properties":{"selector_kind":{"const":"markdown-heading"}}},"then":{"properties":{"selector":{"type":"string","pattern":"^## KEP-SOL-D([1-9]|10):$"}}}}]
    },
    "sourceRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","sources","selections","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/sourceRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-sources/v1"},"sources":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/source"}},"selections":{"type":"array","minItems":16,"items":{"$ref":"#/$defs/selection"}},"authority_effect":{"const":"none"}}
    },
    "definitionBinding": {
      "type":"object","additionalProperties":false,
      "required":["definition_id","source_selection_ref","ontology_refs"],
      "properties":{"definition_id":{"type":"string","pattern":"^KEP-SOL-D([1-9]|10)$"},"source_selection_ref":{"type":"string","pattern":"^KEP-SOL-SEL-D([1-9]|10)$"},"ontology_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}
    },
    "definitionBindingRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","bindings","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/definitionBindingRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-definition-bindings/v1"},"bindings":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/definitionBinding"}},"authority_effect":{"const":"none"}}
    },
    "node": {
      "type":"object","additionalProperties":false,
      "required":["id","label","role","meaning","definition_refs","source_refs"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/text"},
        "role":{"enum":["product_capability","actor","identity","key_binding","artifact_version","state_aggregate","membership","commitment","instruction","policy","replay_domain","consumption_record","evidence","economic_boundary","infrastructure_cost","program_identity","environment","outcome","contract","context_policy","obligation_registry"]},
        "meaning":{"$ref":"#/$defs/text"},
        "definition_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-D([1-9]|10)$"}},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-SEL-"}}
      }
    },
    "nodeRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","confidence","nodes","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/nodeRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-nodes/v1"},"confidence":{"$ref":"#/$defs/confidence"},"nodes":{"type":"array","minItems":20,"items":{"$ref":"#/$defs/node"}},"authority_effect":{"const":"none"}}
    },
    "relation": {
      "type":"object","additionalProperties":false,
      "required":["id","type","source","target","meaning","source_refs"],
      "properties":{"id":{"type":"string","pattern":"^KEP-SOL-REL-"},"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"meaning":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-SEL-"}}}
    },
    "relationRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","confidence","relations","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/relationRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-relations/v1"},"confidence":{"$ref":"#/$defs/confidence"},"relations":{"type":"array","minItems":20,"items":{"$ref":"#/$defs/relation"}},"authority_effect":{"const":"none"}}
    },
    "rule": {
      "type":"object","additionalProperties":false,
      "required":["rule_id","statement","failure_behavior","definition_refs","source_refs"],
      "properties":{"rule_id":{"type":"string","pattern":"^KEP-SOL-RULE-"},"statement":{"$ref":"#/$defs/text"},"failure_behavior":{"$ref":"#/$defs/text"},"definition_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-D([1-9]|10)$"}},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-SEL-"}}}
    },
    "ruleRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","confidence","rules","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/ruleRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-rules/v1"},"confidence":{"$ref":"#/$defs/confidence"},"rules":{"type":"array","minItems":10,"items":{"$ref":"#/$defs/rule"}},"authority_effect":{"const":"none"}}
    },
    "premise": {
      "type":"object","additionalProperties":false,
      "required":["premise_id","statement","evidence_confidence","commitment_confidence","counterevidence","falsification_criteria","source_refs"],
      "properties":{"premise_id":{"type":"string","pattern":"^KEP-SOL-PREMISE-"},"statement":{"$ref":"#/$defs/text"},"evidence_confidence":{"const":"definition-supported"},"commitment_confidence":{"const":"working-candidate"},"counterevidence":{"$ref":"#/$defs/text"},"falsification_criteria":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-SEL-"}}}
    },
    "premiseRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","premises","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/premiseRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-premises/v1"},"premises":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/premise"}},"authority_effect":{"const":"none"}}
    },
    "proof": {
      "type":"object","additionalProperties":false,
      "required":["proof_id","statement","evidence_state","required_future_evidence","source_refs"],
      "properties":{"proof_id":{"type":"string","pattern":"^KEP-SOL-PROOF-"},"statement":{"$ref":"#/$defs/text"},"evidence_state":{"const":"not_evaluable"},"required_future_evidence":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-SEL-"}}}
    },
    "proofRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","proof_requirements","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/proofRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-proofs/v1"},"proof_requirements":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/proof"}},"authority_effect":{"const":"none"}}
    },
    "residue": {
      "type":"object","additionalProperties":false,
      "required":["residue_id","status","description","next_owner","next_action","source_refs"],
      "properties":{"residue_id":{"type":"string","pattern":"^KEP-SOL-RES-"},"status":{"enum":["open","blocked","deferred"]},"description":{"$ref":"#/$defs/text"},"next_owner":{"$ref":"#/$defs/text"},"next_action":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^KEP-SOL-SEL-"}}}
    },
    "residueRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","residue","authority_effect"],
      "properties":{"schema_ref":{"const":"schema.json#/$defs/residueRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-residue/v1"},"residue":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/residue"}},"authority_effect":{"const":"none"}}
    },
    "receipt": {
      "type":"object","additionalProperties":false,
      "required":["receipt_id","path","sha256","material_digest","status"],
      "properties":{"receipt_id":{"type":"string","pattern":"^KEP-SOL-ONTOLOGY-RECEIPT-"},"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha256"},"material_digest":{"$ref":"#/$defs/sha256"},"status":{"enum":["PASS","BLOCK"]}}
    },
    "receiptRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","append_only","receipts","authority_effect"],
      "properties":{"schema_ref":{"const":"../schema.json#/$defs/receiptRegistry"},"schema_version":{"const":"cav2-kep-solana-business-ontology-receipts/v1"},"append_only":{"const":true},"receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},"authority_effect":{"const":"none"}}
    }
  }
}
