{
  "schema_version": "cav2-kep-deployment-continuation-bounded-exploration-model/v1",
  "model_id": "CA2-KEP-DEPLOYMENT-CONTINUATION-013-BOUNDED-EXPLORATION-V1",
  "boundary": "Cartesian exploration of effect knowledge, expected revision posture, and journal continuity for candidate-013 safety obligations. It is an abstract finite model, not a Rust execution or Devnet observation.",
  "dimensions": {
    "effect_state": ["none", "known-in-flight", "unknown-in-flight", "finalized-success", "finalized-failure"],
    "revision_state": ["stale", "current", "future", "already-applied"],
    "journal_state": ["intact", "missing", "truncated", "hash-break", "duplicate", "reordered"]
  },
  "rules": {
    "submit_requires_effect_state": "none",
    "submit_requires_revision_state": "current",
    "submit_requires_journal_state": "intact",
    "unknown_effect_requires_reconciliation": true,
    "already_applied_requires_reconciliation_without_submit": true,
    "non_intact_journal_stops_restart": true
  },
  "obligations": [
    {
      "path_id": "PATH-013-002",
      "obligation_id": "bound-unknown-effect-state",
      "predicate": "Every unknown-in-flight state forbids submission and requires reconciliation."
    },
    {
      "path_id": "PATH-013-005",
      "obligation_id": "explore-stale-expected-future-revisions",
      "predicate": "Every stale or future revision state forbids submission."
    },
    {
      "path_id": "PATH-013-005",
      "obligation_id": "prove-already-applied-is-not-resubmitted",
      "predicate": "Every already-applied state forbids submission and requires reconciliation."
    },
    {
      "path_id": "PATH-013-014",
      "obligation_id": "explore-crash-points",
      "predicate": "Every non-intact journal state stops restart and forbids submission."
    },
    {
      "path_id": "PATH-013-014",
      "obligation_id": "prove-no-replay-after-restart",
      "predicate": "No corrupted-journal or already-applied restart state permits submission."
    }
  ],
  "authority_effect": "none"
}
