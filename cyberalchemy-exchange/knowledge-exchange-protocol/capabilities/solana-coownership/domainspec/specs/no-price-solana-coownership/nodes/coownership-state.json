{
  "schema_version": "domainspec.node/v1",
  "node_id": "coownership-state",
  "feature_id": "no-price-solana-coownership",
  "kind": "State Machine",
  "body": {
    "description": "Owner-set state for the first no-price Solana grant, with rejection represented as no protected-state transition.",
    "states": ["originator-only", "originator-and-recipient"],
    "initial": "originator-only",
    "transitions": ["no-price-grant-completed:originator-only->originator-and-recipient", "no-price-grant-rejected:originator-only->originator-only"]
  }
}
