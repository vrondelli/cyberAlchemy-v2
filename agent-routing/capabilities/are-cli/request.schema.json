{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.cli-request/v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "are.cli-request/v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request": {
      "type": "object",
      "properties": {
        "raw_request": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "objective_kind": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "requested_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 128
        },
        "target_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 128
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 128
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "maxItems": 128
        },
        "field_postures": {
          "type": "object",
          "properties": {
            "request_id": {
              "enum": [
                "explicit",
                "inferred",
                "unknown",
                "absent"
              ]
            },
            "raw_request": {
              "enum": [
                "explicit",
                "inferred",
                "unknown",
                "absent"
              ]
            },
            "objective_kind": {
              "enum": [
                "explicit",
                "inferred",
                "unknown",
                "absent"
              ]
            },
            "requested_effects": {
              "enum": [
                "explicit",
                "inferred",
                "unknown",
                "absent"
              ]
            },
            "target_refs": {
              "enum": [
                "explicit",
                "inferred",
                "unknown",
                "absent"
              ]
            },
            "constraints": {
              "enum": [
                "explicit",
                "inferred",
                "unknown",
                "absent"
              ]
            },
            "evidence_refs": {
              "enum": [
                "explicit",
                "inferred",
                "unknown",
                "absent"
              ]
            }
          },
          "required": [
            "request_id",
            "raw_request",
            "objective_kind",
            "requested_effects",
            "target_refs",
            "constraints",
            "evidence_refs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "raw_request"
      ],
      "additionalProperties": false
    },
    "previous_receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "are.cli-route-receipt/v1"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decision_profile_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "route_decision_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authority_effect": {
          "const": "none"
        },
        "receipt_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "request_id",
        "request_digest",
        "decision_profile_digest",
        "route_decision_digest",
        "authority_effect",
        "receipt_digest"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "item/commandExecution/requestApproval",
            "item/fileChange/requestApproval",
            "item/permissions/requestApproval"
          ]
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "proposal": {
          "type": "object"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "effect_classes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "maxItems": 128,
              "minItems": 1
            },
            "reversible": {
              "type": "boolean"
            },
            "owner_gate_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "structurally_admissible": {
              "type": "boolean"
            },
            "rejection_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "maxItems": 128
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "item_id",
        "proposal"
      ],
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "properties": {
        "completion": {
          "type": "object",
          "properties": {
            "completion_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "status": {
              "enum": [
                "completed",
                "failed",
                "cancelled",
                "pending"
              ]
            },
            "continuation_required": {
              "type": "boolean"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "maxItems": 128
            }
          },
          "required": [
            "completion_id",
            "status",
            "continuation_required",
            "evidence_refs"
          ],
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "route_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "effect_classes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "maxItems": 128,
                "minItems": 1
              },
              "reversible": {
                "type": "boolean"
              },
              "owner_gate_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "structurally_admissible": {
                "type": "boolean"
              },
              "rejection_reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "maxItems": 128
              }
            },
            "required": [
              "option_id",
              "route_id",
              "effect_classes",
              "reversible"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "completion",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "request_id",
    "request"
  ],
  "additionalProperties": false
}
