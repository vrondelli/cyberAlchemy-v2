{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "are.cli-result/v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ok",
        "operation",
        "kind",
        "session_id",
        "request_id",
        "input_digest",
        "receipt",
        "result",
        "route_contract",
        "authority_effect",
        "result_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "are.cli-result/v1"
        },
        "ok": {
          "const": true
        },
        "operation": {
          "enum": [
            "route",
            "context",
            "effect",
            "continue"
          ]
        },
        "kind": {
          "enum": [
            "direct",
            "gate",
            "block",
            "complete"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "input_digest": {
          "type": "string"
        },
        "receipt": {
          "$ref": "request.schema.json#/properties/previous_receipt"
        },
        "result": {
          "type": "object"
        },
        "route_contract": {
          "type": [
            "object",
            "null"
          ]
        },
        "authority_effect": {
          "const": "none"
        },
        "result_digest": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ok",
        "kind",
        "reason_codes",
        "authority_effect"
      ],
      "properties": {
        "schema_version": {
          "const": "are.cli-result/v1"
        },
        "ok": {
          "const": false
        },
        "kind": {
          "const": "block"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_effect": {
          "const": "none"
        }
      }
    }
  ]
}
