{
  "schema_version": "minted-node/v1",
  "node_id": "agent-reasoning-engine.AuthoritySeparation",
  "feature_id": "agent-reasoning-engine",
  "kind": "Rule",
  "intent": "Keep context selection, semantic judgment, validation, consensus, and receipts separate from owner authority and exact-effect permission.",
  "body": {"formal_return_type": "boolean", "semantic_refs": ["CAV2-D65", "CAV2-D67", "CA2-CAP-REASON-AND-MANAGE-CONTEXT"], "required_conditions": ["model output cannot appoint an owner", "validation cannot promote a capability", "semantic recommendation cannot authorize an effect", "effect permission requires a separate exact gate", "claim wording does not exceed evidence"], "violation_behavior": "block and preserve residue", "authority_effect": "none"},
  "connections": [
    {"edge_id": "agent-reasoning-engine.edge.authority-separation-enforces-route", "type": "enforces", "to": "agent-reasoning-engine.IntentRouteResolution"},
    {"edge_id": "agent-reasoning-engine.edge.authority-separation-enforces-view", "type": "enforces", "to": "agent-reasoning-engine.ContextViewBinding"},
    {"edge_id": "agent-reasoning-engine.edge.authority-separation-enforces-reduction", "type": "enforces", "to": "agent-reasoning-engine.SemanticReduction"},
    {"edge_id": "agent-reasoning-engine.edge.authority-separation-enforces-continuation", "type": "enforces", "to": "agent-reasoning-engine.ContinuationDecision"}
  ]
}
