#!/usr/bin/env python3
"""Desktop dependency overlay over the existing shared compiler. Questions: README.md."""
import hashlib,json,os,sys
from pathlib import Path
here=Path(__file__).resolve().parent
digest=hashlib.sha256((here/'desktop-lock.json').read_bytes()).hexdigest()
root=Path(os.environ.get('XDG_DATA_HOME',str(Path.home()/'.local/share')))/'cyberalchemy/toolchains'/('desktop-'+digest[:16])
marker=root/'installation.json'
if not marker.exists() or json.loads(marker.read_text())['lock_sha256']!=digest:
    sys.exit('Run python3 tools/toolchain/bootstrap-desktop.py first')
if len(sys.argv)<2:sys.exit('Usage: tools/toolchain/run-desktop COMMAND [ARGS...]')
env=dict(os.environ);lib=str(root/'usr/lib/x86_64-linux-gnu')
env['PATH']=str(root/'usr/bin')+os.pathsep+env.get('PATH','/usr/bin:/bin')
env['PKG_CONFIG_SYSROOT_DIR']=str(root)
env['PKG_CONFIG_LIBDIR']=os.pathsep.join([lib+'/pkgconfig',str(root/'usr/share/pkgconfig'),'/usr/share/pkgconfig'])
env['LD_LIBRARY_PATH']=lib+(':'+env['LD_LIBRARY_PATH'] if env.get('LD_LIBRARY_PATH') else '')
env['LIBRARY_PATH']=lib+(':'+env['LIBRARY_PATH'] if env.get('LIBRARY_PATH') else '')
os.execve(str(here/'run'),[str(here/'run'),*sys.argv[1:]],env)
