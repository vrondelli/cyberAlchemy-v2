{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-trusted-dataset-system-ontology/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_id", "ontology_type", "branch", "status", "compiled_from", "components", "data_structures", "tables", "constraints", "workflow", "operation_bindings", "event_bindings", "bridge_edges", "test_evidence", "observability", "known_gaps"],
  "properties": {
    "schema_version": {"const":"cav2-trusted-dataset-system-ontology/v1"},
    "ontology_id": {"const":"cav2.trusted-dataset-materialization.system"},
    "ontology_type": {"const":"system"},
    "branch": {"const":"system"},
    "status": {"const":"compiled-candidate"},
    "compiled_from": {"type":"object"},
    "components": {"type":"array", "minItems":7, "items":{"$ref":"#/$defs/node"}},
    "data_structures": {"type":"array", "minItems":4, "items":{"$ref":"#/$defs/node"}},
    "tables": {"type":"array", "minItems":6, "items":{"$ref":"#/$defs/node"}},
    "constraints": {"type":"array", "minItems":4, "items":{"$ref":"#/$defs/node"}},
    "workflow": {"type":"object"},
    "operation_bindings": {"type":"array", "minItems":12},
    "event_bindings": {"type":"array", "minItems":12},
    "bridge_edges": {"type":"array", "minItems":16, "items":{"$ref":"#/$defs/edge"}},
    "test_evidence": {"type":"array", "minItems":7, "items":{"$ref":"#/$defs/node"}},
    "observability": {"type":"array", "minItems":1, "items":{"$ref":"#/$defs/node"}},
    "known_gaps": {"type":"array", "items":{"$ref":"#/$defs/node"}}
  },
  "$defs": {
    "node": {"type":"object", "required":["id"], "properties":{"id":{"type":"string","minLength":1}}},
    "edge": {"type":"object", "required":["id","type","business_ref","system_ref"], "properties":{"id":{"type":"string"},"type":{"enum":["realized_by","depends_on","constrained_by","observed_by","tested_by","drifts_from","traced_to"]},"business_ref":{"type":"string"},"system_ref":{"type":"string"}}}
  }
}
