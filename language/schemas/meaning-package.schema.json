{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/language-meaning-package/v1",
  "title": "CyberAlchemy Language meaning and realization package",
  "$defs": {
    "meaningRegistry": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "language_ref", "bindings"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-meaning-bindings/v1"},
        "language_ref": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["binding_id", "concept_ref", "expression_ref", "status", "business_meaning", "domain_meaning", "product_meaning", "system_realization_ref", "noncollapse_rule", "owner_route", "authority_effect"],
            "additionalProperties": false,
            "properties": {
              "binding_id": {"type": "string", "minLength": 1},
              "concept_ref": {"type": "string", "minLength": 1},
              "expression_ref": {"type": "string", "minLength": 1},
              "status": {"const": "candidate"},
              "business_meaning": {"$ref": "#/$defs/namedMeaning"},
              "domain_meaning": {"$ref": "#/$defs/namedMeaning"},
              "product_meaning": {"$ref": "#/$defs/namedMeaning"},
              "system_realization_ref": {"type": "string", "minLength": 1},
              "noncollapse_rule": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1},
              "authority_effect": {"const": "none"}
            }
          }
        }
      }
    },
    "namedMeaning": {
      "type": "object",
      "required": ["term", "definition"],
      "additionalProperties": false,
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    },
    "edgeRegistry": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "language_ref", "edges", "known_conflicts"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-edge-vocabulary/v1"},
        "language_ref": {"type": "string", "minLength": 1},
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["edge_id", "verb", "source_concept", "target_concept", "business_sentence", "product_consequence", "noncollapse_witness", "domainspec_relationship_ref", "adoption_status", "owner_route", "authority_effect"],
            "additionalProperties": false,
            "properties": {
              "edge_id": {"type": "string", "minLength": 1},
              "verb": {"type": "string", "minLength": 1},
              "source_concept": {"type": "string", "minLength": 1},
              "target_concept": {"type": "string", "minLength": 1},
              "business_sentence": {"type": "string", "minLength": 1},
              "product_consequence": {"type": "string", "minLength": 1},
              "noncollapse_witness": {"type": "string", "minLength": 1},
              "domainspec_relationship_ref": {"type": ["string", "null"]},
              "adoption_status": {"enum": ["proposed", "exercised", "challenged", "accepted", "superseded"]},
              "owner_route": {"type": "string", "minLength": 1},
              "authority_effect": {"const": "none"}
            }
          }
        },
        "known_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["conflict_id", "term", "status", "statement", "owner_route", "next_action", "authority_effect"],
            "additionalProperties": false,
            "properties": {
              "conflict_id": {"type": "string", "minLength": 1},
              "term": {"type": "string", "minLength": 1},
              "status": {"const": "open"},
              "statement": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1},
              "next_action": {"type": "string", "minLength": 1},
              "authority_effect": {"const": "none"}
            }
          }
        }
      }
    },
    "realizationRegistry": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "language_ref", "bindings"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-realization-bindings/v1"},
        "language_ref": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["binding_id", "concept_ref", "status", "selected_domainspec_type_ref", "semantic_equivalence", "candidates", "decision_question", "decision_owner", "blocked_effects", "authority_effect"],
            "additionalProperties": false,
            "properties": {
              "binding_id": {"type": "string", "minLength": 1},
              "concept_ref": {"type": "string", "minLength": 1},
              "status": {"enum": ["open", "selected", "superseded"]},
              "selected_domainspec_type_ref": {"type": ["string", "null"]},
              "semantic_equivalence": {"const": false},
              "candidates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["domainspec_type_ref", "label", "fit_condition"],
                  "additionalProperties": false,
                  "properties": {
                    "domainspec_type_ref": {"type": "string", "minLength": 1},
                    "label": {"type": "string", "minLength": 1},
                    "fit_condition": {"type": "string", "minLength": 1}
                  }
                }
              },
              "decision_question": {"type": "string", "minLength": 1},
              "decision_owner": {"type": "string", "minLength": 1},
              "blocked_effects": {"type": "array", "minItems": 1},
              "authority_effect": {"const": "none"}
            }
          }
        }
      }
    },
    "authorityBindingRegistry": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "language_ref", "bindings"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-authority-bindings/v1"},
        "language_ref": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["binding_id", "concept_ref", "candidate_authority_kind", "possible_promoted_authority_kind", "authority_function", "governing_definition_refs", "source_refs", "allowed_use", "blocked_use", "required_separations", "authority_effect"],
            "additionalProperties": false,
            "properties": {
              "binding_id": {"type": "string", "minLength": 1},
              "concept_ref": {"type": "string", "minLength": 1},
              "candidate_authority_kind": {"type": ["string", "null"]},
              "possible_promoted_authority_kind": {"type": ["string", "null"]},
              "authority_function": {"type": "string", "minLength": 1},
              "governing_definition_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
              "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
              "allowed_use": {"type": "string", "minLength": 1},
              "blocked_use": {"type": "string", "minLength": 1},
              "required_separations": {"type": "array", "minItems": 1, "uniqueItems": true},
              "authority_effect": {"const": "none"}
            }
          }
        }
      }
    }
  }
}
