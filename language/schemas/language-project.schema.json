{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/language-project/v1",
  "title": "CyberAlchemy v2 Language Project package",
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "package_id", "package_root", "package_owner", "project_ref", "project_space", "ontology_type", "visibility", "status", "authority_effect", "definition_authority", "source_registry", "ontology_view", "meaning_registry", "edge_vocabulary", "realization_registry", "authority_registry", "craft_ledger", "craft_view", "schema_path", "validator_path", "blocked_effects"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-project-profile/v1"},
        "package_id": {"type": "string", "minLength": 1},
        "package_root": {"const": "cyberAlchemy-v2/language"},
        "package_owner": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "minLength": 1},
        "ontology_type": {"const": "business-domain"},
        "visibility": {"const": "private"},
        "status": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "definition_authority": {"type": "string", "minLength": 1},
        "source_registry": {"type": "string", "minLength": 1},
        "ontology_view": {"type": "string", "minLength": 1},
        "meaning_registry": {"const": "meaning-bindings.json"},
        "edge_vocabulary": {"const": "edge-vocabulary.json"},
        "realization_registry": {"const": "realization-bindings.json"},
        "authority_registry": {"const": "authority-bindings.json"},
        "craft_ledger": {"const": ".craft/ledger.yml"},
        "craft_view": {"const": "CRAFT.md"},
        "schema_path": {"type": "string", "minLength": 1},
        "validator_path": {"type": "string", "minLength": 1},
        "project_space": {
          "type": "object",
          "required": ["project_space_id", "concept_ref", "path", "role"],
          "additionalProperties": false,
          "properties": {
            "project_space_id": {"type": "string", "minLength": 1},
            "concept_ref": {"const": "CAV2-D15"},
            "path": {"const": "cyberAlchemy-v2/language"},
            "role": {"type": "string", "minLength": 1}
          }
        },
        "blocked_effects": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "project": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "project_id", "name", "purpose", "scope", "exclusions", "owner_routes", "goal_refs", "research_refs", "experiment_refs", "evidence_index", "thesis_refs", "lifecycle_state", "challenge_route", "authority_effect"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "cav2-project/v1"},
        "project_id": {"type": "string", "pattern": "^CA2-PROJECT-[A-Z0-9-]+$"},
        "schema_ref": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1},
        "exclusions": {"type": "array", "minItems": 1},
        "owner_routes": {"type": "array", "minItems": 1},
        "goal_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "research_refs": {"type": "array", "maxItems": 0},
        "experiment_refs": {"type": "array", "maxItems": 0},
        "evidence_index": {"type": "array"},
        "thesis_refs": {"type": "array", "minItems": 1},
        "lifecycle_state": {"enum": ["proposed", "active", "completed", "cancelled", "superseded"]},
        "challenge_route": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"}
      }
    },
    "goal": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "canonical_kind", "goal_id", "title", "project_ref", "outcome", "rationale", "thesis_refs", "scope", "exclusions", "owner_route", "success_conditions", "evidence_requirements", "evidence_refs", "lifecycle_state", "achievement_state", "current_condition", "target_horizon", "revision_history", "challenge_route", "blocked_effects", "authority_effect"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-goal/v1"},
        "canonical_kind": {"const": "goal"},
        "goal_id": {"type": "string", "pattern": "^CA2-GOAL-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "pattern": "^CA2-PROJECT-[A-Z0-9-]+$"},
        "outcome": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "thesis_refs": {"type": "array", "minItems": 1},
        "scope": {"type": "array", "minItems": 1},
        "exclusions": {"type": "array", "minItems": 1},
        "owner_route": {"type": "string", "minLength": 1},
        "success_conditions": {"type": "array", "minItems": 1},
        "evidence_requirements": {"type": "array", "minItems": 1},
        "evidence_refs": {"type": "array"},
        "lifecycle_state": {"enum": ["draft", "active", "achieved", "abandoned", "superseded"]},
        "achievement_state": {"enum": ["not-proven", "proved", "rejected"]},
        "current_condition": {"type": "string", "minLength": 1},
        "target_horizon": {"type": "string", "minLength": 1},
        "revision_history": {"type": "array", "minItems": 1},
        "challenge_route": {"type": "string", "minLength": 1},
        "blocked_effects": {"type": "array", "minItems": 1},
        "authority_effect": {"const": "none"}
      }
    },
    "conceptRegistry": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "concepts"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-concepts/v1"},
        "concepts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["concept_id", "term", "aliases", "status", "normative_voice", "formal_voice", "plain_language_voice", "domain_context_voice", "boundary", "owner_route", "source_refs", "authority_effect"],
            "additionalProperties": false,
            "properties": {
              "concept_id": {"type": "string", "minLength": 1},
              "term": {"type": "string", "minLength": 1},
              "aliases": {"type": "array"},
              "status": {"const": "candidate"},
              "normative_voice": {"type": "string", "minLength": 1},
              "formal_voice": {"type": "string", "minLength": 1},
              "plain_language_voice": {"type": "string", "minLength": 1},
              "domain_context_voice": {"type": "string", "minLength": 1},
              "boundary": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1},
              "source_refs": {"type": "array", "minItems": 1},
              "authority_effect": {"const": "none"}
            }
          }
        }
      }
    },
    "language": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "language_id", "name", "language_concept_ref", "specialization_ref", "bounded_context", "communities", "usage_surfaces", "concept_entries", "conflict_policy", "revision_state", "owner_routes", "authority_effect"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language/v1"},
        "language_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "language_concept_ref": {"type": "string", "minLength": 1},
        "specialization_ref": {"type": "string", "minLength": 1},
        "bounded_context": {
          "type": "object",
          "required": ["context_id", "name", "scope", "exclusions"],
          "additionalProperties": false,
          "properties": {
            "context_id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "exclusions": {"type": "array", "minItems": 1}
          }
        },
        "communities": {"type": "array", "minItems": 1},
        "usage_surfaces": {"type": "array", "minItems": 1},
        "concept_entries": {"type": "array", "minItems": 1},
        "conflict_policy": {"type": "string", "minLength": 1},
        "revision_state": {"type": "string", "minLength": 1},
        "owner_routes": {"type": "array", "minItems": 1},
        "authority_effect": {"const": "none"}
      }
    },
    "discipline": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "discipline_id", "name", "kind_ref", "status", "purpose", "language_ref", "practice_steps", "first_consumer_ref", "first_output_ref", "first_exercise_ref", "validation_mode", "boundary", "owner_route", "authority_effect"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-discipline/v1"},
        "discipline_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind_ref": {"const": "CAV2-D50"},
        "status": {"const": "candidate"},
        "purpose": {"type": "string", "minLength": 1},
        "language_ref": {"type": "string", "minLength": 1},
        "practice_steps": {"type": "array", "minItems": 1},
        "first_consumer_ref": {"type": "string", "minLength": 1},
        "first_output_ref": {"type": "string", "minLength": 1},
        "first_exercise_ref": {"type": "string", "minLength": 1},
        "validation_mode": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "owner_route": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"}
      }
    },
    "example": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "example_id", "title", "status", "language_ref", "discipline_ref", "meaning_binding_refs", "edge_refs", "realization_binding_refs", "goal", "candidate_mappings", "open_questions", "decision_owner", "blocked_actions", "authority_effect"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-example/v1"},
        "example_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["in-progress", "owner-reviewed", "superseded"]},
        "language_ref": {"type": "string", "minLength": 1},
        "discipline_ref": {"type": "string", "minLength": 1},
        "meaning_binding_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "edge_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "realization_binding_refs": {"type": "array", "minItems": 1, "uniqueItems": true},
        "goal": {"type": "string", "minLength": 1},
        "candidate_mappings": {"type": "array", "minItems": 1},
        "open_questions": {"type": "array"},
        "decision_owner": {"type": "string", "minLength": 1},
        "blocked_actions": {"type": "array", "minItems": 1},
        "authority_effect": {"const": "none"}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "sources"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-sources/v1"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "path", "binding_mode", "start_marker", "end_marker", "sha256", "posture", "owner_route"],
            "additionalProperties": false,
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "binding_mode": {"enum": ["file-sha256", "selector-sha256", "locator-only"]},
              "start_marker": {"type": ["string", "null"]},
              "end_marker": {"type": ["string", "null"]},
              "sha256": {"type": ["string", "null"]},
              "posture": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "residueRegistry": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "residue"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-residue/v1"},
        "residue": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["residue_id", "status", "kind", "statement", "owner_route", "next_action"],
            "additionalProperties": false,
            "properties": {
              "residue_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1},
              "next_action": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "ontology": {
      "type": "object",
      "required": ["schema_ref", "schema_version", "ontology_id", "ontology_type", "branch", "visibility", "status", "authority_effect", "nodes", "relation_vocabulary", "relations", "claim_ceiling"],
      "additionalProperties": false,
      "properties": {
        "schema_ref": {"type": "string", "minLength": 1},
        "schema_version": {"const": "cav2-language-ontology/v1"},
        "ontology_id": {"type": "string", "minLength": 1},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "visibility": {"const": "private"},
        "status": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "nodes": {"type": "array", "minItems": 1},
        "relation_vocabulary": {"type": "array", "minItems": 1},
        "relations": {"type": "array", "minItems": 1},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    }
  }
}
