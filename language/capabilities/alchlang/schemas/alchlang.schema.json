{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/alchlang.schema.json",
  "$defs": {
    "id": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "text": {"type":"string","minLength":1},
    "sourceRef": {"type":"string","pattern":"^CAP-SEL-ALCHLANG-"},
    "authorStatement": {"type":"object","additionalProperties":false,"required":["statement_id","statement","decision_posture"],"properties":{"statement_id":{"type":"string","pattern":"^ALCHLANG-INTENT-"},"statement":{"$ref":"#/$defs/text"},"decision_posture":{"const":"approved-semantic-direction"}}},
    "authorIntent": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","intent_id","product_ref","capability_name","statements","artifact_adoption_state","recording_note","authority_effect"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/authorIntent"},"schema_version":{"const":"cav2-alchlang-author-intent/v1"},"intent_id":{"const":"CA2-ALCHLANG-AUTHOR-INTENT-001"},"product_ref":{"const":"CA2-PRODUCT-CYBERALCHEMY"},"capability_name":{"const":"AlchLang"},"statements":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/authorStatement"}},"artifact_adoption_state":{"const":"not-adopted-pending-digest-review"},"recording_note":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
    "profile": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","package_id","package_root","package_owner","meaning_owner","project_ref","product_ref","product_capability_ref","ontology_id","ontology_type","branch","visibility","candidate_status","construction_stage","authority_effect","source_registry","definition_registry","product_capability","node_registry","relation_registry","reference_example_registry","residue_registry","schema_path","validator_path","blocked_outputs"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/profile"},"schema_version":{"const":"cav2-alchlang-profile/v2"},"package_id":{"const":"cav2.language.capability.alchlang"},"package_root":{"const":"cyberAlchemy-v2/language/capabilities/alchlang"},"package_owner":{"$ref":"#/$defs/text"},"meaning_owner":{"$ref":"#/$defs/text"},"project_ref":{"const":"CA2-PROJECT-LANGUAGE"},"product_ref":{"const":"CA2-PRODUCT-CYBERALCHEMY"},"product_capability_ref":{"const":"CA2-CAP-ALCHLANG-MODEL-GOVERNED-DOMAINS"},"ontology_id":{"const":"cav2.alchlang.business"},"ontology_type":{"const":"business-domain"},"branch":{"const":"business"},"visibility":{"const":"private"},"candidate_status":{"const":"candidate"},"construction_stage":{"const":"business-ontology-with-accepted-reference-verticals-candidate"},"authority_effect":{"const":"none"},"source_registry":{"const":"sources.json"},"definition_registry":{"const":"definitions.json"},"product_capability":{"const":"product-capability.json"},"node_registry":{"const":"nodes.json"},"relation_registry":{"const":"relations.json"},"reference_example_registry":{"const":"reference-examples.json"},"residue_registry":{"const":"residue.json"},"schema_path":{"const":"schemas/alchlang.schema.json"},"validator_path":{"const":"scripts/validate.py"},"blocked_outputs":{"type":"array","minItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "source": {"type":"object","additionalProperties":false,"required":["source_id","path","selector_kind","selector","id_field","id_value","selection_sha256","posture","owner_route"],"properties":{"source_id":{"$ref":"#/$defs/sourceRef"},"path":{"$ref":"#/$defs/text"},"selector_kind":{"enum":["markdown-heading","json-pointer","json-record"]},"selector":{"$ref":"#/$defs/text"},"id_field":{"type":["string","null"]},"id_value":{"type":["string","null"]},"selection_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"posture":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}}},
    "sourceRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","selection_digest_algorithm","sources"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/sourceRegistry"},"schema_version":{"const":"cav2-alchlang-sources/v2"},"selection_digest_algorithm":{"const":"sha256-selected-bytes/v1"},"sources":{"type":"array","minItems":13,"maxItems":13,"items":{"$ref":"#/$defs/source"}}}},
    "canonicalBinding": {"type":"object","additionalProperties":false,"required":["definition_ref","term","source_ref","local_posture"],"properties":{"definition_ref":{"enum":["CAV2-D65","CAV2-D67"]},"term":{"$ref":"#/$defs/text"},"source_ref":{"$ref":"#/$defs/sourceRef"},"local_posture":{"const":"reference-only"}}},
    "localTerm": {"type":"object","additionalProperties":false,"required":["term_id","term","disposition","meaning","source_refs","owner_route","authority_effect"],"properties":{"term_id":{"type":"string","pattern":"^ALCHLANG-TERM-"},"term":{"$ref":"#/$defs/text"},"disposition":{"enum":["reuse","specialize","propose","open"]},"meaning":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sourceRef"}},"owner_route":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
    "definitionRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","canonical_bindings","local_terms"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/definitionRegistry"},"schema_version":{"const":"cav2-alchlang-definitions/v1"},"canonical_bindings":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/canonicalBinding"}},"local_terms":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/localTerm"}}}},
    "node": {"type":"object","additionalProperties":false,"required":["id","label","role","plain_language","claim","source_refs","owner_route","candidate_status","authority_effect","forbidden_collapse"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/text"},"role":{"enum":["product_projection","product_capability","actor","outcome","input_contract","output_contract","context_policy","domain_concept","business_rule","construction_boundary"]},"plain_language":{"$ref":"#/$defs/text"},"claim":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sourceRef"}},"owner_route":{"$ref":"#/$defs/text"},"candidate_status":{"enum":["projected","candidate","blocked"]},"authority_effect":{"const":"none"},"forbidden_collapse":{"$ref":"#/$defs/text"}}},
    "nodeRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","nodes"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/nodeRegistry"},"schema_version":{"const":"cav2-alchlang-nodes/v1"},"nodes":{"type":"array","minItems":20,"items":{"$ref":"#/$defs/node"}}}},
    "relationType": {"type":"object","additionalProperties":false,"required":["type","source_roles","target_roles","meaning","forbidden_collapse"],"properties":{"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"target_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"meaning":{"$ref":"#/$defs/text"},"forbidden_collapse":{"$ref":"#/$defs/text"}}},
    "relation": {"type":"object","additionalProperties":false,"required":["id","type","source","target","source_refs","owner_route","candidate_status","authority_effect"],"properties":{"id":{"type":"string","pattern":"^E-ALCHLANG-"},"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sourceRef"}},"owner_route":{"$ref":"#/$defs/text"},"candidate_status":{"enum":["candidate","blocked"]},"authority_effect":{"const":"none"}}},
    "relationRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","relation_vocabulary","relations"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/relationRegistry"},"schema_version":{"const":"cav2-alchlang-relations/v1"},"relation_vocabulary":{"type":"array","minItems":8,"maxItems":8,"items":{"$ref":"#/$defs/relationType"}},"relations":{"type":"array","minItems":16,"items":{"$ref":"#/$defs/relation"}}}},
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifactRef": {"type":"object","additionalProperties":false,"required":["ref","sha256"],"properties":{"ref":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/digest"}}},
    "sourcedArtifactRef": {"type":"object","additionalProperties":false,"required":["ref","sha256","source_ref"],"properties":{"ref":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/digest"},"source_ref":{"$ref":"#/$defs/sourceRef"}}},
    "domainspecSourceRef": {"type":"object","additionalProperties":false,"required":["ref","manifest_sha256"],"properties":{"ref":{"$ref":"#/$defs/text"},"manifest_sha256":{"$ref":"#/$defs/digest"}}},
    "implementationRef": {"type":"object","additionalProperties":false,"required":["ref","digest"],"properties":{"ref":{"$ref":"#/$defs/text"},"digest":{"$ref":"#/$defs/digest"}}},
    "ontologySummary": {"type":"object","additionalProperties":false,"required":["term_ids","edge_ids"],"properties":{"term_ids":{"type":"array","minItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"edge_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "sourceCampaignPosture": {"type":"object","additionalProperties":false,"required":["status","expected_superseded_predecessor_paths"],"properties":{"status":{"const":"historical-accepted-predecessor-set"},"expected_superseded_predecessor_paths":{"type":"array","minItems":1,"maxItems":1,"uniqueItems":true,"items":{"const":"cyberAlchemy-v2/language/capabilities/alchlang/product-capability.json"}}}},
    "referenceExample": {"type":"object","additionalProperties":false,"required":["vertical_id","status","product_capability","business_ontology","alchlang_source","ontology_summary","domainspec_source","compiled_graph","system_ontology","implementation","generation_receipt","accepted_conformance","accepted_construction_binding","authority_effect"],"properties":{"vertical_id":{"enum":["customer-credit-release","inventory-reservation","production-rollback"]},"status":{"const":"candidate-owner-accepted-reference"},"product_capability":{"$ref":"#/$defs/artifactRef"},"business_ontology":{"$ref":"#/$defs/artifactRef"},"alchlang_source":{"$ref":"#/$defs/artifactRef"},"ontology_summary":{"$ref":"#/$defs/ontologySummary"},"domainspec_source":{"$ref":"#/$defs/domainspecSourceRef"},"compiled_graph":{"$ref":"#/$defs/artifactRef"},"system_ontology":{"$ref":"#/$defs/artifactRef"},"implementation":{"$ref":"#/$defs/implementationRef"},"generation_receipt":{"$ref":"#/$defs/artifactRef"},"accepted_conformance":{"$ref":"#/$defs/artifactRef"},"accepted_construction_binding":{"$ref":"#/$defs/sourcedArtifactRef"},"authority_effect":{"const":"none"}}},
    "referenceExampleRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","registry_id","campaign_id","integration_status","source_campaign_posture","decision","reviewed_receipt","examples","authority_effect","claim_ceiling"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/referenceExampleRegistry"},"schema_version":{"const":"cav2-alchlang-reference-examples/v1"},"registry_id":{"const":"cav2.alchlang.accepted-reference-examples"},"campaign_id":{"const":"CA2-CAMPAIGN-ALCHLANG-THREE-COMPILED-VERTICALS-001"},"integration_status":{"const":"candidate-owner-accepted-reference-set"},"source_campaign_posture":{"$ref":"#/$defs/sourceCampaignPosture"},"decision":{"$ref":"#/$defs/sourcedArtifactRef"},"reviewed_receipt":{"$ref":"#/$defs/sourcedArtifactRef"},"examples":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/referenceExample"}},"authority_effect":{"const":"none"},"claim_ceiling":{"$ref":"#/$defs/text"}}},
    "residue": {"type":"object","additionalProperties":false,"required":["residue_id","status","statement","owner_route","next_action","subject_refs","evidence_refs","authority_effect"],"properties":{"residue_id":{"type":"string","pattern":"^CAP-RES-ALCHLANG-"},"status":{"enum":["open","blocked"]},"statement":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"},"next_action":{"$ref":"#/$defs/text"},"subject_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sourceRef"}},"authority_effect":{"const":"none"}}},
    "residueRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","residue"],"properties":{"schema_ref":{"const":"schemas/alchlang.schema.json#/$defs/residueRegistry"},"schema_version":{"const":"cav2-alchlang-residue/v1"},"residue":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/residue"}}}}
  }
}
