{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2.alchlang.general-compiler.package/v1-candidate",
  "title": "AlchLang General Compiler Candidate Package Records",
  "$defs": {
    "authorityNone": {"const":"none"},
    "node": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","role","label","meaning","owner_route","status","authority_effect"],
      "properties": {
        "id":{"type":"string","pattern":"^B-GC-"},"role":{"enum":["actor","product_capability","input_contract","output_contract","domain_concept","outcome","policy"]},"label":{"type":"string","minLength":1},"meaning":{"type":"string","minLength":1},"owner_route":{"type":"string","minLength":1},"status":{"const":"candidate"},"authority_effect":{"$ref":"#/$defs/authorityNone"}
      }
    },
    "relation": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","type","source","target","meaning","status","authority_effect"],
      "properties": {
        "id":{"type":"string","pattern":"^E-GC-"},"type":{"enum":["accepts","produces","achieves","governed_by","contains","constrains","extends"]},"source":{"type":"string","pattern":"^B-GC-"},"target":{"type":"string","pattern":"^B-GC-"},"meaning":{"type":"string","minLength":1},"status":{"const":"candidate"},"authority_effect":{"$ref":"#/$defs/authorityNone"}
      }
    }
  },
  "authority_effect": "none"
}
