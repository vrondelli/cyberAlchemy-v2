{
  "schema_version": "domainspec.node/v1",
  "node_id": "line-subtotal",
  "feature_id": "quantity-price",
  "kind": "Calculation",
  "body": {
    "description": "Exact UInt64 multiplication of selected unit cents by requested quantity; overflow is an error, not rounding.",
    "inputs": [
      "amount_minor",
      "requested_quantity"
    ],
    "typed_contract": {
      "schema_version": "domainspec.typed-calculation/v1",
      "ontology_calculation": "ALCH-QUANTITY-LINESUBTOTAL",
      "inputs": [
        {
          "name": "amount_minor",
          "type": {
            "kind": "scalar",
            "name": "UInt64"
          }
        },
        {
          "name": "requested_quantity",
          "type": {
            "kind": "scalar",
            "name": "UInt64"
          }
        }
      ],
      "result": {
        "kind": "scalar",
        "name": "UInt64"
      },
      "division_rounding": "reject",
      "expression": {
        "op": "multiply",
        "left": {
          "op": "input",
          "name": "amount_minor"
        },
        "right": {
          "op": "input",
          "name": "requested_quantity"
        }
      }
    }
  }
}
