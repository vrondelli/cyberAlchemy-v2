{
  "schema_version": "alchlang.portable-http/v1",
  "entry": "app/function/index.mjs#handler",
  "launcher": "app/function/server.mjs",
  "target": "node-http",
  "runtime": "node>=26.8.1",
  "limits": {
    "request_bytes": 65536,
    "request_read_timeout_ms": 5000
  },
  "method": "POST",
  "path": "/internal/select-provider",
  "environment_references": [
    "INFERENCE_CATALOG_TOKEN",
    "INFERENCE_CATALOG_URL",
    "INFERENCE_INTERNAL_TOKEN"
  ],
  "integrations": {
    "ProviderCatalog": {
      "query": {
        "tenant_id": "input.request.tenant_id"
      },
      "transport": "provided-or-http",
      "provided": "input.catalog",
      "output": "Catalog",
      "urlEnv": "INFERENCE_CATALOG_URL",
      "secretEnv": "INFERENCE_CATALOG_TOKEN",
      "timeout": 3000,
      "maxBytes": 65536
    }
  },
  "provisioned": false,
  "authority_effect": "none"
}
