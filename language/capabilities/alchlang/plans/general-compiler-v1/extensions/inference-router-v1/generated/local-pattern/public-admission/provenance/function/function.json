{
  "schemas": {
    "Input": {
      "strategy": {
        "type": "identifier",
        "max": 128
      },
      "model": {
        "type": "identifier",
        "max": 128,
        "optional": true
      },
      "strategies": {
        "type": "list",
        "items": "identifier",
        "max": 3
      },
      "models": {
        "type": "list",
        "items": "identifier",
        "max": 100
      }
    },
    "Output": {
      "status": {
        "type": "string",
        "const": "ok"
      },
      "code": {
        "type": "string",
        "pattern": "^(OK|UNSUPPORTED_STRATEGY|UNKNOWN_MODEL)$"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "Function",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/internal/admission",
    "input": "Input",
    "output": "Output",
    "authEnv": "INFERENCE_INTERNAL_TOKEN",
    "maxBytes": 65536,
    "timeout": 5000,
    "errorStatus": 422,
    "statuses": {
      "ok": 200
    },
    "errors": {},
    "result": "Result"
  },
  "portability": "node-rust-v1"
}
