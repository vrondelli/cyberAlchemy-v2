{
  "schemas": {
    "Text": {
      "text": {
        "type": "string",
        "max": 32768
      }
    },
    "Observation": {
      "value": {
        "type": "integer",
        "nullable": true,
        "min": 0,
        "max": 1000000000
      },
      "provenance": {
        "type": "string",
        "pattern": "^(unavailable|provider-reported)$"
      }
    },
    "Usage": {
      "input_tokens": {
        "type": "Observation"
      },
      "output_tokens": {
        "type": "Observation"
      }
    },
    "Input": {
      "request_id": {
        "type": "identifier",
        "max": 128
      },
      "model": {
        "type": "identifier",
        "max": 128
      },
      "output": {
        "type": "Text"
      },
      "finish_reason": {
        "type": "string",
        "pattern": "^(stop|length|content_filter|unknown)$"
      },
      "usage": {
        "type": "Usage"
      }
    },
    "Output": {
      "status": {
        "type": "string",
        "const": "ok"
      },
      "value": {
        "type": "Input"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "Function",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/internal/inference-result",
    "input": "Input",
    "output": "Output",
    "authEnv": "INFERENCE_INTERNAL_TOKEN",
    "maxBytes": 65536,
    "timeout": 5000,
    "errorStatus": 422,
    "statuses": {
      "ok": 200
    },
    "errors": {},
    "result": "Result"
  },
  "portability": "node-rust-v1"
}
