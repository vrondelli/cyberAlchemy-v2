{
  "schema_version": "alchlang.portable-http/v1",
  "entry": "app/function/index.mjs#handler",
  "launcher": "app/function/server.mjs",
  "target": "node-http",
  "runtime": "node>=26.8.1",
  "limits": {
    "request_bytes": 65536,
    "request_read_timeout_ms": 5000
  },
  "method": "POST",
  "path": "/internal/stream-fail",
  "environment_references": [
    "INFERENCE_INTERNAL_TOKEN"
  ],
  "integrations": {
    "Sanitize": {
      "query": {},
      "transport": "module-local",
      "module": "Errors",
      "input": "ErrorArgument",
      "output": "Errors__Output",
      "timeout": 5000,
      "maxBytes": 65536
    }
  },
  "provisioned": false,
  "authority_effect": "none"
}
