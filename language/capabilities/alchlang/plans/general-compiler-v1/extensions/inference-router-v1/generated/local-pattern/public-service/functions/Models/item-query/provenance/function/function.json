{
  "schemas": {
    "Provider": {
      "binding_id": {
        "type": "identifier",
        "max": 128
      },
      "binding_version": {
        "type": "identifier",
        "max": 128
      },
      "model": {
        "type": "identifier",
        "max": 128
      },
      "enabled": {
        "type": "boolean"
      },
      "tenant_allowed": {
        "type": "boolean"
      },
      "task": {
        "type": "string",
        "const": "text.generate"
      },
      "context_limit": {
        "type": "integer",
        "min": 1,
        "max": 1000000
      },
      "output_limit": {
        "type": "integer",
        "min": 1,
        "max": 1000000
      },
      "streaming": {
        "type": "boolean"
      },
      "rank": {
        "type": "integer",
        "min": 0,
        "max": 1000000
      }
    },
    "SummaryInput": {
      "providers": {
        "type": "list",
        "items": "Provider",
        "max": 300
      },
      "model": {
        "type": "identifier"
      }
    },
    "Model": {
      "id": {
        "type": "identifier"
      },
      "task": {
        "type": "string",
        "const": "text.generate"
      },
      "context_limit": {
        "type": "integer",
        "min": 1
      },
      "output_limit": {
        "type": "integer",
        "min": 1
      },
      "streaming": {
        "type": "boolean"
      }
    },
    "Output": {
      "status": {
        "type": "string",
        "const": "ok"
      },
      "value": {
        "type": "Model"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "Function",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/internal/model-summary",
    "input": "SummaryInput",
    "output": "Output",
    "authEnv": "INFERENCE_INTERNAL_TOKEN",
    "maxBytes": 262144,
    "timeout": 5000,
    "errorStatus": 422,
    "statuses": {
      "ok": 200
    },
    "errors": {},
    "result": "Result"
  },
  "portability": "node-rust-v1"
}
