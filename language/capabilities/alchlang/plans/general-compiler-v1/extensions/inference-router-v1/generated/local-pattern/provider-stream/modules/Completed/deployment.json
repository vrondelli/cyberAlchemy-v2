{
  "schema_version": "alchlang.portable-http/v1",
  "entry": "app/function/index.mjs#handler",
  "launcher": "app/function/server.mjs",
  "target": "node-http",
  "runtime": "node>=26.8.1",
  "limits": {
    "request_bytes": 65536,
    "request_read_timeout_ms": 5000
  },
  "method": "POST",
  "path": "/internal/stream-complete",
  "environment_references": [
    "INFERENCE_INTERNAL_TOKEN"
  ],
  "integrations": {
    "Normalize": {
      "query": {},
      "transport": "module-local",
      "module": "Provider",
      "input": "ProviderInput",
      "output": "Provider__Output",
      "timeout": 5000,
      "maxBytes": 65536
    },
    "Completion": {
      "query": {},
      "transport": "module-local",
      "module": "Public",
      "input": "CompletionInput",
      "output": "Public__Output",
      "timeout": 5000,
      "maxBytes": 65536
    }
  },
  "provisioned": false,
  "authority_effect": "none"
}
