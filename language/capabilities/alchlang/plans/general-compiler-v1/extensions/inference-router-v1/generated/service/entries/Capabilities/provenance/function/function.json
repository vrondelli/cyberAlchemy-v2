{
  "schemas": {
    "Provider": {
      "binding_id": {
        "type": "identifier",
        "max": 128
      },
      "binding_version": {
        "type": "identifier",
        "max": 128
      },
      "model": {
        "type": "identifier",
        "max": 128
      },
      "enabled": {
        "type": "boolean"
      },
      "tenant_allowed": {
        "type": "boolean"
      },
      "task": {
        "type": "string",
        "const": "text.generate"
      },
      "context_limit": {
        "type": "integer",
        "min": 1,
        "max": 1000000
      },
      "output_limit": {
        "type": "integer",
        "min": 1,
        "max": 1000000
      },
      "streaming": {
        "type": "boolean"
      },
      "rank": {
        "type": "integer",
        "min": 0,
        "max": 1000000
      }
    },
    "Input": {
      "providers": {
        "type": "list",
        "items": "Provider",
        "max": 300
      },
      "strategies": {
        "type": "list",
        "items": "identifier",
        "max": 3
      },
      "retention_ms": {
        "type": "integer",
        "min": 1
      }
    },
    "Custody": {
      "storage": {
        "type": "string",
        "const": "memory"
      },
      "retention_ms": {
        "type": "integer",
        "min": 1
      },
      "stream_replay": {
        "type": "boolean",
        "const": false
      }
    },
    "Capabilities": {
      "tasks": {
        "type": "list",
        "items": "string",
        "max": 1
      },
      "routing_strategies": {
        "type": "list",
        "items": "identifier",
        "max": 3
      },
      "streaming": {
        "type": "boolean"
      },
      "authentication": {
        "type": "string",
        "const": "deferred"
      },
      "authorization": {
        "type": "string",
        "const": "deferred"
      },
      "scope": {
        "type": "string",
        "const": "shared-public"
      },
      "idempotency": {
        "type": "Custody"
      }
    },
    "Output": {
      "status": {
        "type": "string",
        "const": "ok"
      },
      "value": {
        "type": "Capabilities"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "Function",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/internal/capabilities",
    "input": "Input",
    "output": "Output",
    "authEnv": "INFERENCE_INTERNAL_TOKEN",
    "maxBytes": 262144,
    "timeout": 5000,
    "errorStatus": 422,
    "statuses": {
      "ok": 200
    },
    "errors": {},
    "result": "Result"
  },
  "portability": "node-rust-v1"
}
