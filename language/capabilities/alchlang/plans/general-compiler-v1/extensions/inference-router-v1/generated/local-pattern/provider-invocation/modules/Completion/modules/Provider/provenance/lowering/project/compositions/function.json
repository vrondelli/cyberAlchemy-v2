{
  "source_text": "# Local JSON provider-mapping prototype. Open questions: DISPATCH.md.\ndomain provider-response \"Provider response mapper\"\nprofile declarative-function-v1\nportability node-rust-v1\nowner inference-router-owner\nlogic sfol-v1\n\nschema Input:\n  answer: string max 32768\n  stop_reason: string pattern \"^(stop|length|content_filter|unknown)$\"\n  prompt_tokens: integer optional nullable min 0 max 1000000000\n  completion_tokens: integer optional nullable min 0 max 1000000000\n\nschema Output:\n  status: string const \"mapped\"\n  text: string max 32768\n  finish_reason: string pattern \"^(stop|length|content_filter|unknown)$\"\n  input_tokens: integer optional nullable min 0 max 1000000000\n  output_tokens: integer optional nullable min 0 max 1000000000\n\nmapping ResultBody:\n  meaning \"Normalize fixture provider output and preserve missing token observations.\"\n  target Output\n  field status = \"mapped\"\n  field text = input.answer\n  field finish_reason = input.stop_reason\n  field input_tokens = input.prompt_tokens\n  field output_tokens = input.completion_tokens\n\nresult Map:\n  when true yield ResultBody\n\nendpoint Mapper:\n  target node-http\n  runtime node>=26.8.1\n  method POST\n  path \"/internal/provider-response\"\n  input Input\n  output Output\n  result Map\n  auth-env INFERENCE_INTERNAL_TOKEN\n  max-bytes 65536\n  timeout-ms 5000\n  error-status 422\n  status mapped 200\n",
