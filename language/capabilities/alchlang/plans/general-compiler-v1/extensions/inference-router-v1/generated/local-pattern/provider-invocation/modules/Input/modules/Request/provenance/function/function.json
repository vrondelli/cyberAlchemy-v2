{
  "schemas": {
    "Message": {
      "role": {
        "type": "string",
        "pattern": "^(system|user|assistant)$"
      },
      "content": {
        "type": "string",
        "max": 32768
      }
    },
    "Input": {
      "messages": {
        "type": "list",
        "items": "Message",
        "max": 100
      },
      "stream": {
        "type": "boolean",
        "optional": true
      },
      "remote_model": {
        "type": "identifier",
        "max": 128
      },
      "max_output_tokens": {
        "type": "integer",
        "min": 1,
        "max": 1000000
      }
    },
    "Output": {
      "status": {
        "type": "string",
        "const": "mapped"
      },
      "messages": {
        "type": "list",
        "items": "Message",
        "max": 100
      },
      "model": {
        "type": "identifier",
        "max": 128
      },
      "max_tokens": {
        "type": "integer",
        "min": 1,
        "max": 1000000
      },
      "stream": {
        "type": "boolean"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "Mapper",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/internal/provider-request",
    "input": "Input",
    "output": "Output",
    "authEnv": "INFERENCE_INTERNAL_TOKEN",
    "maxBytes": 65536,
    "timeout": 5000,
    "errorStatus": 422,
    "statuses": {
      "mapped": 200
    },
    "errors": {},
    "result": "Map"
  },
  "portability": "node-rust-v1"
}
