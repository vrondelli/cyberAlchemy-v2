{
  "schemas": {
    "Input": {
      "answer": {
        "type": "string",
        "max": 32768
      },
      "stop_reason": {
        "type": "string",
        "pattern": "^(stop|length|content_filter|unknown)$"
      },
      "prompt_tokens": {
        "type": "integer",
        "optional": true,
        "nullable": true,
        "min": 0,
        "max": 1000000000
      },
      "completion_tokens": {
        "type": "integer",
        "optional": true,
        "nullable": true,
        "min": 0,
        "max": 1000000000
      }
    },
    "Output": {
      "status": {
        "type": "string",
        "const": "mapped"
      },
      "text": {
        "type": "string",
        "max": 32768
      },
      "finish_reason": {
        "type": "string",
        "pattern": "^(stop|length|content_filter|unknown)$"
      },
      "input_tokens": {
        "type": "integer",
        "optional": true,
        "nullable": true,
        "min": 0,
        "max": 1000000000
      },
      "output_tokens": {
        "type": "integer",
        "optional": true,
        "nullable": true,
        "min": 0,
        "max": 1000000000
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "Mapper",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/internal/provider-response",
    "input": "Input",
    "output": "Output",
    "authEnv": "INFERENCE_INTERNAL_TOKEN",
    "maxBytes": 65536,
    "timeout": 5000,
    "errorStatus": 422,
    "statuses": {
      "mapped": 200
    },
    "errors": {},
    "result": "Map"
  },
  "portability": "node-rust-v1"
}
