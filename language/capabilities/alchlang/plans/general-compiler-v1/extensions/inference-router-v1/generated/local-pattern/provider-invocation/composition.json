  "steps": [
    {
      "id": "Checked",
      "kind": "local",
      "module": "Input",
      "args": "input",
      "error": "INVALID_INPUT"
    },
    {
      "id": "Selected",
      "kind": "local",
      "module": "Selector",
      "args": {
        "request": "Checked.value.request",
        "catalog": "Checked.value.catalog"
      },
      "error": "INVALID_ROUTING_INPUT",
      "accept": "selected",
      "reject": "NO_ELIGIBLE_PROVIDER"
    },
    {
      "id": "Bound",
      "kind": "binding",
      "binding_id": "Selected.binding_id",
      "version": "Selected.binding_version",
      "model": "Selected.model",
      "policy": "Selected.policy_version"
    },
    {
      "id": "Payload",
      "kind": "local",
      "module": "Request",
      "args": {
        "messages": "Checked.value.messages",
        "remote_model": "Bound.remote_model",
        "max_output_tokens": "Checked.value.request.max_output_tokens",
        "stream": "Checked.value.request.stream"
      },
      "error": "INVALID_INPUT"
    },
    {
      "id": "Exchange",
      "kind": "http",
      "binding": "Bound",
      "body": "Payload",
      "omit": [
        "status"
      ],
      "output": "Response.input",
      "stream": "Checked.value.request.stream",
      "identity": {
        "request_id": "Checked.value.request.request_id",
        "model": "Bound.model"
      }
    },
    {
      "id": "Mapped",
      "kind": "local",
      "module": "Response",
      "args": "Exchange",
      "error": "INVALID_PROVIDER_RESPONSE"
    },
    {
      "id": "Complete",
      "kind": "local",
      "module": "Completion",
      "args": {
        "request_id": "Checked.value.request.request_id",
        "model": "Bound.model",
        "result": "Mapped"
      },
      "error": "INVALID_PROVIDER_RESPONSE"
    }
  ],
  "output": "Complete.value"
