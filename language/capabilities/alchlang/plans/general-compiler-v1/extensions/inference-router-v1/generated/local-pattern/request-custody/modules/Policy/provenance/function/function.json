{
  "schemas": {
    "Input": {
      "exists": {
        "type": "boolean"
      },
      "matches": {
        "type": "boolean"
      },
      "pending": {
        "type": "boolean"
      },
      "stream": {
        "type": "boolean"
      },
      "succeeded": {
        "type": "boolean"
      }
    },
    "Output": {
      "status": {
        "type": "string",
        "pattern": "^(execute|conflict|in_progress|stream_not_replayable|replay|previous_failure)$"
      }
    }
  },
  "integrations": {},
  "flows": {},
  "endpoint": {
    "id": "IdempotencyDecision",
    "target": "node-http",
    "runtime": "node>=26.8.1",
    "method": "POST",
    "path": "/internal/idempotency-decision",
    "input": "Input",
    "output": "Output",
    "authEnv": "INFERENCE_INTERNAL_TOKEN",
    "maxBytes": 4096,
    "timeout": 5000,
    "errorStatus": 422,
    "statuses": {
      "execute": 200,
      "replay": 200,
      "conflict": 409,
      "in_progress": 409,
      "stream_not_replayable": 409,
      "previous_failure": 409
    },
    "errors": {},
    "result": "Decide"
  },
  "portability": "node-rust-v1"
}
