{
  "schema_version": "domainspec.node/v1",
  "node_id": "summarize-order",
  "feature_id": "typed-commerce",
  "kind": "Mapping",
  "body": {
    "description": "Copy identity and amount into a complete summary with standard risk band.",
    "source": "typed-commerce:order",
    "target": "typed-commerce:order-summary",
    "typed_contract": {
      "schema_version": "domainspec.typed-mapping/v1",
      "ontology_mapping": "ALCH-COMMERCE-SUMMARIZE-ORDER",
      "source": "typed-commerce:order",
      "target": "typed-commerce:order-summary",
      "fields": [
        {
          "target": "summary_id",
          "source": "order_id",
          "default": null
        },
        {
          "target": "total",
          "source": "amount",
          "default": null
        },
        {
          "target": "risk_band",
          "source": null,
          "default": {
            "type": "String",
            "value": "standard"
          }
        }
      ],
      "total": true
    }
  }
}
