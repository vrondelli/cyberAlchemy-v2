{
  "schema_version": "domainspec.node/v1",
  "node_id": "fee-policy",
  "feature_id": "typed-commerce",
  "kind": "Policy",
  "body": {
    "description": "Select ApplyFee when amount exceeds 100; otherwise select KeepAmount without invoking either.",
    "strategies": [
      "apply-fee",
      "keep-amount"
    ],
    "typed_contract": {
      "schema_version": "domainspec.typed-policy/v1",
      "ontology_policy": "ALCH-COMMERCE-FEE-POLICY",
      "inputs": [
        {
          "name": "amount",
          "type": {
            "kind": "scalar",
            "name": "UInt64"
          }
        }
      ],
      "cases": [
        {
          "target": "typed-commerce:apply-fee",
          "when": {
            "op": "gt",
            "left": {
              "kind": "parameter",
              "name": "amount"
            },
            "right": {
              "kind": "literal",
              "type": "UInt64",
              "value": 100
            }
          }
        }
      ],
      "default_target": "typed-commerce:keep-amount"
    }
  }
}
