{
  "schema_version": "domainspec.node/v1",
  "node_id": "open-orders",
  "feature_id": "typed-commerce",
  "kind": "Query",
  "body": {
    "description": "Select the two largest open orders, preserving input order for ties, and project identity and amount.",
    "reads": [
      "typed-commerce:order"
    ],
    "typed_contract": {
      "schema_version": "domainspec.typed-query/v1",
      "ontology_query": "ALCH-COMMERCE-OPEN-ORDERS",
      "source": "typed-commerce:order",
      "inputs": [],
      "filter": {
        "op": "eq",
        "left": {
          "kind": "field",
          "name": "status"
        },
        "right": {
          "kind": "literal",
          "type": "String",
          "value": "open"
        }
      },
      "projection": [
        "order_id",
        "amount"
      ],
      "order_by": {
        "field": "amount",
        "direction": "desc"
      },
      "limit": 2
    }
  }
}
