{
  "schema_version": "domainspec.node/v1",
  "node_id": "order-to-message",
  "feature_id": "delivery-example",
  "kind": "Mapping",
  "body": {
    "description": "Copy orderId to messageId and default currency to GBP; require the full declared target.",
    "source": "delivery-example:order",
    "target": "delivery-example:message",
    "typed_contract": {
      "schema_version": "domainspec.typed-mapping/v1",
      "ontology_mapping": "ALCH-EXAMPLE-ORDER-TO-MESSAGE",
      "source": "delivery-example:order",
      "target": "delivery-example:message",
      "fields": [
        {
          "target": "message_id",
          "source": "order_id",
          "default": null
        },
        {
          "target": "currency",
          "source": null,
          "default": {
            "type": "String",
            "value": "GBP"
          }
        }
      ],
      "total": true
    }
  }
}
