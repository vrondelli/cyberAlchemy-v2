{
  "schema_version": "domainspec.node/v1",
  "node_id": "choose-delivery-fee",
  "feature_id": "delivery-example",
  "kind": "Policy",
  "body": {
    "description": "Prefer the express target when urgent, otherwise priority when priority, otherwise standard; never execute the selection.",
    "strategies": [
      "express-fee",
      "priority-fee",
      "standard-fee"
    ],
    "typed_contract": {
      "schema_version": "domainspec.typed-policy/v1",
      "ontology_policy": "ALCH-EXAMPLE-CHOOSE-FEE",
      "inputs": [
        {
          "name": "urgent",
          "type": {
            "kind": "scalar",
            "name": "Bool"
          }
        },
        {
          "name": "priority",
          "type": {
            "kind": "scalar",
            "name": "Bool"
          }
        }
      ],
      "cases": [
        {
          "target": "delivery-example:express-fee",
          "when": {
            "op": "eq",
            "left": {
              "kind": "parameter",
              "name": "urgent"
            },
            "right": {
              "kind": "literal",
              "type": "Bool",
              "value": true
            }
          }
        },
        {
          "target": "delivery-example:priority-fee",
          "when": {
            "op": "eq",
            "left": {
              "kind": "parameter",
              "name": "priority"
            },
            "right": {
              "kind": "literal",
              "type": "Bool",
              "value": true
            }
          }
        }
      ],
      "default_target": "delivery-example:standard-fee"
    }
  }
}
