{
  "name": "@cyberalchemy/domainspec-cli-candidate",
  "version": "0.4.0-candidate.0",
  "description": "Development workspace for the split AlchLang core and optional runtime packages.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1"
  },
  "bin": {
    "domainspec": "dist/cli.js",
    "alchlang": "dist/core-cli.js",
    "alchlang-rust": "dist/rust-cli.js",
    "alchlang-local-host": "dist/local-host-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "bootstrap:rust": "../../../../../../tools/toolchain/run cargo fetch --locked --manifest-path src/event-templates/rust-runtime/Cargo.toml",
    "build:registry": "node scripts/run-toolchain.mjs tsx src/cli.ts registry build --config ../extensions/generatable-operation-patterns-v1/registry/registry-compiler.config.json",
    "test": "node scripts/run-toolchain.mjs tsx --test test/*.test.ts",
    "typecheck": "node scripts/run-toolchain.mjs tsc --noEmit",
    "build": "node scripts/run-toolchain.mjs tsc -p tsconfig.build.json && node scripts/copy-event-templates.mjs",
    "pack:local": "node -e \"require('node:fs').mkdirSync('package-artifacts/0.4.0-candidate.0',{recursive:true})\" && npm pack --pack-destination package-artifacts/0.4.0-candidate.0",
    "pack:release": "npm run build && node scripts/package-release.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@domainspec-v2/cli": "1.0.0"
  },
  "peerDependenciesMeta": {
    "@domainspec-v2/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
