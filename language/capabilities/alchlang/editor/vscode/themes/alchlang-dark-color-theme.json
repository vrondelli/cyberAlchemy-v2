{
  "$schema": "vscode://schemas/color-theme",
  "name": "AlchLang Monokai Dimmed",
  "type": "dark",
  "include": "./monokai-dimmed-base-color-theme.json",
  "tokenColors": [
    {
      "name": "AlchLang comments",
      "scope": "comment.line.number-sign.alch",
      "settings": {"foreground": "#8C8D8B", "fontStyle": "italic"}
    },
    {
      "name": "AlchLang strings",
      "scope": ["string.quoted.double.alch", "punctuation.definition.string.begin.alch", "punctuation.definition.string.end.alch", "constant.character.escape.alch"],
      "settings": {"foreground": "#8E9A3A"}
    },
    {
      "name": "AlchLang declarations and modifiers",
      "scope": ["storage.type.declaration.alch", "storage.modifier.array.alch", "storage.modifier.field.alch"],
      "settings": {"foreground": "#7D7DDD"}
    },
    {
      "name": "AlchLang control keywords",
      "scope": ["keyword.control.header.alch", "keyword.control.import.alch", "keyword.control.directive.alch", "keyword.control.quantifier.alch"],
      "settings": {"foreground": "#B77A48"}
    },
    {
      "name": "AlchLang clause properties",
      "scope": ["keyword.other.clause.alch", "keyword.other.environment.alch", "keyword.other.diagnostic.alch"],
      "settings": {"foreground": "#B77A48"}
    },
    {
      "name": "AlchLang reference keywords",
      "scope": "keyword.other.reference.alch",
      "settings": {"foreground": "#7189A3"}
    },
    {
      "name": "AlchLang reference operands",
      "scope": "entity.name.type.reference.alch",
      "settings": {"foreground": "#C76A70"}
    },
    {
      "name": "AlchLang type and namespace names",
      "scope": ["entity.name.type.alch", "entity.name.type.rule.alch", "entity.name.namespace.alch", "support.type.primitive.alch"],
      "settings": {"foreground": "#5BA9B8"}
    },
    {
      "name": "AlchLang callable names",
      "scope": ["entity.name.function.alch", "support.function.alch"],
      "settings": {"foreground": "#B09A4C"}
    },
    {
      "name": "AlchLang properties and variables",
      "scope": ["variable.other.property.alch", "variable.other.member.alch", "variable.other.readwrite.alch", "variable.other.constant.alch"],
      "settings": {"foreground": "#7189A3"}
    },
    {
      "name": "AlchLang symbolic constants",
      "scope": ["constant.other.symbol.alch", "constant.language.status.alch"],
      "settings": {"foreground": "#7D7DDD"}
    },
    {
      "name": "AlchLang language constants",
      "scope": ["constant.language.boolean.alch", "constant.language.null.alch"],
      "settings": {"foreground": "#9A78D0"}
    },
    {
      "name": "AlchLang numbers",
      "scope": "constant.numeric.alch",
      "settings": {"foreground": "#8FA887"}
    },
    {
      "name": "AlchLang operators",
      "scope": ["keyword.operator.arrow.alch", "keyword.operator.comparison.alch", "keyword.operator.arithmetic.alch", "keyword.operator.assignment.alch", "keyword.operator.logical.alch"],
      "settings": {"foreground": "#9FA29F"}
    },
    {
      "name": "AlchLang punctuation",
      "scope": ["punctuation.separator.alch", "punctuation.separator.key-value.alch", "punctuation.section.alch"],
      "settings": {"foreground": "#8C8D8B"}
    }
  ]
}
