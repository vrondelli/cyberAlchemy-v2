{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\"", "notIn": ["string", "comment"]}
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_-]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:[A-Za-z][A-Za-z0-9_-]*\\s+)?[A-Za-z][A-Za-z0-9_-]*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\S"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:[A-Za-z][A-Za-z0-9_-]*\\s+)?[A-Za-z][A-Za-z0-9_-]*:\\s*(?:#.*)?$",
      "action": {"indent": "indent"}
    }
  ]
}
