{
  "name": "alchlang-language-support",
  "displayName": "AlchLang Language Support",
  "description": "Syntax highlighting, configurable colors, Monokai Dimmed and light color layers, editing rules, and file icons for AlchLang source.",
  "version": "0.3.8",
  "private": true,
  "publisher": "cyberalchemy-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onCommand:alchlang.configureColors"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "alch",
    "alchlang",
    "domainspec"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "package:vsix": "npx --yes @vscode/vsce@3.9.2 package --out alchlang-language-support-0.3.8.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "alchlang.configureColors",
        "title": "Configure Colors",
        "category": "AlchLang"
      }
    ],
    "languages": [
      {
        "id": "alchlang",
        "aliases": [
          "AlchLang",
          "alch"
        ],
        "extensions": [
          ".alch"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/alch-light.svg",
          "dark": "./icons/alch-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "alchlang",
        "scopeName": "source.alch",
        "path": "./syntaxes/alch.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "id": "alchlang-dark",
        "label": "AlchLang Monokai Dimmed",
        "uiTheme": "vs-dark",
        "path": "./themes/alchlang-dark-color-theme.json"
      },
      {
        "id": "alchlang-light",
        "label": "AlchLang Light",
        "uiTheme": "vs",
        "path": "./themes/alchlang-light-color-theme.json"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
