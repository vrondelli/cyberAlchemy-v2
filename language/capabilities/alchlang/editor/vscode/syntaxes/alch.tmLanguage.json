{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AlchLang",
  "scopeName": "source.alch",
  "fileTypes": ["alch"],
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#declarations"},
    {"include": "#headers"},
    {"include": "#fieldDeclarations"},
    {"include": "#references"},
    {"include": "#expressions"},
    {"include": "#symbolicValues"},
    {"include": "#directives"},
    {"include": "#functionCalls"},
    {"include": "#memberPaths"},
    {"include": "#clauseKeywords"},
    {"include": "#types"},
    {"include": "#constants"},
    {"include": "#numbers"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {"patterns": [
      {"name": "comment.line.number-sign.alch", "match": "#.*$"}
    ]},
    "strings": {"patterns": [
      {
        "name": "string.quoted.double.alch",
        "begin": "\"",
        "beginCaptures": {"0": {"name": "punctuation.definition.string.begin.alch"}},
        "end": "\"",
        "endCaptures": {"0": {"name": "punctuation.definition.string.end.alch"}},
        "patterns": [
          {"name": "constant.character.escape.alch", "match": "\\\\(?:[\\\\\"bfnrt/]|u[0-9A-Fa-f]{4})"}
        ]
      }
    ]},
    "declarations": {"patterns": [
      {
        "name": "meta.declaration.type.alch",
        "match": "^(api|capability|channel|configuration|consumer|delivery|deployment|endpoint|entity|enum|event|example|integration|interface|module|observation|ontology|producer|projection|result|schema|states|transition|transport|transport-failure|value-object)\\s+([A-Za-z][A-Za-z0-9_-]*)(?=\\s*:|\\s|$)",
        "captures": {
          "1": {"name": "storage.type.declaration.alch"},
          "2": {"name": "entity.name.type.alch"}
        }
      },
      {
        "name": "meta.declaration.callable.alch",
        "match": "^(action|calculation|command|entry|execution|flow|function|mapping|migration|operation|query|route|service|workflow)\\s+([A-Za-z][A-Za-z0-9_-]*)(?=\\s*:|\\s|$)",
        "captures": {
          "1": {"name": "storage.type.declaration.alch"},
          "2": {"name": "entity.name.function.alch"}
        }
      },
      {
        "name": "meta.declaration.governance.alch",
        "match": "^(axiom|boundary|effect|governed-by|intrinsic|invariant|permission|policy|rule|validation)\\s+([A-Za-z][A-Za-z0-9_-]*)(?=\\s*:|\\s|$)",
        "captures": {
          "1": {"name": "storage.type.declaration.alch"},
          "2": {"name": "entity.name.type.rule.alch"}
        }
      }
    ]},
    "headers": {"patterns": [
      {
        "name": "meta.header.namespace.alch",
        "match": "^(domain|owner)\\s+([A-Za-z][A-Za-z0-9_.:-]*)",
        "captures": {
          "1": {"name": "keyword.control.header.alch"},
          "2": {"name": "entity.name.namespace.alch"}
        }
      },
      {
        "name": "meta.header.profile.alch",
        "match": "^(profile|logic|runtime|target|assembly)\\s+([^\\s#]+)",
        "captures": {
          "1": {"name": "keyword.control.header.alch"},
          "2": {"name": "constant.other.symbol.alch"}
        }
      },
      {
        "name": "meta.header.import.alch",
        "match": "^(import)\\s+([A-Za-z][A-Za-z0-9_.:-]*)\\s+(from)\\s+(\"(?:\\\\.|[^\"\\\\])*\")",
        "captures": {
          "1": {"name": "keyword.control.import.alch"},
          "2": {"name": "entity.name.type.alch"},
          "3": {"name": "keyword.control.import.alch"},
          "4": {"name": "string.quoted.double.alch"}
        }
      }
    ]},
    "fieldDeclarations": {"patterns": [
      {
        "name": "meta.field.primitive.alch",
        "match": "^(\\s+)([A-Za-z_][A-Za-z0-9_-]*)(\\s*:)(\\s*)(string-array|identifier|string|boolean|integer|decimal|timestamp|uuid|record|array|uint64|UInt64|String|Bool)(\\[\\])?",
        "captures": {
          "2": {"name": "variable.other.property.alch"},
          "3": {"name": "punctuation.separator.key-value.alch"},
          "5": {"name": "support.type.primitive.alch"},
          "6": {"name": "storage.modifier.array.alch"}
        }
      },
      {
        "name": "meta.field.named-type.alch",
        "match": "^(\\s+)([A-Za-z_][A-Za-z0-9_-]*)(\\s*:)(\\s*)([A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*)(\\[\\])?",
        "captures": {
          "2": {"name": "variable.other.property.alch"},
          "3": {"name": "punctuation.separator.key-value.alch"},
          "5": {"name": "entity.name.type.alch"},
          "6": {"name": "storage.modifier.array.alch"}
        }
      },
      {
        "name": "meta.field.name.alch",
        "match": "^(\\s+)([A-Za-z_][A-Za-z0-9_-]*)(?=\\s*:)",
        "captures": {"2": {"name": "variable.other.property.alch"}}
      },
      {
        "name": "storage.modifier.field.alch",
        "match": "(?<![A-Za-z0-9_-])(required|optional|nullable|const|min|max|pattern)(?![A-Za-z0-9_-])"
      }
    ]},
    "references": {"patterns": [
      {
        "name": "meta.reference.alch",
        "match": "^(\\s+)(action|boundary|channel|consumer|delivery|event|flow|function|grounded-by|integration|intrinsic|invariant|mapper|operation|permission|policy|producer|query|source|subject|target|transport)\\s+([A-Za-z][A-Za-z0-9_.:-]*)",
        "captures": {
          "2": {"name": "keyword.other.reference.alch"},
          "3": {"name": "entity.name.type.reference.alch"}
        }
      }
    ]},
    "expressions": {"patterns": [
      {
        "name": "meta.expression.alch",
        "begin": "^(\\s+)(where|condition|require|expression|select|provided)\\b",
        "beginCaptures": {"2": {"name": "keyword.control.directive.alch"}},
        "end": "$",
        "patterns": [
          {"include": "#strings"},
          {"include": "#functionCalls"},
          {"include": "#memberPaths"},
          {
            "name": "meta.quantifier.alch",
            "match": "(?<![A-Za-z0-9_-])(forall|exists)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)(?![A-Za-z0-9_-])",
            "captures": {
              "1": {"name": "keyword.control.quantifier.alch"},
              "2": {"name": "variable.other.readwrite.alch"},
              "3": {"name": "keyword.control.quantifier.alch"}
            }
          },
          {"name": "keyword.operator.logical.alch", "match": "(?<![A-Za-z0-9_-])(and|or|not|in|else|yield|exactly_one)(?![A-Za-z0-9_-])"},
          {"include": "#constants"},
          {"include": "#numbers"},
          {"include": "#operators"},
          {"name": "variable.other.readwrite.alch", "match": "(?<![A-Za-z0-9_.-])[A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_.-])"}
        ]
      }
    ]},
    "symbolicValues": {"patterns": [
      {
        "name": "meta.symbolic-value.alch",
        "match": "^(\\s+)(acknowledgement|backoff|binding|claim|commitment|evidence|guarantee|isolation|kind|method|on-failure|payment|property|protocol|provisioner|purpose|response|role|rounding|runtime|scope|selector|semantics|state|status|terminal|unknown-outcome)\\s+([^\\s#]+)",
        "captures": {
          "2": {"name": "keyword.other.clause.alch"},
          "3": {"name": "constant.other.symbol.alch"}
        }
      },
      {
        "name": "meta.environment-reference.alch",
        "match": "^(\\s+)(auth-env|secret-env|url-env)\\s+([A-Za-z_][A-Za-z0-9_]*)",
        "captures": {
          "2": {"name": "keyword.other.environment.alch"},
          "3": {"name": "variable.other.constant.alch"}
        }
      },
      {
        "name": "meta.diagnostic-code.alch",
        "match": "^(\\s+)(error|violation|accept|reject)\\s+([A-Za-z][A-Za-z0-9_.:-]*)",
        "captures": {
          "2": {"name": "keyword.other.diagnostic.alch"},
          "3": {"name": "constant.other.symbol.alch"}
        }
      }
    ]},
    "directives": {"patterns": [
      {
        "name": "meta.binding.alch",
        "match": "^(\\s+)(let|bind)\\s+([A-Za-z_][A-Za-z0-9_]*)",
        "captures": {
          "2": {"name": "keyword.control.directive.alch"},
          "3": {"name": "variable.other.readwrite.alch"}
        }
      },
      {
        "name": "meta.directive.alch",
        "match": "^(\\s+)(accept|actor|args|backoff|bind|cardinality-budget|condition|constitution-ref|dead-letter|delivery|envelope|error|events|exclude|expected|id|key|let|listen|max-receives|max-response-bytes|message-id|module|mount|omit|on|provisioner|reject|require|response|retention-seconds|rules|select|timeout-ms|timeout-seconds|visibility-seconds|violation)(?=\\s|$)",
        "captures": {"2": {"name": "keyword.control.directive.alch"}}
      }
    ]},
    "functionCalls": {"patterns": [
      {
        "name": "meta.function-call.alch",
        "match": "(?<![A-Za-z0-9_-])([A-Za-z_][A-Za-z0-9_-]*)(?=\\s*\\()",
        "captures": {"1": {"name": "support.function.alch"}}
      }
    ]},
    "memberPaths": {"patterns": [
      {"name": "variable.other.member.alch", "match": "(?<![A-Za-z0-9_.-])[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+(?![A-Za-z0-9_.-])"}
    ]},
    "clauseKeywords": {"patterns": [
      {
        "name": "keyword.other.clause.alch",
        "match": "(?<![A-Za-z0-9_-])(action|adopted|alias|allow|auth|authority-effect|boundary|boundary-kind|case|claim|commitment|compatibility|compensations|consumer|contract|default|deadline-ms|decisions|direction|effect|effects|emits|entry|equality|every|exposes|expression|failure-continuation|field|fields|fixtures|from|guarantee|guard|grounded-by|identity|import|initial|input|inputs|integration|intrinsic|invariant|kind|language|limit|mapping|matches|max-attempts|max-bytes|max-concurrent|meaning|method|model|on-failure|ontology|operation|order|output|owner|path|payload|permission|performs|policy|predicate|producer|project|property|protocol|query|reads|reason|request|requires|result|retry|role|rounding|route|schema|selector|source|state-change|statement|status|steps|strategies|subject|target|to|total|transition|transport|type|using|value|version|when|where|writes)(?![A-Za-z0-9_-])"
      }
    ]},
    "types": {"patterns": [
      {"name": "support.type.primitive.alch", "match": "(?<![A-Za-z0-9_-])(string-array|identifier|string|boolean|integer|decimal|timestamp|uuid|record|array|uint64|UInt64|String|Bool)(?![A-Za-z0-9_-])"}
    ]},
    "constants": {"patterns": [
      {"name": "constant.language.boolean.alch", "match": "(?<![A-Za-z0-9_-])(true|false|yes|no)(?![A-Za-z0-9_-])"},
      {"name": "constant.language.null.alch", "match": "(?<![A-Za-z0-9_-])(null|none|absent)(?![A-Za-z0-9_-])"},
      {"name": "constant.language.status.alch", "match": "(?<![A-Za-z0-9_-])(candidate|available|blocked|pending|pass|fail|stable|required|optional|positive|negative|ascending|descending|asc|desc)(?![A-Za-z0-9_-])"}
    ]},
    "numbers": {"patterns": [
      {"name": "constant.numeric.alch", "match": "(?<![A-Za-z0-9_-])-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![A-Za-z0-9_-])"}
    ]},
    "operators": {"patterns": [
      {"name": "keyword.operator.arrow.alch", "match": "<->|->|<-|=>"},
      {"name": "keyword.operator.comparison.alch", "match": "==|!=|<=|>=|<|>"},
      {"name": "keyword.operator.arithmetic.alch", "match": "[+*/-]"},
      {"name": "keyword.operator.assignment.alch", "match": "="},
      {"name": "punctuation.separator.alch", "match": "[,.:]"},
      {"name": "punctuation.section.alch", "match": "[(){}\\[\\]]"}
    ]}
  }
}
