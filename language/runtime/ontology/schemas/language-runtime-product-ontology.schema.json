{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/language-runtime-product-ontology/v1",
  "title": "CyberAlchemy Language Runtime Product Ontology",
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]*$"},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "selector"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-LRPO-[A-Z0-9-]+$"},
        "selector": {"$ref": "#/$defs/text"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "ontology_id", "title", "ontology_type", "branches", "bridge", "materialization", "package_root", "package_owner", "business_meaning_owner", "system_design_owner", "visibility", "candidate_status", "implementation_state", "authority_effect", "source_registry", "definition_registry", "node_registry", "relation_registry", "residue_registry", "business_view", "system_view", "bridge_view", "schema_path", "schema_amendment", "validator_path", "blocked_outputs"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-profile/v1"},
        "ontology_id": {"const": "cav2.language-runtime-product-bridge"},
        "title": {"$ref": "#/$defs/text"},
        "ontology_type": {"const": "business-system-bridge"},
        "branches": {"const": ["business", "system"]},
        "bridge": {"const": "business-system"},
        "materialization": {"const": "package-required"},
        "package_root": {"const": "cyberAlchemy-v2/language/runtime/ontology"},
        "package_owner": {"const": "CyberAlchemy v2 Language Project owner"},
        "business_meaning_owner": {"$ref": "#/$defs/text"},
        "system_design_owner": {"$ref": "#/$defs/text"},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "implementation_state": {"const": "not-implemented"},
        "authority_effect": {"const": "none"},
        "source_registry": {"const": "sources.json"},
        "definition_registry": {"const": "definitions.json"},
        "node_registry": {"const": "nodes.json"},
        "relation_registry": {"const": "relations.json"},
        "residue_registry": {"const": "residue.json"},
        "business_view": {"const": "views/business-view.json"},
        "system_view": {"const": "views/system-view.json"},
        "bridge_view": {"const": "views/bridge-view.json"},
        "schema_path": {"const": "schemas/language-runtime-product-ontology.schema.json"},
        "schema_amendment": {"const": "schema-amendment.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "blocked_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "sources"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-sources/v1"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "branch", "path", "sha256", "posture", "owner_route"],
            "properties": {
              "id": {"type": "string", "pattern": "^SRC-LRPO-[A-Z0-9-]+$"},
              "branch": {"enum": ["business", "system", "mixed"]},
              "path": {"$ref": "#/$defs/text"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "posture": {"$ref": "#/$defs/text"},
              "owner_route": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    },
    "candidateDefinitionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "authority_posture", "definitions"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-candidate-definitions/v1"},
        "authority_posture": {"const": "ontology-candidate-not-canonical"},
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "term", "subject_ref", "definition_status", "authority_kind_ref", "formal_voice", "plain_language_voice", "domain_context_voice", "operational_interpretation", "forbidden_collapse", "source_refs", "owner_route", "authority_effect"],
            "properties": {
              "id": {"type": "string", "pattern": "^LRPO-DEF-[A-Z0-9-]+$"},
              "term": {"$ref": "#/$defs/text"},
              "subject_ref": {"$ref": "#/$defs/id"},
              "definition_status": {"const": "candidate"},
              "authority_kind_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^kind[.][a-z_]+$"}]},
              "formal_voice": {
                "type": "object",
                "additionalProperties": false,
                "required": ["normative_candidate", "expression", "symbols", "boundary_conditions"],
                "properties": {
                  "normative_candidate": {"$ref": "#/$defs/text"},
                  "expression": {"$ref": "#/$defs/text"},
                  "symbols": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["symbol", "meaning"],
                      "properties": {
                        "symbol": {"$ref": "#/$defs/text"},
                        "meaning": {"$ref": "#/$defs/text"}
                      }
                    }
                  },
                  "boundary_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
                }
              },
              "plain_language_voice": {"$ref": "#/$defs/text"},
              "domain_context_voice": {"$ref": "#/$defs/text"},
              "operational_interpretation": {"$ref": "#/$defs/text"},
              "forbidden_collapse": {"$ref": "#/$defs/text"},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
              "owner_route": {"$ref": "#/$defs/text"},
              "authority_effect": {"const": "none"}
            }
          }
        }
      }
    },
    "nodeRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "nodes"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-nodes/v1"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "branch", "role", "plain_language", "claim", "scope", "source_refs", "owner_route", "candidate_status", "evidence_confidence", "commitment_confidence", "implementation_state", "authority_effect", "forbidden_collapse", "open_questions"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "label": {"$ref": "#/$defs/text"},
              "branch": {"enum": ["business", "system"]},
              "role": {"enum": ["project", "goal", "language", "discipline", "capability", "product_output", "business_rule", "business_concept", "outcome", "example", "component", "aggregate", "state_store", "store", "record", "view_model", "engine", "interface", "artifact", "emitter"]},
              "plain_language": {"$ref": "#/$defs/text"},
              "claim": {"$ref": "#/$defs/text"},
              "scope": {"$ref": "#/$defs/text"},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
              "owner_route": {"$ref": "#/$defs/text"},
              "candidate_status": {"enum": ["projected", "candidate", "blocked", "deferred"]},
              "evidence_confidence": {"enum": ["low", "medium", "high"]},
              "commitment_confidence": {"enum": ["low", "conditional", "committed"]},
              "implementation_state": {"enum": ["not-applicable", "not-implemented"]},
              "authority_effect": {"const": "none"},
              "forbidden_collapse": {"$ref": "#/$defs/text"},
              "open_questions": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "relationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "relation_vocabulary", "relations"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-relations/v1"},
        "relation_vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "source_branches", "target_branches", "plain_language", "forbidden_collapse"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
              "label": {"$ref": "#/$defs/text"},
              "source_branches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["business", "system"]}},
              "target_branches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["business", "system"]}},
              "plain_language": {"$ref": "#/$defs/text"},
              "forbidden_collapse": {"$ref": "#/$defs/text"}
            }
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "source", "target", "direction", "owner_route", "source_refs", "authority_effect", "claim_limit"],
            "properties": {
              "id": {"type": "string", "pattern": "^LRPO-REL-[A-Z0-9-]+$"},
              "type": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
              "source": {"$ref": "#/$defs/id"},
              "target": {"$ref": "#/$defs/id"},
              "direction": {"const": "directed"},
              "owner_route": {"$ref": "#/$defs/text"},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
              "authority_effect": {"const": "none"},
              "claim_limit": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    },
    "residueRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "residue"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-residue/v1"},
        "residue": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "description", "status", "owner_route", "next_action", "subject_refs", "source_refs"],
            "properties": {
              "id": {"type": "string", "pattern": "^LRPO-RES-[A-Z0-9-]+$"},
              "label": {"$ref": "#/$defs/text"},
              "description": {"$ref": "#/$defs/text"},
              "status": {"enum": ["open", "deferred", "blocked"]},
              "owner_route": {"$ref": "#/$defs/text"},
              "next_action": {"$ref": "#/$defs/text"},
              "subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "view_id", "view_kind", "node_refs", "relation_refs", "claim_ceiling"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-view/v1"},
        "view_id": {"type": "string", "pattern": "^cav2[.]language-runtime-product-bridge[.](business|system|bridge)$"},
        "view_kind": {"enum": ["business", "system", "bridge"]},
        "node_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "relation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^LRPO-REL-[A-Z0-9-]+$"}},
        "claim_ceiling": {"$ref": "#/$defs/text"}
      }
    },
    "schemaAmendmentWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "amendment_id", "status", "owner_route", "scope", "reason", "changed_shape", "compatibility_effect", "witness", "rollout_route", "rollback_route", "authority_effect"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-schema-amendment/v1"},
        "amendment_id": {"const": "LRPO-SCHEMA-AMEND-001"},
        "status": {"const": "applied-candidate"},
        "owner_route": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "changed_shape": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "compatibility_effect": {"$ref": "#/$defs/text"},
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validator_path", "required_checks"],
          "properties": {
            "validator_path": {"const": "scripts/validate.py"},
            "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
          }
        },
        "rollout_route": {"$ref": "#/$defs/text"},
        "rollback_route": {"$ref": "#/$defs/text"},
        "authority_effect": {"const": "none"}
      }
    },
    "validationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "validated_at", "status", "package_root", "ontology_type", "branches", "bridge", "visibility", "authority_effect", "counts", "material_digest", "checks", "errors", "claim_ceiling"],
      "properties": {
        "schema_ref": {"$ref": "#/$defs/text"},
        "schema_version": {"const": "cav2-language-runtime-product-ontology-validation/v1"},
        "validated_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["PASS", "BLOCK"]},
        "package_root": {"const": "cyberAlchemy-v2/language/runtime/ontology"},
        "ontology_type": {"const": "business-system-bridge"},
        "branches": {"const": ["business", "system"]},
        "bridge": {"const": "business-system"},
        "visibility": {"const": "private"},
        "authority_effect": {"const": "none"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "business_nodes", "system_nodes", "relation_types", "business_relations", "system_relations", "bridge_relations", "views", "residue"],
          "properties": {
            "sources": {"type": "integer", "minimum": 0},
            "candidate_definitions": {"type": "integer", "minimum": 0},
            "business_nodes": {"type": "integer", "minimum": 0},
            "system_nodes": {"type": "integer", "minimum": 0},
            "relation_types": {"type": "integer", "minimum": 0},
            "business_relations": {"type": "integer", "minimum": 0},
            "system_relations": {"type": "integer", "minimum": 0},
            "bridge_relations": {"type": "integer", "minimum": 0},
            "views": {"type": "integer", "minimum": 0},
            "residue": {"type": "integer", "minimum": 0}
          }
        },
        "material_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checks": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "claim_ceiling": {"$ref": "#/$defs/text"}
      }
    }
  }
}
