import Std
import AuthGeneratedSubject
import AuthGeneratedRustIR

namespace AuthRustFragment
open AuthGeneratedSubject
open AuthGeneratedRustIR

-- Fixed interpretation of the closed Rust fragment extracted from the
-- selected generated module. This is not generated by the Rust extractor and
-- does not call the DomainSpec AST interpreter or its executable projection.
inductive Value where
  | string (value : String)
  | bool (value : Bool)
  | context (value : Context)
  | request (value : Request)
  | command (value : Command)
  | permission (value : Permission)
  | evidence (value : Evidence)
  | route (value : RouteBinding)
  | evidenceRows (value : List Evidence)
  | routeRows (value : List RouteBinding)
  | decision (value : String)

structure Env where
  context : Context
  evidence : Option Evidence := none
  binding : Option RouteBinding := none

def root (env : Env) (name : String) : Option Value :=
  if name == "context" then some (.context env.context)
  else if name == "evidence" then env.evidence.map Value.evidence
  else if name == "binding" then env.binding.map Value.route
  else none

def field : Value → String → Option Value
  | .context c, "request" => some (.request c.request)
  | .context c, "candidate_command" => some (.command c.candidate)
  | .context c, "resolved_authentication_evidence" => some (.evidenceRows c.authRows)
  | .context c, "resolved_route_bindings" => some (.routeRows c.routeRows)
  | .request r, "request_id" => some (.string r.requestId)
  | .request r, "authentication_evidence_ref" => some (.string r.authenticationEvidenceRef)
  | .request r, "route_id" => some (.string r.routeId)
  | .command c, "request_id" => some (.string c.requestId)
  | .command c, "session_id" => some (.string c.sessionId)
  | .command c, "required_permission" => some (.permission c.permission)
  | .command c, "scope_evidence_ref" => some (.string c.scopeEvidenceRef)
  | .permission p, "resource" => some (.string p.resource)
  | .permission p, "action" => some (.string p.action)
  | .permission p, "scope" => some (.string p.scope)
  | .evidence e, "evidence_ref" => some (.string e.evidenceRef)
  | .evidence e, "session_id" => some (.string e.sessionId)
  | .evidence e, "trusted" => some (.bool e.trusted)
  | .route r, "route_id" => some (.string r.routeId)
  | .route r, "required_permission" => some (.permission r.permission)
  | .route r, "scope_evidence_ref" => some (.string r.scopeEvidenceRef)
  | .route r, "complete" => some (.bool r.complete)
  | _, _ => none

def fields : Value → List String → Option Value
  | value, [] => some value
  | value, name :: rest => do
      let next ← field value name
      fields next rest

def scalarEq : Value → Value → Option Bool
  | .string a, .string b => some (a == b)
  | .bool a, .bool b => some (a == b)
  | _, _ => none

def anyM {α : Type} (rows : List α) (predicate : α → Option Bool) : Option Bool :=
  match rows with
  | [] => some false
  | row :: rest => do
      let result ← predicate row
      if result then some true else anyM rest predicate

-- Fuel measures expression and Rule-call depth, not resolver multiplicity.
-- `and` and `exists` stop after decisive true/false values, as in the
-- selected Rust bodies. Errors remain Option.none, never false by default.
def eval : Nat → Env → Expr → Option Value
  | 0, _, _ => none
  | fuel + 1, env, expression =>
    match expression with
    | .path name names => do
        let value ← root env name
        fields value names
    | .string value => some (.string value)
    | .bool value => some (.bool value)
    | .eq left right => do
        let a ← eval fuel env left
        let b ← eval fuel env right
        let equal ← scalarEq a b
        some (.bool equal)
    | .not inner => do
        let value ← eval fuel env inner
        match value with
        | .bool b => some (.bool (!b))
        | _ => none
    | .and left right => do
        let value ← eval fuel env left
        match value with
        | .bool false => some (.bool false)
        | .bool true => eval fuel env right
        | _ => none
    | .exactlyOne binder collection where_ => do
        let rows ← eval fuel env collection
        if binder == "evidence" then
          match rows with
          | .evidenceRows entries => do
              let values ← entries.mapM (fun row => eval fuel { env with evidence := some row } where_)
              let booleans ← values.mapM (fun value => match value with | .bool b => some b | _ => none)
              some (.bool ((booleans.filter id).length == 1))
          | _ => none
        else if binder == "binding" then
          match rows with
          | .routeRows entries => do
              let values ← entries.mapM (fun row => eval fuel { env with binding := some row } where_)
              let booleans ← values.mapM (fun value => match value with | .bool b => some b | _ => none)
              some (.bool ((booleans.filter id).length == 1))
          | _ => none
        else none
    | .exists binder collection where_ => do
        let rows ← eval fuel env collection
        if binder == "evidence" then
          match rows with
          | .evidenceRows entries =>
              (anyM entries (fun row => do
                let value ← eval fuel { env with evidence := some row } where_
                match value with | .bool b => some b | _ => none)).map Value.bool
          | _ => none
        else if binder == "binding" then
          match rows with
          | .routeRows entries =>
              (anyM entries (fun row => do
                let value ← eval fuel { env with binding := some row } where_
                match value with | .bool b => some b | _ => none)).map Value.bool
          | _ => none
        else none
    | .ruleRef name argument => do
        let value ← eval fuel env argument
        match value with
        | .context context =>
            let next : Env := { context }
            if name == "candidate_command_provenance" then eval fuel next candidateCommandProvenance
            else if name == "unique_complete_route_binding" then eval fuel next uniqueCompleteRouteBinding
            else if name == "unique_trusted_authentication_evidence" then eval fuel next uniqueTrustedAuthenticationEvidence
            else if name == "command_boundary_admissible" then eval fuel next commandBoundaryAdmissible
            else none
        | _ => none
    | .variant name =>
        if name == "Ready" || name == "Deny" then some (.decision name) else none
    | .branch guard success failure => do
        let value ← eval fuel env guard
        match value with
        | .bool true => eval fuel env success
        | .bool false => eval fuel env failure
        | _ => none

def rule (fuel : Nat) (name : String) (context : Context) : Option Bool := do
  let expression ←
    if name == "candidate_command_provenance" then some candidateCommandProvenance
    else if name == "unique_complete_route_binding" then some uniqueCompleteRouteBinding
    else if name == "unique_trusted_authentication_evidence" then some uniqueTrustedAuthenticationEvidence
    else if name == "command_boundary_admissible" then some commandBoundaryAdmissible
    else none
  let value ← eval fuel { context } expression
  match value with
  | .bool b => some b
  | _ => none

def operation (context : Context) : Option String := do
  let value ← eval 64 { context } admitAuthorizationCommand
  match value with
  | .decision result => some result
  | _ => none

end AuthRustFragment
