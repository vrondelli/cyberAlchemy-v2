{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/lean-theorem-execution-policy/v1-candidate",
  "title": "Auth Lean Theorem Execution Policy Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "owner", "policy_state", "provider_route", "lean_profile_admission_ref", "lean_environment_ref", "source_controls", "execution_controls", "limits", "result_algebra", "network", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "auth-foundation.lean-theorem-execution-policy/v1-candidate"},
    "policy_id": {"const": "auth-foundation.exact-session-role-permission.lean-theorem/v1-candidate"},
    "owner": {"const": "EVF"},
    "policy_state": {"const": "candidate-awaiting-evf-admission"},
    "provider_route": {"const": "evf-theorem"},
    "lean_profile_admission_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "lean_environment_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "source_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imports", "options", "sorry", "unsafe", "new_axioms"],
      "properties": {
        "imports": {"type": "array", "maxItems": 0},
        "options": {"type": "array", "maxItems": 0},
        "sorry": {"const": "forbidden"},
        "unsafe": {"const": "forbidden"},
        "new_axioms": {"const": "forbidden"}
      }
    },
    "execution_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_directory", "environment_allowlist", "deterministic_repetitions", "proof_receipt_required"],
      "properties": {
        "working_directory": {"const": "."},
        "environment_allowlist": {"type": "array", "maxItems": 0},
        "deterministic_repetitions": {"const": 2},
        "proof_receipt_required": {"const": true}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "memory_ceiling_bytes", "max_output_bytes"],
      "properties": {
        "timeout_ms": {"const": 120000},
        "memory_ceiling_bytes": {"const": 1073741824},
        "max_output_bytes": {"const": 1048576}
      }
    },
    "result_algebra": {
      "type": "array",
      "const": ["checked", "rejected", "unsupported", "indeterminate", "timeout", "stale", "failed"]
    },
    "network": {"const": "forbidden"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"const": "theorem-execution-policy-candidate-only-no-execution-authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    }
  }
}
