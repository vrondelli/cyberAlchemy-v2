{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formal-claim-identity-inputs/v2",
  "title": "Auth Foundation FormalClaim Identity Inputs v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "claim_version",
    "owner",
    "business_meaning_ref",
    "definition_binding_ref",
    "formal_language_profile",
    "formal_signature",
    "canonical_proposition",
    "assumptions",
    "claim_ceiling",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "auth-foundation.formal-claim-identity-inputs/v2"},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_version": {"const": "4-definitions-bound-candidate"},
    "owner": {"const": "projects/auth-foundation/formalization"},
    "business_meaning_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "definition_binding_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "formal_language_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "registry_ref"],
      "properties": {
        "profile_id": {"const": "fol-core"},
        "version": {"const": "1-candidate"},
        "registry_ref": {"$ref": "#/$defs/exactCurrentRef"}
      }
    },
    "formal_signature": {"$ref": "#/$defs/formalSignature"},
    "canonical_proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation_media_type", "representation_digest", "semantic_identity", "semantic_identity_digest"],
      "properties": {
        "representation_media_type": {"const": "text/vnd.domainspec.fol-core"},
        "representation_digest": {"$ref": "#/$defs/sha256"},
        "semantic_identity": {"type": "string", "minLength": 1},
        "semantic_identity_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    },
    "sort": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/$defs/text"}}},
    "function": {"type": "object", "additionalProperties": false, "required": ["name", "parameter_sorts", "result_sort"], "properties": {"name": {"$ref": "#/$defs/text"}, "parameter_sorts": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "result_sort": {"$ref": "#/$defs/text"}}},
    "predicate": {"type": "object", "additionalProperties": false, "required": ["name", "parameter_sorts"], "properties": {"name": {"$ref": "#/$defs/text"}, "parameter_sorts": {"type": "array", "items": {"$ref": "#/$defs/text"}}}},
    "constant": {"type": "object", "additionalProperties": false, "required": ["name", "sort"], "properties": {"name": {"$ref": "#/$defs/text"}, "sort": {"$ref": "#/$defs/text"}}},
    "formalSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sorts", "functions", "predicates", "constants"],
      "properties": {
        "sorts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sort"}},
        "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
        "predicates": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
        "constants": {"type": "array", "items": {"$ref": "#/$defs/constant"}}
      }
    }
  }
}
