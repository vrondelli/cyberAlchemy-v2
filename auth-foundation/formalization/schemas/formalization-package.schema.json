{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formalization-package/v1",
  "title": "Auth Foundation Formalization Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "package_id",
    "title",
    "status",
    "phase",
    "visibility",
    "authority_effect",
    "package_owner",
    "package_root",
    "ontology_type",
    "branch",
    "canonical_format",
    "human_views_are_canonical",
    "source_identities",
    "artifacts",
    "package_boundary",
    "claim_ceiling",
    "next_step"
  ],
  "properties": {
    "schema_version": {
      "const": "auth-foundation.formalization-package/v1"
    },
    "schema_ref": {
      "const": "schemas/formalization-package.schema.json"
    },
    "package_id": {
      "const": "auth-foundation.formalization"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate"
    },
    "phase": {
      "const": "proof-and-evidence"
    },
    "visibility": {
      "const": "private"
    },
    "authority_effect": {
      "const": "none"
    },
    "package_owner": {
      "const": "projects/auth-foundation"
    },
    "package_root": {
      "const": "projects/auth-foundation/formalization"
    },
    "ontology_type": {
      "const": "business-domain"
    },
    "branch": {
      "const": "business"
    },
    "canonical_format": {
      "const": "application/json"
    },
    "human_views_are_canonical": {
      "const": false
    },
    "source_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceIdentity"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "package_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {
          "$ref": "#/$defs/stringSet"
        },
        "out_of_scope": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "not-started"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "size", "role"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "model-origin",
            "conversation-evidence",
        "current-system-comparison",
        "formalization-strategy",
        "formalization-contract",
        "owner-decision"
      ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "schema_ref", "status", "canonical"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["ontology", "schema", "case-artifact", "human-index", "validator"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_ref": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["candidate", "supporting"]
        },
        "canonical": {
          "type": "boolean"
        }
      }
    }
  }
}
