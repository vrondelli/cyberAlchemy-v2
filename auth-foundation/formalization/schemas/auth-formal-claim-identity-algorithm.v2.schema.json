{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formal-claim-identity-algorithm/v2",
  "title": "Auth Foundation FormalClaim Identity Algorithm v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm_id", "version", "owner", "digest_algorithm", "representation_digest_rule", "semantic_identity_digest_rule", "identity_inputs_digest_rule", "identity_inputs_schema_ref", "identity_components", "interpretation_boundary", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "auth-foundation.formal-claim-identity-algorithm/v2"},
    "algorithm_id": {"const": "auth-foundation.formal-claim-identity/v2"},
    "version": {"const": "2"},
    "owner": {"const": "projects/auth-foundation/formalization"},
    "digest_algorithm": {"const": "sha256"},
    "representation_digest_rule": {"const": "sha256 of the exact UTF-8 canonical proposition string with no added newline"},
    "semantic_identity_digest_rule": {"const": "sha256 of the exact UTF-8 semantic identity string with no added newline"},
    "identity_inputs_digest_rule": {"const": "sha256 of the exact bytes of the schema-valid CLAIM-IDENTITY-INPUTS.v2-definitions-bound.json artifact"},
    "identity_inputs_schema_ref": {"const": "projects/auth-foundation/formalization/schemas/auth-formal-claim-identity-inputs.v2.schema.json"},
    "identity_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "interpretation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_model_is_identity_input", "join_stage"],
      "properties": {
        "interpretation_model_is_identity_input": {"const": false},
        "join_stage": {"const": "external-evaluation-context"}
      }
    },
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
