{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formalization-authoring-trace/v1",
  "title": "Auth Foundation Formalization Authoring Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authoring_capability", "mode", "target_owner", "target_case", "techniques", "distill", "identity_denominator", "result", "next_route", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "auth-foundation.formalization-authoring-trace/v1"},
    "authoring_capability": {"const": "invoke"},
    "mode": {"const": "define"},
    "target_owner": {"const": "projects/auth-foundation/formalization"},
    "target_case": {"const": "AF-EXACT-SESSION-ROLE-PERMISSION-001"},
    "techniques": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["owner_boundary_check", "artifact_contract_bridge", "validation_loop", "concrete_path_evidence"]}},
    "distill": {"type": "object", "additionalProperties": false, "required": ["status", "rationale"], "properties": {"status": {"const": "not-required"}, "rationale": {"type": "string", "minLength": 1}}},
    "identity_denominator": {"type": "object", "additionalProperties": false, "required": ["status", "rationale"], "properties": {"status": {"const": "not-applicable"}, "rationale": {"type": "string", "minLength": 1}}},
    "result": {"const": "candidate-authored-pending-owner-review"},
    "next_route": {"const": "auth-foundation-owner-semantic-review"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
