{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formal-claim-definition-binding-rebind/v1-candidate",
  "title": "Auth Foundation FormalClaim Definition Binding Rebind Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "claim_identity", "predecessor_binding_ref", "definition_authority_ref", "definition_closure", "semantic_delta", "resolution_policy", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "auth-foundation.formal-claim-definition-binding-rebind/v1-candidate"},
    "binding_id": {"type": "string", "minLength": 1},
    "claim_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_version"],
      "properties": {
        "claim_id": {"const": "FormalClaim:auth-foundation.exact-session-role-permission"},
        "claim_version": {"const": "5-lean-candidate"}
      }
    },
    "predecessor_binding_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "definition_authority_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "definition_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_ids", "canonicalization", "digest_algorithm", "digest"],
      "properties": {
        "definition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonicalization": {"const": "domainspec-json-keysort-v1"},
        "digest_algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "semantic_delta": {"const": "none; exact rebind of the predecessor definition graph to the Lean candidate identity"},
    "resolution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_source", "name_inference", "missing_definition", "transitive_dependencies", "definition_body_authority"],
      "properties": {
        "edge_source": {"const": "predecessor_binding_ref"},
        "name_inference": {"const": "forbidden"},
        "missing_definition": {"const": "block"},
        "transitive_dependencies": {"const": "required"},
        "definition_body_authority": {"const": "definition_authority_ref"}
      }
    },
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    }
  }
}
