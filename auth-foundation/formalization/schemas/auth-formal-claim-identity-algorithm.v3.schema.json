{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formal-claim-identity-algorithm/v3",
  "title": "Auth Foundation Lean FormalClaim Identity Algorithm v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm_id",
    "version",
    "owner",
    "digest_algorithm",
    "representation_digest_rule",
    "semantic_identity_digest_rule",
    "identity_inputs_digest_rule",
    "identity_inputs_schema_ref",
    "identity_components",
    "interpretation_boundary",
    "authority_effect",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "auth-foundation.formal-claim-identity-algorithm/v3"},
    "algorithm_id": {"const": "auth-foundation.formal-claim-identity/v3"},
    "version": {"const": "3"},
    "owner": {"const": "projects/auth-foundation/formalization"},
    "digest_algorithm": {"const": "sha256"},
    "representation_digest_rule": {"type": "string", "minLength": 1},
    "semantic_identity_digest_rule": {"type": "string", "minLength": 1},
    "identity_inputs_digest_rule": {"type": "string", "minLength": 1},
    "identity_inputs_schema_ref": {"const": "projects/auth-foundation/formalization/schemas/auth-formal-claim-identity-inputs.v3.schema.json"},
    "identity_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "interpretation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_model_is_identity_input", "join_stage"],
      "properties": {
        "interpretation_model_is_identity_input": {"const": false},
        "join_stage": {"const": "external-evaluation-context"}
      }
    },
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
