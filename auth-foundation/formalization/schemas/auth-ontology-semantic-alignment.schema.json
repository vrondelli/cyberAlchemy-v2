{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/ontology-semantic-alignment/v1-candidate",
  "title": "Auth Foundation Ontology Semantic Alignment Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alignment_id", "status", "base_ontology_ref", "semantic_authority_ref", "overrides", "deprecated_expressions", "application_policy", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "auth-foundation.ontology-semantic-alignment/v1-candidate"},
    "alignment_id": {"const": "AF-ONTOLOGY-ALIGNMENT-EXACT-SESSION-RBAC-001"},
    "status": {"const": "candidate"},
    "base_ontology_ref": {"$ref": "#/$defs/exactRef"},
    "semantic_authority_ref": {"$ref": "#/$defs/exactRef"},
    "overrides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/override"}},
    "deprecated_expressions": {"$ref": "#/$defs/textSet"},
    "application_policy": {"type": "object", "additionalProperties": false, "required": ["base_bytes_immutable", "authority_source", "consumer_rule", "name_inference"], "properties": {"base_bytes_immutable": {"const": true}, "authority_source": {"const": "semantic_authority_ref"}, "consumer_rule": {"const": "apply-all-overrides-before-current-semantic-use"}, "name_inference": {"const": "forbidden"}}},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "current"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}, "current": {"const": true}}},
    "override": {"type": "object", "additionalProperties": false, "required": ["target_ref", "authority_definition_refs", "replacement_formal", "replacement_plain_language", "boundary"], "properties": {"target_ref": {"$ref": "#/$defs/text"}, "authority_definition_refs": {"$ref": "#/$defs/textSet"}, "replacement_formal": {"$ref": "#/$defs/text"}, "replacement_plain_language": {"$ref": "#/$defs/text"}, "boundary": {"$ref": "#/$defs/text"}}}
  }
}
