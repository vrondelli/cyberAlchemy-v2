{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/lean-environment/v1-candidate",
  "title": "Auth Foundation Lean Environment Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_id", "owner", "toolchain_ref", "toolchain", "imports", "options", "typecheck_command", "status", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "auth-foundation.lean-environment/v1-candidate"},
    "environment_id": {"const": "auth-foundation.lean4.v4.32.0.core-only"},
    "owner": {"const": "projects/auth-foundation/formalization"},
    "toolchain_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "lean_version", "commit", "platform"],
      "properties": {
        "channel": {"const": "leanprover/lean4:v4.32.0"},
        "lean_version": {"const": "4.32.0"},
        "commit": {"const": "8c9756b28d64dab099da31a4c09229a9e6a2ef35"},
        "platform": {"const": "x86_64-unknown-linux-gnu"}
      }
    },
    "imports": {"type": "array", "maxItems": 0},
    "options": {"type": "array", "maxItems": 0},
    "typecheck_command": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
    "status": {"const": "candidate"},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    }
  }
}
