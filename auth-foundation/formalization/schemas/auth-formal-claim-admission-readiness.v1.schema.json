{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formal-claim-admission-readiness/v1-candidate",
  "title": "Auth Foundation FormalClaim Admission Readiness Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_ref", "technical_validation_ref", "selected_dependencies", "checks", "outcome", "blockers", "next_route", "authority_effect", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "auth-foundation.formal-claim-admission-readiness/v1-candidate"},
    "candidate_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "technical_validation_ref": {"$ref": "#/$defs/exactCurrentRef"},
    "selected_dependencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependency"}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "outcome": {"enum": ["ready-for-owner-decision", "not_evaluable", "blocked"]},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "next_route": {"type": "string", "minLength": 1},
    "authority_effect": {"const": "none"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exactCurrentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "current"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "current": {"const": true}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "artifact_ref", "selectors", "role"],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 1},
        "artifact_ref": {"$ref": "#/$defs/exactCurrentRef"},
        "selectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "detail"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "block", "not_evaluable", "not_required"]},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "cause", "unblock_action", "owner"],
      "properties": {
        "blocker_id": {"type": "string", "minLength": 1},
        "cause": {"type": "string", "minLength": 1},
        "unblock_action": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    }
  }
}
