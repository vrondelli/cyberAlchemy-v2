{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/schemas/auth-foundation/formalization-ontology/v1",
  "title": "Auth Foundation Formalization Ontology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "ontology_id",
    "label",
    "ontology_type",
    "branch",
    "status",
    "visibility",
    "authority_effect",
    "package_ref",
    "model_origin",
    "model_delta",
    "scope",
    "nodes",
    "relations",
    "invariants",
    "residue",
    "forbidden_collapses"
  ],
  "properties": {
    "schema_version": {
      "const": "auth-foundation.formalization-ontology/v1"
    },
    "schema_ref": {
      "const": "../schemas/formalization-ontology.schema.json"
    },
    "ontology_id": {
      "const": "auth-foundation.authorization-business-domain"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "ontology_type": {
      "const": "business-domain"
    },
    "branch": {
      "const": "business"
    },
    "status": {
      "const": "candidate"
    },
    "visibility": {
      "const": "private"
    },
    "authority_effect": {
      "const": "none"
    },
    "package_ref": {
      "const": "../formalization-package.json"
    },
    "model_origin": {
      "$ref": "#/$defs/modelOrigin"
    },
    "model_delta": {
      "$ref": "#/$defs/modelDelta"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "residue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/residue"
      }
    },
    "forbidden_collapses": {
      "$ref": "#/$defs/stringSet"
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modelOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_role", "source_refs", "adoption_effect"],
      "properties": {
        "model_id": {
          "const": "cyberalchemy-v2.ontology-model"
        },
        "model_role": {
          "const": "structural-and-semantic-starting-model"
        },
        "source_refs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cav2.node-model",
              "cav2.relation-model",
              "cav2.package-model"
            ]
          }
        },
        "adoption_effect": {
          "const": "candidate-local-copy-only"
        }
      }
    },
    "modelDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted_contract_fields",
        "domain_extensions",
        "deferred_items",
        "forbidden_inferences"
      ],
      "properties": {
        "adopted_contract_fields": {
          "$ref": "#/$defs/stringSet"
        },
        "domain_extensions": {
          "$ref": "#/$defs/stringSet"
        },
        "deferred_items": {
          "$ref": "#/$defs/stringSet"
        },
        "forbidden_inferences": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {
          "$ref": "#/$defs/stringSet"
        },
        "out_of_scope": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal", "plain_language", "domain_context"],
      "properties": {
        "formal": {
          "type": "string",
          "minLength": 1
        },
        "plain_language": {
          "type": "string",
          "minLength": 1
        },
        "domain_context": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "meaning"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_confidence", "commitment_confidence"],
      "properties": {
        "evidence_confidence": {
          "enum": ["unknown", "low", "medium", "high"]
        },
        "commitment_confidence": {
          "enum": ["unknown", "low", "medium", "high"]
        }
      }
    },
    "challengeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_response",
        "valid_challenge_modes",
        "contradiction_edges",
        "validation_edges",
        "owner_route",
        "resolution_gate",
        "blocking_questions",
        "challenge_residue_route"
      ],
      "properties": {
        "challenge_response": {
          "type": "string",
          "minLength": 1
        },
        "valid_challenge_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["evidence", "contradiction", "owner_review"]
          }
        },
        "contradiction_edges": {
          "$ref": "#/$defs/stringSet"
        },
        "validation_edges": {
          "$ref": "#/$defs/stringSet"
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "resolution_gate": {
          "type": "string",
          "minLength": 1
        },
        "blocking_questions": {
          "$ref": "#/$defs/stringSet"
        },
        "challenge_residue_route": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "label",
        "concept_role",
        "definition",
        "fields",
        "source_refs",
        "owner_route",
        "candidate_status",
        "confidence",
        "challenge_contract",
        "residue",
        "forbidden_collapse"
      ],
      "properties": {
        "concept_id": {
          "type": "string",
          "pattern": "^auth-foundation\\.[a-z0-9.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "concept_role": {
          "enum": [
            "actor",
            "entity",
            "value_object",
            "behavior",
            "business_rule",
            "outcome"
          ]
        },
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "source_refs": {
          "$ref": "#/$defs/stringSet"
        },
        "owner_route": {
          "const": "projects/auth-foundation/formalization"
        },
        "candidate_status": {
          "enum": ["candidate", "reviewed-candidate", "deferred", "blocked", "projected"]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "challenge_contract": {
          "$ref": "#/$defs/challengeContract"
        },
        "residue": {
          "$ref": "#/$defs/stringSet"
        },
        "forbidden_collapse": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "relation_type",
        "source_concept",
        "target_concept",
        "direction",
        "owner_route",
        "evidence_refs",
        "authority_effect",
        "value_effect",
        "cycle_policy",
        "forbidden_collapse"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "pattern": "^auth-foundation\\.rel\\.[a-z0-9.-]+$"
        },
        "relation_type": {
          "type": "string",
          "minLength": 1
        },
        "source_concept": {
          "type": "string",
          "minLength": 1
        },
        "target_concept": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["directed", "symmetric", "view-only"]
        },
        "owner_route": {
          "const": "projects/auth-foundation/formalization"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringSet"
        },
        "authority_effect": {
          "enum": ["none", "staging", "projection", "owner-decision", "blocked"]
        },
        "value_effect": {
          "enum": ["value-free", "value-constraining", "unknown"]
        },
        "cycle_policy": {
          "enum": ["acyclic", "cycle-permitted", "unknown"]
        },
        "forbidden_collapse": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "statement", "formal", "status", "failure_result"],
      "properties": {
        "invariant_id": {
          "type": "string",
          "pattern": "^AF-I[0-9]{2}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "formal": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate"
        },
        "failure_result": {
          "enum": ["DENY", "AUTHENTICATION_FAILURE", "MODEL_BLOCK"]
        }
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residue_id", "description", "owner_route", "status", "blocks"],
      "properties": {
        "residue_id": {
          "type": "string",
          "pattern": "^AF-R[0-9]{2}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner_route": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "open"
        },
        "blocks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
