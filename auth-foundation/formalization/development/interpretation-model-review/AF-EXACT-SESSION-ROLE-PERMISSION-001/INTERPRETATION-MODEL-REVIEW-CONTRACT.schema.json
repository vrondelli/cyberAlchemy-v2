{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainspec.dev/auth-foundation/schemas/interpretation-model-review-contract/v1-candidate",
  "title": "Auth Foundation InterpretationModel Review Contract Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_contract_id",
    "title",
    "status",
    "owner",
    "authority_effect",
    "purpose",
    "authoring_provenance",
    "source_closure",
    "review_subject",
    "reviewer_contract",
    "run_time_bindings",
    "traceability_requirements",
    "business_rule_invariant",
    "definition_coverage",
    "mandatory_checks",
    "verdict_model",
    "required_review_output",
    "next_route_after_review",
    "unresolved_questions",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "auth-foundation.interpretation-model-review-contract/v1-candidate"
    },
    "review_contract_id": {
      "const": "AF-IMR-EXACT-SESSION-ROLE-PERMISSION-V2"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "const": "candidate"
    },
    "owner": {
      "const": "projects/auth-foundation/formalization"
    },
    "authority_effect": {
      "const": "none"
    },
    "purpose": {
      "$ref": "#/$defs/text"
    },
    "authoring_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_capability",
        "mode",
        "target_artifact_type",
        "target_owner",
        "phase_status",
        "dispatch_techniques",
        "full_dispatch_required",
        "distill",
        "identity_denominator_validation"
      ],
      "properties": {
        "observed_capability": {
          "const": "invoke"
        },
        "mode": {
          "const": "define"
        },
        "target_artifact_type": {
          "const": "interpretation-model-review-contract"
        },
        "target_owner": {
          "const": "projects/auth-foundation/formalization"
        },
        "phase_status": {
          "const": "candidate-authored"
        },
        "dispatch_techniques": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "owner_boundary_check",
              "artifact_contract_bridge",
              "validation_loop",
              "concrete_path_evidence"
            ]
          }
        },
        "full_dispatch_required": {
          "const": false
        },
        "distill": {
          "$ref": "#/$defs/notRequiredDecision"
        },
        "identity_denominator_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not-applicable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "source_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_business_meaning",
        "business_meaning_owner_decision",
        "stale_predecessor_interpretation",
        "interpretation_model_schema",
        "business_meaning_acceptance_review",
        "business_meaning_validation"
      ],
      "properties": {
        "accepted_business_meaning": {
          "$ref": "#/$defs/sourceBinding"
        },
        "business_meaning_owner_decision": {
          "$ref": "#/$defs/sourceBinding"
        },
        "stale_predecessor_interpretation": {
          "$ref": "#/$defs/sourceBinding"
        },
        "interpretation_model_schema": {
          "$ref": "#/$defs/sourceBinding"
        },
        "business_meaning_acceptance_review": {
          "$ref": "#/$defs/sourceBinding"
        },
        "business_meaning_validation": {
          "$ref": "#/$defs/sourceBinding"
        }
      }
    },
    "review_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "candidate_ref",
        "required_business_meaning_ref",
        "required_model_id",
        "required_version_rule",
        "required_initial_statuses",
        "forbidden_initial_statuses",
        "required_acceptance_status",
        "required_authority_effect"
      ],
      "properties": {
        "artifact_kind": {
          "const": "InterpretationModel successor"
        },
        "candidate_ref": {
          "type": "null"
        },
        "required_business_meaning_ref": {
          "const": "source_closure.accepted_business_meaning"
        },
        "required_model_id": {
          "const": "InterpretationModel:auth-foundation.exact-session-role-permission"
        },
        "required_version_rule": {
          "$ref": "#/$defs/text"
        },
        "required_initial_statuses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "draft",
              "reviewed"
            ]
          }
        },
        "forbidden_initial_statuses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "accepted",
              "superseded"
            ]
          }
        },
        "required_acceptance_status": {
          "const": "not-requested"
        },
        "required_authority_effect": {
          "const": "none"
        }
      }
    },
    "reviewer_contract": {
      "$ref": "#/$defs/reviewerContract"
    },
    "run_time_bindings": {
      "$ref": "#/$defs/runTimeBindings"
    },
    "traceability_requirements": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "business_rule_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_speech",
        "formal_reading",
        "required_properties"
      ],
      "properties": {
        "business_speech": {
          "$ref": "#/$defs/text"
        },
        "formal_reading": {
          "$ref": "#/$defs/text"
        },
        "required_properties": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "definition_coverage": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/definitionCoverage"
      }
    },
    "mandatory_checks": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "$ref": "#/$defs/mandatoryCheck"
      }
    },
    "verdict_model": {
      "$ref": "#/$defs/verdictModel"
    },
    "required_review_output": {
      "$ref": "#/$defs/requiredReviewOutput"
    },
    "next_route_after_review": {
      "$ref": "#/$defs/nextRoute"
    },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 0
    },
    "claim_ceiling": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notRequiredDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "not-required"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "required_status": {
          "$ref": "#/$defs/text"
        },
        "required_version": {
          "$ref": "#/$defs/text"
        },
        "required_option": {
          "$ref": "#/$defs/text"
        },
        "use": {
          "$ref": "#/$defs/text"
        },
        "forbidden_use": {
          "$ref": "#/$defs/text"
        },
        "required_result": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "reviewerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence",
        "exactness",
        "source_rule",
        "conflict_rule",
        "collect_all",
        "authority_boundary"
      ],
      "properties": {
        "independence": {
          "$ref": "#/$defs/text"
        },
        "exactness": {
          "$ref": "#/$defs/text"
        },
        "source_rule": {
          "$ref": "#/$defs/text"
        },
        "conflict_rule": {
          "$ref": "#/$defs/text"
        },
        "collect_all": {
          "const": true
        },
        "authority_boundary": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "runTimeBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_case_package",
        "candidate",
        "schema_compatibility"
      ],
      "properties": {
        "current_case_package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "authoring_baseline_sha256",
            "authoring_baseline_size_bytes",
            "review_requirement"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/text"
            },
            "authoring_baseline_sha256": {
              "$ref": "#/$defs/digest"
            },
            "authoring_baseline_size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "review_requirement": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "candidate": {
          "$ref": "#/$defs/text"
        },
        "schema_compatibility": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "definitionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "term",
        "required_interpretation_role",
        "review_question"
      ],
      "properties": {
        "definition_id": {
          "enum": [
            "AF-DEF-AUTHORIZATION-REQUEST",
            "AF-DEF-SESSION",
            "AF-DEF-ROLE",
            "AF-DEF-PERMISSION",
            "AF-DEF-RESOURCE",
            "AF-DEF-ACTION",
            "AF-DEF-SCOPE",
            "AF-DEF-REQUIRED-PERMISSION",
            "AF-DEF-DECISION-TIME",
            "AF-DEF-AUTHORIZATION-REVISION",
            "AF-DEF-RESOLVED-SESSION",
            "AF-DEF-RESOLVED-ACTIVE-ROLE",
            "AF-DEF-TRUSTED-SCOPE-EVIDENCE",
            "AF-DEF-COMPLETE-AUTHORITATIVE-ROLE-RELATION",
            "AF-DEF-SESSION-CURRENT",
            "AF-DEF-AUTHORIZATION-ADMISSIBLE",
            "AF-DEF-EXACT-ACTIVE-ROLE-GRANT",
            "AF-DEF-AUTHORIZATION-DECISION",
            "AF-DEF-ALLOW",
            "AF-DEF-DENY"
          ]
        },
        "term": {
          "$ref": "#/$defs/text"
        },
        "required_interpretation_role": {
          "$ref": "#/$defs/text"
        },
        "review_question": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "mandatoryCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "pass_condition",
        "failure_result"
      ],
      "properties": {
        "check_id": {
          "pattern": "^AF-IMR-0(0[1-9]|1[0-7])$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "pass_condition": {
          "$ref": "#/$defs/text"
        },
        "failure_result": {
          "const": "BLOCK"
        }
      }
    },
    "verdictModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "FLAG",
        "BLOCK",
        "NOT_EVALUABLE",
        "pass_effect",
        "block_effect",
        "not_evaluable_effect"
      ],
      "properties": {
        "PASS": {
          "$ref": "#/$defs/text"
        },
        "FLAG": {
          "$ref": "#/$defs/text"
        },
        "BLOCK": {
          "$ref": "#/$defs/text"
        },
        "NOT_EVALUABLE": {
          "$ref": "#/$defs/text"
        },
        "pass_effect": {
          "$ref": "#/$defs/text"
        },
        "block_effect": {
          "$ref": "#/$defs/text"
        },
        "not_evaluable_effect": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "requiredReviewOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "required_fields",
        "definition_result_count",
        "mandatory_check_result_count",
        "authority_effect",
        "review_result_claim_ceiling"
      ],
      "properties": {
        "format": {
          "const": "application/json"
        },
        "required_fields": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "enum": [
              "review_id",
              "reviewed_at",
              "reviewer_route",
              "candidate_author_route",
              "review_contract_ref",
              "candidate_exact_ref",
              "source_exact_refs",
              "definition_results",
              "mandatory_check_results",
              "predecessor_delta_results",
              "findings",
              "verdict",
              "next_route",
              "authority_effect",
              "claim_ceiling"
            ]
          }
        },
        "definition_result_count": {
          "const": 20
        },
        "mandatory_check_result_count": {
          "const": 17
        },
        "authority_effect": {
          "const": "none"
        },
        "review_result_claim_ceiling": {
          "const": "Independent evidence about whether one frozen InterpretationModel candidate faithfully interprets the exact accepted BusinessMeaning v2. It does not accept the candidate, admit or identify a FormalClaim, derive obligations, execute providers, join EVF evidence, or establish runtime conformance, security, release, or production readiness."
        }
      }
    },
    "nextRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "FLAG",
        "BLOCK",
        "NOT_EVALUABLE"
      ],
      "properties": {
        "PASS": {
          "$ref": "#/$defs/text"
        },
        "FLAG": {
          "$ref": "#/$defs/text"
        },
        "BLOCK": {
          "$ref": "#/$defs/text"
        },
        "NOT_EVALUABLE": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
