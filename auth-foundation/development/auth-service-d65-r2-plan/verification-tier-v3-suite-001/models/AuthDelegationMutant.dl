.decl tenant(t:symbol)
.decl trustedOrigin(role:symbol, t:symbol)
.decl delegates(parent:symbol, child:symbol)
.decl authority(role:symbol, t:symbol)
.decl violation(role:symbol, t:symbol)
tenant("tenant-a"). tenant("tenant-b").
trustedOrigin("root-a", "tenant-a"). trustedOrigin("root-b", "tenant-b").
delegates("root-a", "team-a"). delegates("team-a", "leaf-a"). delegates("root-b", "leaf-b").
authority(r,t) :- trustedOrigin(r,t).
authority(child,t2) :- delegates(parent,child), authority(parent,t1), tenant(t2).
violation(child,t) :- delegates(parent,child), authority(child,t), !authority(parent,t).
.output authority
.output violation
