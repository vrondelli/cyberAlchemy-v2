{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://domainspec.private/schemas/auth-evf-ontology/v1-candidate","title":"Auth EVF ontology branch document","type":"object","additionalProperties":false,
  "required":["schema_version","ontology_id","branch","authority_effect"],
  "properties":{
    "schema_version":{"type":"string","minLength":1},"ontology_id":{"const":"auth-evf-production-bridge-v1-candidate"},"branch":{"enum":["business","system","bridge"]},"authority_effect":{"const":"none"},
    "nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}},"relations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relation"}}
  },
  "oneOf":[{"required":["nodes"]},{"required":["relations"]}],
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Z][A-Z0-9._-]+$"},
    "node":{"type":"object","additionalProperties":false,"required":["id","label","kind","source_ids","meaning","confidence","authority_effect"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"meaning":{"type":"string","minLength":1},"confidence":{"enum":["low","medium","high"]},"authority_effect":{"const":"none"}}},
    "relation":{"type":"object","additionalProperties":false,"required":["id","from","to","type","source_ids","evidence_mode","authority_effect"],"properties":{"id":{"$ref":"#/$defs/id"},"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"},"type":{"type":"string","minLength":1},"source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"evidence_mode":{"type":"string","minLength":1},"authority_effect":{"const":"none"}}}
  }
}
