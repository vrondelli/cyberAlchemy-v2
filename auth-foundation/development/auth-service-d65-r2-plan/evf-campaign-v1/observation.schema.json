{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"auth-service-evf-observation/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","campaign_id","run_id","case_id","seam","candidate_digest","kind","status","detector","tool_owned","details"],
  "properties":{
    "schema_version":{"const":"auth-service-evf-observation/v1"},
    "campaign_id":{"const":"AUTH-SERVICE-EVF-SEVEN-SEAM-001"},
    "run_id":{"type":"string","minLength":1},
    "case_id":{"type":"string","pattern":"^EVF-"},
    "seam":{"enum":["binding","derivation","lineage","observation","provider","scope","semantic"]},
    "candidate_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "kind":{"enum":["neutral","mutation"]},
    "status":{"enum":["passed","mutation-detected","failed","not-evaluable"]},
    "detector":{"type":"string","minLength":1},
    "tool_owned":{"const":true},
    "details":{"type":"string","minLength":1}
  }
}
