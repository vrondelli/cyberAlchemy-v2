{
  "name": "auth-foundation-authentication-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node src/server.mjs",
    "test": "node --test test/unit.test.mjs",
    "test:live": "LD_LIBRARY_PATH=\"$PWD/.runtime/browser-libs/root/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" node --test --test-concurrency=1 test/live.test.mjs",
    "service": "node scripts/service.mjs",
    "stop": "docker compose --env-file .runtime/compose.env down",
    "build": "bash scripts/build.sh"
  },
  "dependencies": {
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
