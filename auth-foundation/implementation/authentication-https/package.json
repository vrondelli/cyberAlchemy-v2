{
  "name": "auth-foundation-authentication-https",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "NODE_EXTRA_CA_CERTS=\"$PWD/.runtime/tls/ca.crt\" node src/server.mjs",
    "test": "node --test test/unit.test.mjs",
    "test:live": "NODE_EXTRA_CA_CERTS=\"$PWD/.runtime/tls/ca.crt\" LD_LIBRARY_PATH=\"$PWD/.runtime/browser-libs/root/usr/lib/x86_64-linux-gnu\" node --test --test-concurrency=1 test/live.test.mjs",
    "service": "NODE_EXTRA_CA_CERTS=\"$PWD/.runtime/tls/ca.crt\" node scripts/service.mjs",
    "open": "LD_LIBRARY_PATH=\"$PWD/.runtime/browser-libs/root/usr/lib/x86_64-linux-gnu\" node scripts/open-browser.mjs",
    "build": "bash scripts/build.sh",
    "stop": "docker compose --env-file .runtime/compose.env down",
    "test:fresh": "node scripts/test-fresh.mjs"
  },
  "dependencies": {
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
