{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/context.schema.json",
  "title": "CyberAlchemy v2 Context package",
  "$defs": {
    "id": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "text": {"type":"string","minLength":1},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "profile": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","ontology_id","title","ontology_type","ontology_type_selection","branch","materialization","package_root","package_owner","canonical_definition_ref","visibility","ontology_status","runtime_state","authority_effect","source_registry","definition_registry","node_registry","relation_registry","context_instance_glob","residue_registry","schema_path","validator_path","blocked_outputs"],
      "properties":{
        "schema_ref":{"const":"schemas/context.schema.json#/$defs/profile"},"schema_version":{"const":"cav2-context-profile/v1"},"ontology_id":{"const":"cav2.context"},"title":{"$ref":"#/$defs/text"},"ontology_type":{"const":"business-domain"},
        "ontology_type_selection":{"type":"object","additionalProperties":false,"required":["source","confidence","reason"],"properties":{"source":{"const":"inferred"},"confidence":{"const":"high"},"reason":{"$ref":"#/$defs/text"}}},
        "branch":{"const":"business"},"materialization":{"const":"package-required"},"package_root":{"const":"cyberAlchemy-v2/context"},"package_owner":{"$ref":"#/$defs/text"},"canonical_definition_ref":{"const":"CAV2-D66"},"visibility":{"const":"private"},"ontology_status":{"const":"candidate"},"runtime_state":{"const":"not-implemented"},"authority_effect":{"const":"none"},
        "source_registry":{"const":"sources.json"},"definition_registry":{"const":"definitions.json"},"node_registry":{"const":"nodes.json"},"relation_registry":{"const":"relations.json"},"context_instance_glob":{"const":"contexts/*.context.json"},"residue_registry":{"const":"residue.json"},"schema_path":{"const":"schemas/context.schema.json"},"validator_path":{"const":"scripts/validate.py"},"blocked_outputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}
      }
    },
    "source": {"type":"object","additionalProperties":false,"required":["source_id","path","observed_file_sha256","posture","owner_route"],"properties":{"source_id":{"type":"string","pattern":"^SRC-CTX-"},"path":{"$ref":"#/$defs/text"},"observed_file_sha256":{"$ref":"#/$defs/sha256"},"posture":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}}},
    "selection": {"type":"object","additionalProperties":false,"required":["selection_id","source_id","selector_kind","selector","id_field","id_value","selection_sha256"],"properties":{"selection_id":{"type":"string","pattern":"^CTX-SEL-"},"source_id":{"type":"string","pattern":"^SRC-CTX-"},"selector_kind":{"enum":["markdown-heading","json-pointer","json-record"]},"selector":{"$ref":"#/$defs/text"},"id_field":{"type":["string","null"]},"id_value":{"type":["string","null"]},"selection_sha256":{"$ref":"#/$defs/sha256"}}},
    "sourceRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","selection_digest_algorithm","sources","selections"],"properties":{"schema_ref":{"const":"schemas/context.schema.json#/$defs/sourceRegistry"},"schema_version":{"const":"cav2-context-sources/v1"},"selection_digest_algorithm":{"const":"sha256-selected-bytes/v1"},"sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},"selections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/selection"}}}},
    "definitionBinding": {"type":"object","additionalProperties":false,"required":["definition_ref","term","source_selection_ref","authority_status","local_posture","owner_route","forbidden_collapse"],"properties":{"definition_ref":{"const":"CAV2-D66"},"term":{"const":"Context"},"source_selection_ref":{"const":"CTX-SEL-D66"},"authority_status":{"const":"canonical-reference"},"local_posture":{"const":"reference-only"},"owner_route":{"$ref":"#/$defs/text"},"forbidden_collapse":{"$ref":"#/$defs/text"}}},
    "definitionRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","definitions"],"properties":{"schema_ref":{"const":"schemas/context.schema.json#/$defs/definitionRegistry"},"schema_version":{"const":"cav2-context-definitions/v1"},"definitions":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/definitionBinding"}}}},
    "node": {"type":"object","additionalProperties":false,"required":["id","label","role","definition_ref","plain_language","claim","scope","source_refs","owner_route","status","authority_effect","forbidden_collapse"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/text"},"role":{"enum":["product","project","goal","context","bounded_context","capability","business_concept","product_output","policy","business_rule"]},"definition_ref":{"type":["string","null"]},"plain_language":{"$ref":"#/$defs/text"},"claim":{"$ref":"#/$defs/text"},"scope":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CTX-SEL-"}},"owner_route":{"$ref":"#/$defs/text"},"status":{"enum":["canonical-reference","projected","candidate","candidate-instance"]},"authority_effect":{"const":"none"},"forbidden_collapse":{"$ref":"#/$defs/text"}}},
    "nodeRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","nodes"],"properties":{"schema_ref":{"const":"schemas/context.schema.json#/$defs/nodeRegistry"},"schema_version":{"const":"cav2-context-nodes/v1"},"nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}}}},
    "relationType": {"type":"object","additionalProperties":false,"required":["type","source_roles","target_roles","meaning","forbidden_collapse"],"properties":{"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"target_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"meaning":{"$ref":"#/$defs/text"},"forbidden_collapse":{"$ref":"#/$defs/text"}}},
    "relation": {"type":"object","additionalProperties":false,"required":["id","type","source","target","owner_route","source_refs","authority_effect","claim_limit"],"properties":{"id":{"type":"string","pattern":"^CTX-REL-"},"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"owner_route":{"$ref":"#/$defs/text"},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CTX-SEL-"}},"authority_effect":{"const":"none"},"claim_limit":{"$ref":"#/$defs/text"}}},
    "relationRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","relation_vocabulary","relations"],"properties":{"schema_ref":{"const":"schemas/context.schema.json#/$defs/relationRegistry"},"schema_version":{"const":"cav2-context-relations/v1"},"relation_vocabulary":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relationType"}},"relations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relation"}}}},
    "subjectScope": {"type":"object","additionalProperties":false,"required":["included_refs","exclusions"],"properties":{"included_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"exclusions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "revision": {"type":"object","additionalProperties":false,"required":["revision","date","change","owner_route"],"properties":{"revision":{"type":"integer","minimum":1},"date":{"type":"string","format":"date"},"change":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"}}},
    "context": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","context_id","definition_ref","context_kind","product_ref","project_ref","goal_ref","bounded_context_refs","purpose","consumer_refs","intended_uses","subject_scope","source_policy_refs","owner_route","lifecycle_state","revision_history","challenge_route","authority_effect"],
      "properties":{"schema_ref":{"const":"../schemas/context.schema.json#/$defs/context"},"schema_version":{"const":"cav2-context/v1"},"context_id":{"type":"string","pattern":"^CA2-CONTEXT-"},"definition_ref":{"const":"CAV2-D66"},"context_kind":{"enum":["product","project","goal"]},"product_ref":{"$ref":"#/$defs/id"},"project_ref":{"type":["string","null"]},"goal_ref":{"type":["string","null"]},"bounded_context_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"purpose":{"$ref":"#/$defs/text"},"consumer_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"intended_uses":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"subject_scope":{"$ref":"#/$defs/subjectScope"},"source_policy_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"owner_route":{"$ref":"#/$defs/text"},"lifecycle_state":{"enum":["draft","active","superseded","retired"]},"revision_history":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/revision"}},"challenge_route":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}},
      "allOf":[
        {"if":{"properties":{"context_kind":{"const":"product"}}},"then":{"properties":{"project_ref":{"type":"null"},"goal_ref":{"type":"null"}}}},
        {"if":{"properties":{"context_kind":{"const":"project"}}},"then":{"properties":{"project_ref":{"type":"string"},"goal_ref":{"type":"null"}}}},
        {"if":{"properties":{"context_kind":{"const":"goal"}}},"then":{"properties":{"project_ref":{"type":"string"},"goal_ref":{"type":"string"}}}}
      ]
    },
    "residue": {"type":"object","additionalProperties":false,"required":["id","label","description","status","owner_route","next_action","subject_refs","source_refs"],"properties":{"id":{"type":"string","pattern":"^CTX-RES-"},"label":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"status":{"enum":["open","deferred","blocked"]},"owner_route":{"$ref":"#/$defs/text"},"next_action":{"$ref":"#/$defs/text"},"subject_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CTX-SEL-"}}}},
    "residueRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","residue"],"properties":{"schema_ref":{"const":"schemas/context.schema.json#/$defs/residueRegistry"},"schema_version":{"const":"cav2-context-residue/v1"},"residue":{"type":"array","items":{"$ref":"#/$defs/residue"}}}},
    "validationReceipt": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","validated_at","status","package_root","ontology_type","branch","authority_effect","counts","material_digest","checks","warnings","errors","claim_ceiling"],"properties":{"schema_ref":{"const":"schemas/context.schema.json#/$defs/validationReceipt"},"schema_version":{"const":"cav2-context-validation/v1"},"validated_at":{"type":"string","format":"date-time"},"status":{"enum":["PASS","BLOCK"]},"package_root":{"const":"cyberAlchemy-v2/context"},"ontology_type":{"const":"business-domain"},"branch":{"const":"business"},"authority_effect":{"const":"none"},"counts":{"type":"object"},"material_digest":{"$ref":"#/$defs/sha256"},"checks":{"type":"array","items":{"$ref":"#/$defs/text"}},"warnings":{"type":"array","items":{"type":"string"}},"errors":{"type":"array","items":{"type":"string"}},"claim_ceiling":{"$ref":"#/$defs/text"}}}
  }
}
