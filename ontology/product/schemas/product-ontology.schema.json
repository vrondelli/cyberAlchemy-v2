{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-product-ontology.schema/v1",
  "title": "CyberAlchemy v2 product ontology package",
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "selector"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "selector": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref", "schema_version", "ontology_id", "title", "ontology_type",
        "branch", "materialization", "package_root", "package_owner", "meaning_owner",
        "visibility", "candidate_status", "authority_effect", "product_thesis_node_id",
        "source_registry", "node_registry", "relation_registry", "residue_registry",
        "schema_path", "validator_path", "blocked_outputs"
      ],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-product-ontology-profile/v1"},
        "ontology_id": {"const": "cav2.product-thesis"},
        "title": {"type": "string"},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "materialization": {"const": "package-required"},
        "package_root": {"const": "cyberAlchemy-v2/ontology/product"},
        "package_owner": {"type": "string", "minLength": 1},
        "meaning_owner": {"type": "string", "minLength": 1},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "product_thesis_node_id": {"type": "string"},
        "source_registry": {"const": "sources.json"},
        "node_registry": {"const": "nodes.json"},
        "relation_registry": {"const": "relations.json"},
        "residue_registry": {"const": "residue.json"},
        "schema_path": {"const": "schemas/product-ontology.schema.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "blocked_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "sources"],
      "properties": {
        "schema_ref": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256", "posture", "owner_route"],
            "properties": {
              "id": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "posture": {"type": "string"},
              "owner_route": {"type": "string"}
            }
          }
        }
      }
    },
    "nodeRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "nodes"],
      "properties": {
        "schema_ref": {"type": "string"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "label", "role", "plain_language", "claim", "scope", "source_refs",
              "owner_route", "candidate_status", "evidence_confidence", "commitment_confidence",
              "authority_effect", "forbidden_collapse", "open_questions"
            ],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "role": {"enum": ["product", "actor", "work_domain", "problem", "thesis", "product_form", "capability", "product_output", "outcome", "business_rule", "method", "project", "goal", "research", "experiment"]},
              "plain_language": {"type": "string"},
              "claim": {"type": "string"},
              "scope": {"type": "string"},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
              "owner_route": {"type": "string"},
              "candidate_status": {"enum": ["candidate", "reviewed-candidate", "deferred", "blocked", "projected"]},
              "evidence_confidence": {"enum": ["low", "medium", "high"]},
              "commitment_confidence": {"enum": ["low", "conditional", "committed"]},
              "authority_effect": {"const": "none"},
              "forbidden_collapse": {"type": "string"},
              "open_questions": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "relationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "relation_vocabulary", "relations"],
      "properties": {
        "schema_ref": {"type": "string"},
        "relation_vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "plain_language", "forbidden_collapse"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "plain_language": {"type": "string"},
              "forbidden_collapse": {"type": "string"}
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "source", "target", "direction", "owner_route", "source_refs", "authority_effect", "forbidden_collapse"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "source": {"type": "string"},
              "target": {"type": "string"},
              "direction": {"enum": ["directed", "symmetric", "view-only"]},
              "owner_route": {"type": "string"},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
              "authority_effect": {"const": "none"},
              "forbidden_collapse": {"type": "string"}
            }
          }
        }
      }
    },
    "residueRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "residue"],
      "properties": {
        "schema_ref": {"type": "string"},
        "residue": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "description", "status", "owner_route", "next_action", "subject_refs", "source_refs"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "description": {"type": "string"},
              "status": {"enum": ["open", "deferred", "blocked"]},
              "owner_route": {"type": "string"},
              "next_action": {"type": "string"},
              "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
            }
          }
        }
      }
    },
    "validationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref", "schema_version", "validated_at", "status", "package_root",
        "ontology_type", "branch", "visibility", "authority_effect", "validator_path",
        "command", "counts", "material_digest", "checks", "errors"
      ],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-product-ontology-validation/v1"},
        "validated_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["PASS", "BLOCK"]},
        "package_root": {"const": "cyberAlchemy-v2/ontology/product"},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "visibility": {"const": "private"},
        "authority_effect": {"const": "none"},
        "validator_path": {"const": "scripts/validate.py"},
        "command": {"type": "string"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources", "nodes", "relation_types", "relations", "residue"],
          "properties": {
            "sources": {"type": "integer", "minimum": 0},
            "nodes": {"type": "integer", "minimum": 0},
            "relation_types": {"type": "integer", "minimum": 0},
            "relations": {"type": "integer", "minimum": 0},
            "residue": {"type": "integer", "minimum": 0}
          }
        },
        "material_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checks": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
