{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance-product-ontology.schema/v1",
  "title": "Governance business product ontology",
  "$defs": {
    "sourceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "selector"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "selector": {"type": "string", "minLength": 1}}
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_ref", "schema_version", "ontology_id", "title", "ontology_type", "branch",
        "materialization", "package_root", "package_owner", "meaning_owner", "visibility",
        "candidate_status", "authority_effect", "enforcement_effect", "product_node_id",
        "product_thesis_node_id", "source_registry", "node_registry", "relation_registry",
        "residue_registry", "schema_path", "validator_path", "blocked_outputs"
      ],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "governance-product-ontology-profile/v1"},
        "ontology_id": {"const": "governance.product"},
        "title": {"type": "string"},
        "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"},
        "materialization": {"const": "package-required"},
        "package_root": {"const": "cyberAlchemy-v2/ontology/governance/product"},
        "package_owner": {"type": "string", "minLength": 1},
        "meaning_owner": {"type": "string", "minLength": 1},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "product_node_id": {"const": "GOV-PRODUCT-MODULE"},
        "product_thesis_node_id": {"const": "GOV-THESIS-PROPORTIONATE-EVIDENCE-GOVERNANCE"},
        "source_registry": {"const": "sources.json"},
        "node_registry": {"const": "nodes.json"},
        "relation_registry": {"const": "relations.json"},
        "residue_registry": {"const": "residue.json"},
        "schema_path": {"const": "schemas/governance-product-ontology.schema.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "blocked_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "sourceRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "sources"],
      "properties": {
        "schema_ref": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "path", "import_sha256", "digest_role", "posture", "owner_route", "required_selectors"],
          "properties": {
            "id": {"type": "string"}, "path": {"type": "string"},
            "import_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "digest_role": {"type": "string"}, "posture": {"type": "string"},
            "owner_route": {"type": "string"},
            "required_selectors": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }}
      }
    },
    "nodeRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "nodes"],
      "properties": {
        "schema_ref": {"type": "string"},
        "nodes": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": [
            "id", "label", "role", "plain_language", "claim", "scope", "source_refs",
            "owner_route", "candidate_status", "evidence_confidence", "commitment_confidence",
            "authority_effect", "enforcement_effect", "forbidden_collapse", "open_questions"
          ],
          "properties": {
            "id": {"type": "string"}, "label": {"type": "string"},
            "role": {"enum": ["product", "actor", "work_domain", "problem", "thesis", "capability", "product_output", "outcome", "business_rule", "value_measure"]},
            "plain_language": {"type": "string"}, "claim": {"type": "string"}, "scope": {"type": "string"},
            "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
            "owner_route": {"type": "string"}, "candidate_status": {"const": "candidate"},
            "evidence_confidence": {"enum": ["low", "medium", "high"]},
            "commitment_confidence": {"enum": ["low", "conditional", "committed"]},
            "authority_effect": {"const": "none"}, "enforcement_effect": {"const": "none"},
            "forbidden_collapse": {"type": "string"},
            "open_questions": {"type": "array", "items": {"type": "string"}}
          }
        }}
      }
    },
    "relationRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "relation_vocabulary", "relations"],
      "properties": {
        "schema_ref": {"type": "string"},
        "relation_vocabulary": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "label", "plain_language", "forbidden_collapse"],
          "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "plain_language": {"type": "string"}, "forbidden_collapse": {"type": "string"}}
        }},
        "relations": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "type", "source", "target", "direction", "owner_route", "source_refs", "authority_effect", "enforcement_effect", "forbidden_collapse"],
          "properties": {
            "id": {"type": "string"}, "type": {"type": "string"}, "source": {"type": "string"}, "target": {"type": "string"},
            "direction": {"enum": ["directed", "symmetric"]}, "owner_route": {"type": "string"},
            "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
            "authority_effect": {"const": "none"}, "enforcement_effect": {"const": "none"},
            "forbidden_collapse": {"type": "string"}
          }
        }}
      }
    },
    "residueRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "residue"],
      "properties": {
        "schema_ref": {"type": "string"},
        "residue": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "label", "description", "status", "owner_route", "next_action", "subject_refs", "source_refs"],
          "properties": {
            "id": {"type": "string"}, "label": {"type": "string"}, "description": {"type": "string"},
            "status": {"enum": ["open", "deferred", "blocked"]}, "owner_route": {"type": "string"},
            "next_action": {"type": "string"}, "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
          }
        }}
      }
    },
    "validationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "validated_at", "status", "package_root", "ontology_type", "branch", "visibility", "authority_effect", "enforcement_effect", "validator_path", "command", "counts", "material_digest", "checks", "warnings", "errors"],
      "properties": {
        "schema_ref": {"type": "string"}, "schema_version": {"const": "governance-product-ontology-validation/v1"},
        "validated_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["PASS", "BLOCK"]},
        "package_root": {"const": "cyberAlchemy-v2/ontology/governance/product"}, "ontology_type": {"const": "business-domain"},
        "branch": {"const": "business"}, "visibility": {"const": "private"},
        "authority_effect": {"const": "none"}, "enforcement_effect": {"const": "none"},
        "validator_path": {"const": "scripts/validate.py"}, "command": {"type": "string"},
        "counts": {"type": "object"}, "material_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checks": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
