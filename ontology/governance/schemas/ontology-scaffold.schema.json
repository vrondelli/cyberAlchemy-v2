{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/d65-ontology-scaffold/v1",
  "title": "CAV2-D65 Revision 2 Agent-Facing Ontology Scaffold Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "scaffolds", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2-d65-ontology-scaffold-registry/v1"},
    "registry_id": {"const": "cav2.governance.d65-ontology-scaffolds"},
    "scaffolds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scaffold"}
    },
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "scope_kind", "selector", "sha256", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "scope_kind": {"enum": ["whole-file", "heading-section", "json-record"]},
        "selector": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "relationHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "relation_type", "target_ref", "posture"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "posture": {"const": "prototype-hint"}
      }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaffold_id", "construction_id", "purpose", "agent_uses",
        "concept_refs", "relation_hints", "source_bindings",
        "lifecycle_posture", "canonicality", "challenge_route",
        "authority_effect"
      ],
      "properties": {
        "scaffold_id": {"type": "string", "minLength": 1},
        "construction_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "agent_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "concept_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "relation_hints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relationHint"}},
        "source_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceBinding"}},
        "lifecycle_posture": {"const": "prototype-scaffold"},
        "canonicality": {"const": "non-authoritative"},
        "challenge_route": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
