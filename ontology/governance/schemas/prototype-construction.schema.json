{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/schemas/d65-prototype-construction/v1",
  "title": "CAV2-D65 Revision 2 Prototype Construction Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "constructions", "authority_effect"],
  "properties": {
    "schema_version": {"const": "cav2-d65-prototype-construction-registry/v1"},
    "registry_id": {"const": "cav2.governance.d65-prototype-constructions"},
    "constructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/construction"}},
    "authority_effect": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "scope_kind", "selector", "sha256", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "scope_kind": {"enum": ["whole-file", "heading-section", "json-record"]},
        "selector": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "component_binding_ids", "manifest_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "component_binding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "testContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "required_test_ids"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "required_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "test_id", "candidate_manifest_sha256", "result", "evidence_binding"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "test_id": {"type": "string", "minLength": 1},
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"enum": ["PASS", "FAIL"]},
        "evidence_binding": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "productApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "candidate_manifest_sha256", "test_evidence_ids", "status", "decision_ref", "authority_effect"],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1},
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "test_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"const": "approved"},
        "decision_ref": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"}
      }
    },
    "authorityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "kind", "product_approval_id", "status", "authority_effect"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["authorization", "ontology-admission", "system-admission", "activation", "cutover", "publication", "release", "deployment"]},
        "product_approval_id": {"type": "string", "minLength": 1},
        "status": {"const": "candidate"},
        "authority_effect": {"const": "none"}
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_id", "subject_ref", "revision", "state",
        "definition_prototype_refs", "ontology_scaffold_refs",
        "artifact_bindings", "testable_product_candidate",
        "product_test_contract", "product_test_evidence", "product_approval",
        "authority_requests", "challenge_route", "authority_effect"
      ],
      "properties": {
        "construction_id": {"type": "string", "minLength": 1},
        "subject_ref": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "state": {"enum": ["prototype", "candidate_frozen", "tested", "product_approved", "superseded"]},
        "definition_prototype_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ontology_scaffold_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}},
        "testable_product_candidate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate"}]},
        "product_test_contract": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/testContract"}]},
        "product_test_evidence": {"type": "array", "items": {"$ref": "#/$defs/testEvidence"}},
        "product_approval": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/productApproval"}]},
        "authority_requests": {"type": "array", "items": {"$ref": "#/$defs/authorityRequest"}},
        "challenge_route": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"}
      }
    }
  }
}
