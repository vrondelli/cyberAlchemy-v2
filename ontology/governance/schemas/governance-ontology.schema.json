{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-governance-ontology.schema/v2",
  "title": "CyberAlchemy v2 governance ontology package",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref", "schema_version", "ontology_id", "title", "ontology_type",
        "branch", "materialization", "package_root", "package_owner", "meaning_owner",
        "visibility", "candidate_status", "authority_effect", "enforcement_effect",
        "source_registry", "node_registry", "relation_registry", "invariant_registry",
        "rule_registry", "product_binding_registry", "ontology_scaffold_registry",
        "prototype_construction_registry", "ontology_scaffold_schema",
        "prototype_construction_schema", "prototype_construction_validator",
        "prototype_construction_amendment",
        "identity_policy", "residue_registry", "migration_manifest", "module_manifest", "schema_path",
        "validator_path", "blocked_outputs"
      ],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-governance-ontology-profile/v3"},
        "ontology_id": {"const": "cav2.governance-model"},
        "title": {"type": "string", "minLength": 1},
        "ontology_type": {"const": "authority-governance"},
        "branch": {"const": "none"},
        "materialization": {"const": "package-required"},
        "package_root": {"const": "cyberAlchemy-v2/ontology/governance"},
        "package_owner": {"type": "string", "minLength": 1},
        "meaning_owner": {"type": "string", "minLength": 1},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "source_registry": {"const": "sources.json"},
        "node_registry": {"const": "nodes.json"},
        "relation_registry": {"const": "relations.json"},
        "invariant_registry": {"const": "invariants.json"},
        "rule_registry": {"const": "rules.json"},
        "product_binding_registry": {"const": "product-bindings.json"},
        "ontology_scaffold_registry": {"const": "ontology-scaffolds.json"},
        "prototype_construction_registry": {"const": "prototype-constructions.json"},
        "ontology_scaffold_schema": {"const": "schemas/ontology-scaffold.schema.json"},
        "prototype_construction_schema": {"const": "schemas/prototype-construction.schema.json"},
        "prototype_construction_validator": {"const": "scripts/validate-prototype-construction.py"},
        "prototype_construction_amendment": {"const": "schema-amendment-d65-r2.json"},
        "identity_policy": {"const": "identity-policy.json"},
        "residue_registry": {"const": "residue.json"},
        "migration_manifest": {"const": "migration.json"},
        "module_manifest": {"const": "module.json"},
        "schema_path": {"const": "schemas/governance-ontology.schema.json"},
        "validator_path": {"const": "scripts/validate.py"},
        "blocked_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "sources"],
      "properties": {
        "schema_ref": {"type": "string"},
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "path", "import_sha256", "digest_role", "posture", "owner_route", "required_selectors"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "import_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "digest_role": {"type": "string", "minLength": 1},
              "posture": {"type": "string", "minLength": 1},
              "owner_route": {"type": "string", "minLength": 1},
              "required_selectors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "nodeRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "nodes"],
      "properties": {
        "schema_ref": {"type": "string"},
        "nodes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "id", "label", "domainspec_v2_meta_type_id", "domainspec_v2_meta_type",
              "mapping_posture", "canonical_definition_ref", "identity", "required_fields",
              "allowed_values", "owner_route", "candidate_status", "authority_effect",
              "enforcement_effect", "forbidden_collapse"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "domainspec_v2_meta_type_id": {"type": "string", "pattern": "^DS-D1\\.[0-9]+$"},
              "domainspec_v2_meta_type": {"enum": ["Entity", "Value Object", "Enum", "Calculation", "Rule", "Policy", "Workflow", "Event"]},
              "mapping_posture": {"const": "candidate-semantic-alignment"},
              "canonical_definition_ref": {"type": ["string", "null"]},
              "identity": {"type": "string", "minLength": 1},
              "required_fields": {"type": "array", "items": {"type": "string"}},
              "allowed_values": {"type": "array", "items": {"type": "string"}},
              "owner_route": {"type": "string", "minLength": 1},
              "candidate_status": {"const": "candidate"},
              "authority_effect": {"const": "none"},
              "enforcement_effect": {"const": "none"},
              "forbidden_collapse": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "relationRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "relation_vocabulary", "relations"],
      "properties": {
        "schema_ref": {"type": "string"},
        "relation_vocabulary": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label", "source_type", "target_type", "forbidden_collapse"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "source_type": {"type": "string", "minLength": 1},
              "target_type": {"type": "string", "minLength": 1},
              "forbidden_collapse": {"type": "string", "minLength": 1}
            }
          }
        },
        "relations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "source", "target", "direction", "owner_route", "authority_effect", "enforcement_effect", "forbidden_collapse"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "direction": {"const": "directed"},
              "owner_route": {"type": "string", "minLength": 1},
              "authority_effect": {"const": "none"},
              "enforcement_effect": {"const": "none"},
              "forbidden_collapse": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "invariantRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "ontology_id", "invariants", "authority_effect", "enforcement_effect", "implementation_effect"],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-governance-invariant-registry/v1"},
        "ontology_id": {"const": "cav2.governance-model"},
        "invariants": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "id", "owner_qualified_version", "instance_of", "canonical_definition_ref",
              "canonical_schema_ref", "canonical_selector", "canonical_meaning_owner",
              "registration_owner", "source_status", "registry_status", "semantic_version_ref",
              "basis_refs", "axiom_grounding", "validation_mode", "operational_rule_refs",
              "authority_effect", "enforcement_effect", "implementation_effect", "forbidden_collapse"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "owner_qualified_version": {"type": "string", "minLength": 1},
              "instance_of": {"const": "GovernanceInvariant"},
              "canonical_definition_ref": {"type": "string", "minLength": 1},
              "canonical_schema_ref": {"type": "string", "minLength": 1},
              "canonical_selector": {"type": "string", "minLength": 1},
              "canonical_meaning_owner": {"type": "string", "minLength": 1},
              "registration_owner": {"type": "string", "minLength": 1},
              "source_status": {"const": "active"},
              "registry_status": {"const": "candidate"},
              "semantic_version_ref": {"type": ["string", "null"]},
              "basis_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "axiom_grounding": {
                "type": "object", "additionalProperties": false,
                "required": ["posture", "axiom_refs", "residue_ref"],
                "properties": {
                  "posture": {"enum": ["resolved", "unresolved"]},
                  "axiom_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                  "residue_ref": {"type": ["string", "null"]}
                }
              },
              "validation_mode": {"enum": ["review-only", "deterministic", "hybrid", "none-yet"]},
              "operational_rule_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "authority_effect": {"const": "none"},
              "enforcement_effect": {"const": "none"},
              "implementation_effect": {"const": "none"},
              "forbidden_collapse": {"type": "string", "minLength": 1}
            }
          }
        },
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "implementation_effect": {"const": "none"}
      }
    },
    "ruleRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "ontology_id", "rules", "authority_effect", "enforcement_effect", "implementation_effect"],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-governance-rule-registry/v1"},
        "ontology_id": {"const": "cav2.governance-model"},
        "rules": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "id", "owner_qualified_version", "instance_of", "operationalizes", "rule_kind",
              "subject_kind", "evaluation_contract_ref", "review_outcomes", "validation_mode",
              "owner_route", "adoption_state", "constitution_refs", "enforcement_binding_refs",
              "authority_effect", "enforcement_effect", "implementation_effect", "forbidden_collapse"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "owner_qualified_version": {"type": "string", "minLength": 1},
              "instance_of": {"const": "GovernanceRule"},
              "operationalizes": {
                "type": "object", "additionalProperties": false,
                "required": ["relation_type", "source_ref", "source_type", "target_ref", "target_type", "direction"],
                "properties": {
                  "relation_type": {"const": "is_operationalized_by"},
                  "source_ref": {"type": "string", "minLength": 1},
                  "source_type": {"const": "GovernanceInvariant"},
                  "target_ref": {"type": "string", "minLength": 1},
                  "target_type": {"const": "GovernanceRule"},
                  "direction": {"const": "directed"}
                }
              },
              "rule_kind": {"enum": ["audit", "correctness", "pattern_enforcement", "integrity", "lifecycle", "authority", "effect_boundary"]},
              "subject_kind": {"type": "string", "minLength": 1},
              "evaluation_contract_ref": {"type": "string", "minLength": 1},
              "review_outcomes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["satisfied", "violated", "indeterminate"]}},
              "validation_mode": {"const": "review-only"},
              "owner_route": {"type": "string", "minLength": 1},
              "adoption_state": {"const": "not-adopted"},
              "constitution_refs": {"type": "array", "maxItems": 0},
              "enforcement_binding_refs": {"type": "array", "maxItems": 0},
              "authority_effect": {"const": "none"},
              "enforcement_effect": {"const": "none"},
              "implementation_effect": {"const": "none"},
              "forbidden_collapse": {"type": "string", "minLength": 1}
            }
          }
        },
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "implementation_effect": {"const": "none"}
      }
    },
    "productBindingRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "target_ontology", "bindings"],
      "properties": {
        "schema_ref": {"type": "string"},
        "target_ontology": {
          "type": "object", "additionalProperties": false,
          "required": ["ontology_id", "profile_path", "nodes_path", "binding_policy"],
          "properties": {
            "ontology_id": {"const": "governance.product"},
            "profile_path": {"type": "string"},
            "nodes_path": {"type": "string"},
            "binding_policy": {"type": "string", "minLength": 1}
          }
        },
        "bindings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "id", "source_kind", "source_ref", "target_node_id", "target_expectation",
              "relation", "binding_status", "currentness", "authority_effect",
              "enforcement_effect", "implementation_effect", "claim_ceiling"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source_kind": {"enum": ["ontology", "node"]},
              "source_ref": {"type": "string", "minLength": 1},
              "target_node_id": {"type": "string", "minLength": 1},
              "target_expectation": {
                "type": "object", "additionalProperties": false,
                "required": ["label", "role", "candidate_status", "authority_effect"],
                "properties": {
                  "label": {"type": "string"},
                  "role": {"type": "string"},
                  "candidate_status": {"const": "candidate"},
                  "authority_effect": {"const": "none"}
                }
              },
              "relation": {"type": "string", "minLength": 1},
              "binding_status": {"const": "candidate"},
              "currentness": {"enum": ["current", "non-current"]},
              "authority_effect": {"const": "none"},
              "enforcement_effect": {"const": "none"},
              "implementation_effect": {"const": "none"},
              "claim_ceiling": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "identityPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "identity_axes", "semantic_identity", "instance_registration_role", "source_digest_role", "package_digest_role", "product_binding_role", "currentness_behavior", "forbidden_uses"],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-governance-identity-policy/v1"},
        "identity_axes": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "semantic_identity": {"type": "string"},
        "instance_registration_role": {"type": "string"},
        "source_digest_role": {"type": "string"},
        "package_digest_role": {"type": "string"},
        "product_binding_role": {"type": "string"},
        "currentness_behavior": {"type": "string"},
        "forbidden_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "residueRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "residue"],
      "properties": {
        "schema_ref": {"type": "string"},
        "residue": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "issue", "effect", "status", "owner_route", "subject_refs"],
            "properties": {
              "id": {"type": "string"}, "issue": {"type": "string"}, "effect": {"type": "string"},
              "status": {"enum": ["open", "deferred", "blocked"]},
              "owner_route": {"type": "string"},
              "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "schemaAmendmentWitness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_ref", "schema_version", "amendment_id", "status",
        "previous_schema_version", "new_schema_version", "change_kind", "rationale",
        "affected_files", "migration_impact", "rollback", "authority_effect",
        "enforcement_effect", "implementation_effect", "claim_ceiling"
      ],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-governance-schema-amendment/v1"},
        "amendment_id": {"const": "GOV-SCHEMA-AMEND-D64-001"},
        "status": {"const": "user-requested-candidate"},
        "previous_schema_version": {"const": "cav2-governance-ontology-profile/v1"},
        "new_schema_version": {"const": "cav2-governance-ontology-profile/v2"},
        "change_kind": {"const": "additive-governed-instance-registries"},
        "rationale": {"type": "string", "minLength": 1},
        "affected_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "migration_impact": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "implementation_effect": {"const": "none"},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "prototypeConstructionAmendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref", "schema_version", "amendment_id", "status",
        "previous_schema_version", "new_schema_version", "change_kind",
        "rationale", "affected_files", "migration_impact", "rollback",
        "authority_effect", "enforcement_effect", "implementation_effect",
        "claim_ceiling"
      ],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-governance-prototype-construction-amendment/v1"},
        "amendment_id": {"const": "GOV-SCHEMA-AMEND-D65-R2-001"},
        "status": {"const": "user-requested-prototype"},
        "previous_schema_version": {"const": "cav2-governance-ontology-profile/v2"},
        "new_schema_version": {"const": "cav2-governance-ontology-profile/v3"},
        "change_kind": {"const": "additive-prototype-construction-runtime"},
        "rationale": {"type": "string", "minLength": 1},
        "affected_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "migration_impact": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "implementation_effect": {"const": "prototype-only"},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "migrationManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "source_seed", "migration_posture", "imported", "excluded", "superseded", "authority_effect", "enforcement_effect"],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "cav2-governance-ontology-migration/v1"},
        "source_seed": {"type": "string"},
        "migration_posture": {"const": "selective-semantic-materialization"},
        "imported": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["seed_section", "target", "treatment"], "properties": {"seed_section": {"type": "string"}, "target": {"type": "string"}, "treatment": {"type": "string"}}}},
        "excluded": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["seed_section", "reason", "status", "future_target"], "properties": {"seed_section": {"type": "string"}, "reason": {"type": "string"}, "status": {"const": "not_evaluable"}, "future_target": {"type": "string"}}}},
        "superseded": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["seed_section", "replacement", "reason"], "properties": {"seed_section": {"type": "string"}, "replacement": {"type": "string"}, "reason": {"type": "string"}}}},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"}
      }
    },
    "documentAdmission": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "owner_route", "authority_effect", "enforcement_effect"],
      "properties": {
        "status": {"const": "blocked"},
        "reason": {"type": "string", "minLength": 1},
        "owner_route": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "title", "role", "intended_canonical_kind", "durability", "status", "canonical_status", "authority_state", "owner_route", "projection_refs", "required_headings", "authority_effect", "enforcement_effect", "claim_ceiling"],
      "properties": {
        "id": {"type": "string", "pattern": "^GOV-DOC-[0-9]{3}$"},
        "path": {"type": "string", "pattern": "^docs/[A-Z-]+\\.md$"},
        "title": {"type": "string", "minLength": 1},
        "role": {"enum": ["product-meaning", "domain-model", "authority-boundary", "lifecycle-model", "evidence-model", "runtime-intent"]},
        "intended_canonical_kind": {"const": "spec"},
        "durability": {"const": "perennial"},
        "status": {"const": "candidate"},
        "canonical_status": {"const": "not-admitted"},
        "authority_state": {"const": "none"},
        "owner_route": {"type": "string", "minLength": 1},
        "projection_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_headings": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^## "}},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "documentRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "status", "durability", "canonical_admission", "source_order", "documents", "authority_effect", "enforcement_effect", "claim_ceiling"],
      "properties": {
        "schema_ref": {"const": "schemas/governance-ontology.schema.json#/$defs/documentRegistry"},
        "schema_version": {"const": "governance-perennial-documents/v1"},
        "status": {"const": "candidate"},
        "durability": {"const": "perennial"},
        "canonical_admission": {"$ref": "#/$defs/documentAdmission"},
        "source_order": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "documents": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/document"}},
        "authority_effect": {"const": "none"},
        "enforcement_effect": {"const": "none"},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "moduleManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "module_id", "title", "package_root", "module_owner", "visibility", "candidate_status", "host_context", "owned_ontologies", "internal_binding_registry", "perennial_document_registry", "aggregate_validator", "planned_surfaces", "authority_effect", "enforcement_effect", "implementation_effect", "blocked_outputs"],
      "properties": {
        "schema_ref": {"type": "string"},
        "schema_version": {"const": "governance-module/v1"},
        "module_id": {"const": "governance"},
        "title": {"type": "string"},
        "package_root": {"const": "cyberAlchemy-v2/ontology/governance"},
        "module_owner": {"type": "string"},
        "visibility": {"const": "private"},
        "candidate_status": {"const": "candidate"},
        "host_context": {
          "type": "object", "additionalProperties": false,
          "required": ["host_id", "relationship", "target_path", "source_authority_dependency", "product_ontology_dependency", "claim_ceiling"],
          "properties": {
            "host_id": {"const": "cyberalchemy-v2"},
            "relationship": {"const": "module_of"},
