    },
    "validationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "schema_version", "validated_at", "status", "package_root", "ontology_type", "branch", "visibility", "authority_effect", "enforcement_effect", "validator_path", "command", "counts", "material_digest", "checks", "warnings", "errors"],
