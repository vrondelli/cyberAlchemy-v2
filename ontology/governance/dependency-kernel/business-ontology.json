  "nodes": [
    {"id": "GOV-DEPENDENCY-KERNEL-ONTOLOGY", "role": "capability_boundary", "meaning": "The business meaning of selecting and evaluating one governance dependency program without creating authority or effects."},
    {"id": "GDK-PROGRAM-SELECTION", "role": "business_entity", "meaning": "An owner decision selecting one immutable program identity and version for one declared scope, without activating it."},
    {"id": "GDK-GOVERNANCE-PROGRAM", "role": "business_entity", "meaning": "A declarative no-effect program containing dependency records, explicit edges, mode policy, and claim ceilings."},
    {"id": "GDK-WORK-REQUEST", "role": "business_entity", "meaning": "One route-preserving request selecting a program, evaluation mode, root dependencies, and exact candidate inputs when applicable."},
    {"id": "GDK-DEPENDENCY-RECORD", "role": "business_entity", "meaning": "One bounded repository selector with expected content identity and explicit references to further dependencies."},
    {"id": "GDK-DEPENDENCY-CLOSURE", "role": "business_entity", "meaning": "The deterministic transitive set reachable from the work request's selected roots through declared dependency edges."},
    {"id": "GDK-DEPENDENCY-OBSERVATION", "role": "business_entity", "meaning": "The exact observed digest or selector error for one dependency evaluated by the kernel."},
    {"id": "GDK-DEPENDENCY-IMPACT", "role": "business_entity", "meaning": "A classification of one change as current, selected candidate input, relevant drift, ambient drift, or indeterminate relevance."},
    {"id": "GDK-EVALUATION-MODE", "role": "business_enum", "meaning": "Either admitted_use, which requires admitted digests, or candidate_construction, which requires exact selected observed digests and grants no activation."},
    {"id": "GDK-KERNEL-EVALUATION", "role": "business_entity", "meaning": "A deterministic no-effect result with PASS, CANDIDATE, BLOCK, or NOT_EVALUABLE status and complete causal evidence."},
    {"id": "GDK-ACTIVATION-BINDING", "role": "business_entity", "meaning": "A separately owner-controlled immutable binding over program, kernel, route, scope, and effect mapping required before enforcement."},
    {"id": "GDK-RULE-EXPLICIT-SELECTION", "role": "business_rule", "meaning": "Only an exact owner-selected program and request roots may determine the evaluated dependency closure."},
    {"id": "GDK-RULE-SELECTOR-RELEVANCE", "role": "business_rule", "meaning": "Only changed dependencies inside the selected transitive closure can invalidate the work; other observed drift is ambient."},
    {"id": "GDK-RULE-UNKNOWN-FAILS-CLOSED", "role": "business_rule", "meaning": "Missing records, path escape, ambiguous selectors, duplicate identities, cycles, or unresolved edges make the evaluation NOT_EVALUABLE."},
    {"id": "GDK-RULE-CANDIDATE-NON-ACTIVATION", "role": "business_rule", "meaning": "Candidate construction can select exact changed inputs but cannot produce an admitted-use PASS or an active enforcement effect."},
    {"id": "GDK-RULE-SEPARATE-ACTIVATION", "role": "business_rule", "meaning": "A program and kernel remain non-enforcing until a separate exact owner activation binding is present and validated."}
  ],
  "relations": [
    {"type": "selects", "source": "GDK-PROGRAM-SELECTION", "target": "GDK-GOVERNANCE-PROGRAM"},
    {"type": "invokes", "source": "GDK-WORK-REQUEST", "target": "GDK-GOVERNANCE-PROGRAM"},
    {"type": "selects_root", "source": "GDK-WORK-REQUEST", "target": "GDK-DEPENDENCY-RECORD"},
    {"type": "closes_into", "source": "GDK-DEPENDENCY-RECORD", "target": "GDK-DEPENDENCY-CLOSURE"},
    {"type": "produces", "source": "GDK-DEPENDENCY-CLOSURE", "target": "GDK-DEPENDENCY-OBSERVATION"},
    {"type": "classifies", "source": "GDK-DEPENDENCY-OBSERVATION", "target": "GDK-DEPENDENCY-IMPACT"},
    {"type": "constrains", "source": "GDK-EVALUATION-MODE", "target": "GDK-KERNEL-EVALUATION"},
    {"type": "produces", "source": "GDK-GOVERNANCE-PROGRAM", "target": "GDK-KERNEL-EVALUATION"},
    {"type": "may_bind", "source": "GDK-ACTIVATION-BINDING", "target": "GDK-GOVERNANCE-PROGRAM"},
    {"type": "governs", "source": "GDK-RULE-EXPLICIT-SELECTION", "target": "GDK-PROGRAM-SELECTION"},
    {"type": "governs", "source": "GDK-RULE-SELECTOR-RELEVANCE", "target": "GDK-DEPENDENCY-IMPACT"},
    {"type": "governs", "source": "GDK-RULE-UNKNOWN-FAILS-CLOSED", "target": "GDK-KERNEL-EVALUATION"},
    {"type": "governs", "source": "GDK-RULE-CANDIDATE-NON-ACTIVATION", "target": "GDK-EVALUATION-MODE"},
    {"type": "governs", "source": "GDK-RULE-SEPARATE-ACTIVATION", "target": "GDK-ACTIVATION-BINDING"}
  ],
  "authority_effect": "none",
  "enforcement_effect": "none",
  "claim_limit": "Capability-local candidate meaning only; no adopted Governance Rule or Constitution, active program, enforcement binding, implementation conformance, route integration, publication, release, or deployment."
