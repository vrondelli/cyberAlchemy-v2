{
  "schema_version": "minted-node/v1",
  "node_id": "governance-dependency-kernel.DependencyEvaluation",
  "feature_id": "governance-dependency-kernel",
  "kind": "Entity",
  "intent": "Return a deterministic no-effect result with the closed relevant set, observations, ambient evidence, causal blockers, and PASS, CANDIDATE, BLOCK, or NOT_EVALUABLE status.",
  "body": {
    "fields": [
      {"name": "evaluation_id", "type": "sha256", "identity": true},
      {"name": "status", "type": "PASS|CANDIDATE|BLOCK|NOT_EVALUABLE", "identity": false},
      {"name": "dependency_set_digest", "type": "sha256|null", "identity": false},
      {"name": "observations", "type": "DependencyObservation[]", "identity": false},
      {"name": "blockers", "type": "string[]", "identity": false},
      {"name": "effect_authorized", "type": "false", "identity": false}
    ],
    "semantic_refs": ["GDK-KERNEL-EVALUATION", "GDK-DEPENDENCY-OBSERVATION", "GDK-DEPENDENCY-IMPACT"],
    "authority_effect": "none"
  },
  "connections": []
}
