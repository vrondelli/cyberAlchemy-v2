{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/registry-context/v2",
  "title": "CyberAlchemy v2 Registry Context",
  "$defs": {
    "text": {"type":"string","minLength":1},
    "id": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "profile": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","package_id","title","package_root","product_ref","capability_ref","project_ref","goal_ref","first_vertical_context_ref","package_owner","runtime_owner","context_meaning_owner","visibility","status","authority_effect","compatibility_ref","product_ontology_ref","business_ontology_ref","residue_ref","domainspec_project_ref","system_ontology_ref","registry_ref","schema_ref_path","cli_ref","validator_ref","blocked_outputs"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/profile"},"schema_version":{"const":"cav2-registry-context-profile/v2"},"package_id":{"const":"cav2.registry-context"},"title":{"$ref":"#/$defs/text"},"package_root":{"const":"cyberAlchemy-v2/registry-context"},"product_ref":{"const":"CA2-PRODUCT-CYBERALCHEMY"},"capability_ref":{"const":"CA2-CAP-RESOLVE-REGISTRY-CONTEXT"},"project_ref":{"const":"CA2-PROJECT-REGISTRY-CONTEXT"},"goal_ref":{"const":"CA2-GOAL-REGISTRY-CONTEXT-FIRST-VERTICAL"},"first_vertical_context_ref":{"const":"CA2-CONTEXT-REGISTRY-CONTEXT-FIRST-VERTICAL"},"package_owner":{"$ref":"#/$defs/text"},"runtime_owner":{"$ref":"#/$defs/text"},"context_meaning_owner":{"$ref":"#/$defs/text"},"visibility":{"const":"private"},"status":{"const":"candidate-runtime-prototype"},"authority_effect":{"const":"none"},"compatibility_ref":{"const":"compat/v1"},"product_ontology_ref":{"const":"product-ontology.json"},"business_ontology_ref":{"const":"business-ontology.json"},"residue_ref":{"const":"residue.json"},"domainspec_project_ref":{"const":"domainspec-project/project.json"},"system_ontology_ref":{"const":"system-ontology/PROFILE.json"},"registry_ref":{"const":"registry.json"},"schema_ref_path":{"const":"schemas/registry-context.schema.json"},"cli_ref":{"const":"scripts/registry_context_cli.py"},"validator_ref":{"const":"scripts/validate.py"},"blocked_outputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "formalVoice": {"type":"object","additionalProperties":false,"required":["expression","invariants"],"properties":{"expression":{"$ref":"#/$defs/text"},"invariants":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}}},
    "candidateDefinition": {"type":"object","additionalProperties":false,"required":["definition_id","term","base_definition_ref","status","formal_voice","plain_language_voice","domain_context_voice","lifecycle","owner_route","forbidden_collapse","authority_effect"],"properties":{"definition_id":{"const":"RC2-DEF-REGISTRY-CONTEXT"},"term":{"const":"Registry Context"},"base_definition_ref":{"const":"CAV2-D66"},"status":{"const":"candidate"},"formal_voice":{"$ref":"#/$defs/formalVoice"},"plain_language_voice":{"$ref":"#/$defs/text"},"domain_context_voice":{"$ref":"#/$defs/text"},"lifecycle":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"owner_route":{"$ref":"#/$defs/text"},"forbidden_collapse":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
    "definitionRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","authority_posture","definitions"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/definitionRegistry"},"schema_version":{"const":"cav2-registry-context-definitions/v2"},"authority_posture":{"const":"candidate-specialization-of-canonical-context"},"definitions":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/candidateDefinition"}}}},
    "node": {"type":"object","additionalProperties":false,"required":["id","label","role","branch","meaning","owner_route","status","authority_effect"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/text"},"role":{"enum":["product","thesis","project","goal","context","business_concept","capability","request","view","policy","component","system_model","compatibility"]},"branch":{"enum":["product","business","system"]},"meaning":{"$ref":"#/$defs/text"},"owner_route":{"$ref":"#/$defs/text"},"status":{"enum":["projected","candidate-instance","candidate","prototype","preserved"]},"authority_effect":{"const":"none"}}},
    "nodeRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","nodes"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/nodeRegistry"},"schema_version":{"const":"cav2-registry-context-nodes/v2"},"nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}}}},
    "relation": {"type":"object","additionalProperties":false,"required":["id","type","source","target","meaning","authority_effect"],"properties":{"id":{"type":"string","pattern":"^RC2-REL-[0-9]{3}$"},"type":{"type":"string","pattern":"^[a-z][a-z_]*$"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},"meaning":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
    "relationRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","relations"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/relationRegistry"},"schema_version":{"const":"cav2-registry-context-relations/v2"},"relations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relation"}}}},
    "ontologyView": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","ontology_id","ontology_kind","question","answer","node_refs","relation_refs","outcomes","claim_ceiling"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/ontologyView"},"schema_version":{"const":"cav2-registry-context-ontology-view/v2"},"ontology_id":{"type":"string","pattern":"^cav2[.]registry-context[.](product|business)$"},"ontology_kind":{"enum":["product","business"]},"question":{"$ref":"#/$defs/text"},"answer":{"$ref":"#/$defs/text"},"node_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"relation_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC2-REL-"}},"outcomes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"claim_ceiling":{"$ref":"#/$defs/text"}}},
    "registeredSelection": {"type":"object","additionalProperties":false,"required":["selection_id","path","selector_kind","expected_file_sha256","expected_selection_sha256","owner_route"],"properties":{"selection_id":{"type":"string","pattern":"^RC2-SEL-"},"path":{"type":"string","pattern":"^cyberAlchemy-v2/"},"selector_kind":{"const":"whole-json"},"expected_file_sha256":{"$ref":"#/$defs/sha256"},"expected_selection_sha256":{"$ref":"#/$defs/sha256"},"owner_route":{"$ref":"#/$defs/text"}}},
    "registeredContext": {"type":"object","additionalProperties":false,"required":["context_ref","context_path","expected_context_sha256","allowed_selection_ids","owner_route","lifecycle_state"],"properties":{"context_ref":{"type":"string","pattern":"^CA2-CONTEXT-"},"context_path":{"type":"string","pattern":"^cyberAlchemy-v2/context/contexts/"},"expected_context_sha256":{"$ref":"#/$defs/sha256"},"allowed_selection_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC2-SEL-"}},"owner_route":{"$ref":"#/$defs/text"},"lifecycle_state":{"enum":["draft","active"]}}},
    "registry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","contexts","selections","authority_effect"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/registry"},"schema_version":{"const":"cav2-registry-context-registry/v2"},"contexts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/registeredContext"}},"selections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/registeredSelection"}},"authority_effect":{"const":"none"}}},
    "request": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","request_id","context_ref","expected_context_sha256","consumer_ref","intended_use","selection_ids","authority_effect"],"properties":{"schema_ref":{"const":"../schemas/registry-context.schema.json#/$defs/request"},"schema_version":{"const":"cav2-registry-context-request/v2"},"request_id":{"type":"string","pattern":"^RC2-REQ-"},"context_ref":{"type":"string","pattern":"^CA2-CONTEXT-"},"expected_context_sha256":{"$ref":"#/$defs/sha256"},"consumer_ref":{"$ref":"#/$defs/id"},"intended_use":{"$ref":"#/$defs/text"},"selection_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC2-SEL-"}},"authority_effect":{"const":"none"}}},
    "selectedRecord": {"type":"object","additionalProperties":false,"required":["selection_id","selection_sha256","owner_route","content"],"properties":{"selection_id":{"type":"string","pattern":"^RC2-SEL-"},"selection_sha256":{"$ref":"#/$defs/sha256"},"owner_route":{"$ref":"#/$defs/text"},"content":{"type":"object"}}},
    "view": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","view_id","request_id","request_sha256","context_ref","context_sha256","consumer_ref","intended_use","resolution_status","source_epoch_sha256","context_projection","selected_records","claim_ceiling","authority_effect","view_sha256"],"properties":{"schema_ref":{"const":"../schemas/registry-context.schema.json#/$defs/view"},"schema_version":{"const":"cav2-registry-context-view/v2"},"view_id":{"type":"string","pattern":"^RC2-VIEW-"},"request_id":{"type":"string","pattern":"^RC2-REQ-"},"request_sha256":{"$ref":"#/$defs/sha256"},"context_ref":{"type":"string","pattern":"^CA2-CONTEXT-"},"context_sha256":{"$ref":"#/$defs/sha256"},"consumer_ref":{"$ref":"#/$defs/id"},"intended_use":{"$ref":"#/$defs/text"},"resolution_status":{"const":"resolved"},"source_epoch_sha256":{"$ref":"#/$defs/sha256"},"context_projection":{"type":"object"},"selected_records":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/selectedRecord"}},"claim_ceiling":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"},"view_sha256":{"$ref":"#/$defs/sha256"}}},
    "blockedResult": {"type":"object","additionalProperties":false,"required":["schema_version","resolution_status","request_id","errors","authority_effect"],"properties":{"schema_version":{"const":"cav2-registry-context-blocked/v2"},"resolution_status":{"const":"blocked"},"request_id":{"type":["string","null"]},"errors":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"authority_effect":{"const":"none"}}},
    "residueItem": {"type":"object","additionalProperties":false,"required":["residue_id","statement","impact","next_owner","status","authority_effect"],"properties":{"residue_id":{"type":"string","pattern":"^RC2-RES-"},"statement":{"$ref":"#/$defs/text"},"impact":{"$ref":"#/$defs/text"},"next_owner":{"$ref":"#/$defs/text"},"status":{"const":"open"},"authority_effect":{"const":"none"}}},
    "residueRegistry": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","residue","authority_effect"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/residueRegistry"},"schema_version":{"const":"cav2-registry-context-residue/v2"},"residue":{"type":"array","items":{"$ref":"#/$defs/residueItem"}},"authority_effect":{"const":"none"}}},
    "bridgeMapping": {"type":"object","additionalProperties":false,"required":["business_ref","system_ref","relation","claim_limit"],"properties":{"business_ref":{"$ref":"#/$defs/id"},"system_ref":{"$ref":"#/$defs/id"},"relation":{"enum":["projects_candidate_of","proposed_realization_of"]},"claim_limit":{"$ref":"#/$defs/text"}}},
    "systemBridge": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","bridge_id","business_source_ref","domainspec_graph_ref","mappings","owner_route","authority_effect"],"properties":{"schema_ref":{"const":"../schemas/registry-context.schema.json#/$defs/systemBridge"},"schema_version":{"const":"cav2-registry-context-system-bridge/v1"},"bridge_id":{"const":"cav2.registry-context.business-system.v2"},"business_source_ref":{"const":"../business-ontology.json"},"domainspec_graph_ref":{"const":"../domainspec-project/.domainspec/generated/graph.json"},"mappings":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/bridgeMapping"}},"owner_route":{"$ref":"#/$defs/text"},"authority_effect":{"const":"none"}}},
    "migrationEntry": {"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "migration": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","migration_id","from_root","to_root","decision","project_ref","context_ref","compatibility_strategy","v1_inventory","authority_effect","claim_ceiling"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/migration"},"schema_version":{"const":"cav2-registry-context-migration/v2"},"migration_id":{"const":"RC2-MIGRATION-ROOT-CONTEXT-FIRST"},"from_root":{"const":"cyberAlchemy-v2/product/registry-context"},"to_root":{"const":"cyberAlchemy-v2/registry-context"},"decision":{"$ref":"#/$defs/text"},"project_ref":{"const":"CA2-PROJECT-REGISTRY-CONTEXT"},"context_ref":{"const":"CA2-CONTEXT-REGISTRY-CONTEXT-FIRST-VERTICAL"},"compatibility_strategy":{"$ref":"#/$defs/text"},"v1_inventory":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/migrationEntry"}},"authority_effect":{"const":"none"},"claim_ceiling":{"$ref":"#/$defs/text"}}},
    "validationReceipt": {"type":"object","additionalProperties":false,"required":["schema_ref","schema_version","status","package_root","counts","material_sha256","checks","warnings","errors","authority_effect","claim_ceiling"],"properties":{"schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/validationReceipt"},"schema_version":{"const":"cav2-registry-context-validation/v2"},"status":{"enum":["PASS","BLOCK"]},"package_root":{"const":"cyberAlchemy-v2/registry-context"},"counts":{"type":"object"},"material_sha256":{"$ref":"#/$defs/sha256"},"checks":{"type":"array","items":{"$ref":"#/$defs/text"}},"warnings":{"type":"array","items":{"type":"string"}},"errors":{"type":"array","items":{"type":"string"}},"authority_effect":{"const":"none"},"claim_ceiling":{"$ref":"#/$defs/text"}}}
  }
}
