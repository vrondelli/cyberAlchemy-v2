{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberalchemy.local/private/schemas/registry-context/v1",
  "title": "CyberAlchemy Registry Context candidate package",
  "$defs": {
    "text": {"type":"string","minLength":1},
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "ontologyTypeSelection": {
      "type":"object","additionalProperties":false,
      "required":["source","confidence","reason","excluded_types"],
      "properties":{
        "source":{"const":"inferred"},
        "confidence":{"const":"high"},
        "reason":{"$ref":"#/$defs/text"},
        "excluded_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}
      }
    },
    "profile": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","ontology_id","title","ontology_type","ontology_type_selection","branches","bridge","materialization","package_root","package_owner","business_meaning_owner","system_design_owner","visibility","candidate_status","implementation_state","authority_effect","currency_policy","source_registry","definition_registry","node_registry","relation_registry","operation_registry","residue_registry","business_view","system_view","bridge_view","context_request_example","context_view_example","schema_path","validator_path","blocked_outputs"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/profile"},
        "schema_version":{"const":"cav2-registry-context-profile/v1"},
        "ontology_id":{"const":"cav2.registry-context"},
        "title":{"$ref":"#/$defs/text"},
        "ontology_type":{"const":"business-system-bridge"},
        "ontology_type_selection":{"$ref":"#/$defs/ontologyTypeSelection"},
        "branches":{"const":["business","system"]},
        "bridge":{"const":"business-system"},
        "materialization":{"const":"package-required"},
        "package_root":{"const":"cyberAlchemy-v2/product/registry-context"},
        "package_owner":{"const":"CyberAlchemy v2 product owner"},
        "business_meaning_owner":{"const":"CyberAlchemy v2 product owner"},
        "system_design_owner":{"type":"string","pattern":"unresolved"},
        "visibility":{"const":"private"},
        "candidate_status":{"const":"candidate"},
        "implementation_state":{"const":"not-implemented"},
        "authority_effect":{"const":"none"},
        "currency_policy":{"const":"selection-digest-fail-closed"},
        "source_registry":{"const":"sources.json"},
        "definition_registry":{"const":"definitions.json"},
        "node_registry":{"const":"nodes.json"},
        "relation_registry":{"const":"relations.json"},
        "operation_registry":{"const":"operations.json"},
        "residue_registry":{"const":"residue.json"},
        "business_view":{"const":"views/business-view.json"},
        "system_view":{"const":"views/system-view.json"},
        "bridge_view":{"const":"views/bridge-view.json"},
        "context_request_example":{"const":"examples/define-context-request.json"},
        "context_view_example":{"const":"examples/define-context-view.json"},
        "schema_path":{"const":"schemas/registry-context.schema.json"},
        "validator_path":{"const":"scripts/validate.py"},
        "blocked_outputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}
      }
    },
    "source": {
      "type":"object","additionalProperties":false,
      "required":["id","branch","path","observed_file_sha256","posture","owner_route"],
      "properties":{
        "id":{"type":"string","pattern":"^SRC-RC-[A-Z0-9-]+$"},
        "branch":{"enum":["business","system","bridge","mixed"]},
        "path":{"type":"string","pattern":"^cyberAlchemy-v2/"},
        "observed_file_sha256":{"$ref":"#/$defs/sha256"},
        "posture":{"$ref":"#/$defs/text"},
        "owner_route":{"$ref":"#/$defs/text"}
      }
    },
    "sourceSelection": {
      "type":"object","additionalProperties":false,
      "required":["selection_id","source_id","selector_kind","selector","id_field","id_value","selection_sha256"],
      "properties":{
        "selection_id":{"type":"string","pattern":"^RC-SEL-[A-Z0-9-]+$"},
        "source_id":{"type":"string","pattern":"^SRC-RC-[A-Z0-9-]+$"},
        "selector_kind":{"enum":["json-pointer","json-record","markdown-heading"]},
        "selector":{"$ref":"#/$defs/text"},
        "id_field":{"type":["string","null"]},
        "id_value":{"type":["string","null"]},
        "selection_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "sourceRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","selection_digest_algorithm","sources","selections"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/sourceRegistry"},
        "schema_version":{"const":"cav2-registry-context-sources/v1"},
        "selection_digest_algorithm":{"const":"sha256-selected-bytes/v1"},
        "sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},
        "selections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceSelection"}}
      }
    },
    "symbol": {
      "type":"object","additionalProperties":false,"required":["symbol","meaning"],
      "properties":{"symbol":{"$ref":"#/$defs/text"},"meaning":{"$ref":"#/$defs/text"}}
    },
    "formalVoice": {
      "type":"object","additionalProperties":false,
      "required":["normative_candidate","expression","symbols","boundary_conditions"],
      "properties":{
        "normative_candidate":{"$ref":"#/$defs/text"},
        "expression":{"$ref":"#/$defs/text"},
        "symbols":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/symbol"}},
        "boundary_conditions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}}
      }
    },
    "candidateDefinition": {
      "type":"object","additionalProperties":false,
      "required":["id","term","subject_ref","definition_status","formal_voice","plain_language_voice","domain_context_voice","operational_interpretation","forbidden_collapse","source_refs","owner_route","authority_effect"],
      "properties":{
        "id":{"type":"string","pattern":"^RC-DEF-[A-Z0-9-]+$"},
        "term":{"$ref":"#/$defs/text"},
        "subject_ref":{"$ref":"#/$defs/id"},
        "definition_status":{"const":"candidate"},
        "formal_voice":{"$ref":"#/$defs/formalVoice"},
        "plain_language_voice":{"$ref":"#/$defs/text"},
        "domain_context_voice":{"$ref":"#/$defs/text"},
        "operational_interpretation":{"$ref":"#/$defs/text"},
        "forbidden_collapse":{"$ref":"#/$defs/text"},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}},
        "owner_route":{"$ref":"#/$defs/text"},
        "authority_effect":{"const":"none"}
      }
    },
    "candidateDefinitionRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","authority_posture","definitions"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/candidateDefinitionRegistry"},
        "schema_version":{"const":"cav2-registry-context-candidate-definitions/v1"},
        "authority_posture":{"const":"ontology-candidate-not-canonical"},
        "definitions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidateDefinition"}}
      }
    },
    "node": {
      "type":"object","additionalProperties":false,
      "required":["id","label","branch","role","plain_language","claim","scope","source_refs","owner_route","candidate_status","evidence_confidence","commitment_confidence","implementation_state","authority_effect","forbidden_collapse","open_questions"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "label":{"$ref":"#/$defs/text"},
        "branch":{"enum":["business","system"]},
        "role":{"enum":["product","thesis","project","goal","capability","product_output","business_rule","business_concept","component","adapter","snapshot","record","ledger"]},
        "plain_language":{"$ref":"#/$defs/text"},
        "claim":{"$ref":"#/$defs/text"},
        "scope":{"$ref":"#/$defs/text"},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}},
        "owner_route":{"$ref":"#/$defs/text"},
        "candidate_status":{"enum":["projected","candidate","blocked","deferred"]},
        "evidence_confidence":{"enum":["low","medium","high"]},
        "commitment_confidence":{"enum":["low","conditional","committed"]},
        "implementation_state":{"enum":["not-applicable","not-implemented"]},
        "authority_effect":{"const":"none"},
        "forbidden_collapse":{"$ref":"#/$defs/text"},
        "open_questions":{"type":"array","items":{"type":"string"}}
      }
    },
    "nodeRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","nodes"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/nodeRegistry"},
        "schema_version":{"const":"cav2-registry-context-nodes/v1"},
        "nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}}
      }
    },
    "relationVocabularyEntry": {
      "type":"object","additionalProperties":false,
      "required":["id","label","source_branches","target_branches","plain_language","forbidden_collapse"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z_]*$"},
        "label":{"$ref":"#/$defs/text"},
        "source_branches":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["business","system"]}},
        "target_branches":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["business","system"]}},
        "plain_language":{"$ref":"#/$defs/text"},
        "forbidden_collapse":{"$ref":"#/$defs/text"}
      }
    },
    "relation": {
      "type":"object","additionalProperties":false,
      "required":["id","type","source","target","direction","owner_route","source_refs","authority_effect","claim_limit"],
      "properties":{
        "id":{"type":"string","pattern":"^RC-REL-[0-9]{3}$"},
        "type":{"type":"string","pattern":"^[a-z][a-z_]*$"},
        "source":{"$ref":"#/$defs/id"},
        "target":{"$ref":"#/$defs/id"},
        "direction":{"const":"directed"},
        "owner_route":{"$ref":"#/$defs/text"},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}},
        "authority_effect":{"const":"none"},
        "claim_limit":{"$ref":"#/$defs/text"}
      }
    },
    "relationRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","relation_vocabulary","relations"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/relationRegistry"},
        "schema_version":{"const":"cav2-registry-context-relations/v1"},
        "relation_vocabulary":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relationVocabularyEntry"}},
        "relations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/relation"}}
      }
    },
    "operation": {
      "type":"object","additionalProperties":false,
      "required":["id","label","input_ref","output_ref","steps","allowed_effects","blocked_effects","terminal_outcomes","failure_policy","owner_route","source_refs","authority_effect"],
      "properties":{
        "id":{"type":"string","pattern":"^RC-OP-[A-Z0-9-]+$"},
        "label":{"$ref":"#/$defs/text"},
        "input_ref":{"$ref":"#/$defs/id"},
        "output_ref":{"$ref":"#/$defs/id"},
        "steps":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},
        "allowed_effects":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},
        "blocked_effects":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},
        "terminal_outcomes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "failure_policy":{"$ref":"#/$defs/text"},
        "owner_route":{"$ref":"#/$defs/text"},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}},
        "authority_effect":{"const":"none"}
      }
    },
    "operationRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","operations"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/operationRegistry"},
        "schema_version":{"const":"cav2-registry-context-operations/v1"},
        "operations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/operation"}}
      }
    },
    "residue": {
      "type":"object","additionalProperties":false,
      "required":["id","label","description","status","owner_route","next_action","subject_refs","source_refs"],
      "properties":{
        "id":{"type":"string","pattern":"^RC-RES-[A-Z0-9-]+$"},
        "label":{"$ref":"#/$defs/text"},
        "description":{"$ref":"#/$defs/text"},
        "status":{"enum":["open","deferred","blocked"]},
        "owner_route":{"$ref":"#/$defs/text"},
        "next_action":{"$ref":"#/$defs/text"},
        "subject_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}}
      }
    },
    "residueRegistry": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","residue"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/residueRegistry"},
        "schema_version":{"const":"cav2-registry-context-residue/v1"},
        "residue":{"type":"array","items":{"$ref":"#/$defs/residue"}}
      }
    },
    "ontologyView": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","view_id","view_kind","node_refs","relation_refs","claim_ceiling"],
      "properties":{
        "schema_ref":{"const":"../schemas/registry-context.schema.json#/$defs/ontologyView"},
        "schema_version":{"const":"cav2-registry-context-ontology-view/v1"},
        "view_id":{"type":"string","pattern":"^cav2[.]registry-context[.](business|system|bridge)$"},
        "view_kind":{"enum":["business","system","bridge"]},
        "node_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "relation_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-REL-"}},
        "claim_ceiling":{"$ref":"#/$defs/text"}
      }
    },
    "contextScope": {
      "type":"object","additionalProperties":false,
      "required":["product_ref","thesis_ref","project_ref","goal_ref","capability_ref","language_ref"],
      "properties":{
        "product_ref":{"$ref":"#/$defs/id"},
        "thesis_ref":{"$ref":"#/$defs/id"},
        "project_ref":{"$ref":"#/$defs/id"},
        "goal_ref":{"$ref":"#/$defs/id"},
        "capability_ref":{"$ref":"#/$defs/id"},
        "language_ref":{"$ref":"#/$defs/id"}
      }
    },
    "registryQuery": {
      "type":"object","additionalProperties":false,
      "required":["query_id","registry_ref","registry_anchor_selection_ref","required_selection_refs","optional_selection_refs"],
      "properties":{
        "query_id":{"type":"string","pattern":"^RC-QUERY-[A-Z0-9-]+$"},
        "registry_ref":{"$ref":"#/$defs/id"},
        "registry_anchor_selection_ref":{"type":"string","pattern":"^RC-SEL-"},
        "required_selection_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}},
        "optional_selection_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}}
      }
    },
    "bindingPolicy": {
      "type":"object","additionalProperties":false,
      "required":["explicit_only","label_similarity","open_realization","missing_owner"],
      "properties":{
        "explicit_only":{"const":true},
        "label_similarity":{"const":"forbidden"},
        "open_realization":{"const":"preserve-as-residue"},
        "missing_owner":{"const":"preserve-as-residue"}
      }
    },
    "currencyPolicy": {
      "type":"object","additionalProperties":false,
      "required":["mode","whole_file_drift","selection_drift","missing_selection","ambiguous_selection"],
      "properties":{
        "mode":{"const":"selection-digest"},
        "whole_file_drift":{"const":"diagnostic"},
        "selection_drift":{"const":"block"},
        "missing_selection":{"const":"block"},
        "ambiguous_selection":{"const":"block"}
      }
    },
    "contextRequest": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","request_id","consumer_ref","purpose","context_scope","registry_queries","binding_policy","currency_policy","expected_source_epoch","output_profile_ref","authority_effect","request_digest_algorithm","request_digest"],
      "properties":{
        "schema_version":{"const":"cav2-registry-context-request/v1"},
        "request_id":{"type":"string","pattern":"^RC-REQ-[A-Z0-9-]+$"},
        "consumer_ref":{"$ref":"#/$defs/id"},
        "purpose":{"$ref":"#/$defs/text"},
        "context_scope":{"$ref":"#/$defs/contextScope"},
        "registry_queries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/registryQuery"}},
        "binding_policy":{"$ref":"#/$defs/bindingPolicy"},
        "currency_policy":{"$ref":"#/$defs/currencyPolicy"},
        "expected_source_epoch":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
        "output_profile_ref":{"const":"cav2.registry-context.view/v1"},
        "authority_effect":{"const":"none"},
        "request_digest_algorithm":{"const":"sha256-canonical-json-excluding-request-digest/v1"},
        "request_digest":{"$ref":"#/$defs/sha256"}
      }
    },
    "sourceEpochItem": {
      "type":"object","additionalProperties":false,
      "required":["selection_ref","selection_sha256"],
      "properties":{
        "selection_ref":{"type":"string","pattern":"^RC-SEL-"},
        "selection_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "sourceEpoch": {
      "type":"object","additionalProperties":false,
      "required":["algorithm","selections","digest"],
      "properties":{
        "algorithm":{"const":"sha256-canonical-selection-set/v1"},
        "selections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceEpochItem"}},
        "digest":{"$ref":"#/$defs/sha256"}
      }
    },
    "selectedProjection": {
      "oneOf":[
        {
          "type":"object","additionalProperties":false,
          "required":["encoding","content"],
          "properties":{
            "encoding":{"const":"canonical-json"},
            "content":{}
          }
        },
        {
          "type":"object","additionalProperties":false,
          "required":["encoding","content"],
          "properties":{
            "encoding":{"const":"utf8-markdown"},
            "content":{"type":"string"}
          }
        }
      ]
    },
    "contextRecord": {
      "type":"object","additionalProperties":false,
      "required":["record_ref","record_kind","registry_ref","selection_ref","selection_sha256","selected_projection","disposition","owner_route","authority_effect"],
      "properties":{
        "record_ref":{"$ref":"#/$defs/id"},
        "record_kind":{"enum":["product","product-thesis","project","goal","capability","product-output","registry-selection","canonical-definition-selection"]},
        "registry_ref":{"$ref":"#/$defs/id"},
        "selection_ref":{"type":"string","pattern":"^RC-SEL-"},
        "selection_sha256":{"$ref":"#/$defs/sha256"},
        "selected_projection":{"$ref":"#/$defs/selectedProjection"},
        "disposition":{"enum":["included","included-with-residue"]},
        "owner_route":{"$ref":"#/$defs/text"},
        "authority_effect":{"const":"none"}
      }
    },
    "contextBinding": {
      "type":"object","additionalProperties":false,
      "required":["binding_id","relation_type","source_ref","target_ref","binding_state","owner_route","source_selection_refs","noncollapse_rule","blocked_uses","authority_effect"],
      "properties":{
        "binding_id":{"type":"string","pattern":"^RC-VIEW-BIND-[A-Z0-9-]+$"},
        "relation_type":{"type":"string","pattern":"^[a-z][a-z_]*$"},
        "source_ref":{"$ref":"#/$defs/id"},
        "target_ref":{"$ref":"#/$defs/id"},
        "binding_state":{"const":"explicit-source-backed"},
        "owner_route":{"$ref":"#/$defs/text"},
        "source_selection_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}},
        "noncollapse_rule":{"$ref":"#/$defs/text"},
        "blocked_uses":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},
        "authority_effect":{"const":"none"}
      }
    },
    "contextResidue": {
      "type":"object","additionalProperties":false,
      "required":["residue_id","kind","subject_ref","explanation","blocking","owner_route","source_selection_refs"],
      "properties":{
        "residue_id":{"type":"string","pattern":"^RC-VIEW-RES-[A-Z0-9-]+$"},
        "kind":{"enum":["missing","stale","ambiguous","conflict","open-realization","owner-unresolved"]},
        "subject_ref":{"$ref":"#/$defs/id"},
        "explanation":{"$ref":"#/$defs/text"},
        "blocking":{"type":"boolean"},
        "owner_route":{"$ref":"#/$defs/text"},
        "source_selection_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^RC-SEL-"}}
      }
    },
    "contextView": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","view_id","request_ref","request_digest","consumer_ref","purpose","context_scope","resolution_status","source_epoch","records","bindings","residue","blocked_uses","claim_ceiling","authority_effect","view_digest_algorithm","view_digest"],
      "properties":{
        "schema_version":{"const":"cav2-registry-context-view/v1"},
        "view_id":{"type":"string","pattern":"^RC-VIEW-[A-Z0-9-]+$"},
        "request_ref":{"type":"string","pattern":"^RC-REQ-"},
        "request_digest":{"$ref":"#/$defs/sha256"},
        "consumer_ref":{"$ref":"#/$defs/id"},
        "purpose":{"$ref":"#/$defs/text"},
        "context_scope":{"$ref":"#/$defs/contextScope"},
        "resolution_status":{"enum":["resolved","resolved_with_residue","blocked"]},
        "source_epoch":{"$ref":"#/$defs/sourceEpoch"},
        "records":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/contextRecord"}},
        "bindings":{"type":"array","items":{"$ref":"#/$defs/contextBinding"}},
        "residue":{"type":"array","items":{"$ref":"#/$defs/contextResidue"}},
        "blocked_uses":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},
        "claim_ceiling":{"$ref":"#/$defs/text"},
        "authority_effect":{"const":"none"},
        "view_digest_algorithm":{"const":"sha256-canonical-json-excluding-view-digest/v1"},
        "view_digest":{"$ref":"#/$defs/sha256"}
      }
    },
    "validationReceipt": {
      "type":"object","additionalProperties":false,
      "required":["schema_ref","schema_version","validated_at","status","package_root","ontology_type","branches","bridge","visibility","authority_effect","counts","material_digest","checks","warnings","errors","claim_ceiling"],
      "properties":{
        "schema_ref":{"const":"schemas/registry-context.schema.json#/$defs/validationReceipt"},
        "schema_version":{"const":"cav2-registry-context-validation/v1"},
        "validated_at":{"type":"string","format":"date-time"},
        "status":{"enum":["PASS","BLOCK"]},
        "package_root":{"const":"cyberAlchemy-v2/product/registry-context"},
        "ontology_type":{"const":"business-system-bridge"},
        "branches":{"const":["business","system"]},
        "bridge":{"const":"business-system"},
        "visibility":{"const":"private"},
        "authority_effect":{"const":"none"},
        "counts":{"type":"object"},
        "material_digest":{"$ref":"#/$defs/sha256"},
        "checks":{"type":"array","items":{"$ref":"#/$defs/text"}},
        "warnings":{"type":"array","items":{"type":"string"}},
        "errors":{"type":"array","items":{"type":"string"}},
        "claim_ceiling":{"$ref":"#/$defs/text"}
      }
    }
  }
}
