# Local read-only dashboard candidate. Open questions: PLAN.md.
[Unit]
Description=CyberAlchemy Workspace dashboard

[Service]
Type=simple
WorkingDirectory=%h/projects/cyberAlchemy-v2
Environment=LD_LIBRARY_PATH=%h/.local/share/are-runtimes/icu-74.2
ExecStart=%h/.local/share/are-runtimes/node-v26.8.1-linux-x64/bin/node %h/projects/cyberAlchemy-v2/workspace/plans/orchestrator-integration/dashboard-server.mjs %h/.local/state/are-workspace/dashboard-01/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
