[Unit]
Description=ARE single Luna pilot host
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/cyberalchemy-orchestrator/openai_api_key

[Service]
Type=simple
User=are-luna
Group=are-luna
WorkingDirectory=/var/lib/are-luna-pilot
RuntimeDirectory=are-luna-pilot
RuntimeDirectoryMode=0700
UMask=0077
LoadCredential=openai-api-key:/run/cyberalchemy-orchestrator/openai_api_key
ExecStart=/srv/are-luna-pilot/candidates/04384954e710e58f/bin/node /srv/are-luna-pilot/launchers/22ddddd79b0f96af/pilot-host.mjs /srv/are-luna-pilot/launchers/22ddddd79b0f96af/host.json
Restart=no
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/are-luna-pilot /run/are-luna-pilot

[Install]
WantedBy=multi-user.target
