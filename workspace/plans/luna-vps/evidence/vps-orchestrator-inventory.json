{
  "schema_version": "are.vps-orchestrator-inventory/v1",
  "authority_effect": "none",
  "directory_entries": [
    "current",
    "releases"
  ],
  "container": {
    "image": "cyberalchemy-orchestrator:9de7de67",
    "working_dir": "",
    "ports": {
      "8080/tcp": [
        {
          "HostIp": "127.0.0.1",
          "HostPort": "18080"
        }
      ]
    },
    "mounts": [
      {
        "Type": "volume",
        "Name": "cyberalchemy_orchestrator_state",
        "Source": "/var/lib/docker/volumes/cyberalchemy_orchestrator_state/_data",
        "Destination": "/app/state",
        "Driver": "local",
        "Mode": "rw",
        "RW": true,
        "Propagation": ""
      },
      {
        "Type": "bind",
        "Source": "/run/cyberalchemy-orchestrator",
        "Destination": "/run/secrets",
        "Mode": "ro",
        "RW": false,
        "Propagation": "rprivate"
      }
    ]
  },
  "runtime_versions": {
    "node": {
      "exit_code": 127,
      "output": "OCI runtime exec failed: exec failed: unable to start container process: exec: \"node\": executable file not found in $PATH"
    },
    "codex": {
      "exit_code": 127,
      "output": "OCI runtime exec failed: exec failed: unable to start container process: exec: \"codex\": executable file not found in $PATH"
    }
  },
  "open_questions_ref": "../HOST-PLAN.md#open-questions"
}
