{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cav2:workspace:control-center:schema:v1",
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "cav2-workspace-control-center/profile-v1"
        },
        "ontology_id": {
          "const": "cav2.workspace.control-center"
        },
        "ontology_type": {
          "const": "business-domain"
        },
        "branch": {
          "const": "business"
        },
        "views": {
          "type": "array",
          "items": {
            "enum": [
              "product",
              "business"
            ]
          },
          "uniqueItems": true
        },
        "materialization": {
          "const": "package-required"
        },
        "package_owner": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "const": "private"
        },
        "status": {
          "const": "candidate"
        },
        "authority_effect": {
          "const": "none"
        },
        "selection_source": {
          "const": "inferred"
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_registry": {
          "const": "sources.json"
        },
        "node_registry": {
          "const": "nodes.json"
        },
        "relation_registry": {
          "const": "relations.json"
        },
        "view_registry": {
          "const": "views.json"
        },
        "residue_registry": {
          "const": "residue.json"
        },
        "schema_path": {
          "const": "schemas/ontology.schema.json"
        },
        "validator_path": {
          "const": "scripts/validate.py"
        },
        "open_questions_ref": {
          "const": "residue.json"
        },
        "material_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "ontology_id",
        "ontology_type",
        "branch",
        "views",
        "materialization",
        "package_owner",
        "visibility",
        "status",
        "authority_effect",
        "selection_source",
        "selection_rationale",
        "source_registry",
        "node_registry",
        "relation_registry",
        "view_registry",
        "residue_registry",
        "schema_path",
        "validator_path",
        "open_questions_ref",
        "material_files"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "posture": {
                "enum": [
                  "product-intent",
                  "existing-identity"
                ]
              },
              "authority_effect": {
                "const": "none"
              }
            },
            "required": [
              "id",
              "path",
              "sha256",
              "selector",
              "posture",
              "authority_effect"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "view": {
                "enum": [
                  "product",
                  "business"
                ]
              },
              "kind": {
                "enum": [
                  "product",
                  "capability",
                  "actor",
                  "outcome",
                  "measure",
                  "premise",
                  "concept",
                  "workflow",
                  "rule"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "handling": {
                "enum": [
                  "reuse",
                  "specialize",
                  "propose"
                ]
              },
              "external_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner_route": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "status": {
                "const": "candidate"
              },
              "evidence_posture": {
                "enum": [
                  "source-stated",
                  "design-inference",
                  "unmeasured-hypothesis"
                ]
              },
              "boundary": {
                "type": "string",
                "minLength": 1
              },
              "authority_effect": {
                "const": "none"
              }
            },
            "required": [
              "id",
              "view",
              "kind",
              "label",
              "meaning",
              "handling",
              "external_ref",
              "owner_route",
              "source_refs",
              "status",
              "evidence_posture",
              "boundary",
              "authority_effect"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "nodes"
      ],
      "additionalProperties": false
    },
    "relations": {
      "type": "object",
      "properties": {
        "relation_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "from_kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "product",
                    "capability",
                    "actor",
                    "outcome",
                    "measure",
                    "premise",
                    "concept",
                    "workflow",
                    "rule"
                  ]
                },
                "uniqueItems": true
              },
              "to_kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "product",
                    "capability",
                    "actor",
                    "outcome",
                    "measure",
                    "premise",
                    "concept",
                    "workflow",
                    "rule"
                  ]
                },
                "uniqueItems": true
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "cycle_policy": {
                "const": "acyclic-per-type"
              }
            },
            "required": [
              "id",
              "from_kinds",
              "to_kinds",
              "meaning",
              "cycle_policy"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "authority_effect": {
                "const": "none"
              }
            },
            "required": [
              "id",
              "from",
              "type",
              "to",
              "source_refs",
              "rationale",
              "authority_effect"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "relation_types",
        "relations"
      ],
      "additionalProperties": false
    },
    "views": {
      "type": "object",
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "product",
                  "business"
                ]
              },
              "ontology_id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "node_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "relation_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "ontology_id",
              "question",
              "node_refs",
              "relation_refs"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "views"
      ],
      "additionalProperties": false
    },
    "residue": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "open-question",
                  "evidence-gap",
                  "boundary"
                ]
              },
              "status": {
                "const": "open"
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "owner_route": {
                "type": "string",
                "minLength": 1
              },
              "node_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "blocking_stage": {
                "enum": [
                  "none",
                  "integration",
                  "product-test"
                ]
              },
              "authority_effect": {
                "const": "none"
              }
            },
            "required": [
              "id",
              "kind",
              "status",
              "question",
              "owner_route",
              "node_refs",
              "source_refs",
              "blocking_stage",
              "authority_effect"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  }
}
