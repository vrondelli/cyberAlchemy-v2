{
  "name": "@cyberalchemy/workspace-ontology-canvas-experiment",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26.6.0"
  },
  "scripts": {
    "generate": "node scripts/build-graph.mjs",
    "validate": "pnpm run generate && node scripts/validate-experiment.mjs",
    "validate:proof": "node scripts/validate-experiment.mjs --require-proof",
    "typecheck": "pnpm run generate && tsc --noEmit --pretty false",
    "test": "pnpm run generate && vitest run",
    "build": "pnpm run generate && tsc --noEmit --pretty false && vite build",
    "dev": "pnpm run generate && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "browser:proof": "node scripts/browser-proof.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.11.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
