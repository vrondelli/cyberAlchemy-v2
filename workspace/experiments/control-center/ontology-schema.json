{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "business": {
      "type": "object",
      "properties": {
        "ontology_id": {
          "type": "string",
          "minLength": 1
        },
        "ontology_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate"
        },
        "authority_effect": {
          "const": "none"
        },
        "branch": {
          "const": "business"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "parent_ref": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "guard": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "guard"
                  ],
                  "additionalProperties": false
                }
              },
              "invariant": {
                "type": "string",
                "minLength": 1
              },
              "failure": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "const": "definition-pack"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "parent_ref",
              "meaning",
              "states",
              "transitions",
              "invariant",
              "failure",
              "source_ref",
              "selector"
            ],
            "additionalProperties": false
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "relation",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ontology_id",
        "ontology_type",
        "status",
        "authority_effect",
        "branch",
        "nodes",
        "relations"
      ],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "ontology_id": {
          "type": "string",
          "minLength": 1
        },
        "ontology_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate"
        },
        "authority_effect": {
          "const": "none"
        },
        "branch": {
          "const": "system"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "component"
              },
              "responsibility": {
                "type": "string",
                "minLength": 1
              },
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "implementation_ref": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "planned-prototype"
              },
              "source_ref": {
                "const": "definition-pack"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "responsibility",
              "interfaces",
              "implementation_ref",
              "status",
              "source_ref",
              "selector"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ontology_id",
        "ontology_type",
        "status",
        "authority_effect",
        "branch",
        "nodes"
      ],
      "additionalProperties": false
    },
    "bridge": {
      "type": "object",
      "properties": {
        "ontology_id": {
          "type": "string",
          "minLength": 1
        },
        "ontology_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate"
        },
        "authority_effect": {
          "const": "none"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "planned_realization"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to",
              "type",
              "source_refs",
              "claim"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ontology_id",
        "ontology_type",
        "status",
        "authority_effect",
        "relations"
      ],
      "additionalProperties": false
    }
  }
}
