{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cav2-workspace-foundation-browser-evidence/v1-candidate",
  "title": "CyberAlchemy Workspace Foundation browser evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_effect", "profile_id", "observed_at", "identity", "bindings", "samples", "console_errors", "page_errors"],
  "properties": {
    "schema_version": { "const": "cav2-workspace-foundation-browser-evidence/v1-candidate" },
    "authority_effect": { "const": "none" },
    "profile_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "browser_engine", "browser_version", "viewport"],
      "properties": {
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "architecture": { "enum": ["x64", "arm64"] },
        "browser_engine": { "enum": ["chromium", "firefox", "webkit"] },
        "browser_version": { "type": "string", "minLength": 1 },
        "browser_executable": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_sha256", "regime_sha256"],
      "properties": {
        "budget_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "regime_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "durationMs"],
        "properties": {
          "name": { "type": "string" },
          "durationMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "console_errors": { "type": "array", "items": { "type": "string" } },
    "page_errors": { "type": "array", "items": { "type": "string" } }
  }
}
