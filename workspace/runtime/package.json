{
  "name": "@cyberalchemy/workspace-runtime",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "26.8.1"
  },
  "scripts": {
    "generate": "node scripts/build-workspace-snapshot.mjs && node scripts/build-foundation-snapshot.mjs && node ../../foundation/scripts/build-workspace-projection.mjs",
    "generate:foundation": "node scripts/build-foundation-snapshot.mjs",
    "check:foundation": "node scripts/build-foundation-snapshot.mjs --check",
    "check:foundation-capability-instance": "node ../../foundation/scripts/build-workspace-projection.mjs --check && node ../../foundation/scripts/validate.mjs",
    "generate:graph": "node scripts/build-workspace-graph.mjs",
    "check:implementation": "node scripts/check-implementation-manifest.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "dev:fast": "vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build",
    "build:implementation": "npm run check:implementation && npm run generate:graph && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run generate && tsc --noEmit --pretty false",
    "test": "npm run generate && vitest run",
    "test:implementation": "npm run check:implementation && npm run generate:graph && vitest run",
    "test:performance": "vitest run src/performance-budget.test.ts",
    "test:foundation-performance": "vitest run src/foundation-performance-budget.test.ts",
    "benchmark:foundation": "vite build && node scripts/benchmark-foundation.mjs --write",
    "benchmark:foundation:browser": "vite build && node scripts/benchmark-foundation-browser.mjs",
    "benchmark:foundation:differential": "node scripts/build-foundation-differential-report.mjs",
    "benchmark:foundation:import": "node scripts/import-foundation-browser-evidence.mjs",
    "test:foundation": "npm run check:foundation && npm run check:foundation-capability-instance && vitest run src/domain/foundation.test.ts src/domain/foundation-capability-instance.test.ts",
    "browser:acceptance": "node scripts/browser-acceptance.mjs",
    "build:tauri:smoke": "npm run check:implementation && vite build --config wdio/vite.config.mjs && cargo build --manifest-path ../../essays/development/agent-runtime/implementation/desktop/src-tauri/Cargo.toml --features wdio",
    "test:tauri:smoke": "npm run build:tauri:smoke && node wdio/run-smoke.mjs",
    "test:tauri:foundation": "vite build --config wdio/vite.config.mjs && cargo build --manifest-path ../../essays/development/agent-runtime/implementation/desktop/src-tauri/Cargo.toml --features wdio && node wdio/run-foundation-smoke.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@cyberalchemy/essays-runtime": "link:../../essays/runtime",
    "@xyflow/react": "12.11.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@cyberalchemy/orchestrator-console": "link:../../../cya-orquestrator/cyberAlchemy-v2/work-orchestration-implementation/frontend"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
